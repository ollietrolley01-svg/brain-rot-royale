<?xml version='1.0' encoding='utf-8'?>
<roblox xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX1"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">true</bool><int name="StreamingMinRadius">256</int><int name="StreamingTargetRadius">1024</int></Properties></Item><Item class="Lighting" referent="RBX2"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><float name="Brightness">2.4</float><float name="ClockTime">14.5</float><float name="GeographicLatitude">22</float><float name="ExposureCompensation">0.35</float><float name="EnvironmentDiffuseScale">1</float><float name="EnvironmentSpecularScale">1</float><bool name="GlobalShadows">true</bool><float name="FogStart">0</float><float name="FogEnd">100000</float></Properties></Item><Item class="ReplicatedStorage" referent="RBX3"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX4"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">AchievementData</string><ProtectedString name="Source">-- Achievements: lifetime milestones that pay coins once and unlock a title to wear on your
-- nameplate. Progress is read straight off the profile — `stat` names a counter in Stats (wins,
-- kills, matches) or Lifetime (everything else QuestService funnels through).

local AchievementData = {}

AchievementData.List = {
	{ id = "kill1", name = "First Blood", title = "Rookie", stat = "kills", target = 1, coins = 200,
		description = "Eliminate your first opponent." },
	{ id = "kill100", name = "Hundred Club", title = "Hunter", stat = "kills", target = 100, coins = 2000,
		description = "Eliminate 100 opponents." },
	{ id = "kill500", name = "Five Hundred", title = "Reaper", stat = "kills", target = 500, coins = 8000,
		description = "Eliminate 500 opponents." },
	{ id = "win1", name = "Last One Standing", title = "Winner", stat = "wins", target = 1, coins = 500,
		description = "Win a match." },
	{ id = "win10", name = "Ten Crowns", title = "Champion", stat = "wins", target = 10, coins = 5000,
		description = "Win 10 matches." },
	{ id = "win50", name = "Fifty Crowns", title = "Legend", stat = "wins", target = 50, coins = 25000,
		description = "Win 50 matches." },
	{ id = "match25", name = "Regular", title = "Regular", stat = "matches", target = 25, coins = 1000,
		description = "Play 25 matches." },
	{ id = "match200", name = "Veteran", title = "Veteran", stat = "matches", target = 200, coins = 10000,
		description = "Play 200 matches." },
	{ id = "top10x50", name = "Always There", title = "Consistent", stat = "top10", target = 50, coins = 3000,
		description = "Finish in the top 10 fifty times." },
	{ id = "chest100", name = "Looter", title = "Looter", stat = "chests", target = 100, coins = 2000,
		description = "Open 100 chests." },
	{ id = "landmark50", name = "Explorer", title = "Explorer", stat = "landmarkChests", target = 50, coins = 3000,
		description = "Open 50 chests at landmarks." },
	{ id = "build50", name = "Architect", title = "Architect", stat = "builds", target = 50, coins = 3000,
		description = "Build 50 portable defenses." },
	{ id = "damage50k", name = "Menace", title = "Menace", stat = "damage", target = 50000, coins = 6000,
		description = "Deal 50,000 damage." },
	{ id = "obby10", name = "Head For Heights", title = "Cloud Climber", stat = "obby", target = 10, coins = 3000,
		description = "Clear the Cloud Climb 10 times." },
	{ id = "goal25", name = "Top Scorer", title = "Striker", stat = "goals", target = 25, coins = 2000,
		description = "Score 25 goals on the lobby pitch." },
	{ id = "bounty10", name = "Wanted Dead", title = "Bounty Hunter", stat = "bounties", target = 10, coins = 4000,
		description = "Collect 10 bounties." },
	{ id = "crate20", name = "Crate Addict", title = "Crate Addict", stat = "crates", target = 20, coins = 2000,
		description = "Open 20 crates." },
	{ id = "quest30", name = "Grinder", title = "Grinder", stat = "questsDone", target = 30, coins = 5000,
		description = "Complete 30 quests or challenges." },
	{ id = "set1", name = "Full Set", title = "Collector", stat = "sets", target = 1, coins = 3000,
		description = "Own every brainrot of one rarity at once." },
	{ id = "set4", name = "Museum", title = "Curator", stat = "sets", target = 4, coins = 15000,
		description = "Complete four rarity sets." },
	{ id = "barrel50", name = "Powder Keg", title = "Demolitionist", stat = "barrels", target = 50, coins = 3000,
		description = "Blow up 50 explosive barrels." },
	{ id = "hazard25", name = "Booby Trapper", title = "Trapper", stat = "hazardKills", target = 25, coins = 4000,
		description = "Eliminate 25 opponents with explosive barrels or Rot Mines." },
	{ id = "vendor30", name = "Regular Customer", title = "Big Spender", stat = "vendor", target = 30, coins = 2500,
		description = "Buy 30 things from Rot Vendors." },
	{ id = "item150", name = "Well Stocked", title = "Stocked Up", stat = "items", target = 150, coins = 3000,
		description = "Use 150 heals, shields or items." },
	{ id = "supply10", name = "Drop Zone", title = "Air Support", stat = "supply", target = 10, coins = 4000,
		description = "Claim 10 supply drops." },

	-- Progression (ProgressionService). `rankScore` is prestige * 100 + Rot Rank, so 101 is the first
	-- prestige; `mastered` counts guns at Gold mastery or better.
	{ id = "rank25", name = "Quarter Rotten", title = "Rotting", stat = "rankScore", target = 25, coins = 1000,
		description = "Reach Rot Rank 25." },
	{ id = "rank50", name = "Half Gone", title = "Brain Drain", stat = "rankScore", target = 50, coins = 2500,
		description = "Reach Rot Rank 50." },
	{ id = "rank100", name = "Fully Rotted", title = "Fully Rotted", stat = "rankScore", target = 100, coins = 5000,
		description = "Reach Rot Rank 100." },
	{ id = "prestige1", name = "Born Again", title = "Reborn", stat = "rankScore", target = 101, coins = 5000,
		description = "Prestige for the first time." },
	{ id = "prestige5", name = "Rot Royalty", title = "Rot Royalty", stat = "rankScore", target = 501, coins = 9000,
		description = "Reach Prestige 5." },
	{ id = "prestige10", name = "Eternal Rot", title = "Rot Eternal", stat = "rankScore", target = 1001, coins = 25000,
		description = "Reach Prestige 10, the highest there is." },
	{ id = "mastered1", name = "Gun Nerd", title = "Gun Nerd", stat = "mastered", target = 1, coins = 1500,
		description = "Reach Gold mastery with any gun." },
	{ id = "mastered10", name = "Armory", title = "Armorer", stat = "mastered", target = 10, coins = 6000,
		description = "Reach Gold mastery with 10 different guns." },
	{ id = "rotmaster1", name = "Rotmaster", title = "Rotmaster", stat = "rotmasters", target = 1, coins = 8000,
		description = "Reach Rotmaster, the top mastery tier, with any gun." },
	{ id = "index60", name = "Field Notes", title = "Rotologist", stat = "discovered", target = 60, coins = 4000,
		description = "Discover 60 different brainrots in the Rot Index." },
	{ id = "index120", name = "Brainrotica", title = "Encyclopedic", stat = "discovered", target = 120, coins = 9000,
		description = "Discover 120 different brainrots in the Rot Index." },
}

-- Counters that live on the profile's Lifetime table (Stats holds wins, kills and matches).
AchievementData.LifetimeStats = {
	"top10", "chests", "items", "damage", "crates", "supply", "obby", "goals", "bounties", "questsDone", "sets",
	"landmarkChests", "builds", "barrels", "hazardKills", "vendor",
	"rankScore", "mastered", "rotmasters", "discovered",
}

local byId = {}
for _, achievement in ipairs(AchievementData.List) do
	byId[achievement.id] = achievement
end

function AchievementData.Get(id)
	return byId[id]
end

function AchievementData.Value(data, stat)
	if data.Stats and data.Stats[stat] then
		return data.Stats[stat]
	end
	return data.Lifetime and data.Lifetime[stat] or 0
end

-- For the menu: every achievement with progress and whether it's unlocked, plus the worn title.
-- The rank rows count in "rank score" (prestige × 100 + rank), a unit nothing else on screen uses:
-- a Rot Rank 37 player read "37 / 101" towards Born Again and "37 / 1,001" towards Eternal Rot. So
-- those rows say it in the Rank page's own words instead (#86). nil for every other stat, and the
-- menu falls back to the plain count.
function AchievementData.ProgressText(achievement, progress)
	if achievement.stat ~= "rankScore" then
		return nil
	end
	if achievement.target &gt; 100 then
		return string.format("Prestige %d / %d", math.floor(progress / 100), math.floor(achievement.target / 100))
	end
	return string.format("Rank %d / %d", progress, achievement.target)
end

function AchievementData.Snapshot(data)
	local list = {}
	for _, achievement in ipairs(AchievementData.List) do
		local progress = math.min(achievement.target, AchievementData.Value(data, achievement.stat))
		table.insert(list, {
			progressText = AchievementData.ProgressText(achievement, progress),
			id = achievement.id,
			name = achievement.name,
			title = achievement.title,
			description = achievement.description,
			target = achievement.target,
			progress = progress,
			coins = achievement.coins,
			unlocked = data.Achievements[achievement.id] == true,
		})
	end
	return { list = list, title = data.Title }
end

return AchievementData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">ArsenalExpansion</string><ProtectedString name="Source">-- Fifteen additive weapons. All figures are game balance values, in Roblox units.
-- Presentation shares GunModels' tested mechanisms, sights and hand keypoints.
local Pack = {}

Pack.Order = {
	"PawnshopNine", "RustbeltMarshal", "NightShiftPump",
	"DoomscrollSMG", "TrailheadCarbine", "TouchGrassScout", "DeadAirPrecision",
	"RatioPDW", "BackroomsBreacher", "ReceiptPrinterLMG", "SundaySpecial",
	"AuraAuditRifle", "QuietHours", "AdminOverride", "FinalNotice",
}

Pack.Weapons = {
	PawnshopNine = {
		name = "Pistacchio Pum", rarity = "Common", style = "pistol",
		damage = 21, headshotMultiplier = 1.8, fireRate = 4.8, magSize = 13,
		reserveAmmo = 91, reloadTime = 1.45, range = 230, spread = 1.35, pellets = 1,
		groundWeight = 24, chestWeight = 8,
		description = "A pistachio-green pawnshop pistol with cracked-shell grips and the price tag still on.",
	},
	RustbeltMarshal = {
		name = "Sceriffo Sgrunf", rarity = "Common", style = "revolver",
		damage = 38, headshotMultiplier = 1.9, fireRate = 1.9, magSize = 6,
		reserveAmmo = 42, reloadTime = 2.45, range = 290, spread = 0.85, pellets = 1,
		groundWeight = 16, chestWeight = 8,
		description = "Blunt working revolver with walnut grips; deliberate, accurate taps.",
	},
	NightShiftPump = {
		name = "Ciabatta Clonk", rarity = "Common", style = "shotgun",
		damage = 13, headshotMultiplier = 1.3, fireRate = 0.95, magSize = 5,
		reserveAmmo = 40, reloadTime = 2.75, range = 110, spread = 7, pellets = 8,
		groundWeight = 18, chestWeight = 8,
		description = "The night-shift bakery's shotgun: a ciabatta for a pump, a baguette for a stock, breadsticks in the saddle.",
	},
	DoomscrollSMG = {
		name = "Scrolla Scrolla Brrrap", rarity = "Uncommon", style = "smg",
		damage = 15, headshotMultiplier = 1.6, fireRate = 11.5, magSize = 30,
		reserveAmmo = 180, reloadTime = 1.95, range = 205, spread = 2.4, pellets = 1,
		groundWeight = 13, chestWeight = 8, killEffect = "shock",
		description = "A phone clamped to its side mid-scroll, a power bank for a magazine, a selfie stick for a stock. One more mag, then bed.",
	},
	TrailheadCarbine = {
		name = "Scarponcino Trotto Trotto", rarity = "Uncommon", style = "rifle",
		damage = 25, headshotMultiplier = 1.9, fireRate = 6.8, magSize = 25,
		reserveAmmo = 150, reloadTime = 1.9, range = 410, spread = 1.35, pellets = 1,
		groundWeight = 12, chestWeight = 8,
		description = "Packed for a hike: a trekking-pole handguard, a headlamp, paracord and a compass in the stock.",
	},
	TouchGrassScout = {
		name = "Prato Prato Pium", rarity = "Rare", style = "dmr",
		damage = 43, headshotMultiplier = 2.2, fireRate = 3.3, magSize = 14,
		reserveAmmo = 70, reloadTime = 2.2, range = 690, spread = 0.32, pellets = 1,
		ability = "pierce", groundWeight = 0, chestWeight = 4,
		description = "A picnic scout: wicker stock, gingham handguard, a flower on the muzzle and a butterfly on the scope.",
	},
	DeadAirPrecision = {
		name = "Silenzio Sussurrone", rarity = "Rare", style = "sniper",
		damage = 91, headshotMultiplier = 2.4, fireRate = 0.85, magSize = 6,
		reserveAmmo = 30, reloadTime = 3.0, range = 1250, spread = 0.09, pellets = 1,
		ability = "pierce", groundWeight = 0, chestWeight = 3.5, killEffect = "freeze",
		description = "Slate precision rifle. A visible hand-worked bolt rewards measured shots.",
	},
	RatioPDW = {
		name = "Piccolino Ratatatà", rarity = "Epic", style = "smg",
		-- Ratio (the gun rework): five hits with no gap over a second and a half mark the target for three
		-- seconds, and a marked target takes 1.12x from everyone. Damage comes down from 20 to 19 and the
		-- lifesteal goes: 19 x 12.5 = 237.5 body DPS, 266 once the mark is up, against the old 250.
		damage = 19, headshotMultiplier = 1.6, fireRate = 12.5, magSize = 36,
		reserveAmmo = 216, reloadTime = 1.85, range = 230, spread = 2.05, pellets = 1,
		ratio = { stacks = 5, window = 1.5, duration = 3, scale = 1.12 }, groundWeight = 0, chestWeight = 2,
		killEffect = "confetti",
		description = "L + RATIO: five quick hits and the target takes extra damage from everyone for three seconds.",
	},
	BackroomsBreacher = {
		name = "Porta Porta Bonk", rarity = "Epic", style = "shotgun",
		-- A door (the gun rework): the nine pellets land in the shape of a doorway -- the frame, the lintel, the
		-- knob -- scaled to the spread, so the pattern is the same every shot, and each hit shoves. Damage and
		-- pellets are untouched; the lifesteal goes for the shove.
		damage = 13, headshotMultiplier = 1.3, fireRate = 1.85, magSize = 8,
		reserveAmmo = 48, reloadTime = 2.85, range = 125, spread = 6, pellets = 9,
		pattern = "door", knockback = 14, groundWeight = 0, chestWeight = 2,
		killEffect = "ash",
		description = "Fluorescent-yellow breacher from the backrooms. Its pellets land in the shape of a door, and they shove.",
	},
	ReceiptPrinterLMG = {
		name = "Scontrino Infinito Brrrrr", rarity = "Legendary", style = "lmg",
		-- The total (the gun rework): every tenth hit in a run on one target (no gap over 0.8 s) prints a 30
		-- bonus. Damage comes down from 26 to 25 to pay for it; the kill still takes nine hits, 0.76 s.
		damage = 25, headshotMultiplier = 1.6, fireRate = 10.5, magSize = 70,
		reserveAmmo = 280, reloadTime = 4.1, range = 425, spread = 2.5, pellets = 1,
		ability = "goldRush", goldRushBonus = 100, groundWeight = 0, chestWeight = 0.65,
		receipt = { every = 10, bonus = 30, window = 0.8 },
		killEffect = "gold",
		description = "A till that fires. Every tenth hit in a row prints the total: 30 extra damage.",
	},
	SundaySpecial = {
		name = "Pranzo Della Nonna Bum", rarity = "Legendary", style = "cannon",
		damage = 87, headshotMultiplier = 2.2, fireRate = 1.35, magSize = 7,
		reserveAmmo = 35, reloadTime = 3.15, range = 720, spread = 0.65, pellets = 1,
		ability = "goldRush", goldRushBonus = 120, groundWeight = 0, chestWeight = 0.65,
		killEffect = "gold",
		description = "Heirloom lever rifle with deep walnut furniture and restrained brass trim.",
	},
-- Oliver, 2026-09-23 14:57: "make the mythic and secret guns slightly more common so that the rarest ones may
-- appear a few times per game". Mythic 0.18 -&gt; 1.5 each and Secret 0.045 -&gt; 0.8 each (chest weights): of a chest
-- gun roll that is about 1.1% Mythic and 0.6% Secret (was 0.13% and 0.03%), so roughly 2-3 Mythics and 1-2
-- Secrets across a full battle royale's chests. Legendary is untouched and still more common per gun.
	AuraAuditRifle = {
		name = "Occhietto Pium Pium", rarity = "Mythic", style = "rifle",
		damage = 29, headshotMultiplier = 1.9, fireRate = 8.0, magSize = 28,
		reserveAmmo = 168, reloadTime = 2.35, range = 470, spread = 1.05, pellets = 1,
		ability = "chain", chainRadius = 12, chainRatio = 0.22,
		-- The audit (the gun rework): every eighth hit in a run arcs to two more people near the target for 0.6
		-- of the hit. The target's own damage is untouched.
		audit = { every = 8, ratio = 0.6, targets = 2, window = 1 },
		groundWeight = 0, chestWeight = 1.5, killEffect = "shock",
		description = "The auditor: clipboard, checklist and stamp. Every eighth hit in a row arcs to two more people.",
	},
	QuietHours = {
		name = "Nanna Nanna Puff", rarity = "Mythic", style = "sniper",
		damage = 96, headshotMultiplier = 2.35, fireRate = 0.78, magSize = 4,
		reserveAmmo = 24, reloadTime = 3.3, range = 1350, spread = 0.06, pellets = 1,
		ability = "lifesteal", lifestealRatio = 0.16,
		groundWeight = 0, chestWeight = 1.5, killEffect = "freeze",
		description = "Long fluted bolt rifle with dark plum furniture and a moon insignia.",
	},
	AdminOverride = {
		name = "Capo Supremo Bonkolone", rarity = "Secret", style = "pistol",
		damage = 34, headshotMultiplier = 2.0, fireRate = 3.5, magSize = 10,
		reserveAmmo = 60, reloadTime = 1.7, range = 335, spread = 0.65, pellets = 1,
		-- Noclip (the gun rework): each round passes through one wall of the map for 0.7 of its damage.
		ability = "pierce", noclip = { walls = 1, scale = 0.7 }, groundWeight = 0, chestWeight = 0.8, killEffect = "vaporize",
		description = "The admin's sidearm, a terminal glowing down its slide. Its rounds noclip through one wall.",
	},
	FinalNotice = {
		name = "Ultimo Bum", rarity = "Secret", style = "rifle",
		-- Collection (the gun rework): every fifth hit in a run (no gap over 1.5 s) sets off a small blast on the
		-- target, 20 at its centre over 6 studs. Damage comes down from 33 to 31; the kill still takes seven
		-- hits, 0.92 s.
		damage = 31, headshotMultiplier = 1.9, fireRate = 6.5, magSize = 24,
		reserveAmmo = 144, reloadTime = 2.5, range = 490, spread = 1.15, pellets = 1,
		ability = "goldRush", goldRushBonus = 135,
		collect = { every = 5, damage = 20, radius = 6, window = 1.5 },
		groundWeight = 0, chestWeight = 0.8, killEffect = "gold",
		description = "The debt collector's AK. Every fifth hit in a row collects: a small blast on the target.",
	},
}

Pack.Variants = {
	PawnshopNine = { compact = true },
	RustbeltMarshal = {},
	NightShiftPump = {},
	DoomscrollSMG = { skeletonStock = true, laser = true, holo = true },
	TrailheadCarbine = { compact = true, irons = true, light = true },
	TouchGrassScout = { compact = true, light = true },
	DeadAirPrecision = { boltAction = true, flutes = true },
	RatioPDW = { suppressor = true, drum = true, holo = true },
	BackroomsBreacher = { semiAuto = true, drum = true, holo = true, heatShield = true },
	ReceiptPrinterLMG = {},
	SundaySpecial = {},
	AuraAuditRifle = { holo = true, foregrip = true, light = true, engraved = true },
	QuietHours = { boltAction = true, longBarrel = true, flutes = true },
	AdminOverride = { laser = true, light = true },
	FinalNotice = { pattern = "ak", woodFurniture = true },
}

-- Test expectations: a mechanism is a contract, not a guess based on a weapon's name.
Pack.Actions = {
	PawnshopNine = "pistol", RustbeltMarshal = "revolver", NightShiftPump = "pump",
	DoomscrollSMG = "smg", TrailheadCarbine = "ar", TouchGrassScout = "semi",
	DeadAirPrecision = "bolt", RatioPDW = "smg", BackroomsBreacher = "semi",
	ReceiptPrinterLMG = "belt", SundaySpecial = "lever", AuraAuditRifle = "ar",
	QuietHours = "bolt", AdminOverride = "pistol", FinalNotice = "ak",
}

return Pack
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">ArsenalFinish</string><ProtectedString name="Source">-- Individual finishes and stamped badges for the expansion's mechanical builds.
-- No changes to sights, muzzle positions, action travel or hand keypoints.
local Finish = {}
local C = Color3.fromRGB
local looks = {
	PawnshopNine = { C(112, 117, 125), C(53, 49, 43), C(188, 153, 90), "PISTACCHIO", "USED / TESTED", "bars" },
	RustbeltMarshal = { C(76, 80, 86), C(119, 72, 45), C(184, 145, 91), "SCERIFFO", "SGRUNF x6", "star" },
	NightShiftPump = { C(51, 57, 64), C(48, 60, 64), C(214, 170, 70), "CIABATTA", "SECURITY / 03", "bars" },
	DoomscrollSMG = { C(40, 49, 68), C(42, 53, 78), C(120, 180, 200), "SCROLLA SCROLLA", "ONE MORE MAG", "signal" },
	TrailheadCarbine = { C(66, 73, 69), C(100, 112, 79), C(219, 199, 147), "SCARPONCINO", "TROTTO / 25", "mountain" },
	TouchGrassScout = { C(55, 67, 63), C(80, 106, 64), C(179, 207, 133), "PRATO PRATO", "OUTSIDE / 14", "grass" },
	DeadAirPrecision = { C(76, 89, 103), C(101, 114, 124), C(200, 217, 222), "SILENZIO", "NO SIGNAL", "signal" },
	RatioPDW = { C(49, 44, 56), C(114, 54, 82), C(235, 155, 182), "L + RATIO", "REPLY / 36", "bars" },
	BackroomsBreacher = { C(70, 67, 52), C(168, 153, 78), C(240, 223, 139), "PORTA PORTA", "EXIT  &gt;&gt;&gt;", "exit" },
	ReceiptPrinterLMG = { C(57, 61, 64), C(205, 197, 168), C(229, 204, 138), "SCONTRINO", "ITEM: 70\nTOTAL: GG", "receipt" },
	SundaySpecial = { C(93, 79, 63), C(92, 48, 35), C(200, 161, 86), "PRANZO / NONNA", "FAMILY RESERVE", "star" },
	AuraAuditRifle = { C(141, 149, 156), C(215, 213, 198), C(209, 105, 144), "OCCHIETTO", "APPROVED +1", "bars" },
	QuietHours = { C(48, 50, 61), C(66, 51, 75), C(175, 184, 224), "NANNA NANNA", "DO NOT DISTURB", "moon" },
	AdminOverride = { C(31, 38, 40), C(38, 54, 51), C(126, 216, 191), "CAPO SUPREMO", "AUTH / LOCAL", "terminal" },
	FinalNotice = { C(54, 54, 59), C(107, 49, 49), C(205, 169, 99), "ULTIMO BUM", "PAST DUE / GG", "receipt" },
}

-- Print into the host face, so labels cannot obstruct a sight and remain attached to
-- the magazine/slide during every animation. Never use AlwaysOnTop on weapon markings.
--
-- Oliver's #72, "some guns have random floating texts on their texture in fps". Measured across all
-- 62 guns: 50 stamps, and the hosts were far too small to carry them. "CAPO SUPREMO" was printed onto
-- an AdminOverride slide face **0.019 studs wide** -- nineteen thousandths of a stud -- and a magazine
-- stamp covered 0.29 studs of a 0.365-stud face, i.e. four fifths of the magazine was lettering. Every
-- one was drawn from up to 80 studs away. A word squeezed onto a face that size, still being rendered
-- across a street, is not a marking; it is the floating text he is describing.
--
-- Two rules now, and both are in STUDS, because a fraction of "whatever face this happens to be" is
-- what produced the bug:
--   * a host whose printable face is smaller than MIN_FACE simply does not get a stamp;
--   * the lettering is at most MAX_INK studs tall whatever the face is, so it reads as a stencil on
--     the metal rather than as a banner stretched over the part.
-- MaxDistance drops to 10: a serial number is something you read with the gun in your hands.
local MIN_FACE = 0.09
local MAX_INK = 0.035

-- The two dimensions of `host`'s left face, in studs: along the barrel (Z) and up the side (Y).
local function leftFace(host)
	return host.Size.Z, host.Size.Y
end

local function stamp(host, text, ink, motif)
	local along, up = leftFace(host)
	if math.min(along, up) &lt; MIN_FACE then
		return false
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "ArsenalStamp"
	gui.Face = Enum.NormalId.Left
	gui.CanvasSize = Vector2.new(640, 160)
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.AlwaysOnTop = false
	gui.LightInfluence = 1
	gui.MaxDistance = 10
	gui.Parent = host
	-- The canvas is 160 tall and maps onto `up` studs of gun, so this is MAX_INK studs of lettering.
	local inkScale = math.min(0.8, MAX_INK / math.max(up, 1e-3))
	local word = Instance.new("TextLabel")
	word.BackgroundTransparency = 1
	word.Position = UDim2.fromScale(0.22, (1 - inkScale) / 2)
	word.Size = UDim2.fromScale(0.74, inkScale)
	word.Text = text
	word.TextColor3 = ink
	word.TextScaled = true
	word.Font = Enum.Font.RobotoMono
	word.Parent = gui
	local glyph = Instance.new("TextLabel")
	glyph.BackgroundTransparency = 1
	glyph.Position = UDim2.fromScale(0.02, (1 - inkScale) / 2)
	glyph.Size = UDim2.fromScale(0.18, inkScale)
	local symbols = { bars = "///", star = "*", signal = ")))", mountain = "/\\", grass = "\\|/", exit = "&gt;&gt;", receipt = "$", moon = ")", terminal = "&gt;_" }
	glyph.Text = symbols[motif] or "///"
	glyph.TextColor3 = ink
	glyph.TextScaled = true
	glyph.Font = Enum.Font.RobotoMono
	glyph.Parent = gui
	return true
end

function Finish.Apply(model, id, skinned)
	local look = looks[id]
	-- A signature rebuild (GunModelsSignature) has its own colours and markings, and none of the parts this
	-- recolours by name are where the stock build put them.
	if not look or model:GetAttribute("Signature") then return end
	model:SetAttribute("ArsenalPack", "AfterHours15")
	-- The legacy lever builder supplies a loading gate but no ejection keypoint.
	-- Its firing clip emits an eject event, so give this gun a real outlet there.
	if id == "SundaySpecial" then
		local gate = model:GetAttribute("KP_Load")
		model:SetAttribute("KP_Eject", CFrame.new(gate.Position) * CFrame.Angles(0, -math.pi / 2, 0))
	end
	local action = model:GetAttribute("Action")
	-- A revolver is one steel all over. Every metal part still in the frame's own finish takes the body
	-- colour (the darker flutes follow it), and only the wood is furniture; recolouring the frame alone
	-- left a bright barrel, cylinder, crane and hammer on a dark frame.
	local steel
	if action == "revolver" then
		local frame = model:FindFirstChild("Frame")
		steel = frame and frame.Color
	end
	local function sameColour(a, b)
		return math.abs(a.R - b.R) &lt; 0.002 and math.abs(a.G - b.G) &lt; 0.002 and math.abs(a.B - b.B) &lt; 0.002
	end
	local badgeHost, magazine
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") then
			local name = part.Name
			local body, furniture
			if action == "pistol" then
				-- A polymer pistol is two-tone, slide over frame: the frame, its grip, trigger guard, beavertail
				-- and the magazine's grip-shaped extension are one moulding, so they take one colour (a grip in
				-- one colour on a frame in another read as a sleeve that didn't sit flush).
				body = string.match(name, "^Slide") and not string.match(name, "^SlideStop")
				furniture = (string.match(name, "^Frame") and name ~= "FramePin") or string.match(name, "^Grip")
					or string.match(name, "^TriggerGuard") or string.match(name, "^Beavertail") or string.match(name, "^MagazineExtension")
			elseif steel then
				body = part.Material == Enum.Material.Metal and sameColour(part.Color, steel)
				furniture = string.match(name, "^Grip") and part.Material == Enum.Material.Wood
			else
				body = string.match(name, "^Receiver") or string.match(name, "^UpperWall") or string.match(name, "^Slide") or name == "Frame" or name == "TopStrap"
				furniture = string.match(name, "^Stock") or string.match(name, "^Handguard") or string.match(name, "^Grip") or string.match(name, "^Forend") or string.match(name, "^Pump") or name == "Magazine"
			end
			if not skinned and part.Transparency == 0 then
				if body then part.Color = look[1]
				elseif furniture then part.Color = look[2]
				elseif steel and name == "DrumFlute" then part.Color = look[1]:Lerp(Color3.new(0, 0, 0), 0.32) end
			end
			-- Rectangular hosts only; a cylinder's local X is its bore, not its left face.
			-- The BIGGEST candidate wins, not the first one found: several guns carry more than one part
			-- called Slide or Frame, and picking whichever came first landed a whole word on a
			-- nineteen-thousandths-of-a-stud sliver (#72). Compared by printable face area.
			if part:IsA("Part") and part.Shape == Enum.PartType.Block then
				local function bigger(a, b)
					return b == nil or (a.Size.Z * a.Size.Y) &gt; (b.Size.Z * b.Size.Y)
				end
				if (name == "Receiver" or name == "Slide" or name == "Frame") and bigger(part, badgeHost) then
					badgeHost = part
				end
				if name == "Magazine" and bigger(part, magazine) then
					magazine = part
				end
			end
		end
	end
	if badgeHost then stamp(badgeHost, look[4], look[3], look[6]) end
	if magazine then stamp(magazine, look[5], look[3], look[6]) end
	-- A bonded identification plate below the receiver's left face. It is thin,
	-- physically attached, and copies the host's moving group (not a floating charm).
	if badgeHost then
		local plate = Instance.new("Part")
		plate.Name = "ArsenalSerialPlate"
		plate.Size = Vector3.new(0.009, math.min(0.028, badgeHost.Size.Y * 0.2), math.min(0.12, badgeHost.Size.Z * 0.25))
		plate.CFrame = badgeHost.CFrame * CFrame.new(-badgeHost.Size.X / 2 - 0.003, -badgeHost.Size.Y * 0.27, badgeHost.Size.Z * 0.3)
		plate.Color = look[3]
		plate.Material = Enum.Material.Metal
		plate.CanCollide = false
		plate.CanTouch = false
		plate.CanQuery = false
		plate.Massless = true
		plate:SetAttribute("Anim", badgeHost:GetAttribute("Anim"))
		plate.Parent = model
	end
end

return Finish
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Ballistics</string><ProtectedString name="Source">-- Flight, bounce and blast math for everything that flies and blows up: launcher rounds, grenades and
-- smoke bombs. Shared, so the server's ProjectileService, the client that draws the rounds and the
-- arc preview, and tools/projectile_probe.lua all run exactly the same numbers. A preview drawn with
-- different maths from the real throw would be a lie on the screen.
--
--   Ballistics.Rounds[kind]                    launcher rounds ("rocket", "grenade"), by WeaponData's `projectile`
--   Ballistics.Throwables[itemId]              thrown items, by ItemData id
--   Ballistics.RoundState(spec, origin, direction, gravity, t)     position, velocity of a round at time t
--   Ballistics.RoundTimeFor(spec, distance)    how long a round takes to travel `distance` along its line
--   Ballistics.LeadAim(spec, origin, target, targetVelocity, gravity)   a point to aim at so the round hits
--   Ballistics.ThrowOrigin(head, direction)    where a thrown item leaves the hand
--   Ballistics.ThrowVelocity(spec, origin, aimPoint, carrierVelocity)
--   Ballistics.CarrierVelocity(velocity)       the thrower's run as a throw may carry it (flat, capped)
--   Ballistics.LobVelocity(origin, target, gravity, gravityScale)       lands on `target` (bots)
--   Ballistics.StepBody(body, dt, gravity, cast)   one step of a bouncing thrown body
--   Ballistics.BlastScale(distance, innerRadius, radius)   damage multiplier at a distance from a blast
--   Ballistics.SmokeRadius(cloud, now), Ballistics.SmokeDensity(cloud, now)
--   Ballistics.SmokeChord(cloud, a, b, now)    studs of dense smoke on the line from a to b
--
-- Gravity is always passed in (workspace.Gravity when the thing was launched), never read here, so a
-- Low Gravity match changes every arc the same way everywhere.

local Ballistics = {}

local UP = Vector3.yAxis

-- Launcher rounds: a registry keyed by WeaponData's `projectile`, so a new kind of round is data (and,
-- if it needs it, a few behaviour callbacks), never an edit to ProjectileService's loop. Add one with
-- Ballistics.RegisterRound(kind, spec). Damage and blast radius stay with the gun in WeaponData
-- (`damage`, `splashRadius`); a spec is how the round flies and what it does when it meets something.
--
--   motion        "line" (default): leaves at `speed`, reaches `maxSpeed` after `boostTime`, feels
--                 `gravityScale` of gravity; exact at any time, so clients replay it from one event.
--                 "body": bounces from the launch velocity (Ballistics.StepBody) like a thrown grenade.
--                 "free": velocity integrated each step, for rounds that steer; clients get a position
--                 correction every `syncEvery` seconds.
--   radius        collision radius
--   maxTime       bursts in the air after this long
--   armTime       ("line") a hit before this is a dud: it bounces and bursts `dudFuse` later
--   restitution, friction   ("body", and duds) how it bounces
--   fuse          ("body") bursts this long after launch; `impact = true` bursts on first contact instead
--   maxBounces    ("body") bursts on this contact at the latest
--   explosive     false: no blast, it only hurts whatever it hits directly (damage + impactBonus)
--   impactBonus   extra damage to whoever it hits directly
--   innerRadius   full blast damage inside this
--   wallDamage    what walls, floors and roofs within half the blast radius take
--   syncEvery     seconds between position corrections sent to clients ("free")
--
-- Behaviour callbacks, server-side, all optional. `api` is ProjectileService's toolkit (Explode,
-- DealDamage, Creditable, Targets, Report, Remove, Clock); `entry` is the live round (owner, weaponId, def (the gun,
-- for launcher rounds), kind, age, position, velocity, body, damage, radius). A round in flight that
-- strikes a Head part is a headshot: the direct part of its damage (impactBonus, or all of it when
-- `explosive = false`) takes the gun's headshotMultiplier; the blast never does.
--   onLaunch(entry, api)
--   steer(entry, dt, api)                 change entry.velocity ("free" motion)
--   onContact(entry, contact, api)        return "detonate", "bounce", "stop" (gone, no burst), "pass"
--                                         (fly on through it) or nil for the default rules
--   onDetonate(entry, blast, api)         adjust `blast` before it happens, or return false to cancel it
Ballistics.Rounds = {
	-- A PG-7V-style rocket: a booster kick out of the tube, then the sustainer carries it flat and fast.
	rocket = {
		speed = 120,
		maxSpeed = 260,
		boostTime = 0.35,
		gravityScale = 0.06,
		radius = 0.3,
		maxTime = 2.2,
		armTime = 0,
		impactBonus = 25,
		innerRadius = 3.5,
		wallDamage = 150,
	},
	-- A 40mm grenade: slower than a rocket, and it still drops, but it reaches now.
	--
	-- Oliver's #87, "make the grenade launcher launch grenades further". Measured through these very
	-- numbers at the live gravity (196.2), which is the arithmetic the server, the client's draw and
	-- the arc preview all share, so the figures below are the arcs he actually flies:
	--   was  speed 140, gravityScale 0.45 -&gt; a LEVEL shot from eye height hit the ground at 45.1 studs
	--                                        (so a target sixty studs away needed guesswork), best arc 227
	--   now  speed 180, gravityScale 0.36 -&gt; a level shot reaches 64.8 studs (+44%), best arc 463 (+104%)
	-- The level number is the one a player feels; the best arc is what a lobbed shot can reach.
	-- 200 / 0.34 was measured too (level 74.0, best arc 604) and deliberately NOT taken: it turns a
	-- grenade launcher into a 600-stud indirect weapon, which overshoots "further".
	grenade = {
		speed = 180,
		maxSpeed = 180,
		boostTime = 0,
		gravityScale = 0.36,
		radius = 0.22,
		maxTime = 5,
		armTime = 0.12,
		dudFuse = 0.8,
		restitution = 0.3,
		friction = 0.5,
		impactBonus = 12,
		innerRadius = 2.5,
		wallDamage = 110,
	},
}

function Ballistics.RegisterRound(kind, spec)
	assert(type(kind) == "string" and type(spec) == "table", "Ballistics.RegisterRound(kind, spec)")
	Ballistics.Rounds[kind] = spec
	return spec
end

-- Thrown items, keyed by ItemData id. Every one is thrown the same way (`speed` along the aim with a
-- little `lift`, plus `inherit` of the thrower's own run), bounces (`restitution`, `friction`) and
-- settles; `kind` says what it does.
--   frag    blows `fuse` seconds after the throw (less whatever was cooked off in the hand)
--   smoke   starts pouring smoke once it settles (or after `deployAfter` at most)
--   impact  bursts on the first thing it touches
--   sticky  sticks to the first thing it touches (a wall, a vehicle, a player) and rides with it;
--           blows `fuse` seconds after sticking. `stickOffset` is how far the model's origin sits
--           off the surface (its underside), for the stuck frame and the placement ghost.
Ballistics.Throwables = {
	CookedCoconut = {
		kind = "frag",
		speed = 85,
		lift = 0.1,
		inherit = 0.5,
		gravityScale = 0.5,
		radius = 0.42,
		restitution = 0.38,
		friction = 0.55,
		fuse = 3.2,
		cookable = true,
		blastDamage = 100,
		blastRadius = 13,
		innerRadius = 3.5,
		wallDamage = 120,
	},
	LowkeyLatte = {
		kind = "smoke",
		speed = 85,
		lift = 0.1,
		inherit = 0.5,
		gravityScale = 0.5,
		radius = 0.4,
		restitution = 0.22,
		friction = 0.7,
		deployAfter = 2.5,
		hiss = 0.6,
		smokeRadius = 16,
		grow = 2.2,
		hold = 14,
		fade = 4,
	},
	ClingyCrumpet = {
		kind = "sticky",
		speed = 82,
		lift = 0.12,
		inherit = 0.5,
		gravityScale = 0.55,
		radius = 0.45,
		restitution = 0,
		friction = 1,
		fuse = 2.5,
		stickOffset = 0.2,
		blastDamage = 110,
		blastRadius = 12,
		innerRadius = 3.5,
		wallDamage = 130,
	},
}

-- The frame of a stuck item: its origin `offset` off the surface point along the normal, its +Y along
-- the normal (underside on the surface), turned so it sits square to the world rather than to the
-- throw. The live model, the placement ghost and the gallery all place a stuck thing with this.
function Ballistics.StuckFrame(position, normal, offset)
	local up = normal.Magnitude &gt; 1e-4 and normal.Unit or UP
	local reference = math.abs(up.Y) &lt; 0.99 and UP or Vector3.xAxis
	local right = reference:Cross(up).Unit
	return CFrame.fromMatrix(position + up * (offset or 0), right, up, right:Cross(up))
end

-- A body this close to the blast counts as touching it: distances are measured from the root, and a
-- rocket at your feet is a metre or so from it.
Ballistics.BodyAllowance = 1.2
-- Damage at the very edge of the blast radius, as a share of full.
Ballistics.EdgeScale = 0.2
-- Smoke you can see through: a line with less than this much dense smoke on it isn't hidden.
Ballistics.SeeThrough = 6
-- Below this share of full density, a thinning cloud no longer hides anything.
Ballistics.HidingDensity = 0.5

-- A normal speed below this doesn't bounce: the body slides instead. Below `REST_SPEED` on the
-- ground, it stops.
local SLIDE_SPEED = 8
local REST_SPEED = 2.5
-- How far off a surface a body is left after touching it, so the next cast doesn't start inside it.
local SKIN = 0.02

--------------------------------------------------------------------------------
-- Launcher rounds
--------------------------------------------------------------------------------

-- Distance along the line and speed along it at time t.
local function travel(spec, t)
	local boost = spec.boostTime or 0
	local v0, v1 = spec.speed, spec.maxSpeed or spec.speed
	if boost &lt;= 0 or v1 == v0 then
		return v0 * t, v0
	end
	local accel = (v1 - v0) / boost
	if t &lt;= boost then
		return v0 * t + 0.5 * accel * t * t, v0 + accel * t
	end
	return v0 * boost + 0.5 * accel * boost * boost + v1 * (t - boost), v1
end

-- Where a round launched from `origin` along the unit `direction` is at time t, and its velocity.
function Ballistics.RoundState(spec, origin, direction, gravity, t)
	local g = gravity * spec.gravityScale
	local distance, speed = travel(spec, t)
	return origin + direction * distance - UP * (0.5 * g * t * t), direction * speed - UP * (g * t)
end

-- One step of a "free" round (one that steers): the kind's own `steer` with `api`, then gravity,
-- integrated the one way everyone integrates it. Returns the new position and velocity without
-- assigning them, since the server sweeps from the old position to the new one before it moves.
-- The server, the client's replay and the probe all step through here, so with the same dt and
-- the same targets they trace the same path.
function Ballistics.FreeStep(entry, dt, gravity, api)
	local spec = entry.spec
	if spec.steer then
		spec.steer(entry, dt, api)
	end
	local velocity = entry.velocity - UP * (gravity * (spec.gravityScale or 0) * dt)
	local position = entry.position + (entry.velocity + velocity) * (dt / 2)
	return position, velocity
end

-- How a round sits in the air, from its look's `spin` (see ThrowableModels' contract):
--   "none"   nose (-Z) along its velocity
--   "roll"   nose along its velocity, rolled about it by `angle`
--   "flat"   level, nose along the flat part of its velocity, spun about the up axis by `angle`
-- ("tumble" is a bouncing body's own rotation and isn't built here.)
function Ballistics.RoundOrientation(spin, position, velocity, angle)
	local speed = velocity.Magnitude
	local forward = speed &gt; 1e-3 and velocity / speed or -Vector3.zAxis
	if spin == "flat" then
		local flat = Vector3.new(forward.X, 0, forward.Z)
		flat = flat.Magnitude &gt; 1e-3 and flat.Unit or -Vector3.zAxis
		return CFrame.lookAt(position, position + flat, UP) * CFrame.Angles(0, angle or 0, 0)
	elseif spin == "roll" then
		return CFrame.lookAt(position, position + forward) * CFrame.Angles(0, 0, angle or 0)
	end
	local up = math.abs(forward.Y) &gt; 0.98 and Vector3.xAxis or UP
	return CFrame.lookAt(position, position + forward, up)
end

-- How fast each spin turns, in radians a second.
Ballistics.SpinRate = { flat = 22, roll = 30 }

-- The time at which a round has gone `distance` along its line (the inverse of `travel`).
function Ballistics.RoundTimeFor(spec, distance)
	local boost = spec.boostTime or 0
	local v0, v1 = spec.speed, spec.maxSpeed or spec.speed
	if boost &lt;= 0 or v1 == v0 then
		return distance / v0
	end
	local accel = (v1 - v0) / boost
	local boosted = v0 * boost + 0.5 * accel * boost * boost
	if distance &lt;= boosted then
		return (-v0 + math.sqrt(v0 * v0 + 2 * accel * distance)) / accel
	end
	return boost + (distance - boosted) / v1
end

-- A point to aim at from `origin` so a round meets a target now at `target` moving at `targetVelocity`:
-- ahead of it by the flight time, and above it by the drop over that time. The line the round is fired
-- along goes through the returned point. A few rounds of refinement settle it for anything in range.
function Ballistics.LeadAim(spec, origin, target, targetVelocity, gravity)
	local g = gravity * spec.gravityScale
	local velocity = targetVelocity or Vector3.zero
	local t = Ballistics.RoundTimeFor(spec, (target - origin).Magnitude)
	local line = target - origin
	for _ = 1, 6 do
		local predicted = target + velocity * t
		line = predicted - origin + UP * (0.5 * g * t * t)
		t = Ballistics.RoundTimeFor(spec, line.Magnitude)
	end
	return origin + line
end

--------------------------------------------------------------------------------
-- Thrown items
--------------------------------------------------------------------------------

-- The aim line from the head, lifted a touch, so the arc rises through the crosshair.
function Ballistics.ThrowDirection(spec, head, aimPoint)
	local offset = aimPoint - head
	local direction = offset.Magnitude &gt; 0.01 and offset.Unit or -Vector3.zAxis
	return (direction + UP * (spec.lift or 0)).Unit
end

function Ballistics.ThrowOrigin(head, direction)
	return head + direction * 1.2
end

-- The fastest a thrower's own run is taken to be: MatchConfig.BaseWalkSpeed 18 x SprintMultiplier 1.45 x
-- MovementConfig.Slide.PeakMultiplier 1.75 = 45.7, a flat-out slide. A player's root velocity is written
-- by their own client, so uncapped a modified client could report any speed and throw a grenade across the
-- map; faster legitimate carriers (a boosted sprint, a passenger in a car) carry this much and no more.
-- tools/throw_carry_check.py keeps this in step with those three numbers.
Ballistics.MaxCarrierSpeed = 46

-- The part of a thrower's velocity a throw inherits before `inherit` scales it: horizontal only, and never
-- faster than MaxCarrierSpeed. Anything that isn't a finite velocity carries nothing.
function Ballistics.CarrierVelocity(velocity)
	if not velocity then
		return Vector3.zero
	end
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = flat.Magnitude
	if speed ~= speed or speed == math.huge then
		return Vector3.zero
	end
	if speed &gt; Ballistics.MaxCarrierSpeed then
		return flat * (Ballistics.MaxCarrierSpeed / speed)
	end
	return flat
end

-- The launch velocity of a throw toward `aimPoint` from a head at `head`, by someone moving at
-- `carrierVelocity` (its horizontal part, capped, carries into the throw: CarrierVelocity).
function Ballistics.ThrowVelocity(spec, head, aimPoint, carrierVelocity)
	local direction = Ballistics.ThrowDirection(spec, head, aimPoint)
	return direction * spec.speed + Ballistics.CarrierVelocity(carrierVelocity) * (spec.inherit or 0)
end

-- A lob from `origin` that comes down on `target`: longer throws hang longer. For bots, which know
-- where they want it rather than where they're looking.
function Ballistics.LobVelocity(origin, target, gravity, gravityScale)
	local g = gravity * (gravityScale or 1)
	local offset = target - origin
	local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude
	local t = math.clamp(flat / 45, 0.45, 1.6)
	return Vector3.new(offset.X / t, offset.Y / t + 0.5 * g * t, offset.Z / t), t
end

-- One step of a thrown body. `body` is { position, velocity, spec, resting }; `cast(origin, radius,
-- displacement)` sweeps a sphere and returns what it hit ({ Position, Normal, Distance, Instance }) or
-- nil, and is where the caller decides what counts as solid (the server breaks glass inside it and
-- sweeps on). Returns the strongest contact this step as { position, normal, speed, instance }, or nil.
--
-- Up to three contacts are resolved in one step, so a body dropped into a corner doesn't stall a frame
-- per wall. A contact reflects the normal part of the velocity by `restitution` (or kills it below
-- SLIDE_SPEED, which is what turns a bounce into a slide) and takes `friction` off the tangential part
-- in proportion to how hard it landed, which is what makes a rolling grenade slow down on the ground.
function Ballistics.StepBody(body, dt, gravity, cast)
	if body.resting then
		return nil
	end
	local spec = body.spec
	local g = gravity * (spec.gravityScale or 1)
	-- A kind may bounce without saying how (a "bounce" verdict from a round with no numbers).
	local restitution = spec.restitution or 0.3
	local friction = spec.friction or 0.5
	local remaining = dt
	local strongest = nil

	for _ = 1, 3 do
		if remaining &lt;= 1e-5 then
			break
		end
		local velocity = body.velocity
		local displacement = velocity * remaining - UP * (0.5 * g * remaining * remaining)
		local length = displacement.Magnitude
		if length &lt; 1e-5 then
			body.velocity = velocity - UP * (g * remaining)
			break
		end
		local hit = cast(body.position, spec.radius, displacement)
		if not hit then
			body.position += displacement
			body.velocity = velocity - UP * (g * remaining)
			break
		end

		local fraction = math.clamp(hit.Distance / length, 0, 1)
		local elapsed = remaining * fraction
		body.position += displacement.Unit * math.max(0, hit.Distance - SKIN)
		velocity -= UP * (g * elapsed)
		remaining -= elapsed

		local normal = hit.Normal
		local into = velocity:Dot(normal)
		if into &lt; 0 then
			local tangent = velocity - normal * into
			local bounce = -into &gt; SLIDE_SPEED and -into * restitution or 0
			local grip = math.clamp(friction * (-into / 20), 0, 0.9)
			velocity = tangent * (1 - grip) + normal * bounce
			if not strongest or -into &gt; strongest.speed then
				strongest = { position = hit.Position, normal = normal, speed = -into, instance = hit.Instance }
			end
		end
		body.position += normal * SKIN
		body.velocity = velocity

		-- Settled on something flat enough to lie on.
		if normal.Y &gt; 0.6 and velocity.Magnitude &lt; REST_SPEED then
			body.velocity = Vector3.zero
			body.resting = true
			break
		end
	end
	return strongest
end

--------------------------------------------------------------------------------
-- Blasts
--------------------------------------------------------------------------------

-- Full damage inside `innerRadius`, falling in a straight line to EdgeScale at `radius`, nothing past
-- it. `distance` is from the blast to the body with BodyAllowance already taken off.
function Ballistics.BlastScale(distance, innerRadius, radius)
	if distance &gt; radius then
		return 0
	end
	if distance &lt;= innerRadius or radius &lt;= innerRadius then
		return 1
	end
	local t = (distance - innerRadius) / (radius - innerRadius)
	return 1 - t * (1 - Ballistics.EdgeScale)
end

--------------------------------------------------------------------------------
-- Smoke
--------------------------------------------------------------------------------

-- A cloud is { position, startedAt, spec }: `startedAt` is when it began pouring (after the hiss).

local function smoothstep(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

function Ballistics.SmokeRadius(cloud, now)
	local spec = cloud.spec
	return spec.smokeRadius * (0.25 + 0.75 * smoothstep((now - cloud.startedAt) / spec.grow))
end

-- 0 before it starts and after it's gone, 1 while it holds.
function Ballistics.SmokeDensity(cloud, now)
	local spec = cloud.spec
	local age = now - cloud.startedAt
	if age &lt; 0 then
		return 0
	end
	local fill = smoothstep(age / (spec.grow * 0.6))
	local thin = 1 - smoothstep((age - spec.grow - spec.hold) / spec.fade)
	return math.min(fill, thin)
end

function Ballistics.SmokeEndsAt(cloud)
	local spec = cloud.spec
	return cloud.startedAt + spec.grow + spec.hold + spec.fade
end

-- How many studs of the line from `a` to `b` pass through this cloud while it's dense enough to hide
-- anything (0 otherwise). A sphere, measured exactly: the chord of the segment inside it.
function Ballistics.SmokeChord(cloud, a, b, now)
	if Ballistics.SmokeDensity(cloud, now) &lt; Ballistics.HidingDensity then
		return 0
	end
	local radius = Ballistics.SmokeRadius(cloud, now)
	local line = b - a
	local length = line.Magnitude
	if length &lt; 1e-4 then
		return 0
	end
	local unit = line / length
	local toCentre = cloud.position - a
	local along = toCentre:Dot(unit)
	local missSquared = toCentre:Dot(toCentre) - along * along
	if missSquared &gt;= radius * radius then
		return 0
	end
	local half = math.sqrt(radius * radius - missSquared)
	local enter = math.max(0, along - half)
	local exit = math.min(length, along + half)
	return math.max(0, exit - enter)
end

--------------------------------------------------------------------------------
-- The gun rework's rounds (2026-09-24): the three new guns' own kinds
--------------------------------------------------------------------------------
-- Registered here rather than in a module of their own, so they exist wherever Ballistics is loaded:
-- the server before ProjectileService looks one up, and every client that draws them. Their models are
-- hand-built in GunModelsRounds (ThrowableModels.RoundBuilders); `look` is the fallback if that module is
-- not loaded.
--
--   mosquitoDart  Zanzarino Pikpik. A fast little dart with next to no drop that noses toward whoever is
--                 most nearly ahead of it, gently: inside a 10-degree cone, 6 degrees at most over its
--                 flight, so it forgives a near miss and never turns a wide miss into a hit.
--                 Non-explosive; the gun's `bleed` (the itch) comes from its WeaponData.
--   drumlet       Tamburo Tung Tung. A little drum lobbed with a kick upward. It bounces and goes off on
--                 its third contact, on anyone it touches, or 1.6 s after launch, whichever comes first.
--                 Three a shot, fanned (CombatService.Patterns.fan).
--   bananerang    Bananerang. Thrown out, it slows to a hang at the far end of its reach and comes back
--                 along the same curve (a slight bend to the right) to where it was thrown. It passes
--                 through people and cuts each one once on the way out and once on the way back; a wall
--                 stops it. Its path is a function of its age alone (Ballistics.BoomerangVelocity), so
--                 every client traces exactly the server's path.
--
-- `steer` runs on clients too and stays pure (see CreativeRounds). The boomerang's steer also clears, on
-- the server only, the people it passed through from its sweep filter as it turns, so it can meet them
-- again on the way back; that touches the filter, never the path.

local function roundHitInstance(contact)
	return contact and (contact.Instance or contact.instance) or nil
end

local function roundHitsCharacter(instance)
	local model = instance and instance:FindFirstAncestorOfClass("Model")
	return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
end

-- Homing: gently, and only toward someone already nearly in line.
Ballistics.DartHoming = { delay = 0.06, cone = math.rad(10), total = math.rad(6), rate = math.rad(60), range = 80 }

Ballistics.RegisterRound("mosquitoDart", {
	motion = "free",
	speed = 175,
	gravityScale = 0.05,
	radius = 0.18,
	maxTime = 1.6,
	explosive = false,
	impactBonus = 0,
	syncEvery = 0.1,
	look = { shape = "cylinder", size = 0.6, color = Color3.fromRGB(40, 40, 46), trim = Color3.fromRGB(240, 240, 240), spin = "none" },
	steer = function(entry, dt, api)
		local homing = Ballistics.DartHoming
		local turned = type(entry.turned) == "number" and entry.turned or 0
		if entry.age &lt; homing.delay or turned &gt;= homing.total then
			return
		end
		local speed = entry.velocity.Magnitude
		if speed &lt; 1 then
			return
		end
		local forward = entry.velocity / speed
		local best, bestDot = nil, math.cos(homing.cone)
		for _, target in ipairs(api.Targets(entry.position, homing.range, entry.owner)) do
			local to = target.root.Position - entry.position
			local distance = to.Magnitude
			if distance &gt; 0.5 then
				local dot = (to / distance):Dot(forward)
				if dot &gt; bestDot then
					best, bestDot = to / distance, dot
				end
			end
		end
		if not best then
			return
		end
		local angle = math.acos(math.clamp(forward:Dot(best), -1, 1))
		local turn = math.min(angle, homing.rate * dt, homing.total - turned)
		if angle &lt;= 1e-4 or turn &lt;= 0 then
			return
		end
		entry.turned = turned + turn
		entry.velocity = forward:Lerp(best, turn / angle).Unit * speed
	end,
	onContact = function(_entry, contact)
		if roundHitsCharacter(roundHitInstance(contact)) then
			return "detonate"
		end
		return "stop"
	end,
})

Ballistics.DrumletLift = 16

Ballistics.RegisterRound("drumlet", {
	motion = "body",
	speed = 115,
	gravityScale = 0.9,
	radius = 0.26,
	maxTime = 3,
	fuse = 1.6,
	maxBounces = 3,
	restitution = 0.55,
	friction = 0.35,
	impactBonus = 4,
	innerRadius = 1.5,
	wallDamage = 40,
	look = { shape = "cylinder", size = 0.5, color = Color3.fromRGB(200, 40, 50), trim = Color3.fromRGB(245, 240, 230), spin = "tumble" },
	onLaunch = function(entry)
		if entry.body then
			entry.body.velocity += Vector3.new(0, Ballistics.DrumletLift, 0)
		end
	end,
	onContact = function(_entry, contact)
		if roundHitsCharacter(roundHitInstance(contact)) then
			return "detonate"
		end
		return nil
	end,
})

-- The boomerang's flight: out along the throw, slowing to a hang at the far end (the reach is
-- speed x time / pi), and back the same way, bent `curve` x the reach to the right at the far end.
-- Past `catch` of its time it is back at the thrower's end: its time running out there is a catch.
Ballistics.Boomerang = { time = 1.5, curve = 0.1, catch = 0.9 }

-- The velocity of a boomerang `age` seconds after it was thrown along `memory.dir` at `memory.speed`.
function Ballistics.BoomerangVelocity(memory, age)
	local spec = Ballistics.Boomerang
	local u = math.clamp(age / spec.time, 0, 1)
	return memory.dir * (memory.speed * math.cos(math.pi * u))
		+ memory.side * (memory.speed * spec.curve * math.sin(2 * math.pi * u))
end

-- The boomerang's memory, from the velocity it was thrown with.
function Ballistics.BoomerangMemory(velocity)
	local speed = velocity.Magnitude
	local dir = speed &gt; 1e-3 and velocity / speed or -Vector3.zAxis
	local reference = math.abs(dir.Y) &gt; 0.95 and Vector3.xAxis or UP
	return { dir = dir, side = dir:Cross(reference).Unit, speed = speed }
end

Ballistics.RegisterRound("bananerang", {
	motion = "free",
	speed = 115,
	gravityScale = 0,
	radius = 0.45,
	maxTime = Ballistics.Boomerang.time,
	explosive = false,
	impactBonus = 0,
	syncEvery = 0.12,
	look = { shape = "disc", size = 1.1, color = Color3.fromRGB(250, 214, 60), glow = Color3.fromRGB(255, 240, 140), spin = "flat" },
	steer = function(entry, dt)
		local memory = entry.turned
		if type(memory) ~= "table" then
			memory = Ballistics.BoomerangMemory(entry.velocity)
			entry.turned = memory
			-- Server only: what the sweep filter held at the throw (the thrower), kept through the turn.
			if type(entry.filter) == "table" then
				memory.base = #entry.filter
			end
		end
		-- Sampled mid-step, so the stepped path keeps to the exact one.
		entry.velocity = Ballistics.BoomerangVelocity(memory, math.max(0, entry.age - dt / 2))
		if memory.base and not memory.back and entry.age &gt;= Ballistics.Boomerang.time / 2 then
			memory.back = true
			for index = #entry.filter, memory.base + 1, -1 do
				table.remove(entry.filter, index)
			end
			entry.params.FilterDescendantsInstances = entry.filter
		end
	end,
	onContact = function(entry, contact, api)
		local instance = roundHitInstance(contact)
		if not roundHitsCharacter(instance) then
			return "detonate"
		end
		local pass = entry.age &lt; Ballistics.Boomerang.time / 2 and 1 or 2
		entry.cut = entry.cut or {}
		local at = contact.Position or contact.position
		for _, target in ipairs(api.Targets(at, 10, entry.owner)) do
			local character = target.root.Parent
			if character and instance:IsDescendantOf(character) then
				if entry.cut[target.token] ~= pass then
					entry.cut[target.token] = pass
					-- Credited as a burst credits its hit: to nobody once the thrower has left.
					local attacker = entry.owner
					if api.Creditable then
						attacker = api.Creditable(entry.owner)
					end
					api.DealDamage(attacker, target.token, entry.damage, entry.weaponId, false)
				end
				break
			end
		end
		return "pass"
	end,
	onDetonate = function(entry, blast)
		if not blast.direct and entry.age &gt;= Ballistics.Boomerang.time * Ballistics.Boomerang.catch then
			return false
		end
		return nil
	end,
})

return Ballistics
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">BattlePassData</string><ProtectedString name="Source">-- The Brainrot Pass: a free track everyone earns, a premium track unlocked by gamepass,
-- and a daily login streak on the side.

local BattlePassData = {}

BattlePassData.MaxTier = 50
BattlePassData.XpPerTier = 1000

-- Tier rewards are generated rather than hand-listed so the curve stays consistent and you
-- can change MaxTier without editing 50 table entries.
local function tierReward(tier, premium)
	if tier % 10 == 0 then
		return {
			kind = "Crate",
			crate = premium and (tier &gt;= 40 and "Legendary" or "Epic") or (tier &gt;= 30 and "Rare" or "Uncommon"),
		}
	end
	if tier % 5 == 0 then
		return { kind = "Cosmetic", pool = premium and "premium" or "free" }
	end
	return {
		kind = "Coins",
		amount = (premium and 400 or 150) + tier * (premium and 45 or 18),
	}
end

BattlePassData.Tiers = {}
for tier = 1, BattlePassData.MaxTier do
	BattlePassData.Tiers[tier] = {
		tier = tier,
		free = tierReward(tier, false),
		premium = tierReward(tier, true),
	}
end

-- Seven-day login cycle. Missing a day resets the streak to day 1.
BattlePassData.DailyRewards = {
	{ kind = "Coins", amount = 250 },
	{ kind = "Coins", amount = 400 },
	{ kind = "Crate", crate = "Common" },
	{ kind = "Coins", amount = 800 },
	{ kind = "Crate", crate = "Uncommon" },
	{ kind = "Coins", amount = 1500 },
	{ kind = "Crate", crate = "Rare" },
}

BattlePassData.DailyCycle = #BattlePassData.DailyRewards

-- Cosmetics handed out by the pass, by track.
BattlePassData.CosmeticPools = {
	free = { "BananiniYellow", "PartyCone", "CrocodiloCamo", "ChefHat" },
	premium = { "CappuccinaPink", "VikingHelm", "VoidRot", "RotAura", "ToasterPack", "GoldSahur", "SahurAura" },
}

function BattlePassData.TierForXp(xp)
	return math.min(BattlePassData.MaxTier, math.floor(xp / BattlePassData.XpPerTier) + 1)
end

function BattlePassData.XpIntoTier(xp)
	return xp % BattlePassData.XpPerTier
end

return BattlePassData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">BrainrotAssetCandidates</string><ProtectedString name="Source">-- Curated Creator Store candidates for the established meme characters in BrainrotData.
--
-- REVIEW DATA ONLY.  Production does not require this module and it never calls LoadAsset.
-- These were searched in Roblox's live Creator Store index and visually checked from Roblox's
-- own 420px model thumbnails on 2026-09-19.  Import into a separate review folder first.  For
-- entries marked containsScripts, delete every LuaSourceContainer while the returned asset is
-- still unparented; never run free-model code.
--
-- The rest of BrainrotData is original to Brain Rot Royale, so an existing model cannot be an
-- authoritative match for those names.  They need original art rather than unrelated free models.

return {
	["Tung Tung Tung Sahur"] = {
		assetId = 138151705692565,
		creator = "ATMnou",
		containsScripts = false,
		quality = "high-detail single-mesh original look: wood humanoid, human feet, bat",
	},
	["Golden Sahur"] = {
		-- Use the Tung mesh above with a gold material/texture variant; there is no separate canonical
		-- Golden Sahur design worth importing.
		assetId = 138151705692565,
		creator = "ATMnou",
		containsScripts = false,
		variant = "gold",
		quality = "recolour of the high-detail Tung mesh",
	},
	["Bombardiro Crocodilo"] = {
		assetId = 91327024837680,
		creator = "F0g_02",
		containsScripts = true,
		quality = "high-detail crocodile head integrated into a bomber aircraft",
	},
	["Tralalero Tralala"] = {
		assetId = 129482668414941,
		creator = "F0g_02",
		containsScripts = true,
		quality = "realistic shark body with blue sneakers; strongest detailed Store option",
	},
	["Chimpanzini Bananini"] = {
		assetId = 83732984780551,
		creator = "xXH3nry_AltXx",
		containsScripts = false,
		quality = "high-detail green chimp emerging from a peeled banana",
	},
	["Boneca Ambalabu"] = {
		assetId = 125906339004688,
		creator = "Haxcyc_LDC",
		containsScripts = false,
		quality = "high-detail frog head, tire torso, frog/human legs",
	},
	["Lirili Larila"] = {
		assetId = 77231614368559,
		creator = "giacomorixYT",
		containsScripts = false,
		quality = "high-detail cactus elephant with oversized sandals",
	},
	["Ballerina Cappuccina"] = {
		assetId = 75983792852042,
		creator = "hexsunez251",
		containsScripts = true,
		quality = "recognizable cup-headed ballerina, but blockier than the other selected assets",
		caveat = "candidate only; should be replaced if a higher-detail licensed model is found",
	},
	["Brr Brr Patapim"] = {
		assetId = 100538198930997,
		creator = "Haxcyc_LDC",
		containsScripts = false,
		quality = "high-detail forest creature with bark, foliage and oversized human feet",
	},
	["Frigo Camelo"] = {
		assetId = 136392638607318,
		creator = "Thaiskiy",
		containsScripts = false,
		quality = "high-detail camel head and legs fused with a refrigerator body",
	},
	["Bombombini Gusini"] = {
		assetId = 76661728011648,
		creator = "Luciano_Lol97",
		containsScripts = false,
		quality = "detailed white goose aircraft with multiple jet engines",
	},
	["La Vacca Saturno Saturnita"] = {
		assetId = 79911767286448,
		creator = "hexsunez251",
		containsScripts = true,
		quality = "cow head, Saturn body/rings and human feet with a blue cosmic aura",
		caveat = "recognizable but stylized/blocky; candidate only",
	},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">BrainrotCodex</string><ProtectedString name="Source">-- Codex flavour text: one entry for every brainrot in BrainrotData.Types.
--
-- Kept in its own file rather than as a field on BrainrotData, because that file is being
-- restructured on the build machine and this is 126 lines of pure text that collides with nothing.
-- Nothing reads it yet; wiring it to a detail panel is the menu worker's call.
--
-- KEYED BY NAME, not by id. BrainrotData entries have no `id` field — `name` is the identity, and
-- the file says so ("saved collections store brainrots by name"). So does the profile, and so does
-- MenuClient's `counts[def.name]`. A codex keyed by anything else would need an id to exist first.
--
-- Provenance: the first two sentences of every entry are the drafts sent to the mailbox on
-- 2026-09-21 (`...-bimjom-task03-brainrot-descriptions-DRAFT.lua`), kept verbatim. They were
-- written to a 76-character Codex ROW. claude-43's reply moved the target to a detail panel with
-- room for "two or three sentences", so each entry gains a third sentence here and the limit goes
-- from 76 to 160. Nothing drafted was thrown away.
--
--------------------------------------------------------------------------------
-- The voice, so a later entry matches the ones already here
--------------------------------------------------------------------------------
--
-- Read the crate blurbs in CrateData.lua first: flat, declarative, third person, full stop at the
-- end, no exclamation marks. The codex is that house voice with a joke in it, not a louder one.
--
--   * Three sentences. What it looks like, what it does, then the deadpan consequence of both
--     being true. The third is the one that can be cut if a panel turns out tighter than this.
--   * Third person, present tense. The brainrot is the subject.
--   * Its own name never appears in its entry — the row above already shows it.
--   * No exclamation marks, no capitals for emphasis, no emoji.
--   * Every line is written from that entry's own `look` and `move` fields and nothing else.
--   * Playable for a young audience: nothing cruel, nothing gory, nobody dies.
--   * Original writing. Twelve entries carry a name that is also a known meme's; they get no
--     catchphrase and no borrowed lore, only the model THIS project builds. See the mailbox note
--     on those names — they were already in the data and renaming them is not ours to do.

local BrainrotCodex = {}

-- The longest line the UI can show, in characters.
--
-- The chain, all of it quoted from the tree:
--   UiKit.panelSize  -&gt;  math.clamp(viewport.X - safe.Left - safe.Right, 320, 1180)
--   MenuClient:180   -&gt;  "a portrait phone leaves about 296 px of content"
--   a content row    -&gt;  UDim2.new(1, -8, ...), so 288 px of card
--   card padding     -&gt;  14 px each side, as every stat row in MenuClient uses
--   = a 260 px text column on the narrowest screen the menu is drawn for.
--
-- ASSUMPTION, and it is the soft part of this number: Gotham's average advance is taken as
-- 0.5 x TextSize, so 6.5 px at the body size of 13. That gives 40 characters a line, and a detail
-- panel four lines tall gives 160. Nothing here has measured a real glyph — TextService only runs
-- inside Studio. When the detail panel exists and can be measured, re-derive this and trim; the
-- checker reports the longest entry against the limit every run, so the headroom is always visible.
BrainrotCodex.MaxLength = 160

BrainrotCodex.Entries = {
	--------------------------------------------------------------------------------
	-- Common
	--------------------------------------------------------------------------------
	["Tung Tung Tung Sahur"] = "A wooden bean with two arms and one plan. The plan is a very big bonk. It has never needed a second plan.",
	["Bombardiro Crocodilo"] = "A green blob with wings, fangs and no brakes. Drops things from above. Nobody ever taught it to land.",
	["Trippi Troppi"] = "A teal stack with ears and no plan. Pops bubbles at whoever is near. It hums one note the entire time.",
	["Pizzarino Blobbo"] = "A pizza that grew a face and a cap. Spits pepperoni, which is a waste. It privately agrees with you.",
	["Sockolino Stinko"] = "A lone sock that never found its pair. Lobs a smell that arrives first. Standing downwind counts as a hit.",
	["Toastini Crunchi"] = "Toast with arms and opinions. Slams crust-first, so mind the crumbs. It was set one notch too dark and kept the grudge.",
	["Bubblo Gummo"] = "A chewed pink blob with a bow. Spits gum that sticks to everyone. It blows a bubble first, out of politeness.",
	["Noodlo Wobblo"] = "A wobbling stack with noodles for hair. Whips with them, and it stings. Nothing with no bones should move that fast.",
	["Cactino Pokko"] = "A small cactus with a flower and a grudge. Fires needles, looks innocent. Compliment the flower and it may hold off.",
	["Mudlo Splosh"] = "A puddle that learned to walk. Lobs mud and leaves footprints on the carpet. It has no solid parts to argue with.",
	["Spaghettino Twirlo"] = "A ball of spaghetti with a fork still in it. Lashes with a noodle, twirled. It is somehow always still warm.",
	["Gommino Rimbalzo"] = "A rubbery green stack on two feet. Bounces once into you and once away. It has never come to a complete stop.",
	["Pomodorino Schizzo"] = "A blushing tomato with its tongue out. Squirts sauce that never washes out. It considers the tablecloth afterwards.",
	["Biscottino Crumbo"] = "A chocolate chip cookie with a small smile. Crashes down, leaves crumbs. It was baked hard enough to count as masonry.",
	["Lumachina Lenta"] = "A snail in no hurry at all. Lobs slime in a slow arc that still gets there. It set off when the match started.",
	["Ombrellino Pioggia"] = "A blushing umbrella with a face. Its drizzle beam is wet and mildly rude. It would rather make rain than stop it.",
	["Patatina Fritta"] = "A carton of fries with big eyes. Fires salt, and the salt finds your eyes. Cold, hard and deeply resentful.",
	["Mattoncino Blocco"] = "A brick with a frown. Drops on you, which is all a brick can really do. One move, and it has never needed a second.",
	["Nuvoletta Pioviggina"] = "A small sleepy cloud, blushing. Rains on one person only, and it is you. Too small to matter, too stubborn to go.",
	["Pulcinello Piumino"] = "A chick still wearing half its shell. Flicks feathers, and feathers do hurt. Hatched early and entirely unbothered.",
	["Gelatino Tremolo"] = "A green jelly that cannot stop shaking. The wobble is catching. It never fully set and has made peace with that.",
	["Salsiccia Saltella"] = "A sausage on two feet, still sizzling. Hops on you, and now you sizzle too. It left the pan some time ago.",
	["Cipollina Lacrima"] = "A worried little onion, already crying. Its tear beam makes you cry as well. The beam is thin and entirely unfair.",
	["Formichina Operaia"] = "A hard-working ant on six legs. Its zap is passed along like a heavy crumb. It has never once dropped the crumb.",
	["Bottoncino Cucito"] = "A pink button with four holes and a smile. Zaps along a thread nobody sees. The coat it came off is long gone.",
	["Radicchio Rotolo"] = "A purple lettuce with teeth and a bad attitude. Tosses leaves, bitterly. It grows them back by teatime.",

	--------------------------------------------------------------------------------
	-- Uncommon
	--------------------------------------------------------------------------------
	["Tralalero Tralala"] = "A blue disc on two feet, grinning. Fires a wave beam and keeps walking. The beam is on the beat, which does not help.",
	["Chimpanzini Bananini"] = "A smiling banana with ears. Tosses peels, and peels do what peels do. It keeps the rest of itself for later.",
	["Boneca Ambalabu"] = "A red cube on two feet, scowling. Hops up, comes down, repeats. The hop is the only warning you get.",
	["Cappellino Fizzolo"] = "A fizzy bean in a cap and visor. Its beam tingles like fizz up the nose. The visor is for the glare, it says, indoors.",
	["Lamponi Brillo"] = "A glossy raspberry with a leaf on top. Lobs berries that burst on arrival. It has more segments than it needs.",
	["Frullato Vortini"] = "A one-eyed blender with a propeller. Spins, and anyone nearby is smoothie. The lid went missing years ago.",
	["Gnocco Grumpini"] = "A grey lump with horns and no patience. Stomps because talking never worked. It waits for the ground to apologise.",
	["Pinguino Scivolo"] = "A penguin in a scarf, in a hurry. Belly slides into anyone in the way. It arrives faster than it can stop.",
	["Zucchero Scintilla"] = "A sugar cube gone slightly pixelated. Sparks when excited, which is always. It is banned from the kitchen.",
	["Lanternino Lucciola"] = "A sleepy firefly with a lamp for a tail. Flickers, and the flicker zaps. The flicker is a countdown to something.",
	["Cuscino Pisolone"] = "A pillow in a nightcap, very comfy. Its nap wave makes everyone drowsy. Comfort at this level had to be classified.",
	["Pesciolino Bolla"] = "A striped orange fish with big eyes. Blasts bubbles that pop in your face. It carries its own water everywhere.",
	["Cavolfiore Cervello"] = "A cauliflower that looks like a brain and knows it. Its brain wave is a zap. It thinks at people from across the road.",
	["Ghiacciolo Sorbetto"] = "A striped ice lolly, melting slowly. Bursts cold in every direction at once. It refuses to finish, out of spite.",
	["Ragnetto Tessitore"] = "A purple spider with three eyes. Its web links two victims together. It has never once explained the plan.",
	["Tamburino Bum Bum"] = "A red drum with arms, playing itself. Its drum roll shakes everyone nearby. The roll builds, then the floor disagrees.",
	["Pantofolina Morbida"] = "A fluffy pink slipper with ears, half asleep. Smacks softly, but it counts. The contradiction is the whole point.",
	["Cactusello Danzante"] = "A tall dancing cactus with a flower. Pops prickles while doing the steps. It has lost neighbours to the hobby.",
	["Zucchina Lanterna"] = "A carved gourd with a glowing face. Lobs light heavier than it looks. It was carved by somebody in a hurry.",
	["Koalino Pennichella"] = "A grey koala mid-nap. Slams without waking up, then sleeps on you. Asleep twenty-two hours, a menace for the rest.",
	["Fornellino Fiammella"] = "A little stove with knobs and a pilot light. Its zap is a small blue flame. It has waited years to be useful.",
	["Biscione Arrotolato"] = "A coiled green snake with yellow stripes. Spits, then coils back up. It is far longer than the coil suggests.",
	["Nocciolino Ninja"] = "A hazelnut in a cape and headband. Its tap from the shadows is a bonk. You are tapped, then you are on the floor.",
	["Pinna Surfista"] = "A fin in sunglasses with a surfboard. Tosses waves, and that is the trick. There is no shark attached to it.",

	--------------------------------------------------------------------------------
	-- Rare
	--------------------------------------------------------------------------------
	["Lirili Larila"] = "A sleepy green bean covered in spikes. Fires thorns with its eyes shut. It goes straight back to sleep afterwards.",
	["Ballerina Cappuccina"] = "A coffee-coloured stack with a bow. Spins fast enough to knock you over. It has not spilled a single drop.",
	["Brr Brr Patapim"] = "A leafy green blob with a moustache and feet. Stomps twice, never once. That is how it keeps itself warm.",
	["Robottino Bip Bop"] = "A metal box with an antenna and a laser. Beeps before it fires, politely. It was built in the wrong decade.",
	["Draghetto Tostato"] = "A red dragon the size of a kettle. Breathes just enough fire to burn toast. It is sensitive about this.",
	["Polpetta Orbitale"] = "A meatball with orbiting sauce. Lobs itself, which ends badly for you. It does come back down eventually.",
	["Nuvolino Tuono"] = "A sleepy cloud carrying one bolt. Zaps one, then the next, without waking. The bolt picks whoever stood nearest.",
	["Fungo Saltarello"] = "A blushing mushroom on two feet. Stomps, and everyone breathes spores. It should stay put, and it will not.",
	["Tartarughino Turbo"] = "A turtle with an exhaust pipe on its shell. Rushes in, a first for turtles. Steering was left out of the design.",
	["Sirenetta Bollicina"] = "A small mermaid with a bow. Fires bubbles by the dozen, never one at a time. It sings the whole way through.",
	["Magnetino Attrazione"] = "A red horseshoe magnet with a visor. Pulls in one enemy, then a second. It has collected every loose screw here.",
	["Gufetto Professore"] = "A small owl in a monocle and mortarboard. Its lecture beam goes on a while. There is no interrupting it.",
	["Polipo Pittore"] = "An octopus in a beret, tentacles in paint. Splashes ink and calls it art. Every piece is a direct hit.",
	["Cervo Neon"] = "A brown deer with mint glowing antlers. Its zap arcs from one to the next. It is wired for night use.",
	["Pipistrello Bollente"] = "A bat that runs hot, with big ears. Its screech comes out as spit, somehow. The screech arrives first, mercifully.",
	["Scatolone Robusto"] = "A cardboard box in a tie. Crushes you flat and stacks neatly afterwards. It calls falling over a technique.",
	["Cucciolo Cometa"] = "A see-through puppy with a comet for a tail. Zaps you, then wants a cuddle. Nobody has measured it sitting still.",
	["Riccio Rotante"] = "A blushing hedgehog on two feet. Spins, and the quills go everywhere. It curls up for safety and keeps going.",
	["Barattolo Miele"] = "A sleepy honey jar with wings, dripping. Drops honey, and it stays dropped. The lid has been loose for years.",
	["Tricheco Baffone"] = "A walrus with a huge moustache, mostly asleep. One tusk thump, then done. It lets the tusks do the explaining.",
	["Faro Guardiano"] = "A striped lighthouse with a lamp on top. The beam sweeps round, finds you. It walked off its cliff and kept working.",
	["Ape Operosa"] = "A busy bee with a stinger and big eyes. Its buzz zaps one, then the next. It files a short report after each.",
	["Granchio Tenaglia"] = "A red crab with big claws and a worried look. Pinches first, worries later. Sideways has always been enough.",

	--------------------------------------------------------------------------------
	-- Epic
	--------------------------------------------------------------------------------
	["Frigo Camelo"] = "A fridge with humps and arms. Its frost ray is colder than the leftovers. It crossed a desert and never lost its cool.",
	["Bombombini Gusini"] = "A grey goose with wings, a tail and a temper. Its honks land as bombs. The honk arrives a moment before the bang.",
	["Vulcanino Brontolo"] = "A small grumbling volcano with cracks in it. Pulses magma when annoyed. It is annoyed shortly after meeting you.",
	["Specchio Riflesso"] = "A mirrored cube with an orbiting spark. Its zap bounces to whoever looks. It gives back more than it was shown.",
	["Gufo Mezzanotte"] = "A navy owl with very large eyes. Fires a night beam and sees you blink. It only exists between midnight and four.",
	["Serpentino Zigzag"] = "A lime snake with a purple zigzag. Spits darts, never in a straight line. The darts go straight, which is the problem.",
	["Astronauta Pisolino"] = "An astronaut napping on the job. Lobs moon rocks in its sleep. It pocketed them up there and declared none.",
	["Cavaliere Croissant"] = "A croissant in a plumed helmet, flaky and brave. Charges, leaving butter. The armour shatters beautifully.",
	["Stregonella Zucca"] = "A fanged pumpkin in a witch's hat. Lobs a hex, and the hex is a pumpkin. The whole spellbook is gourds.",
	["Nebbiolina Specchio"] = "A one-eyed disc of mist. Its beam is hard to see and harder to dodge. You aim at the reflection and hit nothing.",
	["Mago Merendina"] = "A bearded wizard with a snack in his hat. The snack is the spell. Every spell is filling and none are good for you.",
	["Cavaliere Lattina"] = "A tin can in a cape and plumed helmet. Charges, and both of you dent. The helmet fitted, so it kept the helmet.",
	["Medusa Lucente"] = "A glowing lilac jellyfish, dozy. Its sting hops from one enemy to the next. It glows at a depth where nothing should.",
	["Unicorno Frizzante"] = "A unicorn with heart eyes and a pink mane. Zaps sparkles, sincerely. It runs on fizzy drink and refuses water.",
	["Tuba Tuonante"] = "A gold tuba in headphones, furious. One note, and everyone nearby feels it. Windows go before ears do.",
	["Scheletrino Ballerino"] = "A skeleton in a bow tie, all ribs and rhythm. Bonks you, on the beat. It has not stopped dancing in years.",
	["Astronave Formaggio"] = "A flying saucer made of cheese. Lobs cheese from orbit, holes and all. Nobody briefed the crew on the mission.",
	["Drago Pantofola"] = "A dragon shaped like a fuzzy slipper. Its cosy flame is still fire. It is warm, and the burn is not gentle.",
	["Lupo Lunare"] = "A grey wolf with a moon gem on its forehead. Howls, and the howl is a beam. The answer comes from somewhere else.",
	["Ciclope Cioccolato"] = "A one-eyed chocolate giant, melting a little. Its quake is warm and sticky. The ground goes soft where it stamps.",
	["Nuvola Temporale"] = "A dark storm cloud holding a bolt. Its fork lightning takes two at a time. A full storm packed into a personal size.",

	--------------------------------------------------------------------------------
	-- Legendary
	--------------------------------------------------------------------------------
	["La Vacca Saturno Saturnita"] = "A spotted cow with a ring round its middle. Its quake rattles the ring. It will not say where the ring came from.",
	["Golden Sahur"] = "A solid gold bean in a crown. Bonks like the wooden one, only shinier. It hits considerably harder and knows it.",
	["Re Formaggione"] = "A king made of cheese, holes and all. Its royal wave is a smell you bow to. The court left several years ago.",
	["Galassia Sognante"] = "A glowing purple disc with a halo and one eye. Its zap hops between stars. It is having a slow dream about coins.",
	["Drago Arcobaleno"] = "A pink dragon breathing every colour at once. Prism breath, no refunds. Each colour hurts a different way.",
	["Fantasmino Eterno"] = "A see-through ghost with a halo. Its ray goes through you, and so does it. It forgot what it was haunting.",
	["Imperatore Gelato"] = "An ice cream emperor in a crown and scarf. Brain freeze, no spoon needed. The kingdom keeps melting under it.",
	["Titano Tostapane"] = "A fridge-sized toaster with arms. Lobs burnt toast until the room smells. It is still set one notch too dark.",
	["Imperatrice Farfalla"] = "A pink butterfly empress in a crown. Zaps one subject, then the next. Her smallest movement moves the weather.",
	["Faraone Fagiolino"] = "A golden bean in a pharaoh's headdress. Buries everyone nearby in sand. It was dug back up in a bad mood.",
	["Balena Cantante"] = "A blue whale in headphones, humming. Lobs a song, and the song lands hard. The note started before the match did.",
	["Titano Tuttifrutti"] = "A giant fruit cube with a cherry on top. Its fruit punch is a real punch. It was assembled from the whole bowl.",
	["Stregone Stellato"] = "A navy wizard with stars for eyes. Calls down a star, aimed at you. He borrows the light and never returns it.",
	["Leone Lampadina"] = "A lion with a lightbulb mane and a bolt. Its roar is bright enough to spit. It lights the field and blinds it too.",
	["Castello Ambulante"] = "A stone castle on two feet, with three eyes. Stomps, and the walls join in. It left its hill without notice.",
	["Capitano Calamaro"] = "A squid captain in a top hat, winking. Its ink broadside hits two ships. There is no ship under the gun deck.",

	--------------------------------------------------------------------------------
	-- Mythic
	--------------------------------------------------------------------------------
	["Fenice Pixelata"] = "A phoenix at a very low resolution. Burns down, reloads, burns again. It is currently on version nine.",
	["Kraken Caramello"] = "A caramel kraken, still dripping. Its tentacles link one enemy to the next. Once it has hold, it has hold of both.",
	["Oracolo Lavatrice"] = "A washing machine with a halo. It knows your future and puts it on a spin. It has been right enough times to worry.",
	["Drago Gelatina"] = "A see-through jelly dragon with wings. Lobs wobbles that go off on impact. It never quite set overnight.",
	["Samurai Sushi"] = "A sushi roll with a topknot and moustache. One slash, then the wasabi. Assembled at the counter, served at once.",
	["Grifone Glassato"] = "A griffin with a sugar glaze, still dripping. Dives beak-first, frosts you. The party it was iced for was called off.",
	["Golem Gorgonzola"] = "A colossus of blue cheese with three eyes. Its bonk is heavy and lingers. It was left too long in the dark.",
	["Sfinge Sussurrante"] = "A golden sphinx with stars for eyes. Its beam is a riddle you get wrong. It lowered its voice a century ago.",
	["Leviatano Limonata"] = "A sea monster made of lemonade. Its fizz chains from one enemy to the next. The fizz reaches the shore first.",
	["Mecha Mortadella"] = "A pink deli meat in a robot suit. Overdrives, and the whole deli shakes. It runs hot and smells incredible.",

	--------------------------------------------------------------------------------
	-- Secret
	--------------------------------------------------------------------------------
	["Il Glitch Primordiale"] = "The first bug there ever was, with a halo. Its zap tears reality a little. What it touches stops being where it was.",
	["Cosmo Nonno Stellare"] = "A bearded grandpa in a nightcap, ringed by stars. His nap began everything. He is older than the light, and tired.",
	["Arcobalenissimo"] = "A winged disc of every colour, with a halo. Its beam never runs out. Looking at it is a decision you make once.",
	["L'Ultimo Pixel"] = "The very last pixel, with a halo. Renders one enemy, then the next. It works down the list and does not hurry.",
	["Nonna Nebulosa"] = "A blushing nebula with a bun and goggles. Her gravity pulls you in for tea. Declining is not one of the options.",
	["Il Buco Nero Bello"] = "A black hole with one eye and petals. Its hug is a beam nothing escapes. It only ever wanted the hug.",
}

-- The entry for `name`, or nil if there is none. Callers should treat nil as "no text yet" and draw
-- the panel without it rather than substituting a placeholder — a placeholder that ships reads as
-- finished text, and the checker cannot tell one from a real line.
function BrainrotCodex.Get(name)
	return BrainrotCodex.Entries[name]
end

return BrainrotCodex
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">BrainrotData</string><ProtectedString name="Source">-- Every collectible brainrot.
--
--   coinValue  what selling one pays in SahurCoins
--   attack     how it fights as a companion (see Attacks below)
--   move       the name shown for that attack
--   power      optional per-brainrot damage tweak on top of the rarity baseline
--   look       how BrainrotModels builds it: body shape, colours, face and extras
--
-- Rarity sets the baseline damage, cooldown and range, so a Legendary always hits harder than
-- an Epic regardless of attack type. Names are kept exactly as they were for the original set
-- — saved collections store brainrots by name.

local BrainrotData = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local FOIL = Enum.Material.Foil
local NEON = Enum.Material.Neon
local GLASS = Enum.Material.Glass

--------------------------------------------------------------------------------
-- Companion attacks
--------------------------------------------------------------------------------

BrainrotData.Attacks = {
	Spit = { label = "Spit", range = 110, cooldown = 1.6, power = 1.0, splash = 0,
		description = "Fires a glob at one enemy" },
	Bonk = { label = "Bonk", range = 60, cooldown = 1.9, power = 1.3, splash = 7,
		description = "Leaps in and slams, splashing anyone close" },
	Zap = { label = "Zap", range = 100, cooldown = 1.35, power = 0.85, splash = 0,
		description = "Instant beam — never misses" },
	Lob = { label = "Lob", range = 115, cooldown = 2.2, power = 1.1, splash = 11,
		description = "Arcing shot that splashes on landing" },
	-- A radial move's range is the radius it hits, and it grows by `radiusStep` a rarity step (14
	-- to 23 studs) rather than by RarityRange. It was 26 + RarityRange, 26 to 50: a Secret hit
	-- everyone in a 50-stud circle, through walls, every 6.8 s, against a Lob's 11-stud splash.
	-- Brought down on 2026-09-18 with the damage unchanged.
	Shockwave = { label = "Shockwave", range = 18, radiusStep = 2, cooldown = 2.6, power = 0.95, radial = true,
		description = "Pulse that hits every enemy nearby" },
	Chain = { label = "Chain", range = 95, cooldown = 1.8, power = 0.8, chain = 2,
		description = "Zap that arcs on to a second enemy" },
}

-- Ability styles: what makes two brainrots with the same move feel different (OLIVER_LIST A5). 126
-- brainrots shared six moves, so every Bonk was the same Bonk. A style bends one move with numbers,
-- never with new art: the client draws a style cue from the same parts it already builds.
--
--   power     damage factor on the move (styles are side-grades, not buffs: tools/companion_ability_check.py
--             holds each one's damage a second within 0.85-1.2 of the plain move, counting its DoT;
--             applied after MaxAbilityDamage, so a capped brainrot pays the trade too)
--   cooldown  cooldown factor
--   area      splash / radius factor, plus `areaStep` a rarity step
--   reach     range factor (not radial moves: their range IS their radius)
--   slow      walk-speed factor put on whoever it hits, minus `slowStep` a rarity step, for `slowTime` s
--   dot       fraction of the hit dealt again over `dotTime` s, plus `dotStep` a rarity step (through
--             CompanionBoons' venom ticker, so a kill by the tick is credited like any companion kill)
--   leech     fraction of the damage dealt healed to the owner, plus `leechStep` a rarity step
--   forks     extra enemies the beam jumps on to (each at 60% of the one before)
--   kinds     the moves it can go on; any move when absent
--
-- Blast brainrots take no style: their ability is ProjectileService.Explode, which carries none of it.
-- A brainrot that carries a venom boon takes no DoT style either -- one venom slot per victim, so the
-- second would silently overwrite the first.
BrainrotData.AbilityStyles = {
	Slow = { label = "Chilling", power = 0.92, slow = 0.72, slowStep = 0.03, slowTime = 1.6,
		description = "slows the target" },
	Daze = { label = "Dazing", power = 0.95, slow = 0.45, slowStep = 0.02, slowTime = 0.6,
		description = "staggers the target" },
	Burn = { label = "Burning", power = 0.85, dot = 0.3, dotStep = 0.015, dotTime = 2,
		description = "burns over 2s" },
	Toxic = { label = "Toxic", power = 0.8, dot = 0.35, dotStep = 0.02, dotTime = 4,
		description = "poisons over 4s" },
	Leech = { label = "Leeching", power = 0.92, leech = 0.25, leechStep = 0.03,
		description = "heals you" },
	Wide = { label = "Wide", power = 0.9, area = 1.3, areaStep = 0.03, kinds = { Bonk = true, Lob = true, Shockwave = true },
		description = "wider area" },
	Quick = { label = "Quick", power = 0.8, cooldown = 0.75,
		description = "fast recharge" },
	Long = { label = "Long-range", power = 1.0, cooldown = 1.08, reach = 1.3, kinds = { Spit = true, Zap = true, Lob = true, Chain = true },
		description = "longer reach" },
	Fork = { label = "Forking", power = 0.9, forks = 1, kinds = { Zap = true, Chain = true },
		description = "one more jump" },
}

-- Which style each brainrot's move has, by name (the collection below is keyed by name too, and a
-- save stores names). Picked from what the move is called: a Frost Ray chills, a Stink Cloud poisons,
-- a Brick Drop staggers. Every brainrot is listed except the blast ones; the check refuses a name that
-- is not a brainrot, a style that is not in AbilityStyles, and a style on a move it cannot go on.
BrainrotData.AbilityStyleOf = {
	["Tung Tung Tung Sahur"] = "Daze", ["Bombardiro Crocodilo"] = "Wide", ["Trippi Troppi"] = "Quick",
	["Pizzarino Blobbo"] = "Burn", ["Sockolino Stinko"] = "Toxic", ["Toastini Crunchi"] = "Wide",
	["Bubblo Gummo"] = "Slow", ["Noodlo Wobblo"] = "Quick", ["Cactino Pokko"] = "Toxic",
	["Mudlo Splosh"] = "Toxic", ["Tralalero Tralala"] = "Long", ["Chimpanzini Bananini"] = "Long",
	["Boneca Ambalabu"] = "Wide", ["Cappellino Fizzolo"] = "Fork", ["Lamponi Brillo"] = "Wide",
	["Frullato Vortini"] = "Wide", ["Gnocco Grumpini"] = "Wide", ["Pinguino Scivolo"] = "Slow",
	["Zucchero Scintilla"] = "Fork", ["Lirili Larila"] = "Toxic", ["Ballerina Cappuccina"] = "Wide",
	["Brr Brr Patapim"] = "Wide", ["Robottino Bip Bop"] = "Quick", ["Draghetto Tostato"] = "Burn",
	["Polpetta Orbitale"] = "Wide", ["Nuvolino Tuono"] = "Fork", ["Fungo Saltarello"] = "Toxic",
	["Frigo Camelo"] = "Slow", ["Bombombini Gusini"] = "Wide", ["Vulcanino Brontolo"] = "Burn",
	["Specchio Riflesso"] = "Fork", ["Gufo Mezzanotte"] = "Long", ["Serpentino Zigzag"] = "Toxic",
	["Astronauta Pisolino"] = "Wide", ["Golden Sahur"] = "Daze", ["Galassia Sognante"] = "Fork",
	["Drago Arcobaleno"] = "Burn", ["Fantasmino Eterno"] = "Long", ["Spaghettino Twirlo"] = "Fork",
	["Gommino Rimbalzo"] = "Daze", ["Lanternino Lucciola"] = "Leech", ["Cuscino Pisolone"] = "Daze",
	["Tartarughino Turbo"] = "Quick", ["Sirenetta Bollicina"] = "Quick", ["Magnetino Attrazione"] = "Slow",
	["Cavaliere Croissant"] = "Daze", ["Stregonella Zucca"] = "Toxic", ["Nebbiolina Specchio"] = "Slow",
	["Imperatore Gelato"] = "Slow", ["Titano Tostapane"] = "Burn", ["Oracolo Lavatrice"] = "Wide",
	["Drago Gelatina"] = "Wide", ["Samurai Sushi"] = "Burn", ["Arcobalenissimo"] = "Long",
	["Pomodorino Schizzo"] = "Burn", ["Biscottino Crumbo"] = "Wide", ["Lumachina Lenta"] = "Slow",
	["Ombrellino Pioggia"] = "Slow", ["Patatina Fritta"] = "Burn", ["Mattoncino Blocco"] = "Daze",
	["Nuvoletta Pioviggina"] = "Slow", ["Pulcinello Piumino"] = "Quick", ["Gelatino Tremolo"] = "Wide",
	["Salsiccia Saltella"] = "Burn", ["Cipollina Lacrima"] = "Leech", ["Formichina Operaia"] = "Fork",
	["Bottoncino Cucito"] = "Fork", ["Radicchio Rotolo"] = "Wide", ["Pesciolino Bolla"] = "Quick",
	["Cavolfiore Cervello"] = "Daze", ["Ghiacciolo Sorbetto"] = "Slow", ["Ragnetto Tessitore"] = "Slow",
	["Tamburino Bum Bum"] = "Daze", ["Pantofolina Morbida"] = "Daze", ["Cactusello Danzante"] = "Toxic",
	["Zucchina Lanterna"] = "Leech", ["Koalino Pennichella"] = "Daze", ["Fornellino Fiammella"] = "Burn",
	["Biscione Arrotolato"] = "Toxic", ["Nocciolino Ninja"] = "Quick", ["Pinna Surfista"] = "Wide",
	["Gufetto Professore"] = "Daze", ["Polipo Pittore"] = "Toxic", ["Cervo Neon"] = "Fork",
	["Pipistrello Bollente"] = "Burn", ["Scatolone Robusto"] = "Daze", ["Cucciolo Cometa"] = "Long",
	["Riccio Rotante"] = "Toxic", ["Barattolo Miele"] = "Slow", ["Tricheco Baffone"] = "Daze",
	["Faro Guardiano"] = "Leech", ["Ape Operosa"] = "Fork", ["Granchio Tenaglia"] = "Quick",
	["Mago Merendina"] = "Leech", ["Cavaliere Lattina"] = "Daze", ["Medusa Lucente"] = "Toxic",
	["Unicorno Frizzante"] = "Fork", ["Tuba Tuonante"] = "Daze", ["Scheletrino Ballerino"] = "Daze",
	["Astronave Formaggio"] = "Wide", ["Drago Pantofola"] = "Burn", ["Lupo Lunare"] = "Slow",
	["Ciclope Cioccolato"] = "Wide", ["Nuvola Temporale"] = "Fork", ["Imperatrice Farfalla"] = "Fork",
	["Faraone Fagiolino"] = "Wide", ["Balena Cantante"] = "Leech", ["Titano Tuttifrutti"] = "Daze",
	["Stregone Stellato"] = "Long", ["Leone Lampadina"] = "Long", ["Castello Ambulante"] = "Daze",
	["Capitano Calamaro"] = "Fork", ["Grifone Glassato"] = "Slow", ["Golem Gorgonzola"] = "Toxic",
	["Sfinge Sussurrante"] = "Daze", ["Leviatano Limonata"] = "Fork", ["Mecha Mortadella"] = "Quick",
	["L'Ultimo Pixel"] = "Fork", ["Nonna Nebulosa"] = "Slow", ["Il Buco Nero Bello"] = "Slow",
}

-- The style a brainrot's move has, or nil (a blast brainrot, or a style that cannot go on its move).
function BrainrotData.StyleOf(def)
	if not def or def.blast then
		return nil, nil
	end
	local name = BrainrotData.AbilityStyleOf[def.name]
	local style = name and BrainrotData.AbilityStyles[name]
	if not style or (style.kinds and not style.kinds[def.attack or "Spit"]) then
		return nil, nil
	end
	return style, name
end

-- Buffed 2026-09-22 (Oliver: "buff the brainrots so that they can actually be useful in the matches,
-- as of now they're redundant to guns"). Was Common 6 up to Secret 40, with AbilityPower 1.65 and
-- AbilityCooldown 3.5: a Common's Spit did 10 every 6.4 s (1.5 damage a second), a Legendary's 41
-- every 4.8 s. Now a Common's Spit does 23 every 4 s and a Legendary's 65 every 3 s, so a companion is
-- a real extra gun's worth of pressure without replacing the gun.
BrainrotData.RarityDamage = { Common = 12, Uncommon = 16, Rare = 21, Epic = 27, Legendary = 34, Mythic = 39, Secret = 45 }
BrainrotData.RarityCooldown = { Common = 1.15, Uncommon = 1.05, Rare = 1.0, Epic = 0.92, Legendary = 0.85, Mythic = 0.8, Secret = 0.75 }
-- Ranges roughly doubled on 2026-09-22 (Oliver: "they dont have enough range or dmg to be useful
-- compared to the range and ttk of guns"): a Spit reaches 110 studs at Common, 150 at Secret (was 60-84).
BrainrotData.RarityRange = { Common = 0, Uncommon = 7, Rare = 14, Epic = 20, Legendary = 27, Mythic = 34, Secret = 40 }
-- 0 for Common up to 6 for Secret: the step a radial move's radius grows by.
BrainrotData.RarityIndex = { Common = 0, Uncommon = 1, Rare = 2, Epic = 3, Legendary = 4, Mythic = 5, Secret = 6 }
-- Companions can be shot. A downed companion sits out the rest of the match.
-- Half as tough again (2026-09-22 buff), so a companion isn't shot down before it earns its keep.
BrainrotData.RarityHealth = { Common = 90, Uncommon = 120, Rare = 160, Epic = 200, Legendary = 260, Mythic = 340, Secret = 430 }

-- The companion's move is used on a hotkey, not automatically, so each use hits harder and
-- recharges for longer than the old auto-attack did.
-- Second buff the same night: 1.9 -&gt; 2.3 power, 2.2 -&gt; 1.8 cooldown, cap 90 -&gt; 95.
BrainrotData.AbilityPower = 2.3
BrainrotData.MaxAbilityDamage = 95
BrainrotData.AbilityCooldown = 1.8

-- The most one use of a companion's move can take off any one target, health and shield together:
-- every hit of the use (a fork, a splash) and the DoT or venom it starts, counted after the level,
-- stars, style and MatchConfig.CombatDamageScale (Oliver, 2026-09-24: "make the companions other
-- than Secret ones not one-shot"). The 95 per-hit cap above never counted the DoT, so a Toxic or
-- venom Mythic could take a full-health player from 100 to 0 with one press. Every number is under
-- 100, so no use kills a full-health player on its own, but two uses (or a teammate's shots) still
-- can. Set near the top of what each rarity lands at level 1, so the buff's feel is kept and the cap
-- mostly bites on levelled, merged copies. Secret has no entry: a Secret may still one-shot.
-- Enforced in CompanionService (per use, per target); tools/companion_ability_check.py sweeps it.
BrainrotData.MaxUseDamage = { Common = 34, Uncommon = 42, Rare = 50, Epic = 60, Legendary = 70, Mythic = 80 }

--------------------------------------------------------------------------------
-- Boons: what a companion does FOR its owner
--------------------------------------------------------------------------------
-- A brainrot opts in by carrying `boon`; CompanionBoons reads the field and names no brainrot. Only
-- SOME carry one -- a boon on every entry would make the choice of companion meaningless. The
-- vocabulary is closed and verify.py refuses a key that is not in it, so a typo cannot ship as
-- "no effect at all", which is the failure mode that hides longest.
--
--   regen  = hp per second healed while it is out
--   speed  = walk-speed factor  (1.05 = 5% faster)
--   jump   = jump-height factor
--   health = bonus MaxHealth while equipped (never current health -- see CompanionBoons)
--   venom  = { damage, duration }  its hits poison for `damage` total over `duration` seconds
BrainrotData.Boons = { regen = true, speed = true, jump = true, health = true, venom = true }

-- An ability that explodes instead of landing a single hit. `blast = true` opts in, and verify.py
-- refuses it below BlastMinRarity so a stray edit cannot hand one to a Common. Radius comes from the
-- rarity step rather than being typed per brainrot, so the ladder cannot drift entry by entry.
BrainrotData.BlastMinRarity = "Legendary"
BrainrotData.BlastRadius = 12
BrainrotData.BlastRadiusStep = 2
BrainrotData.BlastPower = 0.9

