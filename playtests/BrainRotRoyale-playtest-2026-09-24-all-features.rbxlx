		overheat = 0.5,
		yawLimit = 180,
		pitchMin = -8,
		pitchMax = 25,
		restPitch = 0,
		slew = 260,
		rarity = "Epic",
	},
	-- The carrier's automatic grenade launcher: 40mm grenades fired flat and fast, ten to a can. Smaller
	-- blasts than the mortar's or a hand launcher's, many more of them.
	CameloGrenadeLauncher = {
		id = "Camelo Grenade Launcher",
		hud = "GRENADES",
		kind = "round",
		projectile = "grenade",
		damage = 34,
		splashRadius = 8,
		headshotMultiplier = 1,
		spread = 0.8,
		fireRate = 2.2,
		magazine = 10,
		recharge = 0.8,
		rechargeDelay = 1.6,
		yawLimit = 180,
		pitchMin = -8,
		pitchMax = 30,
		-- Turned right round, the lowest pitches go into the carrier's own rear hump (the gallery sweep:
		-- 170-180 degrees at -7 and -8); 6 degrees down clears it.
		rearGuard = { arc = 15, pitchMin = -6 },
		restPitch = 2,
		slew = 180,
		rarity = "Epic",
	},

	-- The drivers' guns: light machine guns at the front, a 20-degree arc either side and a little up
	-- and down, fired from the wheel. Weaker than any hand gun a passenger could lean out with (58
	-- damage a second at most against a Rare rifle's 214): something to do with the wheel in your hands,
	-- not a reason to drive rather than fight. Each overheats when run dry.
	RotsterNoseGun = {
		id = "Rotster Nose Gun",
		hud = "NOSE GUN",
		kind = "hitscan",
		damage = 7,
		headshotMultiplier = 1.25,
		range = 260,
		spread = 1.5,
		fireRate = 9,
		magazine = 36,
		recharge = 12,
		rechargeDelay = 1.0,
		overheat = 0.5,
		yawLimit = 20,
		pitchMin = -5,
		pitchMax = 10,
		restPitch = 0,
		rarity = "Uncommon",
	},
	RangerBonnetGun = {
		id = "Ranger Bonnet Gun",
		hud = "BONNET GUN",
		kind = "hitscan",
		damage = 8,
		headshotMultiplier = 1.25,
		range = 280,
		spread = 1.4,
		fireRate = 8,
		magazine = 36,
		recharge = 12,
		rechargeDelay = 1.0,
		overheat = 0.5,
		yawLimit = 20,
		pitchMin = -5,
		pitchMax = 10,
		restPitch = 0,
		rarity = "Uncommon",
	},
	VanBumperGun = {
		id = "Sahur Bumper Gun",
		hud = "BUMPER GUN",
		kind = "hitscan",
		damage = 7,
		headshotMultiplier = 1.25,
		range = 260,
		spread = 1.5,
		fireRate = 9,
		magazine = 36,
		recharge = 12,
		rechargeDelay = 1.0,
		overheat = 0.5,
		yawLimit = 20,
		pitchMin = -5,
		pitchMax = 10,
		restPitch = 0,
		rarity = "Uncommon",
	},
	TartarugaBowGun = {
