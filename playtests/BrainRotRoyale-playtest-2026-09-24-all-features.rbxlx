		piece("Glow", V(0.3, 0.08, 0.06), V(0, 0.44, -0.2), Color3.fromRGB(90, 200, 255), Enum.Material.Neon)
		-- The handle is sewn to the underside, its top just inside the bottom bag, and narrow enough
		-- to pass between the two straps instead of ending a hundredth off their undersides. (At
		-- -0.14 it hung 0.02 under the kit, a slit of light the length of the handle.)
		piece("Grip", V(0.44, 0.08, 0.14), V(0, -0.115, 0), strap, Enum.Material.Fabric)
	elseif id == "RotMine" then
		-- A squat pressure mine: a dark steel disc, a plate in the item's colour with three
		-- pressure prongs around an arming light, and a carry strap underneath. The deployed mine
		-- is this same model at three times the size (HazardService), so it reads the same
		-- in your hand and on the ground.
		local steel = Color3.fromRGB(70, 74, 80)
		body = column("Body", 0.2, 0.9, V(0, 0, 0), steel, Enum.Material.Metal)
		column("Plate", 0.06, 0.72, V(0, 0.13, 0), color, Enum.Material.SmoothPlastic)
		column("Rim", 0.04, 0.94, V(0, 0.02, 0), DARK, Enum.Material.Metal)
		for index = 0, 2 do
			local angle = index / 3 * math.pi * 2 + math.pi / 2
			piece("Prong", V(0.08, 0.14, 0.08), V(math.cos(angle) * 0.24, 0.23, math.sin(angle) * 0.24), STEEL, Enum.Material.Metal)
		end
		ball("Glow", 0.16, V(0, 0.2, 0), Color3.fromRGB(255, 80, 60), Enum.Material.Neon)
		piece("Grip", V(0.5, 0.08, 0.14), V(0, -0.14, 0), DARK, Enum.Material.Fabric)
	elseif id == "PopupBunker" then
		-- An armoured case with rivets and a warning stripe, carried by the handle on top.
		local steel = color
		body = piece("Body", V(1.1, 0.7, 0.5), V(0, 0, 0), steel, Enum.Material.DiamondPlate)
		-- The seam stands a clear 0.07 off the shell; at 1.12 x 0.52 it was a hundredth over it on
		-- four sides.
		piece("Seam", V(1.24, 0.03, 0.64), V(0, 0.08, 0), DARK)
		for _, x in ipairs({ -0.45, 0.45 }) do
			for _, y in ipairs({ -0.25, 0.25 }) do
				ball("Rivet", 0.09, V(x, y, -0.26), STEEL, Enum.Material.Metal)
			end
		end
		-- Hazard bars: one layer of alternating diagonals, each butted against the next (faces that
		-- only share an edge don't fight). It used to be a yellow plate with a dark one turned across
		-- it a hundredth in front, both a couple of hundredths off the shell.
		local tilt = 0.6
		local barStep = 0.09 / math.cos(tilt)
		for index = 0, 3 do
			piece("Stripe", V(0.09, 0.16, 0.07), CFrame.new((index - 1.5) * barStep, -0.14, -0.285) * CFrame.Angles(0, 0, tilt),
				index % 2 == 0 and Color3.fromRGB(240, 190, 40) or DARK, Enum.Material.SmoothPlastic)
		end
		piece("Glow", V(0.6, 0.05, 0.07), V(0, 0.255, -0.285), Color3.fromRGB(90, 200, 255), Enum.Material.Neon)
		for _, x in ipairs({ -0.22, 0.22 }) do
			piece("HandlePost", V(0.08, 0.16, 0.08), V(x, 0.42, 0), DARK, Enum.Material.Metal)
		end
		-- The handle bar rests on top of its posts rather than sinking into them.
		piece("Grip", V(0.56, 0.08, 0.12), V(0, 0.54, 0), DARK, Enum.Material.Fabric)
	elseif id == "BrainrotFortress" then
		-- A gold-trimmed crate with a little keep on top, so the Legendary reads as one.
		local wood = Color3.fromRGB(120, 86, 52)
		body = piece("Body", V(1.0, 0.7, 0.7), V(0, 0, 0), wood, Enum.Material.WoodPlanks)
		-- The gold bands stand a clear 0.07 off the crate, and the end plates sit inside them on the
		-- crate's ends. Before this every trim face landed within three hundredths of the crate's or
		-- of another band's — eight of the thirty-seven flush pairs were trim against trim, four of
		-- them exactly level — and the pass grew the crate itself to sort it out.
		for _, y in ipairs({ -0.24, 0.24 }) do
			piece("Trim", V(1.14, 0.08, 0.84), V(0, y, 0), color, Enum.Material.Foil)
		end
		for _, x in ipairs({ -0.535, 0.535 }) do
			piece("Trim", V(0.07, 0.36, 0.36), V(x, 0, 0), color, Enum.Material.Foil)
		end
		column("Keep", 0.42, 0.4, V(0, 0.56, 0), Color3.fromRGB(190, 182, 168), Enum.Material.Cobblestone)
		for index = 0, 3 do
			local angle = index / 4 * math.pi * 2
			piece("Merlon", V(0.1, 0.12, 0.1), V(math.cos(angle) * 0.15, 0.83, math.sin(angle) * 0.15), Color3.fromRGB(190, 182, 168),
				Enum.Material.Cobblestone)
		end
		-- The pole is stepped into the keep. At 0.4 tall from y 1.0 its foot stood 0.03 above the roof
		-- and 0.1 clear of the merlons, so the pole and its flag were an island hanging over the tower.
		piece("Flagpole", V(0.03, 0.48, 0.03), V(0, 0.96, 0), DARK, Enum.Material.Metal)
		-- The flag flies from the pole, hoist edge just inside it, swung round so it isn't a thin
		-- sheet lying parallel to a thin pole a hundredth away. (Before that it hung in the air a
		-- tenth of a stud to the side of the pole.)
		piece("Glow", V(0.02, 0.14, 0.22), CFrame.new(0, 1.05, 0.005) * CFrame.Angles(0, 0.3, 0) * CFrame.new(0, 0, 0.11),
			color, Enum.Material.Neon)
		-- Sewn to the underside. At -0.42 its top was 0.03 below the crate: a slit of daylight the
		-- length of the handle, which nothing in the z-fight pass looks for (it hunts faces that are
		-- too close, never ones left apart).
		piece("Grip", V(0.6, 0.08, 0.14), V(0, -0.39, 0), DARK, Enum.Material.Fabric)
	elseif id == "RotGlider" and options.open then
		-- The wing, open: eleven cells on an arc, drooping at the tips, striped in the item's colour,
		-- a rib over every seam, and lines down to a harness bar (the body, welded over the head).
		-- This is also every player's drop-in canopy, at three times the size.
		--
		-- The cells tile the arc with nothing between them. Each is exactly as wide as its slice of
		-- the arc at the top skin, so neighbours meet at the crease along the top and overlap
		-- underneath. (The first version spaced nine 0.62-wide cells 18.75 degrees apart, which left
		-- eight see-through slits the length of the wing, half a stud wide on the drop-in canopy.)
		-- Turning a cell about the arc never turns its front and back faces, so every cell's lie in the
		-- same two planes, and where neighbours overlap underneath those faces overlapped: ten flush
		-- pairs. The build's z-fight pass then stretched each cell a step longer than the one before,
		-- one side of the wing 1.2 studs deeper than the other on the drop-in canopy. So every second
		-- cell is STAGGER longer at both ends, and the ribs and tip caps stand STAGGER past those.
		-- No glowing leading edge: Oliver asked for the canopy without it.
		body = piece("Body", V(1.4, 0.12, 0.12), V(0, 0, 0), DARK, Enum.Material.Metal)
		local mint = Color3.fromRGB(120, 230, 160)
		local cells = 11
		local arc = 2.3
		local span = math.rad(150)
		local step = span / (cells - 1)
		local thick, depth = 0.16, 1.6
		local STAGGER = 0.08
		local cellWidth = 2 * (arc + thick / 2) * math.tan(step / 2) + 0.01
		local function onArc(angle)
			return CFrame.new(math.sin(angle) * arc, math.cos(angle) * arc - arc + 2.6, 0) * CFrame.Angles(0, 0, -angle)
		end
		for index = 0, cells - 1 do
			local at = onArc(-span / 2 + index * step)
			local cellDepth = index % 2 == 0 and depth or depth + STAGGER * 2
			piece("Cell", V(cellWidth, thick, cellDepth), at, index % 2 == 0 and color or mint, Enum.Material.Fabric)
		end
		-- Ribs on every seam and a cap at each tip, lying along the seam's own angle.
		for index = 0, cells do
			local at = onArc(-span / 2 + (index - 0.5) * step)
			local tip = index == 0 or index == cells
			piece(tip and "TipCap" or "CellRib", V(tip and 0.08 or 0.05, thick + 0.06, depth + STAGGER * 4), at, DARK, Enum.Material.Fabric)
			-- Lines from alternate ribs, mirrored, down to a riser at each end of the harness bar.
			if index == 2 or index == 4 or index == 5 or index == 6 or index == 7 or index == 9 then
				local anchor = (at * CFrame.new(0, -(thick / 2 + 0.03) + 0.01, 0.3)).Position
				local riser = V(anchor.X &gt; 0 and 0.55 or -0.55, 0, 0)
				local line = CFrame.lookAt(anchor:Lerp(riser, 0.5), anchor)
				piece("Line", V(0.03, 0.03, (anchor - riser).Magnitude), line, Color3.fromRGB(236, 232, 220), Enum.Material.Fabric)
			end
		end
		-- Harness straps down to the shoulders, run down the back of the bar. Centred on it, their front
		-- and back faces lay in the bar's own (four flush pairs, which the pass fixed by doubling the
		-- straps' thickness).
		for _, x in ipairs({ -0.55, 0.55 }) do
			piece("Strap", V(0.12, 1.1, 0.12), CFrame.new(x, -0.55, 0.07) * CFrame.Angles(0, 0, x * 0.3), DARK, Enum.Material.Fabric)
		end
	elseif id == "RotGlider" then
		-- Packed: the wing rolled up on a light frame with its straps, a pull handle, and a strip
		-- of the leading edge showing. Held by the frame.
		body = piece("Body", V(0.24, 0.9, 0.16), V(0, 0.2, 0), DARK, Enum.Material.Metal)
		local mint = Color3.fromRGB(120, 230, 160)
		-- The roll lies across the top of the frame (a cylinder's length is its X), with four bands
		-- round it placed symmetrically. It used to be turned upright, and the "bands" were thin
		-- upright rods standing loose beside it.
		piece("Roll", V(1.3, 0.34, 0.34), V(0, 0.62, 0), color, Enum.Material.Fabric, Enum.PartType.Cylinder)
		for index, x in ipairs({ -0.495, -0.165, 0.165, 0.495 }) do
			piece("RollBand", V(0.05, 0.4, 0.4), V(x, 0.62, 0), index % 2 == 1 and mint or DARK, Enum.Material.Fabric, Enum.PartType.Cylinder)
		end
		piece("Glow", V(1.2, 0.04, 0.06), V(0, 0.62, -0.17), color, Enum.Material.Neon)
		for _, x in ipairs({ -0.45, 0.45 }) do
			piece("Strap", V(0.08, 0.5, 0.08), CFrame.new(x, 0.32, 0.1) * CFrame.Angles(0, 0, -x * 0.5), DARK, Enum.Material.Fabric)
		end
		piece("Handle", V(0.3, 0.08, 0.08), V(0, -0.35, 0), STEEL, Enum.Material.Metal)
		-- The grip is a fabric sleeve round the frame bar. As a block it was 0.14 across inside a
		-- 0.16 frame — invisible except for the stub below it, with all five of its faces a hundredth
		-- or two off the frame's own, the one thing on this model the pass had to touch.
		column("Grip", 0.5, 0.3, V(0, -0.07, 0), DARK, Enum.Material.Fabric)
	end

	-- No two faces left flush, before the welds so only the one part moves.
	ZFight.Fix({ model }, { all = true })

	model.PrimaryPart = body
	body.PivotOffset = body.CFrame:Inverse()

	if not anchored then
		for _, part in ipairs(model:GetChildren()) do
			if part:IsA("BasePart") and part ~= body then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = body
				weld.Part1 = part
				weld.Parent = part
			end
		end
	end

	return model, body
end

return ItemModels
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">MapData</string><ProtectedString name="Source">-- Map presets. Ground is real Roblox Terrain rather than a flat Part, and every preset
-- carries its own material palette so towns don't all read as the same grey boxes.

local MapData = {}

MapData.Maps = {
	SahurSprings = {
		name = "Sahur Springs",
		description = "Rolling grassland with five spread-out villages. Long sightlines.",
		radius = 1280,
		towns = 6,
		buildingsPerTown = { 5, 9 },
		terrainMaterial = Enum.Material.Grass,
		propDensity = 1.0,
		wallMaterials = { Enum.Material.Brick, Enum.Material.WoodPlanks, Enum.Material.Concrete },
		wallColors = {
			Color3.fromRGB(188, 140, 118),
			Color3.fromRGB(206, 192, 170),
			Color3.fromRGB(158, 148, 136),
			Color3.fromRGB(172, 124, 104),
		},
		roofMaterial = Enum.Material.Slate,
		roofColors = { Color3.fromRGB(96, 74, 66), Color3.fromRGB(72, 82, 94), Color3.fromRGB(110, 64, 56) },
		floorMaterial = Enum.Material.WoodPlanks,
	},
	TralalaTown = {
		name = "Tralala Town",
		description = "A dense downtown grid. Tall, tight and vertical — rooftops matter.",
		radius = 950,
		towns = 4,
		buildingsPerTown = { 9, 13 },
		terrainMaterial = Enum.Material.Ground,
		propDensity = 0.4,
		wallMaterials = { Enum.Material.Concrete, Enum.Material.Brick, Enum.Material.Marble },
		wallColors = {
			Color3.fromRGB(150, 156, 172),
			Color3.fromRGB(118, 122, 138),
			Color3.fromRGB(176, 172, 166),
			Color3.fromRGB(132, 108, 100),
		},
		roofMaterial = Enum.Material.Concrete,
		roofColors = { Color3.fromRGB(84, 88, 100), Color3.fromRGB(66, 70, 82) },
		floorMaterial = Enum.Material.Concrete,
	},
	BombardiroBay = {
		name = "Bombardiro Bay",
		description = "Sun-bleached coastal town on open sand. Sniper country.",
		radius = 1480,
		towns = 7,
		buildingsPerTown = { 4, 7 },
		terrainMaterial = Enum.Material.Sand,
		propDensity = 0.7,
		wallMaterials = { Enum.Material.Sandstone, Enum.Material.Concrete, Enum.Material.Brick },
		wallColors = {
			Color3.fromRGB(226, 208, 176),
			Color3.fromRGB(206, 182, 148),
			Color3.fromRGB(188, 166, 142),
			Color3.fromRGB(224, 190, 152),
		},
		roofMaterial = Enum.Material.WoodPlanks,
		roofColors = { Color3.fromRGB(150, 104, 76), Color3.fromRGB(122, 88, 68) },
		floorMaterial = Enum.Material.Sandstone,
	},
	RotRidge = {
		name = "Rot Ridge",
		description = "Rocky highland basin. Cover everywhere, fastest storm on the rotation.",
		radius = 880,
		towns = 5,
		buildingsPerTown = { 4, 8 },
		terrainMaterial = Enum.Material.Rock,
		propDensity = 1.4,
		wallMaterials = { Enum.Material.Cobblestone, Enum.Material.Slate, Enum.Material.Concrete },
		wallColors = {
			Color3.fromRGB(140, 132, 124),
			Color3.fromRGB(112, 106, 102),
			Color3.fromRGB(128, 118, 110),
			Color3.fromRGB(98, 100, 96),
		},
		roofMaterial = Enum.Material.Slate,
		roofColors = { Color3.fromRGB(70, 74, 78), Color3.fromRGB(88, 82, 78) },
		floorMaterial = Enum.Material.Wood,
	},
	PatapimPlains = {
		name = "Patapim Plains",
		description = "Farmland ringing one big central town. Hot drop guaranteed.",
		radius = 1150,
		towns = 5,
		buildingsPerTown = { 6, 10 },
		terrainMaterial = Enum.Material.LeafyGrass,
		propDensity = 1.6,
		wallMaterials = { Enum.Material.WoodPlanks, Enum.Material.Brick, Enum.Material.Wood },
		wallColors = {
			Color3.fromRGB(172, 126, 92),
			Color3.fromRGB(198, 160, 122),
			Color3.fromRGB(150, 112, 84),
			Color3.fromRGB(186, 178, 158),
		},
		roofMaterial = Enum.Material.Slate,
		roofColors = { Color3.fromRGB(118, 62, 54), Color3.fromRGB(92, 70, 60) },
		floorMaterial = Enum.Material.WoodPlanks,
	},
}

MapData.Order = { "SahurSprings", "TralalaTown", "BombardiroBay", "RotRidge", "PatapimPlains" }

-- Time of day and light per map, so the five don't all look like the same afternoon. Applied by
-- MapGenerator when a map is built and put back to the lobby's default when it's cleared. No fog:
-- Bootstrap keeps that off for the whole game.
MapData.DefaultLighting = {
	clockTime = 14, brightness = 2, ambient = Color3.fromRGB(70, 70, 70), outdoorAmbient = Color3.fromRGB(128, 128, 128),
	shadowSoftness = 0.2,
}
-- Ambient particles drawn around the camera on each map (HudClient): pollen over the grass,
-- dust between the blocks, blown sand on the coast, mist at dawn in the highlands, fireflies
-- over the farms. Fields map onto a ParticleEmitter.
MapData.Ambient = {
	SahurSprings = { color = Color3.fromRGB(255, 240, 170), size = 0.35, rate = 14, speed = 1, lifetime = 7,
		transparency = 0.5, lightEmission = 0.4, acceleration = Vector3.new(0.4, 0.25, 0) },
	TralalaTown = { color = Color3.fromRGB(200, 200, 210), size = 0.3, rate = 10, speed = 0.8, lifetime = 8,
		transparency = 0.7, lightEmission = 0.1, acceleration = Vector3.new(0.3, -0.1, 0.2) },
	BombardiroBay = { color = Color3.fromRGB(230, 205, 150), size = 0.6, rate = 18, speed = 9, lifetime = 3,
		transparency = 0.75, lightEmission = 0, acceleration = Vector3.new(8, 0, 2) },
	RotRidge = { color = Color3.fromRGB(180, 195, 215), size = 7, rate = 3, speed = 0.6, lifetime = 9,
		transparency = 0.88, lightEmission = 0.05, acceleration = Vector3.new(0.5, 0.05, 0) },
	PatapimPlains = { color = Color3.fromRGB(220, 255, 120), size = 0.28, rate = 9, speed = 1.2, lifetime = 5,
		transparency = 0.1, lightEmission = 1, acceleration = Vector3.new(0, 0.2, 0) },
}

MapData.Lighting = {
	-- Clear midday over the grass.
	SahurSprings = { clockTime = 13.5, brightness = 2.2, ambient = Color3.fromRGB(72, 76, 70), outdoorAmbient = Color3.fromRGB(134, 138, 128) },
	-- Golden hour between the tall blocks, long shadows down the streets.
	TralalaTown = { clockTime = 17.4, brightness = 2.6, ambient = Color3.fromRGB(78, 64, 60), outdoorAmbient = Color3.fromRGB(150, 118, 96) },
	-- Harsh noon on the sand.
	BombardiroBay = { clockTime = 12.3, brightness = 2.8, ambient = Color3.fromRGB(84, 84, 80), outdoorAmbient = Color3.fromRGB(150, 146, 136) },
	-- Cold dawn in the highlands.
	RotRidge = { clockTime = 6.9, brightness = 1.8, ambient = Color3.fromRGB(56, 62, 76), outdoorAmbient = Color3.fromRGB(104, 114, 138) },
	-- Warm late afternoon over the farms.
	PatapimPlains = { clockTime = 16.2, brightness = 2.4, ambient = Color3.fromRGB(80, 74, 60), outdoorAmbient = Color3.fromRGB(148, 134, 108) },
}

for id, map in pairs(MapData.Maps) do
	map.id = id
end

function MapData.Get(id)
	return MapData.Maps[id]
end

function MapData.RandomCandidates(count)
	local pool = table.clone(MapData.Order)
	for index = #pool, 2, -1 do
		local swap = math.random(1, index)
		pool[index], pool[swap] = pool[swap], pool[index]
	end

	local picked = {}
	for index = 1, math.min(count, #pool) do
		table.insert(picked, pool[index])
	end
	return picked
end

return MapData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">MatchConfig</string><ProtectedString name="Source">-- Battle royale rules: lobby pacing, the storm schedule, and placement payouts.

local MatchConfig = {}

-- Fifty a match, bots filling whatever real players don't. The place itself has to allow it too:
-- Game Settings -&gt; Places -&gt; Max Players (or the Creator Dashboard), which isn't in this file.
MatchConfig.MaxPlayers = 50
-- One is enough to start: bots backfill the rest, so nobody ever waits on a quiet server.
MatchConfig.MinPlayers = 1
MatchConfig.LobbyCountdown = 15
-- Once every player in the server has readied up there's nobody left to wait for, so the
-- countdown drops to this. 8 rather than 5 since the vote became a MODE and map decision
-- (Oliver's #2): three cards, three different games, and five seconds is not long enough to read
-- them. Revert this one number if it ever feels slow.
MatchConfig.AllReadyCountdown = 8

-- How far away text in the lobby can be seen, so the plaza isn't a wall of labels from wherever
-- you stand. Floating labels (Ready Pad, Trading Post, practice targets, podium names, the
-- mannequin's plaque) disappear beyond the first; the big boards and the Cloud Climb sign beyond the
-- second; player nameplates beyond the third while their owner is in the lobby.
MatchConfig.LobbyLabelDistance = 55
MatchConfig.LobbySignDistance = 120
MatchConfig.LobbyNameplateDistance = 80
MatchConfig.ResultsDuration = 15
-- A break in the lobby after every match, before the next countdown can begin: time to open
-- crates, trade, kick the balls around or have a go at the Cloud Climb.
MatchConfig.Intermission = 35
-- What is left of the break once every player here has readied up: they have said they are done, so
-- nobody waits out the rest of the 35 s, but the vote (open all break) and the last results still get a
-- few seconds before the countdown takes over.
MatchConfig.IntermissionAllReady = 5

-- Shields sit on top of health and take damage first. Everyone drops in with none; shield
-- potions fill them (ItemData). The storm ignores shields.
MatchConfig.MaxShield = 100

MatchConfig.LobbyPosition = Vector3.new(0, 500, 0)

-- Everyone starts on the ground, spread across the whole map on a sunflower spiral rather
-- than clustered on town centres. On a 900-radius map that's roughly 250 studs between
-- neighbours, so nobody opens the match already in a fight.
MatchConfig.SpawnHeight = 6
-- Players open a canopy this far above their spawn and steer down; bots start on the ground.
MatchConfig.DropHeight = 170
-- How long you get to pick a landing spot on the drop map once the map is built, before anyone
-- is placed. Not choosing leaves you on the spawn the spiral gave you, which is the old random
-- behaviour unchanged.
MatchConfig.DropSelectSeconds = 15
MatchConfig.SpawnSpread = 0.96

-- Spacing is driven by area per combatant, so pushing points outward only helps if the
-- disc is big enough. `SpawnInnerBias` also keeps anyone from landing dead centre, which
-- is where the tightest clustering used to happen.
MatchConfig.SpawnInnerBias = 0.22

MatchConfig.StartHealth = 100
MatchConfig.BaseWalkSpeed = 18

-- Sprint multiplies whatever the player's current base speed is, so the Rot Runner
-- gamepass bonus still counts while sprinting instead of being flattened by it.
MatchConfig.SprintMultiplier = 1.45

-- Time to raise a weapon after changing what's in your hands. Shared so the server's
-- enforcement and the client's prediction can never disagree.
MatchConfig.EquipTime = 0.35

-- The storm walks through these in order. `holdTime` is the calm before it moves,
-- `shrinkTime` is how long the move takes, and `radiusScale` is a fraction of the chosen
-- map's radius — so the same schedule works on every map regardless of size.
MatchConfig.StormPhases = {
	{ holdTime = 45, shrinkTime = 50, radiusScale = 0.62, damagePerSecond = 1 },
	{ holdTime = 35, shrinkTime = 40, radiusScale = 0.40, damagePerSecond = 2 },
	{ holdTime = 28, shrinkTime = 34, radiusScale = 0.24, damagePerSecond = 4 },
	{ holdTime = 22, shrinkTime = 28, radiusScale = 0.12, damagePerSecond = 7 },
	{ holdTime = 18, shrinkTime = 22, radiusScale = 0.03, damagePerSecond = 12 },
}
-- Sudden death, after the last circle: it holds for `holdTime`, then closes to nothing over `shrinkTime`
-- and everyone left is in the storm, at a rate no heal keeps up with (a Med Kit is 100 health over 5 s).
-- Without it two campers inside the last circle could hold a match open forever: the battle royale has
-- no time limit. StormService runs it as one more circle, so the HUD counts "Circle 6 of 6" and bots
-- read it like any other.
MatchConfig.StormSuddenDeath = { holdTime = 15, shrinkTime = 30, radiusScale = 0, damagePerSecond = 25 }

MatchConfig.VoteCandidates = 3

-- Placement payouts. Rewards do NOT stack: a player gets exactly the crate for the bracket
-- they landed in, nothing from the brackets below. Paying out a crate rather than a fixed
-- brainrot means every placement ends on a roll — a Legendary Crate is only 42% to actually
-- cough up a Legendary or better, and 8% to reach Mythic.
MatchConfig.PlacementBrackets = {
	{ maxRank = 1,  crate = "Legendary", coins = 2500, xp = 900 },
	{ maxRank = 5,  crate = "Epic",      coins = 1200, xp = 550 },
	{ maxRank = 10, crate = "Rare",      coins = 600,  xp = 340 },
	{ maxRank = 20, crate = "Uncommon",  coins = 260,  xp = 190 },
	{ maxRank = 30, crate = "Common",    coins = 120,  xp = 90 },
	{ maxRank = 50, crate = "Common",    coins = 90,   xp = 70 },
}
-- The bottom two were 100 and 60 coins (xp 60 at the bottom). Raised a little (Oliver, 2026-09-22,
-- from ECONOMY.md s.2): at 50 players a player who keeps losing spends two thirds of their matches in
-- ranks 31-50 and earned 4.5x less a minute than a middle player.

-- Every hit between combatants is multiplied by this (CombatService.DealDamage). 1 = the weapons' raw damage.
-- 0.85 (Oliver, 2026-09-22 21:38: "increase the ttk a bit") turned out too slow (2026-09-23 15:07: "make it
-- a good middleground"), so 0.92: a kill takes about 9% longer than raw damage instead of 18%.
MatchConfig.CombatDamageScale = 0.92

MatchConfig.CoinsPerKill = 75
-- Team Deathmatch / Objective Capture payouts. Oliver, 2026-09-23 16:10: "theres no rewards for the team
-- gamemodes!", 2026-09-24: "improve the rewards for team gamemodes too", then on seeing a design held level
-- with the battle royale: "team gamemodes need better rewards!! make them worth playing".
--
-- THE YARDSTICK is the battle royale's pay per minute of play, lobby included (tools/economy_model.py
-- s.2b, ECONOMY.md s.2b). The team modes are meant to be CLEARLY BETTER: about 1.3-1.5x the same player's
-- battle royale hour, in coins AND Pass XP, for every profile -- the player who always loses included, so
-- a loss is still worth playing. The model checks all three profiles ("loses only", "wins sometimes",
-- "strong") in Team Deathmatch and Objective Capture, and fails if any of the twelve ratios leaves 1.25-1.6.
-- Why more and not level: a team match asks for 8 minutes where a battle royale loss can be over in one,
-- and the battle royale keeps its own draw -- the 2,500-coin Legendary win -- which nothing here matches.
--
-- WHAT A MATCH PAYS, all of it at the end, on one itemised results card (RewardService.TeamBreakdown):
--   the result      a crate, coins and XP for a win, a draw or a loss. A loss still pays a crate.
--   performance     kills at the battle royale's own rate, assists, multi-kills, revenge, and in Objective
--                   Capture captures, time on the objective and kills made defending it. Each is capped per
--                   match, so a bot lobby cannot be farmed past a sensible match's worth.
--   time played     coins and XP per minute ACTIVELY played (the PlaytimeService movement rule).
--   TEAM BONUS      what the battle royale has no equivalent for, highlighted and totalled on the card:
--                   the team MVP, the first team win of the day (an Epic Crate), a win streak across
--                   consecutive team matches, and four team-only cosmetics for lifetime team wins.
-- Everything goes through the 2x SahurCoins pass once, on the total. XP is Brainrot Pass XP, which feeds
-- Rot Rank exactly as battle royale XP does (BattlePassService.OnXp). Wins here do NOT count as battle
-- royale wins (Stats.wins, the global board).
--
-- AFK: a player active in fewer than `participation.minActiveShare` of the checks gets the `afk` line
-- and nothing else -- no crate, no win pay, no MVP, no TEAM BONUS -- and their win streak ends.
MatchConfig.TeamModeRewards = {
	-- THE RESULT. A team match is ~9.3 minutes with the lobby (8 of play), so ~6.5 an hour against the
	-- battle royale's 10-19. A loss pays a crate and several times a bottom-half battle royale finish
	-- (90-260). The win is not the battle royale's 2,500: it is shared by the whole side, so much of the gap
	-- between players is made in the performance lines, which only that player earns.
	win = { crate = "Rare", coins = 1300, xp = 345 },
	draw = { crate = "Rare", coins = 600, xp = 270 },
	loss = { crate = "Uncommon", coins = 250, xp = 230 },
	-- Idle for most of the match: this and nothing else.
	afk = { coins = 25, xp = 20 },

	-- MatchService's live kill path. Kills are paid on the results card, so the live payment is 0; the live
	-- call still counts the kill for Stats.kills, the kills quest and gun mastery, up to maxPaidKills.
	killScale = 0,
	maxPaidKills = 40,

	-- Kills pay the battle royale's own rate (CoinsPerKill / XpPerKill, the bot rates for a bot) for the
	-- first `cap` of a match. 30 is past what a strong player makes against bots in 8 minutes (~20), so a
	-- good player is never capped early; the cap is only there for a farmed bot lobby.
	kill = { cap = 30 },
	-- Damage on someone a team-mate then finished: at least `minDamage` in the last `windowSeconds`.
	assist = { coins = 35, xp = 15, cap = 20, minDamage = 25, windowSeconds = 10 },
	-- Killing whoever last killed you.
	revenge = { coins = 50, xp = 15, cap = 5 },
	-- Multi-kills, the battle royale's streak (MatchService STREAK_WINDOW, 50 a step: 50 for a double up to
	-- 200 for a rampage). tools/team_rewards_check.py fails if these drift from MatchService's. Coins only,
	-- as in the battle royale.
	streak = { windowSeconds = 8, coinsPerStep = 50, max = 5, cap = 600 },
	-- Objective Capture only, standing in for the kills that mode does not score. A capture pays everyone of
	-- the capturing team standing on it; time pays per second on an objective your team owns (contested
	-- counts: that is defending it); a defend is a kill of an enemy standing on an objective your team owns,
	-- paid on top of the kill. Sized so Objective Capture lands within a few % of Team Deathmatch.
	capture = { coins = 70, xp = 30, cap = 8 },
	hold = { coinsPerSecond = 1.25, xpPerSecond = 0.4, capSeconds = 240 },
	defend = { coins = 40, xp = 15, cap = 10 },
	-- TEAM BONUS. The best on each team by performance value (uncapped), if it is at least `minCoins`. A bot
	-- can be MVP; then nobody on that team gets the bonus. Never an AFK player. The team modes' answer to
	-- the battle royale's win, paid for carrying rather than for being carried.
	mvp = { coins = 2000, xp = 120, minCoins = 150 },
	-- Paid per minute of ACTIVE play. Checked every `sampleSeconds`: active if the body moved
	-- ProgressionData.Playtime.MoveStuds since the last check in the same life, or dealt damage, or took an
	-- objective or stood on a contested one (a defender behind cover need not move); while dead
	-- a check carries the last live one forward (a player who died mid-fight is still playing, an idle one
	-- is still idle). A respawn is never movement.
	participation = { coinsPerMinute = 15, xpPerMinute = 11, sampleSeconds = 15, minActiveShare = 0.5 },

	-- More TEAM BONUS (RewardService.AwardTeamResult keeps the state):
	--   firstWin     the first team win of each UTC day: an Epic Crate on top of the win's own, plus coins
	--                and XP. Marked in the day's quest progress, so it is saved and resets at midnight.
	--   winStreak    each consecutive team win after the first pays a step more, up to `maxSteps` steps
	--                (a 5-win run pays 4 steps). A draw, a loss or an idle match ends the run.
	--   milestones   lifetime team wins that unlock the team-only cosmetics (CosmeticData `teamOnly`: never
	--                sold, never in a crate). One per match at most, the lowest not yet owned.
	bonus = {
		firstWin = { crate = "Epic", coins = 1500, xp = 500 },
		winStreak = { coins = 250, xp = 60, maxSteps = 4 },
		milestones = {
			{ wins = 3, cosmetic = "TeamSquadStripeSkin" },
			{ wins = 10, cosmetic = "TeamRallyAura" },
			{ wins = 25, cosmetic = "TeamWarbannerSkin" },
			{ wins = 50, cosmetic = "TeamCommanderAura" },
		},
	},
}
-- What that comes to (tools/economy_model.py s.2b, 2026-09-24), coins an hour / XP an hour as a multiple
-- of the same player's battle royale hour:
--                    Team Deathmatch   Objective Capture
--   loses only         1.35 / 1.43       1.45 / 1.42
--   wins sometimes     1.41 / 1.31       1.50 / 1.30
--   strong             1.38 / 1.50       1.43 / 1.45
-- Not counted: the milestone cosmetics, and the crates' brainrots sold (a team hour holds fewer crates,
-- 6.5 against 10-19, so selling everything narrows the lead; see ECONOMY.md s.2b).
MatchConfig.XpPerKill = 60

-- Vehicles parked at each team's base in the team modes (Oliver, 2026-09-24: "make vehicles spawn near
-- the spawns of the teams on team gamemodes"). ModeTeams parks them; they are EXTRA to the map's own
-- town and verge parking, which every mode keeps. One per slot, and both bases get the same models.
--   Slots          "armed" is a car with a mounted weapon (Rotster, Crocodilo Ranger, Sahur Van);
--                  "car" is any car, weighted as the map rolls them; "bike" is any bike. At most one
--                  bike: a base of bikes is a base nobody can fight from.
--   Inner/Outer    studs from the base point the spots are looked for between. The pads spread 60
--                  from it, so the ring overlaps them and PadClearance does the keeping apart.
--   PadClearance   studs from a vehicle's centre to any spawn pad: half a Ranger's length (7.3) plus
--                  the 8-stud box a pad keeps clear, plus a few to walk round the bumper.
--   Gap            studs between two base vehicles' centres, so none is parked into another.
--   LootClearance  studs from any loot already lying there (the base caches).
--   RespawnDelay   seconds after a base vehicle is wrecked (or lost off the map) before a replacement
--                  is parked; never more live base vehicles than slots.
MatchConfig.TeamBaseVehicles = {
	Enabled = true,
	-- Oliver, 2026-09-24: "add more cars to spawn bases". Six, one for each bay of the compound's yard.
	-- Then "we need armored vehicles too": one of the two gun cars is an armoured car (the scout car or
	-- the carrier, rolled once for both bases), so each side has exactly one and neither has two. In the
	-- world they are rare (VehicleModels weights 6 and 4 against the cars' 86); at a base, one of six is
	-- a fair share for a mode built round pushing across one arena.
	Slots = { "armored", "armed", "car", "car", "car", "bike" },
	Inner = 22,
	Outer = 75,
	PadClearance = 18,
	Gap = 18,
	LootClearance = 10,
	RespawnDelay = 45,
}

-- Bots backfill the lobby and play for real: they carry actual weapons from WeaponData,
-- push and strafe instead of standing still, fight each other as well as players, and
-- retreat when hurt. Accuracy falls off with range so close fights are genuinely dangerous
-- and long ones are survivable.
-- #127 (Oliver, 2026-09-22): "reduce the bot count down to 30". Was 50 (49 bots with one player).
-- Oliver, 2026-09-22 13:45: "we need 50 players in the battle royale rounds and keep 30 in the other
-- gamemodes". So the fill target is per mode: MatchService fills to min(target, MaxPlayers) minus the
-- real players, reading BotFillTargetBattleRoyale for the battle royale and BotFillTarget for every
-- other mode (TDM, KOTH). 50 in the battle royale means 49 bots with one player, as it was before #127;
-- the team modes keep 30, where bunched bots were the lag complaint (#126).
MatchConfig.BotFillTarget = 30
MatchConfig.BotFillTargetBattleRoyale = 50
MatchConfig.BotHealth = 100
MatchConfig.BotWalkSpeed = 17
MatchConfig.BotThinkInterval = 0.25

-- Nerfed 2026-09-18 on Oliver's "nerf the ai aim a bit": near 0.66 -&gt; 0.55, far 0.19 -&gt; 0.15, which
-- is about a sixth off a bot's hit rate at every range (measured at 20, 60 and 150 studs by
-- tools/bot_probe.lua's S23). Accuracy falls off with distance, so these two numbers and the falloff
-- below are the whole difficulty dial, alongside BotDamageScale.
-- Oliver, 2026-09-22 14:39: "un nerf the bots aim". Back to the pre-#118 values.
-- Oliver, 2026-09-22 21:34: "make the bots aim a little better". Up a notch (0.66/0.19 -&gt; 0.71/0.22);
-- BotService also lets aim settle on a target and makes fast-moving targets harder to hit.
MatchConfig.BotAccuracyNear = 0.71
MatchConfig.BotAccuracyFar = 0.22
MatchConfig.BotAccuracyFalloff = 120
-- #75/#81 (Oliver: "increase bots reaction speed and their aggressiveness"). Was 0.28, which a
-- bot could only honour in whole thinks (one every ~0.267 s), so it was really two thinks. 0.12 is a
-- real time now: BotService fires the first shot on a short timer when the reaction ends between
-- thinks. Aim does NOT move with it: BotService's aim settle is pinned to the old 0.28 (#40).
MatchConfig.BotReactionTime = 0.12
MatchConfig.BotBurstRest = 0.48

MatchConfig.BotVisionRange = 260
-- Aggression is commitment, not lethality (#75/#81 ruling). Closer fights (was 70) and a later
-- retreat (was 26 hp). 55 not 45: closing in raises the hit rate through the distance falloff
-- (base chance 0.42 at 70 studs, 0.49 at 55, 0.53 at 45), and 45 buys more of that than the ruling
-- allows. Guns with a short reach fight at 0.6 of it either way. tools/bot_aggression_ab.lua
-- measures 55 and 45 against the old values.
MatchConfig.BotEngagePreferred = 55
MatchConfig.BotRetreatHealth = 15

-- Regen only starts after a bot has been out of a fight for a while, which keeps chip damage
-- meaningful without making a wounded bot a permanent free kill. It's the slow fallback;
-- a bot carrying heal items uses those first.
MatchConfig.BotRegenDelay = 9
MatchConfig.BotRegenPerSecond = 3.5

-- Heal items. Bots use Bandages and Med Kits below this share of max health, only once
-- they've been out of sight for BotHealLull seconds (so a heal is a reward for breaking
-- contact, never a mid-duel refill), and no faster than the player heal cooldown.
MatchConfig.BotHealBelow = 0.6
MatchConfig.BotHealLull = 1.5
MatchConfig.BotHealCooldown = 1.5
MatchConfig.BotStartBandages = 1
MatchConfig.BotPlayerBias = 1.6
MatchConfig.BotDamageScale = 0.8

-- Awareness. A target in front of a bot (a 150-degree cone) is noticed at once; one behind it takes
-- BotRearNoticeTime, unless it's the one shooting, so sneaking up on a bot works. When a target
-- breaks line of sight the bot goes to where it last saw them, for BotMemorySeconds plus the time
-- it takes to walk there, instead of tracking them through walls.
-- #75/#81: rear notice 1.2 -&gt; 0.7 (sneaking up still works, for less long); hunting a lost target
-- 6 -&gt; 10 s plus the walk, so a bot chases instead of going back to looting.
MatchConfig.BotRearNoticeTime = 0.7
MatchConfig.BotMemorySeconds = 10

-- Below this share of max health, a bot that's being hit looks for cover (or builds some).
-- Oliver, 2026-09-22 21:35: "make them take cover". Was 0.6.
MatchConfig.BotCoverHealth = 0.8
-- #75/#81: a bot being shot by someone it can't see used to run whenever it was under BotCoverHealth
-- (0.8 since 21:35, so at 79 hp). That's cover in a fight, which stays; running from an unseen
-- shooter now waits until half health, and above that the bot goes looking for them.
MatchConfig.BotFleeHealth = 0.5
-- Pushing a nearly dead target, which overrides taking cover: the target under this share of its
-- health, the bot over that share of its own. Were 0.35 and 0.5 (#75/#81: push earlier).
MatchConfig.BotPushTargetBelow = 0.5
MatchConfig.BotPushHealthAbove = 0.4
-- Team modes: how long a freshly spawned bot spends gearing up at its base (chests first) before it
-- heads for the fight. Ends early once the base has nothing it wants.
MatchConfig.BotBaseGearSeconds = 30

-- Storm pressure: the distance to the safe circle over how far a bot can walk before the storm
-- gets there. Past Rotate it stops looting outside that circle and sprints its wander legs; past
-- Urgent it drops everything and heads in, shooting on the move.
MatchConfig.BotStormRotate = 0.6
MatchConfig.BotStormUrgent = 0.9

-- Bots empty magazines and reload with the gun's own magSize and reloadTime, like players.
MatchConfig.BotReload = true

-- Bots at the wheel (BotService's BOT VEHICLES, BotNav's DRIVING). Oliver, 2026-09-24: "make the bots
-- shoot the vehicle guns and drive the cars". A bot takes any vehicle for a trip longer than
-- BotDriveMinTrip when one stands within BotBoardReach (the goal must not be behind it); in a fight it
-- may jump on an armed vehicle's gun. At most this many bots drive at once: BotDriversMax across a
-- battle royale, BotDriversPerTeam for each side of a team mode. A bot at the wheel of an armed vehicle
-- waits for someone on the gun (Oliver: "wait till it's manned") for up to BotGunnerWait seconds, then
-- gives the vehicle up.
MatchConfig.BotDriversMax = 6
MatchConfig.BotDriversPerTeam = 4
MatchConfig.BotDriveMinTrip = 220
MatchConfig.BotBoardReach = 60
MatchConfig.BotGunnerWait = 25

MatchConfig.CoinsPerBotKill = 40
MatchConfig.XpPerBotKill = 32

function MatchConfig.GetBracket(rank)
	for _, bracket in ipairs(MatchConfig.PlacementBrackets) do
		if rank &lt;= bracket.maxRank then
			return bracket
		end
	end
	return nil
end

return MatchConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">MatchEvents</string><ProtectedString name="Source">-- Match events: a modifier rolled when a match starts, so two matches on the same map don't play
-- the same. Announced on the banner and in a toast. Some matches (NoneChance) have none.
--
--   chestGuns            guns per chest (normally 2)
--   chestRarityFloor     every chest's first gun is at least this rarity
--   dropInterval         seconds between supply drops (normally 95)
--   firstDrop            seconds before the first supply drop (normally 75)
--   speedMultiplier      every player's base walk speed
--   startShield          shield everyone drops in with
--   placementMultiplier  placement coins
--   bountyMinKills       kills before a bounty goes on the leader (normally 3)
--   bountyMultiplier     bounty rewards
--   headshotMultiplier   scales every headshot on top of the gun's own multiplier
--   stormSpeed           how much faster the storm's phases run
--   gravity              workspace gravity, as a fraction of normal
--   lighting             overrides laid over the map's own time of day

local MatchEvents = {}

-- Zone Rush's storm speed, named once so its card can quote it: "half again as fast" was an idiom
-- many players would not read as 1.5x (#86), and a typed "50%" would drift from the number.
local ZONE_RUSH_SPEED = 1.5

MatchEvents.NoneChance = 0.3

MatchEvents.List = {
	{
		id = "LootFrenzy",
		name = "Loot Frenzy",
		description = "Three guns in every chest and a supply drop every minute.",
		color = Color3.fromRGB(255, 196, 64),
		chestGuns = 3,
		dropInterval = 60,
	},
	{
		id = "BountyRush",
		name = "Bounty Rush",
		description = "Bounties from the first kill, and they pay double.",
		color = Color3.fromRGB(255, 110, 110),
		bountyMinKills = 1,
		bountyMultiplier = 2,
	},
	{
		id = "RotRush",
		name = "Rot Rush",
		description = "Everyone moves 20% faster. Fights come to you.",
		color = Color3.fromRGB(80, 220, 255),
		speedMultiplier = 1.2,
	},
	{
		id = "ShieldUp",
		name = "Shield Up",
		description = "Everyone starts with 50 shield.",
		color = Color3.fromRGB(80, 170, 255),
		startShield = 50,
	},
	{
		id = "HighStakes",
		name = "High Stakes",
		description = "Placement coins pay 1.5x. Placing matters more than ever.",
		color = Color3.fromRGB(94, 214, 122),
		placementMultiplier = 1.5,
	},
	{
		id = "NightOps",
		name = "Night Ops",
		description = "Lights out. Street lamps, muzzle flashes and neon are all you've got.",
		color = Color3.fromRGB(120, 130, 220),
		lighting = { clockTime = 0.3, brightness = 0.35, ambient = Color3.fromRGB(16, 18, 30), outdoorAmbient = Color3.fromRGB(34, 38, 60) },
	},
	{
		id = "LowGravity",
		name = "Low Gravity",
		description = "Half gravity: jump higher, fall slower, and every rooftop is reachable.",
		color = Color3.fromRGB(200, 150, 255),
		gravity = 0.5,
	},
	{
		id = "ZoneRush",
		name = "Zone Rush",
		description = string.format("The storm closes %d%% faster. Keep moving.", math.floor((ZONE_RUSH_SPEED - 1) * 100 + 0.5)),
		color = Color3.fromRGB(190, 90, 255),
		stormSpeed = ZONE_RUSH_SPEED,
	},
	{
		id = "HotDrops",
		name = "Hot Drops",
		description = "A supply drop every 45 seconds, the first before the storm even starts.",
		color = Color3.fromRGB(255, 150, 60),
		dropInterval = 45,
		firstDrop = 20,
	},
	{
		id = "Headhunter",
		name = "Headhunter",
		description = "Headshots deal double. Aim high.",
		color = Color3.fromRGB(255, 220, 90),
		headshotMultiplier = 2,
	},
	{
		id = "AuraFarm",
		name = "Aura Farm",
		description = "Every chest holds at least one Epic gun.",
		color = Color3.fromRGB(190, 120, 255),
		chestRarityFloor = "Epic",
	},
}

local byId = {}
for _, event in ipairs(MatchEvents.List) do
	byId[event.id] = event
end

function MatchEvents.Get(id)
	return byId[id]
end

-- nil for a plain match, otherwise one event at random.
function MatchEvents.Roll()
	if math.random() &lt; MatchEvents.NoneChance then
		return nil
	end
	return MatchEvents.List[math.random(1, #MatchEvents.List)]
end

-- What clients are told: enough to announce it, nothing they could use to cheat.
function MatchEvents.Describe(event)
	if not event then
		return nil
	end
	return { id = event.id, name = event.name, description = event.description, color = event.color }
end

return MatchEvents
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">MovementConfig</string><ProtectedString name="Source">-- Movement tuning: stamina, the slide, ledge climbing (mantle) and vaulting.
--
-- One table read by every side of it, so the numbers can never disagree:
--   * MatchService keeps the stamina ledger and the slide window on the server,
--   * Shared/Parkour finds ledges and obstacles and builds the path a climb or vault follows,
--   * StarterPlayerScripts/MovementClient runs the local player's moves and predicts stamina,
--   * HudClient draws the stamina bar,
--   * MovementService runs the same moves for bots on the server,
--   * tools/movement_probe.lua measures all of it in real physics.
--
-- Heights are in studs above the character's FEET (root height minus HipHeight minus half the root),
-- so a scaled avatar gets the same rules as a default one.

local MovementConfig = {}

--------------------------------------------------------------------------------
-- Stamina
--------------------------------------------------------------------------------

MovementConfig.Stamina = {
	Max = 100,
	-- Sprinting only drains while you're actually moving faster than this (studs/s, horizontal), so
	-- holding sprint against a wall or standing still costs nothing.
	MovingSpeed = 6,
	-- 100 stamina at 5.5 a second is 18.2 seconds of continuous sprinting, up from 11.1 at the old 9.
	-- Long enough to cross open ground and still be able to slide at the other end.
	SprintDrainPerSecond = 5.5,
	-- Regeneration waits this long after the last drain or cost, then refills at RegenPerSecond.
	RegenDelay = 0.8,
	RegenPerSecond = 25,
	-- Hitting zero exhausts you: sprint drops, and it can't start again until stamina is back to this.
	-- Exhausted, the refill also waits longer before it starts.
	ExhaustedUntil = 30,
	ExhaustedRegenDelay = 1.4,
	-- One-off costs.
	SlideCost = 18,
	VaultCost = 8,
	MantleCost = 12,
	-- A hop onto something no higher than this costs nothing.
	FreeMantleRise = 4.5,
	-- Stamina only matters in a match: in the lobby, the Cloud Climb and the firing range it is pinned
	-- full and you can sprint forever. That rule is MatchService's staminaApplies (and the client's
	-- stepStamina), not a number here — there used to be a LobbyDrains key in this table that nothing
	-- read, which is worse than no key at all.
}

--------------------------------------------------------------------------------
-- Slide
--------------------------------------------------------------------------------

-- A slide is entered from the CROUCH key while sprinting; it has no control of its own. It lowers the
-- body by exactly as much as a crouch does (Crouch.HipScale, applied by MatchService's one height rule),
-- so you can take one under a gap you couldn't walk through: measured at 4.6 studs and up, against 5.4
-- for a standing body.
MovementConfig.Slide = {
	-- The server's ceiling: while a slide is active, applySpeed multiplies walk speed by this.
	-- The client shapes the real speed underneath it (see MovementClient), so this is the fastest a
	-- slide can ever go, downhill included.
	PeakMultiplier = 1.75,
	-- The client's curve: the slide starts at StartMultiplier x the speed you were sprinting at and
	-- bleeds toward FloorSpeed at Friction per second (exponential), plus or minus the slope.
	StartMultiplier = 1.6,
	FloorSpeed = 14,
	Friction = 1.1,
	-- Downhill adds SlopeGain x gravity x sin(slope) per second; uphill takes the same away.
	SlopeGain = 0.55,
	-- It ends below EndSpeed, after MaxTime, or when you've been airborne longer than AirGrace.
	EndSpeed = 17,
	MaxTime = 1.1,
	AirGrace = 0.3,
	-- You need to be sprinting at this fraction of full sprint speed to start one.
	MinEntryFraction = 0.75,
	-- After a slide ends, the next can start this much later. The server enforces it (with the
	-- window below), the client predicts it.
	Cooldown = 0.6,
	-- How long the server keeps the slide factor on if the client never says it ended.
	ServerWindow = 1.3,
	-- A bot has no client to shape its slide, so it gets a flat burst at the ceiling for this long.
	BotWindow = 0.65,
	-- Steering: how fast A/D can turn a slide, degrees per second.
	TurnRate = 50,
	-- The camera drops this far, and the field of view widens by FovKick degrees.
	CameraDrop = 1.6,
	FovKick = 7,
}

--------------------------------------------------------------------------------
-- Crouch
--------------------------------------------------------------------------------

MovementConfig.Crouch = {
	-- A factor inside applySpeed, like everything else: 18 x 0.45 = 8.1 studs/s.
	SpeedMultiplier = 0.45,
	-- The body really goes down: HipHeight is scaled to this, which lowers the whole rig (the fold in the
	-- legs is drawn per client by Shared/CrouchAnimation). Measured against gaps and a hit-profile grid by
	-- tools/crouch_probe.lua.
	HipScale = 0.53,
	-- Never below this, whatever a scaled avatar's HipHeight is.
	MinHipHeight = 0.8,
	-- The camera and the gun follow the body down by this much (studs), eased, never snapped.
	CameraDrop = 1.0,
	GunDip = 0.25,
	-- How loud a crouched body's footsteps are, as a fraction of normal. Roblox's own character sounds do
	-- the stepping; every client turns the volume down on any body it can see crouching, so crouching is
	-- quiet for the people listening, not just for you. Not silent: crouch is cover, not invisibility.
	StepVolume = 0.35,
	-- Sprinting and crouching cancel each other; a slide settles into a crouch if the input is still held.
	-- After standing up, this long before a crouch can start again (stops a per-shot crouch flicker).
	Cooldown = 0.15,
	-- Crouched and barely moving, the gun is steadier: spread and recoil scale by these. The server
	-- owns the spread (CombatService.SpreadFor, which is what Fire shoots with); the camera kick is
	-- the shooter's own client, so it reads the same numbers from here rather than keeping a second
	-- copy of them. Both fade in over SteadyFade and out over the same, so a crouch tapped for the
	-- instant of a shot pays nothing, and standing up ends it at once with no trailing grace.
	-- "Barely moving" is SteadyMoveFraction of base walk speed: crouch-walking is 45% of base, above
	-- it, so this is for holding still rather than for holding the key.
	SteadySpread = 0.75,
	SteadyRecoil = 0.85,
	SteadyFade = 0.2,
	SteadyMoveFraction = 0.4,
}

--------------------------------------------------------------------------------
-- Air momentum
--------------------------------------------------------------------------------

-- Leaving the ground faster than you could run (a slide-jump, a Rot Rocket, a Launch Pad, a Blink
-- Bean) keeps that speed through the air instead of the humanoid's air control braking it to walking
-- pace in a fraction of a second. You can steer it, and pulling back slows it.
MovementConfig.AirMomentum = {
	-- Only kicks in when the horizontal speed at takeoff beats walk speed by this much.
	MinExcess = 3,
	-- Degrees per second the held momentum turns toward where you're pushing.
	TurnRate = 110,
	-- Studs/s lost per second when pushing against it, and fractional drag per second otherwise.
	Brake = 38,
	Drag = 0.06,
}

--------------------------------------------------------------------------------
-- Ledges and obstacles
--------------------------------------------------------------------------------

MovementConfig.Parkour = {
	-- A ledge needs at least this rise; anything lower you just walk or hop onto.
	MinRise = 1.6,
	-- How far in front of the body a wall can be and still be grabbed.
	Reach = 2.4,
	-- Hands overhead: the highest ledge above the feet you can get a grip on right now (jumping
	-- raises the feet, so a jump reaches higher).
	HandReach = 7.2,
	-- The design cap, measured from the last thing you stood on, so no chain of jumps and grabs gets
	-- further than one real climb. Set against town roofs with tools/roof_access_probe.lua.
	MaxRiseFromGround = 9.5,
	-- Vaulting: a thin obstacle (fence, rail, low wall, window sill) no higher than VaultMaxRise and no
	-- deeper than VaultMaxDepth, with somewhere to land within VaultMaxDrop below its top.
	VaultMinRise = 1.6,
	VaultMaxRise = 4.8,
	VaultMaxDepth = 3.2,
	VaultMaxDrop = 9,
	-- Through a window (a lintel over the sill) the landing may be this far down instead: out of an upstairs
	-- window to the street (a storey is 15, so a second-floor sill is ~19 up; Oliver, 2026-09-24). The vault
	-- ends just outside the window at this forward speed and the rest is a plain fall (no fall damage).
	WindowMaxDrop = 40,
	WindowDropExitSpeed = 10,
	-- Room needed over the top to get through: a vault is a tucked dive, so a 5-stud window works.
	VaultClearance = 3.4,
	-- You have to be moving at least this fast (studs/s) toward it to vault; slower and it's a climb.
	VaultMinSpeed = 9,
	-- In the air within this much of the ground last stood on (a plain jump's apex is 6.4), a vault is
	-- measured from THAT ground rather than from the rising feet: a body that jumped at a sill meant to
	-- vault it, and measured from its feet the same sill read lower every frame until it vanished
	-- (tools/vault_jump_probe.lua). Beyond it (a Bounce Boots jump, a launch) the feet are the reference.
	JumpGrace = 6.5,
	-- A surface counts as a ledge top when its normal is at least this upright.
	TopNormal = 0.72,
	-- A wall counts as a wall when its normal is at most this upright.
	WallNormal = 0.4,
	-- Timings. A mantle's pull-up scales with the height it covers.
	MantleBaseTime = 0.16,
	MantlePerStud = 0.028,
	MantleMaxTime = 0.44,
	MantleOverTime = 0.17,
	-- A vault covers its path at the speed you arrived with, never slower than this.
	VaultMinPathSpeed = 17,
	-- Out of stamina, climbs still happen (you can't be trapped) but take this much longer.
	ExhaustedTimeScale = 1.6,
	-- After a climb or vault lands, a new one can't start for this long.
	Recovery = 0.25,
}

return MovementConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">ObjectiveZone</string><ProtectedString name="Source">-- The shape of an Objective Capture objective, in one place (#93).
--
-- Two things describe an objective: the ring players SEE on the ground, and the test the server
-- runs to decide who is STANDING on it. They used to be worked out separately (both happened to
-- read `mode.hillRadius`, and the capture band's -6 / hillHeight lived only in the capture code),
-- so nothing stopped a later change to one from leaving the other behind: a ring you are visibly
-- inside that doesn't count, or a capture that reaches past the paint. Both now come from here,
-- so the picture you approve is the rule that ships.
--
--   ObjectiveZone.Radius(mode)              -&gt; studs from the centre to the edge of the ring
--   ObjectiveZone.Height(mode)              -&gt; how high above the centre still counts
--   ObjectiveZone.Contains(mode, centre, p) -&gt; is point p on the objective at `centre`
--   ObjectiveZone.RingSize(mode)            -&gt; the ring part's Size (a Cylinder)
--   ObjectiveZone.RingCFrame(centre)        -&gt; the ring part's CFrame
--
-- `mode` is the mode table (GameModes.Modes.KingOfTheHill) or nil for the defaults. Pure: no
-- services, so a harness can run it outside Studio (tools/objective_zone_check.py).

local ObjectiveZone = {}

ObjectiveZone.DefaultRadius = 28
ObjectiveZone.DefaultHeight = 22
-- How far BELOW the centre still counts: the ring sits on the ground, and a root part on a slope
-- or a step down the edge of the hill is a little under the centre's height.
ObjectiveZone.Below = 6
-- The ring is a thin disc; the lift keeps its top clear of the ground it lies on (ZFight's step x3,
-- as before).
ObjectiveZone.RingThickness = 0.4
ObjectiveZone.RingLift = 0.21

function ObjectiveZone.Radius(mode)
	return (mode and mode.hillRadius) or ObjectiveZone.DefaultRadius
end

function ObjectiveZone.Height(mode)
	return (mode and mode.hillHeight) or ObjectiveZone.DefaultHeight
end

-- Flat distance, so standing on the ring counts wherever the ground is; the edge itself counts, the
-- same as the painted disc, which is drawn right out to it.
function ObjectiveZone.Contains(mode, centre, point)
	local dx, dy, dz = point.X - centre.X, point.Y - centre.Y, point.Z - centre.Z
	local radius = ObjectiveZone.Radius(mode)
	return dx * dx + dz * dz &lt;= radius * radius and dy &gt;= -ObjectiveZone.Below and dy &lt;= ObjectiveZone.Height(mode)
end

-- A Cylinder part's LENGTH is its X axis and its diameter is the smaller of Y and Z, so the disc is
-- (thickness, diameter, diameter) and RingCFrame turns X to point up.
function ObjectiveZone.RingSize(mode)
	local diameter = ObjectiveZone.Radius(mode) * 2
	return Vector3.new(ObjectiveZone.RingThickness, diameter, diameter)
end

function ObjectiveZone.RingCFrame(centre)
	return CFrame.new(centre + Vector3.new(0, ObjectiveZone.RingLift, 0)) * CFrame.Angles(0, 0, math.pi / 2)
end

return ObjectiveZone
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">ParachuteModels</string><ProtectedString name="Source">-- Parachute cosmetics: the canopies bought in the shop or pulled from crates, opened over your
-- head on the match drop-in and by the Rot Glider.
--
-- ParachuteModels.Build(id, options) keeps the contract of ItemModels.Build("RotGlider",
-- { open = true }), which MovementService hangs over every character. It returns the model and
-- its body: the harness bar at the design origin, which the model pivots on, with the canopy
-- above it and the straps down to the shoulders. An id with no design here, nil included, builds
-- that default Rot Glider canopy instead, so nothing changes for anyone without a parachute.
--
-- Every canopy is solid.
--   Wings: a row of cells round an arc, each exactly as wide as its slice of the arc along the top
--   skin, so neighbours meet along the top and overlap underneath. A shaped outline (a swept manta,
--   a scalloped membrane, feather tips) is cells plus a wedge from each cell to its seams' depths,
--   so the edge runs straight from seam to seam.
--   Domes: gores and rows tiled the same way in both directions.
-- Paint, trim and decoration sit on that skin, never in place of it, so nothing anywhere is
-- see-through. tools/parachute_probe.lua raycasts every canopy from six sides and from the pilot's
-- eye to prove it. No canopy has Neon or transparency.
--
-- Designs are authored at the Rot Glider's size (1 unit = 1 stud at scale 1) and worn at scale 3.
-- Offsets that only keep two faces apart are held in world studs (`k.gap`), clear of the z-fight
-- guard's tolerance; anything smaller than worn is built worn and shrunk (see Build).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemModels = require(Shared:WaitForChild("ItemModels"))
local ZFight = require(Shared:WaitForChild("ZFight"))

local ParachuteModels = {}

-- The scale MovementService wears a canopy at.
ParachuteModels.WornScale = 3

local V = Vector3.new
local rgb = Color3.fromRGB

-- Canopy cloth is smooth: at the worn size Roblox's Fabric texture reads as chunky knitting and
-- dulls every colour (compared in tools/parachute_gallery.lua renders, 2026-09-17). Fabric is kept
-- for sewn-on patches, where the weave is the point.
local CLOTH = Enum.Material.SmoothPlastic
local TEXTILE = Enum.Material.Fabric
local PLASTIC = Enum.Material.SmoothPlastic
local METAL = Enum.Material.Metal
local FOIL = Enum.Material.Foil
local WOOD = Enum.Material.Wood
local SAND = Enum.Material.Sand
-- Clouds and cotton candy: a soft, matte texture rather than shiny balloons.
local PUFF = Enum.Material.Snow

local DARK = rgb(40, 42, 48)
local LINE = rgb(236, 232, 220)
local BLACK = rgb(24, 24, 28)

-- The Rot Glider's wing: its arc, how far round it goes, where its top sits over the harness bar,
-- and how thick and deep its cells are.
local RADIUS = 2.3
local SPAN = math.rad(150)
local TOP = 2.6
local THICK = 0.16
local CHORD = 1.6

-- The step between two faces that must not fight, in world studs: clear of ZFight's 0.055 fix
-- tolerance at any scale.
local GAP_STUDS = 0.075

-- Where the harness lines meet the bar, either side of the head.
local RISER_X = 0.55

local function pick(value, ...)
	if type(value) == "function" then
		return value(...)
	end
	return value
end

--------------------------------------------------------------------------------
-- The kit every design builds with
--------------------------------------------------------------------------------

local function newKit(model, scale, anchored)
	-- `layout` records the wings and domes a design built, for tools/parachute_probe.lua's seam test.
	local k = { scale = scale, gap = GAP_STUDS / scale, layout = { wings = {}, domes = {} } }

	local function place(part, name, size, cframe, color, material)
		part.Name = name
		part.Size = size * scale
		part.CFrame = CFrame.new(cframe.Position * scale) * cframe.Rotation
		part.Color = color
		part.Material = material or CLOTH
		part.Transparency = 0
		part.Reflectance = 0
		part.Anchored = anchored
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CastShadow = true
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = model
		return part
	end

	local function frameOf(at)
		return typeof(at) == "CFrame" and at or CFrame.new(at)
	end

	function k.block(name, size, cframe, color, material)
		return place(Instance.new("Part"), name, size, frameOf(cframe), color, material)
	end

	function k.ball(name, diameter, at, color, material)
		local part = Instance.new("Part")
		part.Shape = Enum.PartType.Ball
		return place(part, name, V(diameter, diameter, diameter), CFrame.new(frameOf(at).Position), color, material)
	end

	-- A cylinder along `cframe`'s X axis.
	function k.cylinder(name, length, diameter, cframe, color, material)
		local part = Instance.new("Part")
		part.Shape = Enum.PartType.Cylinder
		return place(part, name, V(length, diameter, diameter), cframe, color, material)
	end

	-- A disc lying on a surface frame (its +Y the surface normal).
	function k.disc(name, thickness, diameter, cframe, color, material)
		return k.cylinder(name, thickness, diameter, cframe * CFrame.Angles(0, 0, math.pi / 2), color, material)
	end

	local function lookFrame(a, b)
		local direction = (b - a).Unit
		local up = math.abs(direction.Y) &gt; 0.99 and Vector3.xAxis or Vector3.yAxis
		return CFrame.lookAt((a + b) / 2, b, up)
	end

	-- A cylinder from `a` to `b`.
	function k.rod(name, a, b, diameter, color, material)
		return k.cylinder(name, (b - a).Magnitude, diameter, lookFrame(a, b) * CFrame.Angles(0, math.pi / 2, 0), color, material)
	end

	-- A square-section strip from `a` to `b`: lines and cords.
	function k.strip(name, a, b, width, color, material)
		return k.block(name, V(width, width, (b - a).Magnitude), lookFrame(a, b), color, material)
	end

	function k.wedge(name, size, cframe, color, material)
		return place(Instance.new("WedgePart"), name, size, cframe, color, material)
	end

	-- A flat triangle `thickness` thick, centred on the plane through a, b and c. A right triangle
	-- is one wedge; any other is split at the foot of its height into two.
	function k.triangle(name, a, b, c, thickness, color, material)
		-- A right angle at any corner: one wedge, its right-angled edge at that corner (a wedge's
		-- bottom-back edge), one leg up its height and the other forward along its depth.
		for _, corner in ipairs({ { a, b, c }, { b, c, a }, { c, a, b } }) do
			local p, q, r = corner[1], corner[2], corner[3]
			local legUp, legForward = q - p, r - p
			if math.abs(legUp.Unit:Dot(legForward.Unit)) &lt; 1e-3 then
				local up, back = legUp.Unit, -legForward.Unit
				return k.wedge(name, V(thickness, legUp.Magnitude, legForward.Magnitude),
					CFrame.fromMatrix(p + (legUp + legForward) / 2, up:Cross(back), up, back), color, material)
			end
		end

		local ab, ac, bc = b - a, c - a, c - b
		local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
		if abd &gt; acd and abd &gt; bcd then
			c, a = a, c
		elseif acd &gt; bcd and acd &gt; abd then
			a, b = b, a
		end
		ab, ac, bc = b - a, c - a, c - b
		local right = ac:Cross(ab).Unit
		local up = bc:Cross(right).Unit
		local back = bc.Unit
		local height = math.abs(ab:Dot(up))
		local first, second = nil, nil
		local nearDepth = math.abs(ab:Dot(back))
		if nearDepth &gt; 1e-3 then
			first = k.wedge(name, V(thickness, height, nearDepth), CFrame.fromMatrix((a + b) / 2, right, up, back), color, material)
		end
		local farDepth = math.abs(ac:Dot(back))
		if farDepth &gt; 1e-3 then
			second = k.wedge(name, V(thickness, height, farDepth), CFrame.fromMatrix((a + c) / 2, -right, up, -back), color, material)
		end
		return first, second
	end

	-- Rigging: how a canopy is hung from the harness.
	--
	-- Real canopies aren't hung on a handful of wires from one point. A webbing riser comes off each
	-- end of the bar, one trunk line per bundle rises from it, and each trunk cascades into thinner
	-- branches that spread to their own points under the canopy. That's what this builds, out of round
	-- cord (cylinders, which have no long flat sides to catch the light as a flat strip does).
	--
	-- `anchors` are points under the canopy, in design space. They're split by side and then into a
	-- front and a back bundle, so eight anchors come out as two risers, four trunks and eight branches
	-- rather than eight wires from two points.
	function k.rigging(anchors, color, thickness)
		local cord = color or LINE
		local thick = thickness or 0.026
		for _, side in ipairs({ -1, 1 }) do
			local mine = {}
			for _, anchor in ipairs(anchors) do
				if (anchor.X &lt; 0 and -1 or 1) == side then
					table.insert(mine, anchor)
				end
			end
			if #mine &gt; 0 then
				table.sort(mine, function(a, b)
					return a.Z &lt; b.Z
				end)
				-- The riser: a short length of webbing standing off the bar's end, which the trunks leave from.
				local top = V(side * (RISER_X - 0.03), 0.44, 0)
				k.block("Riser", V(0.09, 0.52, 0.07), CFrame.new(side * (RISER_X - 0.015), 0.2, 0) * CFrame.Angles(0, 0, side * 0.08), DARK, CLOTH)
				local half = math.ceil(#mine / 2)
				for bundle = 1, 2 do
					local first = bundle == 1 and 1 or half + 1
					local last = bundle == 1 and half or #mine
					if last &gt;= first then
						local middle = V(0, 0, 0)
						for index = first, last do
							middle += mine[index]
						end
						middle /= (last - first + 1)
						-- The cascade knot, part way up: one trunk to here, then a branch to each anchor.
						local knot = top:Lerp(middle, 0.58)
						k.rod("Line", top, knot, thick * 1.35, cord)
						for index = first, last do
							-- Each branch starts a little back down the trunk, so the joint has no gap in it.
							k.rod("Line", knot:Lerp(top, 0.06), mine[index], thick, cord)
						end
					end
				end
			end
		end
	end

	-- The Rot Glider's harness: the bar the canopy is welded over the head by, and the straps down
	-- to the shoulders.
	function k.harness(barColor, strapColor)
		local body = k.block("Body", V(1.4, 0.12, 0.12), CFrame.new(), barColor or DARK, METAL)
		-- The straps are a little deeper than the bar, so their front and back faces clear its.
		for _, x in ipairs({ -RISER_X, RISER_X }) do
			k.block("Strap", V(0.12, 1.1, 0.12 + 2 * k.gap), CFrame.new(x, -0.55, 0) * CFrame.Angles(0, 0, x * 0.3), strapColor or DARK, CLOTH)
		end
		return body
	end

	--------------------------------------------------------------------------------
	-- Wings
	--------------------------------------------------------------------------------

	-- spec: cells (odd, so there's a middle cell and the tips are alike), radius, span, top, thick.
	-- The outline is either
	--   chord and sweep: each cell's depth and how far back its middle sits (numbers, or functions of
	--     the cell's place along the span t, -1 .. 1, and its index), or
	--   frontAt and backAt: how far forward and back the wing reaches at each seam (functions of the
	--     seam's index and place along the span; either defaults to the Rot Glider's). Each cell is
	--     then the part both its seams reach, and `w.edges` fills out to the seams.
	function k.wing(spec)
		spec = spec or {}
		local w = {
			cells = spec.cells or 11,
			radius = spec.radius or RADIUS,
			span = spec.span or SPAN,
			top = spec.top or TOP,
			thick = spec.thick or THICK,
		}
		assert(w.cells % 2 == 1, "a wing needs an odd number of cells")
		table.insert(k.layout.wings, w)
		w.step = w.span / (w.cells - 1)
		local centreY = w.top - w.radius

		-- The frame `lift` out from the wing's mid-surface at `angle` round the arc: +Y outward, X
		-- along the span (towards the right-hand tip), Z front (-) to back (+).
		function w.arc(angle, lift)
			local r = w.radius + (lift or 0)
			return CFrame.new(math.sin(angle) * r, math.cos(angle) * r + centreY, 0) * CFrame.Angles(0, 0, -angle)
		end

		-- How wide a tile has to be for its face `outer` out from the mid-surface to meet its
		-- neighbours' along the seam.
		function w.tile(outer)
			return 2 * (w.radius + outer) * math.tan(w.step / 2)
		end

		-- Seam `s` runs between cells s and s + 1; seams 0 and `cells` are the two tips.
		function w.seamAngle(s)
			return -w.span / 2 + (s - 0.5) * w.step
		end

		-- A frame on a cell: `x` across it, `y` out from the mid-surface, `z` front to back. The arc
		-- turns about Z, so `z` is the same number in the cell's frame and the model's.
		function w.at(cell, x, y, z)
			return w.arc(cell.angle) * CFrame.new(x, y, z)
		end

		-- A frame on seam `s`, as `w.at` is on a cell.
		function w.onSeam(s, y, z)
			return w.arc(w.seamAngle(s)) * CFrame.new(0, y, z)
		end

		-- Where the cells either side of seam `s` overlap front to back (just the tip cell's chord at a
		-- tip).
		function w.seamChord(s)
			local left, right = w.list[s], w.list[s + 1]
			if left and right then
				return math.max(left.front, right.front), math.min(left.back, right.back)
			end
			local cell = left or right
			return cell.front, cell.back
		end

		-- Which way along X is further out past tip seam `s`.
		function w.outward(s)
			return s == 0 and -1 or 1
		end

		local seamed = spec.frontAt ~= nil or spec.backAt ~= nil
		local function seamT(s)
			return w.seamAngle(s) / (w.span / 2)
		end

		w.list = {}
		for i = 1, w.cells do
			local angle = -w.span / 2 + (i - 1) * w.step
			local t = angle / (w.span / 2)
			local cell = {
				i = i,
				t = t,
				angle = angle,
				-- A hundredth over, as the Rot Glider's cells are, so the seams close on the top skin.
				width = w.tile(w.thick / 2) + 0.01,
				-- The arc turns each cell about Z, so every cell's front face lies in the same plane as
				-- its neighbours', and they overlap underneath: flush faces. Every second cell stands a
				-- gap longer at both ends, and what's laid on it steps in a gap, so none are.
				stagger = i % 2 == 0 and k.gap or 0,
			}
			if seamed then
				local function front(s)
					return spec.frontAt and spec.frontAt(s, seamT(s)) or -CHORD / 2
				end
				local function back(s)
					return spec.backAt and spec.backAt(s, seamT(s)) or CHORD / 2
				end
				-- Index 1 is the seam on the cell's -X side, 2 the one on its +X side.
				cell.seamFront = { front(i - 1), front(i) }
				cell.seamBack = { back(i - 1), back(i) }
				cell.front = math.max(cell.seamFront[1], cell.seamFront[2])
				cell.back = math.min(cell.seamBack[1], cell.seamBack[2])
				cell.chord = cell.back - cell.front
				cell.sweep = (cell.front + cell.back) / 2
			else
				local chord = CHORD
				if type(spec.chord) == "function" then
					chord = spec.chord(t, i)
				elseif spec.chord then
					chord = spec.chord
				end
				local sweep = 0
				if type(spec.sweep) == "function" then
					sweep = spec.sweep(t, i)
				end
				cell.chord = chord
				cell.sweep = sweep
				cell.front = sweep - chord / 2
				cell.back = sweep + chord / 2
			end
			w.list[i] = cell
		end
		-- On a shaped wing a staggered cell's end can still land within a gap of a neighbour's (their
		-- depths differ by about the stagger), which brings back the flush faces the stagger is for. So
		-- each staggered cell takes the first stagger that clears BOTH neighbours at BOTH ends —
		-- checking only one neighbour just moves the problem to the other. A stagger can also go the
		-- other way (the cell a little shorter), which keeps every one of them small: the outline moves
		-- by at most three gaps, about a tenth of a stud as worn.
		for i = 2, w.cells - 1, 2 do
			local cell = w.list[i]
			for _, candidate in ipairs({ k.gap, -k.gap, 2 * k.gap, -2 * k.gap, 3 * k.gap, -3 * k.gap }) do
				cell.stagger = candidate
				local clear = true
				for _, neighbour in ipairs({ w.list[i - 1], w.list[i + 1] }) do
					if math.abs((cell.front - candidate) - neighbour.front) &lt; 0.8 * k.gap
						or math.abs((cell.back + candidate) - neighbour.back) &lt; 0.8 * k.gap then
						clear = false
					end
				end
				if clear then
					break
				end
			end
		end

		-- The cells themselves, one block each.
		function w.skin(color, material)
			for _, cell in ipairs(w.list) do
				-- Never a part with no depth, however the stagger and a shaped outline work out.
				local depth = math.max(cell.chord + 2 * cell.stagger, 0.05)
				cell.part = k.block("Cell", V(cell.width, w.thick, depth), w.at(cell, 0, 0, cell.sweep), pick(color, cell), material)
			end
		end

		-- For a wing built with frontAt/backAt: on each cell, a wedge from its end out to the deeper
		-- of its two seams, so the edge runs straight from seam to seam. Both cells at a seam reach
		-- that seam's depth there, so the outline is unbroken. `color(cell, edge)` colours them.
		function w.edges(color, material)
			for _, cell in ipairs(w.list) do
				for _, edge in ipairs({ "front", "back" }) do
					local out = edge == "front" and -1 or 1
					local depths = edge == "front" and cell.seamFront or cell.seamBack
					if depths then
						local base = cell[edge] + out * cell.stagger
						local deepSide = (depths[2] - depths[1]) * out &gt; 0 and 2 or 1
						local deep = depths[deepSide]
						-- Only worth a wedge if the step is big enough to see: below a few gaps (about a fifth
						-- of a stud as worn) the cell's own edge is close enough, and the tiny wedges two
						-- neighbours would make meet along the seam with their sloped faces parallel — flush.
						if (deep - base) * out &gt; 3 * k.gap then
							-- Two neighbouring wedges meet along a seam, and where the outline runs nearly
							-- straight their sloped faces come out parallel and touching: flush. Every second
							-- cell stops two gaps short of its seam's depth, which tilts its slope a few degrees
							-- clear of its neighbours' and moves the outline by about a tenth of a stud.
							if cell.i % 2 == 0 and (deep - base) * out &gt; 3 * k.gap then
								deep -= out * 2 * k.gap
							end
							local x = (deepSide == 2 and 1 or -1) * cell.width / 2
							k.triangle("Edge", w.at(cell, x, 0, base).Position, w.at(cell, x, 0, deep).Position, w.at(cell, -x, 0, base).Position,
								w.thick, pick(color, cell, edge), material)
						end
					end
				end
			end
		end

		-- The cells as bands front to back instead: `bounds` are chord fractions (-1 front, 1 back) and
		-- `color(cell, band)` colours each. Every second band stands a gap proud on both faces and
		-- overlaps its neighbours by a gap, so no two faces are flush and no crack can open between.
		-- On staggered cells every band grows a gap at both ends, which keeps each end clear of the
		-- neighbouring cells' band ends as well as of its own cell's.
		function w.bands(bounds, color, material)
			local g = k.gap
			local last = #bounds - 1
			for _, cell in ipairs(w.list) do
				for band = 1, last do
					local z0 = cell.front + (bounds[band] + 1) / 2 * cell.chord - cell.stagger
					local z1 = cell.front + (bounds[band + 1] + 1) / 2 * cell.chord + cell.stagger
					local raised = band % 2 == 0
					local size
					if raised then
						if band &gt; 1 then
							z0 -= g
						end
						if band &lt; last then
							z1 += g
						end
						size = V(w.tile(w.thick / 2 + g) + 0.01 + 2 * g, w.thick + 2 * g, z1 - z0)
					else
						size = V(cell.width, w.thick, z1 - z0)
					end
					k.block("Cell", size, w.at(cell, 0, 0, (z0 + z1) / 2), color(cell, band), material)
				end
			end
		end

		-- A panel over `v0`..`v1` of a cell's chord, on its top ("top") or underside ("bottom"). It's
		-- sunk a gap into the cell and stands `proud` gaps (default 1) out of it. `inset` pulls its
		-- sides in from the seams; without one it runs a gap past them, under its neighbour's panel.
		-- An end that would land on the cell's own front or back is pulled in a gap. Returns the panel
		-- and where its ends really are, front to back, for anything laid along them.
		function w.plate(cell, v0, v1, side, color, material, inset, proud, name)
			local g = k.gap
			proud = (proud or 1) * g
			local z0 = cell.front + (v0 + 1) / 2 * cell.chord
			local z1 = cell.front + (v1 + 1) / 2 * cell.chord
			if v0 &lt;= -1 then
				z0 += g
			end
			if v1 &gt;= 1 then
				z1 -= g
			end
			-- On a staggered cell a panel steps in at both ends, by however far the cell is staggered
			-- (whichever way): clear of its own cell's ends and of the same panel on the cells either side.
			z0 += math.abs(cell.stagger)
			z1 -= math.abs(cell.stagger)
			local width
			if inset then
				width = cell.width - 2 * math.max(inset, g)
			else
				width = w.tile(w.thick / 2 + proud) + 0.01 + 2 * g
			end
			local sign = side == "bottom" and -1 or 1
			local y = sign * (w.thick / 2 + (proud - g) / 2)
			-- Never a panel with no depth, however narrow a band and wide a stagger are asked for.
			local depth = math.max(z1 - z0, 0.02)
			return k.block(name or "Panel", V(width, proud + g, depth), w.at(cell, 0, y, (z0 + z1) / 2), color, material), z0, z1
		end

		-- A rounded leading edge along a cell, `diameter` thick. Its ends run past the seams under
		-- its neighbours' and its front stands just proud of the cell's.
		function w.nose(cell, diameter, color, material)
			local g = k.gap
			local length = w.tile(diameter / 2) + 0.01 + 4 * g
			return k.cylinder("Nose", length, diameter, w.at(cell, 0, 0, w.noseZ(cell, diameter)), color, material)
		end

		-- Where a nose of `diameter` along a cell has its middle, front to back.
		function w.noseZ(cell, diameter)
			return cell.front - cell.stagger + diameter / 2 - 2 * k.gap
		end

		-- A rib over every seam, standing a gap proud of the skin and spanning the chord the two cells
		-- share, and a cap on each tip. A rib is only the top half: underneath, the two cells' flat
		-- faces meet in a shallow groove along the seam, and a rib hanging into it would close over a
		-- sliver of sky (a pinhole seen straight along the wing). options: tipsOnly, tipColor, tipWidth,
		-- tipHeight, tipLift (how far the cap is moved out from the mid-surface; negative hangs it below).
		function w.ribs(color, width, material, options)
			options = options or {}
			local g = k.gap
			for s = 0, w.cells do
				local tip = s == 0 or s == w.cells
				if tip or not options.tipsOnly then
					local front, back = w.seamChord(s)
					local size
					-- Two gaps past the chord for a rib, so its ends clear both the plain and the staggered
					-- cells' ends; the tip cells are never staggered (the count is odd), so a cap needs one.
					local lift
					if tip then
						size = V(options.tipWidth or (0.1 + 4 * g), options.tipHeight or (w.thick + 4 * g), back - front + 2 * g)
						lift = options.tipLift or 0
					else
						size = V(width, w.thick / 2 + g, back - front + 4 * g)
						lift = (w.thick / 2 + g) / 2
					end
					k.block(tip and "TipCap" or "Rib", size, w.arc(w.seamAngle(s), lift) * CFrame.new(0, 0, (front + back) / 2),
						tip and options.tipColor or color, material)
				end
			end
		end

		-- Suspension lines from under seams `seams`, at chord fractions `rows` of the chord either side
		-- shares, down to the riser at that end of the harness bar. Each starts inside the skin and ends
		-- inside the bar.
		function w.lines(seams, rows, color, width)
			local anchors = {}
			for _, s in ipairs(seams) do
				local front, back = w.seamChord(s)
				for _, v in ipairs(rows) do
					local z = front + (v + 1) / 2 * (back - front)
					table.insert(anchors, w.onSeam(s, -w.thick / 2 + 0.02, z).Position)
				end
			end
			k.rigging(anchors, color, width)
		end

		return w
	end

	--------------------------------------------------------------------------------
	-- Domes
	--------------------------------------------------------------------------------

	-- A round canopy on a sphere of `radius`: `gores` panels round it and `rows` of them from the
	-- crown (`crown` from the top) to the hem (`hem` from the top), the hem at height `hemY`.
	--
	-- Flat panels can't tile a sphere exactly. Each is as wide as the dome at its lower edge, so it
	-- meets the next gore all the way down, and its narrower top runs a little past its neighbours'.
	-- Where two gores are different colours that overlap shows as a small triangle of the wrong
	-- colour, so a dome is coloured by row (rings), where panels meet edge to edge.
	function k.dome(spec)
		spec = spec or {}
		local d = {
			gores = spec.gores or 16,
			rows = spec.rows or 4,
			radius = spec.radius or 2.3,
			thick = spec.thick or 0.14,
			crown = spec.crown or math.rad(12),
			hem = spec.hem or math.rad(66),
			hemY = spec.hemY or 1.35,
		}
		d.centreY = d.hemY - d.radius * math.cos(d.hem)
		d.rowAngle = (d.hem - d.crown) / d.rows
		table.insert(k.layout.domes, d)

		-- The frame `lift` out from the mid-surface at `polar` from the top and `azimuth` round: +Y
		-- outward, X round the dome, Z down towards the hem.
		function d.frame(polar, azimuth, lift)
			local r = d.radius + (lift or 0)
			local out = V(math.sin(polar) * math.sin(azimuth), math.cos(polar), math.sin(polar) * math.cos(azimuth))
			local round = V(math.cos(azimuth), 0, -math.sin(azimuth))
			return CFrame.fromMatrix(V(0, d.centreY, 0) + out * r, round, out)
		end

		d.panels = {}
		local outer = d.radius + d.thick / 2
		for gore = 0, d.gores - 1 do
			local azimuth = (gore + 0.5) / d.gores * 2 * math.pi
			for row = 0, d.rows - 1 do
				local polar = d.crown + (row + 0.5) * d.rowAngle
				local length = 2 * outer * math.tan(d.rowAngle / 2) + 0.01
				local reach = outer * math.sin(polar) + length / 2 * math.cos(polar)
				local width = 2 * reach * math.tan(math.pi / d.gores) + 0.01
				table.insert(d.panels, {
					gore = gore,
					row = row,
					polar = polar,
					azimuth = azimuth,
					size = V(width, d.thick, length),
					frame = d.frame(polar, azimuth),
				})
			end
		end

		return d
	end

	return k
end

--------------------------------------------------------------------------------
-- Designs
--------------------------------------------------------------------------------

local DESIGNS = {}

-- The Rot Glider's six line seams on an 11-cell wing, and the two rows they hang from.
local LINE_SEAMS = { 2, 4, 5, 6, 7, 9 }
local LINE_ROWS = { -0.45, 0.4 }

-- Common ------------------------------------------------------------------------

-- A striped bedsheet pressed into service: sky and cream stripes, woven patches sewn on top and
-- underneath, a hem stitched along each patch, and the corners knotted at the tips.
DESIGNS.PatchworkChute = function(k)
	local body = k.harness()
	-- A deep sky blue against warm cream: the first pair (a pale blue and an off-white) washed out to
	-- much the same near-white in full sun, so the stripes didn't read from the ground.
	local SKY = rgb(78, 142, 198)
	local CREAM = rgb(238, 226, 194)
	local SEAM = rgb(196, 182, 152)
	local MUSTARD = rgb(230, 176, 52)
	local RUST = rgb(196, 84, 58)
	local DENIM = rgb(48, 78, 132)
	local MINT = rgb(108, 198, 142)
	local g = k.gap

	local w = k.wing()
	w.skin(function(cell)
		return cell.i % 2 == 1 and CREAM or SKY
	end, CLOTH)
	w.ribs(SEAM, 0.05, CLOTH)

	-- Warm patches on the blue stripes (the even cells) and dark ones on the cream, so every patch
	-- stands off the cloth it's sewn to.
	local patches = {
		{ 2, -0.55, 0.2, "top", MUSTARD },
		{ 4, 0.15, 0.85, "top", RUST },
		{ 6, -0.85, -0.15, "top", MUSTARD },
		{ 8, -0.2, 0.55, "top", MINT },
		{ 10, -0.7, 0.05, "top", RUST },
		{ 3, -0.4, 0.4, "bottom", DENIM },
		{ 5, 0.2, 0.9, "bottom", RUST },
		{ 7, -0.9, -0.2, "bottom", DENIM },
		{ 9, -0.1, 0.7, "bottom", MINT },
	}
	for _, patch in ipairs(patches) do
		local cell = w.list[patch[1]]
		local inset = 0.07
		local _, patchFront, patchBack = w.plate(cell, patch[2], patch[3], patch[4], patch[5], TEXTILE, inset, 1, "Patch")
		-- A hem stitched just inside its front and back edges (measured from where the patch really
		-- ends, staggered cells included), from the cell's skin to a gap proud of the patch, so it
		-- shares no face with either.
		local sign = patch[4] == "bottom" and -1 or 1
		local z0 = patchFront + 2 * g + 0.0175
		local z1 = patchBack - 2 * g - 0.0175
		for _, z in ipairs({ z0, z1 }) do
			k.block("Stitch", V(cell.width - 2 * inset - 0.1, 2 * g, 0.035), w.at(cell, 0, sign * (w.thick / 2 + g), z),
				patch[5]:Lerp(BLACK, 0.4), CLOTH)
		end
	end

	-- The sheet's corners, knotted at the back of each tip with a tail hanging down from the knot
	-- (past a tip, further along the arc is down).
	for _, s in ipairs({ 0, w.cells }) do
		local _, back = w.seamChord(s)
		local knot = w.onSeam(s, 0, back - 0.06)
		k.ball("Knot", 0.26, knot, CREAM, CLOTH)
		k.rod("KnotTail", knot.Position, (knot * CFrame.new(w.outward(s) * 0.34, -0.04, 0.2)).Position, 0.08, CREAM, CLOTH)
	end

	w.lines(LINE_SEAMS, LINE_ROWS)
	return body
end

-- Traffic-cone orange with two white reflective bands on both faces, black rubber stabilisers at
-- the tips, and a little cone riding on top.
DESIGNS.ConeChute = function(k)
	local body = k.harness(DARK, rgb(30, 30, 34))
	local ORANGE = rgb(255, 118, 26)
	local REFLECT = rgb(244, 244, 238)
	local RUBBER = rgb(34, 34, 38)
	local g = k.gap

	local w = k.wing()
	w.skin(ORANGE, PLASTIC)
	for _, cell in ipairs(w.list) do
		for _, band in ipairs({ { -0.52, -0.22 }, { 0.2, 0.5 } }) do
			w.plate(cell, band[1], band[2], "top", REFLECT, PLASTIC, nil, 1, "Band")
			w.plate(cell, band[1], band[2], "bottom", REFLECT, PLASTIC, nil, 1, "Band")
		end
	end
	-- Seams in a deeper orange, and slim black rubber stabilisers for tip caps.
	w.ribs(rgb(214, 92, 18), 0.05, PLASTIC, { tipColor = RUBBER, tipWidth = 0.12, tipHeight = 0.36, tipLift = -0.07 })

	-- The cone: a rubber base, orange, a reflective band, orange again and a rounded tip.
	local centre = w.list[math.ceil(w.cells / 2)]
	local surface = w.thick / 2
	-- Sunk two gaps, so its underside clears the reflective band's.
	k.block("ConeBase", V(0.5, 4 * g, 0.5), w.at(centre, 0, surface, 0.1), RUBBER, PLASTIC)
	local stack = {
		{ 0.36, 0.16, ORANGE },
		{ 0.28, 0.1, REFLECT },
		{ 0.2, 0.16, ORANGE },
	}
	local y = surface + 2 * g
	for _, layer in ipairs(stack) do
		k.disc("Cone", layer[2] + g, layer[1], w.at(centre, 0, y + layer[2] / 2 - g / 2, 0.1), layer[3], PLASTIC)
		y += layer[2]
	end
	k.ball("ConeTip", 0.14, w.at(centre, 0, y, 0.1), ORANGE, PLASTIC)

	w.lines(LINE_SEAMS, LINE_ROWS, rgb(198, 200, 206))
	return body
end

-- Red and white picnic gingham right through the cloth, with a folded napkin corner hanging from
-- each tip.
DESIGNS.GinghamChute = function(k)
	local body = k.harness()
	local RED = rgb(212, 40, 48)
	local PINK = rgb(240, 150, 152)
	local WHITE = rgb(250, 247, 240)

	local w = k.wing()
	w.bands({ -1, -0.5, 0, 0.5, 1 }, function(cell, band)
		local across, along = cell.i % 2 == 0, band % 2 == 0
		if across and along then
			return RED
		elseif across or along then
			return PINK
		end
		return WHITE
	end, CLOTH)
	w.ribs(WHITE, 0.05, CLOTH, { tipsOnly = true })

	-- A napkin corner hanging down past each tip, at the back.
	for _, s in ipairs({ 0, w.cells }) do
		-- Its back edge two gaps in front of the cloth's back edge, so their faces aren't level.
		local _, back = w.seamChord(s)
		back -= 2 * k.gap
		local frame = w.arc(w.seamAngle(s))
		k.triangle("Napkin", (frame * CFrame.new(0, 0, back - 0.55)).Position, (frame * CFrame.new(0, 0, back)).Position,
			(frame * CFrame.new(w.outward(s) * 0.55, 0, back)).Position, 0.06, RED, CLOTH)
	end

	w.lines(LINE_SEAMS, LINE_ROWS)
	return body
end

-- Uncommon ----------------------------------------------------------------------

-- A slice of watermelon: striped green rind underneath and round the leading edge, the pale pith
-- behind it, and pink flesh with seeds across the top.
DESIGNS.MelonChute = function(k)
	local body = k.harness()
	local RIND = rgb(52, 140, 58)
	local RIND_LIGHT = rgb(118, 190, 88)
	local PITH = rgb(222, 244, 196)
	local FLESH = rgb(246, 82, 104)
	local SEED = rgb(34, 24, 20)
	local g = k.gap

	local w = k.wing()
	w.skin(function(cell)
		return cell.i % 2 == 1 and RIND or RIND_LIGHT
	end, CLOTH)
	for _, cell in ipairs(w.list) do
		w.nose(cell, 0.28, RIND, CLOTH)
		w.plate(cell, -0.8, -0.62, "top", PITH, CLOTH, nil, 1, "Pith")
		w.plate(cell, -0.62, 1, "top", FLESH, CLOTH, nil, 1, "Flesh")
		local x = cell.i % 2 == 0 and 0.13 or -0.13
		for _, seed in ipairs({ { x, -0.1 }, { -x, 0.5 } }) do
			local z = cell.front + (seed[2] + 1) / 2 * cell.chord
			k.ball("Seed", 0.1, w.at(cell, seed[1], w.thick / 2 + g, z), SEED, PLASTIC)
		end
	end
	w.ribs(RIND, 0.05, CLOTH, { tipsOnly = true, tipHeight = 0.28 + 2 * g + 0.02 })

	w.lines(LINE_SEAMS, { -0.3, 0.45 })
	return body
end

-- Pizza: cheese across the top with pepperoni and basil, a sauce line behind a crust leading edge,
-- golden crust underneath, and cheese dripping off the back.
DESIGNS.PizzaChute = function(k)
	local body = k.harness()
	local CHEESE = rgb(252, 204, 84)
	local CRUST = rgb(196, 128, 60)
	local CRUST_UNDER = rgb(214, 156, 88)
	local SAUCE = rgb(196, 52, 36)
	local PEPPERONI = rgb(170, 38, 34)
	local BASIL = rgb(56, 140, 60)
	local g = k.gap

	local w = k.wing()
	w.skin(CHEESE, PLASTIC)
	for _, cell in ipairs(w.list) do
		w.nose(cell, 0.34, CRUST, SAND)
		w.plate(cell, -1, 1, "bottom", CRUST_UNDER, SAND, nil, 1, "Crust")
		w.plate(cell, -0.72, -0.56, "top", SAUCE, PLASTIC, nil, 1, "Sauce")
		local even = cell.i % 2 == 0
		local z = cell.front + ((even and -0.15 or 0.4) + 1) / 2 * cell.chord
		k.disc("Pepperoni", 3 * g, 0.34, w.at(cell, even and 0.06 or -0.06, w.thick / 2 + g / 2, z), PEPPERONI, PLASTIC)
	end

	-- Basil leaves on the middle cells, lying flat on the cheese.
	for _, i in ipairs({ 4, 6, 8 }) do
		local cell = w.list[i]
		local y = w.thick / 2 + g / 2
		local z = cell.front + 0.75 * cell.chord
		k.triangle("Basil", w.at(cell, -0.12, y, z).Position, w.at(cell, 0.12, y, z).Position, w.at(cell, 0.02, y, z + 0.24).Position,
			3 * g, BASIL, PLASTIC)
	end
	-- Cheese dripping off the back edge.
	for _, i in ipairs({ 3, 5, 7, 9 }) do
		local cell = w.list[i]
		k.ball("Drip", 0.2, w.at(cell, 0, -0.03, cell.back + 0.02), CHEESE, PLASTIC)
	end
	w.ribs(CRUST, 0.05, SAND, { tipsOnly = true, tipHeight = 0.34 + 2 * g + 0.02 })

	w.lines(LINE_SEAMS, { -0.3, 0.45 })
	return body
end

-- A rainbow along the arc, red at the leading edge to blue at the back, with a cloud at each end.
DESIGNS.RainbowChute = function(k)
	local body = k.harness()
	local COLORS = {
		rgb(236, 48, 48),
		rgb(250, 136, 34),
		rgb(252, 214, 48),
		rgb(92, 198, 70),
		rgb(50, 164, 228),
		rgb(70, 88, 210),
	}
	local CLOUD = rgb(252, 252, 255)

	local w = k.wing()
	w.bands({ -1, -2 / 3, -1 / 3, 0, 1 / 3, 2 / 3, 1 }, function(_, band)
		return COLORS[band]
	end, CLOTH)
	w.ribs(CLOUD, 0.05, PLASTIC, { tipsOnly = true })

	-- The clouds hang down past the tips (further along the arc), a core puff filling the middle of
	-- each so no light gets between them, and none reach out further than the wing's own width allows.
	for _, s in ipairs({ 0, w.cells }) do
		local out = w.outward(s)
		for _, puff in ipairs({
			{ 0.2, -0.12, 0.05, 0.62 },
			{ 0.22, -0.16, -0.45, 0.52 },
			{ 0.34, -0.2, 0.08, 0.56 },
			{ 0.2, -0.12, 0.55, 0.5 },
			{ 0.44, -0.3, -0.25, 0.4 },
		}) do
			k.ball("Cloud", puff[4], w.onSeam(s, puff[2], puff[3]) * CFrame.new(out * puff[1], 0, 0), CLOUD, PUFF)
		end
	end

	w.lines(LINE_SEAMS, LINE_ROWS, CLOUD)
	return body
end

-- Rare --------------------------------------------------------------------------

-- The classic round parachute: a dome in red and white rings, a vent cap on the crown, and lines
-- gathered from the hem to the harness.
DESIGNS.RoundChute = function(k)
	local body = k.harness()
	local RED = rgb(220, 44, 44)
	local WHITE = rgb(248, 246, 240)
	local g = k.gap

	local d = k.dome({ gores = 16, rows = 5 })
	for _, panel in ipairs(d.panels) do
		k.block("Gore", panel.size, panel.frame, panel.row % 2 == 0 and RED or WHITE, CLOTH)
	end

	-- The vent cap: over the crown's opening and down past the first row's inner face, a gap above
	-- the dome's top, with a red button on it.
	local capRadius = d.radius * math.sin(d.crown) + 0.14
	local top = d.centreY + d.radius + d.thick / 2 + g
	local bottom = d.centreY + (d.radius - d.thick / 2) * math.cos(math.asin(capRadius / d.radius)) - 0.03
	k.disc("VentCap", top - bottom, 2 * capRadius, CFrame.new(0, (top + bottom) / 2, 0), WHITE, CLOTH)
	k.disc("VentButton", 3 * g, 0.34, CFrame.new(0, top + g / 2, 0), RED, CLOTH)

	-- Rigging from every other gore seam at the hem, cascaded off a riser at each end of the bar.
	local anchors = {}
	for seam = 1, d.gores - 1, 2 do
		table.insert(anchors, d.frame(d.hem - 0.03, seam / d.gores * 2 * math.pi).Position)
	end
	k.rigging(anchors, LINE)
	return body
end

-- A shark: slate above with a dorsal fin, white belly, eyes on the leading edge, a toothy grin
-- underneath it, and tail fins hanging from the tips.
DESIGNS.SharkChute = function(k)
	local body = k.harness()
	local SLATE = rgb(74, 94, 118)
	local BELLY = rgb(238, 240, 242)
	local MOUTH = rgb(40, 44, 54)
	local TOOTH = rgb(252, 252, 248)
	local EYE = rgb(18, 20, 24)
	local g = k.gap

	local w = k.wing()
	w.skin(SLATE, PLASTIC)
	local nose = 0.3
	for _, cell in ipairs(w.list) do
		w.nose(cell, nose, SLATE, PLASTIC)
		w.plate(cell, -0.55, 1, "bottom", BELLY, PLASTIC, nil, 1, "Belly")
	end

	-- The grin: a dark band under the leading edge with a white tooth pointing back on each cell.
	for i = 3, 9 do
		local cell = w.list[i]
		local _, mouthFront, mouthBack = w.plate(cell, -0.92, -0.6, "bottom", MOUTH, PLASTIC, nil, 1, "Mouth")
		-- From the cell's skin to a gap past the band, so it shares no face with the band, and two gaps
		-- inside its front and back edges.
		local y = -(w.thick / 2 + g)
		local z0 = mouthFront + 2 * g
		local z1 = mouthBack - 2 * g
		k.triangle("Tooth", w.at(cell, -0.15, y, z0).Position, w.at(cell, 0.15, y, z0).Position, w.at(cell, 0, y, z1).Position, 2 * g, TOOTH, PLASTIC)
	end

	-- Eyes on the leading edge, each with a glint.
	for _, i in ipairs({ 4, 8 }) do
		local cell = w.list[i]
		local eye = w.at(cell, 0, 0.09, w.noseZ(cell, nose) - 0.11)
		k.ball("Eye", 0.13, eye, EYE, PLASTIC)
		k.ball("Glint", 0.045, eye * CFrame.new(0.03, 0.05, -0.04), TOOTH, PLASTIC)
	end

	-- The dorsal fin, standing up the middle, its back edge upright.
	local centre = w.list[math.ceil(w.cells / 2)]
	local base = w.thick / 2 - g
	k.triangle("Fin", w.at(centre, 0, base, -0.3).Position, w.at(centre, 0, base, 0.62).Position, w.at(centre, 0, w.thick / 2 + 0.9, 0.62).Position,
		0.1, SLATE, PLASTIC)

	w.ribs(SLATE, 0.05, PLASTIC, { tipsOnly = true, tipHeight = nose + 2 * g + 0.02 })
	-- Tail fins hanging down past the tips, upright at the back (two gaps in front of the cloth's back
	-- edge, so their faces aren't level).
	for _, s in ipairs({ 0, w.cells }) do
		local _, back = w.seamChord(s)
		back -= 2 * g
		local frame = w.arc(w.seamAngle(s))
		k.triangle("TailFin", (frame * CFrame.new(0, 0, back - 0.95)).Position, (frame * CFrame.new(0, 0, back)).Position,
			(frame * CFrame.new(w.outward(s) * 0.8, 0, back)).Position, 0.08, SLATE, PLASTIC)
	end

	w.lines(LINE_SEAMS, { -0.35, 0.45 })
	return body
end

-- A bomber's wing: olive drab over sky grey, roundels top and bottom, a riveted steel leading edge,
-- yellow tips and a twin tail.
DESIGNS.BomberChute = function(k)
	local body = k.harness()
	local OLIVE = rgb(104, 114, 62)
	local UNDER = rgb(150, 170, 182)
	local STEEL = rgb(150, 156, 162)
	local NAVY = rgb(34, 54, 120)
	local ROUNDEL_WHITE = rgb(244, 244, 238)
	local ROUNDEL_RED = rgb(204, 40, 40)
	local YELLOW = rgb(246, 196, 40)
	local g = k.gap

	local w = k.wing()
	w.skin(OLIVE, CLOTH)
	local nose = 0.26
	for _, cell in ipairs(w.list) do
		w.nose(cell, nose, STEEL, METAL)
		local tip = cell.i == 1 or cell.i == w.cells
		w.plate(cell, -1, 1, "bottom", tip and YELLOW or UNDER, CLOTH, nil, 1, "Underside")
		if tip then
			w.plate(cell, -0.72, 1, "top", YELLOW, CLOTH, nil, 1, "TipPaint")
		end
		k.ball("Rivet", 0.06, w.at(cell, 0, nose / 2, w.noseZ(cell, nose)), STEEL, METAL)
	end

	-- Roundels: blue, white and a red centre, each ring a gap prouder than the last and sunk as far
	-- again, so no two faces meet. Underneath they start a step further out, past the underside
	-- panel's faces.
	for _, i in ipairs({ 3, 9 }) do
		local cell = w.list[i]
		local z = cell.front + (0.15 + 1) / 2 * cell.chord
		for _, sign in ipairs({ 1, -1 }) do
			local first = sign == 1 and 0 or 1
			for layer, ring in ipairs({ { 0.5, NAVY }, { 0.34, ROUNDEL_WHITE }, { 0.16, ROUNDEL_RED } }) do
				k.disc("Roundel", 2 * (layer + first) * g, ring[1], w.at(cell, 0, sign * w.thick / 2, z), ring[2], CLOTH)
			end
		end
	end

	-- A twin tail either side of the middle, low and swept.
	for _, i in ipairs({ 5, 7 }) do
		local cell = w.list[i]
		local base = w.thick / 2 - g
		k.triangle("TailFin", w.at(cell, 0, base, cell.back - 0.6).Position, w.at(cell, 0, base, cell.back - 2 * g).Position,
			w.at(cell, 0, w.thick / 2 + 0.42, cell.back - 2 * g).Position, 0.08, OLIVE, CLOTH)
	end

	w.ribs(OLIVE, 0.05, CLOTH, { tipsOnly = true, tipHeight = nose + 2 * g + 0.02 })
	w.lines(LINE_SEAMS, { -0.35, 0.45 }, rgb(186, 190, 168))
	return body
end

-- Epic --------------------------------------------------------------------------

-- Cotton candy: a pink and blue wing lost in sugar puffs that spill over both edges and underneath.
DESIGNS.CandyChute = function(k)
	local body = k.harness(rgb(250, 246, 240), rgb(250, 246, 240))
	local PINK = rgb(255, 164, 212)
	local BLUE = rgb(160, 212, 255)
	local CREAM = rgb(255, 238, 248)

	local w = k.wing()
	w.skin(function(cell)
		return cell.i % 2 == 1 and PINK or BLUE
	end, CLOTH)
	for _, cell in ipairs(w.list) do
		local odd = cell.i % 2 == 1
		k.ball("Puff", 0.66, w.at(cell, 0, w.thick / 2 - 0.1, cell.front + 0.26), odd and BLUE or PINK, PUFF)
		k.ball("Puff", 0.6, w.at(cell, odd and 0.06 or -0.06, w.thick / 2 - 0.06, cell.back - 0.3), odd and CREAM or PINK, PUFF)
		-- Underneath, wide enough to overlap the next cell's all the way down its curve, so there's no
		-- chink between them from any angle.
		k.ball("Puff", 0.8, w.at(cell, 0, -w.thick / 2 - 0.02, cell.sweep + 0.05), odd and PINK or BLUE, PUFF)
	end
	w.ribs(PINK, 0.05, CLOTH, { tipsOnly = true })
	for _, s in ipairs({ 0, w.cells }) do
		k.ball("Puff", 0.7, w.onSeam(s, -0.12, 0.05) * CFrame.new(w.outward(s) * 0.2, 0, 0), CREAM, PUFF)
	end

	w.lines(LINE_SEAMS, LINE_ROWS, CREAM)
	return body
end

-- A dragon's wing: a crimson membrane drawn out to a point at every ivory finger bone and scalloped
-- between them, the bones ending in claws, a dark leading edge, spines down the middle and horns
-- curling off the tips.
DESIGNS.DragonChute = function(k)
	local body = k.harness(rgb(60, 20, 24), rgb(60, 20, 24))
	local MEMBRANE = rgb(168, 26, 36)
	local EDGE = rgb(110, 16, 26)
	local BONE = rgb(236, 226, 200)
	local CLAW = rgb(58, 46, 40)
	local g = k.gap

	-- Bones on the tip seams and these; the membrane reaches furthest back at a bone and least
	-- halfway between two.
	local FRONT = -0.85
	local BONE_SEAMS = { 0, 2, 5, 8, 11, 13 }
	local BONES = {}
	for _, s in ipairs(BONE_SEAMS) do
		BONES[s] = true
	end
	local POINT, BESIDE_TIP, SCALLOP = 0.95, 0.55, 0.42
	local w = k.wing({
		cells = 13,
		frontAt = function()
			return FRONT
		end,
		backAt = function(s)
			if BONES[s] then
				return POINT
			elseif s == 1 or s == 12 then
				return BESIDE_TIP
			end
			return SCALLOP
		end,
	})
	w.skin(MEMBRANE, CLOTH)
	w.edges(MEMBRANE, CLOTH)
	local nose = 0.24
	for _, cell in ipairs(w.list) do
		w.nose(cell, nose, EDGE, CLOTH)
	end
	w.ribs(EDGE, 0.05, CLOTH, { tipsOnly = true, tipHeight = nose + 2 * g + 0.02 })

	-- The bones along their seams, from inside the leading edge to past the point, ending in a claw.
	local surface = w.thick / 2
	-- In a fixed order (pairs has none), so two builds make their parts in the same order, which the
	-- probes' part-by-part comparisons rely on.
	for _, s in ipairs(BONE_SEAMS) do
		local finish = POINT + 0.36
		k.rod("Bone", w.onSeam(s, surface, FRONT + 0.06).Position, w.onSeam(s, surface, finish).Position, 0.1, BONE, PLASTIC)
		-- The claw's root runs back inside the bone's end, so it's held by it.
		k.triangle("Claw", w.onSeam(s, surface + 0.02, finish - 0.12).Position, w.onSeam(s, surface + 0.02, finish + 0.2).Position,
			w.onSeam(s, surface - 0.22, finish + 0.2).Position, 0.07, CLAW, PLASTIC)
	end

	-- Spines down the middle cell.
	local centre = w.list[math.ceil(w.cells / 2)]
	for _, z in ipairs({ -0.62, -0.3, 0.02 }) do
		k.triangle("Spine", w.at(centre, 0, surface - g, z).Position, w.at(centre, 0, surface - g, z + 0.26).Position,
			w.at(centre, 0, surface + 0.24, z + 0.26).Position, 0.07, EDGE, CLOTH)
	end

	-- A horn curling up and out of each tip's leading corner.
	for _, s in ipairs({ 0, w.cells }) do
		local out = w.outward(s)
		-- Mostly up rather than out, so the wing stays its width.
		local p0 = w.onSeam(s, 0.02, FRONT + 0.22).Position
		local p1 = p0 + V(out * 0.12, 0.3, -0.1)
		local p2 = p1 + V(out * 0.02, 0.28, 0.02)
		local p3 = p2 + V(-out * 0.1, 0.18, 0.1)
		k.rod("Horn", p0, p1, 0.16, BONE, PLASTIC)
		k.rod("Horn", p1, p2, 0.11, BONE, PLASTIC)
		k.rod("Horn", p2, p3, 0.06, BONE, PLASTIC)
	end

	w.lines({ 2, 4, 6, 7, 9, 11 }, { -0.4, 0.3 }, rgb(206, 184, 156))
	return body
end

-- Legendary ---------------------------------------------------------------------

-- Golden Sahur: gold over royal velvet, engraved foil trim, a ruby on every rib and a pair of crossed
-- bats on top.
DESIGNS.SahurChute = function(k)
	local body = k.harness(rgb(186, 122, 28), rgb(140, 28, 56))
	local GOLD = rgb(255, 200, 70)
	local GOLD_DEEP = rgb(236, 170, 44)
	local TRIM = rgb(196, 132, 32)
	local VELVET = rgb(140, 28, 56)
	local RUBY = rgb(214, 22, 56)
	local BAT = rgb(160, 106, 58)
	local g = k.gap

	local w = k.wing()
	w.skin(function(cell)
		return cell.i % 2 == 1 and GOLD or GOLD_DEEP
	end, CLOTH)
	local nose = 0.26
	for _, cell in ipairs(w.list) do
		w.nose(cell, nose, GOLD, FOIL)
		w.plate(cell, -1, 1, "bottom", VELVET, CLOTH, nil, 1, "Velvet")
		w.plate(cell, 0.62, 0.82, "top", TRIM, FOIL, nil, 1, "Trim")
	end
	local tipHeight = nose + 4 * g
	w.ribs(TRIM, 0.06, FOIL, { tipHeight = tipHeight })

	-- A ruby at the front of every rib, set into its top.
	for s = 0, w.cells do
		local front = w.seamChord(s)
		local tip = s == 0 or s == w.cells
		local y = tip and tipHeight / 2 or w.thick / 2 + g
		k.ball("Ruby", 0.12, w.onSeam(s, y, front + 0.34), RUBY, PLASTIC)
	end
	-- Gold finials on the tips.
	for _, s in ipairs({ 0, w.cells }) do
		k.ball("Finial", 0.24, w.onSeam(s, 0, 0.05) * CFrame.new(w.outward(s) * 0.08, 0, 0), GOLD, FOIL)
	end

	-- A gold coin underneath, in the middle of the velvet.
	local centre = w.list[math.ceil(w.cells / 2)]
	k.disc("Coin", 3 * g, 0.46, w.at(centre, 0, -w.thick / 2 - 1.5 * g, 0.1), GOLD, FOIL)

	-- Two bats crossed on top, one lying a little over the other.
	local crossing = V(0, w.top + 0.04, 0.05)
	for index, angle in ipairs({ math.rad(38), math.rad(-38) }) do
		local along = V(math.sin(angle), 0, math.cos(angle))
		local lift = V(0, (index - 1) * 0.04, 0)
		local function point(distance)
			return crossing + lift + along * distance
		end
		k.rod("Bat", point(-0.7), point(-0.14), 0.1, BAT, WOOD)
		k.rod("Bat", point(-0.14), point(0.66), 0.19, BAT, WOOD)
		k.ball("BatKnob", 0.15, point(-0.71), BAT, WOOD)
		k.rod("BatBand", point(-0.14 - 2 * g), point(-0.14 + 2 * g), 0.21, GOLD, FOIL)
	end

	w.lines(LINE_SEAMS, LINE_ROWS, rgb(230, 190, 90))
	return body
end

-- A phoenix: flame from deep red in the middle to gold at the tips, the back edge drawn out into
-- golden feather tips with a longer tail in the middle, a fan of tail feathers under it, plumes off
-- each tip, and flame tongues licking back across the top.
DESIGNS.PhoenixChute = function(k)
	local body = k.harness(rgb(120, 30, 14), rgb(120, 30, 14))
	local EMBER = rgb(190, 30, 20)
	local FLAME = rgb(250, 110, 24)
	local GOLD = rgb(255, 200, 60)
	local g = k.gap
	local function flame(t)
		local a = math.abs(t)
		if a &lt; 0.55 then
			return EMBER:Lerp(FLAME, a / 0.55)
		end
		return FLAME:Lerp(GOLD, math.min(1, (a - 0.55) / 0.45))
	end

	-- Feather points every second seam out from the middle, where the two seams either side of the
	-- centre cell are both points, so the middle runs long like a tail.
	local POINTS = { [0] = true, [2] = true, [4] = true, [6] = true, [7] = true, [9] = true, [11] = true, [13] = true }
	local w = k.wing({
		cells = 13,
		frontAt = function()
			return -0.75
		end,
		backAt = function(s)
			return POINTS[s] and 1.08 or 0.7
		end,
	})
	w.skin(function(cell)
		return flame(cell.t)
	end, CLOTH)
	-- The feather tips shade to gold.
	w.edges(function(cell, edge)
		return edge == "back" and flame(cell.t):Lerp(GOLD, 0.55) or flame(cell.t)
	end, CLOTH)
	local nose = 0.24
	for _, cell in ipairs(w.list) do
		w.nose(cell, nose, GOLD, CLOTH)
	end

	-- A fan of three tail feathers hanging back from under the middle cell. Each is two gaps thick
	-- and a gap below the last, so they overlap one another (and the first the cloth) without any
	-- two faces level.
	local centreIndex = math.ceil(w.cells / 2)
	local centre = w.list[centreIndex]
	for index, feather in ipairs({ { -0.2, 0.75, FLAME }, { 0, 1.0, GOLD }, { 0.2, 0.75, EMBER } }) do
		local y = -w.thick / 2 - index * g
		-- Roots two gaps apart, so no two feathers' root edges lie level.
		local root = centre.back - 0.3 - (index - 1) * 2 * g
		k.triangle("TailFeather", w.at(centre, feather[1] - 0.2, y, root).Position, w.at(centre, feather[1] + 0.2, y, root).Position,
			w.at(centre, feather[1] * 1.8, y, centre.back + feather[2]).Position, 2 * g, feather[3], CLOTH)
	end

	-- Flame tongues across the middle of the top.
	for offset = -1, 1 do
		local cell = w.list[centreIndex + offset]
		local y = w.thick / 2 + g / 2
		local z0 = cell.front + 0.45
		k.triangle("Flame", w.at(cell, -0.2, y, z0).Position, w.at(cell, 0.2, y, z0).Position,
			w.at(cell, offset * 0.08, y, z0 + (offset == 0 and 0.9 or 0.68)).Position, 3 * g, offset == 0 and GOLD or FLAME, CLOTH)
	end

	w.ribs(GOLD, 0.05, CLOTH, { tipsOnly = true, tipHeight = nose + 4 * g })

	-- Three plumes fanning back and out from each tip, each in its own layer.
	for _, s in ipairs({ 0, w.cells }) do
		local out = w.outward(s)
		local frame = w.arc(w.seamAngle(s))
		for index, plume in ipairs({ { 25, 1.15, GOLD }, { 50, 1.35, FLAME }, { 75, 1.0, EMBER } }) do
			local angle = math.rad(plume[1])
			local along = V(out * math.sin(angle), 0, math.cos(angle))
			local across = V(math.cos(angle), 0, -out * math.sin(angle))
			-- Roots wide and close together, so the fan overlaps all the way out and leaves no chink
			-- between feathers.
			local root = V(0, (index - 2) * 2 * g, -0.2 + 0.24 * index)
			k.triangle("Plume", (frame * CFrame.new(root + across * 0.26)).Position, (frame * CFrame.new(root - across * 0.26)).Position,
				(frame * CFrame.new(root + along * plume[2])).Position, 2 * g, plume[3], CLOTH)
		end
	end

	w.lines({ 2, 4, 6, 7, 9, 11 }, { -0.35, 0.3 }, rgb(238, 200, 156))
	return body
end

-- Mythic ------------------------------------------------------------------------

-- A thundercloud: a dark wing in rolling grey cloud, with a lightning bolt zig-zagging along it on top
-- and underneath.
DESIGNS.StormChute = function(k)
	local body = k.harness(rgb(50, 52, 60), rgb(50, 52, 60))
	local SLATE = rgb(58, 62, 76)
	local UNDER = rgb(40, 43, 52)
	local CLOUD_DARK = rgb(118, 124, 140)
	local CLOUD_LIGHT = rgb(156, 162, 178)
	local BOLT = rgb(255, 214, 40)
	local g = k.gap

	local w = k.wing()
	w.skin(SLATE, CLOTH)
	for _, cell in ipairs(w.list) do
		local odd = cell.i % 2 == 1
		w.plate(cell, -1, 1, "bottom", UNDER, CLOTH, nil, 1, "Underside")
		k.ball("Cloud", odd and 0.86 or 0.76, w.at(cell, 0, w.thick / 2 - 0.2, cell.front + 0.18), odd and CLOUD_LIGHT or CLOUD_DARK, PUFF)
		k.ball("Cloud", odd and 0.74 or 0.84, w.at(cell, 0, w.thick / 2 - 0.2, cell.back - 0.2), odd and CLOUD_DARK or CLOUD_LIGHT, PUFF)
	end

	-- The bolt: one straight stroke per cell, each running seam to seam between two depths in turn,
	-- so they join into a zig-zag along the clear strip between the clouds. On top it sits on the
	-- cloth; underneath it runs from the cloth to a gap past the underside panel.
	for _, side in ipairs({ 1, -1 }) do
		local y = side == 1 and (w.thick / 2 + g / 2) or -(w.thick / 2 + g)
		local thickness = side == 1 and 3 * g or 2 * g
		for i = 2, w.cells - 1 do
			local cell = w.list[i]
			local near, far = cell.front + 0.66, cell.front + 0.96
			local fromZ, toZ = near, far
			if i % 2 == 1 then
				fromZ, toZ = far, near
			end
			local a = w.at(cell, -cell.width / 2, y, fromZ).Position
			local b = w.at(cell, cell.width / 2, y, toZ).Position
			local frame = CFrame.lookAt((a + b) / 2, b, w.at(cell, 0, 0, 0).UpVector)
			k.block("Bolt", V(0.13, thickness, (b - a).Magnitude + 0.06), frame, BOLT, PLASTIC)
		end
	end

	w.ribs(SLATE, 0.05, CLOTH, { tipsOnly = true })
	for _, s in ipairs({ 0, w.cells }) do
		k.ball("Cloud", 0.84, w.onSeam(s, -0.2, 0) * CFrame.new(w.outward(s) * 0.3, 0, 0), CLOUD_DARK, PUFF)
	end

	w.lines(LINE_SEAMS, { -0.3, 0.45 }, rgb(178, 184, 196))
	return body
end

-- Secret ------------------------------------------------------------------------

-- A galaxy manta: a swept ray's wing in deep space blue, stars above and below, sparkles and a ringed
-- planet on top, curled head fins and a long tail.
DESIGNS.MantaChute = function(k)
	local body = k.harness(rgb(20, 26, 62), rgb(20, 26, 62))
	local NAVY = rgb(24, 32, 78)
	local STAR = rgb(255, 250, 236)
	local PLANET = rgb(232, 146, 82)
	local RING = rgb(238, 216, 172)
	local EYE = rgb(214, 224, 240)
	local g = k.gap

	-- The outline, seam by seam: the leading edge swept back towards the tips, the chord deepest in
	-- the middle, so the tips trail behind like a ray's.
	local function chord(t)
		return 0.4 + 1.9 * (1 - math.min(1, math.abs(t)) ^ 1.6)
	end
	local function front(t)
		return -1.15 + 1.25 * math.min(1, math.abs(t)) ^ 1.5
	end
	local w = k.wing({
		cells = 15,
		thick = 0.14,
		frontAt = function(_, t)
			return front(t)
		end,
		backAt = function(_, t)
			return front(t) + chord(t)
		end,
	})
	w.skin(NAVY, PLASTIC)
	w.edges(NAVY, PLASTIC)

	-- Star specks above and below, half sunk into the skin.
	local specks = {
		{ 2, 0.1, 0, 1 }, { 3, -0.12, 0.3, 1 }, { 4, 0.08, 0.7, 1 }, { 6, -0.1, -0.4, 1 }, { 7, 0.12, 0.35, 1 }, { 8, 0, -0.6, 1 },
		{ 9, -0.06, 0.55, 1 }, { 10, 0.1, -0.2, 1 }, { 12, -0.08, 0.2, 1 }, { 13, 0.06, -0.3, 1 },
		{ 3, 0.1, -0.2, -1 }, { 5, -0.1, 0.4, -1 }, { 6, 0.08, -0.5, -1 }, { 8, -0.12, 0.2, -1 }, { 9, 0.1, -0.35, -1 },
		{ 11, -0.06, 0.45, -1 }, { 12, 0.08, -0.1, -1 }, { 7, 0, 0.7, -1 },
	}
	for index, speck in ipairs(specks) do
		local cell = w.list[speck[1]]
		local z = cell.front + (speck[3] + 1) / 2 * cell.chord
		k.ball("Star", index % 3 == 0 and 0.09 or 0.06, w.at(cell, speck[2], speck[4] * w.thick / 2, z), STAR, PLASTIC)
	end
	-- Four-point sparkles: crossed bars, the second a gap prouder than the first.
	for _, spec in ipairs({ { 4, 0.1 }, { 11, 0.25 } }) do
		local cell = w.list[spec[1]]
		local z = cell.front + (spec[2] + 1) / 2 * cell.chord
		k.block("Sparkle", V(0.3, 3 * g, 0.05), w.at(cell, 0, w.thick / 2 + g / 2, z), STAR, PLASTIC)
		k.block("Sparkle", V(0.05, 4 * g, 0.3), w.at(cell, 0, w.thick / 2 + 2 * g, z), STAR, PLASTIC)
	end

	-- A ringed planet.
	local planetCell = w.list[10]
	local planet = w.at(planetCell, 0, w.thick / 2 + 0.06, planetCell.front + 0.55 * planetCell.chord)
	k.ball("Planet", 0.34, planet, PLANET, PLASTIC)
	k.disc("PlanetRing", 0.03, 0.64, planet * CFrame.Angles(0.3, 0, 0.25), RING, PLASTIC)

	-- Head fins curling down off the leading edge either side of the middle, with pale eyes.
	local centreIndex = math.ceil(w.cells / 2)
	for _, offset in ipairs({ -1, 1 }) do
		local cell = w.list[centreIndex + offset]
		local p0 = w.at(cell, 0, 0, cell.front + 0.08).Position
		local p1 = p0 + V(offset * 0.06, -0.06, -0.32)
		local p2 = p1 + V(-offset * 0.03, -0.16, -0.14)
		local p3 = p2 + V(-offset * 0.05, -0.12, 0.06)
		k.rod("HeadFin", p0, p1, 0.13, NAVY, PLASTIC)
		k.ball("HeadFinJoint", 0.13, p1, NAVY, PLASTIC)
		k.rod("HeadFin", p1, p2, 0.1, NAVY, PLASTIC)
		k.ball("HeadFinJoint", 0.1, p2, NAVY, PLASTIC)
		k.rod("HeadFin", p2, p3, 0.07, NAVY, PLASTIC)
		k.ball("Eye", 0.08, p0 + V(offset * 0.12, 0.05, 0.05), EYE, PLASTIC)
	end

	-- The tail, from under the back of the middle cell.
	local centre = w.list[centreIndex]
	local t0 = w.at(centre, 0, 0, centre.back - 0.1).Position
	local t1 = t0 + V(0, -0.12, 0.7)
	local t2 = t1 + V(0, -0.04, 0.55)
	local t3 = t2 + V(0, 0.06, 0.4)
	k.rod("Tail", t0, t1, 0.09, NAVY, PLASTIC)
	k.ball("TailJoint", 0.09, t1, NAVY, PLASTIC)
	k.rod("Tail", t1, t2, 0.06, NAVY, PLASTIC)
	k.ball("TailJoint", 0.06, t2, NAVY, PLASTIC)
	k.rod("Tail", t2, t3, 0.035, NAVY, PLASTIC)

	w.ribs(NAVY, 0.05, PLASTIC, { tipsOnly = true })
	w.lines({ 3, 5, 7, 8, 10, 12 }, { -0.3, 0.3 }, rgb(170, 186, 214))
	return body
end

--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------

-- Every design, cheapest rarity first.
ParachuteModels.Order = {
	"PatchworkChute", "ConeChute", "GinghamChute",
	"MelonChute", "PizzaChute", "RainbowChute",
	"RoundChute", "SharkChute", "BomberChute",
	"CandyChute", "DragonChute",
	"SahurChute", "PhoenixChute",
	"StormChute",
	"MantaChute",
}

function ParachuteModels.Has(id)
	return id ~= nil and DESIGNS[id] ~= nil
end

-- options: scale (default 1), anchored (default true), name (default "Parachute").
--
-- Below the worn scale a canopy is built at the worn scale and then shrunk whole (Model:ScaleTo), so
-- it is exactly the canopy players wear, only smaller: the gaps that keep faces apart are set in
-- world studs for the worn size, and building small directly would make stacked details (roundels,
-- a cone's base) thicker than the cloth they sit in. Shrunk, those gaps are far finer than anything
-- a close-up camera can make flicker.
--
-- A design is built once per set of options and cloned after that. MovementService builds a canopy
-- on every drop-in and Rot Glider, and a clone skips the maths and the z-fight pass (about a tenth
-- of the time). Probes that need a fresh build switch CacheBuilds off; so does switching ZFight off.
ParachuteModels.CacheBuilds = true
local templates = {}

-- The default Rot Glider canopy, guarded: a canopy is what caps a player's fall on the drop-in, so
-- nothing here may throw. A build that fails returns nil and says why.
local function defaultCanopy(options)
	local ok, model, body = pcall(ItemModels.Build, "RotGlider", {
		scale = options.scale,
		anchored = options.anchored,
		name = options.name or "Parachute",
		open = true,
	})
	if ok and model then
		return model, body
	end
	warn("[ParachuteModels] the default Rot Glider canopy failed to build: " .. tostring(model))
	return nil
end

function ParachuteModels.Build(id, options)
	options = options or {}
	local design = id and DESIGNS[id]
	if not design then
		return defaultCanopy(options)
	end

	local scale = options.scale or 1
	local anchored = options.anchored ~= false
	local buildScale = math.max(scale, ParachuteModels.WornScale)

	local caching = ParachuteModels.CacheBuilds and ZFight.Enabled
	local key = string.format("%s|%s|%s|%s", id, tostring(scale), tostring(anchored), options.name or "Parachute")
	if caching and templates[key] then
		local copy = templates[key]:Clone()
		return copy, copy.PrimaryPart
	end

	local model = Instance.new("Model")
	model.Name = options.name or "Parachute"
	model:SetAttribute("ParachuteId", id)

	-- A design that fails takes the default canopy instead, rather than leaving a player to fall with
	-- nothing over their head: MovementService only caps the fall once a canopy is up.
	local kit = newKit(model, buildScale, anchored)
	local built, body = pcall(design, kit)
	if not built or not body then
		warn(string.format("[ParachuteModels] %s failed to build (%s); using the default canopy", tostring(id), tostring(body)))
		model:Destroy()
		return defaultCanopy(options)
	end

	-- No two faces left flush, before the welds so only the one part moves. What it had to touch, and
	-- the wings and domes the design laid out (in design units, at `buildScale`), are kept for
	-- tools/parachute_probe.lua.
	ParachuteModels.LastFix = ZFight.Fix({ model }, { all = true })
	ParachuteModels.LastLayout = { wings = kit.layout.wings, domes = kit.layout.domes, scale = buildScale }

	model.PrimaryPart = body
	body.PivotOffset = body.CFrame:Inverse()
	if buildScale ~= scale then
		model:ScaleTo(scale / buildScale)
	end

	if not anchored then
		for _, part in ipairs(model:GetChildren()) do
			if part:IsA("BasePart") and part ~= body then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = body
				weld.Part1 = part
				weld.Parent = part
			end
		end
	end

	if caching then
		templates[key] = model:Clone()
	end
	return model, body
end

-- Points a camera at a canopy built by Build: from in front, a little above and to one side,
-- close enough that the canopy fills the view.
function ParachuteModels.FrameCamera(camera, model)
	local box, size = model:GetBoundingBox()
	local radius = size.Magnitude / 2
	local direction = box:VectorToWorldSpace(V(0.5, 0.45, -1).Unit)
	local distance = radius / math.tan(math.rad(camera.FieldOfView / 2)) * 0.95
	camera.CFrame = CFrame.lookAt(box.Position + direction * distance, box.Position)
end

return ParachuteModels
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">Parkour</string><ProtectedString name="Source">-- Ledge climbing (mantle) and vaulting: finding something to climb or vault, and the path the body
-- follows over it. Shared, so the local player's client (StarterPlayerScripts/MovementClient) and the
-- server's bots (MovementService.TryParkour) obey exactly the same rules. Tuning lives in
-- Shared/MovementConfig (Parkour block).
--
-- Finding a move, in order:
--   1. A slab the width of the body, from MinRise to HandReach above the feet, is swept forward. The
--      first solid thing it meets is the obstacle, and its face turns the move square onto it.
--   2. A ray straight down just inside that face finds the top. A ray that starts inside a taller part
--      passes through it, so a wall too high to grab finds no top at all.
--   3. Short rays walk across the top to measure how deep it is: thin means a vault, deep means a
--      climb.
--   4. The body has to fit everywhere it's about to go: over its head on the way up, over the lip,
--      where it lands, and through the gap of a vault. Checks use RespectCanCollide, so an intact
--      window pane (CanCollide) blocks a vault through its window and a broken one (removed) doesn't.
--
-- Never climbed: anything carrying NoMantle = true on itself or an ancestor (the Cloud Climb, the
-- obby towers), other characters, and loose unanchored parts.
--
-- A move is a plan: { kind, rise, depth, topY, forward, points = { Vector3 ... }, times = { ... },
-- duration, exitVelocity, cost }. `Parkour.PositionAt(plan, t)` gives where the root should be `t`
-- seconds in; the runner sets the root there each Heartbeat with its velocity zeroed, then hands over
-- `exitVelocity` at the end.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MovementConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MovementConfig"))

local Parkour = {}

local CFG = MovementConfig.Parkour
local STAMINA = MovementConfig.Stamina

local UP = Vector3.new(0, 1, 0)

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

-- True when `instance` or any ancestor carries NoMantle.
function Parkour.IsExcluded(instance)
	local node = instance
	while node and node ~= workspace and node ~= game do
		if node:GetAttribute("NoMantle") == true then
			return true
		end
		node = node.Parent
	end
	return false
end

-- Part of something with a Humanoid: a player, a bot, a practice dummy, a companion.
local function isCharacterPart(part)
	local model = part:FindFirstAncestorOfClass("Model")
	for _ = 1, 3 do
		if not model then
			return false
		end
		if model:FindFirstChildOfClass("Humanoid") then
			return true
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return false
end

-- Loose physics debris can't be stood on reliably: it moves under you.
local function isLoose(part)
	return part:IsA("BasePart") and not part.Anchored and not part:IsGrounded()
end

local function unclimbable(part)
	return part == nil or Parkour.IsExcluded(part) or isCharacterPart(part) or isLoose(part)
end

-- How a body sits: `stand` is root centre above the feet, `height` feet to the top of the head.
function Parkour.Metrics(character)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return nil
	end
	local stand = humanoid.HipHeight + root.Size.Y / 2
	local head = character:FindFirstChild("Head")
	local headTop = head and (head.Position.Y + head.Size.Y / 2 - root.Position.Y) or 2.5
	-- A fallen or ragdolled head reads nonsense; clamp to a plausible body.
	headTop = math.clamp(headTop, 1.5, 4)
	return {
		root = root,
		humanoid = humanoid,
		stand = stand,
		feetY = root.Position.Y - stand,
		height = stand + headTop,
		halfWidth = math.max(root.Size.X / 2, 0.8),
		halfDepth = math.max(root.Size.Z / 2, 0.5),
	}
end

local function queryParams(character)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { character }
	rayParams.IgnoreWater = true
	rayParams.RespectCanCollide = true
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = { character }
	overlapParams.RespectCanCollide = true
	-- MaxParts is set per query in boxClear: one part answers "is anything in the way", but the
	-- breakable check has to see every part in the box.
	return rayParams, overlapParams
end

-- Is an axis-aligned-to-`forward` box empty? `from` and `to` are the two ends along forward (at any
-- height); the box spans `bottom`..`top` vertically and `width` across.
-- A window pane is not an obstacle to a body moving fast enough to vault: it breaks. This is the shared
-- half of that — Shared/Parkour runs on both sides and can't see the server's DestructibleService, so it
-- matches the name that service gives its panes (DestructibleService.GlassName). The BREAKING is done by
-- MovementService when the vault runs; here it only stops a pane from refusing one.
Parkour.BreakableName = "WindowGlass"

function Parkour.IsBreakable(part)
	return part ~= nil and part.Name == Parkour.BreakableName
end

-- `breakable`: treat panes as if they weren't there, and return the ones found so the caller can break
-- them. Every other clearance check leaves glass solid, so nothing but a vault plans through a window.
local function boxClear(overlapParams, from, to, bottom, top, width, forward, breakable)
	local length = (flat(to) - flat(from)).Magnitude
	local mid = (flat(from) + flat(to)) / 2
	local center = Vector3.new(mid.X, (bottom + top) / 2, mid.Z)
	local cframe = CFrame.lookAt(center, center + forward)
	-- A plain clearance check only needs to know whether anything is there at all, so one part
	-- answers it and the query stops early. The breakable check must see them ALL: capped at one,
	-- a box straddling a window pane and the solid pier beside it reported CLEAR whenever Roblox
	-- happened to hand back the pane, and the client then CFramed the body straight through the
	-- pier (#115) -- a wall clip a modified client could aim by lining up 1.6-3.5 studs off the
	-- window's centre. Unlimited here: the box is one body wide and a few studs deep.
	overlapParams.MaxParts = breakable and 0 or 1
	local parts = workspace:GetPartBoundsInBox(cframe, Vector3.new(width, top - bottom, math.max(length, 0.2)), overlapParams)
	if not breakable then
		return #parts == 0, parts[1]
	end
	local panes, blocker = nil, nil
	for _, part in ipairs(parts) do
		if Parkour.IsBreakable(part) then
			panes = panes or {}
			table.insert(panes, part)
		else
			blocker = blocker or part
		end
	end
	return blocker == nil, blocker, panes
end

-- Where a flat forward walk across the top stops being the top. Returns the depth reached and whether
-- it's still going at `limit`.
local function measureDepth(rayParams, edge, forward, topY, limit, startAt)
	local step = 0.3
	local depth = 0
	-- Terrain's rounded lip sits below the flat top, so the walk starts where the flat was found.
	local d = math.max(0.15, startAt or 0)
	while d &lt;= limit + 0.001 do
		local point = edge + forward * d
		local hit = workspace:Raycast(Vector3.new(point.X, topY + 0.5, point.Z), Vector3.new(0, -1.1, 0), rayParams)
		if not hit or math.abs(hit.Position.Y - topY) &gt; 0.6 or hit.Normal.Y &lt; CFG.TopNormal then
			return depth, false
		end
		depth = d
		d += step
	end
	return depth, true
end

local function easeOut(t)
	return 1 - (1 - t) * (1 - t)
end

local function smooth(t)
	return t * t * (3 - 2 * t)
end

-- Where the root should be `elapsed` seconds into a plan, and whether the plan has finished.
function Parkour.PositionAt(plan, elapsed)
	local points, times = plan.points, plan.times
	local clock = 0
	for index = 2, #points do
		local span = times[index - 1]
		if elapsed &lt; clock + span then
			local t = math.clamp((elapsed - clock) / math.max(span, 1e-3), 0, 1)
			-- The first leg bursts off the mark and eases in; later legs ease both ends.
			local shaped = index == 2 and easeOut(t) or smooth(t)
			return points[index - 1]:Lerp(points[index], shaped), false
		end
		clock += span
	end
	return points[#points], true
end

--[[
	options:
	  groundY     feet height of the last surface stood on (nil: the current feet)
	  speed       horizontal speed toward `direction`, studs/s
	  grounded    on the ground right now
	  allowVault  default true
	  allowMantle default true
	  exhausted   out of stamina: climbs still happen, slower; vaults don't
  windowDrop  a vault through a window (anything overhead lower than a body's height above the
              top) may land up to WindowMaxDrop below, not VaultMaxDrop: out of an upstairs window
              to the street. The plan then ends just outside the window and the fall is plain
              physics. Players only; bots leave it off (BotNav doesn't plan for the drop).
	Returns a plan, or nil and a short reason.
]]
function Parkour.Find(character, direction, options)
	options = options or {}
	local body = Parkour.Metrics(character)
	if not body then
		return nil, "no body"
	end
	local humanoid, root = body.humanoid, body.root
	if humanoid.Health &lt;= 0 or humanoid.Sit then
		return nil, "can't move"
	end
	local state = humanoid:GetState()
	if state == Enum.HumanoidStateType.Swimming or state == Enum.HumanoidStateType.Seated
		or state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown
		or state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.PlatformStanding
		or state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.Climbing then
		return nil, "state " .. state.Name
	end

	local look = flat(direction or root.CFrame.LookVector)
	if look.Magnitude &lt; 0.05 then
		return nil, "no direction"
	end
	local forward = look.Unit
	local rayParams, overlapParams = queryParams(character)
	local origin = root.Position
	local feetY = body.feetY
	local groundY = options.groundY or feetY
	local speed = options.speed or 0
	-- Where the obstacle is measured from. On the ground, the feet. In the air within JumpGrace of the
	-- ground last stood on, that ground: VaultMaxRise describes an obstacle, and measured from rising feet
	-- it described the obstacle minus the jump (a sill 4.0 above the ground read 1.5 at feet+2.5 and
	-- nothing at all at feet+3.5). Climbs keep the feet: a jump reaches higher, by design.
	local baseY = feetY
	if options.grounded == false and feetY - groundY &gt; 0.05 and feetY - groundY &lt;= CFG.JumpGrace then
		baseY = groundY
	end

	-- 1. The face.
	local lowY = baseY + CFG.MinRise - 0.25
	local highY = feetY + CFG.HandReach
	local centerY = (lowY + highY) / 2
	local slabOrigin = Vector3.new(origin.X, centerY, origin.Z)
	local slab = workspace:Blockcast(CFrame.lookAt(slabOrigin, slabOrigin + forward),
		Vector3.new(body.halfWidth * 1.6, highY - lowY, 0.2), forward * (body.halfDepth + CFG.Reach), rayParams)
	if not slab then
		return nil, "nothing ahead"
	end
	if unclimbable(slab.Instance) then
		return nil, "unclimbable face"
	end
	if math.abs(slab.Normal.Y) &gt; CFG.WallNormal then
		return nil, "a slope, not a wall"
	end
	local wallForward = flat(-slab.Normal)
	if wallForward.Magnitude &lt; 0.2 or wallForward.Unit:Dot(forward) &lt; math.cos(math.rad(55)) then
		return nil, "too oblique"
	end
	forward = wallForward.Unit
	local faceDistance = (flat(slab.Position) - flat(origin)):Dot(forward)

	-- 2. The top. Just inside the face first; smooth terrain rounds its edges over a stud or so, so if
	-- the lip there is sloped, look a little further in for the flat.
	local inside = flat(origin) + forward * (faceDistance + 0.12)
	local top = nil
	local topInset = 0.12
	for _, inset in ipairs({ 0.12, 0.7, 1.3 }) do
		local point = flat(origin) + forward * (faceDistance + inset)
		local hit = workspace:Raycast(Vector3.new(point.X, highY + 0.6, point.Z), Vector3.new(0, -(highY + 0.6 - lowY), 0), rayParams)
		if not hit then
			if inset == 0.12 then
				return nil, "too high"
			end
			break
		end
		if hit.Normal.Y &gt;= CFG.TopNormal then
			top, topInset = hit, inset
			break
		end
	end
	if not top then
		return nil, "no flat top"
	end
	if unclimbable(top.Instance) then
		return nil, "unclimbable top"
	end
	local topY = top.Position.Y
	-- `rise` is from the feet (climbs); `vaultRise` from the base (vaults; see baseY above).
	local rise = topY - feetY
	local vaultRise = topY - baseY
	if vaultRise &lt; CFG.MinRise then
		return nil, "a step"
	end
	if rise &gt; CFG.HandReach then
		return nil, "out of reach"
	end
	if topY - groundY &gt; CFG.MaxRiseFromGround then
		return nil, "too high from the ground"
	end

	local edge = Vector3.new(inside.X, topY, inside.Z) - forward * 0.12
	local width = body.halfWidth * 1.8

	-- 3. Depth.
	local depth, deep = measureDepth(rayParams, edge, forward, topY, CFG.VaultMaxDepth, topInset)

	-- 4a. A vault: thin, low, taken at speed, with somewhere to land.
	if options.allowVault ~= false and not options.exhausted and not deep and vaultRise &gt;= CFG.VaultMinRise
		and vaultRise &lt;= CFG.VaultMaxRise and speed &gt;= CFG.VaultMinSpeed then
		local farEdge = edge + forward * (depth + 0.3)
		local landXZ = farEdge + forward * (body.halfDepth + 1.1)
		-- A window: something over the top closer than a body's height (the lintel). Only asked when the
		-- caller allows the long drop, so everything else pays for no extra ray.
		local window = false
		if options.windowDrop then
			local mid = edge + forward * (depth / 2)
			window = workspace:Raycast(Vector3.new(mid.X, topY + 0.2, mid.Z), Vector3.new(0, body.height + 0.3, 0), rayParams) ~= nil
		end
		local maxDrop = window and CFG.WindowMaxDrop or CFG.VaultMaxDrop
		local land = workspace:Raycast(Vector3.new(landXZ.X, topY + 0.5, landXZ.Z), Vector3.new(0, -(maxDrop + 0.5), 0), rayParams)
		if land and land.Normal.Y &gt;= CFG.TopNormal and not unclimbable(land.Instance) and land.Position.Y &lt; topY - 0.4 then
			local landY = land.Position.Y
			-- Further down than a vault lands: the path ends just outside the window and the body falls.
			local drop = topY - landY &gt; CFG.VaultMaxDrop
			local lift = topY + math.max(body.stand * 0.62, 1.7)
			local through, _, panes = boxClear(overlapParams, flat(origin), landXZ + forward * body.halfDepth,
				topY + 0.3, topY + CFG.VaultClearance, width, forward, true)
			local landing = boxClear(overlapParams, landXZ - forward * body.halfDepth, landXZ + forward * body.halfDepth,
				landY + 0.35, landY + body.height - 0.1, width, forward)
			-- Where a drop leaves the path, the whole body has to fit, outside the wall.
			local exitClear = not drop or boxClear(overlapParams, landXZ - forward * body.halfDepth, landXZ + forward * body.halfDepth,
				lift - body.stand + 0.1, lift - body.stand + body.height, width, forward)
			if through and landing and exitClear then
				local pathSpeed = math.max(speed, CFG.VaultMinPathSpeed)
				local points = {
					origin,
					Vector3.new(edge.X, lift, edge.Z) - forward * (body.halfDepth + 0.1),
					Vector3.new(farEdge.X, lift, farEdge.Z) + forward * 0.1,
					drop and Vector3.new(landXZ.X, lift, landXZ.Z) or Vector3.new(landXZ.X, landY + body.stand, landXZ.Z),
				}
				local times = {}
				for index = 2, #points do
					local legLength = (points[index] - points[index - 1]).Magnitude
					table.insert(times, math.clamp(legLength / pathSpeed, 0.06, 0.4))
				end
				local duration = 0
				for _, t in ipairs(times) do
					duration += t
				end
				return {
					kind = "vault", rise = vaultRise, depth = depth, topY = topY, forward = forward, part = top.Instance,
					points = points, times = times, duration = duration, landY = landY, drop = drop,
					-- A drop leaves gently, so it comes down by the building rather than across the street.
					exitVelocity = drop and (forward * CFG.WindowDropExitSpeed + Vector3.new(0, -4, 0))
						or (forward * pathSpeed * 0.95 + Vector3.new(0, -4, 0)),
					cost = STAMINA.VaultCost,
					-- The window panes inside the clearance box: exactly the ones the body passes through, for
					-- whoever runs the plan to break (MovementService does, for bots). nil when there are none.
					panes = panes,
				}
			end
		end
	end

	-- 4b. A climb onto the top.
	if options.allowMantle == false then
		return nil, "no climb"
	end
	-- From the feet: a jump already carrying them past this top lands on it, no climb needed.
	if rise &lt; CFG.MinRise then
		return nil, "a step"
	end
	if not deep and depth &lt; 0.9 then
		return nil, "too thin to stand on"
	end
	local landInset = math.clamp(depth / 2 + 0.15, 0.6, body.halfDepth + 1.0)
	local landXZ = edge + forward * landInset
	local hang = Vector3.new(origin.X, 0, origin.Z)
	local pressed = edge - forward * (body.halfDepth + 0.2)
	-- Never pulled backwards toward a wall that's already under the chest.
	if (flat(pressed) - flat(origin)):Dot(forward) &gt; 0 then
		hang = flat(pressed)
	end
	-- The body rises from where it is to the hang point against the face, so that whole corridor, from the
	-- top of the head up to standing height over the ledge, has to be empty. (An overhang in front of the
	-- face is normally caught earlier, since the sweep meets its front edge first and climbs onto it; this
	-- covers the sliver between the head and the lip box, not just the column straight up.)
	local headTopY = origin.Y - body.stand + body.height
	if topY + body.height &gt; headTopY + 0.1 then
		local column = boxClear(overlapParams, flat(origin) - forward * 0.3, hang + forward * (body.halfDepth * 0.6),
			headTopY + 0.05, topY + body.height, width * 0.9, forward)
		if not column then
			return nil, "no headroom to rise"
		end
	end
	local over = boxClear(overlapParams, flat(origin), landXZ + forward * body.halfDepth,
		topY + 0.3, topY + body.height - 0.1, width, forward)
	if not over then
		return nil, "blocked over the lip"
	end
	local pullY = math.max(topY + math.max(body.stand * 0.42, 1.15), origin.Y)
	local points = {
		origin,
		Vector3.new(hang.X, pullY, hang.Z),
		Vector3.new(landXZ.X, topY + body.stand + 0.05, landXZ.Z),
	}
	local climb = math.max(pullY - origin.Y, 0)
	local scale = options.exhausted and CFG.ExhaustedTimeScale or 1
	local times = {
		math.clamp(CFG.MantleBaseTime + CFG.MantlePerStud * climb, CFG.MantleBaseTime, CFG.MantleMaxTime) * scale,
		CFG.MantleOverTime * scale,
	}
	return {
		kind = "mantle", rise = rise, depth = depth, deep = deep, topY = topY, forward = forward, part = top.Instance,
		points = points, times = times, duration = times[1] + times[2],
		exitVelocity = forward * math.max(6, math.min(speed, 18)),
		cost = rise &lt;= STAMINA.FreeMantleRise and 0 or STAMINA.MantleCost,
	}
end

--------------------------------------------------------------------------------
-- Poses
--------------------------------------------------------------------------------

-- How a body looks mid-move, for everyone watching (and you in third person). There's no uploaded
-- animation in this project, so poses are joint Transforms written in Stepped, straight after the
-- Animator (the same technique as GunPoseClient). Lower body and spine only: the arms stay with the
-- gun pose.
--
-- R15 joint frames: a positive X angle swings a hip's leg forward, folds a knee's shin forward too
-- (so a bent knee is negative), and tips the pelvis (Root) or chest (Waist) backwards. Checked by
-- render in tools/parkour_probe.lua's pose views.
local rad = math.rad
Parkour.Poses = {
	-- Leaning back on one hip, lead leg out straight, back leg tucked.
	slide = {
		Root = CFrame.new(0, -1.55, 0.2) * CFrame.Angles(rad(48), 0, rad(-8)),
		Waist = CFrame.Angles(rad(-20), rad(8), 0),
		RightHip = CFrame.Angles(rad(34), 0, rad(4)),
		RightKnee = CFrame.Angles(rad(-4), 0, 0),
		LeftHip = CFrame.Angles(rad(8), 0, rad(-10)),
		LeftKnee = CFrame.Angles(rad(-78), 0, 0),
	},
	-- Stepping up over the lip: chest leaning in, one knee driven high onto the ledge, the other leg
	-- still hanging below.
	mantle = {
		Root = CFrame.Angles(rad(-12), 0, 0),
		Waist = CFrame.Angles(rad(-16), 0, 0),
		RightHip = CFrame.Angles(rad(96), 0, 0),
		RightKnee = CFrame.Angles(rad(-112), 0, 0),
		LeftHip = CFrame.Angles(rad(-8), 0, 0),
		LeftKnee = CFrame.Angles(rad(-24), 0, 0),
	},
	-- A side vault: body tipped over, both legs swung up and tucked to one side.
	vault = {
		Root = CFrame.Angles(rad(-14), rad(-10), rad(34)),
		Waist = CFrame.Angles(rad(-8), 0, rad(-12)),
		RightHip = CFrame.Angles(rad(72), 0, rad(-18)),
		RightKnee = CFrame.Angles(rad(-44), 0, 0),
		LeftHip = CFrame.Angles(rad(58), 0, rad(-22)),
		LeftKnee = CFrame.Angles(rad(-82), 0, 0),
	},
}

local POSE_JOINTS = {
	Root = "LowerTorso",
	Waist = "UpperTorso",
	RightHip = "RightUpperLeg",
	RightKnee = "RightLowerLeg",
	LeftHip = "LeftUpperLeg",
	LeftKnee = "LeftLowerLeg",
	-- The ankles and the neck are here for Shared/CrouchAnimation: the ankles keep the soles flat while
	-- the legs fold, and the neck keeps the head up while the chest leans over it. The slide/climb/vault
	-- poses have no entry for any of the three, so ApplyPose leaves them exactly as the Animator left them.
	RightAnkle = "RightFoot",
	LeftAnkle = "LeftFoot",
	Neck = "Head",
}

-- The joints a pose drives, by name: Motor6Ds on a player's rig, AnimationConstraints on a physics rig
-- (every bot). Nil for anything that isn't R15.
function Parkour.PoseJoints(character)
	local joints = {}
	for jointName, partName in pairs(POSE_JOINTS) do
		local part = character:FindFirstChild(partName)
		local joint = part and part:FindFirstChild(jointName)
		if joint and (joint:IsA("Motor6D") or joint:IsA("AnimationConstraint")) then
			joints[jointName] = joint
		end
	end
	if not joints.Root or not joints.RightHip or not joints.LeftHip then
		return nil
	end
	return joints
end

-- Blends the pose for `kind` over whatever the Animator just wrote, by `weight` (0..1).
function Parkour.ApplyPose(joints, kind, weight)
	local pose = Parkour.Poses[kind]
	if not pose or weight &lt;= 0 then
		return
	end
	for jointName, target in pairs(pose) do
		local joint = joints[jointName]
		if joint then
			joint.Transform = weight &gt;= 1 and target or joint.Transform:Lerp(target, weight)
		end
	end
end

return Parkour
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">ProgressionData</string><ProtectedString name="Source">-- Meta-progression that outlasts the Brainrot Pass: Rot Rank and Prestige, Brain Cells, weapon
-- mastery, the Rot Index and the Cell Shop. Pure data and maths, required by the server
-- (ProgressionService), by StateSync for the menu snapshot and by the Rank tab
-- (ProgressionPanel), so every side works a number out the same way.
--
--   Rot Rank     an account level, 1 to MaxRank, fed by every point of Brainrot Pass XP (the pass
--                itself is untouched) plus mastery bonuses. Reaching MaxRank lets you PRESTIGE:
--                rank goes back to 1 and every rank reward pays again, a little bigger. XP earned
--                while sitting at MaxRank isn't wasted — every OverflowXp of it pays Cells.
--   Brain Cells  the currency progression pays in. They can't be bought with Robux and no gamepass
--                multiplies them. Spent in the Cell Shop.
--   Mastery      per gun. Credited eliminations earn points (a real player is worth more than a
--                bot) and every tier pays Cells and Rot Rank XP.
--   Rot Index    a lifetime log of every brainrot you have ever owned. Selling or trading a copy
--                never takes an entry back. Each discovery is claimed once for Cells, and a whole
--                rarity page claimed pays a page bonus on top. A brainrot first found by buying it
--                with Robux is logged as Purchased: it shows, but pays nothing until it turns up
--                in play (a crate pull or a Cell Shop buy), so buying one with Robux pays no Cells.
--   Cell Shop    a daily rotation, the same on every server: one brainrot each of Common to Epic
--                and a Companion Snack. Never Legendary or better, and never crates, so the
--                scarcity CrateData and ShopRotation keep isn't touched (tools/verify.py checks).
--
-- Save data lives on the profile as `Progression` (see Default). Reconcile only ever keeps clean,
-- bounded values: counters are whole, finite and non-negative, and every map is capped.

local BrainrotData = require(script.Parent:WaitForChild("BrainrotData"))
local Rarity = require(script.Parent:WaitForChild("Rarity"))
-- WeaponData is required lazily (MasteryWeapons): PlayerData requires this module, and a profile
-- must still load if a gun file is mid-edit and fails.

local ProgressionData = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Bumped when a profile's Progression has been backfilled from what the profile already held
-- (ProgressionService.Migrate). 0 means "not yet".
ProgressionData.Version = 1

--------------------------------------------------------------------------------
-- Rot Rank and Prestige
--------------------------------------------------------------------------------

ProgressionData.MaxRank = 100
ProgressionData.MaxPrestige = 10

-- XP to go from `rank` to the next one. Rank 2 is about one match; the climb steepens to a flat 2,000
-- near the top, so a late rank still costs twelve times an early one. Halved on 2026-09-17 (Oliver:
-- the ladder was too long) — one prestige went from 31 to 16 hours for a strong player, 74 to 38 for a
-- casual one. The shape was kept rather than flattened: a ladder whose rungs all cost the same is a
-- worse ladder. tools/progression_model.py prints the current hours.
function ProgressionData.XpToNext(rank)
	return math.min(150 + 20 * rank, 2000)
end

local rankStart = { [1] = 0 }
for rank = 2, ProgressionData.MaxRank do
	rankStart[rank] = rankStart[rank - 1] + ProgressionData.XpToNext(rank - 1)
end

-- XP from rank 1 to MaxRank: one prestige's worth.
ProgressionData.PrestigeXp = rankStart[ProgressionData.MaxRank]

-- Past MaxRank, every OverflowXp pays OverflowCells (times the prestige multiplier).
ProgressionData.OverflowXp = 25000
ProgressionData.OverflowCells = 500

function ProgressionData.RankStart(rank)
	return rankStart[math.clamp(math.floor(rank), 1, ProgressionData.MaxRank)]
end

function ProgressionData.RankForXp(xp)
	xp = xp or 0
	local low, high = 1, ProgressionData.MaxRank
	while low &lt; high do
		local mid = (low + high + 1) // 2
		if rankStart[mid] &lt;= xp then
			low = mid
		else
			high = mid - 1
		end
	end
	return low
end

-- Rank, XP into it, and the XP it needs (nil at MaxRank).
function ProgressionData.RankProgress(xp)
	local rank = ProgressionData.RankForXp(xp)
	if rank &gt;= ProgressionData.MaxRank then
		return rank, 0, nil
	end
	return rank, (xp or 0) - rankStart[rank], ProgressionData.XpToNext(rank)
end

-- Each prestige makes rank Cells worth 10% more. Cells only: never coins, never crates.
ProgressionData.PrestigeCellBonus = 0.10

function ProgressionData.PrestigeMultiplier(prestige)
	return 1 + ProgressionData.PrestigeCellBonus * math.clamp(prestige or 0, 0, ProgressionData.MaxPrestige)
end

-- A crate on a handful of milestone ranks. Kept sparse and below Legendary on purpose: a whole
-- prestige is five crates next to the hundreds that placements pay over the same hours.
ProgressionData.RankCrates = { [20] = "Rare", [40] = "Rare", [60] = "Rare", [80] = "Rare", [100] = "Epic" }

-- What reaching `rank` pays, at a given prestige. Trimmed alongside the halved curve so twice as many
-- rank-ups don't double Cell income: it lands about 20% above the old rate (263/h for a strong player
-- against 217), which keeps the Cell Shop's 40,000-Cell cosmetics a long-term goal.
function ProgressionData.RankReward(rank, prestige)
	local cells = 14 + 1 * (rank // 5)
	if rank % 25 == 0 then
		cells += 250
	elseif rank % 10 == 0 then
		cells += 100
	end
	return {
		cells = math.floor(cells * ProgressionData.PrestigeMultiplier(prestige) + 0.5),
		crate = ProgressionData.RankCrates[rank],
	}
end

function ProgressionData.OverflowReward(prestige)
	return math.floor(ProgressionData.OverflowCells * ProgressionData.PrestigeMultiplier(prestige) + 0.5)
end

-- Paid on the moment of prestiging into `prestige`.
function ProgressionData.PrestigeReward(prestige)
	return { cells = 1000 * prestige }
end

-- Emblem colour and name per prestige, 0 (none yet) to MaxPrestige.
ProgressionData.Prestiges = {
	[0] = { name = "Fresh", color = rgb(146, 152, 170) },
	{ name = "Bronze Rot", color = rgb(205, 127, 50) },
	{ name = "Silver Rot", color = rgb(200, 206, 216) },
	{ name = "Golden Rot", color = rgb(255, 196, 64) },
	{ name = "Jade Rot", color = rgb(80, 220, 140) },
	{ name = "Sapphire Rot", color = rgb(74, 156, 255) },
	{ name = "Amethyst Rot", color = rgb(186, 104, 255) },
	{ name = "Ruby Rot", color = rgb(236, 64, 96) },
	{ name = "Neon Rot", color = rgb(255, 90, 200) },
	{ name = "Diamond Rot", color = rgb(150, 236, 255) },
	{ name = "Eternal Rot", color = rgb(255, 245, 190) },
}

function ProgressionData.PrestigeInfo(prestige)
	return ProgressionData.Prestiges[math.clamp(prestige or 0, 0, ProgressionData.MaxPrestige)]
end

-- Numbers in sentences: whole, comma-grouped ("24,000"). The compact form ("24.0K", UiKit.formatNumber)
-- is only for chips, tiles and buttons with no room. `Cells(n)` also gets the plural right.
function ProgressionData.Commas(n)
	local text = tostring(math.floor(math.abs(n or 0)))
	local grouped = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if grouped:sub(1, 1) == "," then
		grouped = grouped:sub(2)
	end
	return ((n or 0) &lt; 0 and "-" or "") .. grouped
end

function ProgressionData.Cells(n)
	return ProgressionData.Commas(n) .. (math.floor(math.abs(n or 0)) == 1 and " Brain Cell" or " Brain Cells")
end

-- One number that only ever goes up: 147 is prestige 1, rank 47. Titles hang off it.
function ProgressionData.RankScore(prestige, rank)
	return (prestige or 0) * ProgressionData.MaxRank + (rank or 1)
end

--------------------------------------------------------------------------------
-- Weapon mastery
--------------------------------------------------------------------------------

ProgressionData.KillPoints = { bot = 1, player = 3 }

ProgressionData.MasteryTiers = {
	{ name = "Bronze", points = 10, cells = 20, xp = 150, color = rgb(205, 127, 50) },
	{ name = "Silver", points = 30, cells = 40, xp = 300, color = rgb(200, 206, 216) },
	{ name = "Gold", points = 75, cells = 80, xp = 600, color = rgb(255, 196, 64) },
	{ name = "Platinum", points = 150, cells = 150, xp = 1000, color = rgb(120, 230, 210) },
	{ name = "Diamond", points = 300, cells = 250, xp = 1500, color = rgb(120, 200, 255) },
	{ name = "Rotmaster", points = 600, cells = 400, xp = 2500, color = rgb(255, 90, 200) },
}

-- Reaching this tier counts toward the "mastered" titles.
ProgressionData.MasteredTier = 3
ProgressionData.MasteryPointCap = 1000000

function ProgressionData.MasteryTier(points)
	local tier = 0
	for index, info in ipairs(ProgressionData.MasteryTiers) do
		if (points or 0) &gt;= info.points then
			tier = index
		else
			break
		end
	end
	return tier
end

-- Every gun in WeaponData (packs merged into it included, so new guns count with no list to keep),
-- commonest first and then by name, for the Mastery page. Built on first use.
local masteryWeapons = nil

-- `staged` guns (a pack's guns that aren't in loot yet) are left out, so the page never shows a goal
-- nobody can reach; the list grows on its own the day the flag comes off, with no migration. Pass a
-- mastery map to also include any staged gun that already has points, so earned progress is never
-- hidden — for instance if a gun is staged again after going live.
function ProgressionData.MasteryWeapons(mastery)
	local WeaponData = require(script.Parent:WaitForChild("WeaponData"))
	local function order(a, b)
		local ra = Rarity.Index[WeaponData.Weapons[a].rarity] or 0
		local rb = Rarity.Index[WeaponData.Weapons[b].rarity] or 0
		if ra ~= rb then
			return ra &lt; rb
		end
		return WeaponData.Weapons[a].name &lt; WeaponData.Weapons[b].name
	end

	if not masteryWeapons then
		local list = {}
		for id, def in pairs(WeaponData.Weapons) do
			if not def.staged then
				table.insert(list, id)
			end
		end
		table.sort(list, order)
		masteryWeapons = list
	end

	if not mastery then
		return masteryWeapons
	end

	local extra = {}
	for id, points in pairs(mastery) do
		if WeaponData.Weapons[id] and WeaponData.Weapons[id].staged and (points or 0) &gt; 0 then
			table.insert(extra, id)
		end
	end
	if #extra == 0 then
		return masteryWeapons
	end
	table.sort(extra, order)
	local combined = table.clone(masteryWeapons)
	for _, id in ipairs(extra) do
		table.insert(combined, id)
	end
	return combined
end

--------------------------------------------------------------------------------
-- Rot Index
--------------------------------------------------------------------------------

-- Index states. Recorded: found in play, Cells waiting to be claimed. Claimed: paid. Purchased: first
-- found by buying it with Robux, so it pays nothing and counts toward no page bonus until the same
-- brainrot comes out of a crate or the Cell Shop (ProgressionService.RecordIndex's `earnedName`).
ProgressionData.Recorded = 1
ProgressionData.Claimed = 2
ProgressionData.Purchased = 3

ProgressionData.DiscoverCells = {
	Common = 10, Uncommon = 20, Rare = 40, Epic = 100, Legendary = 250, Mythic = 600, Secret = 1500,
}

-- Paid once, when the last brainrot of a rarity is claimed.
ProgressionData.PageBonus = {
	Common = 250, Uncommon = 500, Rare = 1000, Epic = 2500, Legendary = 5000, Mythic = 8000, Secret = 15000,
}

--------------------------------------------------------------------------------
-- Cell Shop
--------------------------------------------------------------------------------

-- Nothing at or above this rarity is ever offered (tools/verify.py holds it there).
ProgressionData.ShopRarityCeiling = "Legendary"

ProgressionData.ShopSlots = {
	{ id = "common", kind = "Brainrot", rarity = "Common", price = 60, limit = 1 },
	{ id = "uncommon", kind = "Brainrot", rarity = "Uncommon", price = 150, limit = 1 },
	{ id = "rare", kind = "Brainrot", rarity = "Rare", price = 450, limit = 1 },
	{ id = "epic", kind = "Brainrot", rarity = "Epic", price = 1500, limit = 1 },
	{ id = "snack", kind = "Snack", xp = 400, price = 350, limit = 2 },
}

function ProgressionData.Day(now)
	return math.floor((now or os.time()) / 86400)
end

local cachedShopDay, cachedOffers = nil, nil

-- The day's offers: each slot with, for brainrot slots, the brainrot picked for it. Drawn with a
-- Random seeded from the day, so every server and every client agrees without asking.
function ProgressionData.ShopOffers(day)
	if cachedShopDay == day then
		return cachedOffers
	end
	local random = Random.new(day * 7331 + 17)
	local offers = {}
	for _, slot in ipairs(ProgressionData.ShopSlots) do
		local offer = table.clone(slot)
		if slot.kind == "Brainrot" then
			local pool = BrainrotData.OfRarity(slot.rarity)
			offer.brainrot = #pool &gt; 0 and pool[random:NextInteger(1, #pool)].name or nil
		end
		table.insert(offers, offer)
	end
	cachedShopDay, cachedOffers = day, offers
	return offers
end

function ProgressionData.FindOffer(day, offerId)
	for _, offer in ipairs(ProgressionData.ShopOffers(day)) do
		if offer.id == offerId then
			return offer
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Rank-reward cosmetics
--------------------------------------------------------------------------------

-- The `rankOnly` cosmetics in CosmeticData and what earns each. Exactly one condition per entry:
--   prestige     reaching that prestige
--   mastered     Gold mastery or better on that many different guns
--   masteryTier  any one gun at that tier or better
--   cells        a permanent Cell Shop listing at that many Brain Cells (`offer` is its offer id)
-- tools/verify.py checks every entry is a rankOnly cosmetic and every rankOnly cosmetic is here.
ProgressionData.RankCosmetics = {
	{ id = "PrestigeBronzeSkin", prestige = 1 },
	{ id = "PrestigeSilverAura", prestige = 2 },
	{ id = "PrestigeGoldenSkin", prestige = 3 },
	{ id = "PrestigeJadeAura", prestige = 4 },
	{ id = "PrestigeSapphireSkin", prestige = 5 },
	{ id = "PrestigeAmethystAura", prestige = 6 },
	{ id = "PrestigeRubySkin", prestige = 7 },
	{ id = "PrestigeNeonAura", prestige = 8 },
	{ id = "PrestigeDiamondSkin", prestige = 9 },
	{ id = "PrestigeEternalAura", prestige = 10 },
	{ id = "MasteryMastercraftSkin", mastered = 5 },
	{ id = "MasteryDiamondCutSkin", masteryTier = 5 },
	{ id = "MasteryRotmasterSkin", masteryTier = 6 },
	{ id = "CellBrainAura", cells = 15000, offer = "brainAura" },
	{ id = "CellSynapseSkin", cells = 25000, offer = "synapseSkin" },
}

-- Guns at Gold or better, and the best tier on any gun, from a mastery map.
function ProgressionData.MasterySummary(mastery)
	local mastered, best = 0, 0
	for _, points in pairs(mastery or {}) do
		local tier = ProgressionData.MasteryTier(points)
		if tier &gt;= ProgressionData.MasteredTier then
			mastered += 1
		end
		best = math.max(best, tier)
	end
	return mastered, best
end

-- Whether a rank cosmetic's condition is met (Cell Shop ones are bought, so never "earned").
function ProgressionData.CosmeticEarned(entry, progression)
	if entry.prestige then
		return (progression.prestige or 0) &gt;= entry.prestige
	end
	local mastered, best = ProgressionData.MasterySummary(progression.mastery)
	if entry.mastered then
		return mastered &gt;= entry.mastered
	elseif entry.masteryTier then
		return best &gt;= entry.masteryTier
	end
	return false
end

-- How an entry is earned, in words, for the menu.
function ProgressionData.CosmeticRequirement(entry)
	if entry.prestige then
		return "Prestige " .. entry.prestige
	elseif entry.mastered then
		return string.format("Gold mastery on %d guns", entry.mastered)
	elseif entry.masteryTier then
		return string.format("%s mastery on any gun", ProgressionData.MasteryTiers[entry.masteryTier].name)
	elseif entry.cells then
		return ProgressionData.Cells(entry.cells) .. " in the Cell Shop"
	end
	return "?"
end

function ProgressionData.FindCosmeticOffer(offerId)
	for _, entry in ipairs(ProgressionData.RankCosmetics) do
		if entry.offer and entry.offer == offerId then
			return entry
		end
	end
	return nil
end

function ProgressionData.PrestigeCosmetic(prestige)
	for _, entry in ipairs(ProgressionData.RankCosmetics) do
		if entry.prestige == prestige then
			return entry
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Save data
--------------------------------------------------------------------------------

local MAX_MASTERY_KEYS = 128
local MAX_INDEX_KEYS = 512
local MAX_SHOP_KEYS = 16
local MAX_COUNTER = 1e15

function ProgressionData.Default()
	return {
		v = 0,
		-- XP into the current prestige (0 to PrestigeXp), lifetime XP, and XP banked past MaxRank.
		xp = 0,
		total = 0,
		over = 0,
		prestige = 0,
		cells = 0,
		cellsEarned = 0,
		-- Weapon id -&gt; mastery points.
		mastery = {},
		-- Brainrot name -&gt; Recorded or Claimed.
		index = {},
		-- Rarity -&gt; true once its page bonus has been paid.
		pages = {},
		-- The highest rank this profile has already been PAID for. Rewards are handed out when a rank is
		-- crossed, so without this a cheaper curve would silently skip the ranks a player's stored XP now
		-- reaches, and a dearer one could pay the same ranks twice. Set from the player's rank the first
		-- time it's seen (no windfall), reset to 1 on prestige.
		paidRank = 0,
		-- The Cell Shop day these purchases belong to, and offer id -&gt; times bought that day.
		shop = { day = 0, bought = {} },
		-- Beginner's Luck charges (CrateData): how many are left, and whether this profile has ever been
		-- given them. `granted` is the marker the grant keys off, so charges can't be handed out twice;
		-- an absent field reads as no charges, which is why this module only stores and clamps.
		beginnerLuck = { left = 0, granted = false },
	}
end

local function whole(value, max)
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.clamp(math.floor(value), 0, max or MAX_COUNTER)
end

local function cleanKey(key, maxLength)
	return type(key) == "string" and #key &gt; 0 and #key &lt;= maxLength
end

function ProgressionData.Reconcile(saved)
	local clean = ProgressionData.Default()
	if type(saved) ~= "table" then
		return clean
	end

	clean.v = whole(saved.v, ProgressionData.Version)
	clean.xp = whole(saved.xp, ProgressionData.PrestigeXp)
	clean.total = whole(saved.total)
	clean.over = whole(saved.over, ProgressionData.OverflowXp)
	clean.prestige = whole(saved.prestige, ProgressionData.MaxPrestige)
	clean.paidRank = whole(saved.paidRank, ProgressionData.MaxRank)
	clean.cells = whole(saved.cells)
	clean.cellsEarned = whole(saved.cellsEarned)

	if type(saved.mastery) == "table" then
		local count = 0
		for id, points in pairs(saved.mastery) do
			if cleanKey(id, 64) and type(points) == "number" and count &lt; MAX_MASTERY_KEYS then
				local value = whole(points, ProgressionData.MasteryPointCap)
				if value &gt; 0 then
					clean.mastery[id] = value
					count += 1
				end
			end
		end
	end

	if type(saved.index) == "table" then
		local count = 0
		for name, state in pairs(saved.index) do
			if cleanKey(name, 64)
				and (state == ProgressionData.Recorded or state == ProgressionData.Claimed or state == ProgressionData.Purchased)
				and count &lt; MAX_INDEX_KEYS then
				clean.index[name] = state
				count += 1
			end
		end
	end

	if type(saved.pages) == "table" then
		for _, rarity in ipairs(Rarity.Order) do
			if saved.pages[rarity] == true then
				clean.pages[rarity] = true
			end
		end
	end

	if type(saved.beginnerLuck) == "table" then
		local CrateData = require(script.Parent:WaitForChild("CrateData"))
		clean.beginnerLuck.left = whole(saved.beginnerLuck.left, CrateData.BeginnerCrates or 0)
		clean.beginnerLuck.granted = saved.beginnerLuck.granted == true
	end

	if type(saved.shop) == "table" then
		clean.shop.day = whole(saved.shop.day)
		if type(saved.shop.bought) == "table" then
			local count = 0
			for id, times in pairs(saved.shop.bought) do
				if cleanKey(id, 16) and type(times) == "number" and count &lt; MAX_SHOP_KEYS then
					local value = whole(times, 99)
					if value &gt; 0 then
						clean.shop.bought[id] = value
						count += 1
					end
				end
			end
		end
	end

	return clean
end

--------------------------------------------------------------------------------
-- Views
--------------------------------------------------------------------------------

-- Discoveries per rarity from an index map: { [rarity] = { found, claimed, total } }.
function ProgressionData.IndexCounts(index)
	local counts = {}
	for _, rarity in ipairs(Rarity.Order) do
		counts[rarity] = { found = 0, claimed = 0, total = #BrainrotData.OfRarity(rarity) }
	end
	for name, state in pairs(index) do
		local def = BrainrotData.Get(name)
		local entry = def and counts[def.rarity]
		if entry then
			entry.found += 1
			if state == ProgressionData.Claimed then
				entry.claimed += 1
			end
		end
	end
	return counts
end

-- What the Rank tab draws. `data` is the whole profile; returns nil for a profile without
-- Progression. Maps are sent as they are (weapon id -&gt; points, name -&gt; state) and the panel works
-- tiers and counts out with the functions above, so a push stays small.
function ProgressionData.Snapshot(data, now)
	local progression = data and data.Progression
	if type(progression) ~= "table" then
		return nil
	end
	now = now or os.time()

	local rank, into, need = ProgressionData.RankProgress(progression.xp)

	-- Anything owned right now counts as found even before the server has written it down.
	local index = {}
	for name, state in pairs(progression.index) do
		if BrainrotData.Get(name) then
			index[name] = state
		end
	end
	for _, name in ipairs(data.Brainrots or {}) do
		if not index[name] and BrainrotData.Get(name) then
			index[name] = ProgressionData.Recorded
		end
	end

	local day = ProgressionData.Day(now)
	local shop = progression.shop
	local companion = data.Companion

	return {
		rank = rank,
		prestige = progression.prestige,
		xpInto = into,
		xpNeed = need,
		total = progression.total,
		over = progression.over,
		cells = progression.cells,
		cellsEarned = progression.cellsEarned,
		canPrestige = rank &gt;= ProgressionData.MaxRank and progression.prestige &lt; ProgressionData.MaxPrestige,
		mastery = progression.mastery,
		index = index,
		pages = progression.pages,
		shop = {
			day = day,
			bought = shop.day == day and shop.bought or {},
			resetIn = math.max(0, (day + 1) * 86400 - now),
		},
		companion = companion,
		companionXp = companion and data.CompanionXp and data.CompanionXp[companion] or 0,
	}
end

-- Playtime awards (#76), paid by PlaytimeService: coins for every IntervalSeconds of active play
-- in one visit, each award StepCoins bigger than the last up to CapCoins. Leaving the server
-- starts the ladder again; nothing is saved. A stretch only counts if the player moved in at
-- least MinActiveSamples of its SampleSeconds checks, so standing still in the lobby earns nothing.
-- Hour 1 pays 50+75+...+175 = 675 and every hour after pays 6 x 200 = 1,200. Against ECONOMY.md
-- section 2's cash an hour, that is +12% then +22% for a player who only ever loses (5,431), and
-- +6% then +10% for one who wins sometimes (12,024): it matters most to the player losing most.
ProgressionData.Playtime = {
	IntervalSeconds = 600,
	FirstCoins = 50,
	StepCoins = 25,
	CapCoins = 200,
	SampleSeconds = 30,
	MinActiveSamples = 10, -- of the 20 checks in a stretch
	MoveStuds = 4,
}

-- The coins the award'th playtime award pays (1 = the first one of a visit).
function ProgressionData.PlaytimeCoins(award)
	local p = ProgressionData.Playtime
	return math.min(p.CapCoins, p.FirstCoins + p.StepCoins * math.max(0, award - 1))
end

return ProgressionData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">QuestData</string><ProtectedString name="Source">-- Daily quests and weekly challenges.
--
-- Three quests a day — one easy, one medium, one hard — and two challenges a week, the same for
-- everyone, rolled from the day or week number so every server agrees without talking. Progress
-- lives on the profile: dailies reset at midnight UTC, weeklies every seven days. A quest pays
-- coins and pass XP the moment it's done; finishing all three dailies pays a bonus crate on top,
-- and every weekly challenge pays a crate of its own.
--
-- `stat` is what QuestService counts. Where they come from:
--   kills     eliminations (players and bots)        matches   matches played
--   top10     top-10 finishes                        wins      wins
--   chests    chests opened                          items     heals, shields and items used
--   damage    damage dealt (shield counts)           crates    crates opened in the menu
--   supply    supply drops claimed                   obby      Cloud Climb clears
--   goals     goals scored on the lobby pitch        landmarkChests  chests opened inside a landmark
--   builds    portable defenses built (mines too)    barrels   explosive barrels you set off
--   vendor    Rot Vendor purchases                   hazardKills  eliminations by barrel or Rot Mine
-- The team modes (RewardService.AwardTeamResult, at the end of a Team Deathmatch or Objective Capture; not
-- counted for a player idle most of the match):
--   teamMatches  team matches played                 teamWins  team matches won
--   assists      assists                             captures  objectives captured (Objective Capture)
--   mvp          times the team's MVP
--
-- Titles use %d for the target; the ones without a number ignore it.

local QuestData = {}

QuestData.BonusCrate = "Epic"
QuestData.WeeklyCount = 2

QuestData.Pool = {
	easy = {
		{ id = "kills5", stat = "kills", target = 5, title = "Eliminate %d opponents", coins = 400, xp = 150 },
		{ id = "matches2", stat = "matches", target = 2, title = "Play %d matches", coins = 400, xp = 150 },
		{ id = "chests6", stat = "chests", target = 6, title = "Open %d chests", coins = 400, xp = 150 },
		{ id = "items6", stat = "items", target = 6, title = "Use %d heals, shields or items", coins = 400, xp = 150 },
		{ id = "damage800", stat = "damage", target = 800, title = "Deal %d damage", coins = 400, xp = 150 },
		{ id = "goals3", stat = "goals", target = 3, title = "Score %d goals on the lobby pitch", coins = 400, xp = 150 },
		{ id = "crates2", stat = "crates", target = 2, title = "Open %d crates", coins = 400, xp = 150 },
		{ id = "landmark3", stat = "landmarkChests", target = 3, title = "Open %d chests at landmarks", coins = 400, xp = 150 },
		{ id = "builds3", stat = "builds", target = 3, title = "Build %d portable defenses", coins = 400, xp = 150 },
		{ id = "barrels2", stat = "barrels", target = 2, title = "Blow up %d explosive barrels", coins = 400, xp = 150 },
		{ id = "vendor2", stat = "vendor", target = 2, title = "Buy %d things from a Rot Vendor", coins = 400, xp = 150 },
		{ id = "team2", stat = "teamMatches", target = 2, title = "Play %d team matches", coins = 400, xp = 150 },
	},
	medium = {
		{ id = "kills12", stat = "kills", target = 12, title = "Eliminate %d opponents", coins = 900, xp = 300 },
		{ id = "top10x2", stat = "top10", target = 2, title = "Finish in the top 10 %d times", coins = 900, xp = 300 },
		{ id = "chests15", stat = "chests", target = 15, title = "Open %d chests", coins = 900, xp = 300 },
		{ id = "items15", stat = "items", target = 15, title = "Use %d heals, shields or items", coins = 900, xp = 300 },
		{ id = "damage2500", stat = "damage", target = 2500, title = "Deal %d damage", coins = 900, xp = 300 },
		{ id = "matches4", stat = "matches", target = 4, title = "Play %d matches", coins = 900, xp = 300 },
		{ id = "supply1", stat = "supply", target = 1, title = "Claim a supply drop", coins = 900, xp = 300 },
		{ id = "obby1", stat = "obby", target = 1, title = "Clear the Cloud Climb", coins = 900, xp = 300 },
		{ id = "landmark8", stat = "landmarkChests", target = 8, title = "Open %d chests at landmarks", coins = 900, xp = 300 },
		{ id = "hazard2", stat = "hazardKills", target = 2, title = "Eliminate %d opponents with barrels or mines", coins = 900, xp = 300 },
		{ id = "barrels6", stat = "barrels", target = 6, title = "Blow up %d explosive barrels", coins = 900, xp = 300 },
		{ id = "assists6", stat = "assists", target = 6, title = "Get %d assists in team matches", coins = 900, xp = 300 },
		{ id = "captures3", stat = "captures", target = 3, title = "Capture %d objectives in Objective Capture", coins = 900, xp = 300 },
	},
	hard = {
		{ id = "win1", stat = "wins", target = 1, title = "Win a match", coins = 2000, xp = 600 },
		{ id = "kills25", stat = "kills", target = 25, title = "Eliminate %d opponents", coins = 2000, xp = 600 },
		{ id = "top10x4", stat = "top10", target = 4, title = "Finish in the top 10 %d times", coins = 2000, xp = 600 },
		{ id = "damage5000", stat = "damage", target = 5000, title = "Deal %d damage", coins = 2000, xp = 600 },
		{ id = "chests30", stat = "chests", target = 30, title = "Open %d chests", coins = 2000, xp = 600 },
		{ id = "obby3", stat = "obby", target = 3, title = "Clear the Cloud Climb %d times", coins = 2000, xp = 600 },
		{ id = "crates5", stat = "crates", target = 5, title = "Open %d crates", coins = 2000, xp = 600 },
		{ id = "hazard5", stat = "hazardKills", target = 5, title = "Eliminate %d opponents with barrels or mines", coins = 2000, xp = 600 },
		-- Three, where the battle royale's is one: a team match is won about half the time.
		{ id = "teamwins3", stat = "teamWins", target = 3, title = "Win %d team matches", coins = 2000, xp = 600 },
	},
}

-- Weekly challenges: the long grind. Each one pays a crate on top of coins and XP.
QuestData.WeeklyPool = {
	{ id = "w_wins3", stat = "wins", target = 3, title = "Win %d matches", coins = 6000, xp = 2000, crate = "Legendary" },
	{ id = "w_kills100", stat = "kills", target = 100, title = "Eliminate %d opponents", coins = 6000, xp = 2000, crate = "Legendary" },
	{ id = "w_top10x10", stat = "top10", target = 10, title = "Finish in the top 10 %d times", coins = 5000, xp = 1500, crate = "Epic" },
	{ id = "w_chests80", stat = "chests", target = 80, title = "Open %d chests", coins = 4000, xp = 1200, crate = "Epic" },
	{ id = "w_matches15", stat = "matches", target = 15, title = "Play %d matches", coins = 4000, xp = 1200, crate = "Epic" },
	{ id = "w_damage20000", stat = "damage", target = 20000, title = "Deal %d damage", coins = 5000, xp = 1500, crate = "Epic" },
	{ id = "w_obby7", stat = "obby", target = 7, title = "Clear the Cloud Climb %d times", coins = 3500, xp = 1000, crate = "Rare" },
	{ id = "w_crates12", stat = "crates", target = 12, title = "Open %d crates", coins = 4000, xp = 1200, crate = "Epic" },
	{ id = "w_goals15", stat = "goals", target = 15, title = "Score %d goals on the lobby pitch", coins = 3000, xp = 900, crate = "Rare" },
	{ id = "w_items60", stat = "items", target = 60, title = "Use %d heals, shields or items", coins = 4000, xp = 1200, crate = "Epic" },
	{ id = "w_hazard10", stat = "hazardKills", target = 10, title = "Eliminate %d opponents with barrels or mines", coins = 4000, xp = 1200, crate = "Epic" },
	{ id = "w_vendor12", stat = "vendor", target = 12, title = "Buy %d things from Rot Vendors", coins = 3000, xp = 900, crate = "Rare" },
	{ id = "w_teamwins10", stat = "teamWins", target = 10, title = "Win %d team matches", coins = 5000, xp = 1500, crate = "Epic" },
	{ id = "w_mvp3", stat = "mvp", target = 3, title = "Be your team's MVP %d times", coins = 5000, xp = 1500, crate = "Epic" },
}

QuestData.TierOrder = { "easy", "medium", "hard" }

for tier, list in pairs(QuestData.Pool) do
	for _, quest in ipairs(list) do
		quest.tier = tier
	end
end
for _, quest in ipairs(QuestData.WeeklyPool) do
	quest.tier = "weekly"
end

function QuestData.Title(quest)
	return string.format(quest.title, quest.target)
end

function QuestData.Day(now)
	return math.floor((now or os.time()) / 86400)
end

function QuestData.Week(now)
	return math.floor(QuestData.Day(now) / 7)
end

local cachedDay, cachedToday = nil, nil
local cachedWeek, cachedWeekly = nil, nil

-- The three quests for `day`, one per tier, drawn with a Random seeded from the day.
function QuestData.Today(day)
	if cachedDay == day then
		return cachedToday
	end
	local random = Random.new(day * 6151 + 7)
	local list = {}
	for _, tier in ipairs(QuestData.TierOrder) do
		local pool = QuestData.Pool[tier]
		table.insert(list, pool[random:NextInteger(1, #pool)])
	end
	cachedDay, cachedToday = day, list
	return list
end

-- The challenges for `week`, two different ones.
function QuestData.ThisWeek(week)
	if cachedWeek == week then
		return cachedWeekly
	end
	local random = Random.new(week * 9973 + 3)
	local pool = table.clone(QuestData.WeeklyPool)
	local list = {}
	for _ = 1, math.min(QuestData.WeeklyCount, #pool) do
		table.insert(list, table.remove(pool, random:NextInteger(1, #pool)))
	end
	cachedWeek, cachedWeekly = week, list
	return list
end

-- Rolls a profile's quest record over to `day` (and its week) if it's from an earlier one.
function QuestData.Ensure(quests, day)
	if quests.day ~= day then
		quests.day = day
		quests.progress = {}
		quests.done = {}
		quests.bonus = false
	end
	local week = math.floor(day / 7)
	if quests.week ~= week then
		quests.week = week
		quests.weekProgress = {}
		quests.weekDone = {}
	end
	return quests
end

local function describe(quest, progress, done)
	return {
		id = quest.id,
		tier = quest.tier,
		stat = quest.stat,
		title = QuestData.Title(quest),
		target = quest.target,
		progress = math.min(quest.target, progress or 0),
		done = done == true,
		coins = quest.coins,
		xp = quest.xp,
		crate = quest.crate,
	}
end

-- What the menu draws: every quest with its progress, the bonus state and the reset timers.
function QuestData.Snapshot(quests, day, now)
	QuestData.Ensure(quests, day)
	now = now or os.time()

	local list, doneCount = {}, 0
	for _, quest in ipairs(QuestData.Today(day)) do
		local done = quests.done[quest.id] == true
		if done then
			doneCount += 1
		end
		table.insert(list, describe(quest, quests.progress[quest.id], done))
	end

	local weekly = {}
	for _, quest in ipairs(QuestData.ThisWeek(quests.week)) do
		table.insert(weekly, describe(quest, quests.weekProgress[quest.id], quests.weekDone[quest.id]))
	end

	return {
		day = day,
		resetIn = math.max(0, (day + 1) * 86400 - now),
		list = list,
		doneCount = doneCount,
		total = #list,
		bonusClaimed = quests.bonus == true,
		bonusCrate = QuestData.BonusCrate,
		weekly = weekly,
		weekResetIn = math.max(0, (quests.week + 1) * 7 * 86400 - now),
	}
end

-- "5h 12m" (or "2d 5h") until the next set.
function QuestData.FormatReset(seconds)
	seconds = math.max(0, math.floor(seconds))
	if seconds &gt;= 86400 then
		return string.format("%dd %dh", seconds // 86400, (seconds % 86400) // 3600)
	elseif seconds &gt;= 3600 then
		return string.format("%dh %02dm", seconds // 3600, (seconds % 3600) // 60)
	end
	return string.format("%dm %02ds", seconds // 60, seconds % 60)
end

return QuestData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">Rarity</string><ProtectedString name="Source">local Rarity = {}

-- Mythic and Secret sit above Legendary. Nothing drops them loose: they come only from the top
-- crates, at small odds, which is what makes a full collection a long grind.
Rarity.Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }

Rarity.Index = {}
for index, name in ipairs(Rarity.Order) do
	Rarity.Index[name] = index
end

Rarity.Colors = {
	Common = Color3.fromRGB(178, 184, 196),
	Uncommon = Color3.fromRGB(94, 214, 122),
	Rare = Color3.fromRGB(74, 156, 255),
	Epic = Color3.fromRGB(186, 104, 255),
	Legendary = Color3.fromRGB(255, 184, 48),
	Mythic = Color3.fromRGB(255, 70, 140),
	Secret = Color3.fromRGB(120, 255, 235),
}

function Rarity.Color(name)
	return Rarity.Colors[name] or Rarity.Colors.Common
end

function Rarity.IsAtLeast(name, threshold)
	return (Rarity.Index[name] or 0) &gt;= (Rarity.Index[threshold] or 0)
end

-- Picks a rarity from a {Common = 70, Rare = 30, ...} weight map.
function Rarity.Roll(weights)
	local total = 0
	for _, weight in pairs(weights) do
		total += weight
	end
	if total &lt;= 0 then
		return "Common"
	end

	local roll = math.random() * total
	local cumulative = 0
	for _, name in ipairs(Rarity.Order) do
		local weight = weights[name]
		if weight and weight &gt; 0 then
			cumulative += weight
			if roll &lt;= cumulative then
				return name
			end
		end
	end
	return "Common"
end

return Rarity
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">Remotes</string><ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local IS_SERVER = RunService:IsServer()

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	if IS_SERVER then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	else
		folder = ReplicatedStorage:WaitForChild("Remotes")
	end
end

local function get(className, name)
	local existing = folder:FindFirstChild(name)
	if existing then
		return existing
	end
	if IS_SERVER then
		local instance = Instance.new(className)
		instance.Name = name
		instance.Parent = folder
		return instance
	end
	return folder:WaitForChild(name)
end

local Remotes = {}

function Remotes.Event(name)
	return get("RemoteEvent", name)
end

function Remotes.Function(name)
	return get("RemoteFunction", name)
end

return Remotes
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">RoadkillPass</string><ProtectedString name="Source">-- Roadkill at speed keeps the vehicle's momentum (Oliver 09-24: "make vehicles keep their momentum
-- when they do a roadkill").
--
-- Before this, a body in a vehicle's way was a solid part like any other. The machine that simulates
-- the vehicle (the driver's client for a player's car, the server for a bot's or an empty one) sees
-- someone else's character as a body it cannot shove (its owner keeps putting it back), so the car
-- stopped dead on it or ploughed on with the body dragged in front; a corpse on the road did the same;
-- and the sudden loss of speed was also scored as a crash on the car (VehicleService's
-- checkCollisionDamage).
--
-- Now, on whichever machine simulates the vehicle, every physics step BEFORE the simulation runs
-- (VehicleClient's drive loop, VehicleService's step):
--   * over FLOOR (VehicleService's roadkill floor), every body the vehicle's colliders are about to
--     reach this step -- or already touch -- is let through: NoCollisionConstraints between the body's
--     parts and this vehicle's colliders AND its riders' solid parts (a body let through the hull would
--     otherwise meet the driver inside it: measured, that alone cost a car 20-28% of its speed), for
--     PASS_SECONDS and after that until the body is clear.
--   * a live body costs the vehicle Toll of its flat speed (a few percent; less for the heavy ones),
--     its heading, vertical speed and spin untouched, and is reported as a hit (the server's roadkill:
--     damage, credit, the throw along the direction of travel).
--   * a dead one (a ragdoll) is let through for nothing: bodies are not speed bumps.
--   * at or under FLOOR nothing changes: the body collides as it always did, so you can nudge someone
--     with a car without hurting them.
-- The server lets the body through as well when it accepts a hit (its constraints reach every
-- machine, the victim's own included).

local RoadkillPass = {}
RoadkillPass.__index = RoadkillPass

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VehicleArmor = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("VehicleArmor"))

-- studs/s of flat speed; VehicleService's ROADKILL_FLOOR is this number (roadkill_check holds them equal).
RoadkillPass.FLOOR = 12
-- How long a body stays let through, at least; after it, until it is clear of the vehicle.
RoadkillPass.PASS_SECONDS = 1.5
-- A body is let through at the most this long however long it stays alongside.
RoadkillPass.PASS_MAX = 6
-- How far ahead the look reaches, in steps of the vehicle's travel, and the margin all round (studs):
-- enough that a body this step's travel reaches is let through before the contact, not after it.
RoadkillPass.LEAD_STEPS = 2.5
RoadkillPass.MARGIN = 0.6
-- The share of its flat speed a vehicle gives up to a body: a person is a few percent of a car's
-- weight, next to nothing to an armoured car's, and a real share of a bike's.
RoadkillPass.Tolls = { bike = 0.04, car = 0.025, armored = 0.01 }

function RoadkillPass.Toll(modelId, kind)
	local armor = VehicleArmor.Models[modelId]
	if armor and armor.cabin == "armored" then
		return RoadkillPass.Tolls.armored
	end
	return kind == "bike" and RoadkillPass.Tolls.bike or RoadkillPass.Tolls.car
end

-- The vehicle's velocity once it has gone through a body: the flat part short by `toll`, the vertical
-- as it was (the heading is the flat part's direction, which a scale leaves alone).
function RoadkillPass.After(velocity, toll)
	local keep = 1 - toll
	return Vector3.new(velocity.X * keep, velocity.Y, velocity.Z * keep)
end

-- Where a body goes when a vehicle doing `velocity` hits it: on along the direction of travel, off
-- to the side it was standing on (`offset`, from the vehicle's middle to the body), and up -- over the
-- bonnet and off the side, out of the vehicle's path, rather than on ahead of it to be run down again.
-- MovementClient caps a "blast" at 60 studs/s flat.
function RoadkillPass.Throw(velocity, offset)
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = flat.Magnitude
	if speed &lt; 1e-3 then
		return Vector3.new(0, 14, 0)
	end
	local along = flat / speed
	local side = Vector3.new(-along.Z, 0, along.X)
	local sign = (offset and offset.X * side.X + offset.Z * side.Z &lt; 0) and -1 or 1
	local forward = math.min(speed * 0.6, 40)
	local lateral = math.min(speed * 0.45, 26)
	local up = math.clamp(14 + speed * 0.35, 16, 40)
	return along * forward + side * (sign * lateral) + Vector3.new(0, up, 0)
end

-- The body a part belongs to (a model with a Humanoid), or nil.
function RoadkillPass.BodyOf(part)
	local model = part and part:FindFirstAncestorOfClass("Model")
	while model do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			return model, humanoid
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

-- One vehicle's state. `onHit(character, speed, velocity)` is told of each live body it goes through:
-- the flat speed and the velocity it had before the toll.
function RoadkillPass.new(model, chassis, onHit)
	local self = setmetatable({}, RoadkillPass)
	self.model = model
	self.chassis = chassis
	self.onHit = onHit
	self.passed = {}
	self.colliders = {}
	self.seats = {}
	local reach = 0
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("Seat") or part:IsA("VehicleSeat") then
			table.insert(self.seats, part)
		elseif part:IsA("BasePart") and part.CanCollide then
			table.insert(self.colliders, part)
			reach = math.max(reach, (part.Position - chassis.Position).Magnitude + part.Size.Magnitude / 2)
		end
	end
	self.reach = reach + 3
	self.toll = RoadkillPass.Toll(model:GetAttribute("VehicleModel"), model:GetAttribute("VehicleKind"))
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = false
	self.params = params
	self.lastVelocity = nil
	self.lastSpin = nil
	return self
end

function RoadkillPass:isRider(humanoid)
	for _, seat in ipairs(self.seats) do
		if seat.Occupant == humanoid then
			return true
		end
	end
	return false
end

-- Lets `character` through this vehicle (both ways: every limb against every collider and every
-- rider's solid part). Returns true the first time; again while it is through, only the time is extended.
function RoadkillPass:Pass(character, now)
	local pass = self.passed[character]
	if pass then
		pass.untilTime = math.max(pass.untilTime, now + RoadkillPass.PASS_SECONDS)
		return false
	end
	local mine = {}
	for _, collider in ipairs(self.colliders) do
		table.insert(mine, collider)
	end
	for _, seat in ipairs(self.seats) do
		local occupant = seat.Occupant
		local rider = occupant and occupant.Parent
		if rider and rider ~= character then
			for _, part in ipairs(rider:GetChildren()) do
				if part:IsA("BasePart") and part.CanCollide then
					table.insert(mine, part)
				end
			end
		end
	end
	local constraints = {}
	for _, part in ipairs(character:GetChildren()) do
		if part:IsA("BasePart") then
			for _, collider in ipairs(mine) do
				local constraint = Instance.new("NoCollisionConstraint")
				constraint.Name = "RoadkillPass"
				constraint.Part0 = collider
				constraint.Part1 = part
				constraint.Parent = self.chassis
				table.insert(constraints, constraint)
			end
		end
	end
	self.passed[character] = { since = now, untilTime = now + RoadkillPass.PASS_SECONDS, constraints = constraints }
	return true
end

local function release(pass)
	for _, constraint in ipairs(pass.constraints) do
		constraint:Destroy()
	end
end

-- Collisions back on for every body whose time is up and that is clear of the vehicle.
function RoadkillPass:expire(now)
	for character, pass in pairs(self.passed) do
		local done = character.Parent == nil or now - pass.since &gt; RoadkillPass.PASS_MAX
		if not done and now &gt;= pass.untilTime then
			local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
			done = root == nil or (root.Position - self.chassis.Position).Magnitude &gt; self.reach
		end
		if done then
			release(pass)
			self.passed[character] = nil
		end
	end
end

-- The bodies within the look-ahead of the colliders this step: { [character] = humanoid }.
function RoadkillPass:bodiesAhead(velocity, dt)
	local filter = { self.model }
	for _, seat in ipairs(self.seats) do
		local occupant = seat.Occupant
		if occupant and occupant.Parent then
			table.insert(filter, occupant.Parent)
		end
	end
	self.params.FilterDescendantsInstances = filter
	local lead = velocity * (dt * RoadkillPass.LEAD_STEPS)
	local margin = RoadkillPass.MARGIN * 2
	local found = {}
	for _, collider in ipairs(self.colliders) do
		if collider.Parent then
			local frame = collider.CFrame
			local localLead = frame:VectorToObjectSpace(lead)
			local size = collider.Size + Vector3.new(math.abs(localLead.X) + margin, math.abs(localLead.Y) + margin,
				math.abs(localLead.Z) + margin)
			for _, part in ipairs(workspace:GetPartBoundsInBox(frame + lead / 2, size, self.params)) do
				local character, humanoid = RoadkillPass.BodyOf(part)
				if character and not found[character] and not self:isRider(humanoid) then
					found[character] = humanoid
				end
			end
		end
	end
	return found
end

-- The step: call before the physics simulates it. Returns how many live bodies it went through.
function RoadkillPass:Sweep(dt, now)
	local chassis = self.chassis
	self:expire(now)
	local velocity = chassis.AssemblyLinearVelocity
	local spin = chassis.AssemblyAngularVelocity
	local lastVelocity, lastSpin = self.lastVelocity, self.lastSpin
	self.lastVelocity, self.lastSpin = velocity, spin
	local flat = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	if flat &lt;= RoadkillPass.FLOOR then
		return 0
	end
	local hits = 0
	for character, humanoid in pairs(self:bodiesAhead(velocity, dt)) do
		if self:Pass(character, now) and humanoid.Health &gt; 0 then
			hits += 1
			-- A body that came in from the side already touched last step: what that cost is given back.
			local lastFlat = lastVelocity and Vector3.new(lastVelocity.X, 0, lastVelocity.Z).Magnitude or 0
			if lastFlat &gt; flat + 1 then
				velocity, spin = lastVelocity, lastSpin
				flat = lastFlat
			end
			if self.onHit then
				self.onHit(character, flat, velocity)
			end
			velocity = RoadkillPass.After(velocity, self.toll)
			flat = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		end
	end
	if hits &gt; 0 then
		chassis.AssemblyLinearVelocity = velocity
		chassis.AssemblyAngularVelocity = spin
		self.lastVelocity, self.lastSpin = velocity, spin
	end
	return hits
end

function RoadkillPass:Destroy()
	for character, pass in pairs(self.passed) do
		release(pass)
		self.passed[character] = nil
	end
end

return RoadkillPass
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">SafeValue</string><ProtectedString name="Source">-- Checks for values that arrive from a client. A RemoteEvent argument is whatever a modified client
-- chooses to send, and the dangerous numbers slip past the obvious tests:
--
--   * NaN fails every comparison, so `math.abs(v) &gt; limit` and `v.Magnitude &gt; limit` are both FALSE
--     for it: a size check alone lets it straight through. Only `v == v` catches it.
--   * Infinity passes `v == v`, then turns into NaN the moment it meets `.Unit`, `limit / v` or `0 * v`.
--
-- So every component is tested on its own, for NaN and for size. A value that fails must be refused
-- (or replaced with a server-chosen default) before it reaches physics, a raycast or a broadcast.
--
--   SafeValue.Number(n, limit)    a real number within +-limit
--   SafeValue.Vector3(v, limit)   a Vector3 whose X, Y and Z all pass Number
--
-- `limit` defaults to 1e6, far beyond any map coordinate and far below where float precision fails.

local SafeValue = {}

SafeValue.DefaultLimit = 1e6

function SafeValue.Number(n, limit)
	return type(n) == "number" and n == n and math.abs(n) &lt;= (limit or SafeValue.DefaultLimit)
end

function SafeValue.Vector3(v, limit)
	if typeof(v) ~= "Vector3" then
		return false
	end
	limit = limit or SafeValue.DefaultLimit
	local x, y, z = v.X, v.Y, v.Z
	return x == x and y == y and z == z and math.abs(x) &lt;= limit and math.abs(y) &lt;= limit and math.abs(z) &lt;= limit
end

return SafeValue
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">ShopRotation</string><ProtectedString name="Source">-- The shop's rotating stock.
--
-- Every five minutes a new selection of cosmetics goes on sale and a new set of crates can be
-- bought. It's the same on every server and every client: each rotation is drawn with a Random
-- seeded from the rotation number, and the rotation number comes from the shared server clock
-- (workspace:GetServerTimeNow), so nobody needs to be told what's in stock.
--
-- Rarer things turn up less often. Cosmetic slots are filled by weighted draws — a Common is a
-- hundred times as likely to be picked as a Legendary — and each crate has its own chance of
-- being in stock at all. Only buying is limited: crates you own can always be opened, and
-- cosmetics you own can always be equipped.

local CosmeticData = require(script.Parent:WaitForChild("CosmeticData"))
local CrateData = require(script.Parent:WaitForChild("CrateData"))

local ShopRotation = {}

ShopRotation.RotationSeconds = 300

-- How many of each kind of cosmetic are on sale per rotation, in the order they're drawn. The
-- order matters: every client has to make the same draws in the same sequence.
ShopRotation.Slots = {
	{ kind = "GunSkin", count = 3 },
	{ kind = "Aura", count = 2 },
	{ kind = "Accessory", count = 4 },
}

-- How likely an item of each rarity is to fill a slot, relative to the others.
ShopRotation.RarityWeight = { Common = 100, Uncommon = 55, Rare = 25, Epic = 9, Legendary = 1, Mythic = 0.4, Secret = 0.1 }

-- Chance each crate is buyable in a given rotation. The two crates that pay out mostly Legendary
-- and up are the hardest to catch on the shelf.
ShopRotation.CrateChance = {
	Common = 1, Uncommon = 1, Rare = 0.85, Epic = 0.6, Legendary = 0.25, Mythic = 0.1,
	Accessory = 0.7, Skin = 0.75, Aura = 0.5, Parachute = 0.5,
	-- The Death Effect Crate (2026-09-24). Drawn last in CrateData.Order, so its roll comes after
	-- every other crate's in each rotation and theirs are exactly as they were.
	DeathEffect = 0.5,
	-- Sold for Robux, so it's never out of stock.
	Super = 1,
}

local function serverNow()
	local ok, time = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	return ok and time or os.time()
end

function ShopRotation.Window(at)
	return math.floor((at or serverNow()) / ShopRotation.RotationSeconds)
end

function ShopRotation.SecondsLeft(at)
	local time = at or serverNow()
	return ShopRotation.RotationSeconds - (time % ShopRotation.RotationSeconds)
end

-- Parachutes on sale per rotation. They're drawn after everything else, from a Random of their
-- own, so adding them (2026-09-17) left every rotation's skins, auras, accessories and crates
-- exactly as they were. tools/parachute_shop_probe.lua checks that against the old draw.
ShopRotation.ParachuteSlots = 2

-- Death effects (kind "KillAnimation") on sale per rotation (#24, 2026-09-24). Drawn last, from a
-- Random of their own, for the same reason as the parachutes: every earlier draw in every rotation
-- stays as it was. Four of the eleven buyable ones at a time, so the Death Effects tab always has a
-- real choice without the whole range being on the shelf at once.
ShopRotation.KillAnimationSlots = 4

local cached = nil

-- `count` weighted draws, without repeats, from the buyable cosmetics of `kind`, marked in `into`.
local function drawCosmetics(random, kind, count, into)
	local pool = {}
	for _, id in ipairs(CosmeticData.OfKind(kind, true)) do
		local item = CosmeticData.Get(id)
		if item.price then
			table.insert(pool, { id = id, weight = ShopRotation.RarityWeight[item.rarity] or 1 })
		end
	end
	for _ = 1, math.min(count, #pool) do
		local total = 0
		for _, entry in ipairs(pool) do
			total += entry.weight
		end
		local roll = random:NextNumber() * total
		for index, entry in ipairs(pool) do
			roll -= entry.weight
			if roll &lt;= 0 or index == #pool then
				into[entry.id] = true
				table.remove(pool, index)
				break
			end
		end
	end
end

local function stockFor(window)
	if cached and cached.window == window then
		return cached
	end
	local random = Random.new(window * 7919 + 17)

	local cosmetics = {}
	for _, slot in ipairs(ShopRotation.Slots) do
		drawCosmetics(random, slot.kind, slot.count, cosmetics)
	end

	local crates = {}
	for _, id in ipairs(CrateData.Order) do
		crates[id] = random:NextNumber() &lt; (ShopRotation.CrateChance[id] or 1)
	end
	-- There's always something to buy.
	crates.Common = true
	crates.Super = true

	drawCosmetics(Random.new(window * 6311 + 29), "Parachute", ShopRotation.ParachuteSlots, cosmetics)
	drawCosmetics(Random.new(window * 4513 + 41), "KillAnimation", ShopRotation.KillAnimationSlots, cosmetics)

	cached = { window = window, cosmetics = cosmetics, crates = crates }
	return cached
end

function ShopRotation.IsCosmeticInStock(id, at)
	return stockFor(ShopRotation.Window(at)).cosmetics[id] == true
end

function ShopRotation.IsCrateInStock(id, at)
	return stockFor(ShopRotation.Window(at)).crates[id] == true
end

-- "3:42" until the next rotation.
function ShopRotation.FormatTimeLeft(at)
	local seconds = math.max(0, math.floor(ShopRotation.SecondsLeft(at)))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

return ShopRotation
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX53"><Properties><string name="Name">SoundConfig</string><ProtectedString name="Source">-- Audio cues.
--
-- There is no uploaded audio in this project, so every cue is built out of the sound files the
-- Roblox client itself ships, under `rbxasset://sounds/`. `tools/sound_probe.lua` loads each
-- candidate and reads its length back, which is how this list is known rather than guessed —
-- an earlier version of this file believed only eleven files survived and pointed two cues at
-- paths that no longer existed, so they silently played nothing. Twenty-three resolve today:
--
--   action_falling 10.00  action_footsteps_plastic 2.48  action_get_up 0.57  action_jump 0.34
--   action_jump_land 0.26  action_swim 4.88  impact_explosion_02 2.12  impact_explosion_03 2.59
--   impact_water 2.38  oof 0.33  ouch 0.33  volume_slider 0.85  electronicpingshort 0.72
--   switch 0.24  switch3 0.37  bass 1.01  clickfast 0.29  metal 0.60  snap 0.42  hit 0.84
--   button 0.58  collide 1.20  uuhhh 0.33
--
-- A cue is a recipe, not a file: `layers` stack several of those sources at their own pitch,
-- volume and start delay, and `effects` runs the result through Roblox's SoundEffect chain. That
-- is what turns a stock click into a gunshot with a transient and a body, or a mag change into
-- two distinct mechanical noises a beat apart. A single-file cue can still be written the old
-- way with `id`.
--
-- To use real audio instead, put a Creator Marketplace id ("rbxassetid://123456") in a layer's
-- `id` and drop the extra layers; nothing outside this file needs to change. `maxDistance` only
-- applies to positional playback (Sfx.PlayAt), which is how you hear other people's gunfire.
-- How distance, travel time and indoors/outdoors change a cue is in the Acoustics section at the
-- bottom (#120); `tools/sound_acoustics_check.py` holds it to its rules.

local SoundConfig = {}

local FALL = "rbxasset://sounds/action_falling.mp3"
local STEPS = "rbxasset://sounds/action_footsteps_plastic.mp3"
local GETUP = "rbxasset://sounds/action_get_up.mp3"
local JUMP = "rbxasset://sounds/action_jump.mp3"
local LAND = "rbxasset://sounds/action_jump_land.mp3"
local SWIM = "rbxasset://sounds/action_swim.mp3"
local BOOM2 = "rbxasset://sounds/impact_explosion_02.mp3"
local BOOM3 = "rbxasset://sounds/impact_explosion_03.mp3"
local WATER = "rbxasset://sounds/impact_water.mp3"
local OOF = "rbxasset://sounds/oof.ogg"
local OUCH = "rbxasset://sounds/ouch.ogg"
local SLIDER = "rbxasset://sounds/volume_slider.ogg"
local PING = "rbxasset://sounds/electronicpingshort.wav"
local SWITCH = "rbxasset://sounds/switch.wav"
local SWITCH3 = "rbxasset://sounds/switch3.wav"
local BASS = "rbxasset://sounds/bass.wav"
local CLICK = "rbxasset://sounds/clickfast.wav"
local METAL = "rbxasset://sounds/metal.ogg"
local SNAP = "rbxasset://sounds/snap.mp3"
local HIT = "rbxasset://sounds/hit.wav"
local BUTTON = "rbxasset://sounds/button.wav"
local COLLIDE = "rbxasset://sounds/collide.wav"
local UUH = "rbxasset://sounds/uuhhh.mp3"

-- `category` picks the volume slider in Settings that controls the cue: Weapons, Effects or
-- Interface (each also scaled by Master).
SoundConfig.Sounds = {
	--------------------------------------------------------------------------------
	-- Guns
	--------------------------------------------------------------------------------

	-- A shot is a crack and a body: a sharp transient off the top of `snap`, then a short burst
	-- of explosion under it for weight. Compressed so it stays punchy at a distance, with enough
	-- distortion to give it teeth without turning to mush.
	-- UNUSED: nothing plays "Gunshot" any more. Every gun plays a family report below
	-- (CombatClient's SHOT_CUE / SHOT_CUE_BY_ID), and the fallback for an unmapped gun is
	-- GunshotRifle. Kept as the original recipe for reference.
	Gunshot = {
		volume = 0.34,
		pitch = 1,
		maxDistance = 420,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 1, pitch = 1.45 },
			{ id = BOOM2, volume = 0.55, pitch = 2.4 },
			{ id = CLICK, volume = 0.35, pitch = 0.8, delay = 0.02 },
		},
		effects = {
			{ "DistortionSoundEffect", { Level = 0.16 } },
			{ "CompressorSoundEffect", { Threshold = -22, Ratio = 5, Attack = 0.002, Release = 0.12 } },
		},
	},

	-- Your shot landed: a short high tick, deliberately thin so it cuts through the shot itself.
	HitConfirm = {
		volume = 0.5,
		pitch = 1,
		category = "Weapons",
		layers = {
			{ id = CLICK, volume = 1, pitch = 1.9 },
			{ id = SWITCH, volume = 0.5, pitch = 1.6 },
		},
	},

	-- A headshot, for the shooter: the hit tick with a bell over it so it reads as better.
	Headshot = {
		volume = 0.62,
		pitch = 1,
		category = "Weapons",
		layers = {
			{ id = PING, volume = 1, pitch = 1.75 },
			{ id = CLICK, volume = 0.6, pitch = 2 },
		},
		effects = { { "EqualizerSoundEffect", { HighGain = 6, MidGain = -2, LowGain = -14 } } },
	},

	-- The crack everyone near it hears on a headshot.
	HeadshotCrack = {
		volume = 0.5,
		pitch = 1,
		maxDistance = 300,
		category = "Weapons",
		layers = {
			{ id = HIT, volume = 1, pitch = 1.35 },
			{ id = SNAP, volume = 0.7, pitch = 1.7 },
		},
	},

	-- And what it sounds like from the wrong end.
	HeadshotTaken = {
		volume = 0.8,
		pitch = 1,
		category = "Weapons",
		layers = {
			{ id = OUCH, volume = 1, pitch = 0.82 },
			{ id = HIT, volume = 0.6, pitch = 0.7 },
		},
		effects = { { "EqualizerSoundEffect", { LowGain = 6, MidGain = 0, HighGain = -6 } } },
	},

	-- A magazine change: the catch, then the fresh mag seating a beat later.
	Reload = {
		volume = 0.55,
		pitch = 1,
		category = "Weapons",
		layers = {
			{ id = SWITCH, volume = 1, pitch = 0.85 },
			{ id = METAL, volume = 0.7, pitch = 1.3, delay = 0.14 },
			{ id = CLICK, volume = 0.8, pitch = 0.75, delay = 0.3 },
		},
	},

	-- Each kind of gun's report. Every one is built from the same four jobs, weighted differently so
	-- the families are told apart by ear -- positionally, that's how you know what is shooting at you:
	--   crack  the transient: `snap` pitched up (higher = smaller, snappier gun), with `hit` or `click`
	--          under it for a punchier edge;
	--   body   an explosion file pitched up hard. PlaybackSpeed shortens as well as raises it, so the
	--          pitch sets how long the boom lasts: ~3x is a pistol's pop, ~1x a cannon's roll;
	--   weight `bass` -- how much chest the shot has;
	--   tail   reverb, or a late quiet layer, for the big guns that should ring out.
	-- Rapid-fire families (SMG, rotary) keep short bodies and less low end so a long burst stays a
	-- rattle instead of turning to mush; single-shot heavies get the longest tails.
	GunshotPistol = {
		-- Crisp and dry: a bright crack, a short pop of body, almost no tail.
		volume = 0.34,
		pitch = 1,
		maxDistance = 360,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 1, pitch = 1.75 },
			{ id = HIT, volume = 0.35, pitch = 1.6 },
			{ id = BOOM2, volume = 0.35, pitch = 3.0 },
		},
		effects = {
			{ "DistortionSoundEffect", { Level = 0.12 } },
			{ "CompressorSoundEffect", { Threshold = -22, Ratio = 5, Attack = 0.002, Release = 0.08 } },
			{ "EqualizerSoundEffect", { LowGain = -3, MidGain = 1, HighGain = 3 } },
		},
	},
	-- The SMGs: the lightest, shortest report in the game, so 11-14 rounds a second reads as a
	-- chatter rather than a smear.
	GunshotSMG = {
		volume = 0.32,
		pitch = 1,
		maxDistance = 320,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 0.9, pitch = 1.95 },
			{ id = CLICK, volume = 0.35, pitch = 1.5 },
			{ id = BOOM2, volume = 0.28, pitch = 3.4 },
		},
		effects = {
			{ "CompressorSoundEffect", { Threshold = -22, Ratio = 5, Attack = 0.002, Release = 0.06 } },
			{ "EqualizerSoundEffect", { LowGain = -6, MidGain = 0, HighGain = 2 } },
		},
	},
	-- A revolver is a big round from a short barrel: a hand-cannon boom with a short room ring.
	GunshotRevolver = {
		volume = 0.4,
		pitch = 1,
		maxDistance = 420,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 1, pitch = 1.25 },
			{ id = BOOM2, volume = 0.7, pitch = 1.9 },
			{ id = BASS, volume = 0.45, pitch = 1.7 },
		},
		effects = {
			{ "DistortionSoundEffect", { Level = 0.18 } },
			{ "ReverbSoundEffect", { DecayTime = 0.9, WetLevel = -13, DryLevel = 0 } },
		},
	},
	GunshotRifle = {
		-- Crack plus a mid body and a little chest, and a faint metallic ring off the receiver.
		volume = 0.36,
		pitch = 1,
		maxDistance = 460,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 1, pitch = 1.4, crack = true },
			{ id = BOOM2, volume = 0.65, pitch = 2.2 },
			{ id = BASS, volume = 0.35, pitch = 2.4 },
			{ id = METAL, volume = 0.12, pitch = 2.6, delay = 0.02 },
			-- Out in the open the report comes back off the terrain a quarter of a second later.
			{ id = BOOM3, volume = 0.12, pitch = 0.95, delay = 0.25, where = "outdoor" },
		},
		effects = {
			{ "DistortionSoundEffect", { Level = 0.2 } },
			{ "CompressorSoundEffect", { Threshold = -22, Ratio = 5, Attack = 0.002, Release = 0.12 } },
		},
	},
	-- A battle-rifle round from a long barrel: more body than a rifle, a room-sized tail.
	GunshotDMR = {
		volume = 0.4,
		pitch = 1,
		maxDistance = 620,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 1, pitch = 1.2, crack = true },
			{ id = BOOM2, volume = 0.8, pitch = 1.7 },
			{ id = BASS, volume = 0.5, pitch = 1.5 },
			{ id = BOOM3, volume = 0.18, pitch = 0.8, delay = 0.3, where = "outdoor" },
		},
		effects = {
			{ "DistortionSoundEffect", { Level = 0.2 } },
			{ "ReverbSoundEffect", { DecayTime = 1.3, WetLevel = -10, DryLevel = 0 } },
		},
	},
	-- Belt-fed: a rifle's crack over more weight, dirtier, for long bursts at a steadier rate.
	GunshotLMG = {
		volume = 0.38,
		pitch = 1,
		maxDistance = 520,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 0.95, pitch = 1.3, crack = true },
			{ id = BOOM2, volume = 0.7, pitch = 1.9 },
			{ id = BASS, volume = 0.45, pitch = 1.9 },
		},
		effects = {
			{ "DistortionSoundEffect", { Level = 0.26 } },
			{ "CompressorSoundEffect", { Threshold = -21, Ratio = 5, Attack = 0.002, Release = 0.1 } },
		},
	},
	-- Squeezing the trigger on an empty gun: the hammer or striker falling on nothing.
	DryFire = {
		volume = 0.5,
		pitch = 1,
		category = "Weapons",
		layers = {
			{ id = CLICK, volume = 0.9, pitch = 1.25 },
			{ id = SWITCH, volume = 0.3, pitch = 1.9 },
		},
	},
	GunshotHeavy = {
		-- The chaingun at 13 a second: each shot short and tight so the stream is a buzz-saw roar, the
		-- weight carried by the bass rather than a long body, the top end shaved so it doesn't tire you.
		volume = 0.34,
		pitch = 1,
		maxDistance = 500,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 0.85, pitch = 1.3, crack = true },
			{ id = BOOM2, volume = 0.5, pitch = 2.8 },
			{ id = BASS, volume = 0.4, pitch = 2.6 },
		},
		effects = {
			{ "DistortionSoundEffect", { Level = 0.28 } },
			{ "EqualizerSoundEffect", { LowGain = 2, MidGain = 0, HighGain = -2 } },
		},
	},
	GunshotShotgun = {
		-- Mostly boom: a wide explosion body, a lower crack, a thump of bass and a short room tail.
		-- Pitched lower than any rifle: a 12-bore's muzzle blast comes out of a wide bore at low
		-- pressure, so its energy sits an octave or so under a rifle's, and the shot is subsonic, so
		-- there is no separate crack.
		volume = 0.42,
		pitch = 1,
		maxDistance = 440,
		category = "Weapons",
		layers = {
			{ id = BOOM3, volume = 1, pitch = 1.45 },
			{ id = SNAP, volume = 0.75, pitch = 0.85 },
			{ id = BASS, volume = 0.7, pitch = 1.1 },
			{ id = COLLIDE, volume = 0.25, pitch = 1.6 },
		},
		effects = {
			{ "DistortionSoundEffect", { Level = 0.26 } },
			{ "CompressorSoundEffect", { Threshold = -20, Ratio = 6, Attack = 0.003, Release = 0.18 } },
			{ "ReverbSoundEffect", { DecayTime = 0.7, WetLevel = -16, DryLevel = 0 } },
		},
	},
	GunshotSniper = {
		-- The loudest single crack in the game, a heavy body, and a long outdoor roll: a quiet, slow
		-- second explosion a beat later, under a long reverb, so it is heard across the map.
		volume = 0.44,
		pitch = 1,
		maxDistance = 800,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 1, pitch = 1.1, crack = true },
			{ id = BOOM2, volume = 0.95, pitch = 1.4 },
			{ id = BASS, volume = 0.7, pitch = 1.0 },
			-- Outdoors the roll is the terrain answering: a slow second boom, then a fainter echo
			-- off something further away. Indoors the room reverb below replaces both.
			{ id = BOOM3, volume = 0.3, pitch = 0.9, delay = 0.08, where = "outdoor" },
			{ id = BOOM3, volume = 0.2, pitch = 0.7, delay = 0.5, where = "outdoor" },
		},
		effects = {
			{ "DistortionSoundEffect", { Level = 0.18 } },
			{ "ReverbSoundEffect", { DecayTime = 1.6, WetLevel = -6, DryLevel = 0 } },
		},
	},
	GunshotSuppressed = {
		-- A cough, not a crack: a thin high tick, the action cycling, a hiss of gas; lows cut.
		acoustic = "suppressed",
		volume = 0.38,
		pitch = 1,
		maxDistance = 140,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 0.35, pitch = 2.9 },
			{ id = CLICK, volume = 0.55, pitch = 1.4 },
			{ id = SLIDER, volume = 0.18, pitch = 2.6 },
			{ id = BUTTON, volume = 0.2, pitch = 1.2 },
		},
		effects = { { "EqualizerSoundEffect", { LowGain = -12, MidGain = -3, HighGain = -2 } } },
	},
	GunshotRocket = {
		-- A launch, not a bang: a deep whoomp out of the tube, the motor's whoosh, a thump and a tail.
		volume = 0.46,
		pitch = 1,
		maxDistance = 650,
		category = "Weapons",
		layers = {
			{ id = BOOM3, volume = 0.8, pitch = 1.2 },
			{ id = JUMP, volume = 0.85, pitch = 0.5 },
			{ id = FALL, volume = 0.3, pitch = 2.2 },
			{ id = BASS, volume = 0.65, pitch = 0.8 },
		},
		effects = { { "ReverbSoundEffect", { DecayTime = 1.4, WetLevel = -9, DryLevel = 0 } } },
	},
	GunshotRail = {
		-- Electric: a descending ping, a hard bright crack, a zip of charge, flanged so it shimmers.
		acoustic = "energy",
		volume = 0.44,
		pitch = 1,
		maxDistance = 700,
		category = "Weapons",
		layers = {
			{ id = PING, volume = 0.85, pitch = 0.4 },
			{ id = SNAP, volume = 0.6, pitch = 2.3 },
			{ id = BASS, volume = 0.55, pitch = 2.0 },
			{ id = BOOM2, volume = 0.3, pitch = 3.0 },
			{ id = SLIDER, volume = 0.15, pitch = 3.0 },
		},
		effects = {
			{ "FlangeSoundEffect", { Depth = 0.6, Mix = 0.45, Rate = 9 } },
			{ "EqualizerSoundEffect", { LowGain = 0, MidGain = 0, HighGain = 3 } },
		},
	},
	GunshotBubble = {
		-- A pop and a blub: a tiny high snap, water, a springy bounce, a soft click, chorused wet.
		volume = 0.4,
		pitch = 1,
		maxDistance = 220,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 0.3, pitch = 3.3 },
			{ id = WATER, volume = 0.55, pitch = 2.5 },
			{ id = JUMP, volume = 0.35, pitch = 2.1 },
			{ id = BUTTON, volume = 0.25, pitch = 2.0 },
		},
		effects = { { "ChorusSoundEffect", { Depth = 0.2, Mix = 0.4, Rate = 3 } } },
	},
	GunshotCrossbow = {
		-- A twang: a slow low snap for the string, a buzz as it settles, the thunk of the stock.
		-- A bow has no muzzle blast, so it carries like a suppressed gun, not a loud one.
		acoustic = "suppressed",
		volume = 0.45,
		pitch = 1,
		maxDistance = 160,
		category = "Weapons",
		layers = {
			{ id = SNAP, volume = 0.95, pitch = 0.55 },
			{ id = SLIDER, volume = 0.35, pitch = 0.75, delay = 0.02 },
			{ id = COLLIDE, volume = 0.35, pitch = 2.1 },
		},
		effects = { { "EqualizerSoundEffect", { LowGain = 3, MidGain = 0, HighGain = -2 } } },
	},
	GunshotCannon = {
		-- The biggest report there is: a slow full-length explosion, a low crack, heavy bass, a second
		-- boom a beat behind for the muzzle blast, and a long tail.
		volume = 0.48,
		pitch = 1,
