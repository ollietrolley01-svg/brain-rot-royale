		crateOnly = true,
		color = Color3.fromRGB(110, 200, 70),
		description = "Crate exclusive. A funnel of rot spins them up into the sky and pops.",
	},
	KillMeteorStrike = {
		name = "Brainrot Meteor",
		kind = "KillAnimation",
		rarity = "Mythic",
		crateOnly = true,
		color = Color3.fromRGB(255, 110, 20),
		description = "Crate exclusive. A burning meteor. A crater. Rocks. Overkill.",
	},
	KillBlackHole = {
		name = "Rot Singularity",
		kind = "KillAnimation",
		rarity = "Secret",
		crateOnly = true,
		color = Color3.fromRGB(150, 70, 255),
		description = "Crate exclusive. A black hole opens, swallows them whole, and goes off like a star.",
	},
}

for id, item in pairs(CosmeticData.Items) do
	item.id = id
end

function CosmeticData.Get(id)
	return CosmeticData.Items[id]
end

-- Sorted ids of one kind. Bundle exclusives, rank rewards and team-mode rewards are never included, since
-- nothing but a bundle, progression or team wins hands them out; `excludeCrateOnly` also leaves out the
-- crate exclusives.
function CosmeticData.OfKind(kind, excludeCrateOnly)
	local ids = {}
	for id, item in pairs(CosmeticData.Items) do
		if item.kind == kind and not item.bundleOnly and not item.rankOnly and not item.teamOnly
			and not (excludeCrateOnly and item.crateOnly) then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	return ids
end

return CosmeticData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">CosmeticPreview</string><ProtectedString name="Source">-- A live preview of any cosmetic, built from the same modules that put it on a player.
--
--   local handle = CosmeticPreview.Fill(frame, "CrownOfRot")   -- fills the frame you hand it
--   handle:Destroy()                                           -- or CosmeticPreview.Release(frame)
--
-- The caller owns layout: Fill reads the frame it is given and sizes itself to it, at 72 px or 102 px
-- or larger, and re-frames if that frame changes size. Nothing is positioned here.
--
-- What each kind shows:
--   Accessory  the real pieces, through Shared/CosmeticBuild, so it is the geometry a wearer gets
--   Parachute  the canopy, through Shared/ParachuteModels, the same build the drop-in opens
--   GunSkin    a pistol wearing the skin's colour and material, since a skin recolours any gun
--   Aura       an orb of the aura's colour with specks drifting round it, because a ViewportFrame
--              renders neither particles nor lights, and an aura is both
--   KillAnimation (a death effect) the real effect, LOOPING on a stand-in body: the same design from
--              Shared/DeathEffectDesigns the game plays, on the same engine (DeathEffectFx) in its
--              preview mode, where particles become little neon sparks and lights are left to the
--              flash parts. Model() gives it frozen at its peak; Fill() plays it. A row preview steps
--              twelve times a second and not at all while scrolled out of sight; the Death Effects
--              stage (`options.stage`) steps every frame and can play its sounds (`options.sound`) on
--              the first loop after a PREVIEW press
--
-- Two costs are managed here. Designs are built once and cloned after, and a preview does not build
-- until its frame has been laid out -- at most one build per frame, so opening a page of twenty rows
-- spreads the work rather than hitching on the first draw.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CosmeticData = require(Shared:WaitForChild("CosmeticData"))

local CosmeticPreview = {}

-- The design modules are loaded the first time a preview of that kind is asked for, not on require:
-- a page showing only accessories should not pay for the gun builder. A module that fails to load
-- costs its own kind its preview, not the page.
local loaded = {}
local function soft(name)
	if loaded[name] == nil then
		local ok, module = pcall(require, Shared:WaitForChild(name))
		if not ok then
			warn(string.format("[CosmeticPreview] %s previews are off: %s", name, tostring(module)))
		end
		loaded[name] = ok and module or false
	end
	return loaded[name] or nil
end

-- Compact, reads at 72 px, and a pistol is what a new player is holding anyway.
local SKIN_GUN = { "SahurPistol", "RotSMG" }

local FIELD_OF_VIEW = 32

--------------------------------------------------------------------------------
-- Building the models
--------------------------------------------------------------------------------

local function anchor(model)
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	return model
end

-- A ViewportFrame draws no particles and no light, so an aura is previewed as an orb with specks
-- around it. When a design declares `aura.layers`, the first layer picks the speck count, size and
-- direction, so a sinking cloud of heavy puffs does not preview identically to a fast spit of
-- needles. An aura with no layers gets exactly what it got before: seven specks of 0.22.
local function auraLook(item)
	local layer = item.aura and item.aura.layers and item.aura.layers[1]
	if not layer then
		return { count = 7, size = 0.22, rise = 1, spin = 0.9, color = item.color }
	end
	local speed = layer.speed and layer.speed[2] or 3
	return {
		count = math.clamp(math.floor((layer.rate or 14) / 3), 4, 12),
		size = math.clamp((layer.size or 0.55) * 0.4, 0.1, 0.4),
		rise = (layer.rise or 2.5) &gt;= 0 and 1 or -1,
		spin = math.clamp(speed / 3, 0.4, 2.4),
		color = layer.color or item.color,
	}
end

local function auraModel(item)
	local look = auraLook(item)
	local model = Instance.new("Model")
	model.Name = "Aura"

	local orb = Instance.new("Part")
	orb.Name = "Orb"
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.new(1.5, 1.5, 1.5)
	orb.CFrame = CFrame.new()
	orb.Color = item.color
	orb.Material = Enum.Material.Neon
	orb.Transparency = 0.25
	orb.Parent = model

	-- The specks the emitter would throw, as parts, since a ViewportFrame draws no particles. They are
	-- moved by the turn loop, which is also the only thing that makes an aura read as an aura. They
	-- start spread around the orb rather than stacked at one point, so a still of one -- a crate
	-- reveal's first frame, a render -- looks like an aura too.
	local SPECKS = look.count
	for index = 1, SPECKS do
		local speck = Instance.new("Part")
		speck.Name = "Speck" .. index
		speck.Shape = Enum.PartType.Ball
		speck.Size = Vector3.new(look.size, look.size, look.size)
		speck.Color = look.color
		speck.Material = Enum.Material.Neon
		speck.Transparency = 0.15
		local spin = index / SPECKS * math.pi * 2
		local rise = (index - 1) / SPECKS
		speck.CFrame = CFrame.new(math.cos(spin) * (0.95 - rise * 0.25), rise * 1.5 - 0.75, math.sin(spin) * (0.95 - rise * 0.25))
		speck.Parent = model
	end

	return anchor(model)
end

local function gunModel(item)
	local GunModels, WeaponData = soft("GunModels"), soft("WeaponData")
	if not (GunModels and WeaponData) then
		return nil
	end
	for _, id in ipairs(SKIN_GUN) do
		local def = WeaponData.Get(id)
		if def then
			-- detail = "world" skips the micro detail: it is a 72 px thumbnail, and the parts it drops
			-- are the ones too small to see at that size anyway.
			local ok, model = pcall(GunModels.Build, def, item.color, item.material or Enum.Material.SmoothPlastic,
				{ skinned = true, detail = "world" })
			if ok and model then
				model:PivotTo(CFrame.Angles(0, math.rad(-90), 0) * CFrame.Angles(math.rad(-8), 0, 0))
				return anchor(model)
			end
		end
	end
	return nil
end

-- Death effects: a pause with the body back on its feet between loops, and how often a row steps.
local DEATH_REST = 0.7
local ROW_STEP = 1 / 12

-- A stand-in body with death effect `id` built on it, stepped to `t`. Returns the model (the body and
-- the effect's folder) and the effect, or nil. `sound` is passed to the effect.
local function deathScene(id, t, sound)
	local DeathEffectFx, Designs = soft("DeathEffectFx"), soft("DeathEffectDesigns")
	local design = Designs and Designs.Get(id)
	if not (DeathEffectFx and design) then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = "DeathEffect"
	local dummy = DeathEffectFx.Dummy()
	dummy.Parent = model
	local fx = DeathEffectFx.new({
		parent = model,
		origin = DeathEffectFx.DummyRoot,
		ground = Vector3.zero,
		life = design.life,
		body = dummy,
		ownsBody = true,
		preview = true,
		seed = 7,
		sound = sound,
	})
	local ok, err = pcall(function()
		design.build(fx)
		fx:step(t or 0)
	end)
	if not ok then
		warn(string.format("[CosmeticPreview] %s failed to build: %s", tostring(id), tostring(err)))
		model:Destroy()
		return nil
	end
	return model, fx, design
end

local BUILDERS = {
	Accessory = function(id, item)
		local CosmeticBuild = soft("CosmeticBuild")
		if not CosmeticBuild then
			return nil
		end
		return anchor((CosmeticBuild.Model(item, CFrame.new(), 1, id)))
	end,
	Parachute = function(id)
		local ParachuteModels = soft("ParachuteModels")
		if not ParachuteModels then
			return nil
		end
		local ok, model = pcall(ParachuteModels.Build, id, { scale = ParachuteModels.WornScale })
		if not ok or not model then
			return nil
		end
		return anchor(model)
	end,
	GunSkin = function(_, item)
		return gunModel(item)
	end,
	Aura = function(_, item)
		return auraModel(item)
	end,
	-- Frozen at its peak (the burst): a still of the moment it is sold on.
	KillAnimation = function(id)
		local DeathEffectFx, Designs = soft("DeathEffectFx"), soft("DeathEffectDesigns")
		local design = DeathEffectFx and Designs and Designs.Get(id)
		if not design then
			return nil
		end
		return (deathScene(id, design.peak))
	end,
}

local templates = {}

-- The design itself, built once per id and kept. Auras are never cached: each one animates its own
-- specks, and a clone would share nothing but trouble.
local function templateFor(id)
	local item = CosmeticData.Get(id)
	if not item then
		return nil, nil
	end
	local builder = BUILDERS[item.kind]
	if not builder then
		return nil, item
	end
	if item.kind == "Aura" then
		return builder(id, item), item
	end
	local template = templates[id]
	if template == nil then
		local ok, built = pcall(builder, id, item)
		if not ok then
			warn(string.format("[CosmeticPreview] %s failed to build: %s", tostring(id), tostring(built)))
		end
		template = (ok and built) or false
		templates[id] = template
	end
	return template or nil, item
end

-- A fresh model of `id`, for callers placing it themselves (a crate reveal, a podium). Theirs to
-- parent, move and destroy.
function CosmeticPreview.Model(id)
	local template, item = templateFor(id)
	if not template then
		return nil
	end
	-- An aura is built fresh each time, so it is already the caller's; everything else is the kept
	-- template and must be cloned.
	return item.kind == "Aura" and template or template:Clone()
end

--------------------------------------------------------------------------------
-- Filling a frame
--------------------------------------------------------------------------------

local live = {}
local byFrame = {}
local connection
local swingClock = 0

-- Far enough back that the whole model stays in frame through the turn: the bounding sphere, rather
-- than the box, because the box's width changes as it rotates and the sphere's does not.
local function frameCamera(preview)
	local model = preview.model
	if not model then
		return
	end
	local box, size = model:GetBoundingBox()
	local aspect = preview.viewport.AbsoluteSize.X / math.max(preview.viewport.AbsoluteSize.Y, 1)
	local radius = size.Magnitude / 2
	local half = math.tan(math.rad(FIELD_OF_VIEW / 2))
	local distance = radius / (half * math.min(1, aspect)) * 1.06
	-- The turn orbits this point, not the world origin: a back-anchored item is authored a third of a
	-- stud off centre, and orbiting the origin would swing it across the frame instead of turning it.
	preview.pivot = box.Position
	preview.base = CFrame.lookAt(box.Position + Vector3.new(0, radius * 0.35, -distance), box.Position)
	preview.camera.CFrame = preview.base
end

-- The camera for a death effect: the design's own `view` (a focus and a radius the whole effect fits
-- in), because the effect's bounding box changes every frame. A row is cropped tighter, so the body
-- reads at 72 px; the stage shows all of it.
local function frameDeath(preview)
	local view = preview.death.design.view or { focus = Vector3.new(0, 3.5, 0), radius = 8 }
	local aspect = preview.viewport.AbsoluteSize.X / math.max(preview.viewport.AbsoluteSize.Y, 1)
	local radius = view.radius * (preview.stage and 1 or 0.7)
	local half = math.tan(math.rad(FIELD_OF_VIEW / 2))
	local distance = radius / (half * math.min(1, aspect)) * 1.05
	preview.pivot = view.focus
	preview.base = CFrame.lookAt(view.focus + Vector3.new(0.45, 0.28, -0.85).Unit * distance, view.focus)
	preview.camera.CFrame = preview.base
end

-- (Re)starts a death effect's loop at `t`. The first loop after Fill may carry sound; later ones don't.
local function startDeath(preview, t)
	local death = preview.death
	if death and death.model then
		death.fx:destroy()
		death.model:Destroy()
	end
	local sound = nil
	if preview.sound and not preview.soundPlayed then
		preview.soundPlayed = true
		local play = preview.sound
		sound = function(cue, _, jitter)
			play(cue, jitter)
		end
	end
	local model, fx, design = deathScene(preview.id, t, sound)
	if not model then
		preview.death = nil
		return
	end
	model.Parent = preview.viewport
	preview.model = model
	preview.death = { model = model, fx = fx, design = design, t = t, acc = 0 }
end

-- Whether a frame is inside the window of the scrolling list it's in (rows scrolled away don't step).
local function onScreen(viewport)
	local list = viewport:FindFirstAncestorWhichIsA("ScrollingFrame")
	if not list then
		return true
	end
	local a, b = viewport.AbsolutePosition, list.AbsolutePosition
	local aSize, bSize = viewport.AbsoluteSize, list.AbsoluteSize
	return a.Y + aSize.Y &gt; b.Y and a.Y &lt; b.Y + bSize.Y and a.X + aSize.X &gt; b.X and a.X &lt; b.X + bSize.X
end

local function stepDeath(entry, dt)
	local death = entry.death
	if not death then
		return
	end
	death.acc += dt
	if not entry.stage and (death.acc &lt; ROW_STEP or not onScreen(entry.viewport)) then
		return
	end
	death.t += death.acc
	death.acc = 0
	local life = death.design.life
	if death.t &gt;= life + DEATH_REST then
		startDeath(entry, 0)
	elseif death.t &gt;= life then
		if not death.rested then
			-- The effect is over: take it down, which puts the body back on its feet for the pause.
			death.rested = true
			death.fx:destroy()
		end
	else
		local ok, err = pcall(death.fx.step, death.fx, death.t)
		if not ok then
			warn(string.format("[CosmeticPreview] %s: %s", tostring(entry.id), tostring(err)))
			entry.death = nil
		end
	end
end

local function build(preview)
	local item = CosmeticData.Get(preview.id)
	if item and item.kind == "KillAnimation" then
		preview.built = true
		preview.specks = {}
		-- A row opens on the effect's peak so a page of them isn't a page of people standing still;
		-- the stage starts from the top, so the PREVIEW press plays it through.
		local design = soft("DeathEffectDesigns") and soft("DeathEffectDesigns").Get(preview.id)
		startDeath(preview, (not preview.stage and design) and design.peak or 0)
		if preview.death then
			frameDeath(preview)
		end
		return
	end
	local template
	template, item = templateFor(preview.id)
	preview.built = true
	if not template then
		return
	end
	local model = item.kind == "Aura" and template or template:Clone()
	model.Parent = preview.viewport
	preview.model = model
	preview.specks = {}
	if item.kind == "Aura" then
		preview.look = auraLook(item)
		for _, part in ipairs(model:GetChildren()) do
			if part.Name:match("^Speck") then
				table.insert(preview.specks, part)
			end
		end
	end
	frameCamera(preview)
end

-- Fills `frame` with a preview of the cosmetic `id`. Returns a handle with :Destroy(); the preview
-- also tears itself down if the frame leaves the tree, so a page that rebuilds its rows leaks nothing.
-- `options.background` sets the backdrop colour, `options.turn` how far it swings (0 for still).
-- Death effects only: `options.stage` steps every frame rather than twelve times a second, and
-- `options.sound(cue, pitchJitter)` plays the first loop's sounds.
function CosmeticPreview.Fill(frame, id, options)
	options = options or {}
	CosmeticPreview.Release(frame)

	local viewport = Instance.new("ViewportFrame")
	viewport.Name = "CosmeticPreview"
	viewport.Size = UDim2.fromScale(1, 1)
	viewport.BackgroundColor3 = options.background or Color3.fromRGB(28, 30, 38)
	viewport.BackgroundTransparency = options.backgroundTransparency or 0
	viewport.BorderSizePixel = 0
	viewport.Ambient = Color3.fromRGB(170, 170, 182)
	viewport.LightColor = Color3.fromRGB(255, 250, 240)
	viewport.LightDirection = Vector3.new(-0.4, -1, 0.6)
	viewport.ZIndex = frame.ZIndex

	local camera = Instance.new("Camera")
	camera.FieldOfView = FIELD_OF_VIEW
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	viewport.Parent = frame

	local preview = {
		id = id,
		frame = frame,
		viewport = viewport,
		camera = camera,
		turn = options.turn or 0.55,
		phase = #live * 0.9,
		stage = options.stage == true,
		sound = options.sound,
		base = CFrame.new(),
		built = false,
		size = Vector2.new(),
	}

	function preview:Destroy()
		for index = #live, 1, -1 do
			if live[index] == self then
				table.remove(live, index)
			end
		end
		if byFrame[self.frame] == self then
			byFrame[self.frame] = nil
		end
		if self.death then
			self.death.fx:destroy()
			self.death = nil
		end
		if self.viewport then
			self.viewport:Destroy()
			self.viewport = nil
		end
	end

	frame.AncestryChanged:Connect(function()
		if not frame:IsDescendantOf(game) then
			preview:Destroy()
		end
	end)

	table.insert(live, preview)
	byFrame[frame] = preview

	if not connection then
		connection = RunService.Heartbeat:Connect(function(dt)
			-- The swing's clock: frame time added up, not os.clock (CPU time in Roblox).
			swingClock += dt
			local now = swingClock
			local builtOne = false
			for index = #live, 1, -1 do
				local entry = live[index]
				if not entry.viewport or not entry.viewport:IsDescendantOf(game) then
					entry:Destroy()
				else
					local size = entry.viewport.AbsoluteSize
					if size.X &gt; 0 and size.Y &gt; 0 then
						-- One build per frame: twenty rows of real parts all at once is a visible hitch.
						if not entry.built and not builtOne then
							builtOne = true
							build(entry)
						elseif entry.built and (size - entry.size).Magnitude &gt; 0.5 then
							if entry.death then
								frameDeath(entry)
							else
								frameCamera(entry)
							end
						end
						stepDeath(entry, dt)
						entry.size = size

						if entry.model then
							if entry.turn &gt; 0 then
								local swing = math.sin(now * 0.6 + entry.phase) * entry.turn
								local pivot = entry.pivot or Vector3.zero
								entry.camera.CFrame = CFrame.new(pivot) * CFrame.Angles(0, swing, 0) * CFrame.new(-pivot) * entry.base
							end
							local look = entry.look
							for n, speck in ipairs(entry.specks) do
								local spin = now * (look and look.spin or 0.9) + n * (math.pi * 2 / #entry.specks)
								local rise = ((now * 0.35 + n * 0.17) % 1)
								if look and look.rise &lt; 0 then
									rise = 1 - rise
								end
								local radius = 0.95 - rise * 0.25
								speck.CFrame = CFrame.new(math.cos(spin) * radius, rise * 1.5 - 0.75, math.sin(spin) * radius)
								speck.Transparency = 0.15 + rise * 0.7
							end
						end
					end
				end
			end
		end)
	end

	return preview
end

-- Tears down whatever Fill put in `frame`.
function CosmeticPreview.Release(frame)
	local preview = byFrame[frame]
	if preview then
		preview:Destroy()
	end
end

return CosmeticPreview
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">CrateData</string><ProtectedString name="Source">-- Loot crates. Two families:
--
--   Brainrot crates  Common up to Legendary, then Mythic. Every crate rolls only within a window
--                    of four adjacent rarities around its own tier — the tier below it, itself
--                    and the two above (the ends of the ladder clamp) — so a Rare Crate is
--                    Uncommon to Legendary and nothing outside that, and the Legendary Crate is
--                    the first with any shot at Mythic and Secret. Brainrot crates can also pay
--                    out an accessory instead (`accessoryChance`, percent).
--   Item crates      Accessory, Gun Skin and Aura crates roll only that kind of cosmetic, and
--                    only ones you don't own yet. With nothing new left at the rolled rarity
--                    they refund `duplicateRefund` of the price instead, so they're never a waste.
--
-- `jackpot` is a chance of bonus SahurCoins on top of whatever the crate paid out.
-- `pity` is a guarantee: open `every` of that crate without rolling `rarity` or better and the
-- next one is forced to `rarity`. The counter is per player per crate and resets on any roll at
-- or above the guaranteed rarity, so a lucky pull doesn't stack with the guarantee.
-- Legendary and up are deliberately scarce: every crate that can roll them does so at low odds,
-- and the pity guarantees for those tiers are long, so they're a backstop rather than a schedule.
-- `productKey` points at a developer product in GamepassConfig so a crate can be bought with
-- Robux; the newer crates are coins-only. `robuxOnly` crates have no `coinPrice` at all.

local CrateData = {}

-- DeathEffect is last on purpose: ShopRotation rolls each crate's stock in this order from one Random,
-- so a crate added at the end leaves every earlier crate's stock in every rotation as it was.
CrateData.Order = { "Super", "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic",
	"Style", "DeluxeStyle", "PrestigeStyle", "Accessory", "Skin", "Aura", "Parachute", "DeathEffect" }

CrateData.Crates = {
	-- The best crate in the game, and the only one sold for Robux alone (no coin price): a Mythic
	-- or Secret brainrot every time, and more often than not a big coin jackpot on top. Always
	-- in stock.
	Super = {
		name = "Super Crate",
		category = "Brainrot",
		productKey = "CrateSuper",
		robuxOnly = true,
		color = Color3.fromRGB(255, 80, 230),
		odds = { Mythic = 90, Secret = 10 },
		jackpot = { chance = 0.6, min = 50000, max = 250000 },
		description = "Mythic or Secret every time, and a 60% chance of a 50K-250K jackpot.",
	},
	Common = {
		name = "Common Crate",
		category = "Brainrot",
		coinPrice = 500,
		productKey = "CrateCommon",
		accessoryChance = 6,
		odds = { Common = 62, Uncommon = 26, Rare = 9, Epic = 3 },
		pity = { every = 20, rarity = "Rare" },
		description = "Common to Epic, mostly the everyday kind.",
	},
	Uncommon = {
		name = "Uncommon Crate",
		category = "Brainrot",
		coinPrice = 1500,
		productKey = "CrateUncommon",
		accessoryChance = 8,
		odds = { Common = 30, Uncommon = 40, Rare = 22, Epic = 8 },
		pity = { every = 15, rarity = "Epic" },
		description = "Common to Epic, with real odds of a Rare.",
	},
	Rare = {
		name = "Rare Crate",
		category = "Brainrot",
		coinPrice = 5000,
		productKey = "CrateRare",
		accessoryChance = 10,
		odds = { Uncommon = 24, Rare = 45, Epic = 28, Legendary = 3 },
		pity = { every = 12, rarity = "Epic" },
		description = "Uncommon to Legendary, with a slim shot at a Legendary.",
	},
	Epic = {
		name = "Epic Crate",
		category = "Brainrot",
		coinPrice = 20000,
		productKey = "CrateEpic",
		accessoryChance = 14,
		odds = { Rare = 32, Epic = 54, Legendary = 12, Mythic = 2 },
		pity = { every = 25, rarity = "Legendary" },
		description = "Rare to Mythic. Nothing below a Rare, and a real shot at a Legendary.",
	},
	Legendary = {
		name = "Legendary Crate",
		category = "Brainrot",
		coinPrice = 75000,
		productKey = "CrateLegendary",
		accessoryChance = 18,
		odds = { Epic = 58, Legendary = 34, Mythic = 7, Secret = 1 },
		jackpot = { chance = 0.25, min = 5000, max = 25000 },
		pity = { every = 40, rarity = "Mythic" },
		description = "Epic to Secret: plenty of Legendaries, a small shot at Mythic, and a 25% coin jackpot.",
	},
	Mythic = {
		name = "Mythic Crate",
		category = "Brainrot",
		coinPrice = 250000,
		odds = { Legendary = 80, Mythic = 17, Secret = 3 },
		jackpot = { chance = 0.4, min = 20000, max = 100000 },
		pity = { every = 50, rarity = "Secret" },
		description = "Legendary or better, every time, with a shot at Mythic and Secret.",
	},
	-- The STYLE CRATES: cosmetic crates in tiers, drawing from every cosmetic kind at once rather than
	-- one slot each (Oliver, 2026-09-18: "varying tiers of these crates"). Tiers rather than more
	-- kind-crates because the pools are small — 13 accessories, 15 auras, 22 gun skins, 15 parachutes —
	-- so a tier that only dropped Legendary accessories would exhaust after two opens and refund
	-- forever. `kinds` is what a tier can draw from; the rarity is rolled first, then an unowned
	-- cosmetic of that rarity from any of them.
	--
	-- All three are sold for coins AND for Robux, which makes them paid random items: the odds on the
	-- card are the odds rolled, always, on both routes. Beginner's Luck can never touch them —
	-- CrateData.BeginnerBoosted only ever returns true for a brainrot crate, and that must not be
	-- widened to these.
	Style = {
		name = "Style Crate",
		category = "Cosmetic",
		kinds = { "Accessory", "GunSkin", "Aura", "Parachute" },
		coinPrice = 8000,
		productKey = "CrateStyle",
		color = Color3.fromRGB(120, 200, 255),
		duplicateRefund = 0.35,
		odds = { Common = 42, Uncommon = 30, Rare = 18, Epic = 7, Legendary = 2.5, Mythic = 0.4, Secret = 0.1 },
		description = "Any cosmetic: an accessory, a gun skin, an aura or a parachute.",
	},

	DeluxeStyle = {
		name = "Deluxe Style Crate",
		category = "Cosmetic",
		kinds = { "Accessory", "GunSkin", "Aura", "Parachute" },
		coinPrice = 25000,
		productKey = "CrateDeluxeStyle",
		color = Color3.fromRGB(180, 140, 255),
		duplicateRefund = 0.4,
		odds = { Common = 20, Uncommon = 28, Rare = 27, Epic = 16, Legendary = 7, Mythic = 1.6, Secret = 0.4 },
		pity = { every = 10, rarity = "Epic" },
		description = "Any cosmetic, weighted to the good end.",
	},

	PrestigeStyle = {
		name = "Prestige Style Crate",
		category = "Cosmetic",
		kinds = { "Accessory", "GunSkin", "Aura", "Parachute" },
		coinPrice = 60000,
		productKey = "CratePrestigeStyle",
		color = Color3.fromRGB(255, 190, 90),
		duplicateRefund = 0.45,
		odds = { Uncommon = 18, Rare = 30, Epic = 28, Legendary = 17, Mythic = 5, Secret = 2 },
		pity = { every = 8, rarity = "Legendary" },
		description = "No Commons at all. The best cosmetics in the game are in here.",
	},

	Accessory = {
		name = "Accessory Crate",
		category = "Accessory",
		coinPrice = 10000,
		color = Color3.fromRGB(255, 120, 190),
		duplicateRefund = 0.35,
		odds = { Common = 40, Uncommon = 30, Rare = 18, Epic = 9, Legendary = 3 },
		description = "Accessories only, never one you already own.",
	},
	Skin = {
		name = "Gun Skin Crate",
		category = "GunSkin",
		coinPrice = 7500,
		color = Color3.fromRGB(120, 200, 255),
		duplicateRefund = 0.35,
		odds = { Common = 35, Uncommon = 30, Rare = 20, Epic = 10, Legendary = 4, Mythic = 0.8, Secret = 0.2 },
		description = "Gun skins only, including crate-exclusive Legendary, Mythic and Secret skins.",
	},
	Aura = {
		name = "Aura Crate",
		category = "Aura",
		coinPrice = 20000,
		color = Color3.fromRGB(190, 120, 255),
		duplicateRefund = 0.35,
		odds = { Common = 25, Uncommon = 28, Rare = 25, Epic = 14, Legendary = 6, Mythic = 1.6, Secret = 0.4 },
		description = "Auras only, including crate-exclusive Legendary, Mythic and Secret auras.",
	},
	-- Canopies for the drop-in and the Rot Glider (CosmeticData kind "Parachute", designed by
	-- ParachuteModels). Like the other item crates it only gives one you don't own yet, drawing from
	-- every parachute of the rolled rarity, shop ones included, and refunds when there's none left.
	Parachute = {
		name = "Parachute Crate",
		category = "Parachute",
		coinPrice = 15000,
		color = Color3.fromRGB(255, 146, 54),
		duplicateRefund = 0.35,
		odds = { Common = 25, Uncommon = 28, Rare = 25, Epic = 14, Legendary = 6, Mythic = 1.6, Secret = 0.4 },
		description = "Parachutes only, never one you already own.",
	},
	-- Death effects (CosmeticData kind "KillAnimation", #24, 2026-09-24): the only place the Legendary,
	-- Mythic and Secret ones come from. Like the other item crates it gives only one you don't own,
	-- from every death effect of the rolled rarity, shop ones included, and moves to the nearest
	-- rarity with something new left (CrateService.Open). The odds are the Parachute Crate's: the
	-- same fifteen-item ladder, three Common to one Secret. Coins only, like the other kind crates.
	DeathEffect = {
		name = "Death Effect Crate",
		category = "KillAnimation",
		coinPrice = 15000,
		color = Color3.fromRGB(150, 70, 255),
		duplicateRefund = 0.35,
		odds = { Common = 25, Uncommon = 28, Rare = 25, Epic = 14, Legendary = 6, Mythic = 1.6, Secret = 0.4 },
		description = "Death effects only, never one you already own. The only way to get the crate exclusives.",
	},
}

function CrateData.Get(tier)
	return CrateData.Crates[tier]
end

-- Crate luck. Luck L means the crate is rolled L times and the rarest result is kept, the way
-- "2x luck" works in most games. Rather than literally rolling L times, the odds are transformed
-- exactly: the chance of rarity r OR BETTER becomes 1 - (1 - p)^L, where p is that chance at base
-- odds. So nothing can exceed 100%, a crate can still only roll the rarities it lists, and the rare
-- end gains the most (1% becomes 1.99% at 2x). Pity is separate and unchanged: its counter reads
-- whatever this roll produced.
--
-- The roll (CrateService.Open) and every place odds are shown (the crate cards) call this same
-- function with the same luck, so the odds a player sees are exactly the odds they get. Returns
-- rarity -&gt; percent, summing to 100.
local Rarity = require(script.Parent:WaitForChild("Rarity"))

CrateData.MaxLuck = 8

-- Beginner's Luck: a brand new profile's first few FREE brainrot crates roll at this much luck, on
-- top of any pass. Only crates the game hands out, never one bought with Robux or coins: a crate
-- someone paid for always rolls the odds its card shows. Nothing in the UI names this; the cards for
-- a boosted crate show which rarities can drop and no percentages, so no number on screen is ever a
-- number the roll didn't use.
CrateData.BeginnerLuck = 4
CrateData.BeginnerCrates = 4

-- Beginner's Luck charges left on a profile (pass it data.Progression). Missing on saves from before
-- the feature, which reads as none.
function CrateData.BeginnerLeft(progression)
	local beginner = progression and progression.beginnerLuck
	local left = beginner and tonumber(beginner.left) or 0
	if left ~= left then
		return 0
	end
	return math.max(0, math.floor(left))
end

-- Whether the next crate of this tier out of a player's inventory rolls with Beginner's Luck.
--
-- It takes the whole holding, not just the next crate, on purpose: a boosted card shows no
-- percentages, and a card with no percentages must never be one you can BUY a crate on. Crates
-- bought with coins count as paid (coins are bought with Robux), so the boost applies only when
-- every crate of that tier is one the game handed out. Buying one — with Robux or coins — puts
-- percentages straight back and opens ahead of the free ones.
-- CrateService.Open asks this before it spends anything and StateSync asks it for the menu, so the
-- card and the roll always agree.
function CrateData.BeginnerBoosted(crate, heldCount, paidCount, freeCount, beginnerLeft)
	if not crate or (crate.category ~= nil and crate.category ~= "Brainrot") then
		return false
	end
	local held, paid, free = heldCount or 0, paidCount or 0, freeCount or 0
	local bought = paid + math.max(0, held - paid - free) -- Robux crates plus coin-bought ones
	return bought &lt;= 0 and free &gt; 0 and (beginnerLeft or 0) &gt; 0
end

-- The luck one open rolls with, from the player's pass luck and whether this particular crate is a
-- boosted free one. The server rolls with this and the menu draws its odds with it, so shown and
-- rolled can't drift apart.
function CrateData.LuckFor(crate, passLuck, beginnerBoosted)
	local luck = math.max(1, tonumber(passLuck) or 1)
	if beginnerBoosted and (crate.category == nil or crate.category == "Brainrot") then
		luck *= CrateData.BeginnerLuck
	end
	return math.clamp(math.floor(luck), 1, CrateData.MaxLuck)
end

-- The odds line on a crate card, as the pieces the menu joins with spaces. `boosted` is a crate
-- rolling with Beginner's Luck: those list which rarities can drop and NO percentages, because the
-- percentages for the luck they actually roll with aren't the ones a player could be told. Kept here
-- rather than in MenuClient so tools/crate_card_gallery.lua renders the real thing.
function CrateData.OddsLine(crate, luck, boosted)
	local effective = CrateData.EffectiveOdds(crate, luck)
	local parts = {}
	if luck &gt; 1 and not boosted then
		table.insert(parts, string.format("%dx LUCK:", luck))
	end
	for _, rarity in ipairs(Rarity.Order) do
		local chance = effective[rarity]
		if chance and chance &gt; 0 then
			-- Fractions of a percent (Secret odds) need the extra digit to not read as 0. The full rarity
			-- word, not its first four letters: "Unco", "Lege" and "Secr" are not words a first-time player
			-- knows, and these are the disclosed odds of a paid random item (player's-eye review, #86).
			-- The card labels wrap and grow, so the longer line costs a line, not legibility.
			table.insert(parts, boosted and rarity
				or string.format(chance &lt; 1 and "%s %.2f%%" or "%s %.1f%%", rarity, chance))
		end
	end
	if crate.accessoryChance and crate.accessoryChance &gt; 0 then
		-- A ceiling, and a swap: CrateService.Open only gives one when an accessory the player doesn't
		-- own exists at the rarity rolled, and it replaces the brainrot rather than adding to it.
		table.insert(parts, string.format("up to %d%% an accessory instead", crate.accessoryChance))
	end
	return parts
end

function CrateData.EffectiveOdds(crate, luck)
	luck = math.clamp(math.floor(tonumber(luck) or 1), 1, CrateData.MaxLuck)
	local total = 0
	for _, weight in pairs(crate.odds) do
		total += weight
	end
	local result = {}
	if total &lt;= 0 then
		return result
	end
	-- From the rarest down: `atLeast` is the base chance of this rarity or better, and each rarity's
	-- share is the step between its boosted cumulative chance and the one above it. The last step
	-- ends at exactly 1, so the shares always add up to 100.
	local atLeast, boostedAbove = 0, 0
	for index = #Rarity.Order, 1, -1 do
		local rarity = Rarity.Order[index]
		local weight = crate.odds[rarity]
		if weight and weight &gt; 0 then
			atLeast = math.min(1, atLeast + weight / total)
			local boosted = 1 - (1 - atLeast) ^ luck
			result[rarity] = (boosted - boostedAbove) * 100
			boostedAbove = boosted
		end
	end
	return result
end

return CrateData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">CrateModels</string><ProtectedString name="Source">-- Crates and chests, built from parts, shared by everything that shows one:
--
--   Crate   the loot crates you open — the menu's opening animation, the Crate Altar's shelf,
--           the idle crate on the altar between pulls. A dark capsule with rounded metal edges,
--           tier-coloured corner caps and glowing seams, a badge on the front, a domed lid with
--           a neon band, and a gold padlock. Every part that takes the tier colour is returned
--           in `tinted`, so the opening animation can walk it up the rarity ladder.
--   Chest   the chests on the map, a different thing altogether: a banded wooden treasure
--           chest with brass straps and corners, a keyhole plate, a curved lid, and a warm glow
--           waiting under it. The lid is a child named "Lid", which LootFxClient swings open.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Rarity = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Rarity"))
local ZFight = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ZFight"))

local CrateModels = {}

local V = Vector3.new
local SHELL = Color3.fromRGB(38, 42, 56)
local SHELL_DARK = Color3.fromRGB(26, 28, 38)
local STEEL = Color3.fromRGB(168, 172, 182)
local GOLD = Color3.fromRGB(255, 200, 60)
local WOOD = Color3.fromRGB(104, 68, 40)
local WOOD_DARK = Color3.fromRGB(74, 48, 30)
local BRASS = Color3.fromRGB(214, 170, 80)
local GLOW = Color3.fromRGB(255, 214, 120)

local function newPart(parent, name, size, cframe, color, material, shape, transparency)
	local part = Instance.new("Part")
	part.Name = name
	if shape then
		part.Shape = shape
	end
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Transparency = transparency or 0
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- A wedge through the same path as a part, for the peaked lids.
local function newWedge(parent, name, size, cframe, color, material)
	local part = Instance.new("WedgePart")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Parent = parent
	return part
end

-- What makes each crate read as itself at the size of a card (72 px) — beyond its colour, which was
-- all that told them apart. Each is a silhouette a thumb can pick out: the lid's shape (flat, a
-- dome, a peaked roof, a crown of points round a dome), studs down the corner columns, a ring of
-- lights hanging over the lid, a glass shell with a glowing core, a ribbon and bow for the cosmetic
-- crates, gold fittings for the top tiers, and what the badge says. A tier not listed gets the
-- dome (the old look).
local STYLES = {
	Common = { lid = "flat" },
	Uncommon = { lid = "dome" },
	Rare = { lid = "dome", studs = true },
	Epic = { lid = "peak", studs = true },
	Legendary = { lid = "crown", studs = true, gold = true },
	Mythic = { lid = "peak", halo = true, studs = true, metal = true },
	Secret = { lid = "dome", glass = true, core = true, glyph = "?" },
	Super = { lid = "crown", halo = true, gold = true },
	Style = { lid = "flat", bow = true, cloth = true },
	DeluxeStyle = { lid = "flat", bow = true, cloth = true, studs = true },
	PrestigeStyle = { lid = "flat", bow = true, cloth = true, gold = true, halo = true },
}
CrateModels.Styles = STYLES

-- A crate for `tier` (a CrateData tier name; the colour comes from Rarity, or `options.color`),
-- centred on the origin with its bottom at y = 0, facing -Z. options: scale, color.
-- Returns model, lid, lidBand, tinted.
function CrateModels.Crate(tier, options)
	options = options or {}
	local scale = options.scale or 1
	local color = options.color or (tier and Rarity.Color(tier)) or GOLD
	local style = (tier and STYLES[tier]) or STYLES.Uncommon
	local fittingColor = style.gold and GOLD or STEEL
	local fittingMaterial = style.gold and Enum.Material.Foil or Enum.Material.Metal
	local model = Instance.new("Model")
	model.Name = "Crate"
	model:SetAttribute("CrateTier", tier or "")
	local tinted = {}

	local function piece(name, size, cframe, pieceColor, material, shape, transparency)
		local frame = typeof(cframe) == "Vector3" and CFrame.new(cframe) or cframe
		return newPart(model, name, size * scale, CFrame.new(frame.Position * scale) * frame.Rotation, pieceColor, material, shape, transparency)
	end

	-- The shell: a box with its vertical edges rounded off by columns and a plinth underneath.
	-- Everything layered on the front is stepped a clear 0.06 out from what's behind it (body
	-- 1.50, bands 1.56, seam 1.62, badge ring 1.70, badge 1.80, keyhole 1.86), so no two faces
	-- lie flush.
	-- The shell stands clear of the plinth and the corner columns: its underside used to be 0.04
	-- over the plinth's, which is inside the z-fight pass's reach, and the pass answered by growing
	-- the shell and shifting all 27 parts of the crate.
	-- The shell: dark plastic; glass with the glow inside for the Secret crate; cloth in the crate's
	-- own colour for the cosmetic crates; brushed metal for the Mythic.
	local body = piece("Body", V(4, 2.7, 3), V(0, 1.61, 0),
		style.cloth and color:Lerp(SHELL, 0.55) or (style.glass and SHELL_DARK or SHELL),
		style.glass and Enum.Material.Glass or (style.cloth and Enum.Material.Fabric or (style.metal and Enum.Material.Metal or Enum.Material.SmoothPlastic)),
		nil, style.glass and 0.3 or nil)
	-- The plinth rides on the feet, which stand on y = 0: the crate's base is its origin. (The feet
	-- used to hang 0.06 below the plinth's bottom, so a crate set on a surface sank into it.)
	piece("Plinth", V(4.3, 0.3, 3.3), V(0, 0.21, 0), SHELL_DARK, Enum.Material.Metal)
	for _, x in ipairs({ -2, 2 }) do
		for _, z in ipairs({ -1.5, 1.5 }) do
			-- Cylinder length is its X, so the column's height goes first and the quarter turn stands
			-- it up. It runs from inside the plinth to inside the lid, clear of the body's top and
			-- bottom faces.
			piece("Edge", V(2.7, 0.5, 0.5), CFrame.new(x, 1.52, z) * CFrame.Angles(0, 0, math.pi / 2), fittingColor, fittingMaterial, Enum.PartType.Cylinder)
			if style.studs then
				-- Three studs down each column, set most of the way into it (balls: no flat faces).
				for _, y in ipairs({ 0.9, 1.52, 2.14 }) do
					piece("Stud", V(0.3, 0.3, 0.3), V(x * 1.07, y, z * 1.093), fittingColor, fittingMaterial, Enum.PartType.Ball)
				end
			end
			table.insert(tinted, piece("Cap", V(0.7, 0.7, 0.7), V(x, 2.95, z), color, Enum.Material.Foil, Enum.PartType.Ball))
			piece("Foot", V(0.6, 0.42, 0.6), V(x, 0.21, z), STEEL, Enum.Material.Metal)
		end
	end
	-- Seams of light round the body and a badge on the front.
	for _, y in ipairs({ 0.75, 2.15 }) do
		table.insert(tinted, piece("Band", V(4.12, 0.22, 3.12), V(0, y, 0), color, Enum.Material.Neon))
	end
	table.insert(tinted, piece("Seam", V(0.12, 2.38, 3.24), V(0, 1.55, 0), color, Enum.Material.Neon, nil, 0.2))
	local badge = piece("Badge", V(1.4, 1.4, 0.1), V(0, 1.45, -1.75), SHELL_DARK, Enum.Material.Metal)
	table.insert(tinted, piece("BadgeRing", V(0.08, 1.5, 1.5), CFrame.new(0, 1.45, -1.66) * CFrame.Angles(0, math.pi / 2, 0), color, Enum.Material.Neon,
		Enum.PartType.Cylinder))
	if tier then
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 50
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.Text = style.glyph or string.sub(tier, 1, 1)
		label.TextColor3 = color
		label.TextScaled = true
		label.Parent = gui
		gui.Parent = badge
	end
	-- Side handles, against the body.
	for _, x in ipairs({ -2.1, 2.1 }) do
		piece("Handle", V(0.2, 0.3, 1.2), V(x, 1.6, 0), STEEL, Enum.Material.Metal)
	end

	-- The lid: a dome (a cylinder lying across) on a rim, with its own band and the padlock. Its
	-- pivot is its hinge — the middle of its back edge, at the underside — so an open swings it:
	-- lid:PivotTo(lid:GetPivot() * CFrame.Angles(angle, 0, 0)) with a POSITIVE angle: the crate
	-- faces -Z, so the lid's front lies at -Z from the hinge, and a positive turn about the hinge's
	-- X lifts it (a negative one swings it down into the crate — measured by CrateOpen's gallery,
	-- and LootFxClient's chest swing uses positive too). The riders (dome, band, lock) are carried
	-- along by their offsets from the lid the way the reveal already does. The same hinge is on
	-- the lid as the attribute "Hinge", in the lid's own space, for anything that animates by
	-- CFrame rather than by pivot.
	local lid = piece("Lid", V(4.2, 0.4, 3.2), V(0, 3.0, 0), SHELL_DARK, Enum.Material.Metal)
	-- Scaled like every other offset here, so a scaled crate's lid still swings about its own back edge.
	local hinge = CFrame.new(0, -0.2 * scale, 1.6 * scale)
	lid.PivotOffset = hinge
	lid:SetAttribute("Hinge", hinge)
	-- What stands on the lid plate (its top is 3.2). Every piece here butts the plate or clears it
	-- by 0.07 or more; the returned `lidBand` is the tier-coloured neon of whichever lid this is.
	local lidBand
	if style.lid == "dome" or style.lid == "crown" then
		local dome = piece("LidDome", V(3.6, 1.6, 1.6), CFrame.new(0, 3.2, 0), style.cloth and body.Color or SHELL, body.Material, Enum.PartType.Cylinder)
		dome.Parent = lid
		lidBand = piece("LidBand", V(3.72, 1.7, 1.7), CFrame.new(0, 3.2, 0), color, Enum.Material.Neon, Enum.PartType.Cylinder, 0.55)
		if style.lid == "crown" then
			-- Eight points round the dome, on the plate outside the dome's reach (|z| &gt; 0.85).
			for _, x in ipairs({ -1.55, -0.55, 0.55, 1.55 }) do
				for _, z in ipairs({ -1.3, 1.3 }) do
					piece("Point", V(0.6, 0.18, 0.18), CFrame.new(x, 3.5, z) * CFrame.Angles(0, 0, math.pi / 2), fittingColor, fittingMaterial, Enum.PartType.Cylinder).Parent = lid
					piece("PointTip", V(0.3, 0.3, 0.3), V(x, 3.85, z), fittingColor, fittingMaterial, Enum.PartType.Ball).Parent = lid
				end
			end
		end
	elseif style.lid == "peak" then
		-- Two wedges back to back, their vertical faces meeting at z = 0 and their undersides on the
		-- plate (they touch each other only along the ridge line), and a neon cap along the ridge.
		newWedge(lid, "LidPeak", V(3.6, 1.1, 1.5) * scale, CFrame.new(V(0, 3.75, -0.75) * scale), SHELL, body.Material)
		newWedge(lid, "LidPeak", V(3.6, 1.1, 1.5) * scale, CFrame.new(V(0, 3.75, 0.75) * scale) * CFrame.Angles(0, math.pi, 0), SHELL, body.Material)
		lidBand = piece("LidBand", V(3.72, 0.14, 0.14), V(0, 4.34, 0), color, Enum.Material.Neon)
	elseif style.bow then
		-- A present: a ribbon each way across the flat lid, the cross ribbon a step above the other
		-- (so no faces share a plane) and neon — it is this lid's band — and a knot where they cross.
		piece("Ribbon", V(0.5, 0.1, 3.44), V(0, 3.25, 0), color, Enum.Material.Fabric).Parent = lid
		lidBand = piece("LidBand", V(4.44, 0.1, 0.5), V(0, 3.35, 0), color, Enum.Material.Neon)
		piece("Knot", V(0.7, 0.7, 0.7), V(0, 3.45, 0), color, Enum.Material.Fabric, Enum.PartType.Ball).Parent = lid
	else
		-- Flat: a low ridge bar and a neon strip along the front edge.
		piece("LidRidge", V(3.2, 0.24, 0.8), V(0, 3.32, 0.2), style.cloth and body.Color or SHELL, body.Material).Parent = lid
		lidBand = piece("LidBand", V(3.72, 0.1, 0.16), V(0, 3.25, -1.45), color, Enum.Material.Neon)
	end
	lidBand.Parent = lid
	table.insert(tinted, lidBand)
	-- No padlock on a present.
	if not style.bow then
		local lock = piece("Lock", V(0.7, 0.8, 0.3), V(0, 2.72, -1.65), GOLD, Enum.Material.Foil)
		lock.Parent = lid
		local shackle = piece("Shackle", V(0.15, 0.6, 0.6), CFrame.new(0, 3.25, -1.65) * CFrame.Angles(0, math.pi / 2, 0), STEEL, Enum.Material.Metal, Enum.PartType.Cylinder)
		shackle.Parent = lid
		piece("Keyhole", V(0.14, 0.24, 0.06), V(0, 2.7, -1.83), SHELL_DARK, Enum.Material.Metal).Parent = lid
	end
	if style.halo then
		-- A ring of eight lights hung over the lid, touching nothing (floating on purpose).
		for index = 0, 7 do
			local angle = index / 8 * math.pi * 2
			local light = piece("HaloLight", V(0.32, 0.32, 0.32), V(math.cos(angle) * 1.7, 4.55, math.sin(angle) * 1.7), color, Enum.Material.Neon, Enum.PartType.Ball)
			light:SetAttribute("IntentionalFloat", true)
			table.insert(tinted, light)
		end
	end
	if style.core then
		table.insert(tinted, piece("Core", V(1.6, 1.6, 1.6), V(0, 1.61, 0), color, Enum.Material.Neon, Enum.PartType.Ball))
	end

	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 8 * scale
	light.Brightness = 1.2
	light.Parent = body

	-- No two faces left flush: the badge and bands sit a clear hair proud of the body.
	ZFight.Fix({ model }, { all = true })

	model.PrimaryPart = body
	body.PivotOffset = body.CFrame:Inverse()
	return model, lid, lidBand, tinted
end

-- A map chest at `cframe` (its base on the ground): the "Chest" part with everything attached
-- under it, the lid a child named "Lid". Nothing is parented into the world yet.
function CrateModels.Chest(cframe)
	-- The body stands on its four feet, which stand on `cframe` (the ground), so no face of it
	-- lies in the ground's own surface.
	local chest = Instance.new("Part")
	chest.Name = "Chest"
	chest.Size = V(3.6, 2.0, 2.6)
	chest.Color = WOOD
	chest.Material = Enum.Material.WoodPlanks
	chest.Anchored = true
	chest.CFrame = cframe * CFrame.new(0, 1.3, 0)
	chest.TopSurface = Enum.SurfaceType.Smooth
	chest.BottomSurface = Enum.SurfaceType.Smooth
	local frame = chest.CFrame

	-- Plank lines, brass corners and straps, feet, and the lock plate. Every layer stands a clear
	-- 0.07 or more proud of the one under it — half-extents across: body 1.30, lid 1.35, planks
	-- 1.37, lip 1.42, straps and corners 1.44; along: lid 1.70, body 1.80, planks 1.87, corners
	-- 1.94, staves 1.95 and 2.03, lip 2.12; and on the front, plate 1.46, keyhole 1.52. The corners
	-- and straps stop inside the body's top, under the lid's lip, so nothing lies flush with
	-- anything else. (At 0.06 steps the pass still moved all 56 parts: 0.06 clears the scan's
	-- tolerance but not the pass's, so measure against FixTolerance, not Tolerance.)
	for _, y in ipairs({ -0.35, 0.35 }) do
		newPart(chest, "Plank", V(3.74, 0.06, 2.74), frame * CFrame.new(0, y, 0), WOOD_DARK, Enum.Material.Wood)
	end
	for _, x in ipairs({ -1.77, 1.77 }) do
		for _, z in ipairs({ -1.27, 1.27 }) do
			newPart(chest, "Corner", V(0.34, 1.96, 0.34), frame * CFrame.new(x, -0.08, z), BRASS, Enum.Material.Metal)
			newPart(chest, "Foot", V(0.5, 0.3, 0.5), frame * CFrame.new(x, -1.15, z), BRASS, Enum.Material.Metal)
		end
	end
	for _, x in ipairs({ -1.0, 1.0 }) do
		newPart(chest, "Strap", V(0.34, 1.96, 2.88), frame * CFrame.new(x, -0.08, 0), BRASS, Enum.Material.Metal)
	end
	-- The lock plate sits below the hasp that closes onto it rather than overlapping its last 0.08:
	-- where they overlapped, their faces were 0.03 apart and the z-fight pass pulled the hasp out.
	newPart(chest, "Plate", V(0.9, 0.9, 0.16), frame * CFrame.new(0, 0.2, -1.38), BRASS, Enum.Material.Foil)
	newPart(chest, "Keyhole", V(0.16, 0.3, 0.06), frame * CFrame.new(0, 0.18, -1.49), Color3.fromRGB(20, 20, 24), Enum.Material.Metal)
	-- The glow waiting inside: a lit strip down inside the chest (its light spills out through the
	-- seam and the keyhole). It used to sit up inside the lid's base, where its top face was a
	-- twentieth of a stud off the lid's own and off the brass lip's.
	local seam = newPart(chest, "Seam", V(3.0, 0.1, 2.0), frame * CFrame.new(0, 0.78, 0), GLOW, Enum.Material.Neon, nil, 0.25)
	local light = Instance.new("PointLight")
	light.Color = GLOW
	light.Range = 7
	light.Brightness = 0.9
	light.Parent = seam

	-- The lid: a barrel top of staves on a half circle over a flat base plate, with brass bands, a
	-- head at each end and a lip under it. It rests on the body's rim rather than sinking into it.
	-- LootFxClient hinges it on its back edge.
	--
	-- It used to be a single cylinder with its lower half sunk into the body's rim. That reads
	-- correctly only while the chest is shut: LootFxClient hinges the lid on its back edge and
	-- swings it up, which brings the buried half round with it, so opening a chest showed a
	-- complete tube instead of a dome. A cylinder cannot be both half sunk and opened. An arc of
	-- staves is genuinely open underneath, so the lid reveals the inside of a dome.
	--
	-- The part itself stays the hinge: LootFxClient reads its Z size to place the hinge on the
	-- back edge and carries every descendant along with it, so the staves must be its children.
	-- The lid's base plate: narrower than the staves that cover it, so its ends aren't in their
	-- plane, and lifted until its underside meets the body's rim rather than sinking 0.09 into it
	-- (the two overlapped, which put their side faces 0.05 apart).
	local lid = Instance.new("Part")
	lid.Name = "Lid"
	lid.Size = V(3.4, 0.26, 2.7)
	lid.CFrame = frame * CFrame.new(0, 1.13, 0)
	lid.Color = WOOD_DARK
	lid.Material = Enum.Material.WoodPlanks
	lid.Anchored = true
	lid.CanCollide = false
	lid.CanQuery = false
	lid.CanTouch = false
	lid.Parent = chest

	-- Staves over the arc with brass bands across them.
	--
	-- Turning a stave about the arc does NOT turn the two faces at its ends: every stave's ends lay
	-- in the same two planes, and since neighbours overlap along the arc, that was twelve pairs of
	-- faces lying flush — the same mistake the glider's canopy cells made. So alternate staves run
	-- STAGGER longer at both ends. The bands are cut to exactly their share of the arc instead of
	-- overlapping their neighbours, which leaves their ends in one plane but with nothing to fight
	-- (faces that only share an edge don't).
	local STAVES = 8
	local STAGGER = 0.08
	local archRadius = 1.26
	-- A shade under each band's share of the arc, so neighbours leave a hair of daylight rather
	-- than overlapping: cut to exactly their share they still overlapped by 0.016 at the inner
	-- edge (turned rectangles meet at their corners, not along their faces), and 0.016 sits right
	-- on the pass's minimum overlap, which Roblox's arithmetic tipped over.
	local bandDepth = (archRadius + 0.16) * math.pi / STAVES * 0.92
	for index = 0, STAVES - 1 do
		local around = -math.pi / 2 + (index + 0.5) * (math.pi / STAVES)
		local at = lid.CFrame * CFrame.Angles(around, 0, 0)
		newPart(lid, "LidStave", V(3.9 + (index % 2) * STAGGER * 2, 0.2, 0.62), at * CFrame.new(0, archRadius, 0), WOOD,
			Enum.Material.WoodPlanks)
		for _, x in ipairs({ -1.0, 1.0 }) do
			newPart(lid, "LidBand", V(0.42, 0.12, bandDepth), at * CFrame.new(x, archRadius + 0.16, 0), BRASS, Enum.Material.Metal)
		end
	end
	-- The barrel's two ends. The staves only make the curve, so without these both ends of the lid
	-- stood open and you looked straight into a hollow half-tube from the side. Each end is a head
	-- of planks stacked up the half circle, inset 0.06 from the stave ends so no face is shared.
	-- Every plank reaches past the staves' inside surface at its bottom and stops inside their
	-- thickness at its top corners, so nothing shows between head and staves and nothing pokes out.
	-- The heads stack from the lid's top face upward (starting at its mid-plane put a plank edge
	-- 0.03 off the lid's own top), stand well inside the staves' ends, and stop short of the lid's
	-- sides so no plank's width lands in the lid's side plane.
	local HEAD_PLANKS = 8
	local headBase = 0.13
	local plankHeight = (archRadius - headBase) / HEAD_PLANKS
	local headReach = 1.28
	for _, side in ipairs({ -1, 1 }) do
		for index = 0, HEAD_PLANKS - 1 do
			local top = headBase + (index + 1) * plankHeight
			local halfWidth = math.sqrt(headReach * headReach - top * top)
			newPart(lid, "LidHead", V(0.2, plankHeight, halfWidth * 2),
				lid.CFrame * CFrame.new(side * 1.7, headBase + (index + 0.5) * plankHeight, 0), WOOD_DARK, Enum.Material.WoodPlanks)
		end
	end
	newPart(lid, "LidLip", V(4.24, 0.2, 2.84), lid.CFrame * CFrame.new(0, -0.1, 0), BRASS, Enum.Material.Metal)
	newPart(lid, "Hasp", V(0.5, 0.6, 0.14), lid.CFrame * CFrame.new(0, -0.16, -1.42), BRASS, Enum.Material.Foil)

	ZFight.Fix({ chest }, { all = true })
	return chest, lid
end

return CrateModels
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">CrateOpen</string><ProtectedString name="Source">-- The crate-open lid swing, in one place.
--
-- A crate opens by swinging its lid up and over on its hinge -- CrateModels puts that hinge at the
-- middle of the lid's back edge, as the lid's PivotOffset and as its "Hinge" attribute -- with a
-- moment of press-down first and a little overshoot at the end, so the lid reads as having weight.
--
-- The swing is not the same for every crate (Oliver's #60: the tiers want their own quality of
-- animation). A Common crate snaps open; the further up the ladder, the longer the press-down, the
-- slower the swing and the heavier the settle, so a Prestige Style crate opens like something that
-- cost sixty thousand coins. It is one curve with per-tier numbers rather than a different animation
-- each, because every one of them still has to read as the same crate opening.
--
-- It lives here rather than in MenuClient because two things play it and a third measures it: the
-- crate reveal in the menu, the world containers in LootFxClient, and tools/crate_open_gallery.lua,
-- which renders the swing frame by frame. A gallery that reproduced the curve instead of calling it
-- would drift from the animation it claims to be a picture of.
local CrateOpen = {}

-- Past upright, so the lid comes to rest against the back of the crate the way a chest lid does.
CrateOpen.OpenAngle = math.rad(112)

-- duration: how long the swing takes, in seconds. overshoot: how far past the rest angle it throws
-- before settling, as a share of the open angle. anticipation: the share of the swing spent pressing
-- down before the lid gives. Anything not listed opens on Default -- the kind crates (Accessory,
-- Skin, Aura, Parachute) sit mid-ladder deliberately.
CrateOpen.Default = { duration = 0.46, overshoot = 0.12, anticipation = 0.16 }
CrateOpen.Tiers = {
	Common = { duration = 0.34, overshoot = 0.06, anticipation = 0.10 },
	Uncommon = { duration = 0.38, overshoot = 0.08, anticipation = 0.12 },
	Rare = { duration = 0.42, overshoot = 0.10, anticipation = 0.14 },
	Epic = { duration = 0.46, overshoot = 0.12, anticipation = 0.16 },
	Legendary = { duration = 0.52, overshoot = 0.15, anticipation = 0.18 },
	Mythic = { duration = 0.58, overshoot = 0.17, anticipation = 0.20 },
	Secret = { duration = 0.62, overshoot = 0.19, anticipation = 0.22 },
	Super = { duration = 0.58, overshoot = 0.17, anticipation = 0.20 },
	-- The cosmetic ladder, in step with the brainrot one it is priced against.
	Style = { duration = 0.42, overshoot = 0.10, anticipation = 0.14 },
	DeluxeStyle = { duration = 0.52, overshoot = 0.15, anticipation = 0.18 },
	PrestigeStyle = { duration = 0.62, overshoot = 0.20, anticipation = 0.22 },
}

-- The numbers for one crate tier, every field filled in from Default.
function CrateOpen.For(tier)
	local style = tier and CrateOpen.Tiers[tier] or nil
	if not style then
		return CrateOpen.Default
	end
	return {
		duration = style.duration or CrateOpen.Default.duration,
		overshoot = style.overshoot or CrateOpen.Default.overshoot,
		anticipation = style.anticipation or CrateOpen.Default.anticipation,
	}
end

-- How long this tier's swing lasts. Callers time the rest of the reveal off this.
function CrateOpen.Duration(tier)
	return CrateOpen.For(tier).duration
end

-- The lid's angle, in radians, `since` seconds into the open of a crate of this tier. Negative while
-- it presses down, then rising to OpenAngle with a half-sine overshoot that is gone by the end.
function CrateOpen.Angle(since, tier)
	local style = CrateOpen.For(tier)
	local t = math.clamp((since or 0) / style.duration, 0, 1)
	if t &lt; style.anticipation then
		-- Shallow on purpose: the lid rests on the body, so a press is the front edge biting into it.
		-- 0.05 rad over a 3.2-stud lid is about 0.16 studs, which reads as weight, not as clipping.
		return -0.05 * math.sin(t / style.anticipation * math.pi)
	end
	local s = (t - style.anticipation) / (1 - style.anticipation)
	return CrateOpen.OpenAngle * ((1 - (1 - s) ^ 3) + math.sin(s * math.pi) * style.overshoot)
end

-- Where the lid sits at that angle, given where it started and where its hinge is in its own space.
-- `lidStart * hinge * R * hinge:Inverse()` turns the lid about the hinge without moving the hinge;
-- anything riding on the lid keeps its own offset from this.
--
-- The angle is POSITIVE about X. A crate faces -Z and its hinge is the back edge at +Z, so the front
-- edge sits at -Z from the hinge, and a positive X rotation is the one that lifts it: rotating a
-- point (0, 0, -d) by θ about X sends it to y = d·sinθ, which rises only while θ is positive. The
-- note in CrateModels suggests `CFrame.Angles(-angle, 0, 0)`, which swings the front DOWN into the
-- crate; LootFxClient's world-crate swing, which has been on screen since before this module, uses
-- the positive angle. Measured either way by tools/crate_open_gallery.lua, which fails the sign.
function CrateOpen.LidCFrame(lidStart, hinge, angle)
	return lidStart * hinge * CFrame.Angles(angle, 0, 0) * hinge:Inverse()
end

-- The hinge of a lid part, from the attribute CrateModels writes, falling back to its pivot.
function CrateOpen.Hinge(lid)
	local attribute = lid:GetAttribute("Hinge")
	return typeof(attribute) == "CFrame" and attribute or lid.PivotOffset
end

return CrateOpen
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">CreativeArsenal</string><ProtectedString name="Source">-- Fourteen creative guns, two for every rarity: everyday objects turned into weapons, in the spirit of
-- the Bubble Blaster. A tier's body-DPS band (damage x fireRate) is ANALYSIS, not a gate -- nothing in
-- the tools checks it, and slow high-damage guns sit below their tier's fast ones everywhere (QuietHours
-- is a Mythic sniper at 74.9 against a 232 in the same tier). Below a tier's floor is an archetype, not a
-- fault: don't raise a slow gun's fireRate to reach a band. The gate that matters is the one-shot
-- threshold -- health 100 plus shield 100 is a 200 pool -- and which guns cross it on a head hit.
-- Stats sit inside each tier's body-DPS band (damage x fireRate) against the guns
-- already in WeaponData and ArsenalExpansion; models are built by GunModelsCreative.
--
-- STAGED: `staged = true` keeps a gun out of players' hands until it has passed tools/ads_align_probe,
-- gun_gaps_probe, ads_hands_probe, tools/status_effects_probe, claude-f0's sight review and renders.
-- Ground and chest loot go by weight, so those are 0; bot loot and supply drops roll every gun of a
-- rarity and ignore weights, so they skip `staged` instead -- it is the one flag that gates all four.
-- `plannedGroundWeight` and `plannedChestWeight` are the numbers to switch on: when a gun passes, drop
-- its `staged` and set its weights in the same edit (tools/verify.py fails if the two ever disagree).
--
-- What those weights do to the drop mix, since WeaponData rolls ONE global weighted pool and a tier's
-- share is its guns' weights over the total. Ground: Common 67.0% -&gt; 67.5%, Uncommon 33.0% -&gt; 32.5%.
-- Chest: Common 35.0% -&gt; 34.3%, Uncommon 38.0% -&gt; 39.2%, Rare 17.7% -&gt; 17.3%, Epic 6.7% -&gt; 6.6%,
-- Legendary 2.3% -&gt; 2.3%, Mythic 0.10% -&gt; 0.20%, Secret 0.05% -&gt; 0.10%. The top two tiers double
-- because they hold two guns each and these add two more apiece: accepted deliberately (twice as many
-- top-tier guns to find, each still vanishingly rare) rather than by splitting the stock guns' weights.
--
-- `style` matters beyond the fallback model, though less than it used to: CombatClient decides whether
-- a gun scopes in from the MODEL's `Optic` attribute, and uses `style` only for how far it zooms
-- (sniper 0.3, dmr 0.45, railgun 0.4, anything else the 0.4 default). So a scoped gun on an unusual
-- style -- the Snow Globe is a scoped "blaster" -- zooms at the default, and a red dot on a "sniper"
-- no longer scopes by accident.
--
-- Fields past the usual WeaponData ones, all read by ServerScriptService/Modules/StatusEffects.lua
-- (a CombatService damage listener) except `projectile`, which Ballistics and ProjectileService read:
--   knockback   studs/s shove along the shot       (StatusEffects, via MovementService.Launch)
--   bleed       { damage, duration }                (StatusEffects, damage over time)
--   ignite      { damage, duration }                (StatusEffects, damage over time)
--   chill       { slow, duration, stacks, freeze }  (StatusEffects, via the status speed API)
--   projectile  a ballistics kind registered in CreativeRounds: "ricochetDisc", "homingSlipper", "lobbedToast"
--               (a projectile gun's damage is dealt by ProjectileService, which has no headshot flag,
--               so those guns carry headshotMultiplier = 1 like the stock launcher does)
-- The three projectile guns' rounds are registered by CreativeRounds; loading it here puts the kinds in
-- Ballistics wherever WeaponData loads, before anything looks one up.
require(script.Parent:WaitForChild("CreativeRounds"))

local Pack = {}

Pack.Order = {
	"SqueakyDuckPopper", "JuiceBoxSquirter",
	"SpaghettiSlinger", "BoomboxBassline",
	"GumballGatling", "FidgetDiscLauncher",
	"MicrowaveZapper", "PizzaCutterCrossbow",
	"DiscoBallDeleter", "ToasterMortar",
	"RubberChickenRailgun", "LavaLampLancer",
	"SnowGlobeSingularity", "GrandmasSlipperLauncher",
}

Pack.Weapons = {
	-- Common ------------------------------------------------------------------
	SqueakyDuckPopper = {
		name = "Squeaky Duck Popper", rarity = "Common", style = "pistol",
		damage = 20, headshotMultiplier = 1.8, fireRate = 4.5, magSize = 14,
		reserveAmmo = 98, reloadTime = 1.25, range = 230, spread = 1.3, pellets = 1,
		staged = true, groundWeight = 0, chestWeight = 0, plannedGroundWeight = 30, plannedChestWeight = 10,
		killEffect = "confetti",
		description = "A chunky bath-toy pistol with a rubber duck perched beside the sights. It squeaks.",
	},
	JuiceBoxSquirter = {
		name = "Juice Box Squirter", rarity = "Common", style = "smg",
		damage = 12, headshotMultiplier = 1.5, fireRate = 11.5, magSize = 32,
		reserveAmmo = 192, reloadTime = 1.8, range = 170, spread = 3.0, pellets = 1,
		staged = true, groundWeight = 0, chestWeight = 0, plannedGroundWeight = 26, plannedChestWeight = 10,
		killEffect = "float",
		description = "Squirt gun fed from a clear juice box. Watch the level drop.",
	},

	-- Uncommon ----------------------------------------------------------------
	SpaghettiSlinger = {
		name = "Spaghetti Slinger", rarity = "Uncommon", style = "shotgun",
		damage = 14, headshotMultiplier = 1.3, fireRate = 1.2, magSize = 6,
		reserveAmmo = 42, reloadTime = 2.5, range = 105, spread = 7, pellets = 7,
		staged = true, groundWeight = 0, chestWeight = 0, plannedGroundWeight = 14, plannedChestWeight = 14,
		killEffect = "ash",
		description = "A colander on a pump. Seven noodles, al dente, point blank.",
	},
	BoomboxBassline = {
		name = "Boombox Bassline", rarity = "Uncommon", style = "blaster",
		damage = 34, headshotMultiplier = 1.4, fireRate = 2.4, magSize = 10,
		reserveAmmo = 60, reloadTime = 2.0, range = 120, spread = 1.5, pellets = 1,
		ability = "pierce", knockback = 45,
		staged = true, groundWeight = 0, chestWeight = 0, plannedGroundWeight = 10, plannedChestWeight = 14,
		killEffect = "confetti",
		description = "Cassette boombox with speaker-cone muzzles. The drop hits people.",
	},

	-- Rare ----------------------------------------------------------------------
	GumballGatling = {
		name = "Gumball Gatling", rarity = "Rare", style = "minigun",
		damage = 16, headshotMultiplier = 1.4, fireRate = 12, magSize = 60,
		reserveAmmo = 240, reloadTime = 3.2, range = 260, spread = 3.0, pellets = 1,
		ability = "chain", chainRadius = 8, chainRatio = 0.15,
		staged = true, groundWeight = 0, chestWeight = 0, plannedChestWeight = 5,
		killEffect = "confetti",
		description = "Crank the gumball machine. The globe empties as you fire; gumballs bounce to a neighbour.",
	},
	FidgetDiscLauncher = {
		name = "Fidget Disc Launcher", rarity = "Rare", style = "launcher",
		damage = 55, headshotMultiplier = 1.5, fireRate = 1.3, magSize = 5,
		reserveAmmo = 30, reloadTime = 2.6, range = 300, spread = 0.8, pellets = 1,
		-- No `ability`: a projectile gun's hits go through ProjectileService, which applies none, and the
		-- HUD would advertise one the gun doesn't have.
		projectile = "ricochetDisc",
		staged = true, groundWeight = 0, chestWeight = 0, plannedChestWeight = 5,
		killEffect = "shock",
		description = "Fires glowing fidget spinners that glance off the first wall they meet.",
	},

	-- Epic ------------------------------------------------------------------------
	MicrowaveZapper = {
		name = "Microwave Zapper", rarity = "Epic", style = "blaster",
		damage = 22, headshotMultiplier = 1.5, fireRate = 11, magSize = 45,
		reserveAmmo = 180, reloadTime = 2.8, range = 240, spread = 1.6, pellets = 1,
		ability = "chain", chainRadius = 12, chainRatio = 0.25,
		staged = true, groundWeight = 0, chestWeight = 0, plannedChestWeight = 2,
		killEffect = "burn",
		description = "A countertop microwave on a stock. The door window is the sight. Ding.",
	},
	PizzaCutterCrossbow = {
		name = "Pizza Cutter Crossbow", rarity = "Epic", style = "crossbow",
		damage = 82, headshotMultiplier = 2.0, fireRate = 1.0, magSize = 3,
		reserveAmmo = 24, reloadTime = 2.2, range = 480, spread = 0.3, pellets = 1,
		ability = "pierce", bleed = { damage = 12, duration = 3 },
		staged = true, groundWeight = 0, chestWeight = 0, plannedChestWeight = 2,
		killEffect = "ash",
		description = "Rolling-pin limbs throw spinning pizza cutters that keep going.",
	},

	-- Legendary ---------------------------------------------------------------------
	DiscoBallDeleter = {
		name = "Disco Ball Deleter", rarity = "Legendary", style = "blaster",
		damage = 26, headshotMultiplier = 1, fireRate = 9, magSize = 40,
		reserveAmmo = 200, reloadTime = 2.4, range = 330, spread = 1.6, pellets = 1,
		ability = "chain", chainRadius = 14, chainRatio = 0.35,
		staged = true, groundWeight = 0, chestWeight = 0, plannedChestWeight = 0.65,
		killEffect = "confetti",
		description = "A caged mirror ball that spins up and throws light that jumps between people.",
	},
	ToasterMortar = {
		name = "Toaster Mortar", rarity = "Legendary", style = "launcher",
		-- Explosive, so only the round's impactBonus (15) is multiplied and the blast share stays flat:
		-- this is worth about three damage on a direct hit to the head.
		damage = 70, headshotMultiplier = 1.2, fireRate = 1.0, magSize = 2,
		reserveAmmo = 16, reloadTime = 2.4, range = 350, spread = 1.0, pellets = 1,
		ability = "explosive", splashRadius = 10, projectile = "lobbedToast",
		staged = true, groundWeight = 0, chestWeight = 0, plannedChestWeight = 0.65,
		killEffect = "burn",
		description = "A chrome two-slot toaster on a tube. Push the lever down, toast comes out hot.",
	},

	-- Mythic ------------------------------------------------------------------------------
	RubberChickenRailgun = {
		name = "Rubber Chicken Railgun", rarity = "Mythic", style = "railgun",
		damage = 105, headshotMultiplier = 2.2, fireRate = 0.7, magSize = 3,
		reserveAmmo = 18, reloadTime = 3.0, range = 1400, spread = 0, pellets = 1,
		ability = "pierce",
		staged = true, groundWeight = 0, chestWeight = 0, plannedChestWeight = 0.18,
		killEffect = "vaporize",
		description = "A rubber chicken stretched along a coil rail. It screams every single time.",
	},
	LavaLampLancer = {
		name = "Lava Lamp Lancer", rarity = "Mythic", style = "rifle",
		damage = 48, headshotMultiplier = 2.0, fireRate = 3.2, magSize = 12,
		reserveAmmo = 60, reloadTime = 2.4, range = 700, spread = 0.3, pellets = 1,
		ability = "lifesteal", lifestealRatio = 0.2, ignite = { damage = 15, duration = 3 },
		staged = true, groundWeight = 0, chestWeight = 0, plannedChestWeight = 0.18,
		killEffect = "burn",
		description = "The receiver is a lava lamp. The wax rises while you hold it.",
	},

	-- Secret ------------------------------------------------------------------------------
	SnowGlobeSingularity = {
		name = "Snow Globe Singularity", rarity = "Secret", style = "blaster",
		damage = 30, headshotMultiplier = 1.8, fireRate = 5, magSize = 20,
		reserveAmmo = 100, reloadTime = 2.2, range = 380, spread = 0.9, pellets = 1,
		ability = "chain", chainRadius = 10, chainRatio = 0.3,
		chill = { slow = 0.12, duration = 2, stacks = 3, freeze = 0.6 },
		staged = true, groundWeight = 0, chestWeight = 0, plannedChestWeight = 0.045,
		killEffect = "freeze",
		description = "A tiny town in a snow globe on a brass frame. Three hits and they're part of the scenery.",
	},
	GrandmasSlipperLauncher = {
		name = "Grandma's Slipper Launcher", rarity = "Secret", style = "crossbow",
		-- Headshots reach projectile rounds again (a round striking a Head counts), so this carries a real
		-- multiplier once more. 2.2 rather than its old 2.5, and the fireRate back to 0.9: 2.5 x (90 + 10)
		-- would be a 250 hit, a one-shot through a full 200 pool and the hardest in the game on a round
		-- that homes. 2.2 puts it under QuietHours (225.6) and the RubberChickenRailgun (231), in the same
		-- family as the other slow, high-damage guns. The 1.15 rate was raised to reach the Secret DPS
		-- band and never did (103.5 against a 119 floor), so nothing is lost putting it back.
		-- Measured since (projectile_probe, IMPACT homing): the steer takes the target's ROOT, so a homing
		-- hit aimed at a head lands 100 on the torso with headshot = false, and against a peeker with only
		-- a head showing the round follows the root into the wall and hits nobody. The multiplier is
		-- therefore reachable only when a head is what the round meets on its way to the root -- it cannot
		-- be aimed for. Don't read a low headshot rate here as the multiplier going to waste.
		damage = 90, headshotMultiplier = 2.2, fireRate = 0.9, magSize = 4,
		reserveAmmo = 20, reloadTime = 2.6, range = 420, spread = 0.4, pellets = 1,
		ability = "goldRush", goldRushBonus = 150, projectile = "homingSlipper",
		staged = true, groundWeight = 0, chestWeight = 0, plannedChestWeight = 0.045,
		killEffect = "gold",
		description = "A fuzzy house slipper on a spring-loaded launcher. It always finds you.",
	},
}

return Pack
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">CreativeRounds</string><ProtectedString name="Source">-- The creative guns' own rounds, registered into Ballistics' round registry by kind (WeaponData
-- `projectile`). Required by CreativeArsenal, so the kinds exist wherever WeaponData is loaded -- on the
-- server before ProjectileService looks one up, and on the client for whatever draws them.
--
-- Callbacks run on the server only and reach server tools through the `api` ProjectileService passes
-- (Targets, DealDamage, ...); nothing here requires a server module. A sweep contact on a flying round
-- is { Instance, Position, Normal, Distance }; a contact on a bouncing body is { instance, position,
-- normal, speed }, so both spellings are read.
--
--   ricochetDisc   Fidget Disc Launcher. Flies flat and fast; the first wall it meets it glances off
--                  (becoming a bouncing body), and whatever body it meets next it cuts -- a person takes
--                  the hit, anything else just stops it. Non-explosive.
--   homingSlipper  Grandma's Slipper Launcher. Flies at a moderate speed with a slight drop and, after a
--                  moment, curves toward the enemy most nearly ahead of it inside a 25-degree cone,
--                  turning at most 20 degrees over its whole flight. Non-explosive, hits hard.
--   lobbedToast    Toaster Mortar. Pops out with an upward kick and arcs under full gravity, bursting on
--                  the first thing it touches.
--
-- `look` is how ProjectileClient draws the round (claude-a4's contract, documented in ThrowableModels):
--   shape  "disc" | "slipper" | "toast" | "ball" | "box" | "cylinder"
--   size   studs, the longest dimension
--   color  Color3; trim (optional accent) and glow (optional neon accent) likewise
--   spin   "roll" (about its velocity) | "flat" (level, spinning like a frisbee) | "tumble" (end over
--          end) | "none" (nose along its velocity)
-- `steer` also runs on the client, against a client api whose Targets lists living characters near
-- the round, so the curve bends on screen as it does on the server. It must stay pure: it reads dt,
-- entry.age/velocity/position/owner/turned and api.Targets only, keeps its memory in entry.turned,
-- and uses no services, randomness or module state. onContact and onLaunch are server-only.

local Ballistics = require(script.Parent:WaitForChild("Ballistics"))

local CreativeRounds = {}

local HOMING_CONE = math.rad(25)
local HOMING_TOTAL = math.rad(20)
local HOMING_RATE = math.rad(90)
local HOMING_DELAY = 0.12
local HOMING_RANGE = 70
local TOAST_LIFT = 22

local function hitInstance(contact)
	return contact and (contact.Instance or contact.instance) or nil
end

local function isCharacter(instance)
	local model = instance and instance:FindFirstAncestorOfClass("Model")
	return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
end

CreativeRounds.ricochetDisc = Ballistics.RegisterRound("ricochetDisc", {
	motion = "free",
	speed = 150,
	gravityScale = 0.03,
	radius = 0.35,
	maxTime = 2.2,
	explosive = false,
	impactBonus = 0,
	restitution = 0.55,
	friction = 0.3,
	syncEvery = 0.1,
	look = { shape = "disc", size = 0.9, color = Color3.fromRGB(255, 80, 180), glow = Color3.fromRGB(90, 255, 200), spin = "flat" },
	onContact = function(entry, contact)
		if isCharacter(hitInstance(contact)) then
			return "detonate"
		end
		if not entry.ricocheted then
			entry.ricocheted = true
			return "bounce"
		end
		return "stop"
	end,
})

CreativeRounds.homingSlipper = Ballistics.RegisterRound("homingSlipper", {
	motion = "free",
	speed = 115,
	gravityScale = 0.08,
	radius = 0.4,
	maxTime = 3,
	explosive = false,
	impactBonus = 10,
	syncEvery = 0.08,
	look = { shape = "slipper", size = 1.1, color = Color3.fromRGB(255, 150, 190), trim = Color3.fromRGB(255, 240, 250), spin = "none" },
	steer = function(entry, dt, api)
		if entry.age &lt; HOMING_DELAY or (entry.turned or 0) &gt;= HOMING_TOTAL then
			return
		end
		local speed = entry.velocity.Magnitude
		if speed &lt; 1 then
			return
		end
		local forward = entry.velocity / speed
		local best, bestDot = nil, math.cos(HOMING_CONE)
		for _, target in ipairs(api.Targets(entry.position, HOMING_RANGE, entry.owner)) do
			local to = target.root.Position - entry.position
			local distance = to.Magnitude
			if distance &gt; 0.5 then
				local dot = (to / distance):Dot(forward)
				if dot &gt; bestDot then
					best, bestDot = to / distance, dot
				end
			end
		end
		if not best then
			return
		end
		local angle = math.acos(math.clamp(forward:Dot(best), -1, 1))
		local turn = math.min(angle, HOMING_RATE * dt, HOMING_TOTAL - (entry.turned or 0))
		if angle &lt;= 1e-4 or turn &lt;= 0 then
			return
		end
		local direction = forward:Lerp(best, turn / angle).Unit
		entry.turned = (entry.turned or 0) + turn
		entry.velocity = direction * speed
	end,
	onContact = function(entry, contact)
		if isCharacter(hitInstance(contact)) then
			return "detonate"
		end
		return "stop"
	end,
})

CreativeRounds.lobbedToast = Ballistics.RegisterRound("lobbedToast", {
	motion = "body",
	speed = 95,
	gravityScale = 1,
	radius = 0.3,
	maxTime = 4,
	impact = true,
	restitution = 0.2,
	friction = 0.6,
	impactBonus = 15,
	innerRadius = 3,
	wallDamage = 80,
	look = { shape = "toast", size = 0.8, color = Color3.fromRGB(206, 150, 80), trim = Color3.fromRGB(150, 96, 48), spin = "tumble" },
	onLaunch = function(entry)
		if entry.body then
			entry.body.velocity += Vector3.new(0, TOAST_LIFT, 0)
		end
	end,
})

return CreativeRounds
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">CrouchAnimation</string><ProtectedString name="Source">-- Crouching, as an animation rather than a held pose.
--
-- Nothing in this project can upload keyframed animation, so this is procedural — but procedural done
-- properly: every value here is a pure function of its arguments (how far into the crouch, how far the
-- body has WALKED, and the clock), the way Shared/CompanionAnimations is written. That means the gallery
-- can render any frame of it and tools/crouch_probe.lua can measure it, with no client running.
--
--   CrouchAnimation.Weight(elapsed, entering)   0..1, eased: 0.18 s in, 0.14 s out
--   CrouchAnimation.Segments(character)         { upper, lower, foot, length } measured off the rig
--   CrouchAnimation.Depth(segments, drop)       how high the hips ride over the soles while crouched
--   CrouchAnimation.Stride(character)           the step length, and the segments it came from
--   CrouchAnimation.Walk(speed, crouchSpeed)    0..1: how much walk cycle to mix over the idle
--   CrouchAnimation.Advance(phase, moved, ...)  turns studs travelled into cycle phase
--   CrouchAnimation.Foot(phase, ...)            where a sole is, relative to the hip (the probe's hook)
--   CrouchAnimation.Pose(state)                 { Root, Waist, Neck, hips, knees, ankles }
--   CrouchAnimation.Apply(joints, pose, weight) writes them onto Motor6Ds / AnimationConstraints
--
-- HOW THE FEET STAY PLANTED. The legs are not a pair of sine waves on the hip and knee — that was the
-- first cut, and it skated nearly a stud a cycle, because a FOLDED leg's foot swings far less than
-- sin(SWING) x its length. Instead each sole is given a target in the world and the leg is solved to
-- reach it:
--
--   * planted half-cycle: the sole holds still on the ground and slides backward through the body,
--     covering exactly the distance the body travels, so skate is zero by construction;
--   * swing half-cycle: it lifts and swings forward to meet the next plant;
--   * a two-link IK (upper leg, lower leg) turns that target into hip and knee angles, and the ankle
--     takes whatever is left over so the sole stays flat.
--
-- Measured by tools/crouch_probe.lua on a real R15: 0.00 studs of skate at any steady speed, 0.07 while
-- accelerating from a standstill to full crouch speed in 0.2 s, against a target of 0.35. (The residue is
-- the step length changing mid-step as the speed changes.) The sole is flat under the body at mid-stance
-- and rolls at most 30 degrees at the ends of the stride, which is toe-off and heel-strike.
--
-- The hips ride at `depth` over the soles, and depth comes from the body's OWN HipHeight — the same
-- number MatchService lowered to put the body down (MovementConfig.Crouch.HipScale). Pose and collision
-- can therefore never disagree: retune HipScale and the legs fold to match.
--
-- Lower body, spine and neck: the arms keep the gun pose (GunPoseClient), exactly like Parkour.ApplyPose.
-- The neck is here only to undo the chest's lean, so the body doesn't crouch staring at its own feet.

local CrouchAnimation = {}

CrouchAnimation.EnterTime = 0.18
CrouchAnimation.ExitTime = 0.14

-- The crouch itself, in degrees at full weight. The legs aren't in this list: they are solved.
local LEAN = 16
local WAIST = 10
-- The walk cycle, all as fractions of the LEG (hip joint to sole), so every avatar scales with it.
--
-- STEP is not taste: it is the longest step the foot can take before the ankle has to bend further than
-- an ankle bends. Crouched, the hips ride barely half a leg off the ground, and the further the foot
-- reaches from under them the more the ankle has to roll to keep the sole down. Measured across the
-- cycle by tools/crouch_probe.lua: 0.75 costs 30 degrees of roll at the ends of the stride, which is
-- toe-off and heel-strike; 0.88 costs 45, which is a broken foot. So the step is 0.75 and the cadence
-- (about 4.8 steps a second at crouch speed) follows from it, rather than the other way round.
--
-- STANCE is how far in front of the hips the feet sit. Crouching puts your hips BACK over your heels —
-- with the feet directly under them the ankle needs 63 degrees at mid-stance and the sole can never lie
-- flat. At 0.3 of a leg forward it needs 35, inside a real ankle, and the sole is flat where it matters.
local STEP = 0.75
local STANCE = 0.2 -- of the full stride, which works out at 0.3 of a leg
-- How high the swinging foot lifts, also of the stride: 0.077 of a stride is 0.115 of a leg, about a
-- quarter of a stud on a default rig. Enough to clear the ground and read as a step; more and the ankle
-- has to roll past its limit at the top of the swing.
local LIFT = 0.077
-- How far the ankle may bend to keep the sole flat, in degrees (toes down positive). Holding the foot
-- flat through the WHOLE cycle would want 74 degrees at the back of the stride, which is not a foot, it
-- is a break — a human ankle points to about 50. Clamped here, the heel simply comes up at the back
-- instead (toe-off, which is what a real foot does there) while mid-stance stays flat to under 2
-- degrees. Measured by tools/crouch_probe.lua, which asserts both ends of that.
local ANKLE_DOWN, ANKLE_UP = 50, 25
-- How much of the chest's lean the neck takes back out. The Root and the Waist together pitch the torso
-- 26 degrees over, and the head is bolted to the top of it: left alone, a crouching body stares at its
-- own feet. Not all of it — a crouch does drop the chin a little, and a head held perfectly level over a
-- folded body looks stuffed.
local HEAD_LEVEL = 0.85
local BOB = 1.4
-- The idle: breathing and a slow shift of weight, so a held crouch is never a statue.
local BREATH_RATE, BREATH = 1.6, 1.5
local SHIFT_RATE, SHIFT = 1.25, 2.2
-- Below this fraction of the crouch's own speed the walk cycle fades out into the idle.
local WALK_FADE = 0.12
-- The phase advances per stud travelled against the stride the CURRENT amplitude actually covers, or a
-- half-speed walk would skate as badly as the old formula did. Amplitude below this is treated as this
-- (the legs are barely moving there, and dividing by zero is worse).
local MIN_AMPLITUDE = 0.3

local rad, sin, cos = math.rad, math.sin, math.cos
local pi = math.pi
local TAU = pi * 2

local function smoothIn(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

-- 0..1 while crouching down, 1..0 while standing up. Going down eases out (it drops quickly, then
-- settles); standing up eases in (a push off the knees), so the two read as different movements.
function CrouchAnimation.Weight(elapsed, entering)
	if entering then
		local t = math.clamp(elapsed / CrouchAnimation.EnterTime, 0, 1)
		return 1 - (1 - t) * (1 - t)
	end
	local t = math.clamp(elapsed / CrouchAnimation.ExitTime, 0, 1)
	return 1 - smoothIn(t)
end

-- The leg, measured off the rig's own JOINTS: hip to knee, knee to ankle, ankle to sole.
--
-- NOT off the part sizes, which was the first cut and was wrong by a third: R15's leg parts OVERLAP, so
-- on a default rig their heights add up to 2.98 studs while the hip really sits 2.27 above the sole. A
-- pose built on the longer number reaches for ground that isn't there — the probe caught the soles a
-- third of a stud under the floor and the ankle bent to 92 degrees trying to stay flat.
--
-- Bone lengths are distances between joints, so they don't care what the body is doing when we measure:
-- this is safe to call on a character mid-animation, which is exactly when it is called.
function CrouchAnimation.Segments(character)
	-- A bone is measured between the two joint points that sit on the SAME part, in that part's own
	-- local space: the hip's socket and the knee's socket are both fixed points on the upper leg, so their
	-- distance is the thigh, whatever the body is doing and however the rig is being simulated. Measuring
	-- between WORLD points on different parts looks equivalent and isn't: a bot is a physics rig whose
	-- joints stretch slightly under load, and the gallery caught that reading a leg 6% long.
	local function pointOn(part, jointName, which)
		local joint = part and part:FindFirstChild(jointName)
		if not joint then
			return nil
		end
		if joint:IsA("Motor6D") then
			return (which == 0 and joint.C0 or joint.C1).Position
		end
		if joint:IsA("AnimationConstraint") then
			local attachment = which == 0 and joint.Attachment0 or joint.Attachment1
			return attachment and attachment.Position or nil
		end
		return nil
	end
	local upperPart = character and character:FindFirstChild("LeftUpperLeg")
	local lowerPart = character and character:FindFirstChild("LeftLowerLeg")
	local footPart = character and character:FindFirstChild("LeftFoot")
	-- On the upper leg: where it hangs from the hip (the hip joint's far end) and where the knee is.
	local hipOnUpper = pointOn(upperPart, "LeftHip", 1)
	local kneeOnUpper = pointOn(lowerPart, "LeftKnee", 0)
	-- On the lower leg: the knee's far end and the ankle.
	local kneeOnLower = pointOn(lowerPart, "LeftKnee", 1)
	local ankleOnLower = pointOn(footPart, "LeftAnkle", 0)
	-- On the foot: the ankle's far end, and the sole straight below it.
	local ankleOnFoot = pointOn(footPart, "LeftAnkle", 1)
	local segments
	if hipOnUpper and kneeOnUpper and kneeOnLower and ankleOnLower and ankleOnFoot and footPart then
		segments = {
			upper = (hipOnUpper - kneeOnUpper).Magnitude,
			lower = (kneeOnLower - ankleOnLower).Magnitude,
			foot = ankleOnFoot.Y + footPart.Size.Y / 2,
		}
	else
		-- A default R15, measured.
		segments = { upper = 1.04, lower = 0.99, foot = 0.24 }
	end
	segments.length = segments.upper + segments.lower + segments.foot
	return segments
end

-- How high the hip joints ride over the soles once the body has dropped by `drop` studs. Clamped so the
-- leg can always reach: fully folded it still spans a little, and fully straight it spans `length`.
function CrouchAnimation.Depth(segments, drop)
	local straight = segments.length
	local shortest = math.abs(segments.upper - segments.lower) + segments.foot + 0.15
	return math.clamp(straight - math.max(drop or 0, 0), shortest, straight - 0.05)
end

-- The ground a full cycle covers: two steps, each STEP of a leg. Takes the segments a caller already
-- has (this runs per body per frame) or a character to measure them from.
function CrouchAnimation.Stride(segments)
	if typeof(segments) == "Instance" or segments == nil then
		segments = CrouchAnimation.Segments(segments)
	end
	return math.max(segments.length * STEP, 0.4) * 2, segments
end

-- How much walk cycle to mix over the idle, from how fast the body is actually moving against the speed
-- a crouch-walk runs at.
function CrouchAnimation.Walk(speed, crouchSpeed)
	local fraction = (speed or 0) / math.max(crouchSpeed or 8.1, 0.1)
	return math.clamp((fraction - WALK_FADE) / (1 - WALK_FADE), 0, 1)
end

-- Studs travelled -&gt; cycle phase. The stride shrinks with the amplitude, so a half-speed walk takes half
-- the steps rather than the same steps with sliding feet.
function CrouchAnimation.Advance(phase, moved, stride, walk)
	local cycle = math.max(stride, 0.1) * math.max(walk or 1, MIN_AMPLITUDE)
	return ((phase or 0) + (moved or 0) / cycle * TAU) % TAU
end

-- Where one sole sits relative to its hip joint: `forward` studs ahead of it, `drop` studs below.
--
-- The cycle is halves: over the first (phase 0..pi) the foot is PLANTED, moving backward through the body
-- at exactly the rate the body advances; over the second it lifts and swings forward again. The other leg
-- runs half a cycle out, so one foot is always planted.
--
-- The reach uses the SAME amplitude Advance divides by — clamped the same way — because the two must
-- agree or the foot covers a different distance from the body: that mismatch was worth 0.22 studs of
-- skate at quarter speed on its own. Only the lift follows the raw walk blend.
function CrouchAnimation.Foot(phase, walk, stride, depth)
	walk = math.clamp(walk or 0, 0, 1)
	phase = (phase or 0) % TAU
	local reach = stride * 0.25 * math.max(walk, MIN_AMPLITUDE) -- half a step either side of the stance
	-- The feet sit forward of the hips, not under them: see STANCE. Both are tied to the stride so one
	-- leg measurement sets the whole shape of the walk.
	local stance = stride * STANCE
	local lift0 = stride * LIFT
	local forward, lift
	if phase &lt; pi then
		-- Planted: straight line from in front to behind, the same distance the body covers.
		forward = stance + reach - (phase / pi) * reach * 2
		lift = 0
	else
		-- Swing: back to the front on a raised arc. The curve is a cubic with its END SLOPES MATCHED to
		-- the planted half's, not an ease-in-out: eased, the foot would arrive still travelling forward
		-- with the body and stop dead the instant it landed, which reads as a stamp. Matching the slopes
		-- means the foot is already moving backward through the body at exactly ground speed when it
		-- touches down, so its speed over the ground is zero at the moment of contact. It also makes the
		-- foot carry on backward a little as it lifts and reach a little past the mark before settling —
		-- which is what a real swinging leg does.
		local t = (phase - pi) / pi
		forward = stance + reach * (((-8 * t + 12) * t - 2) * t - 1)
		lift = sin(t * pi) * lift0 * walk
	end
	return forward, depth - lift
end

-- Two-link IK: hip and knee angles (radians, forward positive) that put the ankle at (forward, drop)
-- relative to the hip, with the leg bending knee-first like a real one.
local function solveLeg(forward, drop, upper, lower)
	local reach = math.sqrt(forward * forward + drop * drop)
	local limit = (upper + lower) * 0.999
	local floor = math.abs(upper - lower) + 0.02
	reach = math.clamp(reach, floor, limit)
	-- Interior angle at the knee, then the angle the thigh makes with the straight line to the ankle.
	local knee = math.acos(math.clamp((upper * upper + lower * lower - reach * reach) / (2 * upper * lower), -1, 1))
	local thigh = math.acos(math.clamp((reach * reach + upper * upper - lower * lower) / (2 * reach * upper), -1, 1))
	local toTarget = math.atan2(forward, math.max(drop, 0.05))
	return toTarget + thigh, -(pi - knee)
end

-- The pose `state` describes. There is no weight here: the pose is always the full crouch, and Apply
-- does all the blending — that way one pose can be handed to several bodies at different stages of the
-- same move without being rebuilt.
--   phase       radians, from Advance
--   walk        0..1, from Walk
--   clock       os.clock(), for breathing
--   segments    from Segments
--   depth       from Depth
--   stride      from Stride
function CrouchAnimation.Pose(state)
	local segments = state.segments or CrouchAnimation.Segments(nil)
	local depth = state.depth or CrouchAnimation.Depth(segments, 0.94)
	local stride = state.stride or CrouchAnimation.Stride(segments)
	local walk = math.clamp(state.walk or 0, 0, 1)
	local phase = state.phase or 0
	local clock = state.clock or 0

	-- Idle: the spine breathes and the hips trade weight; both fade out as the walk comes in.
	local breath = sin(clock * BREATH_RATE) * BREATH * (1 - walk)
	local shift = sin(clock * SHIFT_RATE) * SHIFT * (1 - walk)
	-- Walk: the torso counter-bobs at twice the leg rate. The bob moves the HIPS, so it is taken out of
	-- the legs' targets below and the soles stay where they are.
	local bob = sin(phase * 2) * BOB * walk
	local lean = LEAN + bob

	-- The breath moves the WAIST, which is above the hips, so the legs owe it nothing.
	local rightForward, rightDrop = CrouchAnimation.Foot(phase, walk, stride, depth)
	local leftForward, leftDrop = CrouchAnimation.Foot(phase + pi, walk, stride, depth)

	-- The legs hang off LowerTorso, which the Root joint has just pitched forward by `lean`, so that
	-- pitch comes back out of the targets or the whole stance would tip with the torso.
	local pitch = rad(lean)
	local ankle = segments.foot
	--
	-- WHICH WAY THE PITCH GOES, since it is easy to get backwards and costs a stud when you do. Every R15
	-- joint here turns about its PARENT's X axis, so the angles down a limb simply add: a thigh's angle in
	-- the world is the Root's own turn plus the hip's. The Root leans the chest FORWARD on a NEGATIVE turn
	-- (Parkour.Poses agrees: the mantle leans in at -12 and the slide lies back at +48), so with `pitch`
	-- positive-forward the world thigh angle is hip - pitch. Turning a world target into the torso's own
	-- frame is therefore a turn of +pitch, which in (forward, down) terms is the pair below.
	local function leg(forward, drop)
		-- Ankle target, in the tilted torso's own frame, with the foot's own height taken off.
		local toAnkle = drop - ankle
		local x = forward * cos(pitch) + toAnkle * sin(pitch)
		local y = toAnkle * cos(pitch) - forward * sin(pitch)
		local hip, knee = solveLeg(x, y, segments.upper, segments.lower)
		-- Whatever the chain adds up to, the ankle takes back out, so the sole stays flat: the foot's own
		-- angle in the world is -pitch + hip + knee + ankle, and that has to come to nothing — as far as
		-- an ankle can, anyway.
		return hip, knee, math.clamp(pitch - hip - knee, -rad(ANKLE_UP), rad(ANKLE_DOWN))
	end
	local rightHip, rightKnee, rightAnkle = leg(rightForward, rightDrop)
	local leftHip, leftKnee, leftAnkle = leg(leftForward, leftDrop)

	-- The joints add down the chain, so the head's own angle in the world is -(lean) + -(WAIST - breath)
	-- plus whatever the neck does; this gives most of that back.
	local stoop = lean + WAIST - breath
	return {
		Root = CFrame.Angles(rad(-lean), 0, rad(shift * 0.5)),
		Waist = CFrame.Angles(rad(-WAIST + breath), 0, rad(-shift * 0.35)),
		Neck = CFrame.Angles(rad(stoop * HEAD_LEVEL), 0, rad(-shift * 0.25)),
		RightHip = CFrame.Angles(rightHip, 0, rad(shift * 0.2)),
		RightKnee = CFrame.Angles(rightKnee, 0, 0),
		RightAnkle = CFrame.Angles(rightAnkle, 0, 0),
		LeftHip = CFrame.Angles(leftHip, 0, rad(-shift * 0.2)),
		LeftKnee = CFrame.Angles(leftKnee, 0, 0),
		LeftAnkle = CFrame.Angles(leftAnkle, 0, 0),
	}
end

-- Writes a pose onto the joints (Shared/Parkour.PoseJoints finds them), blending over whatever the
-- Animator wrote this frame. Arms are never touched.
--
-- TWO WEIGHTS, and the reason matters. The body's height is not eased by anyone: MatchService sets
-- HipHeight the moment a crouch starts and the moment it ends, so the hips are DOWN on the very next
-- frame. Easing the legs into the fold over the same moment would leave them straighter than the hips
-- are low — feet through the floor going down, feet in the air coming up. So the legs take the body's
-- own timing (`legs`, normally 1 while crouched and 0 while not) and only the spine eases, which is the
-- part of the transition an ease actually reads on.
function CrouchAnimation.Apply(joints, pose, weight, legs)
	weight = math.clamp(weight == nil and 1 or weight, 0, 1)
	legs = math.clamp(legs == nil and weight or legs, 0, 1)
	if weight &lt;= 0 and legs &lt;= 0 then
		return
	end
	for name, target in pairs(pose) do
		local joint = joints[name]
		-- The neck exists to undo the spine's lean, so it has to ease with the spine. On the legs' timing
		-- it would be fully counter-rotated while the chest was only half over, and the head would tip UP.
		local blend = (name == "Root" or name == "Waist" or name == "Neck") and weight or legs
		if joint and blend &gt; 0 then
			joint.Transform = blend &gt;= 1 and target or joint.Transform:Lerp(target, blend)
		end
	end
end

return CrouchAnimation
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">DailySpinData</string><ProtectedString name="Source">-- The Daily Spin: a wheel of nine prizes, spun once a day at the booth in the lobby (or the
-- DAILY button on the Pass tab, which is the same spin). Which segment it lands on is rolled
-- server-side by weight; the wheel then turns to it for everyone to see.
--
-- Consecutive days build a streak, and the streak multiplies the coin prizes (StreakBonus per
-- day, capped). Any gap starts the streak over.
--
--   Coins      SahurCoins, times the streak multiplier
--   Crate      one crate of that tier
--   Accessory  a shop accessory you don't own yet (Common to Epic by weight); coins if you own them all
--   Brainrot   a Rare or Epic brainrot straight into your collection (a Legendary 5% of the time)
--   TempPass   one of the gamepasses you don't own, for 24 hours; coins if you own them all

local DailySpinData = {}

-- Weights add up to 100, so each one reads straight off as a percentage.
--
-- The old table paid 500 coins on nearly a quarter of all spins, in a game where finishing first
-- pays 2,500 and a Legendary Crate. That made the likeliest outcome of your one daily spin a
-- shrug. The floor is now worth collecting, the jackpot is worth hoping for, and the top of the
-- wheel carries the same Legendary Crate a first-place finish does — so there's a reason to come
-- back and spin rather than a formality to click through.
DailySpinData.Segments = {
	{ id = "coins1200", label = "1,200 C", kind = "Coins", amount = 1200, weight = 20, color = Color3.fromRGB(255, 196, 64) },
	{ id = "rareCrate", label = "RARE CRATE", kind = "Crate", crate = "Rare", weight = 15, color = Color3.fromRGB(80, 170, 255) },
	{ id = "coins3000", label = "3,000 C", kind = "Coins", amount = 3000, weight = 14, color = Color3.fromRGB(255, 226, 120) },
	{ id = "accessory", label = "ACCESSORY", kind = "Accessory", weight = 10, color = Color3.fromRGB(255, 110, 200),
		rarities = { Common = 25, Uncommon = 30, Rare = 28, Epic = 17 } },
	{ id = "epicCrate", label = "EPIC CRATE", kind = "Crate", crate = "Epic", weight = 10, color = Color3.fromRGB(190, 120, 255) },
	{ id = "brainrot", label = "BRAINROT", kind = "Brainrot", weight = 10, color = Color3.fromRGB(94, 214, 122),
		rarities = { Rare = 55, Epic = 40, Legendary = 5 } },
	{ id = "pass", label = "PASS FOR A DAY", kind = "TempPass", hours = 24, weight = 11, color = Color3.fromRGB(110, 210, 255) },
	{ id = "legendaryCrate", label = "LEGENDARY CRATE", kind = "Crate", crate = "Legendary", weight = 5,
		color = Color3.fromRGB(255, 146, 38) },
	{ id = "jackpot", label = "15,000 C", kind = "Coins", amount = 15000, weight = 5, color = Color3.fromRGB(232, 92, 92) },
}

-- Coins pay +10% per streak day beyond the first, up to double.
DailySpinData.StreakBonus = 0.1
DailySpinData.StreakCap = 10

function DailySpinData.StreakMultiplier(streak)
	return 1 + DailySpinData.StreakBonus * math.clamp((streak or 1) - 1, 0, DailySpinData.StreakCap)
end

-- A segment index, by weight.
function DailySpinData.Roll()
	local total = 0
	for _, segment in ipairs(DailySpinData.Segments) do
		total += segment.weight
	end
	local value = math.random() * total
	for index, segment in ipairs(DailySpinData.Segments) do
		value -= segment.weight
		if value &lt;= 0 then
			return index
		end
	end
	return #DailySpinData.Segments
end

return DailySpinData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">DeathEffectDesigns</string><ProtectedString name="Source">-- The death effects themselves (#24; CosmeticData kind "KillAnimation", "Death Effects" on screen),
-- keyed by CosmeticData id, built on Shared/DeathEffectFx. Read that file first: it explains the
-- timeline, the budgets and what a design may do to the body.
--
-- Every design runs in four beats, because that is what makes an effect read at a glance from
-- across a street rather than as a pile of parts:
--   anticipation  the body reacts first (winds up, flushes a colour, looks up at what's coming)
--   burst         the one big moment: a flash, a light, the sound, the body popped or flattened
--   follow-through the pieces carry on and overshoot (arcs, bounces, a wobble that settles)
--   settle        everything eases out and fades, and the body is gone by the end
--
-- Fields per design:
--   life     seconds (DeathEffectFx.MAX_LIFETIME at most); the body is gone by then
--   peak     the moment a thumbnail shows (the burst, just after the flash)
--   moments  three stills for the gallery: anticipation, burst, follow-through
--   view     where a preview camera looks, relative to the feet: focus and a radius to fit
--   cues     every SoundConfig cue it plays (the harness checks each exists)
--   build    function(fx): declares the whole timeline up front; fx:step does the rest
--
-- `Default` holds the plain death's two little effects (DeathFxClient), which are not cosmetics.

local Shared = script.Parent
local DeathEffectFx = require(Shared:WaitForChild("DeathEffectFx"))

local Ease = DeathEffectFx.Ease
local V = Vector3.new
local UPRIGHT = DeathEffectFx.UPRIGHT
local BALL = Enum.PartType.Ball
local CYLINDER = Enum.PartType.Cylinder
local NEON = Enum.Material.Neon
local SMOOTH = Enum.Material.SmoothPlastic
local WOOD = Enum.Material.Wood
local GLASS = Enum.Material.Glass
local FOIL = Enum.Material.Foil
local SLATE = Enum.Material.Slate
local BASALT = Enum.Material.Basalt

local rgb = Color3.fromRGB
local WHITE = rgb(255, 255, 255)
local CONFETTI = { rgb(255, 120, 190), rgb(70, 214, 236), rgb(255, 214, 64), rgb(80, 220, 120), rgb(150, 80, 240), rgb(255, 132, 36) }
local GOO = rgb(150, 196, 96)
local GOO_DARK = rgb(96, 140, 56)
local GOO_GLOW = rgb(178, 255, 102)
local BAT = rgb(168, 122, 72)
local GRIP = rgb(60, 40, 30)
local TAPE = rgb(206, 48, 48)
local STAR = rgb(255, 214, 64)
local DUST = rgb(200, 186, 160)
local GHOST = rgb(214, 236, 255)
local GHOST_GLOW = rgb(170, 220, 255)
local EYE = rgb(24, 24, 28)
local DRUM = rgb(206, 150, 80)
local DRUM_HEAD = rgb(244, 226, 190)
local RIM = rgb(206, 48, 48)
local STAMP = rgb(255, 132, 36)
local GOLD = rgb(255, 196, 64)
local GOLD_PALE = rgb(255, 238, 160)
local BRAIN = rgb(255, 150, 176)
local BRAIN_DARK = rgb(206, 92, 124)
local BRAIN_HOT = rgb(255, 90, 160)
local BALLOONS = { rgb(255, 84, 104), rgb(70, 190, 255), rgb(255, 214, 64) }
local STRING = rgb(236, 236, 236)
local INK = rgb(34, 22, 52)
local INK_EDGE = rgb(150, 60, 255)
local CYAN = rgb(60, 240, 255)
local MAGENTA = rgb(255, 60, 220)
local STORM = rgb(58, 60, 72)
local STORM_LIGHT = rgb(96, 100, 118)
local BOLT = rgb(210, 236, 255)
local CHAR = rgb(26, 22, 20)
local ASH = rgb(96, 92, 88)
local ICE = rgb(150, 226, 255)
local ICE_WHITE = rgb(236, 250, 255)
local ROT = rgb(110, 200, 70)
local ROT_DARK = rgb(52, 110, 40)
local MUD = rgb(96, 78, 52)
local ROCK = rgb(70, 58, 52)
local MAGMA = rgb(255, 110, 20)
local EMBER = rgb(255, 196, 60)
local SCORCH = rgb(30, 22, 20)
local VOID = rgb(6, 4, 10)
local VIOLET = rgb(150, 70, 255)
local ORCHID = rgb(255, 90, 230)
local SOUL = rgb(170, 255, 200)

local function where(at)
	if type(at) == "function" then
		return at()
	end
	return at
end

-- Deterministic shiver: two sines out of step, -1..1.
local function shiver(t, seed)
	return math.sin(t * 83.1 + seed * 12.7) * 0.6 + math.sin(t * 47.3 + seed * 5.1) * 0.4
end

-- A neon ball that swells and fades: the flash of a pop.
local function flash(fx, t, at, color, size, duration)
	fx:at(t, function()
		local ball = fx:part(V(1, 1, 1), CFrame.new(where(at)), color, NEON, BALL, 0.05)
		if not ball then
			return
		end
		fx:tween(t, duration, function(e)
			local d = 1 + (size - 1) * e
			ball.Size = V(d, d, d)
			ball.Transparency = 0.05 + 0.95 * e
		end, Ease.quadOut)
	end)
end

-- A flat neon disc racing outwards and fading: a shockwave. `turn` tilts it off the ground.
local function shock(fx, t, at, color, from, to, duration, turn)
	fx:at(t, function()
		local disc = fx:part(V(0.12, from, from), CFrame.new(where(at)) * (turn or CFrame.identity) * UPRIGHT, color, NEON, CYLINDER, 0.3)
		if not disc then
			return
		end
		fx:tween(t, duration, function(e)
			local d = from + (to - from) * e
			disc.Size = V(0.12, d, d)
			disc.Transparency = 0.3 + 0.7 * e
		end, Ease.quadOut)
	end)
end

local function disc(fx, at, diameter, color, material, transparency, thick)
	return fx:part(V(thick or 0.1, diameter, diameter), CFrame.new(at) * UPRIGHT, color, material, CYLINDER, transparency)
end

-- Transparency from what it is now to 1.
local function fadeOut(fx, part, t, duration)
	if not part then
		return
	end
	local base = part.Transparency
	fx:tween(t, duration, function(e)
		part.Transparency = base + (1 - base) * e
	end, Ease.quadIn)
end

-- Where something thrown from `p0` at `v` is after `tau` seconds under `gravity`, bouncing once off
-- `floor` (keeping `bounce` of its speed) and sliding to a stop.
local function hop(p0, v, gravity, tau, floor, bounce)
	local y = p0.Y + v.Y * tau - 0.5 * gravity * tau * tau
	if y &gt;= floor then
		return V(p0.X + v.X * tau, y, p0.Z + v.Z * tau), false
	end
	local a, b, c = -0.5 * gravity, v.Y, p0.Y - floor
	local land = (-b - math.sqrt(math.max(0, b * b - 4 * a * c))) / (2 * a)
	local after = tau - land
	local up = -(v.Y - gravity * land) * (bounce or 0.3)
	local rise = math.max(0, up * after - 0.5 * gravity * after * after)
	local slide = land + math.min(after, 0.5) * 0.35
	return V(p0.X + v.X * slide, floor + rise, p0.Z + v.Z * slide), true
end

local Designs = {}

--------------------------------------------------------------------------------
-- Common
--------------------------------------------------------------------------------

-- They wind up like a spring and POP: streamers, confetti and a popper left smoking on the spot.
Designs.KillConfettiPop = {
	life = 2.4,
	peak = 0.42,
	moments = { 0.2, 0.42, 1.3 },
	view = { focus = V(0, 3.4, 0), radius = 8 },
	cues = { "DeathFuse", "Confetti" },
	build = function(fx)
		local g = fx.ground
		local chest = fx.origin + V(0, 0.8, 0)
		local POP = 0.3

		-- Anticipation: squash down, then stretch up and flush white.
		fx:sound(0, "DeathFuse", 0.1)
		fx:tween(0, 0.18, function(e)
			fx:bodyPose({ scale = V(1 + 0.12 * e, 1 - 0.2 * e, 1 + 0.12 * e) })
		end, Ease.quadOut)
		fx:tween(0.18, POP - 0.18, function(e)
			fx:bodyPose({ scale = V(1.12 - 0.22 * e, 0.8 + 0.42 * e, 1.12 - 0.22 * e), tint = WHITE, tintAlpha = 0.75 * e })
		end, Ease.backIn)
		fx:burst(0.02, chest + V(0, 1.6, 0), { count = 6, color = { STAR, WHITE }, texture = "sparks", size = { 0.35, 0 },
			speed = { 3, 6 }, life = { 0.2, 0.35 }, spread = 40, glow = 1 })

		-- Burst.
		fx:sound(POP, "Confetti", 0.15)
		fx:at(POP, function()
			fx:hideBody()
		end)
		flash(fx, POP, chest, rgb(255, 236, 246), 7, 0.3)
		fx:light(POP, 0.5, chest, CONFETTI[1], 18, 6)
		fx:burst(POP, chest, { count = 16, color = { CONFETTI[1], CONFETTI[3], CONFETTI[2] }, texture = "sparkle", size = { 0.55, 0.2 },
			speed = { 14, 22 }, life = { 0.8, 1.5 }, accel = V(0, -18, 0), drag = 1.4, spin = 300, glow = 0.6 })
		fx:burst(POP, chest, { count = 14, color = { CONFETTI[4], CONFETTI[5], CONFETTI[6] }, texture = "sparkle", size = { 0.5, 0.2 },
			speed = { 10, 18 }, life = { 0.8, 1.6 }, accel = V(0, -16, 0), drag = 1.6, spin = 300, glow = 0.6 })
		fx:burst(POP + 0.05, chest + V(0, 1, 0), { count = 10, color = { GOLD_PALE, GOLD }, texture = "sparkle", size = { 0.3, 0.1 },
			speed = { 2, 5 }, life = { 1.2, 1.9 }, accel = V(0, -2, 0), drag = 1, glow = 1 })

		-- Streamers: out and up with the pop, then fluttering down to lie flat.
		fx:at(POP, function()
			for index = 1, 14 do
				local angle = index / 14 * math.pi * 2 + fx.random:NextNumber() * 0.4
				local out = V(math.cos(angle), 0, math.sin(angle))
				local peak = chest + out * (2.4 + fx.random:NextNumber() * 2.4) + V(0, 3 + fx.random:NextNumber() * 3, 0)
				local land = V(peak.X, g.Y + 0.06, peak.Z) + out * (0.8 + fx.random:NextNumber())
				local spinA, spinB = fx.random:NextNumber() * 9 + 4, fx.random:NextNumber() * 9 + 4
				local streamer = fx:part(V(0.6, 0.08, 0.26), CFrame.new(chest), CONFETTI[index % #CONFETTI + 1], NEON)
				if streamer then
					fx:tween(POP, 0.4, function(e)
						streamer.CFrame = CFrame.new(chest:Lerp(peak, e)) * CFrame.Angles(e * spinA, e * spinB, 0)
					end, Ease.quadOut)
					local fall = 1.65 - index * 0.02
					fx:tween(POP + 0.4, fall, function(e, raw)
						local sway = math.sin(raw * math.pi * 3 + index) * 0.7 * (1 - raw)
						local settle = math.clamp((raw - 0.8) / 0.2, 0, 1)
						local position = peak:Lerp(land, e) + out * sway
						local tumble = CFrame.Angles((1 - settle) * (spinA + raw * 8), (spinB + raw * 5), 0)
						streamer.CFrame = CFrame.new(position) * tumble:Lerp(CFrame.Angles(0, spinB, 0), settle)
					end, Ease.sineInOut)
					fadeOut(fx, streamer, 2.0, 0.35)
				end
			end
		end)

		-- The popper, left smoking where they stood.
		fx:at(POP, function()
			local lean = CFrame.Angles(math.rad(18), fx.random:NextNumber() * math.pi * 2, 0)
			local base = CFrame.new(g) * lean
			local tube = fx:part(V(1.5, 0.9, 0.9), base * CFrame.new(0, 0.75, 0) * UPRIGHT, CONFETTI[5], SMOOTH, CYLINDER)
			local rim = fx:part(V(0.18, 1.1, 1.1), base * CFrame.new(0, 1.5, 0) * UPRIGHT, STAR, NEON, CYLINDER)
			fx:tween(POP, 0.3, function(e, raw)
				local s = math.max(0.05, e)
				if tube then
					tube.Size = V(1.5 * s, 0.9 * s, 0.9 * s)
					tube.CFrame = base * CFrame.new(0, 0.75 * s, 0) * UPRIGHT
				end
				if rim then
					rim.Size = V(0.18, 1.1 * s, 1.1 * s)
					rim.CFrame = base * CFrame.new(0, 1.5 * s, 0) * UPRIGHT
				end
			end, Ease.backOut)
			fx:tween(1.9, 0.45, function(e)
				if tube then
					tube.CFrame = base * CFrame.new(0, 0.75 - 1.6 * e, 0) * UPRIGHT
				end
				if rim then
					rim.CFrame = base * CFrame.new(0, 1.5 - 1.6 * e, 0) * UPRIGHT
				end
			end, Ease.quadIn)
			fadeOut(fx, tube, 2.0, 0.35)
			fadeOut(fx, rim, 2.0, 0.35)
			fx:burst(POP + 0.05, (base * CFrame.new(0, 1.6, 0)).Position, { count = 8, color = { rgb(255, 214, 236), rgb(160, 150, 170) },
				texture = "smoke", size = { 0.8, 2.4 }, speed = { 2, 4 }, life = { 0.9, 1.4 }, spread = 25, direction = lean.UpVector,
				accel = V(0, 2, 0), glow = 0, fade = 0.3 })
		end)
	end,
}

-- They go green, tremble and melt into a bubbling puddle that ripples, stinks and dries up.
Designs.KillRotPuddle = {
	life = 2.8,
	peak = 0.95,
	moments = { 0.25, 0.8, 1.7 },
	view = { focus = V(0, 2.6, 0), radius = 7.5 },
	cues = { "StickySquelch", "DeathBubble" },
	build = function(fx)
		local g, pivot = fx.ground, fx.pivot
		local MELT = 0.35

		-- Anticipation: rot creeps over them and they tremble.
		fx:tween(0, MELT, function(e, raw)
			fx:bodyPose({ to = pivot * CFrame.new(shiver(raw * MELT, 1) * 0.08 * e, 0, shiver(raw * MELT, 2) * 0.06 * e),
				scale = V(1, 1, 1), tint = GOO, tintAlpha = 0.85 * e })
		end, Ease.sineInOut)

		-- Burst: down they go, spreading as they sink.
		fx:sound(MELT - 0.05, "StickySquelch", 0.15)
		fx:tween(MELT, 0.75, function(e)
			fx:bodyPose({ scale = V(1 + 0.6 * e, 1 - 0.94 * e, 1 + 0.6 * e), fade = 0.25 * e })
		end, Ease.quadIn)
		fx:tween(MELT + 0.6, 0.25, function(e)
			fx:bodyPose({ fade = 0.25 + 0.75 * e })
		end)

		local puddle = disc(fx, g + V(0, 0.06, 0), 0.4, GOO, SMOOTH, 0.12, 0.12)
		local core = disc(fx, g + V(0, 0.1, 0), 0.3, GOO_DARK, SMOOTH, 0.1, 0.1)
		fx:tween(MELT, 0.8, function(e)
			if puddle then
				puddle.Size = V(0.12, 0.4 + 8.2 * e, 0.4 + 8.2 * e)
			end
			if core then
				core.Size = V(0.1, 0.3 + 5 * e, 0.3 + 5 * e)
			end
		end, Ease.backOut)
		fx:burst(MELT + 0.1, g + V(0, 0.6, 0), { count = 18, color = { GOO_GLOW, GOO_DARK }, texture = "glow", size = { 0.5, 0.15 },
			speed = { 8, 14 }, life = { 0.5, 0.8 }, spread = 50, accel = V(0, -40, 0), glow = 0.3 })
		fx:light(MELT, 0.9, g + V(0, 1, 0), GOO_GLOW, 14, 2.5)

		-- Follow-through: bubbles swell, rise a little and pop; the surface ripples.
		for index = 1, 5 do
			local angle = index * 2.4
			local radius = 0.8 + (index % 3) * 0.9
			local at = g + V(math.cos(angle) * radius, 0.25, math.sin(angle) * radius)
			local start = 0.95 + index * 0.17
			local bubble = fx:part(V(0.05, 0.05, 0.05), CFrame.new(at), index % 2 == 0 and GOO_GLOW or GOO, SMOOTH, BALL, 1)
			fx:tween(start, 0.4, function(e)
				if bubble then
					local d = 0.2 + 0.95 * e
					bubble.Size = V(d, d, d)
					bubble.CFrame = CFrame.new(at + V(0, 0.55 * e, 0))
					bubble.Transparency = 0.15
				end
			end, Ease.backOut)
			fx:at(start + 0.42, function()
				if bubble then
					bubble.Transparency = 1
				end
			end)
			if index % 2 == 1 then
				fx:burst(start + 0.42, at + V(0, 0.6, 0), { count = 4, color = GOO_GLOW, texture = "glow", size = { 0.3, 0 },
					speed = { 3, 5 }, life = { 0.25, 0.4 }, spread = 60, accel = V(0, -20, 0) })
			end
		end
		fx:sound(1.35, "DeathBubble", 0.25, g)
		fx:sound(1.8, "DeathBubble", 0.25, g)
		shock(fx, MELT + 0.75, g + V(0, 0.14, 0), GOO_GLOW, 4, 10, 0.6)
		fx:burst(1.2, g + V(0, 0.8, 0), { count = 10, color = { GOO, rgb(120, 140, 90) }, texture = "smoke", size = { 1, 2.6 },
			speed = { 1, 2 }, life = { 1, 1.4 }, spread = 30, accel = V(0, 1.5, 0), glow = 0, fade = 0.45 })

		-- Settle: the puddle dries up.
		fx:tween(2.1, 0.6, function(e)
			if puddle then
				puddle.Size = V(0.12, 8.6 - 7.8 * e, 8.6 - 7.8 * e)
				puddle.Transparency = 0.12 + 0.88 * e
			end
			if core then
				core.Size = V(0.1, 5.3 - 5 * e, 5.3 - 5 * e)
				core.Transparency = 0.1 + 0.9 * e
			end
		end, Ease.quadIn)
	end,
}

-- They float off under three balloons, drifting and turning, until one pops.
Designs.KillBalloonFloat = {
	life = 3.1,
	peak = 1.2,
	moments = { 0.3, 1.1, 2.4 },
	view = { focus = V(0, 6.5, 0), radius = 10 },
	cues = { "DeathBalloonInflate", "DeathBalloonPop" },
	build = function(fx)
		local pivot = fx.pivot
		local LIFT = 0.45
		local RISE = 12
		local POP = 2.35
		-- Where the whole body is at `raw` (0..1) through the climb: slow, then faster, with a sway.
		local function bodyFrame(t)
			local climb = math.max(0, t - LIFT)
			local height = RISE * (climb / (3 - LIFT)) ^ 1.6
			local sway = math.sin(climb * 3.1) * 0.12 * math.min(1, climb * 2)
			return pivot * CFrame.new(0, height, 0) * CFrame.Angles(0, climb * 0.9, sway)
		end

		fx:sound(0, "DeathBalloonInflate", 0.1)
		-- Hands up, where the strings will be.
		local anchors = { V(-1.5, 2.4, 0), V(0, 4.8, 0.3), V(1.5, 2.4, 0) }
		local offsets = { V(-2.1, 9.2, 0.4), V(0.2, 10.4, -0.3), V(2.3, 9, 0.2) }
		local balloons = {}
		for index = 1, 3 do
			local balloon = fx:part(V(0.05, 0.05, 0.05), bodyFrame(0) * CFrame.new(offsets[index]), BALLOONS[index], SMOOTH, BALL, 0.05)
			local knot = fx:part(V(0.3, 0.3, 0.3), bodyFrame(0) * CFrame.new(offsets[index] - V(0, 1.3, 0)), BALLOONS[index], SMOOTH, BALL, 1)
			local line = fx:part(V(0.06, 0.06, 0.06), bodyFrame(0) * CFrame.new(anchors[index]), STRING, SMOOTH, nil, 1)
			balloons[index] = { balloon = balloon, knot = knot, line = line }
			if balloon then
				balloon.Reflectance = 0.15
			end
		end

		-- Every frame from the start: each balloon inflating (springy, one after another: the
		-- anticipation), then the body on its climb with the balloons bobbing above it.
		fx:tween(0, 3.1, function(_, raw)
			local t = raw * 3.1
			local frame = bodyFrame(t)
			if t &gt;= LIFT then
				fx:bodyPose({ to = frame })
			end
			for index, entry in ipairs(balloons) do
				local bob = V(math.sin(t * 2.3 + index) * 0.25, math.sin(t * 3.1 + index * 2) * 0.2, 0)
				local top = frame * CFrame.new(offsets[index] + bob)
				local grown = math.max(0.05, Ease.elasticOut(math.clamp((t - index * 0.08) / 0.4, 0, 1)))
				-- Settle: after the middle one pops, they all drift out of sight.
				local gone = Ease.quadIn(math.clamp((t - 2.3) / 0.65, 0, 1))
				local shown = grown &gt; 0.06 and gone or 1
				if entry.balloon then
					entry.balloon.Size = V(2.1, 2.5, 2.1) * grown
					entry.balloon.CFrame = top
					entry.balloon.Transparency = (index == 2 and t &gt;= POP) and 1 or math.max(0.05, shown)
				end
				local knotAt = top * CFrame.new(0, -1.3 * grown, 0)
				if entry.knot then
					entry.knot.CFrame = knotAt
					entry.knot.Transparency = shown
				end
				if entry.line then
					entry.line.Transparency = math.max(0.1, shown)
					local hand = (frame * CFrame.new(anchors[index])).Position
					local length = (knotAt.Position - hand).Magnitude
					entry.line.Size = V(0.06, 0.06, math.max(0.05, length))
					entry.line.CFrame = CFrame.lookAt((hand + knotAt.Position) / 2, knotAt.Position)
				end
			end
		end)
		fx:burst(0.9, function()
			return (bodyFrame(0.9) * CFrame.new(0, 0.2, 0)).Position
		end, { count = 6, color = { WHITE, BALLOONS[2] }, texture = "sparkle", size = { 0.4, 0 }, speed = { 1, 2 },
			life = { 0.6, 1 }, accel = V(0, -3, 0), glow = 1 })
		fx:burst(1.6, function()
			return (bodyFrame(1.6) * CFrame.new(0, 0.2, 0)).Position
		end, { count = 6, color = { WHITE, BALLOONS[1] }, texture = "sparkle", size = { 0.4, 0 }, speed = { 1, 2 },
			life = { 0.6, 1 }, accel = V(0, -3, 0), glow = 1 })

		fx:sound(POP, "DeathBalloonPop", 0.1, function()
			return (bodyFrame(POP) * CFrame.new(offsets[2])).Position
		end)
		flash(fx, POP, function()
			return (bodyFrame(POP) * CFrame.new(offsets[2])).Position
		end, BALLOONS[2], 3.5, 0.2)
		fx:light(POP, 0.35, function()
			return (bodyFrame(POP) * CFrame.new(offsets[2])).Position
		end, BALLOONS[2], 14, 3)
		fx:burst(POP, function()
			return (bodyFrame(POP) * CFrame.new(offsets[2])).Position
		end, { count = 10, color = { BALLOONS[2], WHITE }, texture = "sparkle", size = { 0.45, 0 }, speed = { 6, 10 },
			life = { 0.3, 0.5 }, glow = 0.8 })
		fx:tween(2.3, 0.65, function(e)
			fx:bodyPose({ fade = e })
		end, Ease.quadIn)
	end,
}

--------------------------------------------------------------------------------
-- Uncommon
--------------------------------------------------------------------------------

-- A bat the size of a lamppost winds up behind them, swings, and flattens them. Stars.
Designs.KillBigBonk = {
	life = 2.4,
	peak = 0.52,
	moments = { 0.28, 0.5, 1.3 },
	view = { focus = V(6, 6, 3.3), radius = 12 },
	cues = { "DeathWhoosh", "DeathBonk" },
	build = function(fx)
		local g = fx.ground
		local LENGTH = 14
		local WIND, HIT = 0.3, 0.46
		-- The hinge the bat turns about, LENGTH from the spot, so it comes down ON the spot. It stands
		-- off their right side and a little behind (give or take; a character faces -Z, so its right
		-- is +X), so seen from the front the swing is side-on: the shop's stage camera, which looks
		-- at them from the front, sees the whole arc.
		local yaw = 2.65 + (fx.random:NextNumber() - 0.5) * 0.6
		local hinge = fx.pivot * CFrame.Angles(0, yaw, 0) * CFrame.new(-LENGTH, 1.2, 0)
		local pieces = {
			{ 0, fx:part(V(1.5, 1.5, 1.5), hinge, GRIP, SMOOTH, BALL) },
			{ 2.6, fx:part(V(5, 0.9, 0.9), hinge, GRIP, SMOOTH, CYLINDER) },
			{ 5.2, fx:part(V(0.5, 1.05, 1.05), hinge, TAPE, SMOOTH, CYLINDER) },
			{ 9.6, fx:part(V(9, 2.4, 2.4), hinge, BAT, WOOD, CYLINDER) },
		}
		-- The bat at `angle`: 0 is upright, pi/2 flat on the ground across the spot. Turning -angle
		-- about Z takes the hinge's +Y to its +X, which points at the spot.
		local function place(angle, lift)
			local bat = hinge * CFrame.new(0, lift or 0, 0) * CFrame.Angles(0, 0, -angle)
			for _, piece in ipairs(pieces) do
				if piece[2] then
					piece[2].CFrame = bat * CFrame.new(0, piece[1], 0) * UPRIGHT
				end
			end
		end
		place(0)

		-- Anticipation: the bat leans back while its shadow grows over them; they cower.
		local shadow = disc(fx, g + V(0, 0.05, 0), 0.5, rgb(20, 18, 24), SMOOTH, 0.6)
		fx:tween(0, HIT, function(e)
			if shadow then
				shadow.Size = V(0.1, 0.5 + 5 * e, 0.5 + 5 * e)
				shadow.Transparency = 0.6 - 0.25 * e
			end
		end, Ease.quadIn)
		fx:tween(0, WIND, function(e)
			place(-0.35 * e)
			fx:bodyPose({ scale = V(1 + 0.05 * e, 1 - 0.08 * e, 1 + 0.05 * e) })
		end, Ease.quadOut)
		fx:sound(WIND - 0.05, "DeathWhoosh", 0.1)
		fx:tween(WIND, HIT - WIND, function(e)
			place(-0.35 + (math.pi / 2 + 0.35) * e)
		end, Ease.quadIn)

		-- Burst: BONK. Pancake.
		fx:sound(HIT, "DeathBonk", 0.1)
		fx:tween(HIT, 0.14, function(e)
			fx:bodyPose({ scale = V(1.05 + 0.5 * e, 0.92 - 0.8 * e, 1.05 + 0.5 * e) })
		end, Ease.backOut)
		fx:burst(HIT, g + V(0, 0.5, 0), { count = 22, color = { DUST, rgb(150, 140, 120) }, texture = "smoke", size = { 1.2, 3 },
			speed = { 10, 16 }, life = { 0.5, 0.9 }, spread = 80, drag = 3, accel = V(0, 2, 0), glow = 0, fade = 0.25 })
		fx:burst(HIT, g + V(0, 2.4, 0), { count = 10, color = { STAR, WHITE }, texture = "sparkle", size = { 0.7, 0.1 },
			speed = { 8, 14 }, life = { 0.4, 0.7 }, glow = 1, accel = V(0, -10, 0) })
		shock(fx, HIT, g + V(0, 0.12, 0), WHITE, 2, 11, 0.35)
		fx:light(HIT, 0.3, g + V(0, 2, 0), WHITE, 16, 3)
		if shadow then
			fadeOut(fx, shadow, HIT, 0.2)
		end

		-- Follow-through: the bat bounces off and settles; stars circle the pancake.
		fx:tween(HIT, 0.5, function(_, raw)
			place(math.pi / 2 - 0.3 * math.sin(raw * math.pi) * (1 - raw) - 0.06 * (1 - raw))
		end)
		fx:at(HIT, function()
			for index = 1, 5 do
				local star = fx:part(V(0.8, 0.8, 0.2), CFrame.new(g + V(0, 1.4, 0)), STAR, NEON)
				if star then
					fx:tween(HIT, 1.5, function(e, raw)
						local angle = index / 5 * math.pi * 2 + raw * math.pi * 4
						local radius = 2.2 * Ease.backOut(math.min(1, raw * 4))
						local height = 1.2 + math.sin(raw * math.pi * 6 + index) * 0.2
						star.CFrame = CFrame.new(g + V(math.cos(angle) * radius, height, math.sin(angle) * radius))
							* CFrame.Angles(0, -angle, math.pi / 4 + raw * 6)
					end)
					fadeOut(fx, star, 1.65, 0.3)
				end
			end
		end)

		-- Settle: the bat lifts away; the pancake fades.
		fx:tween(1.4, 0.7, function(e)
			place(math.pi / 2 - 0.9 * e, 6 * e)
		end, Ease.quadIn)
		for _, piece in ipairs(pieces) do
			fadeOut(fx, piece[2], 1.7, 0.45)
		end
		fx:tween(1.8, 0.45, function(e)
			fx:bodyPose({ fade = e })
		end)
	end,
}

-- They shiver, go pale and sink away; their ghost pops out, waves, and drifts up with a trailing tail.
Designs.KillRotGhost = {
	life = 2.9,
	peak = 0.8,
	moments = { 0.25, 0.7, 1.9 },
	view = { focus = V(0, 6, 0), radius = 9 },
	cues = { "FloatAway", "DeathGhostWail" },
	build = function(fx)
		local pivot = fx.pivot
		local OUT = 0.35
		local chest = fx.origin + V(0, 0.8, 0)

		fx:tween(0, OUT, function(e, raw)
			fx:bodyPose({ to = pivot * CFrame.new(shiver(raw * OUT, 3) * 0.1 * e, 0, 0), scale = V(1, 1, 1),
				tint = GHOST, tintAlpha = 0.7 * e, fade = 0.35 * e })
		end, Ease.sineInOut)
		-- The body sinks into the ground and is gone.
		fx:tween(OUT, 0.9, function(e)
			fx:bodyPose({ to = pivot * CFrame.new(0, -3 * e, 0), scale = V(1, 1 - 0.3 * e, 1), fade = 0.35 + 0.65 * e })
		end, Ease.quadIn)

		-- The ghost, in its own frame: +Y up, facing where the body faced (-Z).
		local shape = {
			{ V(0, 0, 0), V(2.6, 2.6, 2.6), GHOST, BALL, 0.25 },
			{ V(0, -1.3, 0), V(2.2, 2.2, 2.2), GHOST, BALL, 0.3 },
			{ V(0.25, -2.3, 0.1), V(1.5, 1.5, 1.5), GHOST, BALL, 0.4 },
			{ V(0.6, -3.1, 0.2), V(0.9, 0.9, 0.9), GHOST, BALL, 0.5 },
			{ V(-1.35, -0.9, 0), V(0.8, 0.8, 0.8), GHOST, BALL, 0.3 },
			{ V(1.35, -0.9, 0), V(0.8, 0.8, 0.8), GHOST, BALL, 0.3 },
			{ V(-0.45, 0.25, -1.15), V(0.42, 0.62, 0.2), EYE, nil, 0 },
			{ V(0.45, 0.25, -1.15), V(0.42, 0.62, 0.2), EYE, nil, 0 },
			{ V(0, -0.45, -1.2), V(0.5, 0.5, 0.2), EYE, BALL, 0 },
		}
		local built = {}
		for index, piece in ipairs(shape) do
			local part = fx:part(V(0.05, 0.05, 0.05), CFrame.new(chest), piece[3], piece[4] and piece[3] == GHOST and NEON or SMOOTH, piece[4], 1)
			built[index] = { part = part, offset = piece[1], size = piece[2], base = piece[5] }
		end
		-- Where the ghost's centre is at time t (the tail pieces read it a little in the past, so they
		-- trail behind the turns like a real tail).
		local function centre(t)
			local climb = math.max(0, t - OUT)
			local grow = Ease.backOut(math.min(1, climb / 0.35))
			local height = 1 + climb * 3.6
			local sway = math.sin(climb * 4.2) * 0.9
			return pivot * CFrame.new(sway, chest.Y - fx.ground.Y + height, 0) * CFrame.Angles(0, 0, math.sin(climb * 4.2) * 0.15), grow
		end
		fx:tween(OUT, 2.9 - OUT, function(_, raw)
			local t = OUT + raw * (2.9 - OUT)
			for index, entry in ipairs(built) do
				local part = entry.part
				if part then
					local lag = index &gt;= 3 and index &lt;= 4 and (index - 2) * 0.09 or 0
					local frame, grow = centre(t - lag)
					local blink = (t &gt; 1.3 and t &lt; 1.42) and (index == 7 or index == 8) and 0.15 or 1
					local wave = 0
					if index == 5 then
						wave = math.sin(t * 9) * 0.35
					end
					part.Size = V(entry.size.X, entry.size.Y * blink, entry.size.Z) * math.max(0.05, grow)
					part.CFrame = frame * CFrame.new(entry.offset * math.max(0.05, grow) + V(0, wave, 0))
					local fade = math.clamp((t - 2.25) / 0.55, 0, 1)
					part.Transparency = entry.base + (1 - entry.base) * fade
				end
			end
		end)
		fx:sound(OUT, "FloatAway", 0.1)
		fx:sound(OUT + 0.15, "DeathGhostWail", 0.1)
		fx:burst(OUT, chest, { count = 14, color = { WHITE, GHOST_GLOW }, texture = "glow", size = { 0.8, 0 }, speed = { 3, 6 },
			life = { 0.5, 0.9 }, drag = 2, glow = 1 })
		fx:burst(1.1, function()
			return (centre(1.0)).Position - V(0, 2.4, 0)
		end, { count = 8, color = { GHOST_GLOW, WHITE }, texture = "sparkle", size = { 0.5, 0 }, speed = { 0.5, 1.5 },
			life = { 0.6, 1 }, accel = V(0, -1, 0), glow = 1 })
		fx:burst(1.7, function()
			return (centre(1.6)).Position - V(0, 2.4, 0)
		end, { count = 8, color = { GHOST_GLOW, WHITE }, texture = "sparkle", size = { 0.5, 0 }, speed = { 0.5, 1.5 },
			life = { 0.6, 1 }, accel = V(0, -1, 0), glow = 1 })
		fx:light(OUT, 2, built[1].part, GHOST_GLOW, 12, 2)
	end,
}

-- They darken to ink, bulge, and SPLAT: a puddle of ink with a splash crown and flung blobs.
Designs.KillInkSplat = {
	life = 2.7,
	peak = 0.45,
	moments = { 0.2, 0.42, 1.2 },
	view = { focus = V(0, 2.2, 0), radius = 8.5 },
	cues = { "DeathInkSplat" },
	build = function(fx)
		local g, pivot = fx.ground, fx.pivot
		local SPLAT = 0.3
		local chest = fx.origin + V(0, 0.4, 0)

		fx:tween(0, SPLAT, function(e, raw)
			local bulge = 1 + 0.14 * e + math.sin(raw * math.pi * 5) * 0.03
			fx:bodyPose({ scale = V(bulge, 1 - 0.08 * e, bulge), tint = INK, tintAlpha = e })
		end, Ease.quadIn)
		fx:sound(SPLAT, "DeathInkSplat", 0.1)
		fx:at(SPLAT, function()
			fx:hideBody()
		end)
		flash(fx, SPLAT, chest, INK_EDGE, 5, 0.18)
		fx:light(SPLAT, 0.4, chest, INK_EDGE, 14, 3)

		-- The splat itself: a glowing rim under an ink pool, both springing out.
		local rim = disc(fx, g + V(0, 0.05, 0), 0.4, INK_EDGE, NEON, 0.35, 0.08)
		local pool = disc(fx, g + V(0, 0.09, 0), 0.4, INK, SMOOTH, 0, 0.1)
		for _, part in ipairs({ rim, pool }) do
			part.Transparency = 1
		end
		fx:tween(SPLAT, 0.35, function(e)
			if pool then
				pool.Transparency = 0
				pool.Size = V(0.1, 0.4 + 7 * e, 0.4 + 7 * e)
			end
			if rim then
				rim.Transparency = 0.35
				rim.Size = V(0.08, 0.4 + 7.8 * e, 0.4 + 7.8 * e)
			end
		end, Ease.backOut)

		-- The crown: spikes of ink jump up round the edge and fall back.
		fx:at(SPLAT, function()
			for index = 1, 6 do
				local angle = index / 6 * math.pi * 2 + 0.3
				local base = g + V(math.cos(angle) * 2.4, 0, math.sin(angle) * 2.4)
				local lean = CFrame.Angles(0, -angle, 0) * CFrame.Angles(0, 0, -0.35)
				local spike = fx:part(V(0.5, 0.1, 0.5), CFrame.new(base) * lean, INK, SMOOTH)
				fx:tween(SPLAT, 0.55, function(_, raw)
					if spike then
						local height = math.sin(raw * math.pi) * (1.6 + (index % 3) * 0.5)
						spike.Size = V(0.5 - 0.25 * raw, math.max(0.1, height), 0.5 - 0.25 * raw)
						spike.CFrame = CFrame.new(base) * lean * CFrame.new(0, height / 2, 0)
					end
				end)
				fx:at(SPLAT + 0.56, function()
					if spike then
						spike.Transparency = 1
					end
				end)
			end
		end)

		-- Blobs flung out, landing and flattening into drops.
		fx:at(SPLAT, function()
			for index = 1, 7 do
				local angle = index / 7 * math.pi * 2 + fx.random:NextNumber() * 0.5
				local reach = 4 + fx.random:NextNumber() * 3
				local from = chest
				local to = g + V(math.cos(angle) * reach, 0.08, math.sin(angle) * reach)
				local size = 0.6 + fx.random:NextNumber() * 0.5
				local blob = fx:part(V(size, size, size), CFrame.new(from), index % 3 == 0 and INK_EDGE or INK,
					index % 3 == 0 and NEON or SMOOTH, BALL)
				local flight = 0.38 + index * 0.02
				fx:tween(SPLAT, flight, function(_, raw)
					if blob then
						local arc = math.sin(raw * math.pi) * (2 + index % 3)
						blob.CFrame = CFrame.new(from:Lerp(to, raw) + V(0, arc, 0))
					end
				end)
				fx:tween(SPLAT + flight, 0.2, function(e)
					if blob then
						blob.Shape = Enum.PartType.Cylinder
						blob.Size = V(0.12, size * (1 + 0.9 * e), size * (1 + 0.9 * e))
						blob.CFrame = CFrame.new(to) * UPRIGHT
					end
				end, Ease.backOut)
				fadeOut(fx, blob, 1.95 + index * 0.03, 0.45)
			end
		end)
		fx:burst(SPLAT, chest, { count = 20, color = { INK_EDGE, INK }, texture = "glow", size = { 0.6, 0.2 }, speed = { 12, 20 },
			life = { 0.4, 0.7 }, spread = 70, accel = V(0, -45, 0), glow = 0.4 })

		-- Follow-through: the rim pulses as the ink settles.
		fx:tween(SPLAT + 0.35, 1.3, function(_, raw)
			if rim then
				rim.Transparency = 0.35 + 0.25 * math.sin(raw * math.pi * 4) ^ 2
			end
		end)

		-- Settle: it all soaks away.
		fx:tween(2.0, 0.65, function(e)
			if pool then
				pool.Size = V(0.1, 7.4 - 5 * e, 7.4 - 5 * e)
				pool.Transparency = e
			end
			if rim then
				rim.Size = V(0.08, 8.2 - 5 * e, 8.2 - 5 * e)
				rim.Transparency = 0.35 + 0.65 * e
			end
		end, Ease.quadIn)
	end,
}

--------------------------------------------------------------------------------
-- Rare
--------------------------------------------------------------------------------

-- A target glows under them, a war drum drops out of the sky spinning, STAMPS them flat, bounces,
-- and leaves a burning ring of tiles.
Designs.KillDrumStamp = {
	life = 2.6,
	peak = 0.55,
	moments = { 0.4, 0.55, 1.3 },
	view = { focus = V(0, 4, 0), radius = 10 },
	cues = { "DeathWhoosh", "DeathDrumBoom" },
	build = function(fx)
		local g = fx.ground
		local LAND = 0.5
		local target = disc(fx, g + V(0, 0.05, 0), 0.5, STAMP, NEON, 0.5)
		fx:tween(0, LAND, function(e, raw)
			if target then
				target.Size = V(0.1, 0.5 + 5.5 * e, 0.5 + 5.5 * e)
				target.Transparency = 0.35 + 0.35 * math.sin(raw * math.pi * 6) ^ 2
			end
		end, Ease.quadOut)
		if target then
			fadeOut(fx, target, LAND, 0.15)
		end

		local pieces = {
			{ 0, fx:part(V(3.4, 5, 5), CFrame.new(g + V(0, 20, 0)), DRUM, WOOD, CYLINDER) },
			{ 1.72, fx:part(V(0.12, 4.8, 4.8), CFrame.new(g + V(0, 20, 0)), DRUM_HEAD, SMOOTH, CYLINDER) },
			{ 1.6, fx:part(V(0.4, 5.3, 5.3), CFrame.new(g + V(0, 20, 0)), RIM, SMOOTH, CYLINDER) },
			{ -1.6, fx:part(V(0.4, 5.3, 5.3), CFrame.new(g + V(0, 20, 0)), RIM, SMOOTH, CYLINDER) },
		}
		local function place(height, spin, wobble)
			local centre = CFrame.new(g + V(0, height, 0)) * CFrame.Angles(0, spin, 0) * CFrame.Angles(wobble or 0, 0, 0)
			for _, piece in ipairs(pieces) do
				if piece[2] then
					piece[2].CFrame = centre * CFrame.new(0, piece[1], 0) * UPRIGHT
				end
			end
		end
		-- Anticipation: down it comes, spinning; they shrink from it.
		fx:sound(0.05, "DeathWhoosh", 0.1)
		fx:tween(0, LAND, function(e, raw)
			place(1.9 + (1 - e) * 18, raw * math.pi * 3)
			fx:bodyPose({ scale = V(1 + 0.06 * e, 1 - 0.1 * e, 1 + 0.06 * e) })
		end, Ease.quadIn)

		-- Burst: stamped.
		fx:sound(LAND, "DeathDrumBoom", 0.08)
		fx:tween(LAND, 0.06, function(e)
			fx:bodyPose({ scale = V(1.06 + 0.6 * e, 0.9 - 0.82 * e, 1.06 + 0.6 * e) })
		end, Ease.quadOut)
		fx:burst(LAND, g + V(0, 0.4, 0), { count = 22, color = { DUST, rgb(160, 130, 100) }, texture = "smoke", size = { 1.4, 3.4 },
			speed = { 12, 18 }, life = { 0.6, 1 }, spread = 85, drag = 3, accel = V(0, 2, 0), glow = 0, fade = 0.25 })
		fx:burst(LAND, g + V(0, 0.3, 0), { count = 14, color = { EMBER, STAMP }, texture = "sparks", size = { 0.5, 0 },
			speed = { 14, 22 }, life = { 0.3, 0.6 }, spread = 80, accel = V(0, -30, 0), glow = 1 })
		shock(fx, LAND, g + V(0, 0.15, 0), STAMP, 3, 14, 0.4)
		fx:light(LAND, 0.45, g + V(0, 2, 0), STAMP, 20, 5)

		-- Follow-through: two bounces, the rims wobbling; a ring of tiles lights up round it.
		fx:tween(LAND, 0.6, function(_, raw)
			local bounce = math.abs(math.sin(raw * math.pi * 2)) * (1 - raw) * 2.4
			place(1.9 + bounce, math.pi * 3 + raw * 0.4, math.sin(raw * math.pi * 5) * 0.12 * (1 - raw))
		end)
		fx:at(LAND + 0.02, function()
			for index = 1, 10 do
				local angle = index / 10 * math.pi * 2
				local frame = CFrame.new(g + V(math.cos(angle) * 3.9, 0.07, math.sin(angle) * 3.9)) * CFrame.Angles(0, -angle, 0)
				local tile = fx:part(V(0.05, 0.12, 0.05), frame, STAMP, NEON)
				fx:tween(LAND + 0.02 + index * 0.02, 0.22, function(e)
					if tile then
						tile.Size = V(1.8 * e + 0.05, 0.12, 0.75 * e + 0.05)
					end
				end, Ease.backOut)
				fadeOut(fx, tile, 1.7, 0.7)
			end
		end)

		-- Settle: it lifts back into the sky; the pancake fades.
		fx:tween(1.3, 0.8, function(e)
			place(1.9 + 14 * e, math.pi * 3.4 - e * 2)
		end, Ease.quadIn)
		for _, piece in ipairs(pieces) do
			fadeOut(fx, piece[2], 1.75, 0.35)
		end
		fx:tween(1.6, 0.6, function(e)
			fx:bodyPose({ fade = e })
		end)
	end,
}

-- They turn to gold, shake, and burst into a fountain of spinning coins that bounce and settle.
Designs.KillCoinFountain = {
	life = 2.8,
	peak = 0.62,
	moments = { 0.28, 0.55, 1.4 },
	view = { focus = V(0, 5, 0), radius = 10 },
	cues = { "Gold", "GoldCrumble", "DeathCoinJingle" },
	build = function(fx)
		local g, pivot = fx.ground, fx.pivot
		local BURST = 0.42
		local chest = fx.origin + V(0, 0.8, 0)

		fx:sound(0, "Gold", 0.1)
		fx:tween(0, 0.25, function(e)
			fx:bodyPose({ tint = GOLD, tintAlpha = e })
		end, Ease.quadOut)
		fx:at(0.12, function()
			fx:bodyPose({ material = FOIL })
		end)
		fx:tween(0.12, BURST - 0.12, function(e, raw)
			local amount = 0.12 * e
			fx:bodyPose({ to = pivot * CFrame.new(shiver(raw, 4) * amount, 0, shiver(raw, 5) * amount), scale = V(1 + 0.08 * e, 1 + 0.04 * e, 1 + 0.08 * e) })
		end, Ease.quadIn)
		fx:light(0.05, BURST, chest, GOLD, 12, 1.5)

		fx:sound(BURST, "GoldCrumble", 0.15)
		fx:sound(BURST + 0.15, "DeathCoinJingle", 0.2)
		fx:at(BURST, function()
			fx:hideBody()
		end)
		flash(fx, BURST, chest, GOLD_PALE, 7, 0.3)
		fx:light(BURST, 0.5, chest, GOLD, 18, 5)
		fx:burst(BURST, chest, { count = 22, color = { GOLD_PALE, GOLD }, texture = "sparkle", size = { 0.6, 0.1 },
			speed = { 10, 18 }, life = { 0.6, 1.1 }, accel = V(0, -20, 0), drag = 1, glow = 1 })
		fx:burst(BURST + 0.1, chest + V(0, 2, 0), { count = 12, color = { WHITE, GOLD }, texture = "sparkle", size = { 0.35, 0 },
			speed = { 1, 3 }, life = { 1.2, 1.8 }, accel = V(0, -2, 0), glow = 1 })

		-- Coins: up and out, spinning, bouncing once, then lying flat and fading.
		fx:at(BURST, function()
			for index = 1, 16 do
				local angle = index * 2.4 + fx.random:NextNumber() * 0.3
				local spread = 3 + fx.random:NextNumber() * 4
				local velocity = V(math.cos(angle) * spread, 12 + fx.random:NextNumber() * 7, math.sin(angle) * spread)
				local coin = fx:part(V(0.2, 1.2, 1.2), CFrame.new(chest), GOLD, FOIL, CYLINDER)
				local delay = (index % 4) * 0.03
				local spin = 10 + fx.random:NextNumber() * 8
				if coin then
					coin.Reflectance = 0.3
					fx:tween(BURST + delay, 2.8 - BURST - delay, function(_, raw)
						local tau = raw * (2.8 - BURST - delay)
						local position, landed = hop(chest, velocity, 32, tau, g.Y + 0.12, 0.35)
						local turn = landed and CFrame.Angles(0, spin, math.pi / 2) or CFrame.Angles(tau * spin, tau * spin * 0.5, 0)
						coin.CFrame = CFrame.new(position) * turn
					end)
					fadeOut(fx, coin, 2.1 + index * 0.01, 0.45)
				end
			end
		end)
	end,
}

-- They glitch, and a scan line sweeps up them, deleting them into voxels that float away.
Designs.KillPixelDissolve = {
	life = 2.6,
	peak = 0.85,
	moments = { 0.2, 0.8, 1.6 },
	view = { focus = V(0, 3.8, 0), radius = 8 },
	cues = { "DeathGlitch" },
	build = function(fx)
		local g, pivot = fx.ground, fx.pivot
		local SCAN, TOP = 0.3, 1.5
		local height = 6.3

		fx:sound(0, "DeathGlitch", 0.1)
		-- Anticipation: flicker between themselves and a neon cyan copy, jittering sideways.
		fx:tween(0, SCAN, function(_, raw)
			local tick = math.floor(raw * SCAN * 30)
			local on = tick % 3 ~= 1
			fx:bodyPose({ to = pivot * CFrame.new(on and 0 or shiver(tick, 6) * 0.25, 0, 0), scale = V(1, 1, 1),
				tint = tick % 2 == 0 and CYAN or MAGENTA, tintAlpha = on and 0.2 or 0.9 })
		end)
		fx:at(SCAN, function()
			fx:bodyPose({ to = pivot, scale = V(1, 1, 1), tint = CYAN, tintAlpha = 0.35, material = NEON })
		end)

		-- The scan line.
		local plane = disc(fx, g + V(0, 0.1, 0), 4.2, CYAN, NEON, 0.45, 0.06)
		fx:tween(SCAN, TOP - SCAN, function(e)
			if plane then
				plane.CFrame = CFrame.new(g + V(0, 0.1 + height * e, 0)) * UPRIGHT
			end
		end)
		if plane then
			fadeOut(fx, plane, TOP, 0.25)
		end
		fx:sound(SCAN, "DeathGlitch", 0.2)
		fx:light(SCAN, TOP - SCAN, plane, CYAN, 12, 2)

		-- Each piece of the body goes as the line passes it: gone in a blink, leaving voxels.
		local pieces = fx:bodyPieces()
		if pieces then
			for _, piece in ipairs(pieces) do
				local when = SCAN + math.clamp(piece.height / height, 0, 1) * (TOP - SCAN)
				fx:tween(when - 0.05, 0.15, function(e)
					fx:fadePiece(piece, e)
					fx:tintPiece(piece, WHITE, e)
				end)
			end
		end
		fx:tween(TOP, 0.1, function(e)
			fx:bodyPose({ fade = 1 })
		end)
		fx:at(SCAN, function()
			for index = 1, 18 do
				local rise = (index - 1) / 17
				local when = SCAN + rise * (TOP - SCAN)
				local angle = index * 2.2
				local from = g + V(math.cos(angle) * 0.7 * fx.random:NextNumber(), 0.3 + rise * (height - 0.6), math.sin(angle) * 0.5)
				local drift = V(math.cos(angle) * (0.8 + fx.random:NextNumber() * 1.6), 2 + fx.random:NextNumber() * 2.2, math.sin(angle) * (0.8 + fx.random:NextNumber()))
				local size = 0.32 + (index % 3) * 0.1
				local color = ({ CYAN, MAGENTA, WHITE })[index % 3 + 1]
				local voxel = fx:part(V(size, size, size), CFrame.new(from), color, NEON, nil, 1)
				local span = 0.9
				fx:tween(when, span, function(e, raw)
					if voxel then
						local shrink = math.max(0.05, size * (1 - raw))
						voxel.Transparency = raw &lt; 0.9 and 0.05 or 1
						voxel.Size = V(shrink, shrink, shrink)
						voxel.CFrame = CFrame.new(from + drift * e) * CFrame.Angles(raw * 3, raw * 4, 0)
					end
				end, Ease.quadOut)
			end
		end)
		fx:burst(SCAN, g + V(0, 1, 0), { count = 12, color = { CYAN, WHITE }, texture = "sparkle", size = { 0.5, 0 }, speed = { 3, 6 },
			life = { 0.4, 0.7 }, glow = 1 })
		fx:burst(0.9, g + V(0, 3.2, 0), { count = 14, color = { MAGENTA, CYAN }, texture = "sparkle", size = { 0.5, 0 }, speed = { 3, 6 },
			life = { 0.4, 0.8 }, glow = 1 })
		fx:burst(TOP - 0.05, g + V(0, height, 0), { count = 12, color = { WHITE, CYAN }, texture = "sparkle", size = { 0.6, 0 },
			speed = { 4, 8 }, life = { 0.4, 0.8 }, glow = 1 })
	end,
}

--------------------------------------------------------------------------------
-- Epic
--------------------------------------------------------------------------------

-- A brain swells out of their head, throbbing faster and faster while they flush pink and inflate,
-- then POPS: two shockwaves, a pink flash, and chunks raining down.
Designs.KillBrainBlast = {
	life = 2.8,
	peak = 1.0,
	moments = { 0.55, 0.98, 1.6 },
	view = { focus = V(0, 5.5, 0), radius = 11 },
	cues = { "DeathBrainSwell", "Vaporize" },
	build = function(fx)
		local g = fx.ground
		local POP = 0.95
		local centre = fx.origin + V(0, 3.4, 0)

		fx:sound(0, "DeathBrainSwell", 0.05)
		fx:tween(0, POP, function(e)
			fx:bodyPose({ scale = V(1 + 0.2 * e, 1 + 0.08 * e, 1 + 0.2 * e), tint = BRAIN_HOT, tintAlpha = 0.65 * e })
		end, Ease.quadIn)
		fx:light(0.1, POP, centre, BRAIN_HOT, 16, 2.5)
		fx:burst(0.25, centre, { count = 14, color = { BRAIN, WHITE }, texture = "glow", size = { 0.6, 0.1 }, life = { 0.5, 0.65 },
			inward = 6, glow = 1 })

		local lobes = {
			fx:part(V(0.4, 0.4, 0.4), CFrame.new(centre), BRAIN, SMOOTH, BALL),
			fx:part(V(0.4, 0.4, 0.4), CFrame.new(centre), BRAIN, SMOOTH, BALL),
		}
		local folds = {
			fx:part(V(0.2, 0.2, 0.2), CFrame.new(centre), BRAIN_DARK, NEON),
			fx:part(V(0.2, 0.2, 0.2), CFrame.new(centre), BRAIN_DARK, NEON),
		}
		local stem = fx:part(V(0.4, 0.3, 0.3), CFrame.new(centre), BRAIN_DARK, SMOOTH, CYLINDER)
		-- Anticipation: it grows and throbs, the throb speeding up as it nears the pop.
		fx:tween(0, POP, function(e, raw)
			local size = 0.6 + e * 5
			local throb = 1 + math.sin(raw * raw * math.pi * 14) * 0.07 * raw
			for side, lobe in ipairs(lobes) do
				if lobe then
					lobe.Size = V(size * 0.6 * throb, size * 0.72, size * throb)
					lobe.CFrame = CFrame.new(centre + V((side == 1 and -1 or 1) * size * 0.26, 0, 0))
				end
				local fold = folds[side]
				if fold then
					fold.Size = V(size * 0.08, size * 0.08, size * 0.85 * throb)
					fold.CFrame = CFrame.new(centre + V((side == 1 and -1 or 1) * size * 0.26, size * 0.33, 0))
				end
			end
			if stem then
				stem.Size = V(size * 0.5, size * 0.22, size * 0.22)
				stem.CFrame = CFrame.new(centre - V(0, size * 0.45, 0)) * UPRIGHT
			end
		end, Ease.sineInOut)

		-- Burst.
		fx:sound(POP, "Vaporize", 0.1)
		fx:at(POP, function()
			fx:hideBody()
			for _, part in ipairs({ lobes[1], lobes[2], folds[1], folds[2], stem }) do
				part.Transparency = 1
			end
		end)
		flash(fx, POP, centre, rgb(255, 214, 230), 13, 0.35)
		fx:light(POP, 0.6, centre, BRAIN_HOT, 26, 8)
		shock(fx, POP, centre, BRAIN_HOT, 2, 24, 0.5)
		shock(fx, POP + 0.06, centre, BRAIN, 2, 16, 0.55, CFrame.Angles(math.pi / 2, 0, 0))
		fx:burst(POP, centre, { count = 22, color = { BRAIN_HOT, WHITE }, texture = "sparkle", size = { 0.8, 0.1 }, speed = { 16, 26 },
			life = { 0.5, 1 }, drag = 1.5, accel = V(0, -10, 0), glow = 1 })
		fx:burst(POP + 0.05, centre, { count = 14, color = { BRAIN, rgb(200, 120, 150) }, texture = "smoke", size = { 2, 4.5 },
			speed = { 4, 8 }, life = { 0.9, 1.4 }, drag = 2, glow = 0.2, fade = 0.4 })

		-- Follow-through: chunks of brain fly out, drop and bounce.
		fx:at(POP, function()
			for index = 1, 10 do
				local angle = index / 10 * math.pi * 2 + fx.random:NextNumber() * 0.4
				local velocity = V(math.cos(angle) * (8 + fx.random:NextNumber() * 5), 8 + fx.random:NextNumber() * 8, math.sin(angle) * (8 + fx.random:NextNumber() * 5))
				local size = 0.7 + fx.random:NextNumber() * 0.5
				local chunk = fx:part(V(size, size * 0.8, size), CFrame.new(centre), index % 2 == 0 and BRAIN or BRAIN_DARK, SMOOTH, BALL)
				fx:tween(POP, 2.8 - POP, function(_, raw)
					if chunk then
						local tau = raw * (2.8 - POP)
						local position, _ = hop(centre, velocity, 36, tau, g.Y + size * 0.4, 0.3)
						chunk.CFrame = CFrame.new(position)
					end
				end)
				fadeOut(fx, chunk, 2.1 + index * 0.02, 0.45)
			end
		end)
	end,
}

-- Storm clouds gather over them; lightning strikes, they flash white to the bone and char black,
-- smoke, a second smaller bolt, and they crumble to ash.
Designs.KillLightningSmite = {
	life = 3.0,
	peak = 0.62,
	moments = { 0.35, 0.6, 1.6 },
	view = { focus = V(0, 6.5, 0), radius = 11 },
	cues = { "DeathThunder", "Shock" },
	build = function(fx)
		local g, pivot = fx.ground, fx.pivot
		local STRIKE = 0.55
		local sky = g + V(0, 13, 0)
		local head = fx.origin + V(0, 2.2, 0)

		-- Anticipation: the cloud gathers and churns, crackling, and they look up.
		local puffs = {}
		for index = 1, 4 do
			local offset = V(math.cos(index * 1.7) * 2.2, (index % 2) * 0.6, math.sin(index * 1.7) * 1.6)
			local puff = fx:part(V(0.05, 0.05, 0.05), CFrame.new(sky + offset), index % 2 == 0 and STORM or STORM_LIGHT, SMOOTH, BALL, 0.1)
			puffs[index] = { part = puff, offset = offset, size = 3.4 + (index % 3) * 0.9 }
		end
		fx:tween(0, 3.0, function(_, raw)
			local t = raw * 3
			local grow = Ease.quadOut(math.min(1, t / 0.5))
			local fade = math.clamp((t - 2.1) / 0.8, 0, 1)
			for index, entry in ipairs(puffs) do
				if entry.part then
					local d = entry.size * grow * (1 + fade * 0.5)
					entry.part.Size = V(d, d * 0.7, d)
					entry.part.CFrame = CFrame.new(sky + entry.offset + V(math.sin(t * 2 + index) * 0.4, 0, math.cos(t * 1.7 + index) * 0.3))
					entry.part.Transparency = 0.1 + 0.9 * fade
				end
			end
		end)
		fx:burst(0.3, sky, { count = 6, color = { BOLT, CYAN }, texture = "sparks", size = { 0.4, 0 }, speed = { 4, 8 },
			life = { 0.15, 0.3 }, glow = 1 })
		fx:tween(0, STRIKE, function(e)
			fx:bodyPose({ tint = BOLT, tintAlpha = 0.3 * e })
		end)

		-- The bolt: six jagged segments from the cloud to the head.
		local segments = {}
		for index = 1, 6 do
			segments[index] = fx:part(V(0.35, 0.35, 1), CFrame.new(sky), BOLT, NEON, nil, 1)
		end
		local function strike(seed, from, to, width)
			local points = { from }
			for index = 1, 5 do
				local along = from:Lerp(to, index / 6)
				local kink = V(math.sin(seed * 7.1 + index * 3.3) * 1.3, 0, math.cos(seed * 5.3 + index * 2.1) * 1.3)
				table.insert(points, along + kink)
			end
			table.insert(points, to)
			for index, segment in ipairs(segments) do
				if segment then
					local a, b = points[index], points[index + 1]
					segment.Size = V(width, width, (b - a).Magnitude + width)
					segment.CFrame = CFrame.lookAt((a + b) / 2, b)
				end
			end
		end
		local function flicker(t0, duration)
			fx:tween(t0, duration, function(_, raw)
				for _, segment in ipairs(segments) do
					if segment then
						segment.Transparency = raw &gt;= 1 and 1 or (math.floor(raw * 8) % 2 == 0 and 0 or 0.5)
					end
				end
			end)
		end
		fx:at(STRIKE, function()
			strike(1, sky, head, 0.45)
		end)
		flicker(STRIKE, 0.3)
		fx:at(0.85, function()
			strike(2, sky + V(1.5, 0, -1), g + V(1.2, 0, 0.8), 0.25)
		end)
		flicker(0.85, 0.14)

		-- Burst: the strike.
		fx:sound(STRIKE, "DeathThunder", 0.08)
		fx:sound(STRIKE + 0.05, "Shock", 0.2)
		flash(fx, STRIKE, head, BOLT, 9, 0.25)
		fx:light(STRIKE, 0.4, head, BOLT, 30, 10)
		shock(fx, STRIKE, g + V(0, 0.12, 0), BOLT, 2, 12, 0.3)
		-- White to the bone for a blink, then charred.
		fx:tween(STRIKE, 0.2, function(_, raw)
			if raw &lt; 0.4 then
				fx:bodyPose({ tint = WHITE, tintAlpha = 1, material = NEON })
			else
				fx:bodyPose({ tint = CHAR, tintAlpha = 1, material = SLATE })
			end
		end)
		fx:burst(STRIKE, head, { count = 24, color = { WHITE, BOLT, CYAN }, texture = "sparks", size = { 0.5, 0 }, speed = { 16, 26 },
			life = { 0.3, 0.6 }, accel = V(0, -30, 0), glow = 1 })
		fx:burst(0.8, fx.origin, { count = 12, color = { rgb(70, 66, 62), rgb(40, 40, 40) }, texture = "smoke", size = { 1, 3 },
			speed = { 2, 4 }, life = { 1, 1.5 }, spread = 25, accel = V(0, 3, 0), glow = 0, fade = 0.35 })

		-- Follow-through: they twitch; then crumble into ash.
		fx:tween(STRIKE + 0.1, 0.5, function(_, raw)
			local twitch = math.floor(raw * 10) % 2 == 0 and 0.1 or -0.1
			fx:bodyPose({ to = pivot * CFrame.Angles(0, 0, twitch * (1 - raw)), scale = V(1, 1, 1) })
		end)
		fx:tween(1.25, 0.85, function(e)
			fx:bodyPose({ to = pivot, scale = V(1 + 0.25 * e, 1 - 0.75 * e, 1 + 0.25 * e), tint = CHAR:Lerp(ASH, e), tintAlpha = 1 })
		end, Ease.quadIn)
		fx:tween(1.8, 0.45, function(e)
			fx:bodyPose({ fade = e })
		end)
		fx:burst(1.3, fx.origin, { count = 14, color = { ASH, rgb(60, 58, 56) }, texture = "smoke", size = { 0.8, 2 }, speed = { 1, 3 },
			life = { 0.8, 1.3 }, accel = V(2, 2, 0), drag = 1, glow = 0, fade = 0.3 })
	end,
}

--------------------------------------------------------------------------------
-- Legendary (crate exclusives)
--------------------------------------------------------------------------------

-- Crystals grow up round them and freeze them solid, glowing; then the whole lot SHATTERS into
-- glittering shards that skitter across the ground.
Designs.KillCrystalShatter = {
	life = 2.9,
	peak = 0.86,
	moments = { 0.45, 0.85, 1.6 },
	view = { focus = V(0, 3.4, 0), radius = 9 },
	cues = { "Freeze", "Shatter" },
	build = function(fx)
		local g, pivot = fx.ground, fx.pivot
		local BREAK = 0.8
		local chest = fx.origin + V(0, 0.6, 0)

		fx:sound(0, "Freeze", 0.1)
		fx:tween(0.15, 0.45, function(e)
			fx:bodyPose({ tint = ICE, tintAlpha = e, fade = 0.25 * e })
		end, Ease.sineInOut)
		fx:at(0.3, function()
			fx:bodyPose({ material = GLASS })
		end)
		fx:light(0.1, BREAK, chest, ICE, 14, 2.5)
		fx:burst(0.2, chest, { count = 12, color = { ICE_WHITE, ICE }, texture = "sparkle", size = { 0.4, 0 }, speed = { 2, 4 },
			life = { 0.5, 0.8 }, glow = 1 })

		-- Anticipation: spikes grow out of the ground round their feet, leaning in to encase them.
		local spikes = {}
		for index = 1, 7 do
			local angle = index / 7 * math.pi * 2
			local base = g + V(math.cos(angle) * 1.5, 0, math.sin(angle) * 1.5)
			local tall = 3.2 + (index % 3) * 1.1
			local lean = CFrame.Angles(0, -angle, 0) * CFrame.Angles(0, 0, 0.32 + (index % 2) * 0.1)
			local spike = fx:part(V(0.9, 0.05, 0.9), CFrame.new(base) * lean, index % 2 == 0 and ICE or ICE_WHITE, GLASS, nil, 0.3)
			spikes[index] = spike
			fx:tween(0.05 + index * 0.06, 0.4, function(e)
				if spike then
					local h = math.max(0.05, tall * e)
					spike.Size = V(0.9 - 0.2 * e, h, 0.9 - 0.2 * e)
					spike.CFrame = CFrame.new(base) * lean * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, index, 0)
				end
			end, Ease.backOut)
		end

		-- Burst: shatter.
		fx:sound(BREAK, "Shatter", 0.15)
		fx:at(BREAK, function()
			fx:hideBody()
			for _, spike in ipairs(spikes) do
				spike.Transparency = 1
			end
		end)
		flash(fx, BREAK, chest, ICE_WHITE, 8, 0.25)
		fx:light(BREAK, 0.5, chest, ICE, 22, 7)
		shock(fx, BREAK, g + V(0, 0.12, 0), ICE, 2, 12, 0.4)
		fx:burst(BREAK, chest, { count = 26, color = { WHITE, ICE }, texture = "sparkle", size = { 0.6, 0.1 }, speed = { 12, 22 },
			life = { 0.5, 1 }, drag = 1, accel = V(0, -18, 0), glow = 1 })

		-- Follow-through: shards fly, tumble, bounce, skitter.
		fx:at(BREAK, function()
			for index = 1, 14 do
				local angle = index / 14 * math.pi * 2 + fx.random:NextNumber() * 0.3
				local from = pivot * CFrame.new(math.cos(angle) * 0.6, 1 + (index % 5) * 1, math.sin(angle) * 0.4)
				local velocity = V(math.cos(angle) * (7 + fx.random:NextNumber() * 6), 5 + fx.random:NextNumber() * 8, math.sin(angle) * (7 + fx.random:NextNumber() * 6))
				local size = V(0.35 + fx.random:NextNumber() * 0.4, 0.8 + fx.random:NextNumber() * 0.9, 0.3)
				local shard = fx:part(size, from, index % 3 == 0 and ICE_WHITE or ICE, GLASS, nil, 0.2)
				local tumble = V(fx.random:NextNumber() * 12, fx.random:NextNumber() * 12, fx.random:NextNumber() * 12)
				if shard then
					shard.Reflectance = 0.3
					fx:tween(BREAK, 2.9 - BREAK, function(_, raw)
						local tau = raw * (2.9 - BREAK)
						local position, landed = hop(from.Position, velocity, 34, tau, g.Y + size.Y * 0.15, 0.3)
						local spin = math.min(tau, landed and 0.6 or tau)
						shard.CFrame = CFrame.new(position) * CFrame.Angles(tumble.X * spin, tumble.Y * spin, landed and math.pi / 2 or tumble.Z * spin)
					end)
					fadeOut(fx, shard, 2.1 + index * 0.02, 0.5)
				end
			end
		end)
		fx:burst(1.2, g + V(0, 0.5, 0), { count = 12, color = { ICE_WHITE, ICE }, texture = "sparkle", size = { 0.35, 0 },
			speed = { 1, 2 }, life = { 0.8, 1.3 }, spread = 60, glow = 1 })
	end,
}

-- A swirl of rot opens under them and winds up into a funnel that lifts them, spinning and
-- shrinking, into itself; the funnel collapses upward with a pop.
Designs.KillRotVortex = {
	life = 3.0,
	peak = 1.15,
	moments = { 0.45, 1.1, 2.1 },
	view = { focus = V(0, 6, 0), radius = 11 },
	cues = { "DeathVortex", "Vaporize" },
	build = function(fx)
		local g, pivot = fx.ground, fx.pivot
		local LIFT, GONE, POP = 0.5, 1.7, 2.05
		local top = g + V(0, 11, 0)

		fx:sound(0, "DeathVortex", 0.05)
		-- The ground swirl.
		local swirls = {}
		for index = 1, 3 do
			swirls[index] = disc(fx, g + V(0, 0.05 + index * 0.02, 0), 0.4, ({ ROT, ROT_DARK, GOO_GLOW })[index], index == 3 and NEON or SMOOTH, 0.45)
		end
		fx:tween(0, 3.0, function(_, raw)
			local t = raw * 3
			local grow = Ease.backOut(math.min(1, t / 0.6))
			local shrink = math.clamp((t - GONE) / 0.4, 0, 1)
			for index, swirl in ipairs(swirls) do
				if swirl then
					local d = (7.5 - index * 1.6) * grow * (1 - 0.8 * shrink)
					local wobble = V(math.cos(t * (5 + index) + index) * 0.4, 0, math.sin(t * (5 + index) + index) * 0.4)
					swirl.Size = V(0.1, math.max(0.1, d), math.max(0.1, d))
					swirl.CFrame = CFrame.new(g + V(0, 0.05 + index * 0.02, 0) + wobble) * UPRIGHT
					swirl.Transparency = 0.45 + 0.55 * math.clamp((t - POP) / 0.7, 0, 1)
				end
			end
		end)

		-- The funnel: rings stacked up to the sky, each wobbling round its own axis.
		local rings = {}
		for index = 1, 6 do
			rings[index] = fx:part(V(0.14, 0.1, 0.1), CFrame.new(g), index % 2 == 0 and ROT or GOO_GLOW, NEON, CYLINDER, 0.55)
		end
		local function ringAt(index, t)
			local rise = index / 6
			local grow = Ease.backOut(math.clamp((t - LIFT - index * 0.05) / 0.35, 0, 1))
			local collapse = Ease.quadIn(math.clamp((t - GONE) / (POP - GONE), 0, 1))
			local height = 0.6 + rise * 10
			local d = (1.6 + rise * 7) * grow * (1 - collapse)
			local position = g + V(math.cos(t * 7 + index) * 0.5 * rise, height + (top.Y - g.Y - height) * collapse, math.sin(t * 7 + index) * 0.5 * rise)
			return CFrame.new(position) * CFrame.Angles(math.sin(t * 3 + index) * 0.12, 0, 0) * UPRIGHT, d
		end
		fx:tween(LIFT, POP - LIFT, function(_, raw)
			local t = LIFT + raw * (POP - LIFT)
			for index, ring in ipairs(rings) do
				if ring then
					local frame, d = ringAt(index, t)
					ring.CFrame = frame
					ring.Size = V(0.14, math.max(0.1, d), math.max(0.1, d))
					ring.Transparency = raw &gt;= 1 and 1 or 0.55
				end
			end
		end)

		-- The body: tint, then up the funnel, spinning faster and shrinking away.
		fx:tween(0, LIFT, function(e)
			fx:bodyPose({ tint = ROT, tintAlpha = 0.5 * e })
		end)
		fx:tween(LIFT, GONE - LIFT, function(e, raw)
			local spin = raw * raw * math.pi * 7
			local s = 1 - 0.85 * e
			fx:bodyPose({ to = pivot * CFrame.new(0, 7 * e, 0) * CFrame.Angles(0, spin, math.sin(raw * math.pi) * 0.4),
				scale = V(s, s, s), fade = math.clamp((raw - 0.7) / 0.3, 0, 1) })
		end, Ease.quadIn)

		-- Debris spiralling up the funnel.
		fx:at(LIFT, function()
			for index = 1, 8 do
				local size = 0.4 + (index % 3) * 0.2
				local chunk = fx:part(V(size, size, size), CFrame.new(g), index % 2 == 0 and MUD or ROT_DARK, SMOOTH, index % 3 == 0 and BALL or nil)
				local phase = index / 8 * math.pi * 2
				fx:tween(LIFT + index * 0.04, 1.4, function(e, raw)
					if chunk then
						local angle = phase + raw * math.pi * 5
						local radius = 4.5 * (1 - e) + 0.6
						chunk.CFrame = CFrame.new(g + V(math.cos(angle) * radius, 0.4 + e * 9, math.sin(angle) * radius)) * CFrame.Angles(raw * 7, raw * 5, 0)
						chunk.Transparency = raw &gt;= 0.97 and 1 or 0
					end
				end, Ease.quadIn)
			end
		end)
		fx:burst(0.2, g + V(0, 0.4, 0), { count = 10, color = { ROT, GOO_GLOW }, texture = "smoke", size = { 1, 2.4 }, speed = { 2, 4 },
			life = { 0.8, 1.2 }, spread = 70, accel = V(0, 3, 0), glow = 0.2, fade = 0.4 })
		fx:light(LIFT, POP - LIFT, g + V(0, 4, 0), GOO_GLOW, 20, 3)

		-- Burst at the top: the funnel pops.
		fx:sound(POP, "Vaporize", 0.15, top)
		flash(fx, POP, top, GOO_GLOW, 9, 0.3)
		fx:light(POP, 0.5, top, GOO_GLOW, 26, 7)
		fx:burst(POP, top, { count = 20, color = { GOO_GLOW, WHITE }, texture = "sparkle", size = { 0.7, 0.1 }, speed = { 10, 18 },
			life = { 0.5, 0.85 }, accel = V(0, -14, 0), glow = 1 })
		fx:burst(POP + 0.05, top, { count = 10, color = { ROT, rgb(120, 150, 100) }, texture = "smoke", size = { 2, 4 }, speed = { 3, 5 },
			life = { 0.7, 0.85 }, drag = 2, glow = 0, fade = 0.45 })
	end,
}

--------------------------------------------------------------------------------
-- Mythic (crate exclusive)
--------------------------------------------------------------------------------

-- A target glows under them and a burning brainrot meteor streaks down out of the sky: a huge flash,
-- two shockwaves, a glowing crater, flying rock, fire and smoke.
Designs.KillMeteorStrike = {
	life = 3.2,
	peak = 0.95,
	moments = { 0.78, 0.92, 1.8 },
	view = { focus = V(0, 5, 0), radius = 13 },
	cues = { "DeathMeteorFall", "DeathMeteorImpact" },
	build = function(fx)
		local g, pivot = fx.ground, fx.pivot
		local FALL, IMPACT = 0.1, 0.85
		-- In from behind them and off to their right, give or take, so from the front (the shop's stage
		-- camera) it streaks across the sky rather than straight down the lens.
		local heading = 0.49 + (fx.random:NextNumber() - 0.5) * 0.6
		local start = (pivot * CFrame.new(math.cos(heading) * 30, 55, math.sin(heading) * 30)).Position
		local finish = g + V(0, 1.5, 0)
		local function path(t)
			local e = Ease.quadIn(math.clamp((t - FALL) / (IMPACT - FALL), 0, 1))
			return start:Lerp(finish, e)
		end

		-- Anticipation: the target, the meteor coming, them glowing in its light.
		local target = disc(fx, g + V(0, 0.05, 0), 0.5, MAGMA, NEON, 0.5)
		fx:tween(0, IMPACT, function(e, raw)
			if target then
				target.Size = V(0.1, 0.5 + 6.5 * e, 0.5 + 6.5 * e)
				target.Transparency = 0.3 + 0.4 * math.sin(raw * math.pi * 7) ^ 2
			end
		end, Ease.quadOut)
		fx:tween(0.3, IMPACT - 0.3, function(e)
			fx:bodyPose({ tint = MAGMA, tintAlpha = 0.45 * e })
		end, Ease.quadIn)
		fx:sound(FALL, "DeathMeteorFall", 0.05)
		local rock = fx:part(V(3.2, 3.2, 3.2), CFrame.new(start), ROCK, BASALT, BALL)
		local shell = fx:part(V(3.8, 3.8, 3.8), CFrame.new(start), MAGMA, NEON, BALL, 0.45)
		local trail = {}
		for index = 1, 3 do
			local d = 3.2 - index * 0.7
			trail[index] = { part = fx:part(V(d, d, d), CFrame.new(start), index == 1 and MAGMA or EMBER, NEON, BALL, 0.3 + index * 0.15), lag = index * 0.035 }
		end
		fx:tween(0, IMPACT, function(_, raw)
			local t = raw * IMPACT
			local visible = t &gt;= FALL
			if rock then
				rock.CFrame = CFrame.new(path(t)) * CFrame.Angles(t * 5, t * 3, 0)
				rock.Transparency = visible and 0 or 1
			end
			if shell then
				shell.CFrame = CFrame.new(path(t))
				shell.Transparency = visible and 0.45 or 1
			end
			for index, entry in ipairs(trail) do
				if entry.part then
					entry.part.CFrame = CFrame.new(path(t - entry.lag))
					entry.part.Transparency = visible and (0.3 + index * 0.15) or 1
				end
			end
		end)
		fx:light(FALL, IMPACT - FALL, shell, MAGMA, 22, 4)
		if target then
			fadeOut(fx, target, IMPACT, 0.1)
		end

		-- Burst: impact.
		fx:sound(IMPACT, "DeathMeteorImpact", 0.08, g)
		fx:at(IMPACT, function()
			fx:hideBody()
			for _, part in ipairs({ rock, shell, trail[1].part, trail[2].part, trail[3].part }) do
				part.Transparency = 1
			end
		end)
		flash(fx, IMPACT, g + V(0, 2, 0), rgb(255, 230, 180), 16, 0.35)
		fx:light(IMPACT, 0.7, g + V(0, 3, 0), MAGMA, 34, 12)
		shock(fx, IMPACT, g + V(0, 0.2, 0), EMBER, 2, 26, 0.4)
		shock(fx, IMPACT + 0.08, g + V(0, 0.25, 0), MAGMA, 2, 14, 0.7)
		fx:burst(IMPACT, g + V(0, 1, 0), { count = 24, color = { EMBER, MAGMA }, texture = "sparks", size = { 0.6, 0 },
			speed = { 18, 30 }, life = { 0.5, 1 }, spread = 70, accel = V(0, -30, 0), glow = 1 })
		fx:burst(IMPACT + 0.03, g + V(0, 0.8, 0), { count = 14, color = { EMBER, MAGMA, rgb(120, 40, 20) }, texture = "fire",
			size = { 2, 0.5 }, speed = { 4, 9 }, life = { 0.5, 0.9 }, spread = 45, accel = V(0, 6, 0), glow = 1 })
		fx:burst(IMPACT + 0.1, g + V(0, 1.5, 0), { count = 14, color = { rgb(90, 80, 74), rgb(40, 38, 36) }, texture = "smoke",
			size = { 2.5, 6 }, speed = { 3, 7 }, life = { 1.2, 2 }, spread = 60, drag = 1.5, accel = V(0, 2, 0), glow = 0, fade = 0.3 })

		-- The crater: a scorched pit in a molten rim that cools.
		local rim = disc(fx, g + V(0, 0.06, 0), 0.5, MAGMA, NEON, 1, 0.1)
		local pit = disc(fx, g + V(0, 0.1, 0), 0.5, SCORCH, BASALT, 1, 0.12)
		fx:tween(IMPACT, 0.3, function(e)
			if rim then
				rim.Transparency = 0.1
				rim.Size = V(0.1, 0.5 + 10 * e, 0.5 + 10 * e)
			end
			if pit then
				pit.Transparency = 0
				pit.Size = V(0.12, 0.5 + 8 * e, 0.5 + 8 * e)
			end
		end, Ease.backOut)
		fx:tween(IMPACT + 0.3, 2.4 - IMPACT, function(e)
			if rim then
				rim.Color = MAGMA:Lerp(rgb(90, 20, 10), e)
			end
		end)
		fx:tween(2.5, 0.65, function(e)
			if rim then
				rim.Transparency = 0.1 + 0.9 * e
			end
			if pit then
				pit.Transparency = e
			end
		end, Ease.quadIn)

		-- Rocks thrown out of the crater.
		fx:at(IMPACT, function()
			for index = 1, 8 do
				local angle = index / 8 * math.pi * 2 + fx.random:NextNumber() * 0.4
				local velocity = V(math.cos(angle) * (9 + fx.random:NextNumber() * 7), 10 + fx.random:NextNumber() * 9, math.sin(angle) * (9 + fx.random:NextNumber() * 7))
				local size = 0.8 + fx.random:NextNumber() * 0.8
				local from = g + V(0, 0.8, 0)
				local chunk = fx:part(V(size, size * 0.8, size), CFrame.new(from), index % 3 == 0 and MAGMA or ROCK, index % 3 == 0 and NEON or BASALT)
				local spin = V(fx.random:NextNumber() * 8, fx.random:NextNumber() * 8, 0)
				fx:tween(IMPACT, 3.2 - IMPACT, function(_, raw)
					if chunk then
						local tau = raw * (3.2 - IMPACT)
						local position, landed = hop(from, velocity, 38, tau, g.Y + size * 0.4, 0.25)
						local turn = math.min(tau, landed and 0.9 or tau)
						chunk.CFrame = CFrame.new(position) * CFrame.Angles(spin.X * turn, spin.Y * turn, 0)
					end
				end)
				fadeOut(fx, chunk, 2.5 + index * 0.02, 0.5)
			end
		end)
	end,
}

--------------------------------------------------------------------------------
-- Secret (crate exclusive)
--------------------------------------------------------------------------------

-- A pinprick of nothing opens above them with a spinning accretion disc. It pulls them in, stretched
-- and spinning, swallows the ground around them, collapses to a point, and goes off like a star.
Designs.KillBlackHole = {
	life = 3.2,
	peak = 1.2,
	moments = { 0.5, 1.2, 2.2 },
	view = { focus = V(0, 5.5, 0), radius = 11 },
	cues = { "DeathSingularity", "Vaporize" },
	build = function(fx)
		local g, pivot = fx.ground, fx.pivot
		local OPEN, PULL, GONE, POP = 0.6, 0.6, 1.7, 2.0
		local centre = g + V(0, 8, 0)
		local tilt = CFrame.Angles(math.rad(18), 0, math.rad(10))

		fx:sound(0, "DeathSingularity", 0.05)
		local hole = fx:part(V(0.05, 0.05, 0.05), CFrame.new(centre), VOID, SMOOTH, BALL)
		local halo = fx:part(V(0.05, 0.05, 0.05), CFrame.new(centre), VIOLET, NEON, BALL, 0.75)
		local discs = {
			fx:part(V(0.08, 0.1, 0.1), CFrame.new(centre) * tilt * UPRIGHT, VIOLET, NEON, CYLINDER, 0.35),
			fx:part(V(0.06, 0.1, 0.1), CFrame.new(centre) * tilt * UPRIGHT, ORCHID, NEON, CYLINDER, 0.55),
		}
		local clumps = {}
		for index = 1, 4 do
			clumps[index] = fx:part(V(0.4, 0.4, 0.4), CFrame.new(centre), index % 2 == 0 and WHITE or ORCHID, NEON, BALL)
		end
		-- The hole's size at t: opens, holds and throbs, then collapses to nothing before the pop.
		local function scaleAt(t)
			local open = Ease.backOut(math.clamp(t / OPEN, 0, 1))
			local collapse = Ease.quadIn(math.clamp((t - GONE) / (POP - GONE), 0, 1))
			return open * (1 - collapse) * (1 + math.sin(t * 9) * 0.05)
		end
		fx:tween(0, POP, function(_, raw)
			local t = raw * POP
			local s = scaleAt(t)
			local done = raw &gt;= 1
			if hole then
				local d = math.max(0.05, 2.2 * s)
				hole.Size = V(d, d, d)
				hole.Transparency = done and 1 or 0
			end
			if halo then
				local d = math.max(0.05, 3.2 * s)
				halo.Size = V(d, d, d)
				halo.Transparency = done and 1 or 0.72
			end
			for index, part in ipairs(discs) do
				if part then
					local d = math.max(0.1, (index == 1 and 7 or 9.5) * s)
					part.Size = V(part.Size.X, d, d)
					part.CFrame = CFrame.new(centre) * tilt * CFrame.Angles(0, t * (index == 1 and 2 or -1.5), 0) * UPRIGHT
					part.Transparency = done and 1 or (index == 1 and 0.35 or 0.55)
				end
			end
			for index, clump in ipairs(clumps) do
				if clump then
					local angle = index / 4 * math.pi * 2 + t * (4 + t * 3)
					local radius = (2.4 + (index % 2) * 1) * s
					clump.CFrame = CFrame.new(centre) * tilt * CFrame.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
					clump.Transparency = done and 1 or 0
				end
			end
		end)
		fx:burst(0.2, centre, { count = 18, color = { WHITE, VIOLET }, texture = "glow", size = { 0.5, 0.1 }, life = { 0.6, 0.8 },
			inward = 7, glow = 1 })
		fx:burst(0.9, centre, { count = 12, color = { ORCHID, VIOLET }, texture = "sparkle", size = { 0.5, 0.1 }, life = { 0.6, 0.8 },
			inward = 6, glow = 1 })
		fx:light(0.05, GONE, halo, VIOLET, 22, 3)

		-- Anticipation, then the pull: they tip toward it, stretch, spin, and are swallowed.
		fx:tween(0, PULL, function(e)
			fx:bodyPose({ to = pivot * CFrame.Angles(0.15 * e, 0, 0), scale = V(1, 1 + 0.1 * e, 1), tint = VIOLET, tintAlpha = 0.3 * e })
		end, Ease.sineInOut)
		fx:tween(PULL, GONE - PULL, function(e, raw)
			local rise = (centre.Y - g.Y - 2) * e
			local spin = raw * raw * math.pi * 6
			fx:bodyPose({ to = pivot * CFrame.new(0, rise, 0) * CFrame.Angles(0.15, spin, 0),
				scale = V(1 - 0.85 * e, 1 + 1.4 * e - 1.9 * math.max(0, e - 0.6), 1 - 0.85 * e),
				tint = VIOLET, tintAlpha = 0.3 + 0.5 * e, fade = math.clamp((raw - 0.75) / 0.25, 0, 1) })
		end, Ease.quadIn)
		-- Ground debris pulled up and in.
		fx:at(0.7, function()
			for index = 1, 6 do
				local angle = index / 6 * math.pi * 2
				local from = g + V(math.cos(angle) * 4, 0.3, math.sin(angle) * 4)
				local size = 0.5 + (index % 3) * 0.25
				local chunk = fx:part(V(size, size * 0.7, size), CFrame.new(from), index % 2 == 0 and ROCK or MUD, SLATE)
				fx:tween(0.7 + index * 0.05, 0.85, function(e, raw)
					if chunk then
						local swirl = angle + raw * math.pi * 3
						local radius = 4 * (1 - e)
						local height = from.Y + (centre.Y - from.Y) * e
						chunk.CFrame = CFrame.new(V(g.X + math.cos(swirl) * radius, height, g.Z + math.sin(swirl) * radius)) * CFrame.Angles(raw * 6, raw * 4, 0)
						local s = math.max(0.05, size * (1 - 0.8 * e))
						chunk.Size = V(s, s * 0.7, s)
						chunk.Transparency = raw &gt;= 0.97 and 1 or 0
					end
				end, Ease.quadIn)
			end
		end)

		-- Burst: collapse, then it goes off like a star.
		fx:sound(POP, "Vaporize", 0.1, centre)
		flash(fx, POP, centre, rgb(246, 230, 255), 13, 0.35)
		fx:light(POP, 0.6, centre, ORCHID, 30, 9)
		shock(fx, POP, centre, ORCHID, 1, 20, 0.5, tilt)
		shock(fx, POP + 0.05, centre, WHITE, 1, 12, 0.45, CFrame.Angles(math.pi / 2, 0, 0))
		fx:burst(POP, centre, { count = 24, color = { WHITE, ORCHID, VIOLET }, texture = "sparkle", size = { 0.8, 0.1 }, speed = { 14, 24 },
			life = { 0.5, 0.9 }, drag = 1.5, glow = 1 })
		-- Settle: stardust drifting down.
		fx:burst(POP + 0.15, centre, { count = 8, color = { WHITE, VIOLET }, texture = "sparkle", size = { 0.4, 0 }, speed = { 1, 3 },
			life = { 0.8, 1 }, accel = V(0, -2, 0), glow = 1 })
	end,
}

--------------------------------------------------------------------------------
-- The plain death (DeathFxClient): no cosmetic equipped, or a gun effect. Never moves the body,
-- which is the server's ragdoll.
--------------------------------------------------------------------------------

Designs.Default = {
	-- The hit: a white flash over them, a spit of rot sparks, a thud of dust where they land and a
	-- little rot-soul wisp that rises and fades.
	Impact = {
		life = 2.6,
		peak = 0.9,
		moments = { 0.05, 0.4, 1.3 },
		view = { focus = V(0, 4, 0), radius = 8 },
		cues = {},
		build = function(fx)
			local g = fx.ground
			fx:flashBody(0, 0.3, WHITE)
			fx:burst(0, function()
				return fx:bodyCenter()
			end, { count = 10, color = { BRAIN, GOO_GLOW }, texture = "sparkle", size = { 0.5, 0 }, speed = { 6, 11 },
				life = { 0.3, 0.55 }, accel = V(0, -20, 0), glow = 1 })
			fx:light(0, 0.25, function()
				return fx:bodyCenter()
			end, BRAIN, 10, 1.5)
			fx:burst(0.35, g + V(0, 0.3, 0), { count = 8, color = { DUST, rgb(150, 140, 120) }, texture = "smoke", size = { 0.8, 2 },
				speed = { 3, 6 }, life = { 0.5, 0.8 }, spread = 80, drag = 3, glow = 0, fade = 0.35 })
			-- The wisp.
			local wisp, halo
			local from
			fx:at(0.7, function()
				from = fx:bodyCenter()
				wisp = fx:part(V(0.9, 0.9, 0.9), CFrame.new(from), SOUL, Enum.Material.Neon, BALL, 0.2)
				halo = fx:part(V(1.9, 1.9, 1.9), CFrame.new(from), SOUL, Enum.Material.Neon, BALL, 0.75)
				fx:light(0.7, 1.6, wisp, SOUL, 8, 1.2)
			end)
			fx:tween(0.7, 1.7, function(e, raw)
				if wisp and from then
					local s = math.max(0.05, 0.9 * (1 - 0.5 * raw))
					local at = CFrame.new(from + V(math.sin(raw * math.pi * 3) * 0.6, 6 * e, 0))
					local gone = math.clamp((raw - 0.6) / 0.4, 0, 1)
					wisp.Size = V(s, s, s)
					wisp.CFrame = at
					wisp.Transparency = 0.2 + 0.8 * gone
					if halo then
						local h = s * (2.1 + math.sin(raw * math.pi * 6) * 0.2)
						halo.Size = V(h, h, h)
						halo.CFrame = at
						halo.Transparency = 0.75 + 0.25 * gone
					end
				end
			end, Ease.sineInOut)
			fx:burst(1.1, function()
				return wisp and wisp.Position or fx:bodyCenter()
			end, { count = 5, color = { SOUL, WHITE }, texture = "sparkle", size = { 0.35, 0 }, speed = { 0.5, 1.5 },
				life = { 0.5, 0.8 }, accel = V(0, -2, 0), glow = 1 })
			fx:burst(1.6, function()
				return wisp and wisp.Position or fx:bodyCenter()
			end, { count = 5, color = { SOUL, WHITE }, texture = "sparkle", size = { 0.35, 0 }, speed = { 0.5, 1.5 },
				life = { 0.4, 0.7 }, accel = V(0, -2, 0), glow = 1 })
		end,
	},
	-- The end: as the server fades the ragdoll out, it goes in a soft puff rather than just thinning.
	Poof = {
		life = 1.5,
		peak = 0.3,
		moments = { 0.1, 0.3, 0.8 },
		view = { focus = V(0, 3, 0), radius = 7 },
		cues = {},
		build = function(fx)
			local centre = fx:bodyCenter()
			fx:burst(0, centre, { count = 12, color = { rgb(200, 210, 190), rgb(120, 130, 120) }, texture = "smoke", size = { 1.4, 3.2 },
				speed = { 2, 5 }, life = { 0.7, 1.2 }, drag = 2, accel = V(0, 2, 0), glow = 0, fade = 0.35 })
			fx:burst(0.05, centre, { count = 8, color = { SOUL, WHITE }, texture = "sparkle", size = { 0.4, 0 }, speed = { 3, 6 },
				life = { 0.4, 0.8 }, glow = 1 })
		end,
	},
}

--------------------------------------------------------------------------------

-- The cosmetic designs by id (Default is not one).
function Designs.Get(id)
	if id == "Default" or id == "Get" or id == "Ids" then
		return nil
	end
	local design = Designs[id]
	return type(design) == "table" and design.build and design or nil
end

-- Every cosmetic design's id, sorted.
function Designs.Ids()
	local ids = {}
	for id, design in pairs(Designs) do
		if type(design) == "table" and design.build then
			table.insert(ids, id)
		end
	end
	table.sort(ids)
	return ids
end

return Designs
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">DeathEffectFx</string><ProtectedString name="Source">-- Death effects (#24; called kill animations in the code and the save, "Death Effects" on screen):
-- the engine every one of them is built on. The same module plays them in the world
-- (StarterPlayerScripts/KillAnimFxClient), loops them in the shop's previews (CosmeticPreview) and
-- freezes them for the gallery (tools/deathfx_gallery.lua), so what a player previews is what plays.
--
-- An effect is a TIMELINE, not a pile of tweens and delays. Its design (DeathEffectDesigns) declares
-- parts, then what each does between two moments (`fx:tween`), what happens at a moment (`fx:at`),
-- particle bursts, light flashes and sounds. `fx:step(t)` puts everything where it is at t seconds.
-- Nothing in here waits or schedules anything: whoever owns the effect steps it. That buys three
-- things this project has paid for the lack of before:
--   * the world, a looping shop preview and a gallery still show the same frames: a still at 0.8 s
--     is frame 0.8 s of the game, not an approximation of it;
--   * teardown is one Destroy of one folder, with nothing left running behind it;
--   * a harness can step it on a stand-in clock and measure every frame (tools/killanim_check.py).
--
-- Budgets, per effect, because a grenade can drop five bodies in one frame and every client builds
-- every effect near enough to see. `fx:part`, `fx:burst` and `fx:light` refuse past them and every
-- design copes with a refusal (nil):
--   MAX_PARTS      parts, including the invisible anchors that carry emitters and lights
--   MAX_PARTICLES  particles emitted over the whole effect
--   MAX_LIGHTS     PointLights (a flash each)
--   MAX_LIFETIME   seconds; the owner destroys the effect at its design's `life`, never later
--   MAX_SPARKS     preview only: the parts that stand in for particles (see below)
-- Raised on 2026-09-24 from 24 parts / 40 particles / 3 s, for the multi-stage versions.
--
-- The body. When the effect has been handed the victim's body (KillAnimService claimed it, so the
-- server has anchored it and will hide it once the effect is over), the design moves, squashes,
-- tints and fades it through `fx:bodyPose` and friends. Those are LOCAL changes to anchored parts, so
-- no physics fights them, every client does the same thing in step with its own effect, and nothing
-- replicates. Geometry is only ever written to anchored parts; a body that isn't ours (the default
-- ragdoll, still simulated) can be read and flashed but never moved. With no body every body call is
-- a no-op, so each design also reads right on its own.
--
-- Previews. A ViewportFrame draws neither particles nor lights, so in preview mode (`preview = true`)
-- a burst becomes a handful of small neon "sparks" flying the same way, and lights are skipped: the
-- neon flash parts that go with every light carry the flash on their own. Sparks come out of their
-- own budget, so a preview never has fewer real parts than the game.
--
-- Cylinders run along their X axis, so every upright or flat-lying one here is turned a quarter
-- about Z (UPRIGHT).

local DeathEffectFx = {}

DeathEffectFx.MAX_PARTS = 32
DeathEffectFx.MAX_PARTICLES = 64
DeathEffectFx.MAX_LIGHTS = 2
DeathEffectFx.MAX_LIFETIME = 3.2
DeathEffectFx.MAX_SPARKS = 24

-- Particle textures. Only files the Roblox client itself ships, and only the five this project has
-- already seen load (GunFx.lua, ExplosiveFx.lua): no uploaded assets.
DeathEffectFx.Textures = {
	glow = "rbxasset://textures/glow.png",
	sparkle = "rbxasset://textures/sparkle.png",
	fire = "rbxasset://textures/particles/fire_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	sparks = "rbxasset://textures/particles/fire_sparks_main.dds",
}

local V = Vector3.new
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)
DeathEffectFx.UPRIGHT = UPRIGHT

local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local WHITE = Color3.new(1, 1, 1)
local MIN_SIZE = 0.05

--------------------------------------------------------------------------------
-- Easing. Each takes 0..1 and gives 0 at 0 and exactly 1 at 1 (the harness holds every one to
-- that), so a tween always lands where it says. Back and Elastic overshoot on the way.
--------------------------------------------------------------------------------

local C1 = 1.70158
local C3 = C1 + 1
local C4 = (2 * math.pi) / 3

local Ease = {}
Ease.linear = function(a)
	return a
end
Ease.quadIn = function(a)
	return a * a
end
Ease.quadOut = function(a)
	return 1 - (1 - a) * (1 - a)
end
Ease.quadInOut = function(a)
	return a &lt; 0.5 and 2 * a * a or 1 - (-2 * a + 2) ^ 2 / 2
end
Ease.cubicIn = function(a)
	return a * a * a
end
Ease.cubicOut = function(a)
	return 1 - (1 - a) ^ 3
end
Ease.sineInOut = function(a)
	return -(math.cos(math.pi * a) - 1) / 2
end
Ease.expoOut = function(a)
	return a &gt;= 1 and 1 or 1 - 2 ^ (-10 * a)
end
Ease.backOut = function(a)
	return 1 + C3 * (a - 1) ^ 3 + C1 * (a - 1) ^ 2
end
Ease.backIn = function(a)
	return C3 * a * a * a - C1 * a * a
end
Ease.elasticOut = function(a)
	if a &lt;= 0 then
		return 0
	elseif a &gt;= 1 then
		return 1
	end
	return 2 ^ (-10 * a) * math.sin((a * 10 - 0.75) * C4) + 1
end
Ease.bounceOut = function(a)
	local n, d = 7.5625, 2.75
	if a &lt; 1 / d then
		return n * a * a
	elseif a &lt; 2 / d then
		a -= 1.5 / d
		return n * a * a + 0.75
	elseif a &lt; 2.5 / d then
		a -= 2.25 / d
		return n * a * a + 0.9375
	end
	a -= 2.625 / d
	return n * a * a + 0.984375
end
DeathEffectFx.Ease = Ease

--------------------------------------------------------------------------------
-- One effect
--------------------------------------------------------------------------------

local Fx = {}
Fx.__index = Fx

local function flatYaw(look)
	local flat = V(look.X, 0, look.Z)
	if flat.Magnitude &lt; 1e-3 then
		return 0
	end
	return math.atan2(-flat.X, -flat.Z)
end

local function torsoOf(model)
	return model and (model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
		or model:FindFirstChild("HumanoidRootPart")) or nil
end

-- options:
--   parent     where the effect's folder goes (workspace, a ViewportFrame, a gallery folder)
--   origin     the body's root position (about three studs above the ground)
--   ground     the ground under it
--   life       seconds, capped at MAX_LIFETIME; a burst's particles are cut to die before it
--   body       the victim's Model, or nil
--   ownsBody   true when the body is ours to move (claimed and anchored, or a preview dummy)
--   preview    sparks instead of particles, no lights, and the body put back on Destroy
--   seed       for the design's Random, so a still or a thumbnail is the same every time
--   sound      function(cue, position, pitchJitter), or nil for silence
function DeathEffectFx.new(options)
	local folder = Instance.new("Folder")
	folder.Name = options.name or "DeathEffectFx"
	local fx = setmetatable({
		folder = folder,
		origin = options.origin,
		ground = options.ground or (options.origin - V(0, 3, 0)),
		life = math.min(options.life or DeathEffectFx.MAX_LIFETIME, DeathEffectFx.MAX_LIFETIME),
		preview = options.preview == true,
		random = Random.new(options.seed or 1),
		soundHook = options.sound,
		bodyModel = options.body,
		ownsBody = options.body ~= nil and options.ownsBody == true,
		parts = 0,
		particles = 0,
		lights = 0,
		sparkCount = 0,
		tracks = {},
		events = {},
		seq = 0,
		now = 0,
		alive = true,
	}, Fx)
	-- Where the body stands and which way it faces: every design places things relative to this, so
	-- a bat swings onto the spot and a ghost's face looks the way the body did.
	local torso = torsoOf(options.body)
	local yaw = torso and flatYaw(torso.CFrame.LookVector) or (options.yaw or 0)
	fx.pivot = CFrame.new(fx.ground) * CFrame.Angles(0, yaw, 0)
	folder.Parent = options.parent
	return fx
end

-- An anchored, untouchable part, or nil once the budget is spent.
function Fx:part(size, cframe, color, material, shape, transparency)
	if not self.alive or self.parts &gt;= DeathEffectFx.MAX_PARTS then
		return nil
	end
	self.parts += 1
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		part.Shape = shape
	end
	part.Size = size
	part.CFrame = cframe
	part.Color = color or WHITE
	part.Material = material or SMOOTH
	part.Transparency = transparency or 0
	part.Parent = self.folder
	return part
end

-- `fn(eased, raw)` is called every step while t is inside [t0, t0 + duration], and once more at
-- exactly 1 when t passes the end, so it always lands. It must SET state from alpha (never add to
-- it), which is what lets a still jump straight to any moment.
function Fx:tween(t0, duration, fn, ease)
	self.seq += 1
	table.insert(self.tracks, { t0 = t0, t1 = t0 + math.max(duration, 0), fn = fn, ease = ease or Ease.linear, seq = self.seq })
	self.tracksDirty = true
end

-- `fn()` once, the first step at or after `t`.
function Fx:at(t, fn)
	self.seq += 1
	table.insert(self.events, { t = t, fn = fn, seq = self.seq })
end

local function byStart(a, b)
	if a.t0 ~= b.t0 then
		return a.t0 &lt; b.t0
	end
	return a.seq &lt; b.seq
end

-- Everything where it is at `t`, and the same whether it got there in one jump or sixty frames:
--   1. everything DUE by t, in the order it fell due: each event at its moment, and each tween that
--      has finished landing (its final call, at 1) at its end. A tween landing and an event at the
--      same instant: the tween lands first, so an event that hides a part a tween was moving wins.
--      An event may add more events and tweens; they are picked up in the same pass.
--   2. then every tween still in progress, in start order, so a later tween on the same property
--      wins over an earlier one.
-- Without (1), a still that jumped straight to 1.6 s ran a bubble's "pop" event and THEN its swell
-- tween's last frame, and the popped bubble came back.
function Fx:step(t)
	if not self.alive then
		return
	end
	self.now = t
	for _ = 1, 1024 do
		local best, bestTime, bestKind = nil, 0, 0
		for _, event in ipairs(self.events) do
			if not event.done and event.t &lt;= t then
				-- kind 1: an event goes after a tween landing at the same instant.
				if not best or event.t &lt; bestTime or (event.t == bestTime and (bestKind == 1 and event.seq &lt; best.seq)) then
					best, bestTime, bestKind = event, event.t, 1
				end
			end
		end
		for _, track in ipairs(self.tracks) do
			if not track.done and track.t1 &lt;= t then
				if not best or track.t1 &lt; bestTime or (track.t1 == bestTime and (bestKind == 1 or track.seq &lt; best.seq)) then
					best, bestTime, bestKind = track, track.t1, 0
				end
			end
		end
		if not best then
			break
		end
		best.done = true
		if bestKind == 0 then
			best.fn(best.ease(1), 1)
		else
			best.fn()
		end
		if not self.alive then
			return
		end
	end
	if self.tracksDirty then
		table.sort(self.tracks, byStart)
		self.tracksDirty = false
	end
	for _, track in ipairs(self.tracks) do
		if not track.done and track.t0 &lt;= t then
			local raw = math.clamp((t - track.t0) / (track.t1 - track.t0), 0, 1)
			track.fn(track.ease(raw), raw)
		end
	end
end

--------------------------------------------------------------------------------
-- Particles, lights, sound
--------------------------------------------------------------------------------

local function sequenceOf(color)
	if typeof(color) == "Color3" then
		return ColorSequence.new(color)
	end
	local keypoints = {}
	for index, each in ipairs(color) do
		table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / math.max(#color - 1, 1), each))
	end
	if #keypoints == 1 then
		return ColorSequence.new(color[1])
	end
	return ColorSequence.new(keypoints)
end

local function firstColor(color)
	return typeof(color) == "Color3" and color or color[1]
end

local function where(at)
	if type(at) == "function" then
		return at()
	end
	return at
end

-- Preview stand-ins for a burst: a few neon balls flying the way the particles would, shrinking and
-- fading over the same life. Deterministic (the effect's own Random), so a still is repeatable.
function Fx:sparks(t, at, spec)
	local count = math.min(math.ceil((spec.count or 10) / 4), 7, DeathEffectFx.MAX_SPARKS - self.sparkCount)
	local life = math.min(((spec.life and (spec.life[1] + spec.life[2]) / 2) or 1), math.max(0.05, self.life - t - 0.05))
	local speed = spec.speed or { 6, 12 }
	local accel = spec.accel or Vector3.zero
	local drag = spec.drag or 0
	local spread = math.rad(math.clamp(spec.spread or 180, 0, 180))
	local colors = typeof(spec.color) == "Color3" and { spec.color } or (spec.color or { WHITE })
	local size = math.clamp((spec.size and spec.size[1] or 0.5) * 0.45, 0.12, 0.6)
	local up = spec.direction or V(0, 1, 0)
	-- Any vector not parallel to `up`, to build the cone around it.
	local side = math.abs(up.Y) &lt; 0.9 and V(0, 1, 0) or V(1, 0, 0)
	local right = up:Cross(side).Unit
	local forward = right:Cross(up).Unit
	for index = 1, count do
		self.sparkCount += 1
		local spark = Instance.new("Part")
		spark.Anchored = true
		spark.CanCollide = false
		spark.CanQuery = false
		spark.CanTouch = false
		spark.CastShadow = false
		spark.Shape = Enum.PartType.Ball
		spark.Material = NEON
		spark.Color = colors[(index - 1) % #colors + 1]
		spark.Size = V(size, size, size)
		spark.CFrame = CFrame.new(at)
		spark.Parent = self.folder
		-- A direction inside the cone: `spread` from `up`, evenly round it.
		local theta = spread * math.sqrt(self.random:NextNumber())
		local phi = (index / count + self.random:NextNumber() * 0.3) * math.pi * 2
		local dir = up * math.cos(theta) + (right * math.cos(phi) + forward * math.sin(phi)) * math.sin(theta)
		local velocity = dir * (speed[1] + (speed[2] - speed[1]) * self.random:NextNumber())
		local start = at
		if spec.inward then
			-- Starts out on the sphere and falls to its middle, the way an Inward emitter does.
			start = at + dir * spec.inward
			velocity = Vector3.zero
		end
		self:tween(t, life, function(_, raw)
			local tau = raw * life
			local travel
			if spec.inward then
				travel = (at - start) * Ease.quadIn(raw)
			elseif drag &gt; 0 then
				travel = velocity * ((1 - math.exp(-drag * tau)) / drag) + accel * (0.5 * tau * tau)
			else
				travel = velocity * tau + accel * (0.5 * tau * tau)
			end
			spark.CFrame = CFrame.new(start + travel)
			local shrink = math.max(MIN_SIZE, size * (1 - raw * 0.7))
			spark.Size = V(shrink, shrink, shrink)
			spark.Transparency = 0.1 + 0.9 * raw * raw
		end)
	end
end

-- A one-off burst of particles at `t` from `at` (a position, or a function returning one, read at
-- that moment). spec: count, color (a Color3 or a list, over the particle's life), texture (a key of
-- Textures), size = { start, finish }, speed = { min, max }, life = { min, max }, spread (degrees
-- from `direction`, default up; 180 is every way), accel, drag, glow (LightEmission), spin, inward
-- (a radius: particles start on that sphere and fall to its middle).
--
-- Costs one invisible anchor part and `count` particles, cut to what's left of the budget. The
-- particles' lifetime is cut so the last one is gone before the effect is.
function Fx:burst(t, at, spec)
	self:at(t, function()
		local position = where(at)
		if not position then
			return
		end
		if self.preview then
			self:sparks(t, position, spec)
			return
		end
		local count = math.min(spec.count or 10, DeathEffectFx.MAX_PARTICLES - self.particles)
		if count &lt;= 0 then
			return
		end
		local size = spec.inward and V(spec.inward * 2, spec.inward * 2, spec.inward * 2) or V(0.2, 0.2, 0.2)
		local frame = CFrame.new(position)
		if spec.direction then
			frame = CFrame.lookAt(position, position + spec.direction) * CFrame.Angles(-math.pi / 2, 0, 0)
		end
		local anchor = self:part(size, frame, WHITE, SMOOTH, spec.inward and Enum.PartType.Ball or nil, 1)
		if not anchor then
			return
		end
		self.particles += count
		local lifeMax = math.max(0.05, math.min((spec.life or { 0.6, 1.2 })[2], self.life - t - 0.05))
		local lifeMin = math.min((spec.life or { 0.6, 1.2 })[1], lifeMax)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Enabled = false
		emitter.Rate = 0
		emitter.Texture = DeathEffectFx.Textures[spec.texture or "sparkle"] or DeathEffectFx.Textures.sparkle
		emitter.Color = sequenceOf(spec.color or WHITE)
		emitter.LightEmission = spec.glow or 0.5
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, (spec.size or { 0.5, 0 })[1]),
			NumberSequenceKeypoint.new(1, (spec.size or { 0.5, 0 })[2]),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, spec.fade or 0.05),
			NumberSequenceKeypoint.new(0.7, math.min(1, (spec.fade or 0.05) + 0.25)),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(lifeMin, lifeMax)
		local speed = spec.speed or { 6, 12 }
		emitter.Speed = NumberRange.new(speed[1], speed[2])
		local spread = spec.spread or 180
		emitter.SpreadAngle = Vector2.new(spread, spread)
		emitter.Acceleration = spec.accel or Vector3.zero
		emitter.Drag = spec.drag or 0
		emitter.Rotation = NumberRange.new(0, 360)
		local spin = spec.spin or 90
		emitter.RotSpeed = NumberRange.new(-spin, spin)
		if spec.inward then
			emitter.Shape = Enum.ParticleEmitterShape.Sphere
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
			emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
			emitter.Speed = NumberRange.new(spec.inward / lifeMax * 0.8, spec.inward / lifeMax)
		end
		emitter.Parent = anchor
		emitter:Emit(count)
	end)
end

-- A light flash: up to `peak` brightness in the first eighth of `duration`, then away. `at` is a
-- position, a function returning one, or a Part (the light rides on it and costs no anchor).
-- Nothing in a preview: the neon flash part that goes with every light carries it there.
function Fx:light(t, duration, at, color, range, peak)
	if self.preview then
		return
	end
	self:at(t, function()
		if self.lights &gt;= DeathEffectFx.MAX_LIGHTS then
			return
		end
		local holder = typeof(at) == "Instance" and at or nil
		if not holder then
			local position = where(at)
			holder = position and self:part(V(0.2, 0.2, 0.2), CFrame.new(position), WHITE, SMOOTH, nil, 1)
		end
		if not holder then
			return
		end
		self.lights += 1
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = range
		light.Brightness = 0
		light.Shadows = false
		light.Parent = holder
		self:tween(t, duration, function(_, raw)
			light.Brightness = peak * (raw &lt; 0.125 and raw / 0.125 or (1 - (raw - 0.125) / 0.875) ^ 2)
		end)
	end)
end

-- A cue from SoundConfig at `t`, where the body is (or `at`).
function Fx:sound(t, cue, jitter, at)
	self:at(t, function()
		if self.soundHook then
			self.soundHook(cue, where(at) or self.origin, jitter or 0.1)
		end
	end)
end

--------------------------------------------------------------------------------
-- The body
--------------------------------------------------------------------------------

-- The body's pieces, snapshotted the first time a design asks (by then the server's anchoring has
-- arrived: it is sent before the effect is). nil when the effect has no body of its own.
function Fx:bodyPieces()
	if not self.ownsBody or not self.bodyModel then
		return nil
	end
	if self.pieces then
		return self.pieces
	end
	local pieces = {}
	local inverse = self.pivot:Inverse()
	for _, part in ipairs(self.bodyModel:GetDescendants()) do
		if part:IsA("BasePart") then
			local decals = {}
			for _, child in ipairs(part:GetChildren()) do
				if child:IsA("Decal") or child:IsA("Texture") then
					table.insert(decals, { decal = child, transparency = child.Transparency })
				end
			end
			local rel = inverse * part.CFrame
			table.insert(pieces, {
				part = part,
				cf = part.CFrame,
				rel = rel,
				height = rel.Position.Y,
				size = part.Size,
				transparency = part.Transparency,
				color = part.Color,
				material = part.Material,
				decals = decals,
			})
		end
	end
	self.pieces = pieces
	return pieces
end

-- The middle of the body right now (it may be falling): the torso, else where it died.
function Fx:bodyCenter()
	local torso = torsoOf(self.bodyModel)
	if torso and torso.Parent then
		return torso.Position
	end
	return self.origin
end

-- Puts one piece at `cframe`, `scale` times its own size (a Vector3 along the pivot's axes, turned
-- into the piece's own through its pose at the snapshot). Only an anchored piece is moved: an
-- unanchored one is being simulated, and a local CFrame on it would be overwritten next frame anyway.
function Fx:placePiece(piece, cframe, scale)
	local part = piece.part
	if not part.Parent or not part.Anchored then
		return
	end
	part.CFrame = cframe
	if scale then
		local rot = piece.rel
		local function along(axis)
			return math.abs(axis.X) * scale.X + math.abs(axis.Y) * scale.Y + math.abs(axis.Z) * scale.Z
		end
		part.Size = V(
			math.max(MIN_SIZE, piece.size.X * along(rot.RightVector)),
			math.max(MIN_SIZE, piece.size.Y * along(rot.UpVector)),
			math.max(MIN_SIZE, piece.size.Z * along(-rot.LookVector))
		)
	end
end

-- 0 is as it was, 1 is gone. A part that was invisible to begin with (the root) stays invisible.
function Fx:fadePiece(piece, fade)
	local part = piece.part
	if not part.Parent then
		return
	end
	part.Transparency = piece.transparency + (1 - piece.transparency) * math.clamp(fade, 0, 1)
	for _, entry in ipairs(piece.decals) do
		if entry.decal.Parent then
			entry.decal.Transparency = entry.transparency + (1 - entry.transparency) * math.clamp(fade, 0, 1)
		end
	end
end

function Fx:tintPiece(piece, color, alpha)
	if piece.part.Parent then
		piece.part.Color = piece.color:Lerp(color, math.clamp(alpha, 0, 1))
	end
end

-- The whole body at once. pose (every field optional; only the ones given are written):
--   to      the pivot's new CFrame (the body moves and turns with it)
--   scale   a Vector3 along the pivot's axes, about the ground point: Y 0.1 is a pancake
--   fade    0..1
--   tint    Color3, with `tintAlpha` 0..1
--   material
function Fx:bodyPose(pose)
	local pieces = self:bodyPieces()
	if not pieces then
		return
	end
	local geometry = pose.to ~= nil or pose.scale ~= nil
	local to = pose.to or self.pivot
	local scale = pose.scale or V(1, 1, 1)
	for _, piece in ipairs(pieces) do
		if geometry then
			local rel = piece.rel
			local moved = to * CFrame.new(rel.Position * scale) * (rel - rel.Position)
			self:placePiece(piece, moved, scale)
		end
		if pose.fade then
			self:fadePiece(piece, pose.fade)
		end
		if pose.tint then
			self:tintPiece(piece, pose.tint, pose.tintAlpha or 1)
		end
		if pose.material and piece.part.Parent and piece.transparency &lt; 1 then
			piece.part.Material = pose.material
		end
	end
end

-- Gone, at once (the pop of a pop).
function Fx:hideBody()
	self:bodyPose({ fade = 1 })
end

-- A white flash over the whole body, for a body we may not move (the default ragdoll): a Highlight in
-- the world, a quick tint in a preview. Cheap, and gone after `duration`.
function Fx:flashBody(t, duration, color)
	if not self.bodyModel then
		return
	end
	if self.preview then
		local pieces = self.ownsBody and self:bodyPieces()
		if pieces then
			self:tween(t, duration, function(_, raw)
				for _, piece in ipairs(pieces) do
					self:tintPiece(piece, color, 1 - raw)
				end
			end)
		end
		return
	end
	self:at(t, function()
		if not self.bodyModel.Parent then
			return
		end
		local highlight = Instance.new("Highlight")
		highlight.Adornee = self.bodyModel
		highlight.FillColor = color
		highlight.OutlineTransparency = 1
		highlight.FillTransparency = 0.2
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.Parent = self.folder
		self:tween(t, duration, function(eased)
			highlight.FillTransparency = 0.2 + 0.8 * eased
		end, Ease.quadIn)
	end)
end

--------------------------------------------------------------------------------
-- Done
--------------------------------------------------------------------------------

-- Tears the effect down. A preview also puts its dummy back exactly as it found it, so the next loop
-- starts from a whole body. A body in the world is left as it is: the server hides it.
function Fx:destroy()
	if not self.alive then
		return
	end
	self.alive = false
	self.folder:Destroy()
	if self.preview and self.pieces then
		for _, piece in ipairs(self.pieces) do
			local part = piece.part
			if part.Parent then
				part.CFrame = piece.cf
				part.Size = piece.size
				part.Transparency = piece.transparency
				part.Color = piece.color
				part.Material = piece.material
			end
			for _, entry in ipairs(piece.decals) do
				entry.decal.Transparency = entry.transparency
			end
		end
	end
end

--------------------------------------------------------------------------------
-- A stand-in body for previews and the gallery
--------------------------------------------------------------------------------

-- A blocky R15 body, feet on y = 0, facing -Z like a character, root at (0, 3.2, 0): the fifteen
-- limbs by their R15 names and proportions, so an effect treats it exactly as it treats a player.
local SKIN = Color3.fromRGB(246, 206, 150)
local SHIRT = Color3.fromRGB(70, 170, 190)
local PANTS = Color3.fromRGB(52, 62, 96)
local SHOE = Color3.fromRGB(40, 36, 36)
local DUMMY = {
	{ "HumanoidRootPart", V(2, 2, 1), V(0, 3.2, 0), SHIRT, 1 },
	{ "Head", V(1.2, 1.2, 1.2), V(0, 5.3, 0), SKIN },
	{ "UpperTorso", V(2, 1.6, 1), V(0, 3.9, 0), SHIRT },
	{ "LowerTorso", V(2, 0.4, 1), V(0, 2.9, 0), PANTS },
	{ "LeftUpperArm", V(1, 1.2, 1), V(-1.5, 4.1, 0), SHIRT },
	{ "LeftLowerArm", V(1, 1, 1), V(-1.5, 3, 0), SKIN },
	{ "LeftHand", V(1, 0.3, 1), V(-1.5, 2.35, 0), SKIN },
	{ "RightUpperArm", V(1, 1.2, 1), V(1.5, 4.1, 0), SHIRT },
	{ "RightLowerArm", V(1, 1, 1), V(1.5, 3, 0), SKIN },
	{ "RightHand", V(1, 0.3, 1), V(1.5, 2.35, 0), SKIN },
	{ "LeftUpperLeg", V(1, 1.2, 1), V(-0.5, 2.1, 0), PANTS },
	{ "LeftLowerLeg", V(1, 1.2, 1), V(-0.5, 0.9, 0), PANTS },
	{ "LeftFoot", V(1, 0.3, 1.1), V(-0.5, 0.15, -0.05), SHOE },
	{ "RightUpperLeg", V(1, 1.2, 1), V(0.5, 2.1, 0), PANTS },
	{ "RightLowerLeg", V(1, 1.2, 1), V(0.5, 0.9, 0), PANTS },
	{ "RightFoot", V(1, 0.3, 1.1), V(0.5, 0.15, -0.05), SHOE },
	-- The face, as parts: a ViewportFrame draws decals, but there's no uploaded face to draw.
	{ "LeftEye", V(0.2, 0.3, 0.05), V(-0.25, 5.4, -0.61), SHOE },
	{ "RightEye", V(0.2, 0.3, 0.05), V(0.25, 5.4, -0.61), SHOE },
}
DeathEffectFx.DummyRoot = V(0, 3.2, 0)

function DeathEffectFx.Dummy(at)
	local model = Instance.new("Model")
	model.Name = "DeathEffectDummy"
	local base = at or CFrame.new()
	for _, entry in ipairs(DUMMY) do
		local part = Instance.new("Part")
		part.Name = entry[1]
		part.Size = entry[2]
		part.CFrame = base * CFrame.new(entry[3])
		part.Color = entry[4]
		part.Transparency = entry[5] or 0
		part.Material = SMOOTH
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = model
	end
	model.PrimaryPart = model:FindFirstChild("HumanoidRootPart")
	return model
end

return DeathEffectFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">DefensePlacement</string><ProtectedString name="Source">-- Where a portable defense goes up: the placement rules DefenseService builds by, shared with the
-- client so the translucent preview (StarterPlayerScripts/DefensePreview) shows exactly the site the
-- server will use. One copy of the rules, so the two can't drift apart.
--
--   DefensePlacement.Sizes[itemId]                               each structure's box (studs)
--   DefensePlacement.ThrowTarget(from, look, aimPoint)          -&gt; target, facing
--   DefensePlacement.FindSite(character, size, centre, flat, defenses, extraExclude)
--                                                               -&gt; origin CFrame, nil, plan
--                                                               or nil, why not
--   DefensePlacement.Landing(from, velocity, flightTime, params) -&gt; where a thrown kit comes down
--
-- "Place it anywhere" (OLIVER_LIST #128, Oliver 09-24: "allow defense placement anywhere"). FindSite
-- no longer refuses a site for being sloped, wet, cluttered or against a wall; it works out HOW the
-- structure stands there, and the plan it returns is what DefenseService builds and what the preview
-- draws, footings included:
--   * sloped or uneven ground, rooftops: a bunker or fortress is built LEVEL at the highest ground
--     under it, and every lower edge gets a post down to the ground, so nothing hangs in the air and
--     nothing is buried in the hill; a barricade (a wall) tilts along its length to follow the
--     ground, up to WallTilt, and posts take up whatever is left;
--   * rubble and small props: sat over, the way a pad sits over a stone; loose debris is shoved;
--   * shallow water: posts down to the bed, with floats at the waterline;
--   * over a ledge: posts where the ground below is in reach, and up to half of it may overhang;
--   * against a wall or in a gap too small for it: slid to the nearest spot within SlideMax that is
--     free, rather than refused.
-- What it still refuses, because each one protects somebody: a player, bot or vehicle in the way;
-- a spawn (the pads, the team bunker), an objective's centre, a team base's vehicle bays and their
-- ways out (TeamBaseRuins tags those "NoBuild"); a doorway or a covered passage the structure would seal; the lobby; nothing to stand on
-- at all (off the map, deep water); and anything tagged "NoBuild". The count cap stays in
-- DefenseService. `defenses` is the folder built defenses live in, which never counts as ground;
-- `extraExclude` lets the client leave out what only it has (the camera's viewmodel and preview,
-- client-side effects), which the server never sees. Proven offline by tools/defense_anywhere_check.py.

local DefensePlacement = {}

-- #128 B's slope allowances. Since "anywhere" (#128, 09-24) they no longer refuse a site: a slope is
-- levelled and stood on posts instead. Kept, with the numbers tools/defense_throw_probe.lua pins,
-- because they are still the honest answer to "how steep can this stand with no footing at all".
DefensePlacement.MaxSlope = 5
-- How much drop a site may have across the footprint, per structure. One number for all three made
-- the limit an accident of size: the five sampled points are the centre and the corners inset 0.5, so
-- 5 studs of drop is ~24 degrees across a barricade's 11-stud span, ~14 across a bunker's 19.8 and
-- only ~10 across a fortress's 28.3 -- the biggest thing in the game was also the fussiest, which
-- nobody chose. A barricade is a fence and tolerates more; the fortress is held to the bunker's ANGLE
-- (14.2 degrees) over its own diagonal, which is 7.2 studs. Anything not listed keeps that angle too,
-- never stricter than MaxSlope.
DefensePlacement.MaxSlopeFor = {
	RotBarricade = 7,
	PopupBunker = 5,
	BrainrotFortress = 7.2,
}
DefensePlacement.SlopeAngle = math.rad(14.2)

-- The drop a footprint of `size` may have. Sizes are shared table values, so the structure is
-- recognised by identity; an unknown footprint gets the angle over its own sampled diagonal.
function DefensePlacement.SlopeAllowance(size)
	for id, known in pairs(DefensePlacement.Sizes) do
		if known == size then
			return DefensePlacement.MaxSlopeFor[id] or DefensePlacement.MaxSlope
		end
	end
	local halfX, halfZ = size.X / 2 - 0.5, size.Z / 2 - 0.5
	local span = 2 * math.sqrt(halfX * halfX + halfZ * halfZ)
	return math.max(DefensePlacement.MaxSlope, span * math.tan(DefensePlacement.SlopeAngle))
end
-- How far a kit can be thrown.
DefensePlacement.ThrowRange = 60
-- Where a kit comes to rest is lifted this far before the site checks (DefenseService.landKit).
DefensePlacement.LandLift = 1

DefensePlacement.Sizes = {
	RotBarricade = Vector3.new(12, 7.5, 1.6),
	PopupBunker = Vector3.new(15, 8.5, 15),
	BrainrotFortress = Vector3.new(21, 12, 21),
}

-- Workspace folders that are never ground and never in the way: pickups, companions, effects,
-- deployables, supply drops.
DefensePlacement.IgnoredFolders = { "Loot", "Companions", "Effects", "Deployables", "SupplyDrops" }
-- The overlap check ignores the same, except deployables (a launch pad in the box blocks a build).
DefensePlacement.OverlapIgnoredFolders = { "Loot", "Companions", "Effects", "SupplyDrops" }

-- Where a throw from `from`, with the thrower looking along `look`, aimed at `aimPoint` (already
-- checked by the caller; nil throws straight ahead) comes down, and which way the structure faces:
-- along the aim, or the thrower's facing when the aim is straight down at their feet. The throw is
-- clamped to ThrowRange.
function DefensePlacement.ThrowTarget(from, look, aimPoint)
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = flatLook.Magnitude &gt; 0.01 and flatLook.Unit or Vector3.new(0, 0, -1)
	local target = aimPoint or (from + look * 30)
	local offset = target - from
	if offset.Magnitude &gt; DefensePlacement.ThrowRange then
		offset = offset.Unit * DefensePlacement.ThrowRange
	end
	local facing = Vector3.new(offset.X, 0, offset.Z)
	facing = facing.Magnitude &gt; 0.5 and facing.Unit or flatLook
	return from + offset, facing, offset
end

-- Where a thrown kit actually leaves the hand: ThrowLead in front of the head and ThrowLift up,
-- unless something solid is nearer than that. Pressed against a building wall, the unclipped point
-- sat on the FAR side of it, so the kit settled, built or armed inside the building: a 95-damage Rot
-- Mine nobody could reach. ProjectileService.handOrigin already clips a grenade's origin the same
-- way; this is that clip, in the shared module so the server's throw and the client's ghost cannot
-- drift apart. Solid geometry only (RespectCanCollide), so a bush or a decal doesn't shorten a throw.
DefensePlacement.ThrowLead = 2
DefensePlacement.ThrowLift = 0.5
-- The kit is a stud and a half across at its throw scale; half of that, and a little margin, is how
-- far short of the wall the kit's CENTRE has to start so no part of it is inside the wall.
DefensePlacement.ThrowSkin = 0.9

function DefensePlacement.ThrowOrigin(character, headPosition, look, extraExclude)
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = flatLook.Magnitude &gt; 0.01 and flatLook.Unit or Vector3.new(0, 0, -1)
	local wanted = headPosition + flatLook * DefensePlacement.ThrowLead + Vector3.new(0, DefensePlacement.ThrowLift, 0)
	local params = DefensePlacement.GroundParams(character, nil, extraExclude)
	params.RespectCanCollide = true
	local delta = wanted - headPosition
	if delta.Magnitude &lt; 1e-4 then
		return wanted
	end
	-- Cast ThrowSkin PAST the spawn point, not just to it: a wall standing exactly at the spawn point
	-- is not "between" head and point, so a ray that stops there reports nothing and the kit is left
	-- centred on the wall's face with half of itself inside (measured at a 2.0 gap,
	-- tools/defense_throw_probe.lua).
	local direction = delta.Unit
	local hit = workspace:Raycast(headPosition, delta + direction * DefensePlacement.ThrowSkin, params)
	if not hit then
		return wanted
	end
	-- Pulled back so the kit's whole width clears the wall. Where there isn't room in front of the
	-- head for that -- pressed against a wall closer than the kit is wide -- it goes BEHIND the head
	-- rather than into the wall: inside the thrower's own body, which physics resolves against the
	-- thrower, on their side of the wall. Never further back than the kit is deep.
	local keep = math.clamp(hit.Distance - DefensePlacement.ThrowSkin, -DefensePlacement.ThrowSkin, delta.Magnitude)
	return headPosition + direction * keep
end

-- The lob itself, in one place: DefenseService throws the kit on this arc and the client's preview
-- walks the same one to work out where the kit will actually arrive. Longer throws take longer, so the
-- arc keeps its shape; the velocity is the one that puts the kit on `target` after `flightTime` under
-- the world's gravity. Returns velocity, flightTime, target, facing, offset.
DefensePlacement.ThrowSpeed = 40
DefensePlacement.ThrowMinTime = 0.5
DefensePlacement.ThrowMaxTime = 1.6

function DefensePlacement.ThrowArc(from, look, aimPoint)
	local target, facing, offset = DefensePlacement.ThrowTarget(from, look, aimPoint)
	local flightTime = math.clamp(offset.Magnitude / DefensePlacement.ThrowSpeed, DefensePlacement.ThrowMinTime, DefensePlacement.ThrowMaxTime)
	local velocity = Vector3.new(offset.X / flightTime, offset.Y / flightTime + 0.5 * workspace.Gravity * flightTime, offset.Z / flightTime)
	return velocity, flightTime, target, facing, offset
end

-- Where that arc first meets the world, walked in `steps` straight segments with a raycast each: the
-- kit is thrown flat enough that on a hill it can arrive well short of the aim, and this is the only
-- honest answer to "where will it land". Returns the point and whether anything was hit at all (when
-- nothing is, the arc's end is returned, which is the aim point).
function DefensePlacement.TraceThrow(from, velocity, flightTime, params, steps)
	steps = steps or 20
	local gravity = workspace.Gravity
	local previous = from
	for index = 1, steps do
		local t = flightTime * index / steps
		local point = from + velocity * t - Vector3.new(0, 0.5 * gravity * t * t, 0)
		local hit = params and workspace:Raycast(previous, point - previous, params) or nil
		if hit then
			-- The time the arc actually reaches the hit, not the end of the segment it is on: a kit
			-- flown along the arc to this time arrives on the spot.
			local before = flightTime * (index - 1) / steps
			return hit.Position, true, before + (t - before) * hit.Distance / math.max((point - previous).Magnitude, 1e-6)
		end
		previous = point
	end
	return previous, false, flightTime
end

-- A point on the lob `t` seconds after the throw.
function DefensePlacement.ArcPoint(from, velocity, t)
	return from + velocity * t - Vector3.new(0, 0.5 * workspace.Gravity * t * t, 0)
end

-- How long past the aimed flight a kit keeps falling looking for something to land on: aimed at the
-- sky or off a cliff, the arc's end is in the air.
DefensePlacement.FallTime = 3

-- Where a kit thrown on this arc comes down, and when: the arc walked as TraceThrow walks it, and
-- carried on falling past its aimed end when it met nothing. DefenseService builds exactly here -- it
-- no longer lets the kit's physics decide, so nothing bounces or rolls off the spot -- and the
-- preview draws exactly here. Returns the point, whether anything was met, and the time.
function DefensePlacement.Landing(from, velocity, flightTime, params)
	local point, struck, t = DefensePlacement.TraceThrow(from, velocity, flightTime, params)
	if struck then
		return point, true, t
	end
	local previous = point
	local steps = 30
	for index = 1, steps do
		local at = flightTime + DefensePlacement.FallTime * index / steps
		local next_ = DefensePlacement.ArcPoint(from, velocity, at)
		local hit = params and workspace:Raycast(previous, next_ - previous, params) or nil
		if hit then
			local before = flightTime + DefensePlacement.FallTime * (index - 1) / steps
			return hit.Position, true, before + (at - before) * hit.Distance / math.max((next_ - previous).Magnitude, 1e-6)
		end
		previous = next_
	end
	return point, false, flightTime
end

local function addFolders(list, names)
	for _, name in ipairs(names) do
		local instance = workspace:FindFirstChild(name)
		if instance then
			table.insert(list, instance)
		end
	end
end

function DefensePlacement.GroundParams(character, defenses, extraExclude)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = {}
	if character then
		table.insert(filter, character)
	end
	if defenses then
		table.insert(filter, defenses)
	end
	addFolders(filter, DefensePlacement.IgnoredFolders)
	for _, instance in ipairs(extraExclude or {}) do
		table.insert(filter, instance)
	end
	params.FilterDescendantsInstances = filter
	return params
end

--------------------------------------------------------------------------------
-- Anywhere (#128): how a structure stands where it landed
--------------------------------------------------------------------------------

-- How far the base is set INTO the highest ground under it. Not zero: a pad sat exactly on a part
-- floor shares its plane with it, and the two flicker.
DefensePlacement.Embed = 0.15
-- The ground is sampled on a grid about this fine, its outer columns on the footprint's edges.
DefensePlacement.ColumnStep = 3.5
-- Ground rising faster than this from where the kit landed is a wall or a cliff, not a slope, and
-- the structure slides away from it. 62 degrees so a 60-degree hill is still a hill.
DefensePlacement.MaxClimb = math.rad(62)
-- Small things on the ground -- rubble, a crate, a kerb -- are sat over: no bigger than PropSize
-- across and no taller than PropHeight above the ground round them. Unanchored ones are shoved.
DefensePlacement.PropHeight = 3
DefensePlacement.PropSize = 6
-- The longest post. Ground further down than this is not under the structure at all.
DefensePlacement.MaxStilt = 40
-- A deck over water stands this far above the surface, on floats.
DefensePlacement.WaterClear = 0.8
-- How far a barricade tilts to follow the ground along its length; posts take up the rest.
DefensePlacement.WallTilt = math.rad(40)
-- At least this share of the footprint needs ground within MaxStilt, on both sides of the centre
-- both ways: up to half may hang over a ledge, none of it may hang off one side.
DefensePlacement.SupportShare = 0.5
-- Against a wall: the nearest spot this far away that is free, looked for in rings SlideStep apart.
DefensePlacement.SlideStep = 2
-- 14: a fortress thrown into a doorway has to come 13 studs out of it (its half-width and a body's
-- width clear of the door).
DefensePlacement.SlideMax = 14
-- A body's width (an R15 is 2 across, 2.2 with its arms swinging). Leaving less than this between a
-- structure and a wall across a covered passage, or in front of a doorway, shuts someone in.
DefensePlacement.DoorGap = 2.2
-- Posts: a gap shorter than PostMin is bedding, not a stilt.
DefensePlacement.PostMin = 0.35
DefensePlacement.PostWidth = 0.8
-- How far a post goes into the ground: deep enough that the downhill side of its own 0.8-stud foot is
-- still in the ground on a 60-degree slope.
DefensePlacement.FootEmbed = 1
-- A door more than a step up gets a ladder, or a raised bunker is a bunker nobody can get into.
DefensePlacement.LadderStep = 1.5
-- The protected places.
DefensePlacement.ObjectiveCentreShare = 0.35
DefensePlacement.SpawnMargin = 4
DefensePlacement.NoBuildTag = "NoBuild"

-- What each structure needs beyond its box: a wall tilts along its length; a door (the local spot
-- just outside the back doorway, where a ladder goes) and the deck height it opens onto.
DefensePlacement.Profiles = {
	-- `bounds`: the ground the structure really covers, local (the columns, the posts under its edges and
	-- the box that must be clear all use it): the barricade's rail and posts reach 6.2 each way, the
	-- bunker's corner posts 7.5, the fortress's pad and towers 10.1. A post stands at each edge column
	-- and must be under something, so these are never wider than that. `rows`: extra columns (and
	-- posts) under anything standing outside the bounds -- the bunker's sandbag row, out in front of
	-- its pad at z -7.6, from x -6.3 to 6.3.
	RotBarricade = { wall = true, bounds = { x0 = -6.2, x1 = 6.2, z0 = -0.8, z1 = 0.8 } },
	PopupBunker = { door = Vector3.new(0, 0, 8.55), deck = 0.4, metal = true, bounds = { x0 = -7.5, x1 = 7.5, z0 = -7.5, z1 = 7.5 },
		rows = { { z = -8.15, x0 = -6.25, x1 = 6.25 } } },
	BrainrotFortress = { door = Vector3.new(0, 0, 11.05), deck = 0.5, metal = true,
		bounds = { x0 = -10.1, x1 = 10.1, z0 = -10.1, z1 = 10.1 } },
}

DefensePlacement.FootingLook = {
	timber = { color = Color3.fromRGB(116, 84, 52), material = Enum.Material.WoodPlanks },
	steel = { color = Color3.fromRGB(58, 60, 68), material = Enum.Material.Metal },
	float = { color = Color3.fromRGB(196, 72, 48), material = Enum.Material.SmoothPlastic },
}

-- Every refusal left, and nothing else: each protects somebody (or there is nothing to stand on).
DefensePlacement.Refusals = {
	body = "Someone's in the way.",
	spawn = "Keep the spawn clear.",
	objective = "Not on the objective's centre.",
	lane = "Keep the vehicle bays' way out clear.",
	door = "That would shut a doorway.",
	lobby = "Not in the lobby.",
	ground = "Nothing under it to stand on.",
	room = "No room to build here.",
	nobuild = "Can't build here.",
}

local CollectionService = game:GetService("CollectionService")

local function profileOf(size)
	for id, known in pairs(DefensePlacement.Sizes) do
		if known == size then
			return DefensePlacement.Profiles[id] or {}, id
		end
	end
	return {}, nil
end

-- The player, bot or vehicle an instance belongs to, if any: never ground, and never built into.
function DefensePlacement.BodyOf(instance)
	local node = instance
	while node and node ~= workspace do
		if node:IsA("Model") and (node:FindFirstChildOfClass("Humanoid") or node:GetAttribute("VehicleMaxHealth") ~= nil
			or node:FindFirstChildOfClass("VehicleSeat")) then
			return node
		end
		node = node.Parent
	end
	return nil
end

-- Whether two boxes (CFrame, Size) overlap by more than a hair: the separating-axis test.
-- GetPartBoundsInBox answers with bounding boxes, so a sloped roof slab whose ridge is far above the
-- structure "overlaps" it; this is the exact answer that query is filtered through.
function DefensePlacement.BoxesOverlap(cfA, sizeA, cfB, sizeB)
	local a = { cfA.RightVector, cfA.UpVector, cfA.LookVector }
	local b = { cfB.RightVector, cfB.UpVector, cfB.LookVector }
	local ha = { sizeA.X / 2, sizeA.Y / 2, sizeA.Z / 2 }
	local hb = { sizeB.X / 2, sizeB.Y / 2, sizeB.Z / 2 }
	local axes = { a[1], a[2], a[3], b[1], b[2], b[3] }
	for i = 1, 3 do
		for j = 1, 3 do
			local cross = a[i]:Cross(b[j])
			if cross.Magnitude &gt; 1e-6 then
				table.insert(axes, cross.Unit)
			end
		end
	end
	local d = cfB.Position - cfA.Position
	for _, axis in ipairs(axes) do
		local ra = ha[1] * math.abs(a[1]:Dot(axis)) + ha[2] * math.abs(a[2]:Dot(axis)) + ha[3] * math.abs(a[3]:Dot(axis))
		local rb = hb[1] * math.abs(b[1]:Dot(axis)) + hb[2] * math.abs(b[2]:Dot(axis)) + hb[3] * math.abs(b[3]:Dot(axis))
		if math.abs(d:Dot(axis)) &gt;= ra + rb - 0.02 then
			return false
		end
	end
	return true
end

-- The highest point of a part, whatever its rotation.
local function topOf(part)
	local cf, size = part.CFrame, part.Size
	return cf.Y + math.abs(cf.RightVector.Y) * size.X / 2 + math.abs(cf.UpVector.Y) * size.Y / 2
		+ math.abs(cf.LookVector.Y) * size.Z / 2
end

local function rebuildParams(ctx)
	local extra = {}
	for _, instance in ipairs(ctx.extra) do
		table.insert(extra, instance)
	end
	for _, instance in ipairs(ctx.skip) do
		table.insert(extra, instance)
	end
	-- Solid things only: a camo net or a sign is not what a post stands on.
	ctx.ground = DefensePlacement.GroundParams(ctx.character, ctx.defenses, extra)
	ctx.ground.RespectCanCollide = true
	ctx.dry = DefensePlacement.GroundParams(ctx.character, ctx.defenses, extra)
	ctx.dry.RespectCanCollide = true
	ctx.dry.IgnoreWater = true
end

-- A ray that passes through players, bots and vehicles: they are never ground, and whether one is in
-- the way is the overlap check's business.
local function cast(ctx, from, direction, dry)
	for _ = 1, 6 do
		local hit = workspace:Raycast(from, direction, dry and ctx.dry or ctx.ground)
		if not hit then
			return nil
		end
		local body = DefensePlacement.BodyOf(hit.Instance)
		if not body then
			return hit
		end
		table.insert(ctx.skip, body)
		rebuildParams(ctx)
	end
	return nil
end

-- One column of ground: `floor` is what a post stands on (the bed, under water), `top` is what the
-- deck must clear (the waterline plus WaterClear, over water), `surface` the waterline.
local function column(ctx, x, z, top, bottom)
	local from = Vector3.new(x, top, z)
	local down = Vector3.new(0, bottom - top, 0)
	local hit = cast(ctx, from, down, false)
	local col = { x = x, z = z }
	if not hit then
		return col
	end
	if ctx.lobby and hit.Instance:IsDescendantOf(ctx.lobby) then
		col.lobby = true
	end
	if hit.Material == Enum.Material.Water then
		col.surface = hit.Position.Y
		local bed = cast(ctx, from, down, true)
		col.floor = bed and bed.Position.Y or nil
		col.top = col.surface + DefensePlacement.WaterClear
	else
		col.floor = hit.Position.Y
		col.top = col.floor
	end
	return col
end

local function newContext(character, size, flat, defenses, extraExclude)
	local profile, id = profileOf(size)
	local ctx = { character = character, size = size, profile = profile, id = id, defenses = defenses,
		extra = extraExclude or {}, skip = {} }
	ctx.facing = CFrame.lookAt(Vector3.zero, flat)
	ctx.right = ctx.facing.RightVector
	ctx.look = ctx.facing.LookVector
	ctx.halfX, ctx.halfZ = size.X / 2, size.Z / 2
	ctx.probeUp = math.sqrt(ctx.halfX * ctx.halfX + ctx.halfZ * ctx.halfZ) * math.tan(DefensePlacement.MaxClimb)
		+ DefensePlacement.PropHeight + 2
	ctx.lobby = workspace:FindFirstChild("Lobby")
	-- The columns span what the structure really covers on the ground (Profiles.bounds), which is a
	-- little more than its box for some: the bunker's sandbag row stands out in front of its pad.
	local bounds = profile.bounds or {}
	local function axis(lo, hi)
		lo, hi = lo + 0.05, hi - 0.05
		local count = math.max(2, math.ceil((hi - lo) / DefensePlacement.ColumnStep) + 1)
		local list = {}
		for index = 0, count - 1 do
			table.insert(list, lo + (hi - lo) * index / (count - 1))
		end
		return list, (hi - lo) / (count - 1)
	end
	ctx.bounds = { x0 = bounds.x0 or -ctx.halfX, x1 = bounds.x1 or ctx.halfX, z0 = bounds.z0 or -ctx.halfZ, z1 = bounds.z1 or ctx.halfZ }
	local xs, zs
	xs, ctx.stepX = axis(ctx.bounds.x0, ctx.bounds.x1)
	zs, ctx.stepZ = axis(ctx.bounds.z0, ctx.bounds.z1)
	ctx.grid = {}
	for ix, x in ipairs(xs) do
		for iz, z in ipairs(zs) do
			table.insert(ctx.grid, { lx = x, lz = z, ix = ix, iz = iz, edge = ix == 1 or ix == #xs or iz == 1 or iz == #zs })
		end
	end
	ctx.nx, ctx.nz = #xs, #zs
	ctx.box = { x0 = ctx.bounds.x0, x1 = ctx.bounds.x1, z0 = ctx.bounds.z0, z1 = ctx.bounds.z1 }
	for rowIndex, row in ipairs(profile.rows or {}) do
		local rowXs = (axis(row.x0, row.x1))
		for index, x in ipairs(rowXs) do
			table.insert(ctx.grid, { lx = x, lz = row.z, ix = 900 + index, iz = 900 + rowIndex, edge = true, extra = true })
		end
		ctx.box.x0, ctx.box.x1 = math.min(ctx.box.x0, row.x0), math.max(ctx.box.x1, row.x1)
		ctx.box.z0, ctx.box.z1 = math.min(ctx.box.z0, row.z - 0.1), math.max(ctx.box.z1, row.z + 0.1)
	end
	rebuildParams(ctx)
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	local filter = {}
	if character then
		table.insert(filter, character)
	end
	addFolders(filter, DefensePlacement.OverlapIgnoredFolders)
	for _, instance in ipairs(ctx.extra) do
		table.insert(filter, instance)
	end
	overlap.FilterDescendantsInstances = filter
	ctx.overlap = overlap
	return ctx
end

-- The columns under a footprint centred on `c`, with a wall tilted by `roll` (its length then covers
-- less ground: the columns move in by cos(roll)).
local function sample(ctx, c, roll, top, bottom)
	local cols = {}
	local cosR = math.cos(roll)
	for _, cell in ipairs(ctx.grid) do
		local offset = ctx.facing:VectorToWorldSpace(Vector3.new(cell.lx * cosR, 0, cell.lz))
		local col = column(ctx, c.X + offset.X, c.Z + offset.Z, top, bottom)
		col.lx, col.lz, col.edge, col.ix, col.iz, col.extra = cell.lx, cell.lz, cell.edge, cell.ix, cell.iz, cell.extra
		col.dist = math.sqrt(cell.lx * cosR * cell.lx * cosR + cell.lz * cell.lz)
		table.insert(cols, col)
	end
	return cols
end

-- The tilt that lays a wall along the ground: the best straight line through the columns' heights
-- along its length, leaving out the ones that drop away (a ledge is not a slope to follow).
local function fitRoll(cols, ref)
	local climb = math.tan(DefensePlacement.MaxClimb)
	local n, sx, sy, sxx, sxy = 0, 0, 0, 0, 0
	for _, col in ipairs(cols) do
		if col.top and math.abs(col.top - ref) &lt;= col.dist * climb + DefensePlacement.PropHeight then
			n += 1
			sx += col.lx
			sy += col.top
			sxx += col.lx * col.lx
			sxy += col.lx * col.top
		end
	end
	local denom = n * sxx - sx * sx
	if n &lt; 2 or denom &lt; 1e-6 then
		return 0
	end
	return math.clamp(math.atan((n * sxy - sx * sy) / denom), -DefensePlacement.WallTilt, DefensePlacement.WallTilt)
end

-- Whether a wall, a cliff or a fence stands in the footprint. The ground is walked from the columns
-- round the centre, where the kit landed, to their neighbours: up no steeper than MaxClimb, down as
-- far as it likes (dropping off a ledge is what posts are for). A column that can't be reached that
-- way is the top of something the structure would be built through or balanced on: slide instead.
-- A radial "no higher than the slope from the centre" rule let a 6-stud fence between two columns
-- through as a bump, and the barricade was balanced on top of it.
local function walled(ctx, cols, ref, roll)
	local climb = math.tan(DefensePlacement.MaxClimb)
	local stepX, stepZ = ctx.stepX * math.cos(roll), ctx.stepZ
	local byCell = {}
	for _, col in ipairs(cols) do
		byCell[col.ix * 1000 + col.iz] = col
	end
	local reached, queue = {}, {}
	for _, col in ipairs(cols) do
		if not col.extra and col.top and col.dist &lt;= math.max(stepX, stepZ) and col.top &lt;= ref + col.dist * climb + DefensePlacement.PropHeight then
			reached[col] = true
			table.insert(queue, col)
		end
	end
	local head = 1
	while head &lt;= #queue do
		local col = queue[head]
		head += 1
		for _, step in ipairs({ { 1, 0, stepX }, { -1, 0, stepX }, { 0, 1, stepZ }, { 0, -1, stepZ } }) do
			local next_ = byCell[(col.ix + step[1]) * 1000 + col.iz + step[2]]
			if next_ and next_.top and not reached[next_] and next_.top &lt;= col.top + step[3] * climb then
				reached[next_] = true
				table.insert(queue, next_)
			end
		end
	end
	-- Unreached but low (the far side of a gap) is not a wall. An extra row is judged against the
	-- nearest reached column: no steeper than MaxClimb from it.
	for _, col in ipairs(cols) do
		local high = col.top and col.top &gt; ref + DefensePlacement.PropHeight
		if col.extra and col.top then
			local nearest, gap = nil, math.huge
			for _, other in ipairs(cols) do
				if reached[other] then
					local d = math.sqrt((other.x - col.x) ^ 2 + (other.z - col.z) ^ 2)
					if d &lt; gap then
						nearest, gap = other, d
					end
				end
			end
			high = not nearest or col.top &gt; nearest.top + gap * climb
		end
		if high and (col.extra or not reached[col]) then
			return true
		end
	end
	return false
end

-- How far a point is from a footprint (level frame, half extents), on the ground plane.
local function footprintDistance(frame, halfX, halfZ, x, z)
	local p = frame:PointToObjectSpace(Vector3.new(x, frame.Y, z))
	local dx = math.max(math.abs(p.X) - halfX, 0)
	local dz = math.max(math.abs(p.Z) - halfZ, 0)
	return math.sqrt(dx * dx + dz * dz)
end

-- The protected places, from what the world itself shows (the client has to reach the same answer
-- for its preview, so nothing here may come from a server-only table): an objective's centre (the
-- Hill models' own HillX/HillZ/HillRadius), a spawn (any SpawnLocation, and a team base's "Spawn"
-- bunker), and anything tagged NoBuild -- a team base's bays and their ways out (TeamBaseRuins'
-- NoBuildLane parts, whose NoBuildReason says so), and the way in for any other place to keep clear.
-- Tags replicate, so the client's preview sees the same zones.
local function zoneRefusal(ctx, frame)
	local R = DefensePlacement.Refusals
	local box = frame * CFrame.new(0, ctx.size.Y / 2, 0)
	local hill = workspace:FindFirstChild("Hill")
	if hill then
		for _, objective in ipairs(hill:GetChildren()) do
			local x, z, radius = objective:GetAttribute("HillX"), objective:GetAttribute("HillZ"), objective:GetAttribute("HillRadius")
			if x and z and radius and footprintDistance(frame, ctx.halfX, ctx.halfZ, x, z) &lt; radius * DefensePlacement.ObjectiveCentreShare then
				return R.objective
			end
		end
	end
	for _, tagged in ipairs(CollectionService:GetTagged(DefensePlacement.NoBuildTag)) do
		local cf, size = nil, nil
		if tagged:IsA("BasePart") then
			cf, size = tagged.CFrame, tagged.Size
		elseif tagged:IsA("Model") then
			cf, size = tagged:GetBoundingBox()
		end
		if cf and DefensePlacement.BoxesOverlap(cf, size, box, ctx.size) then
			return tagged:GetAttribute("NoBuildReason") or R.nobuild
		end
	end
	local margin = 2 * DefensePlacement.SpawnMargin
	for _, part in ipairs(workspace:GetPartBoundsInBox(box, ctx.size + Vector3.new(margin, 6, margin), ctx.overlap)) do
		if part:IsA("SpawnLocation") then
			return R.spawn
		end
		local bunker = part:FindFirstAncestor("Spawn")
		if bunker and bunker.Parent and string.sub(bunker.Parent.Name, 1, 8) == "TeamBase" then
			return R.spawn
		end
	end
	return nil
end

-- What is in the structure's box once it stands at `origin`: "body" (a player, bot or vehicle, at
-- all: those refuse), "static" (a wall, a tree: slide), or "prop" and the level that clears the
-- props (sit over them). Loose, unanchored debris is shoved aside by the rising structure.
local function obstruction(ctx, c, origin, level, roll)
	local size = ctx.size
	local clear = DefensePlacement.Embed + 0.1
	local height = size.Y - clear
	local b = ctx.box
	local boxCF = origin * CFrame.new((b.x0 + b.x1) / 2, clear + height / 2, (b.z0 + b.z1) / 2)
	local boxSize = Vector3.new(b.x1 - b.x0 - 0.2, height, b.z1 - b.z0 - 0.2)
	-- Bodies count half a stud out and from the ground up: one pressed against the edge would be
	-- shoved by the rise.
	local roomCF = origin * CFrame.new(0, size.Y / 2, 0)
	local roomSize = size + Vector3.new(1, 1, 1)
	local tanR = math.tan(roll)
	local static, propLevel = false, nil
	for _, part in ipairs(workspace:GetPartBoundsInBox(roomCF, roomSize, ctx.overlap)) do
		local body = DefensePlacement.BodyOf(part)
		if body then
			if DefensePlacement.BoxesOverlap(part.CFrame, part.Size, roomCF, roomSize) then
				return "body"
			end
		elseif part.CanCollide and DefensePlacement.BoxesOverlap(part.CFrame, part.Size, boxCF, boxSize) then
			local across = (part.Position - c):Dot(ctx.right)
			local base = level + across * tanR
			local small = math.max(part.Size.X, part.Size.Y, part.Size.Z) &lt;= DefensePlacement.PropSize
			if small and topOf(part) &lt;= base + DefensePlacement.Embed + DefensePlacement.PropHeight then
				if part.Anchored then
					propLevel = math.max(propLevel or -math.huge, topOf(part) - across * tanR - DefensePlacement.Embed)
				end
			else
				static = true
			end
		end
	end
	if static then
		return "static"
	end
	if propLevel and propLevel &gt; level + 1e-3 then
		return "prop", propLevel
	end
	return nil
end

-- Whether a structure standing here would shut someone in: spanning a covered passage (a doorway, a
-- corridor) with less than a body's width left on both sides, or standing closer than that in front
-- of an opening in a wall (a wall on both sides of a gap at least 3 studs wide).
local function sealsPassage(ctx, c, level)
	local gap = DefensePlacement.DoorGap
	local centre = Vector3.new(c.X, level + 2.5, c.Z)
	local roof = cast(ctx, Vector3.new(c.X, level + 0.5, c.Z), Vector3.new(0, ctx.size.Y + 6, 0), false)
	if roof then
		for _, axis in ipairs({ { ctx.right, ctx.halfX }, { ctx.look, ctx.halfZ } }) do
			local reach = axis[1] * (axis[2] + gap)
			if cast(ctx, centre, reach, false) and cast(ctx, centre, -reach, false) then
				return true
			end
		end
	end
	for _, face in ipairs({
		{ ctx.look, ctx.right, ctx.halfZ, ctx.halfX },
		{ -ctx.look, ctx.right, ctx.halfZ, ctx.halfX },
		{ ctx.right, ctx.look, ctx.halfX, ctx.halfZ },
		{ -ctx.right, ctx.look, ctx.halfX, ctx.halfZ },
	}) do
		local normal, along, depth, length = face[1], face[2], face[3], face[4]
		local seenWall, run = false, 0
		local steps = math.floor(2 * length)
		for index = 0, steps - 1 do
			local s = -length + 0.5 + index * (2 * length - 1) / math.max(steps - 1, 1)
			local from = centre + along * s + normal * (depth - 0.3)
			if cast(ctx, from, normal * (gap + 0.3), false) then
				if seenWall and run &gt;= 3 then
					return true
				end
				seenWall, run = true, 0
			else
				run += 1
			end
		end
	end
	return false
end

-- Whether the ground from `a` to `b` can be walked without climbing a wall: a slide may go round a
-- corner of the footprint's own site, never up the side of a building onto its roof.
local function pathClear(ctx, a, b, top, bottom)
	local flatA, flatB = Vector3.new(a.X, 0, a.Z), Vector3.new(b.X, 0, b.Z)
	local steps = math.max(1, math.ceil((flatB - flatA).Magnitude))
	local climb = math.tan(DefensePlacement.MaxClimb)
	local stride = (flatB - flatA).Magnitude / steps
	local previous, last = nil, nil
	for index = 0, steps do
		local p = flatA:Lerp(flatB, index / steps)
		local col = column(ctx, p.X, p.Z, top, bottom)
		if col.top and previous and col.top - previous &gt; stride * climb + 0.5 then
			return false
		end
		-- And across, at the height a walker on the steepest slope allowed would be: a wall this
		-- stride crosses is hit, whether or not the column rays (which start inside it) saw it.
		if previous and last then
			local height = previous + stride * climb + 0.5
			if cast(ctx, Vector3.new(last.X, height, last.Z), Vector3.new(p.X - last.X, 0, p.Z - last.Z), false) then
				return false
			end
		end
		previous = col.top or previous
		last = p
	end
	return true
end

-- The level-and-footing plan for a structure centred on `c`, or nil, why not and what kind of
-- refusal it is: "zone", "body" and "ground" are final, "blocked" (a wall in the way) tries the
-- nearest free spot instead.
local function settle(ctx, c)
	local R = DefensePlacement.Refusals
	local up = cast(ctx, c, Vector3.new(0, ctx.probeUp, 0), false)
	local top = up and (up.Position.Y - 0.05) or (c.Y + ctx.probeUp)
	local bottom = c.Y - DefensePlacement.MaxStilt - 2
	local middle = column(ctx, c.X, c.Z, top, bottom)
	if middle.lobby then
		return nil, R.lobby, "zone"
	end
	local cols = sample(ctx, c, 0, top, bottom)
	local ref = middle.top
	for _, col in ipairs(cols) do
		if col.lobby then
			return nil, R.lobby, "zone"
		end
		if not middle.top and col.top then
			ref = math.max(ref or -math.huge, col.top)
		end
	end
	if not ref then
		return nil, R.ground, "ground"
	end
	-- Protected places refuse before anything else: sliding out of a spawn is not the answer.
	local zone = zoneRefusal(ctx, CFrame.new(c.X, ref, c.Z) * ctx.facing)
	if zone then
		return nil, zone, "zone"
	end

	-- A wall in the way first, so a wall's top is never taken for ground to tilt a barricade along.
	if walled(ctx, cols, ref, 0) then
		return nil, R.room, "blocked"
	end
	local roll = 0
	if ctx.profile.wall then
		roll = fitRoll(cols, ref)
		if math.abs(roll) &gt; 1e-3 then
			cols = sample(ctx, c, roll, top, bottom)
			if walled(ctx, cols, ref, roll) then
				return nil, R.room, "blocked"
			end
		end
	end
	local lift = math.sin(roll)
	local level = -math.huge
	for _, col in ipairs(cols) do
		if col.top then
			level = math.max(level, col.top - col.lx * lift)
		end
	end
	if level == -math.huge then
		level = ref
	end
	level -= DefensePlacement.Embed

	local origin = nil
	for _ = 1, 4 do
		local candidate = CFrame.new(c.X, level, c.Z) * ctx.facing * CFrame.Angles(0, 0, roll)
		local kind, raised = obstruction(ctx, c, candidate, level, roll)
		if kind == "body" then
			return nil, R.body, "body"
		elseif kind == "static" then
			return nil, R.room, "blocked"
		elseif kind == "prop" then
			level = raised
		else
			origin = candidate
			break
		end
	end
	if not origin then
		return nil, R.room, "blocked"
	end
	-- A terrain overhang above is not a part, so the box check can't see it.
	if up and up.Instance == workspace.Terrain and level + ctx.size.Y &gt; up.Position.Y then
		return nil, R.room, "blocked"
	end

	local count, minX, maxX, minZ, maxZ = 0, math.huge, -math.huge, math.huge, -math.huge
	for _, col in ipairs(cols) do
		if col.floor and level + col.lx * lift - col.floor &lt;= DefensePlacement.MaxStilt then
			count += 1
			minX, maxX = math.min(minX, col.lx), math.max(maxX, col.lx)
			minZ, maxZ = math.min(minZ, col.lz), math.max(maxZ, col.lz)
		end
	end
	if count &lt; #cols * DefensePlacement.SupportShare or minX &gt; 0 or maxX &lt; 0 or minZ &gt; 0 or maxZ &lt; 0 then
		return nil, R.ground, "ground"
	end

	if sealsPassage(ctx, c, level) then
		return nil, R.door, "blocked"
	end

	local door = nil
	if ctx.profile.door then
		local offset = ctx.facing:VectorToWorldSpace(ctx.profile.door)
		door = column(ctx, c.X + offset.X, c.Z + offset.Z, top, bottom)
	end
	local plan = { origin = origin, level = level, roll = roll, centre = c, columns = cols, door = door,
		size = ctx.size, profile = ctx.profile, id = ctx.id, facing = ctx.facing, top = top, bottom = bottom, nx = ctx.nx, nz = ctx.nz }
	plan.footings = DefensePlacement.Footings(plan)
	return plan
end

local slideOffsets = nil
local function slides()
	if slideOffsets then
		return slideOffsets
	end
	slideOffsets = {}
	local radius = DefensePlacement.SlideStep
	while radius &lt;= DefensePlacement.SlideMax + 1e-6 do
		for index = 0, 7 do
			local angle = index * math.pi / 4
			table.insert(slideOffsets, Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius))
		end
		radius += DefensePlacement.SlideStep
	end
	return slideOffsets
end

-- The posts, sill, floats and ladder a plan stands on, as { kind, size, cframe, color, material,
-- shape, class } in world space. One list, read by DefenseService to build them and by the preview to
-- draw them, so the ghost's footings are the built ones to the stud.
function DefensePlacement.Footings(plan)
	local list = {}
	local profile = plan.profile or {}
	local look = profile.metal and DefensePlacement.FootingLook.steel or DefensePlacement.FootingLook.timber
	local lift = math.sin(plan.roll)
	local posts = 0
	for _, col in ipairs(plan.columns) do
		if col.edge and col.floor then
			local base = plan.level + col.lx * lift
			local gap = base - col.floor
			if gap &gt; DefensePlacement.PostMin and gap &lt;= DefensePlacement.MaxStilt then
				-- Up into the pad (or the sill under a wall's sandbags), never ending in its plane.
				local topY = profile.wall and (base - 0.1) or (base + 0.2)
				local bottomY = col.floor - DefensePlacement.FootEmbed
				table.insert(list, { kind = "post", size = Vector3.new(DefensePlacement.PostWidth, topY - bottomY, DefensePlacement.PostWidth),
					cframe = CFrame.new(col.x, (topY + bottomY) / 2, col.z) * plan.facing, color = look.color, material = look.material })
				posts += 1
			end
		end
		if col.edge and col.surface then
			-- A Cylinder's length is its X axis: the float lies along the structure's width.
			table.insert(list, { kind = "float", shape = Enum.PartType.Cylinder, size = Vector3.new(2.4, 1.4, 1.4),
				cframe = CFrame.new(col.x, col.surface, col.z) * plan.facing,
				color = DefensePlacement.FootingLook.float.color, material = DefensePlacement.FootingLook.float.material })
		end
	end
	if profile.wall and posts &gt; 0 then
		-- A sill under the bottom row, so the bags between two posts rest on something.
		table.insert(list, { kind = "sill", size = Vector3.new(plan.size.X, 0.5, 1.2), cframe = plan.origin * CFrame.new(0, -0.15, 0),
			color = look.color, material = look.material })
	end
	local door = plan.door
	if door and door.floor and profile.deck then
		local deck = plan.level + profile.deck
		local gap = deck - door.floor
		if gap &gt; DefensePlacement.LadderStep and gap &lt;= DefensePlacement.MaxStilt then
			-- A TrussPart is sized in whole 2-stud cells: rounded up, the extra goes into the ground.
			local topY = deck + 0.3
			local height = math.ceil((topY - (door.floor - 0.3)) / 2) * 2
			table.insert(list, { kind = "ladder", class = "TrussPart", size = Vector3.new(2, height, 2),
				cframe = CFrame.new(door.x, topY - height / 2, door.z) * plan.facing,
				color = DefensePlacement.FootingLook.steel.color, material = Enum.Material.Metal })
		end
	end
	return list
end

-- The whole answer: a plan (see settle) for the structure where it landed or at the nearest free spot
-- within SlideMax, or nil, why not and the kind of refusal. Bots and the preview both come through
-- here (DefenseService.CheckSite, DefensePreview.Site), so all three agree.
function DefensePlacement.Plan(character, size, centre, flat, defenses, extraExclude)
	local ctx = newContext(character, size, flat, defenses, extraExclude)
	local plan, reason, kind = settle(ctx, centre)
	if plan then
		plan.slid = Vector3.zero
		return plan
	end
	if kind ~= "blocked" then
		return nil, reason, kind
	end
	-- Under the same ceiling the landing spot has: from a doorway, the path is walked under the lintel,
	-- not over the roof.
	local up = cast(ctx, centre, Vector3.new(0, ctx.probeUp, 0), false)
	local top = up and (up.Position.Y - 0.05) or (centre.Y + ctx.probeUp)
	local bottom = centre.Y - DefensePlacement.MaxStilt - 2
	for _, offset in ipairs(slides()) do
		local shift = ctx.facing:VectorToWorldSpace(offset)
		local moved = centre + shift
		if pathClear(ctx, centre, moved, top, bottom) then
			local found = settle(ctx, moved)
			if found then
				found.slid = shift
				return found
			end
		end
	end
	return nil, reason, kind
end

-- Whether a structure of `size` can stand centred on `centre` with its front toward `flat` (a unit
-- direction on the ground plane): the origin to build at (level with the ground, or tilted along a
-- wall's length) and the plan with its footings, or nil and why not.
function DefensePlacement.FindSite(character, size, centre, flat, defenses, extraExclude)
	local plan, reason = DefensePlacement.Plan(character, size, centre, flat, defenses, extraExclude)
	if not plan then
		return nil, reason
	end
	return plan.origin, nil, plan
end

return DefensePlacement
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">GameModes</string><ProtectedString name="Source">-- The game modes. The battle royale is one of them and is unchanged by any of this; Team
-- Deathmatch and King of the Hill are the two that respawn you.
--
-- This module is DEFINITIONS ONLY, shared so the client can name a mode, colour a team and draw a
-- scoreline without a round trip. Everything that happens on a server lives in
-- ServerScriptService.Modules.GameMode and the three Mode* modules beside it.
--
-- The flags a mode carries, and who reads them:
--   respawn       death is not an elimination: the mode scores it and puts the player back
--   teams         combatants are split into the two sides below, and friendly fire is off
--   storm         the shrinking circle runs (battle royale only)
--   bounds        a STATIC boundary circle is drawn instead, and never shrinks
--   dropSelect    the 15-second "choose your drop" window runs
--   dropLoot      a death puts the victim's gear on the floor
--   loadout       everyone spawns carrying `Loadout` below (Oliver's green weapon + heals + throwables)
--
-- No mode introduces a new match STATE string. The HUD banner, CombatClient, MovementClient,
-- ProjectileClient and TouchControls all gate on the state string (27 sites), and an unrecognised
-- value would break them quietly — the same reason the drop window rides as a flag on `Loading`
-- rather than as a state of its own. A mode is a FIELD on the broadcast, never a new state.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Rarity = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Rarity"))

local GameModes = {}

--------------------------------------------------------------------------------
-- Teams
--------------------------------------------------------------------------------

-- Two sides. The colours are MEASURED, not picked by eye: of twelve readable team shades, these
-- two are the pair that is furthest from every rarity colour in Rarity.Colors while still being
-- unmistakable from each other. Weighted-RGB distance: each is at least 143 from the nearest
-- rarity colour (the next best pair scored 129) and they are 452 apart from one another. That
-- matters because a team tint on a nameplate or a scoreline must never read as a rarity tint —
-- Legendary is (255,184,48) and an orange team colour drifts into it fast (amber scored 39).
GameModes.Teams = {
	{ id = "Ember", name = "Ember Squad", short = "EMBER", color = Color3.fromRGB(255, 112, 36) },
	{ id = "Teal", name = "Teal Crew", short = "TEAL", color = Color3.fromRGB(40, 196, 190) },
}

GameModes.TeamCount = #GameModes.Teams

-- 1 -&gt; 2, 2 -&gt; 1. Written as a function rather than "3 - index" so a third team, if it ever
-- happens, fails loudly here instead of silently returning nothing.
function GameModes.OtherTeam(index)
	if index == 1 then
		return 2
	elseif index == 2 then
		return 1
	end
	return nil
end

function GameModes.Team(index)
	return GameModes.Teams[index]
end

function GameModes.TeamColor(index)
	local team = GameModes.Teams[index]
	return team and team.color or Color3.fromRGB(200, 200, 200)
end

function GameModes.TeamName(index)
	local team = GameModes.Teams[index]
	return team and team.name or "No team"
end

--------------------------------------------------------------------------------
-- The spawn loadout (Oliver: "you spawn with a green weapon some heals, and throwables")
--------------------------------------------------------------------------------

-- GREEN IS **Uncommon**. Not a guess: Rarity.Colors.Uncommon is (94, 214, 122) and it is the only
-- green in the table — Common is grey (178,184,196), Rare blue, Epic purple, Legendary orange,
-- Mythic pink, Secret cyan. `GameModes.GreenRarity` is the name; `GameModes.AssertGreen` below
-- re-proves it from the data at runtime so a future palette change cannot quietly make this a lie.
GameModes.GreenRarity = "Uncommon"

-- Proves the tier named above really is the green one, from a palette's own numbers. PURE and
-- parameterised on purpose: the probe calls this exact function twice, once on Rarity's real table
-- and once on a palette deliberately broken so a different tier is the green one, and fails if the
-- broken palette is accepted. A detector that has quietly stopped detecting then shows up as a red
-- probe rather than as a green one that checks nothing.
--
-- "Greenest" is argmax of (G - max(R, B)): the channel lead over the brightest of the other two.
-- Plain "largest G" would crown Secret (120,255,235), which is cyan.
function GameModes.GreenCheck(colors, order, name)
	local mine = colors and colors[name]
	if not mine then
		return false, "no such rarity: " .. tostring(name)
	end
	local r, g, b = mine.R * 255, mine.G * 255, mine.B * 255
	if g &lt;= r or g &lt;= b then
		return false, string.format("%s is not green: R%d G%d B%d", tostring(name), r, g, b)
	end

	local bestName, bestLead = nil, -math.huge
	for _, other in ipairs(order) do
		local colour = colors[other]
		if colour then
			local lead = colour.G * 255 - math.max(colour.R * 255, colour.B * 255)
			if lead &gt; bestLead then
				bestName, bestLead = other, lead
			end
		end
	end
	if bestName ~= name then
		return false, string.format("%s is greener than %s (lead %.0f)", tostring(bestName), tostring(name), bestLead)
	end
	return true, string.format("%s R%d G%d B%d, lead %.0f", name, r, g, b, g - math.max(r, b))
end

function GameModes.AssertGreen()
	return GameModes.GreenCheck(Rarity.Colors, Rarity.Order, GameModes.GreenRarity)
end

-- What everyone spawns with, on the first spawn and on every respawn.
--
-- The GUN is not listed here on purpose: the pool of Uncommon guns is built at RUN TIME from
-- WeaponData.Weapons, because hardcoding ids would already be stale. Base WeaponData holds 6
-- Uncommon guns, ArsenalExpansion adds 2, CreativeArsenal 2 and WorkshopArsenal 1 — eleven today,
-- and the arsenal tabs are still landing packs. GameMode builds the pool and prints its size.
--
-- Heals: Bandages, not Med Kits. A Med Kit takes 5 seconds to use (ItemData), which is most of a
-- respawn timer; a Bandage takes 2.5. Mini Shields are in on Oliver's call — without any shield the
-- time-to-kill between two Uncommon guns is short enough that whoever shoots first simply wins.
--
-- Five of the eight slots, so three stay free for what you pick up off the map. Looting still
-- means something in a mode that hands you a kit.
GameModes.Loadout = {
	items = {
		{ id = "Bandage", count = 3 },
		{ id = "MiniShield", count = 2 },
		{ id = "CookedCoconut", count = 2 },
		{ id = "LowkeyLatte", count = 1 },
		-- #114: the popup barricade in the team kit. The Rot Barricade IS the popup barricade (thrown,
		-- rises out of the ground where it lands, 250 HP); one per life, so cover is a decision rather
		-- than a spam.
		{ id = "RotBarricade", count = 1 },
	},
	-- Checked by the loadout probe so a silent drift in ItemData's stack sizes shows up as a
	-- failure rather than as a quietly truncated kit.
	slotsUsed = 6,
}

--------------------------------------------------------------------------------
-- Modes
--------------------------------------------------------------------------------

-- Match events that still make sense in a respawn mode. Zone Rush and Hot Drops need a storm and
-- supply drops; Loot Frenzy and Aura Farm are about chests, which nobody is fighting over when the
-- kit is handed to you. The rest change how the fight feels and are kept.
local RESPAWN_EVENTS = {
	RotRush = true,
	LowGravity = true,
	NightOps = true,
	Headhunter = true,
	ShieldUp = true,
	BountyRush = true,
}

GameModes.Order = { "BattleRoyale", "TeamDeathmatch", "KingOfTheHill" }

GameModes.Modes = {
	BattleRoyale = {
		id = "BattleRoyale",
		name = "Battle Royale",
		short = "BR",
		description = "Fifty in, one out. The storm closes until there is nowhere left to stand.",
		color = Color3.fromRGB(186, 104, 255),
		respawn = false,
		teams = false,
		storm = true,
		bounds = false,
		dropSelect = true,
		dropLoot = true,
		loadout = false,
	},

	TeamDeathmatch = {
		id = "TeamDeathmatch",
		name = "Team Deathmatch",
		short = "TDM",
		description = "Two sides, one arena, and you come straight back.",
		color = Color3.fromRGB(255, 112, 36),
		respawn = true,
		teams = true,
		storm = false,
		bounds = true,
		dropSelect = false,
		-- Nobody needs the floor covered in guns in a mode that hands out a kit every five seconds.
		dropLoot = false,
		loadout = true,

		respawnDelay = 5,
		spawnProtection = 3,
		scoreTarget = 100,  -- Oliver, 2026-09-18: first to 100 team kills (was 50)
		timeLimit = 480,
		scoreLabel = "eliminations",
		events = RESPAWN_EVENTS,
	},

	KingOfTheHill = {
		id = "KingOfTheHill",
		-- Oliver 09-22 15:39: renamed and made two objectives (ModeKingOfTheHill). The id stays.
		name = "Objective Capture",
		short = "OBJ",
		description = "Two objectives. Capture them, and each one your team holds scores every second.",
		color = Color3.fromRGB(40, 196, 190),
		respawn = true,
		teams = true,
		storm = false,
		bounds = true,
		dropSelect = false,
		dropLoot = false,
		loadout = true,

		-- A second longer than TDM: losing the hill should cost the side that lost it more than
		-- losing a duel in the open costs.
		respawnDelay = 6,
		spawnProtection = 3,
		scoreTarget = 250,
		timeLimit = 480,
		scoreLabel = "seconds held",
		events = RESPAWN_EVENTS,

		-- ONE FIXED HILL (Oliver's decision, taken knowing one side may fortify it). The rotation
		-- below is built and tested but NOT enabled: flipping `hillRotation` to true is the whole
		-- change if the measurement ever says a static hill kills the match.
		hillRotation = false,
		hillRotateSeconds = 90,
		hillWarnSeconds = 10,
		hillRadius = 28,
		-- How much of the hill's height counts. A capture zone that reached the sky would let
		-- someone hold it from a third-floor window across the square.
		hillHeight = 22,
	},
}

-- Which mode each match runs. Rotation, not a vote, so the modes are IN the game and playable
-- rather than waiting on owned vote UI; the vote is designed separately. The battle royale keeps
-- three slots in five because it is the main game and Oliver asked for these ALONGSIDE it, not
-- instead of it.
GameModes.Rotation = { "BattleRoyale", "TeamDeathmatch", "BattleRoyale", "KingOfTheHill", "BattleRoyale" }

-- THE SENTENCE IS BUILT FROM THE NUMBER, because the two drifted.
--
-- `TeamDeathmatch.description` read "First to 50 eliminations" while `scoreTarget` a few lines above
-- it in the same table read 100 (Oliver asked for 100 on 2026-09-18 and got it). Anything printing
-- the sentence -- a vote card, a mode picker, a toast -- told him the wrong number. Editing the
-- string would fix today and drift again the next time the target moves; composing it cannot.
--
-- So the tables above carry a description with NO NUMBER IN IT, and the scoring sentence is added
-- here from the mode's own scoreTarget. tools/verify.py refuses a build where any description
-- hard-codes a number that disagrees with its scoreTarget, with a planted needle, so a literal
-- creeping back in is caught rather than shipped.
local SCORE_SENTENCE = {
	TeamDeathmatch = " First to %d eliminations.",
	KingOfTheHill = " First to %d seconds held.",
}

for id, sentence in pairs(SCORE_SENTENCE) do
	local mode = GameModes.Modes[id]
	if mode and mode.scoreTarget then
		mode.description = mode.description .. string.format(sentence, mode.scoreTarget)
	end
end

function GameModes.Get(id)
	return GameModes.Modes[id]
end

-- The mode at a given position in the rotation, 1-based and wrapping. Takes the match number, so
-- a server that has run six matches is at rotation slot 2 again.
function GameModes.FromRotation(matchNumber)
	local list = GameModes.Rotation
	local index = ((math.floor(matchNumber) - 1) % #list) + 1
	return GameModes.Modes[list[index]] or GameModes.Modes.BattleRoyale
end

-- Whether a rolled match event is allowed in this mode. A mode with no allowlist takes anything,
-- which is the battle royale.
function GameModes.AllowsEvent(mode, event)
	if not event or not mode or not mode.events then
		return true
	end
	return mode.events[event.id] == true
end

-- What the client is told about the mode: enough to name it, colour it and draw a scoreline.
function GameModes.Describe(mode)
	if not mode then
		return nil
	end
	return {
		id = mode.id,
		name = mode.name,
		short = mode.short,
		description = mode.description,
		color = mode.color,
		teams = mode.teams == true,
		respawn = mode.respawn == true,
		scoreTarget = mode.scoreTarget,
		scoreLabel = mode.scoreLabel,
	}
end

return GameModes
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">GamepassConfig</string><ProtectedString name="Source">-- Every `id = 0` is a placeholder. Anything still at 0 is hidden from the in-game shop, so
-- the game runs fine before you set monetization up.
--
-- GAMEPASS = bought once, owned forever.
-- DEVELOPER PRODUCT = bought repeatedly (single-use boosts, crates, coin packs, brainrots).
--
-- SETTING IT UP (do this once, after the place is published)
-- ------------------------------------------------------------
--  1. Open https://create.roblox.com/dashboard/creations, click this experience, then in the left
--     menu choose Monetization.
--  2. GAMEPASSES: Monetization -&gt; Passes -&gt; Create a Pass. Make one pass for every entry in
--     GamepassConfig.Passes below, using its `name` and `description`, and upload any square image.
--     After creating it, open the pass, choose Sales, switch "Item for Sale" on and set the price to
--     `suggestedPrice`. The pass's ID is the number in its URL: paste it over that entry's `id = 0`.
--       Iron Sahur 300 R$, Rot Runner 300 R$, 2x SahurCoins 350 R$, Brainrot Pass Premium 450 R$,
--       2x Crate Luck 350 R$.
--  3. DEVELOPER PRODUCTS: Monetization -&gt; Developer Products -&gt; Create a Developer Product. Make one
--     product for every entry in GamepassConfig.Products (bundles, boosts, crates, coin packs, and
--     the seven "Brainrot: &lt;Rarity&gt;" products), with its `name`, `description` and `suggestedPrice`.
--     Paste each product's ID over its `id = 0`. The brainrot products' IDs go in the
--     BrainrotProductIds table further down, one per rarity, not in the Products table.
--  4. Game Settings -&gt; Security: switch on "Enable Studio Access to API Services" (purchases and
--     saving both need DataStores), then publish.
--  5. Test from a real client (not Studio's Run): Studio fakes purchases, and receipts are only
--     retried and saved properly in a live server.
--
-- Prices are only suggestions here: whatever you set on the dashboard is what players pay. Keep the
-- dashboard and `suggestedPrice` in step, since the shop cards show `suggestedPrice`.

local GamepassConfig = {}

-- The Daily Spin can hand any pass out for a day (a temporary pass, tracked in the profile), so
-- everyone gets a taste.
GamepassConfig.Passes = {
	ExtraHealth = {
		id = 1995380456,
		name = "Iron Sahur",
		description = "+50 max health in every match, permanently.",
		-- 300 R$: every permanent pass is at least 300 (Oliver, 2026-09-24).
		suggestedPrice = 300,
		order = 1,
	},
	ExtraSpeed = {
		id = 1994036507,
		name = "Rot Runner",
		description = "+4 walkspeed in every match, permanently.",
		-- 300 R$: every permanent pass is at least 300 (Oliver, 2026-09-24).
		suggestedPrice = 300,
		order = 2,
	},
	-- Doubles every coin EARNED by playing, through Monetization.EarnCoins: placements, kills,
	-- bounties, streaks, match events, quests and weekly challenges, achievements, Brainrot Pass coin
	-- rewards, Daily Spin coins, set bonuses, the obby, goals and easter eggs.
	-- Never doubled: coins bought with Robux (coin packs, bundles), crate jackpots and duplicate
	-- refunds (those are part of what a crate says it contains), and, while `doublesSelling` is false,
	-- coins from selling brainrots. Selling stays at face value because with it doubled, buying crates
	-- with coins and selling the pulls turns a profit for an owner of both this and 2x Crate Luck (a
	-- Common Crate returns 794 coins on average for 500). tools/verify.py checks that no crate is
	-- profitable that way, so turning `doublesSelling` on without re-pricing crates fails the build.
	CoinBoost = {
		id = 1993988489,
		name = "2x SahurCoins",
		description = "Doubles every SahurCoin you earn by playing: matches, kills, bounties, quests, achievements, the Brainrot Pass, the Daily Spin and set bonuses.",
		suggestedPrice = 350,
		multiplier = 2,
		doublesSelling = false,
		order = 3,
	},
	-- Every crate you open rolls twice and keeps the rarer result (CrateData.EffectiveOdds). Owners
	-- see the boosted odds on every crate card, because the cards and the roll use the same function.
	CrateLuck = {
		id = 1994690460,
		name = "2x Crate Luck",
		description = "Every crate you open rolls twice and keeps the rarer result. Crate cards show your boosted odds.",
		suggestedPrice = 350,
		luck = 2,
		order = 5,
	},
	BrainrotPassPremium = {
		id = 1994252489,
		name = "Brainrot Pass Premium",
		description = "Unlocks the premium reward track on the Brainrot Pass.",
		-- 450 R$ (Oliver, 2026-09-18). The premium track runs the length of a season, so it's priced
		-- as a season pass rather than as a one-off unlock.
		suggestedPrice = 450,
		order = 4,
	},
}

-- `grant` tells Monetization what to hand over. Kinds: Coins, Crate, Consumable, Bundle.
--
-- A Bundle's `contents` is a list of the other kinds plus Cosmetic (`id` from CosmeticData). A
-- `limit` makes the shop stop offering it once a player has bought it that many times; a player
-- who somehow buys past it still gets everything, since they paid. Bundle exclusives that are
-- already owned turn into `duplicateCoins` instead. `featured` products get a big card at the top
-- of the Robux Shop, in `featured` order, with `badge` and `worth` shown on it.
GamepassConfig.Products = {
	StarterBundle = {
		id = 3714557565,
		name = "Starter Bundle",
		description = "One time only. Everything you need to get your collection going.",
		featured = 1,
		badge = "ONE TIME ONLY",
		-- "Worth" is counted at this shop's own Robux prices (Oliver, 2026-09-22: fix the worth lines):
		-- 25K coins at the 50K pack's rate, Legendary 499, Epic 135, 2 Rare 70, 2 Health boosts 70 =
		-- 974 R$, before the exclusive. Recount it here if a price or the contents change.
		worth = "Worth 950+ R$  •  3x value",
		limit = 1,
		color = Color3.fromRGB(94, 214, 122),
		suggestedPrice = 300,
		order = 5,
		grant = {
			kind = "Bundle",
			duplicateCoins = 15000,
			contents = {
				{ kind = "Coins", amount = 25000 },
				{ kind = "Crate", crate = "Legendary", amount = 1 },
				{ kind = "Crate", crate = "Epic", amount = 1 },
				{ kind = "Crate", crate = "Rare", amount = 2 },
				-- One-match 1.5x max health (150), twice.
				{ kind = "Consumable", consumable = "Health", amount = 2 },
				{ kind = "Cosmetic", id = "StarterSpark" },
			},
		},
	},
	ProBundle = {
		id = 3714557634,
		name = "Pro Bundle",
		description = "The big one: a Super Crate, 2 Mythic Crates, 2 Legendary Crates, 50K coins, Pro boosts and two Pro exclusives.",
		featured = 2,
		badge = "BEST VALUE",
		-- At this shop's own Robux prices: 50K coins 399, Super 100, 2 Mythic 1,798, 2 Legendary 998 =
		-- 3,295 R$, before the Pro boosts and the two exclusives, which aren't sold alone. (It used to
		-- say 7,000+, which only held with the Mythic Crates counted at their coin price.)
		worth = "Worth 3,200+ R$  •  4x value",
		color = Color3.fromRGB(255, 184, 48),
		suggestedPrice = 800,
		order = 6,
		grant = {
			kind = "Bundle",
			duplicateCoins = 40000,
			contents = {
				-- Cut on 2026-09-18, with the crate repricing: at the rationalised prices the old contents
				-- (5 Super, 10 Mythic, 150k coins) came to roughly 30,000 R$ of crates for 800 R$, which
				-- isn't a bundle, it's an arbitrage — nobody would buy a crate directly again. This is
				-- about 4,200 R$ at the shop's Robux prices for 800 (see `worth`).
				{ kind = "Coins", amount = 50000 },
				{ kind = "Crate", crate = "Super", amount = 1 },
				{ kind = "Crate", crate = "Mythic", amount = 2 },
				{ kind = "Crate", crate = "Legendary", amount = 2 },
				-- Pro boosts: one-match 2x max health (200) and 1.5x speed, five of each.
				{ kind = "Consumable", consumable = "HealthPro", amount = 5 },
				{ kind = "Consumable", consumable = "SpeedPro", amount = 5 },
				{ kind = "Cosmetic", id = "ProPlating" },
				{ kind = "Cosmetic", id = "ProAura" },
			},
		},
	},
	BoostHealthOnce = {
		id = 3714557823,
		name = "One-Match Iron Sahur",
		description = "+50 max health for your next match only.",
		grant = { kind = "Consumable", consumable = "Health", amount = 1 },
		-- The Iron Sahur pass already gives this much every match, so an owner is never sold one
		-- (GamepassConfig.Outclassed); PlanBoosts would never spend it for them.
		outclassedBy = "ExtraHealth",
		suggestedPrice = 35,
		order = 1,
	},
	BoostSpeedOnce = {
		id = 3714557909,
		name = "One-Match Rot Runner",
		description = "+4 walkspeed for your next match only.",
		grant = { kind = "Consumable", consumable = "Speed", amount = 1 },
		outclassedBy = "ExtraSpeed",
		suggestedPrice = 35,
		order = 2,
	},
	CrateSuper = {
		id = 3714558011,
		name = "Super Crate",
		description = "The best crate in the game: a Mythic or Secret brainrot every time, plus a 60% chance of a 50K-250K coin jackpot.",
		grant = { kind = "Crate", crate = "Super" },
		featured = 3,
		badge = "ALWAYS IN STOCK",
		worth = "Mythic or Secret, guaranteed",
		color = Color3.fromRGB(255, 90, 200),
		-- 100 R$ (Oliver, 2026-09-22 22:22; was 999). Set the same on the Creator Dashboard.
		suggestedPrice = 100,
		order = 9,
