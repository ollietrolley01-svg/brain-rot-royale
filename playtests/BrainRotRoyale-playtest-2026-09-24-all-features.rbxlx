				key(0.5, V(0.02, 0.04, -0.06), V(-6, -8, 10)), key(0.58, V(0.02, 0.05, -0.1), V(-8, -14, 14)),
				key(0.7, V(0, 0.03, 0.03), V(4, 10, -6)), key(0.8, V(0, 0.02, 0), V(0, 0, 0)), key(1, V(), V()),
