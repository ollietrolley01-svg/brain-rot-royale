	end,
	draw = {
		duration = 0.45,
		gun = {
			key(0, V(), V()), key(0.2, V(0, 0.02, 0), V(0, 0, 4)), key(0.26, V(0, 0.02, 0), V(0, 0, -4)), key(0.32, V(0, 0.02, 0), V(0, 0, 4)),
			key(0.38, V(0, 0.02, 0), V(0, 0, -3)), key(1, V(), V()),
