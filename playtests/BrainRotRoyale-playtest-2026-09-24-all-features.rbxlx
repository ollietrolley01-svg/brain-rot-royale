		restPitch = 0,
		rarity = "Rare",
	},
}

-- Vehicle model -&gt; turret weapon. Must match VehicleModels.Mounts (the harness checks they agree).
VehicleWeaponData.ByModel = {
	Rotster = "RotsterRoofGun",
	CrocodiloRanger = "RangerRocketPod",
	SahurVan = "VanMortar",
	TartarugaScout = "TartarugaHMG",
	CameloCarrier = "CameloGrenadeLauncher",
}

-- Vehicle model -&gt; the driver's gun. Must match VehicleModels.DriverMounts.
VehicleWeaponData.DriverByModel = {
	Rotster = "RotsterNoseGun",
	CrocodiloRanger = "RangerBonnetGun",
	SahurVan = "VanBumperGun",
	TartarugaScout = "TartarugaBowGun",
	CameloCarrier = "CameloBonnetGun",
}

-- The two mounts, their parts on the model and what the server publishes on it for each.
VehicleWeaponData.Mounts = { "turret", "driver" }
VehicleWeaponData.Parts = {
	turret = { yaw = "TurretYaw", pitch = "TurretPitch", muzzle = "TurretMuzzle" },
	driver = { yaw = "DriverGunYaw", pitch = "DriverGunPitch", muzzle = "DriverGunMuzzle" },
}
VehicleWeaponData.Attributes = {
	turret = { ammo = "WeaponAmmo", firedAt = "WeaponFiredAt", yaw = "AimYaw", pitch = "AimPitch", hot = "WeaponHot" },
	driver = { ammo = "DriverGunAmmo", firedAt = "DriverGunFiredAt", yaw = "DriverAimYaw", pitch = "DriverAimPitch", hot = "DriverGunHot" },
}

function VehicleWeaponData.ForModel(modelId, mount)
	local byModel = mount == "driver" and VehicleWeaponData.DriverByModel or VehicleWeaponData.ByModel
	local key = type(modelId) == "string" and byModel[modelId] or nil
	return key and VehicleWeaponData.Weapons[key] or nil
end

-- The shots a mount holds at `now`, from what it held when it last fired (see VehicleWeapons).
-- Shared so the client's readout climbs back exactly as the server's count does.
function VehicleWeaponData.AmmoAt(spec, ammo, firedAt, now)
	local idle = now - (firedAt or -math.huge) - spec.rechargeDelay
	if idle &lt;= 0 then
		return ammo
	end
	return math.min(spec.magazine, ammo + idle * spec.recharge)
end

-- Whether a mount holding `ammo` (as AmmoAt counts it) with its overheat flag `hot` may fire, and the
-- flag afterwards. A belt run dry overheats a gun with `overheat`; it stays hot until it has cooled
-- back up to that share of its magazine.
function VehicleWeaponData.Ready(spec, ammo, hot)
	if ammo &lt; 1 then
		return false, spec.overheat ~= nil
	end
	if hot and spec.overheat and ammo &lt; spec.magazine * spec.overheat then
		return false, true
	end
	return true, false
end

-- The lowest the barrel may go at `yaw` (radians): pitchMin, or the front guard's floor inside its arc.
function VehicleWeaponData.PitchFloor(spec, yaw)
	local guard = spec.frontGuard
	if guard and math.abs(yaw) &lt; math.rad(guard.arc) then
		return math.rad(math.max(spec.pitchMin, guard.pitchMin))
	end
	local rear = spec.rearGuard
	if rear and math.abs(yaw) &gt; math.pi - math.rad(rear.arc) then
		return math.rad(math.max(spec.pitchMin, rear.pitchMin))
	end
	return math.rad(spec.pitchMin)
end

-- Yaw and pitch (radians) that point the mount along `direction`, held inside its arc.
-- `direction` is in the mount's own space (front -Z, up +Y). Yaw is positive to the left, pitch
-- positive up, which is what CFrame.Angles(0, yaw, 0) and CFrame.Angles(pitch, 0, 0) do to the
-- two pivots. The server fires along it and the client swings the turret by it.
function VehicleWeaponData.ClampAim(spec, direction)
	local flat = math.sqrt(direction.X * direction.X + direction.Z * direction.Z)
	local yaw = math.atan2(-direction.X, -direction.Z)
	local pitch = math.atan2(direction.Y, flat)
	local yawLimit = math.rad(spec.yawLimit)
	yaw = math.clamp(yaw, -yawLimit, yawLimit)
	pitch = math.clamp(pitch, VehicleWeaponData.PitchFloor(spec, yaw), math.rad(spec.pitchMax))
	return yaw, pitch
end

-- A mount-space vector turned by the pitch pivot (about X), then the yaw pivot (about Y): what the
-- two Motor6D Transforms do to a point of the barrel.
function VehicleWeaponData.Turn(v, yaw, pitch)
	local cp, sp, cy, sy = math.cos(pitch), math.sin(pitch), math.cos(yaw), math.sin(yaw)
	local y1 = v.Y * cp - v.Z * sp
	local z1 = v.Y * sp + v.Z * cp
	return Vector3.new(v.X * cy + z1 * sy, y1, -v.X * sy + z1 * cy)
end

-- THE AIM, solved exactly, for the server's shot and the client's turret and sight alike.
--   frame    the yaw pivot's frame at rest (world); the yaw axis is its Y through its position
--   pivot    the pitch pivot at rest, in that frame (on its YZ plane: x = 0)
--   muzzle   the muzzle at rest, relative to the pitch pivot, in that frame (x = 0)
--   aim      the world point the shot should pass through
-- Returns yaw, pitch (radians, clamped to the arc), and the world origin (the muzzle at those angles)
-- and unit direction of the shot; nil for an aim on top of the mount.
-- Because the pitch pivot and the muzzle sit on the yaw pivot's YZ plane, the barrel's vertical plane
-- always holds the yaw axis: the yaw is the aim's own bearing about that axis, however far out in
-- front the pitch pivot is (the Rotster's pintle stands 1.75 ahead of its ring). The pitch is then
-- found in that plane so the line out of the MUZZLE -- not the pivot -- runs through the aim point:
-- a close target is hit where it is aimed at rather than a barrel's length beside it.
function VehicleWeaponData.Solve(spec, frame, pivot, muzzle, aim)
	local q = frame:PointToObjectSpace(aim)
	local flat = math.sqrt(q.X * q.X + q.Z * q.Z)
	if flat &lt; 0.05 then
		return nil
	end
	local yaw = math.atan2(-q.X, -q.Z)
	-- The aim in the barrel's plane: straight ahead of the unturned mount, `flat` out.
	local toAim = Vector3.new(0, q.Y, -flat) - pivot
	if toAim.Magnitude &lt; 1 then
		return nil
	end
	local pitch = math.atan2(toAim.Y, -toAim.Z)
	for _ = 1, 3 do
		local mouth = VehicleWeaponData.Turn(muzzle, 0, pitch)
		local fromMouth = toAim - mouth
		if fromMouth.Magnitude &lt;= 1 then
			break
		end
		pitch = math.atan2(fromMouth.Y, -fromMouth.Z)
	end
	local yawLimit = math.rad(spec.yawLimit)
	yaw = math.clamp(yaw, -yawLimit, yawLimit)
	pitch = math.clamp(pitch, VehicleWeaponData.PitchFloor(spec, yaw), math.rad(spec.pitchMax))
	local origin = frame:PointToWorldSpace(VehicleWeaponData.Turn(pivot, yaw, 0) + VehicleWeaponData.Turn(muzzle, yaw, pitch))
	local direction = frame:VectorToWorldSpace(VehicleWeaponData.Turn(Vector3.new(0, 0, -1), yaw, pitch))
	return yaw, pitch, origin, direction
end

return VehicleWeaponData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX59"><Properties><string name="Name">VehicleWreckFx</string><ProtectedString name="Source">-- What a vehicle's lamps and smoke do once it's wrecked (#53/#57's visible half). ModuleScript, on
-- the same footing as GunFx.lua/ExplosiveFx.lua: split out of VehicleClient.client.lua (a
-- LocalScript, which a gallery cannot require and drive) specifically so this can be proven the way
-- those already are, rather than asserted.
--
--   VehicleWreckFx.LampShare(role, wrecked, driven, braking) -&gt; 0..1   pure, no Instances, unit-testable
--   VehicleWreckFx.LampBaseColor(part) -&gt; Color3                       the part's TRUE original colour
--   VehicleWreckFx.SetSmoke(model, wrecked) -&gt; ParticleEmitter or nil  creates once, toggles after
--
-- Reasons wrecked matters twice over: the driver's own HUD warning (VehicleClient's panel) is
-- rarely SEEN, because the same server frame that zeroes health also ejects them (VehicleService's
-- damageVehicle sets Sit = false), tearing the driving HUD down before the next Stepped tick. Dark
-- lamps and smoke are what actually reaches a bystander, or someone who walks up wondering why the
-- drive prompt vanished.

local VehicleWreckFx = {}

local DIM_PARKED = 0.34
local DIM_TAIL = 0.42
local SMOKE_TEXTURE = "rbxasset://textures/particles/smoke_main.dds" -- already proven in ExplosiveFx.lua/GunFx.lua

-- The brightness share a lamp of `role` ("tail" or anything else) should show, given whether the
-- vehicle is wrecked, driven and braking. Pure function: no Instances touched, so a probe can hand
-- it every combination directly rather than building a model to find out.
function VehicleWreckFx.LampShare(role, wrecked, driven, braking)
	if wrecked then
		return 0
	end
	if role == "tail" then
		return braking and 1 or DIM_TAIL
	end
	return driven and 1 or DIM_PARKED
end

-- The part's TRUE original colour, read from a persisted attribute rather than from `.Color`
-- itself (bug-hunt B3-2, the defense-in-depth half; strong-keying VehicleClient's `lamps` cache is
-- the other half). `.Color` is what LampShare's result gets multiplied into every frame, so reading
-- it back as "the base" a second time is exactly how a rebuilt cache used to compound the darkening
-- forever. Set once, on the first call for a given part, and never written again by anything in
-- this module -- callable any number of times (a rebuilt cache, a repeated probe call) and always
-- recovers the same value.
local BASE_COLOR_ATTRIBUTE = "LampBaseColor"
function VehicleWreckFx.LampBaseColor(part)
	local base = part:GetAttribute(BASE_COLOR_ATTRIBUTE)
	if typeof(base) ~= "Color3" then
		base = part.Color
		part:SetAttribute(BASE_COLOR_ATTRIBUTE, base)
	end
	return base
end

-- One ParticleEmitter per vehicle, made once (lazily, only once `wrecked` is first true) and just
-- enabled/disabled after -- attached to the Chassis, which every registered kind has, rather than
-- any per-model part, so it works without per-model authoring. Returns the emitter (or nil if there
-- is no Chassis, or none has been made yet and `wrecked` is false) so a caller/probe can inspect it.
--
-- STRONG keys (bug-hunt B3-3a, 2026-09-21): this is called every frame, for every vehicle within
-- ANIMATE_DISTANCE, by VehicleClient's updateLamps. A weak `smoke` table meant a dropped-and-
-- recreated entry made a SECOND Attachment+ParticleEmitter while the first stayed parented and
-- enabled (nothing ever destroys the old one) -- duplicate emitters, compounding smoke rate, and a
-- leaked Instance per drop. Dropped explicitly on AncestryChanged, same shape as `lamps` above.
local smoke = {}
function VehicleWreckFx.SetSmoke(model, wrecked)
	local emitter = smoke[model]
	if not emitter then
		if not wrecked then
			return nil
		end
		local chassis = model:FindFirstChild("Chassis")
		if not chassis then
			return nil
		end
		local attachment = Instance.new("Attachment")
		attachment.Name = "WreckSmoke"
		attachment.Position = Vector3.new(0, chassis.Size.Y / 2, -chassis.Size.Z * 0.2)
		attachment.Parent = chassis
		emitter = Instance.new("ParticleEmitter")
		emitter.Texture = SMOKE_TEXTURE
		emitter.Color = ColorSequence.new(Color3.fromRGB(40, 40, 42))
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.2) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
		emitter.Lifetime = NumberRange.new(1.4, 2.2)
		emitter.Rate = 12
		emitter.Speed = NumberRange.new(1.5, 2.5)
		emitter.SpreadAngle = Vector2.new(12, 12)
		emitter.Enabled = false
		emitter.Parent = attachment
		smoke[model] = emitter
		model.AncestryChanged:Connect(function()
			if not model:IsDescendantOf(workspace) then
				smoke[model] = nil
			end
		end)
	end
	emitter.Enabled = wrecked
	return emitter
end

return VehicleWreckFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX60"><Properties><string name="Name">VoteCursor</string><ProtectedString name="Source">-- The vote screen's two cursor decisions, in one place, pure and total.
--
-- WHY THIS MODULE EXISTS — Oliver's #100, "my mouse doesn't unlock anymore when vote menus pull up".
-- It was never a regression. It was unreachable by construction and then became reachable:
--
--   VoteDropClient computed  open = voteState.open and state == "Countdown" and NOT MenuOpen,
--   and VoteScreen drew itself when  open == true or decided ~= nil,  with `decided` also nilled on
--   MenuOpen. So BOTH branches that make the vote screen visible required MenuOpen to be FALSE.
--   MenuCursor.client.lua raises its modal and writes MouseBehavior.Default per frame ONLY while
--   MenuOpen is TRUE. The two sets therefore never intersected: while a vote was on screen, nothing
--   in the project could free the mouse. The screen's own predicate excluded the only state in which
--   anything unlocks the cursor.
--
-- That cost nothing while the lobby left the mouse free anyway. It started costing Oliver the moment
-- something else held the lock during a vote — a lobby trial gun (RangeState -&gt; rangeActive -&gt;
-- CombatClient sets CameraMode.LockFirstPerson, and Roblox's own camera then relocks the mouse EVERY
-- FRAME), and the mid-match winner reveal of #107. MAKING A FORM REACHABLE MAKES ITS BUGS REACHABLE.
--
-- PURE AND TOTAL: no services, no Instances, no upvalues. tools/prematch_ui_probe.lua runs a table
-- over it. VoteDropClient is a LocalScript and nothing in this harness can run one, so no decision
-- may be left inside it.
local VoteCursor = {}

-- The name this screen claims the cursor under. One constant, so the claim and the exclusion below
-- cannot drift apart — a claim filed under one spelling and excluded under another would read as
-- "somebody else is holding the cursor" forever, and the screen would hide itself permanently.
VoteCursor.ClaimName = "VoteScreen"

-- What is on screen, and what wants the mouse. TWO ANSWERS FROM ONE INPUT SET, because the trap is
-- precisely that they differ, and because VoteScreen and VoteDropClient must not each decide it.
--
-- `visible` is the old VoteScreen rule, unchanged: the interactive vote, or the winner reveal.
-- `wantsCursor` is the INTERACTIVE vote ONLY. The reveal must NOT claim the cursor:
--   * there is nothing to click — every card is built with `Active = enabled and not decided` and
--     `enabled` is false whenever a winner is decided, so the reveal cannot take input at all; and
--   * claiming raises the MenuOpen attribute, which CombatClient reads in inCombat() at five sites.
--     A reveal that claimed would switch combat off for its three seconds. Today the reveal lands in
--     the "Loading" state while the map builds, so that is currently harmless — but "currently
--     harmless" is how the bug above was born, and a cursor claim on a screen nobody can click is
--     wrong on its own terms.
--
-- `ready` is the third input (the player's-eye review; logic review #29). An UNREADY player's vote is
-- drawn -- greyed cards under "ready up to vote" -- but must NOT take the cursor. Taking it raised
-- MenuOpen, which made HudClient drop the Ready key, while the full-screen overlay sat over the READY
-- UP pill in BrrHud (DisplayOrder 0, under this screen's 30): the one screen telling the player to
-- ready up had disabled both ways of doing it, and a player who was not yet in the match could only
-- reach the pad. The drop picker already gates on readiness; the vote now agrees with it. `nil`
-- counts as ready, so a caller that does not say (a gallery, an older probe row) keeps the
-- interactive vote.
function VoteCursor.Screen(open, decided, ready)
	local visible = open == true or decided ~= nil
	local wantsCursor = open == true and ready ~= false
	return visible, wantsCursor
end

-- Does the vote screen stand aside because somebody ELSE has the cursor?
--
-- The vote panel is drawn above the shop, the inventory and the merge dialog (DisplayOrder 30), so a
-- vote sitting on top of a menu the player opened is worse than a vote they close the menu to see.
-- That is the rule this preserves. What it must NOT do is count the screen's OWN claim as somebody
-- else's — that is the circularity that made the set empty.
--
-- ANSWERED FROM THE HOLDER SET, NEVER FROM A COUNT. A count is a snapshot, and a count-based test
-- ("more than one claim outstanding") breaks in the direction that locks the mouse: claim twice, or
-- miss a release on one exit path, and it reads as "somebody else is holding" forever, with nothing
-- in the log and no probe able to see it. Excluding by NAME is idempotent — our own claim can be
-- outstanding once, twice or leaked, and the answer is the same.
--
-- `holders` is MenuOpenClaims.Holders(); `legacyHeld` is MenuOpenClaims.LegacyHolder(), covering the
-- writers that still set the attribute directly instead of claiming.
function VoteCursor.ShouldStandAside(holders, legacyHeld, myName)
	if type(holders) == "table" then
		for _, name in ipairs(holders) do
			if name ~= myName then
				return true
			end
		end
	end
	return legacyHeld == true
end

return VoteCursor
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX61"><Properties><string name="Name">VoteReveal</string><ProtectedString name="Source">-- One pure decision, kept out of VoteDropClient so it can be tested: a VoteChanged snapshot has
-- arrived — does the winner reveal start?
--
-- It exists because of Oliver's #107 ("sometimes game choosing menu pulls up randomly mid match").
-- VoteService caches its `resolved` pick until the NEXT Open() (VoteService.lua:190), and Snapshot()
-- emits `winner = (not open and resolved) and resolved.id` (VoteService.lua:137). So for the WHOLE of
-- a running match every snapshot carries a winner — it is a standing FIELD, not an announcement. And
-- Bootstrap.server.lua:282 re-broadcasts that snapshot to EVERY client whenever anybody joins.
--
-- The rule this replaces was `state.winner and not state.open`, inline in the remote handler. That is
-- a test on the CONTENT of a snapshot, not on a change, so every mid-match join replayed a
-- three-second winner reveal on every player's screen — over a running match, where the cursor is
-- locked to the middle of it, which is the other half of Oliver's #100.
--
-- THE CLASS OF BUG: A BROADCAST IS A STATE SNAPSHOT, NOT AN EVENT. The same rule Shared/CombatState
-- was written for after #82, in the same session, on a different remote.
--
-- PURE AND TOTAL. No upvalues, no services, no Instances: every answer is a function of the two
-- arguments, and every input shape has an answer, so tools/prematch_ui_probe.lua can run a table over
-- it. Anything left inline in VoteDropClient is logic no probe in this harness can ever reach — it is
-- a LocalScript, and nothing here can run one.
local VoteReveal = {}

-- `previous` is the last VoteChanged snapshot this client held (nil before the first one), `next` the
-- one just received. True only for the transition "the vote I was watching has just closed on a
-- winner".
--
--   open=true  -&gt; open=false, winner set    REVEAL. The countdown ran out; this is the announcement.
--   open=false -&gt; open=false, same winner   NO. The mid-match join re-broadcast — #107.
--   open=false -&gt; open=false, other winner  NO. Still not a close we watched; the next Open() clears
--                                           `winner` to nil, so a real second match always passes
--                                           through an open snapshot first.
--   anything   -&gt; open=true                 NO. The vote is still running.
--   anything   -&gt; winner=nil                NO. A cancelled countdown closes with no winner.
--   nil        -&gt; open=false, winner set    NO, AND THIS IS A DELIBERATE CHOICE, NOT AN OVERSIGHT.
--
-- ON THE nil PREVIOUS, because it is the case a reader will assume was written carelessly. A reveal
-- is a TRANSITION, and a client holding no previous snapshot has not observed one — it is seeing
-- history. The only way a client's first-ever snapshot can carry a winner is that it arrived after
-- the vote had already resolved: that client joined during the match (or during the map build). That
-- is the same population as #107, so "reveal on a nil previous" and "#107" cannot be separated — you
-- cannot have one without the other.
--
-- The costs are not symmetric either. A missed reveal costs one player who joined in the same second
-- the vote resolved a three-second informational panel about a match they are being dropped into
-- anyway, and the HUD names the mode. A spurious reveal puts a full-screen panel over live gameplay
-- with the mouse locked to the middle of it. So an unobservable transition answers "no".
function VoteReveal.ShouldReveal(previous, next)
	if type(next) ~= "table" then
		return false
	end
	-- Still open: whatever else is in the snapshot, nothing has been decided yet.
	if next.open == true then
		return false
	end
	-- A countdown cancelled by everyone unreadying closes with no Resolve and so no winner.
	if next.winner == nil then
		return false
	end
	if type(previous) ~= "table" then
		return false
	end
	-- The whole rule: we watched it open, and now it is closed on a winner. EXACTLY ONCE — the very
	-- next snapshot has `previous.open == false` and answers no, which is what makes the repeat safe.
	return previous.open == true
end

-- Which of the vote screen's two faces may be drawn, given the match state from MatchChanged, whether
-- the vote snapshot says it is open, and whether a reveal timer is running. Returns open, showReveal.
--
-- THE MATCH STATE HAS THE LAST WORD, and that is the second half of #107. ShouldReveal stops a
-- snapshot from STARTING a reveal it should not, but a reveal that started legitimately — the vote
-- closing at MatchService's `VoteService.Close()`, just after the state goes to Loading — used to run
-- its full three seconds whatever the match did meanwhile. A battle royale hides it behind the drop
-- picker; a respawn mode (TDM, King of the Hill) has no picker, so on a map that built in under three
-- seconds the winner panel sat over the first seconds of live play. Now it is drawn only while the
-- match is still Loading (or, for a remote that arrives a beat early, Countdown), and never over the
-- drop picker.
--
-- The interactive vote is drawn only in the lobby, whatever the snapshot says: the server's `open`
-- and the match state arrive on two different remotes, and requiring both means neither can put the
-- vote over a match on its own. The server opens it when the break after a match begins (findings C4),
-- so it is up through Intermission and Waiting as well as the countdown -- but outside the countdown
-- only for a player who is `ready`: the break is for crates, trading and the Cloud Climb, and a greyed
-- panel over the whole lobby for 35 s is in the way of all of it. The countdown shows it to everyone,
-- greyed for the unready (VoteCursor.Screen), as before.
local LOBBY_VOTE = { Intermission = true, Waiting = true }

function VoteReveal.View(match, voteOpen, revealing, ready)
	local state = type(match) == "table" and match.state or nil
	local open = voteOpen == true and (state == "Countdown" or (LOBBY_VOTE[state] == true and ready == true))
	local showReveal = revealing == true
		and (state == "Loading" or state == "Countdown")
		and not (type(match) == "table" and match.dropSelect == true)
	return open, showReveal
end

return VoteReveal
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX62"><Properties><string name="Name">WeaponData</string><ProtectedString name="Source">-- Guns, ordered by rarity. Higher rarity means better stats AND an ability, which is what
-- makes chest loot worth fighting over versus the floor loot you trip on at drop.
--
-- Abilities are resolved in ServerScriptService.Modules.CombatService:
--   pierce    - the shot keeps going through the first target it hits
--   explosive - splash damage around the impact point
--   lifesteal - heals the shooter for a fraction of damage dealt
--   chain     - damage arcs to one extra nearby enemy
--   goldRush  - eliminations with this weapon pay bonus SahurCoins
--
-- `style` picks the model silhouette WeaponService.BuildGunModel builds: pistol, revolver,
-- smg, rifle, dmr, shotgun, doublebarrel, crossbow, sniper, blaster, launcher, lmg, minigun,
-- cannon or railgun.
--
-- groundWeight &gt; 0 means it spawns loose on the map. Only Common and Uncommon do; the good
-- stuff is chest-only.
--
-- A hitscan shot does its full `damage` anywhere inside `range` and nothing at all beyond it: there is
-- no falloff with distance. So a shotgun's feel is `spread` and `range`, NOT its burst -- pellets go out
-- in a cone of `spread` degrees (ADS x0.34, a steady crouch tighter still), and against a two-stud torso
-- a hip-fired 9-degree gun puts about a third of its pellets on target at 10 studs and almost none at 30.
-- Don't buff a shotgun's paper damage to make it feel stronger; tighten the cone and lengthen the reach.
--
-- `projectile` makes the gun fire a real round instead of a hitscan shot: its kind in
-- Ballistics.Rounds ("rocket", "grenade", ...) says how it flies, and ProjectileService flies it.
-- `damage` and `splashRadius` are then the round's blast.
--
-- `explosiveAmmo = { damage, radius, wallDamage }` makes a hitscan gun's bullets go off where they stop
-- (#122): a small blast through ProjectileService's own, so it falls off to a fifth at the edge, is
-- stopped by cover, and holes walls within half its radius for `wallDamage`, once per wall. The victim
-- the bullet struck is inside it too, so keep `damage` well below the gun's own.

local WeaponData = {}

WeaponData.Weapons = {
	-- Common ------------------------------------------------------------------
	SahurPistol = {
		name = "Sahur Pistol",
		rarity = "Common",
		style = "pistol",
		description = "A carved ash-wood pistol off the pre-dawn drummer, a hand drum slung under its nose. Tok tok tok.",
		damage = 22,
		headshotMultiplier = 1.8,
		fireRate = 4,
		magSize = 15,
		reserveAmmo = 90,
		reloadTime = 1.3,
		range = 250,
		spread = 1.2,
		pellets = 1,
		groundWeight = 45,
		chestWeight = 14,
	},
	RotSMG = {
		name = "Rot SMG",
		rarity = "Common",
		style = "smg",
		description = "Left in the swamp too long: mould, bandages, a rusty can for a suppressor and mushrooms in the bones.",
		damage = 13,
		headshotMultiplier = 1.5,
		fireRate = 11,
		magSize = 28,
		reserveAmmo = 180,
		reloadTime = 1.9,
		range = 180,
		spread = 3.2,
		pellets = 1,
		groundWeight = 35,
		chestWeight = 14,
	},
	BubbleBlaster = {
		name = "Bubble Blaster",
		rarity = "Common",
		style = "blaster",
		damage = 16,
		headshotMultiplier = 1.5,
		fireRate = 6,
		magSize = 20,
		reserveAmmo = 140,
		reloadTime = 1.5,
		range = 170,
		spread = 2.2,
		pellets = 1,
		groundWeight = 30,
		chestWeight = 14,
	},
	CrumblyCarbine = {
		name = "Crumbly Carbine",
		rarity = "Common",
		style = "rifle",
		description = "A biscuit-tin carbine: a stack of cookies for a handguard and a bite out of the stock.",
		-- The first rifle most people find: reach the pistols don't have, at a slow, forgiving rate.
		damage = 18,
		headshotMultiplier = 1.7,
		fireRate = 5.5,
		magSize = 24,
		reserveAmmo = 144,
		reloadTime = 1.9,
		range = 300,
		spread = 2,
		pellets = 1,
		groundWeight = 30,
		chestWeight = 14,
	},
	PocketPopper = {
		name = "Pocket Popper",
		rarity = "Common",
		style = "pistol",
		description = "The cinema's pocket pistol: a butter-yellow slide on a striped carton, popcorn spilling out.",
		damage = 17,
		headshotMultiplier = 1.9,
		fireRate = 6,
		magSize = 12,
		reserveAmmo = 96,
		reloadTime = 1.1,
		range = 200,
		spread = 1.6,
		pellets = 1,
		groundWeight = 35,
		chestWeight = 14,
	},

	-- Uncommon ----------------------------------------------------------------
	CrocodiloRifle = {
		name = "Crocodilo Rifle",
		rarity = "Uncommon",
		style = "rifle",
		description = "An AK gone to the swamp and the skies: croc scutes, a jaw that snaps on the muzzle, a bomber's tail.",
		damage = 27,
		headshotMultiplier = 1.9,
		fireRate = 7,
		magSize = 30,
		reserveAmmo = 150,
		reloadTime = 2.1,
		range = 380,
		spread = 1.7,
		pellets = 1,
		groundWeight = 22,
		chestWeight = 18,
	},
	TralalaShotgun = {
		name = "Tralala Shotgun",
		rarity = "Uncommon",
		style = "shotgun",
		description = "A shark from the grip forward, with a blue high-top sneaker for a pump.",
		damage = 13,
		headshotMultiplier = 1.4,
		fireRate = 1.1,
		magSize = 6,
		reserveAmmo = 48,
		reloadTime = 2.6,
		range = 110,
		spread = 7,
		pellets = 8,
		groundWeight = 18,
		chestWeight = 16,
	},
	SigmaRevolver = {
		name = "Sigma Revolver",
		rarity = "Uncommon",
		style = "revolver",
		-- Slow and heavy: two body shots and a tap, or one headshot and a tap.
		damage = 46,
		headshotMultiplier = 2,
		fireRate = 2.2,
		magSize = 6,
		reserveAmmo = 42,
		reloadTime = 2.2,
		range = 320,
		spread = 0.7,
		pellets = 1,
		groundWeight = 14,
		chestWeight = 12,
	},
	LagSwitchSMG = {
		name = "Lag Switch SMG",
		rarity = "Uncommon",
		style = "smg",
		description = "A home router with a trigger: rabbit-ear antennas, blinking lights and a spool of cable for a drum.",
		damage = 16,
