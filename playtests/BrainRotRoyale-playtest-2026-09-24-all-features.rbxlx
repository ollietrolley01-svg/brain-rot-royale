Viewmodel.Flair = FLAIR

-- The flair's inspect clip for this gun, or nil (the stock inspect plays).
local function flairInspect(self)
	local flair = self.flair and FLAIR[self.flair]
	return flair and flair.inspect and flair.inspect(self) or nil
end

-- A fresh copy of a flair's clip table: a playing clip is stamped with its start and the events it fired.
local function copyClip(clip)
	local out = {}
	for name, value in pairs(clip) do
		out[name] = type(value) == "table" and table.clone(value) or value
	end
	return out
end

local function flairDraw(self)
	local flair = self.flair and FLAIR[self.flair]
	return flair and flair.draw and copyClip(flair.draw) or nil
end

-- The reload clip with this gun's flourish laid over its last stretch.
local function flairReload(self, clip)
	local flair = self.flair and FLAIR[self.flair]
	local flourish = flair and flair.reload
	if not clip or not flourish then
		return clip
	end
	local gun = clip.gun or { key(0, V(), V()), key(1, V(), V()) }
	for _, entry in ipairs(gun) do
		if entry[1] &gt; FLAIR_RELOAD_FROM and entry[1] &lt; 1 then
			-- The mechanism is still moving the gun here (an empty reload's charging handle): no flourish.
			return clip
		end
	end
	local merged = {}
	for _, entry in ipairs(gun) do
		table.insert(merged, entry)
	end
	for _, entry in ipairs(flourish.gun or {}) do
		table.insert(merged, entry)
	end
	table.sort(merged, function(a, b)
		return a[1] &lt; b[1]
	end)
	clip.gun = merged
	if flourish.events then
		clip.events = clip.events or {}
		for _, entry in ipairs(flourish.events) do
			table.insert(clip.events, entry)
		end
	end
	return clip
end

local baseReloadClip = reloadClip
reloadClip = function(self, empty, missing)
	return flairReload(self, baseReloadClip(self, empty, missing))
end

-- Plays a clip over `duration` seconds from now, replacing any clip of the same kind.
function Viewmodel:play(kind, clip, duration)
	if not clip then
		self.clips[kind] = nil
		return
	end
	clip.kind = kind
	clip.start = self.now
	clip.duration = math.max(duration or clip.duration or 0.3, 0.05)
	clip.fired = {}
	self.clips[kind] = clip
end

local function sample(track, t)
	if not track or #track == 0 then
		return nil
	end
	if t &lt;= track[1][1] then
		return track[1], track[1], 0
	end
	for index = 2, #track do
		local b = track[index]
		if t &lt;= b[1] then
			local a = track[index - 1]
			local span = b[1] - a[1]
			return a, b, span &gt; 0 and smooth((t - a[1]) / span) or 1
		end
	end
	local last = track[#track]
	return last, last, 0
end

local function sampleValue(track, t)
	local a, b, s = sample(track, t)
	if not a then
		return nil
	end
	return a[2] + (b[2] - a[2]) * s
end

--------------------------------------------------------------------------------
-- Commands
--------------------------------------------------------------------------------

function Viewmodel:Equip(rack)
	self.equipAt = self.now
	self.clips = {}
	self.slideLocked = false
	if rack then
		local clip = rackClip(self)
		if clip then
			clip.delay = 0.3
			self.pendingRack = clip
		end
	end
	-- A flair gun's draw flourish, once it is up (and after the rack, when there is one).
	local draw = flairDraw(self)
	if draw then
		draw.delay = self.pendingRack and 0.9 or 0.3
		self.pendingFlair = draw
	else
		self.pendingFlair = nil
	end
	emit(self, "sound", "Equip")
end

function Viewmodel:Fire(roundsLeft)
	local kick = self.kick
	-- Aimed, the gun still drives back but turns much less: the sight picture holds, and the camera's own
	-- recoil carries the climb.
	local pushScale = 1 - self.aim * 0.45
	local turnScale = 1 - self.aim * 0.7
	self.kickVel += V((math.random() - 0.5) * 0.01, 0.004, kick[1] * 10) * pushScale
	self.kickRotVel += V(kick[2] * 14, (math.random() - 0.5) * kick[3] * 10, (math.random() - 0.5) * kick[3] * 18) * turnScale
	self.shotAt = self.now
	self.clips.inspect = nil
	self.pendingRack = nil
	self.pendingFlair = nil
	self.clips.rack = nil
	if self.action == "rotary" then
		self.spinSpeed = math.max(self.spinSpeed, 26)
	end
	if self.action == "crossbow" then
		self.cocked = false
	end
	if (self.action == "rocket" or self.action == "crossbow") and roundsLeft &lt;= 0 then
		self.roundShown = false
	end
	local clip = fireClip(self, roundsLeft)
	if clip then
		self:play("fire", clip)
		if self.action == "pistol" and roundsLeft &lt;= 0 then
			self.slideLocked = true
		end
	end
	-- Guns that throw their empties on the shot itself; pump, bolt and lever guns throw them as they're
	-- worked, and a double barrel keeps its shells until it's broken open.
	local throwsOnShot = self.action ~= "pump" and self.action ~= "bolt" and self.action ~= "lever" and self.action ~= "break"
	if throwsOnShot and not (clip and clip.events) then
		self:eject()
	end
	return self:muzzleCFrame()
end

function Viewmodel:StartReload(seconds, roundsLeft, magSize)
	self.clips.inspect = nil
	self.pendingRack = nil
	self.pendingFlair = nil
	self.clips.rack = nil
	local empty = roundsLeft &lt;= 0
	local clip = reloadClip(self, empty, (magSize or 1) - roundsLeft)
	self:play("reload", clip, seconds)
	self.reloadEmpty = empty
end

function Viewmodel:StopReload()
	local clip = self.clips.reload
	if clip then
		self.clips.reload = nil
		self.slideLocked = false
		self.cocked = true
		self.roundShown = true
		self:clearProps()
	end
end

function Viewmodel:Inspect()
	if self.clips.reload then
		return
	end
	self.pendingFlair = nil
	local flair = flairInspect(self)
	if flair then
		self:play("inspect", flair, flair.duration)
		return
	end
	self:play("inspect", {
		gun = {
			key(0, V(), V()), key(0.18, V(-0.25, 0.18, 0.1), V(10, 55, -25)), key(0.45, V(-0.25, 0.18, 0.1), V(10, 65, -30)),
			key(0.6, V(-0.2, 0.14, 0.05), V(-6, -40, 35)), key(0.85, V(-0.2, 0.14, 0.05), V(-6, -48, 38)), key(1, V(), V()),
		},
	}, 2.6)
end

function Viewmodel:SetHidden(hidden)
	if self.hidden == hidden then
		return
	end
	self.hidden = hidden
	-- Everything: the gun, both arms and whatever the hand is holding. Behind a full-screen scope not a
	-- knuckle may show.
	for _, part in ipairs(self.parts) do
		veil(part, hidden)
	end
	self.arms:SetHidden(hidden)
	for _, prop in pairs(self.props) do
		for _, part in ipairs(prop.parts) do
			part.LocalTransparencyModifier = hidden and 1 or 0
		end
	end
	self.visibilityDirty = true
end

--------------------------------------------------------------------------------
-- Props: what the left hand brings from the pocket
--------------------------------------------------------------------------------

local PROP_FINISH = GunModels.Finishes

local function buildProp(kind)
	local model = Instance.new("Model")
	model.Name = "BRR_Prop"
	local function piece(shape, size, cframe, look)
		local part = Instance.new("Part")
		part.Shape = shape or Enum.PartType.Block
		part.Size = size
		part.CFrame = cframe
		part.Color = look.color
		part.Material = look.material
		part.Reflectance = look.reflectance
		localOnly(part)
		part.Parent = model
		return part
	end
	local mm = GunModels.StudsPerMillimetre
	local along = CFrame.Angles(0, math.pi / 2, 0)
	if kind == "shell" or kind == "shellBig" or kind == "shells" then
		local count = kind == "shells" and 2 or 1
		local big = kind == "shellBig" and 1.25 or 1
		for index = 1, count do
			local x = (index - (count + 1) / 2) * 22 * mm
			piece(Enum.PartType.Cylinder, V(60 * mm * big, 20 * mm * big, 20 * mm * big), CF(x, 0, -30 * mm) * along, kind == "shellBig" and PROP_FINISH.brass or PROP_FINISH.shell)
			piece(Enum.PartType.Cylinder, V(12 * mm * big, 21.4 * mm * big, 21.4 * mm * big), CF(x, 0, 6 * mm) * along, PROP_FINISH.brass)
		end
	elseif kind == "speedloader" then
		piece(Enum.PartType.Cylinder, V(14 * mm, 30 * mm, 30 * mm), CF(0, 0, 10 * mm) * along, PROP_FINISH.nitride)
		for index = 0, 5 do
			local angle = index / 6 * math.pi * 2
			piece(Enum.PartType.Cylinder, V(38 * mm, 9.6 * mm, 9.6 * mm), CF(math.cos(angle) * 13.5 * mm, math.sin(angle) * 13.5 * mm, -12 * mm) * along, PROP_FINISH.brass)
		end
	elseif kind == "grenade" then
		piece(Enum.PartType.Cylinder, V(50 * mm, 42 * mm, 42 * mm), CF(0, 0, 10 * mm) * along, PROP_FINISH.brass)
		piece(Enum.PartType.Ball, V(40 * mm, 40 * mm, 40 * mm), CF(0, 0, -20 * mm), PROP_FINISH.warhead)
	end
	return model
end

function Viewmodel:prop(kind)
	local prop = self.props[kind]
	if not prop then
		local model = buildProp(kind)
		local parts, offsets = {}, {}
		local pivot = model:GetPivot()
		for _, part in ipairs(model:GetChildren()) do
			table.insert(parts, part)
			offsets[part] = pivot:ToObjectSpace(part.CFrame)
		end
		prop = { model = model, parts = parts, offsets = offsets, shown = false }
		self.props[kind] = prop
	end
	return prop
end

function Viewmodel:clearProps()
	for _, prop in pairs(self.props) do
		prop.model.Parent = nil
		prop.shown = false
	end
end

--------------------------------------------------------------------------------
-- Per frame
--------------------------------------------------------------------------------

-- A group's transform in gun space at `value`.
function Viewmodel:groupTransform(group, value)
	local travel = self.travel[group]
	local pivot = self.pivots[group]
	local swing = self.swing[group]
	if group == "bolt" and pivot and swing then
		-- Turn the bolt up, then draw it back.
		local turn = math.clamp(value, 0, 1)
		local back = math.clamp(value - 1, 0, 1)
		return CF(0, 0, (travel or 0) * back) * pivot * CFrame.Angles(rad(swing) * turn, 0, 0) * pivot:Inverse()
	elseif pivot and swing then
		return pivot * CFrame.Angles(rad(swing) * value, 0, 0) * pivot:Inverse()
	elseif travel then
		return CF(0, 0, travel * value)
	end
	return CFrame.identity
end

function Viewmodel:muzzleCFrame()
	local muzzle = self.keys.Muzzle
	return self.frame and muzzle and self.frame * muzzle or nil
end

function Viewmodel:eject()
	local eject = self.keys.Eject
	if self.casing ~= "none" and eject and self.frame then
		emit(self, "casing", self.frame * eject, self.casing)
	end
end

-- Resolves a hand anchor to a CFrame in gun space: a keypoint (riding its moving group), the pocket
-- (low beside you, in view space), or the grip.
function Viewmodel:anchor(name, transforms, view, frame)
	if name == "Pocket" then
		return frame:ToObjectSpace(view * CF(-0.62, -1.45, -0.55) * A(-35, 25, 10))
	end
	local keyFrame = self.keys[name] or self.keys.SupportHand or self.keys.GripHand
	local group = self.keyGroups[name]
	local transform = group and transforms[group]
	if transform then
		keyFrame = transform * keyFrame
	end
	return keyFrame
end

-- Returns the hand's frame, how far it closes, and how its fingers close on this gun: where the knuckle
-- plane is, how far the fingertips turn in under what they hold, and how far the gun lets them close at
-- all. All nil where the hand is on nothing, and the hand then simply closes on itself.
local function handTrack(self, track, t, transforms, view, frame, default)
	local function held(name)
		local shape = self.gripShapes and self.gripShapes[name]
		return shape and shape.fingers or nil
	end
	if not track then
		return self:anchor(default, transforms, view, frame), CURL[default] or 0.8, held(default)
	end
	local a, b, s = sample(track, t)
	local function resolve(entry)
		local cframe = self:anchor(entry[2], transforms, view, frame)
		if entry[3] then
			cframe = cframe + entry[3]
		end
		return cframe, CURL[entry[2]] or 0.7, held(entry[2])
	end
	local ca, curlA, heldA = resolve(a)
	local cb, curlB, heldB = resolve(b)
	-- What each finger may do belongs to one anchor or the other: it is the gun's shape where the hand
	-- is, not a blend of two shapes. So the nearer anchor's is used whole and the hand's own `curl`,
	-- which does blend, carries the movement between them.
	local shape = heldA
	if s &gt;= 0.5 then
		shape = heldB or heldA
	else
		shape = heldA or heldB
	end
	return ca:Lerp(cb, s), curlA + (curlB - curlA) * s, shape
end

-- input: camera (CFrame), aiming, sprinting, speed, grounded, velocity (Vector3, local to the root),
-- mouseDelta (Vector2), sway (bool), landDip, slideDip, reloading (bool)
function Viewmodel:Update(dt, input)
	dt = math.min(dt, 0.1)
	self.now += dt
	local now = self.now
	if now &gt;= (self.nightCheckAt or 0) then
		self.nightCheckAt = now + 0.5
		self:updateNightSights()
	end
	-- The arms follow the avatar as it is now (#44). A character spawns as a plain grey rig and its
	-- appearance -- colours, body package, shirt -- arrives a moment later, and the gun you spawn holding
	-- is drawn in between: its arms were copied from the grey rig and stayed grey and bare until the next
	-- weapon swap. Once a second the avatar's arms are compared with what was copied, and copied again if
	-- they have changed.
	if self.character and now &gt;= self.lookCheckAt then
		self.lookCheckAt = now + LOOK_CHECK
		local lookOk, look = pcall(Arms.LookOf, self.character)
		if lookOk and look ~= self.armsLook then
			self.armsLook = look
			-- Built first and swapped in only once built: a copy that fails leaves the arms there are.
			local builtOk, arms = pcall(Arms.new, self.model, self.character)
			if builtOk then
				self.arms.model:Destroy()
				self.arms = arms
				if self.hidden then
					self.arms:SetHidden(true)
				end
			end
		end
	end
	local view = input.camera

	-- Blends.
	-- Aim blends out while the hands work the gun (a reload, a rack on the draw, breaking a double open):
	-- the pull or the break goes on below the eye, not across the sight picture.
	local wantAim = input.aiming and not self.clips.reload and not self.clips.rack and 1 or 0
	self.aim += (wantAim - self.aim) * math.clamp(dt * 13, 0, 1)
	local wantSprint = (input.sprinting and (input.speed or 0) &gt; 4 and not input.aiming) and 1 or 0
	self.sprint += (wantSprint - self.sprint) * math.clamp(dt * 9, 0, 1)
	local aim = smooth(self.aim)

	-- The draw, and the rack that follows the first one.
	local raised = math.clamp((now - self.equipAt) / 0.35, 0, 1)
	local down = (1 - raised) ^ 3
	if self.pendingRack and now - self.equipAt &gt;= self.pendingRack.delay then
		self:play("rack", self.pendingRack, 0.55)
		self.pendingRack = nil
	end
	if self.pendingFlair and now - self.equipAt &gt;= self.pendingFlair.delay and not self.clips.reload then
		self:play("inspect", self.pendingFlair)
		self.pendingFlair = nil
	end

	-- Clips: sample every track of every playing clip. Later kinds win where they overlap.
	local values = {}
	local gunOffset = CFrame.identity
	local leftTrack, rightTrack, leftT, rightT = nil, nil, 0, 0
	local propKind
	for _, kind in ipairs({ "fire", "rack", "inspect", "reload" }) do
		local clip = self.clips[kind]
		if clip then
			local t = math.clamp((now - clip.start) / clip.duration, 0, 1)
			if clip.values then
				for name, track in pairs(clip.values) do
					values[name] = sampleValue(track, t)
				end
			end
			if clip.gun then
				local a, b, s = sample(clip.gun, t)
				local position = a[2]:Lerp(b[2], s)
				local rotation = a[3]:Lerp(b[3], s)
				-- Working the action between aimed shots (a pump, a lever, a bolt) keeps the gun on target:
				-- fully aimed, the gun moves a sixth as far, about the eye, so the sights stay in line and the
				-- crosshair stays on the sight picture instead of the receiver.
				if kind == "fire" or kind == "rack" then
					local keep = 1 - 0.85 * aim
					position *= keep
					rotation *= keep
				end
				gunOffset = gunOffset * CF(position) * A(rotation.X, rotation.Y, rotation.Z)
			end
			if clip.left then
				leftTrack, leftT = clip.left, t
			end
			if clip.right then
				rightTrack, rightT = clip.right, t
			end
			if clip.prop then
				propKind = clip.prop
			end
			for index, event in ipairs(clip.events or {}) do
				if t &gt;= event[1] and not clip.fired[index] then
					clip.fired[index] = true
					self:handleEvent(event)
				end
			end
			if t &gt;= 1 then
				self.clips[kind] = nil
				if kind == "reload" then
					self.slideLocked = false
					self.cocked = true
					self.roundShown = true
					self:clearProps()
				end
			end
		end
	end

	-- Persistent mechanism state.
	if self.slideLocked and values.slide == nil then
		values.slide = 1
	end
	self.drumAngle += (self.drumTarget - self.drumAngle) * math.clamp(dt * 18, 0, 1)
	self.spinSpeed = math.max(0, self.spinSpeed - dt * (self.spinSpeed &gt; 10 and 22 or 8))
	self.spin += self.spinSpeed * dt

	-- Springs: the kick settles back, stiffer and better damped while aimed. Stepped no coarser than 1/60 s:
	-- in one step, a 10 fps frame made the spring unstable, each frame throwing the gun further.
	local stiffness, damping = 180 + 120 * aim, 16 + 8 * aim
	local springSteps = math.max(1, math.ceil(dt * 60 - 1e-6))
	local springDt = dt / springSteps
	for _ = 1, springSteps do
		self.kickVel += (-self.kickPos * stiffness - self.kickVel * damping) * springDt
		self.kickPos += self.kickVel * springDt
		self.kickRotVel += (-self.kickRot * stiffness - self.kickRotVel * damping) * springDt
		self.kickRot += self.kickRotVel * springDt
	end

	-- Sway, bob, breathing, strafe roll, the jump and the landing. Aiming steadies all of it; the stride
	-- bob, breathing and the landing and slide dips (which move the sight picture itself) almost entirely.
	local steady = 1 - aim * 0.85
	local still = 1 - aim * 0.95
	local bobOffset = CFrame.identity
	if input.sway ~= false then
		local speed = input.speed or 0
		if input.grounded and speed &gt; 1 then
			self.bob += dt * speed * (0.55 + self.sprint * 0.25)
		end
		local amplitude = (input.grounded and math.min(speed / 16, 1.5) or 0) * still
		local breathe = math.sin(now * 1.6) * 0.01 * still
		bobOffset = CF(math.sin(self.bob) * 0.045 * amplitude, -math.abs(math.cos(self.bob)) * 0.06 * amplitude + breathe, 0)
			* A(0, 0, math.deg(math.sin(self.bob) * 0.025 * amplitude))
		local mouse = input.mouseDelta or Vector2.zero
		local blend = math.clamp(dt * 10, 0, 1)
		self.swayX += (math.clamp(-mouse.X * 0.0032, -0.12, 0.12) - self.swayX) * blend
		self.swayY += (math.clamp(-mouse.Y * 0.0032, -0.09, 0.09) - self.swayY) * blend
	else
		self.swayX, self.swayY = 0, 0
	end
	local localVelocity = input.velocity or Vector3.zero
	local moveBlend = math.clamp(dt * 6, 0, 1)
	self.roll += (math.clamp(-localVelocity.X * 0.004, -0.08, 0.08) - self.roll) * moveBlend
	self.airPitch += (math.clamp((localVelocity.Y or 0) * 0.0025, -0.1, 0.1) - self.airPitch) * moveBlend
	local swayOffset = CFrame.Angles((self.swayY + self.airPitch) * steady, self.swayX * steady, (self.swayX * 0.7 + self.roll) * steady)

	-- The frame: hip and aim poses, blended, with every motion layered around the grip at the hip. At full
	-- aim the draw, sprint, bob and sway turn about the front sight, which holds on the target while the
	-- gun wobbles; the kick and the working of the action turn about the eye, so the front and rear sights
	-- stay in line while the whole picture tips and settles.
	local hold = self.hold
	local grip = self.gripPoint
	local hip = view * CF(self.hipPosition) * A(hold.pitch, hold.yaw, 0) * CF(-grip)
	local sight = self.keys.Sight or CF(0, 0.2, 0.2)
	local ads = view * CF(0, 0, -self.eyeRelief) * sight:Inverse()
	local base = hip:Lerp(ads, aim)

	local sprintPose = hold.sprint
	local sprintOffset = CF(sprintPose[1] * self.sprint) * A(sprintPose[2].X * self.sprint, sprintPose[2].Y * self.sprint, sprintPose[2].Z * self.sprint)
	local equipOffset = CF(0, -1.0 * down, 0.35 * down) * A(-60 * down + math.sin(raised * math.pi) * 3, 0, 25 * down)
	local landDip, slideDip = (input.landDip or 0) * still, (input.slideDip or 0) * still
	local kickOffset = CF(self.kickPos.X, self.kickPos.Y - landDip - slideDip * 0.6, self.kickPos.Z)
		* A(self.kickRot.X + slideDip * 6, self.kickRot.Y, self.kickRot.Z + slideDip * 5)
	local motionPivot = grip:Lerp(self.aimPivot, aim)
	local actionPivot = grip:Lerp(self.eyePoint, aim)
	-- At the hip the two pivots are one point, toAction is the identity, and this is the one motion
	-- equip * sprint * gun * bob * sway * kick about the grip it always was.
	local toAction = CF(-motionPivot) * CF(actionPivot)
	local frame = base * CF(motionPivot) * equipOffset * sprintOffset * toAction * gunOffset * toAction:Inverse()
		* bobOffset * swayOffset * toAction * kickOffset * CF(-actionPivot)
	self.frame = frame

	-- Group transforms.
	local transforms = {}
	local function transformOf(group)
		if transforms[group] then
			return transforms[group]
		end
		local own
		if group == "drum" then
			local pivot = self.pivots.drum
			local turn = self.drumAngle + (values.drum or 0) * math.pi * 2
			own = pivot and pivot * CFrame.Angles(turn, 0, 0) * pivot:Inverse() or CFrame.identity
		elseif group == "spin" then
			local pivot = self.pivots.spin
			own = pivot and pivot * CFrame.Angles(self.spin, 0, 0) * pivot:Inverse() or CFrame.identity
		elseif group == "mag" or group == "round" or group == "rounds" or group == "string" or group == "stringRest" then
			own = CFrame.identity
		else
			own = self:groupTransform(group, values[group] or 0)
		end
		local parent = self.parents[group]
		if parent then
			own = transformOf(parent) * own
		end
		transforms[group] = own
		return own
	end
	for group in pairs(self.groupParts) do
		transformOf(group)
	end
	for group in pairs(self.pivots) do
		transformOf(group)
	end
	for group in pairs(self.travel) do
		transformOf(group)
	end

	-- Hands.
	local leftLocal, leftCurl, leftHeld = handTrack(self, leftTrack, leftT, transforms, view, frame, "SupportHand")
	local rightLocal, rightCurl, rightHeld = handTrack(self, rightTrack, rightT, transforms, view, frame, "GripHand")
	if not self.keys.SupportHand then
		leftLocal = self:anchor("Pocket", transforms, view, frame)
	end
	self.hands.left = self.hands.left and self.hands.left:Lerp(leftLocal, math.clamp(dt * 22, 0, 1)) or leftLocal
	self.hands.right = self.hands.right and self.hands.right:Lerp(rightLocal, math.clamp(dt * 22, 0, 1)) or rightLocal
	local leftWorld = frame * self.hands.left
	local rightWorld = frame * self.hands.right

	-- Held things follow the left hand: the magazine (from its seat under MagHand), the round (from its
	-- place at Load), and a pocket prop.
	local magHold = values.magHold or 0
	if magHold &gt; 0 and self.keys.MagHand then
		local attached = frame:ToObjectSpace(leftWorld * self.keys.MagHand:Inverse())
		transforms.mag = CFrame.identity:Lerp(attached, magHold)
	end
	local magSlide = values.magSlide or 0
	if magSlide &gt; 0 then
		local well = self.keys.MagWell or CFrame.identity
		local direction = well:VectorToWorldSpace(V(0, -1, 0))
		transforms.mag = (transforms.mag or CFrame.identity) + direction * magSlide
	end
	local roundHold = values.roundHold or 0
	if roundHold &gt; 0 and self.keys.Load then
		local attached = frame:ToObjectSpace(leftWorld * self.keys.Load:Inverse())
		transforms.round = CFrame.identity:Lerp(attached, roundHold)
	end

	-- Visibility.
	local magVisible = (values.magVisible or 1) &gt; 0.5
	local roundVisible
	if values.roundVisible ~= nil then
		roundVisible = values.roundVisible &gt; 0.5
	else
		roundVisible = self.roundShown
	end
	local roundsVisible = (values.roundsVisible or 1) &gt; 0.5
	local cocked = values.cocked ~= nil and values.cocked &gt; 0.5 or (values.cocked == nil and self.cocked)
	if values.cocked ~= nil and values.cocked &gt; 0.5 then
		self.cocked = true
	end
	local visibility = { mag = magVisible, round = roundVisible, rounds = roundsVisible, string = cocked, stringRest = not cocked }
	local visibilityKey = string.format("%s%s%s%s%s", tostring(magVisible), tostring(roundVisible), tostring(roundsVisible), tostring(cocked), tostring(self.hidden))
	if visibilityKey ~= self.visibilityKey or self.visibilityDirty then
		self.visibilityKey = visibilityKey
		self.visibilityDirty = false
		for group, shown in pairs(visibility) do
			for _, part in ipairs(self.groupParts[group] or {}) do
				veil(part, self.hidden or not shown)
			end
		end
	end

	-- Energy glow.
	if values.glow and self.groupParts.glow == nil then
		self.glowLevel = values.glow
	end

	-- Move everything.
	local parts = table.create(#self.parts + 16)
	local cframes = table.create(#self.parts + 16)
	for _, part in ipairs(self.model:GetChildren()) do
		local offset = self.offsets[part]
		if offset then
			local group = self.groupOf[part]
			local transform = group and transforms[group]
			parts[#parts + 1] = part
			cframes[#cframes + 1] = transform and frame * transform * offset or frame * offset
		end
	end
	self.arms:pose(1, view, rightWorld, rightCurl, parts, cframes, rightHeld)
	self.arms:pose(-1, view, leftWorld, leftCurl, parts, cframes, leftHeld)

	-- The prop in the left hand.
	local propHold = values.propHold or 0
	for kind, prop in pairs(self.props) do
		if kind ~= propKind or propHold &lt; 0.5 then
			if prop.shown then
				prop.model.Parent = nil
				prop.shown = false
			end
		end
	end
	if propKind and propHold &gt;= 0.5 then
		local prop = self:prop(propKind)
		if not prop.shown then
			prop.model.Parent = self.model
			prop.shown = true
		end
		local held = leftWorld * CF(0, -0.07, -0.2)
		for _, part in ipairs(prop.parts) do
			parts[#parts + 1] = part
			cframes[#cframes + 1] = held * prop.offsets[part]
		end
	end

	workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)

	local scopedIn = self.scoped and self.aim &gt; 0.92 and not self.clips.reload and not self.clips.rack
	return {
		frame = frame,
		muzzle = self:muzzleCFrame(),
		scopedIn = scopedIn,
		aim = self.aim,
		laser = self.laserEmitter and self.laserEmitter.CFrame or nil,
		reloading = self.clips.reload ~= nil,
	}
end

function Viewmodel:handleEvent(event)
	local kind = event[2]
	if kind == "sound" then
		emit(self, "sound", event[3])
	elseif kind == "eject" then
		self:eject()
	elseif kind == "spin" then
		-- A flair spinning a rotary's barrels up.
		self.spinSpeed = math.max(self.spinSpeed, event[3] or 26)
	elseif kind == "drop" then
		-- A copy of the magazine where it is right now, handed off to fall away.
		local group = event[3]
		local copy = Instance.new("Model")
		copy.Name = "BRR_Dropped"
		for _, part in ipairs(self.groupParts[group] or {}) do
			local clone = part:Clone()
			veil(clone, false)
			clone:SetAttribute("Anim", nil)
			clone.Parent = copy
		end
		if #copy:GetChildren() &gt; 0 then
			emit(self, "drop", copy, self.frame and self.frame.UpVector or Vector3.yAxis)
		else
			copy:Destroy()
		end
	elseif kind == "casings" then
		-- Out of the ejector where a gun has one (a break gun throws its empties up and back as the barrels
		-- drop); otherwise from where the hand loads, which is where a revolver's cases fall.
		local load = self.keys.Eject or self.keys.Load
		if load and self.frame then
			for _ = 1, event[3] or 1 do
				emit(self, "casing", self.frame * load * CF((math.random() - 0.5) * 0.05, (math.random() - 0.5) * 0.05, 0), self.action == "break" and "shell" or "pistol", true)
			end
		end
	end
end

-- For the gallery: freeze a viewmodel at a moment. `state` sets aim/sprint directly and can start a
-- clip `progress` of the way through.
function Viewmodel:Pose(camera, state)
	-- As in play: aim has blended out by the time a reload or a rack is under way.
	self.aim = (state.clip == "reload" or state.clip == "rack") and 0 or state.aim or 0
	self.sprint = state.sprint or 0
	self.equipAt = -math.huge
	self.clips = {}
	self.hands = {}
	if state.clip == "reload" then
		self:StartReload(1, state.roundsLeft or 0, state.magSize or 30)
	elseif state.clip == "rack" then
		self:play("rack", rackClip(self), 1)
	elseif state.clip == "fire" then
		self:play("fire", fireClip(self, state.roundsLeft or 5), 1)
	elseif state.clip == "inspect" then
		self:Inspect()
	elseif state.clip == "draw" then
		-- A flair gun's draw flourish (tools/gunfun_flair_check.py); nothing for a gun without one.
		self:play("inspect", flairDraw(self))
	end
	local onEvent = self.onEvent
	self.onEvent = nil
	for _, clip in pairs(self.clips) do
		clip.start = self.now - (state.progress or 0) * clip.duration
	end
	self:Update(0, { camera = camera, aiming = (state.aim or 0) &gt; 0.5, sway = false, speed = 0, grounded = true })
	self.onEvent = onEvent
end

--------------------------------------------------------------------------------
-- The third-person body (#13)
--
-- Other players' bodies are posed by GunPoseClient. So that a reload seen from outside is the same reload
-- you see in first person, it is driven by the same clip tables: `ClipFor` builds this gun's reload or
-- rack clip from the gun model on the body (the HeldGun carries the same contract: Action and the parts'
-- Anim groups), and `BodyArm` turns where the clip's left hand is at a moment -- which anchor it is at or
-- between -- into the left arm's shoulder and elbow turns. The right hand stays on the grip: the held gun
-- is welded to the torso (WeaponService.MountGun), so a right arm that moved would leave it.
--------------------------------------------------------------------------------

-- Shoulder yaw and pitch and elbow bend, in degrees, for the left hand at each anchor, in the convention
-- GunPoseClient's own poses use (yaw applied after pitch; positive pitch raises the arm forward; negative
-- yaw turns a left arm in across the body). SupportHand is GunPoseClient's held pose exactly.
local BODY_LEFT = {
	SupportHand = { -38, 78, 14 },
	MagHand = { -50, 55, 60 },
	Slap = { -50, 58, 50 },
	Pocket = { -10, 15, 40 },
	Load = { -55, 62, 55 },
	ChargeHand = { -58, 88, 95 },
	BoltHand = { -60, 75, 85 },
	CoverHand = { -45, 95, 60 },
}
Viewmodel.BodyLeft = BODY_LEFT

local function bodyTurns(name)
	local entry = BODY_LEFT[name] or BODY_LEFT.SupportHand
	return CFrame.Angles(0, rad(entry[1]), 0) * CFrame.Angles(rad(entry[2]), 0, 0), CFrame.Angles(rad(entry[3]), 0, 0)
end

-- The reload (`kind` "reload") or rack ("rack") clip for the gun `model`, as first person would play it.
-- `empty` and `missing` are what StartReload is given. Nil when the gun has no such clip.
function Viewmodel.ClipFor(model, kind, empty, missing)
	-- The flair too: its reload flourish is part of the reload the body plays.
	local context = { action = model:GetAttribute("Action") or "ar", groupParts = {}, def = {}, flair = model:GetAttribute("Flair") }
	for _, part in ipairs(model:GetDescendants()) do
		local group = part:IsA("BasePart") and part:GetAttribute("Anim")
		if group then
			context.groupParts[group] = context.groupParts[group] or {}
			table.insert(context.groupParts[group], part)
		end
	end
	if kind == "rack" then
		return rackClip(context)
	end
	return reloadClip(context, empty == true, missing or 1)
end

-- The left arm's shoulder and elbow turns at `progress` (0..1) through `clip`: the anchors either side of
-- that moment on the clip's left-hand track, eased between exactly as first person eases them.
function Viewmodel.BodyArm(clip, progress)
	local a, b, s = sample(clip and clip.left, progress)
	if not a then
		return bodyTurns("SupportHand")
	end
	local shoulderA, elbowA = bodyTurns(a[2])
	local shoulderB, elbowB = bodyTurns(b[2])
	return shoulderA:Lerp(shoulderB, s), elbowA:Lerp(elbowB, s), a[2], b[2], s
end

return Viewmodel
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX194"><Properties><string name="Name">VoteDropClient</string><ProtectedString name="Source">-- The two screens a player sees before a match: the mode+map vote in the lobby (from the break after
-- the last match through the countdown), and the drop-location picker once the map is built.
--
-- This script is the WIRING only — remotes, match state, keys, the cursor and the viewport. The
-- drawing lives in VoteScreen.lua and DropPicker.lua, which are ModuleScripts so tools/gallery.ps1
-- can render exactly what a player sees rather than a replica of it.
--
-- It has its own ScreenGui for two reasons. HudClient's main chunk is three locals from Luau's
-- 200-local limit, which is a silent compile failure; and a ScreenGui of our own can set
-- ZIndexBehavior.Sibling, which is what lets the map's overlays stack inside the disc without
-- fighting the panel's own ZIndex.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MatchConfig = require(Shared:WaitForChild("MatchConfig"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local VoteScreen = require(script.Parent:WaitForChild("VoteScreen"))
local EventBanner = require(script.Parent:WaitForChild("EventBanner"))
local DropPicker = require(script.Parent:WaitForChild("DropPicker"))
-- The cursor is claimed, never simply switched on and off: see MenuOpenClaims for the two ways a
-- bare SetAttribute strands it, both of which Oliver has reported.
local MenuOpenClaims = require(script.Parent:WaitForChild("MenuOpenClaims"))
-- The two decisions this script used to make inline. They live in Shared because this is a
-- LocalScript and NOTHING IN THIS HARNESS CAN RUN ONE — a rule left here is a rule no probe can ever
-- check, which is how #100 stayed unreachable-by-construction without anybody noticing.
local VoteCursor = require(Shared:WaitForChild("VoteCursor"))
local VoteReveal = require(Shared:WaitForChild("VoteReveal"))
local Settings = require(script.Parent:WaitForChild("Settings"))

local matchChanged = Remotes.Event("MatchChanged")
local voteChanged = Remotes.Event("VoteChanged")
local castVote = Remotes.Function("CastVote")
local chooseDrop = Remotes.Event("ChooseDrop")
local getDropMap = Remotes.Function("GetDropMap")

-- How long the winner stays on screen after the countdown ends. The map takes several seconds to
-- build, so this costs nobody anything and answers "what did we get?" without a toast.
local REVEAL_SECONDS = 3

local gui = Instance.new("ScreenGui")
gui.Name = "PreMatchUi"
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
-- Above the HUD (`BrrHud`, default 0), the inventory (8) and the controls hint (20); below the
-- admin HUD (50). Both of these screens are modal moments — nothing else in the game should be
-- drawn over the map you are choosing a landing spot on.
gui.DisplayOrder = 30
gui.Parent = playerGui

local matchState = { state = "Waiting", countdown = 0, dropSelect = false }
local voteState = { open = false, candidates = {}, votes = {} }
local revealUntil = 0
local revealId = nil
-- The LAST VoteChanged snapshot, so the reveal can fire on a TRANSITION instead of on an arrival.
-- The server's `winner` is a standing field for the whole match (VoteService caches `resolved` until
-- the next Open), and Bootstrap re-broadcasts the snapshot on every join — so without this, every
-- mid-match join replayed the reveal on everybody's screen. That is Oliver's #107.
local previousVote = nil
-- The picker's outstanding claim on the cursor, held while its window is up.
local dropCursorClaim = nil
-- The vote screen's, held while the INTERACTIVE vote is up. Not during the reveal: see VoteCursor.
local voteCursorClaim = nil

local vote = VoteScreen.new({
	parent = gui,
	zIndex = 36,
	-- THE CURSOR FIX FOR #100, half two. Half one is the Modal overlay inside VoteScreen, which is
	-- what actually unlocks the mouse; this is the half that stops a click on a card also firing the
	-- gun, because CombatClient reads MenuOpen at five sites in inCombat().
	--
	-- Through MenuOpenClaims, never by writing the attribute: one boolean cannot say "two things want
	-- this", and a bare SetAttribute here would strand the menu's cursor exactly the way the drop
	-- picker's first version did.
	onMenuOpen = function(open)
		if open then
			if not voteCursorClaim then
				voteCursorClaim = MenuOpenClaims.Claim(VoteCursor.ClaimName)
			end
		elseif voteCursorClaim then
			voteCursorClaim()
			voteCursorClaim = nil
		end
	end,
	onVote = function(candidateId)
		-- Nothing waits on the answer: the tally comes back to everyone through VoteChanged, and a
		-- refusal is already unreachable from here — the cards are disabled and the header says
		-- "Ready up to vote" whenever the server would refuse. pcall'd because an InvokeServer on a
		-- client on its way out throws, and a throw here would take the button's handler with it.
		task.spawn(function()
			pcall(function()
				castVote:InvokeServer(candidateId)
			end)
		end)
	end,
})

local picker = DropPicker.new({
	parent = gui,
	zIndex = 40,
	totalSeconds = MatchConfig.DropSelectSeconds,
	onPick = function(x, z)
		chooseDrop:FireServer(x, z)
	end,
	-- The second half of the cursor fix: CombatClient reads MenuOpen so a click on the map does not
	-- also fire the gun. The picker owns WHEN, this owns the attribute, because a module a gallery
	-- can render has no player to set attributes on.
	--
	-- Through MenuOpenClaims and NOT by writing the attribute directly. Writing it directly is what
	-- the first version of this line did, and it is two of Oliver's cursor bugs: an unconditional
	-- clear strands the menu's own cursor when the picker closes over the top of it, and the menu
	-- closing underneath strands the picker's. A claim says "this screen wants the cursor" instead
	-- of "the cursor is now free", which is the thing a single boolean cannot say twice.
	onMenuOpen = function(open)
		if open then
			if not dropCursorClaim then
				dropCursorClaim = MenuOpenClaims.Claim("DropPicker")
			end
		elseif dropCursorClaim then
			dropCursorClaim()
			dropCursorClaim = nil
		end
	end,
})

--------------------------------------------------------------------------------
-- The vote
--------------------------------------------------------------------------------

local function isReady()
	return player:GetAttribute("Ready") == true
end

local function renderVote()
	-- Both faces of the screen are gated on the MATCH state, in Shared/VoteReveal.View so a harness
	-- can run it (tools/vote_open_check.py): the interactive vote only in the lobby, the
	-- winner reveal only while the match is still loading and never behind the drop picker. Without
	-- the second half, a respawn mode on a quick-building map had the reveal over live play (#107).
	local stateOpen, showReveal = VoteReveal.View(matchState, voteState.open, revealId ~= nil and tick() &lt; revealUntil, isReady())
	local decided = showReveal and revealId or nil
	-- The shop, the inventory and the merge dialog all raise `MenuOpen`, and this screen is drawn
	-- above every one of them (DisplayOrder 30). A vote panel sitting on top of the menu somebody
	-- opened is a worse bug than a vote panel they have to close the menu to see, so it stands aside
	-- and comes straight back — the attribute's own changed signal re-renders below.
	--
	-- IT ASKS WHO IS HOLDING THE CURSOR, NOT WHETHER THE ATTRIBUTE IS SET, and that is the whole of
	-- #100. Reading the raw attribute counted THIS SCREEN'S OWN CLAIM as somebody else's, so a vote
	-- that took the cursor immediately hid itself: the two conditions could never hold at once, and
	-- the set "vote on screen AND mouse free" was empty by construction. Excluded BY NAME, from the
	-- holder set, never from a count — see VoteCursor.ShouldStandAside.
	local menuUp = VoteCursor.ShouldStandAside(
		MenuOpenClaims.Holders(), MenuOpenClaims.LegacyHolder(), VoteCursor.ClaimName)
	local open = stateOpen and not menuUp
	if menuUp then
		decided = nil
	end
	-- The server keys this by UserId as a STRING: a table keyed by raw UserIds is a sparse array and
	-- RemoteEvents truncate those at the first gap, which used to leave the client unable to
	-- highlight its own vote at all.
	local mine = voteState.votes and voteState.votes[tostring(player.UserId)]
	local candidates = {}
	for index, candidate in ipairs(voteState.candidates or {}) do
		candidates[index] = {
			id = candidate.id,
			mode = candidate.mode,
			map = candidate.map,
			votes = candidate.votes,
			mine = mine == candidate.id,
		}
	end
	vote:Render({
		open = open,
		decided = decided,
		candidates = candidates,
		seconds = matchState.countdown or 0,
		-- The vote opens with the break after a match, so its clock is the break's until the countdown.
		total = matchState.state == "Intermission" and MatchConfig.Intermission or MatchConfig.LobbyCountdown,
		ready = isReady(),
		-- Named on the "ready up to vote" line, so the panel that asks for it says which key it is.
		readyKey = Settings.KeyLabel("Ready"),
	})
end

voteChanged.OnClientEvent:Connect(function(state)
	voteState = state or { open = false, candidates = {}, votes = {} }
	-- A SNAPSHOT, NOT AN EVENT. `winner` stands in every snapshot for the whole match, and Bootstrap
	-- re-broadcasts on every join, so the old test (`state.winner and not state.open`) replayed the
	-- reveal over live gameplay each time somebody joined — Oliver's #107, and the state that made
	-- his mouse unfreeable in #100. The decision now compares against the PREVIOUS snapshot and lives
	-- in Shared/VoteReveal, where tools/prematch_ui_probe.lua runs a truth table over it.
	local shouldReveal = VoteReveal.ShouldReveal(previousVote, state)
	previousVote = state
	if shouldReveal then
		revealId = state.winner
		-- tick(), not os.clock(): os.clock() is process CPU time in Roblox, so a clock that
		-- spends its time waiting would never reach the deadline.
		revealUntil = tick() + REVEAL_SECONDS
		-- The match-event card waits for the reveal panel to go, rather than spend its 3.2 s under
		-- it (#86; EventBanner.HoldFor).
		EventBanner.HoldFor(REVEAL_SECONDS)
		task.delay(REVEAL_SECONDS + 0.05, function()
			if revealId == state.winner then
				revealId = nil
				renderVote()
			end
		end)
	elseif state and state.open then
		revealId = nil
	end
	renderVote()
end)

player:GetAttributeChangedSignal("Ready"):Connect(renderVote)
-- Set by the menu, the inventory and the merge dialog — and by this script's own picker, which is
-- why the vote and the picker can never end up on screen together.
player:GetAttributeChangedSignal("MenuOpen"):Connect(renderVote)

-- 1, 2, 3 vote for the first, second and third card. There is no clash with the hotbar: those keys
-- only do anything in CombatClient while a match is in progress, and this screen is only up in the
-- lobby (the break, waiting and the countdown).
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not isReady() or not (VoteReveal.View(matchState, voteState.open, false, true)) then
		return
	end
	local index
	if input.KeyCode == Enum.KeyCode.One then
		index = 1
	elseif input.KeyCode == Enum.KeyCode.Two then
		index = 2
	elseif input.KeyCode == Enum.KeyCode.Three then
		index = 3
	end
	if not index then
		return
	end
	local id = vote:CandidateAt(index)
	if id then
		task.spawn(function()
			pcall(function()
				castVote:InvokeServer(id)
			end)
		end)
	end
end)

--------------------------------------------------------------------------------
-- The drop picker
--------------------------------------------------------------------------------

-- One token per window: a map that arrives after its window closed is dropped rather than drawn
-- over the next one.
local dropToken = 0

local function openPicker()
	dropToken += 1
	local token = dropToken
	picker:SetPayload(nil)
	picker:SetSeconds(matchState.countdown or MatchConfig.DropSelectSeconds)
	picker:SetVisible(true)
	task.spawn(function()
		-- Two tries: the first can land in the moment between the window opening and the map being
		-- reachable, and the rate limit allows for exactly this.
		for attempt = 1, 2 do
			local ok, payload = pcall(function()
				return getDropMap:InvokeServer()
			end)
			if token ~= dropToken then
				return
			end
			if ok and type(payload) == "table" then
				picker:SetPayload(payload)
				return
			end
			if attempt == 1 then
				task.wait(1)
			else
				warn("[VoteDropClient] no drop map from the server; the picker stays on its placeholder")
			end
			if token ~= dropToken then
				return
			end
		end
	end)
end

local function updateDrop()
	local active = matchState.dropSelect == true and isReady()
	if active and not picker.visible then
		openPicker()
	elseif not active and picker.visible then
		dropToken += 1
		picker:SetVisible(false)
	end
	if active then
		picker:SetSeconds(matchState.countdown or 0)
	end
end

matchChanged.OnClientEvent:Connect(function(state)
	matchState = state or matchState
	updateDrop()
	renderVote()
end)

--------------------------------------------------------------------------------
-- The viewport
--------------------------------------------------------------------------------

-- A screen that lays out once and never again is how the short and tall versions end up shipped
-- without ever having run: the menu shell's `SetViewport` turned out never to be called in the
-- game at all. Both screens re-lay themselves whenever the viewport changes, which also covers a
-- phone being turned over mid-countdown.
local camera = workspace.CurrentCamera
if camera then
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		vote:Relayout()
		if picker.visible then
			picker:Layout()
		end
	end)
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	local newCamera = workspace.CurrentCamera
	if newCamera then
		newCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			vote:Relayout()
			if picker.visible then
				picker:Layout()
			end
		end)
	end
end)

renderVote()
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX195"><Properties><string name="Name">VoteScreen</string><ProtectedString name="Source">-- The pre-match vote: which MODE, on which MAP (Oliver's #2).
--
-- Three cards, ONE PER MODE — Battle Royale, Team Deathmatch, King of the Hill, in an order the
-- server shuffles — each on a DIFFERENT random map, so one tap picks both at once. That is the
-- whole design decision: a mode vote and a map vote as two screens would be two decisions and twice
-- the countdown, and a mode vote with the map fixed would hand the same map to three different
-- games.
--
-- Most votes wins; a tie among the leaders is drawn at random; a vote nobody cast goes to Battle
-- Royale because that is the main game. Only players who have READIED UP can vote — somebody
-- standing in the lobby with no intention of playing does not choose the match — and an unreadied
-- player sees the cards greyed with "Ready up to vote" rather than a screen that silently ignores
-- them. All of that is decided and enforced in ServerScriptService/Modules/VoteService.lua; this
-- file draws it and nothing more.
--
-- WHAT EACH CARD SAYS IS DERIVED, NEVER TYPED. The pitch line is built from the mode's own
-- scoreTarget and scoreLabel, so a card cannot claim "first to 50" while the server plays to 100 —
-- which is exactly what `GameModes.TeamDeathmatch.description` says today.
--
-- A ModuleScript so tools/gallery.ps1 can render it, and because HudClient's main chunk is three
-- locals from Luau's 200-local limit.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local UserInputService = game:GetService("UserInputService")

local MapData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapData"))
-- What is drawn and what holds the mouse, in one place. See VoteCursor for why they are not the same
-- answer, and for why this screen could never free the cursor before (Oliver's #100).
local VoteCursor = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("VoteCursor"))

local UiKit = require(script.Parent:WaitForChild("UiKit"))
local UiParts = require(script.Parent:WaitForChild("UiParts"))

local create = UiKit.create
local Role, Type, Space, Radius, Stroke = UiKit.Role, UiKit.Type, UiKit.Space, UiKit.Radius, UiKit.Stroke

local VoteScreen = {}

-- TEST SEAM. Never set by game code: a gallery frame can choose a width but not a viewport height,
-- and `short` is decided by height, so without this the short version ships unexercised.
VoteScreen.ViewportForTest = nil

local TERRAIN_SWATCH = {
	[Enum.Material.Grass] = Color3.fromRGB(92, 146, 70),
	[Enum.Material.LeafyGrass] = Color3.fromRGB(84, 142, 60),
	[Enum.Material.Ground] = Color3.fromRGB(150, 124, 92),
	[Enum.Material.Sand] = Color3.fromRGB(214, 190, 140),
	[Enum.Material.Rock] = Color3.fromRGB(132, 126, 118),
}

local function textWidth(text, size, font)
	local ok, measured = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(4000, 200)).X
	end)
	return ok and measured or #text * size * 0.58
end

-- Built from the mode's own numbers, so it cannot drift from what the server plays.
local function pitchFor(mode)
	if mode.id == "BattleRoyale" then
		return "Fifty in, one out. Storm, loot, and you pick where you drop."
	end
	local target = mode.scoreTarget
	local label = mode.scoreLabel or "points"
	if not target then
		return mode.description or ""
	end
	if label == "seconds held" then
		return string.format("Two teams, two objectives. Capture and hold them, first to %d. Respawns.", target)
	end
	return string.format("Two teams. First to %d %s. Respawns.", target, label)
end

local function sizeTag(radius)
	if radius &gt;= 1250 then
		return "Large map"
	elseif radius &gt;= 1000 then
		return "Medium map"
	end
	return "Small map"
end

local function swatchColour(mapId)
	local preset = MapData.Get(mapId)
	return (preset and TERRAIN_SWATCH[preset.terrainMaterial]) or Color3.fromRGB(92, 146, 70)
end

--------------------------------------------------------------------------------

local Screen = {}
Screen.__index = Screen

-- `onVote(candidateId)` is called on a tap or a number key. `parent` is a ScreenGui.
-- `onMenuOpen(open)` is called with the INTERACTIVE vote's state, and it is the caller's job to write
-- the player attribute: a module a gallery can render has no player to set attributes on. Same split
-- as DropPicker.
function VoteScreen.new(options)
	local self = setmetatable({}, Screen)
	self.parent = options.parent
	self.onVote = options.onVote
	self.onMenuOpen = options.onMenuOpen
	self.zIndex = options.zIndex or 36
	self.touch = options.touch
	self.forcedInputKind = options.inputKind
	self.menuOpenHeld = false
	self.state = { open = false, candidates = {}, seconds = 0, ready = false }

	-- THE CURSOR FIX FOR #100, half one, and the only half that actually unlocks the mouse. A VISIBLE
	-- GuiButton with Modal = true frees the cursor for as long as it is up, which is the one thing
	-- that beats `CameraMode.LockFirstPerson` — Roblox's own camera relocks the mouse EVERY FRAME, so
	-- no one-shot MouseBehavior write survives it. Transparent, exactly like the inventory's overlay
	-- and MenuCursor's flag: a Modal button has to be Visible, it does not have to be seen, and the
	-- vote screen is not gaining a dim it was never designed with.
	--
	-- It follows the INTERACTIVE vote, not the screen's visibility — see VoteCursor.Screen.
	-- `options.noModal` exists for one reason: the gallery builds a deliberately broken screen with it
	-- to prove the check that reads these properties can actually fail.
	if not options.noModal then
		self.modal = create("TextButton", {
			Name = "VoteOverlay",
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromScale(0, 0),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Modal = true,
			Selectable = false,
			Active = true,
			Text = "",
			Visible = false,
			ZIndex = (options.zIndex or 36) - 1,
			Parent = options.parent,
		})
	end

	self.root = create("Frame", {
		Name = "VoteScreen",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = self.zIndex,
		Parent = self.parent,
	})
	return self
end

function Screen:isTouch()
	if self.touch ~= nil then
		return self.touch
	end
	local ok, touch = pcall(function()
		return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	end)
	return ok and touch or false
end

-- Which WORDS to use -- "touch", "gamepad" or "keyboard" -- as distinct from which layout. isTouch
-- decides the shape (safe area, insets, the phone banner) and is rightly about the screen; this is
-- about the hands. The two-device test alone sent a console player down the keyboard branch, "Press
-- 1, 2 or 3" on a machine with no keys, because a console is neither touch nor keyboard (the
-- coordinator's sweep; HudClient's tips use the same three-way test). `options.inputKind` lets a
-- gallery or a probe force one.
function Screen:inputKind()
	if self.forcedInputKind then
		return self.forcedInputKind
	end
	if self:isTouch() then
		return "touch"
	end
	local ok, kind = pcall(function()
		local last = UserInputService:GetLastInputType()
		if string.find(last.Name, "Gamepad", 1, true)
			or (UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled) then
			return "gamepad"
		end
		return "keyboard"
	end)
	return ok and kind or "keyboard"
end

function Screen:Destroy()
	-- Release BEFORE the instances go. A screen torn down while holding the cursor leaves its claim
	-- outstanding with nothing left alive to release it, and the mouse stays free for the session.
	if self.menuOpenHeld then
		self.menuOpenHeld = false
		if self.onMenuOpen then
			self.onMenuOpen(false)
		end
	end
	if self.modal then
		self.modal:Destroy()
	end
	self.root:Destroy()
end

-- Which candidate a number key picks, so VoteDropClient does not have to know the card order.
function Screen:CandidateAt(index)
	local candidate = self.state.candidates[index]
	return candidate and candidate.id or nil
end

-- The whole screen is re-rendered from `state`; there is no incremental path to get out of step
-- with the server. A vote arrives every time anyone in the lobby taps a card, which on a 50-player
-- server is a handful of redraws of nine text labels — measured against the alternative of an
-- update path that can disagree with the tally it is drawing, that is the right trade.
--
-- state = { open, candidates = { { id, mode, map, votes, mine } }, decided = id, seconds, ready, readyKey }
function Screen:Render(state)
	if state then
		self.state = state
	end
	state = self.state
	-- One definition of "drawn" and "holds the mouse", shared with VoteDropClient. The reveal is
	-- visible WITHOUT wanting the cursor: its cards are built inert (`Active = enabled and not
	-- decided`), so there is nothing to click, and claiming for it would switch combat off.
	local visible, wantsCursor = VoteCursor.Screen(state.open, state.decided, state.ready)
	self.root.Visible = visible
	if self.modal then
		self.modal.Visible = wantsCursor
	end
	-- ON A CHANGE ONLY. Render runs on every redraw — a snapshot arrives each time anyone in the
	-- lobby taps a card — and a callback fired per redraw would claim and release the cursor once per
	-- tap. Treating a repeat as a transition is the exact bug class this fix exists for; it is not
	-- being reintroduced two files from where it was found.
	if wantsCursor ~= self.menuOpenHeld then
		self.menuOpenHeld = wantsCursor
		if self.onMenuOpen then
			self.onMenuOpen(wantsCursor)
		end
	end
	if not visible then
		return
	end
	self:Layout()
end

function Screen:Relayout()
	if self.root.Visible then
		self:Layout()
	end
end

local function viewportOf()
	if VoteScreen.ViewportForTest then
		return VoteScreen.ViewportForTest
	end
	local camera = workspace.CurrentCamera
	return camera and camera.ViewportSize or Vector2.new(1280, 720)
end

-- One candidate. `shape` is "card" (large), "compact" (short) or "row" (tall).
function Screen:card(parent, candidate, shape, w, h, order, decidedId, enabled)
	local mode = candidate.mode
	local decided = decidedId ~= nil
	local isDecided = decidedId == candidate.id
	local button = create("TextButton", {
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = Role.Surface,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		ClipsDescendants = true,
		LayoutOrder = order,
		Active = enabled and not decided,
		Selectable = enabled and not decided,
		ZIndex = self.zIndex + 1,
		Parent = parent,
	}, { create("UICorner", { CornerRadius = UDim.new(0, Radius.Card) }) })

	-- EXACTLY ONE UIStroke. Roblox applies one per object, so a card that adds a "highlight" stroke
	-- next to its resting stroke gets whichever the engine picked — which is how a highlight ends up
	-- working on some cards and not others. The state decides the stroke's colour; it does not add
	-- another one. Border mode is required as well: on a TextButton the default Contextual mode
	-- strokes the TEXT, and this button has none.
	local highlighted = candidate.mine or isDecided
	create("UIStroke", {
		Color = isDecided and Role.Positive or (candidate.mine and Role.Accent or Role.Line),
		Thickness = highlighted and Stroke.Focus or Stroke.Hairline,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = button,
	})
	-- Everything the vote did not pick steps back once the vote is decided, so the winner reads at
	-- a glance from across the room.
	if decided and not isDecided then
		button.BackgroundTransparency = 0.55
	end
	-- Greyed, not hidden: an unreadied player can see exactly what they are missing, and the header
	-- says how to join in.
	if not enabled then
		button.BackgroundTransparency = 0.4
	end

	local ink = enabled and Role.Text or Role.TextMuted
	local votes = candidate.votes or 0

	if shape == "row" then
		create("Frame", {
			Size = UDim2.new(0, 6, 1, 0),
			BackgroundColor3 = mode.color,
			BackgroundTransparency = enabled and 0 or 0.4,
			BorderSizePixel = 0,
			ZIndex = self.zIndex + 2,
			Parent = button,
		})
		local x, tallyW = Space.MD + 6, 92
		UiParts.text(button, Type.Heading, mode.name, ink, {
			Position = UDim2.fromOffset(x, Space.SM),
			Size = UDim2.fromOffset(w - x - tallyW - Space.MD, 24),
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = self.zIndex + 2,
		})
		create("Frame", {
			Position = UDim2.fromOffset(x, Space.SM + 28),
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = swatchColour(candidate.map.id),
			BorderSizePixel = 0,
			ZIndex = self.zIndex + 2,
			Parent = button,
		}, {
			create("UICorner", { CornerRadius = UDim.new(1, 0) }),
			create("UIStroke", { Color = Role.Base, Thickness = 2 }),
		})
		UiParts.text(button, Type.Label, candidate.map.name .. "  ·  " .. sizeTag(candidate.map.radius), Role.TextMuted, {
			Position = UDim2.fromOffset(x + 22, Space.SM + 28),
			Size = UDim2.fromOffset(w - x - 22 - tallyW - Space.MD, 16),
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = self.zIndex + 2,
		})
		local tally = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -Space.SM, 0.5, 0),
			Size = UDim2.fromOffset(tallyW - Space.SM, 44),
			BackgroundColor3 = candidate.mine and Role.Accent or Role.SurfaceAlt,
			BorderSizePixel = 0,
			ZIndex = self.zIndex + 2,
			Parent = button,
		}, { create("UICorner", { CornerRadius = UDim.new(0, Radius.Control) }) })
		UiParts.text(tally, Type.Heading, tostring(votes), candidate.mine and Role.AccentInk or ink, {
			Position = UDim2.fromOffset(0, 3),
			Size = UDim2.new(1, 0, 0, 22),
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = self.zIndex + 3,
		})
		UiParts.text(tally, Type.Caption,
			isDecided and "NEXT" or (candidate.mine and "YOURS" or (votes == 1 and "VOTE" or "VOTES")),
			candidate.mine and Role.AccentInk or Role.TextMuted, {
			Position = UDim2.fromOffset(0, 25),
			Size = UDim2.new(1, 0, 0, 14),
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = self.zIndex + 3,
		})
	else
		create("Frame", {
			Size = UDim2.new(1, 0, 0, 6),
			BackgroundColor3 = mode.color,
			BackgroundTransparency = enabled and 0 or 0.4,
			BorderSizePixel = 0,
			ZIndex = self.zIndex + 2,
			Parent = button,
		})
		local inner = w - Space.MD * 2
		local y = Space.MD + 2
		UiParts.text(button, Type.Heading, mode.name, ink, {
			Position = UDim2.fromOffset(Space.MD, y),
			Size = UDim2.fromOffset(inner, 24),
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = self.zIndex + 2,
		})
		y += 26
		if shape == "card" then
			UiParts.text(button, Type.Caption, pitchFor(mode), Role.TextMuted, {
				Position = UDim2.fromOffset(Space.MD, y),
				Size = UDim2.fromOffset(inner, 34),
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				ZIndex = self.zIndex + 2,
			})
			y += 40
		end
		local swatch = shape == "card" and 32 or 26
		create("Frame", {
			Position = UDim2.fromOffset(Space.MD, y),
			Size = UDim2.fromOffset(swatch, swatch),
			BackgroundColor3 = swatchColour(candidate.map.id),
			BorderSizePixel = 0,
			ZIndex = self.zIndex + 2,
			Parent = button,
		}, {
			create("UICorner", { CornerRadius = UDim.new(1, 0) }),
			create("UIStroke", { Color = Role.Base, Thickness = 2 }),
		})
		UiParts.text(button, Type.Label, candidate.map.name, ink, {
			Position = UDim2.fromOffset(Space.MD + swatch + Space.SM, y),
			Size = UDim2.fromOffset(inner - swatch - Space.SM, 18),
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = self.zIndex + 2,
		})
		UiParts.text(button, Type.Caption, sizeTag(candidate.map.radius), Role.TextMuted, {
			Position = UDim2.fromOffset(Space.MD + swatch + Space.SM, y + 18),
			Size = UDim2.fromOffset(inner - swatch - Space.SM, 14),
			ZIndex = self.zIndex + 2,
		})

		local text = string.format("%d VOTE%s", votes, votes == 1 and "" or "S")
		local pillW = textWidth(text, Type.Label.Size, Type.Label.Font) + Space.LG * 2
		local tally = create("Frame", {
			Position = UDim2.fromOffset(Space.MD, h - Space.MD - 30),
			Size = UDim2.fromOffset(pillW, 30),
			BackgroundColor3 = candidate.mine and Role.Accent or Role.SurfaceAlt,
			BorderSizePixel = 0,
			ZIndex = self.zIndex + 2,
			Parent = button,
		}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		UiParts.text(tally, Type.Label, text, candidate.mine and Role.AccentInk or ink, {
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = self.zIndex + 3,
		})
		if isDecided then
			UiParts.text(button, Type.Label, "PLAYING NEXT", Role.Positive, {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromOffset(w - Space.MD, h - Space.MD - 26),
				Size = UDim2.fromOffset(inner - pillW - Space.SM, 20),
				TextXAlignment = Enum.TextXAlignment.Right,
				ZIndex = self.zIndex + 2,
			})
		elseif candidate.mine then
			UiParts.text(button, Type.Caption, "YOUR VOTE", Role.Accent, {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromOffset(w - Space.MD, h - Space.MD - 24),
				Size = UDim2.fromOffset(inner - pillW - Space.SM, 18),
				TextXAlignment = Enum.TextXAlignment.Right,
				ZIndex = self.zIndex + 2,
			})
		end
	end

	if enabled and not decided then
		-- Hover and press by hand rather than through UiParts.interactive, for one reason: that
		-- helper parents a focus UIStroke of its own, and this card has already spent its single
		-- stroke on saying whether it is the one you voted for.
		local rest = Role.Surface
		button.MouseEnter:Connect(function()
			button.BackgroundColor3 = rest:Lerp(Color3.new(1, 1, 1), 0.12)
		end)
		button.MouseLeave:Connect(function()
			button.BackgroundColor3 = rest
		end)
		button.MouseButton1Down:Connect(function()
			button.BackgroundColor3 = rest:Lerp(Color3.new(0, 0, 0), 0.18)
		end)
		-- A finger has no "leave": a tap lands on the hover colour and stays there without this.
		button.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				button.BackgroundColor3 = rest
			end
		end)
		button.Activated:Connect(function()
			if self.onVote then
				self.onVote(candidate.id)
			end
		end)
	end
	return button
end

function Screen:Layout()
	for _, child in ipairs(self.root:GetChildren()) do
		child:Destroy()
	end
	local state = self.state
	local viewport = viewportOf()
	local form = UiKit.form(viewport)
	local touch = self:isTouch()
	local safe = UiKit.safeArea(viewport, touch)
	local decidedId = state.decided
	local enabled = state.ready ~= false and decidedId == nil

	local panel = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Role.Base,
		BorderSizePixel = 0,
		ZIndex = self.zIndex,
		Parent = self.root,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0, Radius.Panel) }),
		create("UIStroke", { Color = Role.Line, Thickness = Stroke.Hairline }),
	})

	local shape, cardW, cardH, gap, width
	if form == "tall" then
		width = math.clamp(viewport.X - safe.Left - safe.Right, 300, 420)
		shape, cardW, cardH, gap = "row", width - Space.MD * 2, 80, Space.SM
	elseif form == "short" then
		shape, cardW, cardH, gap = "compact", 236, 150, Space.MD
		width = 3 * cardW + 2 * gap + Space.MD * 2
	else
		shape, cardW, cardH, gap = "card", 286, 236, Space.MD
		width = 3 * cardW + 2 * gap + Space.MD * 2
	end
	local inner = width - Space.MD * 2

	local title = decidedId and "NEXT MATCH" or "VOTE:  MODE &amp; MAP"
	local headerStyle = form == "large" and Type.Title or Type.Heading
	local y = Space.MD
	UiParts.text(panel, headerStyle, title, Role.Text, {
		Position = UDim2.fromOffset(Space.MD, y),
		Size = UDim2.fromOffset(inner - 76, headerStyle.Size + 8),
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = self.zIndex + 1,
	})
	if not decidedId then
		UiParts.text(panel, form == "large" and Type.Display or Type.Title,
			tostring(math.max(0, math.floor(state.seconds or 0))), Role.Accent, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromOffset(width - Space.MD, y - 4),
			Size = UDim2.fromOffset(72, 40),
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = self.zIndex + 1,
		})
	end
	y += headerStyle.Size + 12

	local track = create("Frame", {
		Position = UDim2.fromOffset(Space.MD, y),
		Size = UDim2.fromOffset(inner, 4),
		BackgroundColor3 = Role.SurfaceAlt,
		BorderSizePixel = 0,
		ZIndex = self.zIndex + 1,
		Parent = panel,
	}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	create("Frame", {
		Size = UDim2.fromScale(decidedId and 1 or math.clamp((state.seconds or 0) / math.max(state.total or 15, 1), 0, 1), 1),
		BackgroundColor3 = decidedId and Role.Positive or Role.Accent,
		BorderSizePixel = 0,
		ZIndex = self.zIndex + 2,
		Parent = track,
	}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	y += 4 + Space.MD

	local holder = create("Frame", {
		Position = UDim2.fromOffset(Space.MD, y),
		Size = UDim2.fromOffset(inner, shape == "row" and (3 * cardH + 2 * gap) or cardH),
		BackgroundTransparency = 1,
		ZIndex = self.zIndex + 1,
		Parent = panel,
	}, {
		create("UIListLayout", {
			FillDirection = shape == "row" and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, gap),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for index, candidate in ipairs(state.candidates) do
		self:card(holder, candidate, shape, cardW, cardH, index, decidedId, enabled)
	end
	y += holder.Size.Y.Offset + Space.SM

	-- One line that says what happens next. Which line depends on the three things a player can be:
	-- not readied (so their vote would not count), voting, or watching the result.
	local hint, hintColour
	if decidedId then
		local winner
		for _, candidate in ipairs(state.candidates) do
			if candidate.id == decidedId then
				winner = candidate
			end
		end
		hint = winner and string.format("%s on %s. Building the map…", winner.mode.name, winner.map.name)
			or "Building the map…"
		hintColour = Role.Positive
	elseif not enabled then
		-- The vote takes neither the cursor nor the overlay from an unready player (VoteCursor.Screen),
		-- so both ways to ready up work from right here; say which they are, in the hands' own words.
		local kind = self:inputKind()
		if kind == "touch" then
			hint = "Not in the next match yet — tap READY UP at the top to vote."
		elseif kind == "gamepad" then
			hint = "Not in the next match yet — step on the ready pad on the airship, or READY UP at the top, to vote."
		elseif state.readyKey then
			hint = string.format("Not in the next match yet — press [%s] or click READY UP at the top to vote.", state.readyKey)
		else
			hint = "Ready up to vote — only players who are in the next match choose it."
		end
		hintColour = Role.Accent
	else
		-- Worded for the hands, not the screen: a console is neither touch nor keyboard, and the
		-- pad has no 1, 2 or 3.
		local kind = self:inputKind()
		if kind == "touch" then
			hint = "Tap a card to vote. Most votes wins; a tie is drawn at random."
		elseif kind == "gamepad" then
			hint = "Pick a card. Most votes wins; a tie is drawn at random."
		else
			hint = "Press 1, 2 or 3, or click a card. Most votes wins; a tie is drawn at random."
		end
		hintColour = Role.TextMuted
	end
	UiParts.text(panel, Type.Caption, hint, hintColour, {
		Position = UDim2.fromOffset(Space.MD, y),
		Size = UDim2.fromOffset(inner, 32),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = self.zIndex + 1,
	})
	y += (form == "tall" and 32 or 18) + Space.MD

	panel.Size = UDim2.fromOffset(width, y)
	-- Below Roblox's top bar AND below the HUD's own banner, then centred in what is left. The
	-- banner's rect comes from PhoneLayout rather than a guess: on a portrait phone it sits where
	-- this panel would otherwise start, and the first render had the two overlapping by six pixels.
	local ceiling = safe.Top
	if touch then
		pcall(function()
			local rects = require(script.Parent:WaitForChild("PhoneLayout")).Rects(viewport)
			if rects and rects.banner then
				ceiling = math.max(ceiling, rects.banner.y + rects.banner.h + Space.SM)
			end
		end)
	end
	local bottomInset = touch and Space.LG or safe.Bottom
	-- Held a little high rather than dead centre: the lobby is behind this, and the ready button
	-- and the plaza are what a player looks at next.
	local top = ceiling + math.max(0, (viewport.Y - ceiling - bottomInset - y)) * 0.45
	panel.Position = UDim2.new(0.5, 0, 0, math.max(ceiling, math.floor(top)))
end

return VoteScreen
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX196"><Properties><string name="Name">ZiplineClient</string><ProtectedString name="Source">-- Riding a zipline (server: ZiplineService). The server has checked we're at the top and tells
-- us the line; from there our own character is moved along it, hanging under the rope, facing
-- the way it's going, until the bottom — or until we jump off, or the line SNAPS (Oliver 2026-09-24:
-- ziplines break like everything else; DestructibleService takes the whole line down when any of it
-- is shot out): then we drop from where we are, carrying on a little the way we were going.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local player = Players.LocalPlayer
local ride = Remotes.Event("Zipline")

local riding = nil

local function stopRide(letGo)
	local current = riding
	riding = nil
	if not current then
		return
	end
	if current.humanoid.Parent then
		current.humanoid.PlatformStand = false
	end
	if letGo and current.root.Parent then
		local direction = (current.to - current.from).Unit
		current.root.AssemblyLinearVelocity = Vector3.new(direction.X, 0, direction.Z) * current.speed * 0.45 + Vector3.new(0, 6, 0)
	end
	Sfx.Play("Zipline", 0.1, 0.8)
end

ride.OnClientEvent:Connect(function(data)
	if riding or type(data) ~= "table" or typeof(data.from) ~= "Vector3" or typeof(data.to) ~= "Vector3" then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health &lt;= 0 then
		return
	end
	riding = {
		from = data.from,
		to = data.to,
		length = math.max(1, (data.to - data.from).Magnitude),
		speed = tonumber(data.speed) or 50,
		hang = tonumber(data.hang) or 4.4,
		-- The line itself, when the server says which: gone from under us means it snapped.
		line = typeof(data.line) == "Instance" and data.line or nil,
		t = 0,
		humanoid = humanoid,
		root = root,
	}
	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = Vector3.zero
	Sfx.Play("Zipline", 0.1)
end)

RunService.Heartbeat:Connect(function(dt)
	local current = riding
	if not current then
		return
	end
	if not current.root.Parent or current.humanoid.Health &lt;= 0 then
		stopRide(false)
		return
	end
	if current.line and not current.line:IsDescendantOf(workspace) then
		-- The line snapped: let go, falling.
		stopRide(true)
		return
	end
	current.t = math.min(1, current.t + dt * current.speed / current.length)
	local position = current.from:Lerp(current.to, current.t) - Vector3.new(0, current.hang, 0)
	local direction = current.to - current.from
	local flat = Vector3.new(direction.X, 0, direction.Z)
	local look = flat.Magnitude &gt; 0.1 and flat.Unit or Vector3.new(0, 0, -1)
	current.root.CFrame = CFrame.lookAt(position, position + look)
	current.root.AssemblyLinearVelocity = Vector3.zero
	current.root.AssemblyAngularVelocity = Vector3.zero
	if current.t &gt;= 1 then
		stopRide(true)
	end
end)

UserInputService.JumpRequest:Connect(function()
	if riding then
		stopRide(true)
	end
end)
</ProtectedString></Properties></Item></Item><Item class="StarterCharacterScripts" referent="RBX197"><Properties><string name="Name">StarterCharacterScripts</string></Properties><Item class="Script" referent="RBX198"><Properties><string name="Name">Health</string><ProtectedString name="Source">-- Deliberately empty. Roblox copies a default Script named "Health" into every character, and it
-- regenerates 1% of MaxHealth a second, all match long: storm phase 1 (1 dmg/s) did nothing and heal
-- items were worth half as much. A script of the same name here replaces it. Players heal out of
-- combat on the server instead, at the bots' rate after the bots' lull (MatchService's `regen`,
-- MatchConfig.BotRegenDelay / BotRegenPerSecond). tools/regen_check.py fails if this goes.
</ProtectedString></Properties></Item></Item></Item></roblox>