local streakLabel = create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.34, 0),
	Size = UDim2.fromOffset(520, 60),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
