-- 558 wide: six 84px slot cells, five 6px gaps, 12px padding each side.
local weaponFrame = create("Frame", {
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -16, 1, -16),
	Size = UDim2.new(0, 690, 0, 150),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.15,
	BorderSizePixel = 0,
	Visible = false,
	Parent = screenGui,
}, { rounded(12), padding(12) })

-- Narrow screens: the hotbar shrinks (a UIScale about its bottom-right corner) until it clears the
-- bottom-left stack, whose widest piece is the companion ability icon's key badge at 404 px across,
-- and never takes more than about a third of the screen's height. Full size from about 1122 px wide;
-- 0.6 on an 844x390 phone. In a do-block: this script's main chunk is close to Luau's 200-local limit.
do
	local LEFT_STACK_RIGHT, GAP, WIDTH, HEIGHT = 404, 12, 690, 150
	local hotbarScale = create("UIScale", { Parent = weaponFrame })
	-- On a touch screen the hotbar is a different shape altogether (four across and two down, in the
	-- band between the thumbstick and the buttons): the phone layout block near the end of this file
	-- owns it there, and this rule steps aside rather than fighting it every time the screen changes.
	local phoneOk, PhoneLayout = pcall(require, script.Parent:WaitForChild("PhoneLayout", 5))
	local function fitHotbar()
		local viewport = camera.ViewportSize
		if phoneOk and PhoneLayout and PhoneLayout.Active(viewport) then
			return
		end
		local room = viewport.X - 16 - (LEFT_STACK_RIGHT + GAP)
		local scale = math.clamp(math.min(1, room / WIDTH, viewport.Y * 0.3 / HEIGHT), 0.5, 1)
		hotbarScale.Scale = scale
		weaponFrame:SetAttribute("HotbarScale", scale)
	end
	fitHotbar()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(fitHotbar)
end

local ammoText = create("TextLabel", {
	Size = UDim2.new(1, 0, 0, 32),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "--",
	TextColor3 = C.Text,
	TextXAlignment = Enum.TextXAlignment.Right,
	TextSize = 30,
	Parent = weaponFrame,
})

local weaponName = create("TextLabel", {
	Position = UDim2.new(0, 0, 0, 32),
	Size = UDim2.new(1, 0, 0, 20),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "Unarmed",
	TextColor3 = C.Muted,
	TextXAlignment = Enum.TextXAlignment.Right,
	TextSize = 15,
	Parent = weaponFrame,
})

-- What the held item does (#86 C14), with its standing rule (the structure cap, M13): the left of the
-- ammo row, which is empty while an item is in hand ("x3" or "RAISING" is all the right-hand side says,
-- under 130 px at 30 pt). There is no row under the item line to put it in -- the slots start 6 px
-- below it -- and a taller plate would push the whole hotbar up the screen. Two lines of 12 pt in 516
-- px hold the longest description with its cap rule. Desktop shape only: setHotbarShape hides it on a
-- phone, as it does the ammo and item lines.
do
	local itemDetail = create("TextLabel", {
		Name = "ItemDetail",
		Size = UDim2.new(1, -150, 0, 32),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = C.Muted,
		TextSize = 12,
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Left,
		Visible = false,
		Parent = weaponFrame,
	})
end

local slotRow = create("Frame", {
	Position = UDim2.new(0, 0, 0, 58),
	Size = UDim2.new(1, 0, 0, 64),
	BackgroundTransparency = 1,
	Parent = weaponFrame,
}, {
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

-- Eight slots, each holding a gun or a stack of one item. The cells are built once and updated in
-- place: loadout pushes arrive on every shot, and rebuilding the row each time recreated dozens of
-- GUI instances thirteen times a second on the chaingun.
local SLOT_COUNT = 8
local slotCells = nil

-- The item being used right now, on our clock, from the latest loadout push.
local useEndsAt, useDuration, useIndex = nil, 1, nil

-- A slot's item drawn in 3D, framed to fit. Only rebuilt when the item in the slot changes.
local function setSlotIcon(refs, itemId)
	if refs.iconId == itemId then
		return
	end
	refs.iconId = itemId
	refs.icon:ClearAllChildren()
	local model = itemId and ItemModels.Build(itemId) or nil
	if not model then
		refs.icon.Visible = false
		return
	end
	model:PivotTo(CFrame.Angles(0, math.rad(35), 0))
	model.Parent = refs.icon

	local box, size = model:GetBoundingBox()
	local radius = size.Magnitude / 2
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(box.Position + Vector3.new(0, radius * 0.35, -radius / math.tan(math.rad(20)) * 1.02), box.Position)
	camera.Parent = refs.icon
	refs.icon.CurrentCamera = camera
	refs.icon.Visible = true
end

local function buildSlotCells()
	slotCells = {}
	for index = 1, SLOT_COUNT do
		local cell = create("TextButton", {
			Size = UDim2.fromOffset(78, 64),
			BackgroundColor3 = C.Background,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ClipsDescendants = true,
			LayoutOrder = index,
			Parent = slotRow,
		}, { rounded(8) })

		local stroke = create("UIStroke", {
			Color = C.Accent,
			Thickness = 2,
			Enabled = false,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = cell,
		})

		-- Rises from the bottom while this slot's item is being used.
		local fill = create("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = C.Green,
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Visible = false,
			Parent = cell,
		})

		local icon = create("ViewportFrame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 2),
			Size = UDim2.fromOffset(44, 44),
			BackgroundTransparency = 1,
			Ambient = Color3.fromRGB(170, 170, 182),
			LightColor = Color3.fromRGB(255, 250, 240),
			LightDirection = Vector3.new(-0.4, -1, 0.6),
			Visible = false,
			Parent = cell,
		})

		local key = create("TextLabel", {
			Position = UDim2.fromOffset(5, 2),
			Size = UDim2.fromOffset(30, 14),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = tostring(index),
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextSize = 11,
			Parent = cell,
		})

		local count = create("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -5, 0, 2),
			Size = UDim2.fromOffset(44, 16),
			BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne,
			Text = "",
			TextColor3 = C.Text,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextSize = 14,
			Parent = cell,
		})

		-- Guns have no icon; their name sits in the middle of the cell instead.
		local center = create("TextLabel", {
			Position = UDim2.new(0, 4, 0, 16),
			Size = UDim2.new(1, -8, 0, 30),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = "",
			TextColor3 = C.Muted,
			TextWrapped = true,
			TextSize = 11,
			Parent = cell,
		})

		-- The tier as a letter in the bottom-right corner (#86 M4): the bar under the cell says it only in
		-- colour. C U R E L M S -- the first letters of Rarity.Order, all different. The item name beside
		-- it stops 15 px short to leave the corner clear. Both are 12 px text, the smallest the HUD uses: at
		-- 10 they were hard to read on a phone.
		local tier = create("TextLabel", {
			Name = "Tier",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -3, 1, -4),
			Size = UDim2.fromOffset(12, 14),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBlack,
			Text = "",
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextSize = 12,
			Parent = cell,
		})

		local name = create("TextLabel", {
			Position = UDim2.new(0, 3, 1, -18),
			Size = UDim2.new(1, -18, 0, 14),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = "",
			TextColor3 = C.Text,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextSize = 12,
			Parent = cell,
		})

		local bar = create("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 3),
			BackgroundColor3 = C.Muted,
			BorderSizePixel = 0,
			Visible = false,
			Parent = cell,
		})

		-- Tapping a cell holds that slot (the server checks it isn't empty); right-clicking drops
		-- what's in it at your feet.
		cell.Activated:Connect(function()
			if loadout and loadout.slots[index] and loadout.equipped ~= index then
				equipRemote:FireServer(index)
				Sfx.Play("UiClick")
			end
		end)
		cell.MouseButton2Click:Connect(function()
			if loadout and loadout.slots[index] then
				dropRemote:FireServer(index)
				Sfx.Play("UiClick", 0.08)
			end
		end)

		slotCells[index] = {
			cell = cell,
			stroke = stroke,
			fill = fill,
			icon = icon,
			key = key,
			count = count,
			center = center,
			name = name,
			bar = bar,
			tier = tier,
		}
	end
end

local function renderSlots()
	if not slotCells then
		buildSlotCells()
	end

	-- The phone hotbar has no ammo line under it (setHotbarShape hides it), so each gun cell says its
	-- reserve too (#86 C12). And the first movement item says the key that uses it without switching
	-- off your gun (#86 C18: MovementClient's quick-use, the first "movement" item in the bag), on a
	-- keyboard, where a key means something.
	local phoneShape = weaponFrame:GetAttribute("PhoneShape") == true
	local quickSlot = nil
	if UserInputService.KeyboardEnabled and loadout and loadout.slots then
		local ItemData = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("ItemData"))
		for index = 1, SLOT_COUNT do
			local slot = loadout.slots[index]
			local item = type(slot) == "table" and slot.kind == "item" and ItemData.Get(slot.id)
			if item and item.kind == "movement" then
				quickSlot = index
				break
			end
		end
	end
	for index = 1, SLOT_COUNT do
		local refs = slotCells[index]
		local slot = loadout and loadout.slots[index]
		local held = slot and loadout.equipped == index

		refs.cell.BackgroundColor3 = held and C.Panel or C.Background
		refs.cell.BackgroundTransparency = held and 0 or (slot and 0.35 or 0.6)
		refs.stroke.Enabled = held and true or false
		refs.key.Text = Settings.KeyLabel("Slot" .. index) .. (index == quickSlot and (" · " .. Settings.KeyLabel("MovementItem")) or "")
		refs.tier.Text = (slot and type(slot.rarity) == "string") and string.upper(string.sub(slot.rarity, 1, 1)) or ""
		refs.tier.TextColor3 = slot and Rarity.Color(slot.rarity) or C.Muted

		if not slot then
			setSlotIcon(refs, nil)
			refs.center.Text = ""
			refs.name.Text = ""
			refs.count.Text = ""
			refs.bar.Visible = false
		elseif slot.kind == "item" then
			setSlotIcon(refs, slot.id)
			refs.center.Text = ""
			refs.name.Text = slot.name
			refs.name.TextColor3 = Rarity.Color(slot.rarity)
			refs.count.Text = "x" .. slot.count
			refs.count.TextColor3 = C.Text
			refs.bar.Visible = true
			refs.bar.BackgroundColor3 = Rarity.Color(slot.rarity)
		else
			setSlotIcon(refs, nil)
			local empty = slot.mag == 0 and slot.reserve == 0
			refs.center.Text = (phoneShape and empty) and "NO AMMO" or slot.name
			refs.center.TextColor3 = (phoneShape and empty) and C.Red or Rarity.Color(slot.rarity)
			refs.name.Text = ""
			refs.count.Text = phoneShape and string.format("%d/%d", slot.mag, slot.reserve or 0) or tostring(slot.mag)
			refs.count.TextColor3 = slot.mag == 0 and C.Red or C.Text
			refs.bar.Visible = true
			refs.bar.BackgroundColor3 = Rarity.Color(slot.rarity)
		end
	end
end

-- "USING SHIELD POTION" with a bar and the seconds left, just under the crosshair.
local usePanel = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0.6, 0),
	Size = UDim2.fromOffset(250, 46),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.2,
	BorderSizePixel = 0,
	Visible = false,
	Parent = screenGui,
}, { rounded(10), padding(8) })

local useLabel = create("TextLabel", {
	Size = UDim2.new(1, -50, 0, 18),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = C.Text,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextTruncate = Enum.TextTruncate.AtEnd,
	TextSize = 14,
	Parent = usePanel,
})

local useTimeLabel = create("TextLabel", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, 0, 0, 0),
	Size = UDim2.fromOffset(50, 18),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "",
	TextColor3 = C.Accent,
	TextXAlignment = Enum.TextXAlignment.Right,
	TextSize = 15,
	Parent = usePanel,
})

local useTrack = create("Frame", {
	Position = UDim2.new(0, 0, 0, 22),
	Size = UDim2.new(1, 0, 0, 8),
	BackgroundColor3 = C.Panel,
	BorderSizePixel = 0,
	Parent = usePanel,
}, { rounded(4) })

local useFill = create("Frame", {
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = C.Green,
	BorderSizePixel = 0,
	Parent = useTrack,
}, { rounded(4) })

local function trackUse(newLoadout)
	local using = newLoadout and newLoadout.using
	if using then
		useEndsAt = os.clock() + using.remaining
		useDuration = math.max(using.duration, 0.05)
		useIndex = using.index
		local slot = newLoadout.slots[using.index]
		useLabel.Text = "USING " .. string.upper(slot and slot.name or "")
	else
		useEndsAt, useIndex = nil, nil
	end
end

game:GetService("RunService").RenderStepped:Connect(function()
	local remaining = useEndsAt and useEndsAt - os.clock() or 0
	local active = remaining &gt; 0 and loadout ~= nil
	local progress = active and math.clamp(1 - remaining / useDuration, 0, 1) or 0

	usePanel.Visible = active
	if active then
		useFill.Size = UDim2.fromScale(progress, 1)
		useTimeLabel.Text = string.format("%.1fs", remaining)
	end
	if slotCells then
		for index, refs in ipairs(slotCells) do
			local filling = active and index == useIndex
			refs.fill.Visible = filling
			if filling then
				refs.fill.Size = UDim2.fromScale(1, progress)
			end
		end
	end
end)

local function renderWeapon()
	if not loadout then
		weaponFrame.Visible = false
		hudLayout.show(healthFrame, false)
		showCrosshair(false)
		updateCompanionWidget()
		return
	end

	weaponFrame.Visible = true
	hudLayout.show(healthFrame, true)

	local slot = loadout.equipped and loadout.slots[loadout.equipped]
	-- The words for the slot (#86 C14 description, C39 gun type), from the inventory module, which says
	-- them in its cards too. Required here, not at the top: this chunk is close to Luau's local limit.
	local okPanel, Panel = pcall(require, script.Parent:FindFirstChild("InventoryPanel"))
	if not okPanel or type(Panel) ~= "table" or type(Panel.Describe) ~= "function" then
		Panel = nil
	end
	local itemDetail = weaponFrame:FindFirstChild("ItemDetail")
	if itemDetail then
		itemDetail.Text = (Panel and slot and slot.kind == "item") and Panel.Describe(slot) or ""
		itemDetail.Visible = itemDetail.Text ~= "" and weaponFrame:GetAttribute("PhoneShape") ~= true
	end
	if slot and slot.kind == "item" then
		-- The same "not ready yet" as a gun gets after a swap (#86 M16): a click in it is eaten.
		local raising = (loadout.equipReadyIn or 0) &gt; 0.05
		ammoText.Text = raising and "RAISING" or ("x" .. slot.count)
		ammoText.TextColor3 = raising and C.Muted or C.Text
		-- How to use it on this device (#86 M5), and why nothing happens from a driver's seat, where
		-- the server refuses it (#86 M14: ProjectileService won't let a driver throw).
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		local lastInput = UserInputService:GetLastInputType()
		local how = "click to use"
		if seat ~= nil and seat:IsA("VehicleSeat") then
			how = "hands on the wheel"
		elseif string.find(lastInput.Name, "Gamepad", 1, true) then
			how = "RT to use"
		elseif lastInput == Enum.UserInputType.Touch then
			how = "tap FIRE to use"
		end
		weaponName.Text = slot.name .. "  •  " .. how
		weaponName.TextColor3 = Rarity.Color(slot.rarity)
		showCrosshair(false)
	elseif slot then
		-- The server won't fire for a moment after a swap. Say so, or it reads as dropped input.
		local raising = (loadout.equipReadyIn or 0) &gt; 0.05
		if loadout.reloading then
			ammoText.Text = "RELOADING"
			ammoText.TextColor3 = C.Accent
		elseif raising then
			ammoText.Text = "RAISING"
			ammoText.TextColor3 = C.Muted
		elseif slot.mag == 0 and slot.reserve == 0 then
			-- Out entirely. "0 / 0" in the ordinary colour carries the same weight as "24 / 90", and
			-- a reload at zero reserve is refused SILENTLY (WeaponService.lua:1756) -- so the player
			-- presses reload, nothing happens, and nothing says why.
			ammoText.Text = "NO AMMO"
			ammoText.TextColor3 = C.Red
		elseif slot.mag == 0 then
			-- Empty magazine, ammo to load. The key is read from Settings so a rebind shows.
			ammoText.Text = string.format("0 / %d  •  [%s]", slot.reserve, Settings.KeyLabel("Reload"))
			ammoText.TextColor3 = C.Accent
		else
			ammoText.Text = string.format("%d / %d", slot.mag, slot.reserve)
			ammoText.TextColor3 = C.Text
		end
		-- What the gun's perk does, not its internal id (#86 C45).
		local abilityWords = {
			pierce = "PIERCE: through the first body",
			chain = "CHAIN: arcs to a second enemy",
			lifesteal = "LIFESTEAL: heals on hit",
			explosive = "EXPLOSIVE: splash",
			goldRush = "GOLD RUSH: kills pay coins",
		}
		-- The tier in words as well as colour (#86 M34), as the floor label already says it.
		-- And what KIND of gun it is (#86 C39), unless the name already says so ("Rot SMG").
		local typeWord = Panel and Panel.GunTypeWord(slot.name, slot.style) or nil
		weaponName.Text = (type(slot.rarity) == "string" and (string.upper(slot.rarity) .. "  ") or "") .. slot.name
			.. (typeWord and (" · " .. typeWord) or "")
			.. (slot.ability and ("  •  " .. (abilityWords[slot.ability] or slot.ability)) or "")
		weaponName.TextColor3 = Rarity.Color(slot.rarity)
		showCrosshair(true)
	else
		ammoText.Text = "--"
		ammoText.TextColor3 = C.Muted
		weaponName.Text = "Unarmed"
		weaponName.TextColor3 = C.Muted
		showCrosshair(false)
	end

	local shield = loadout.shield or 0
	shieldBar.Size = UDim2.fromScale(math.clamp(shield / (loadout.maxShield or 100), 0, 1), 1)
	healsText.Text = shield &gt; 0 and string.format("%d SHIELD", math.ceil(shield)) or ""

	renderSlots()
	updateCompanionWidget()
end

--------------------------------------------------------------------------------
-- Inventory: a tab on top of the hotbar and the panel it opens (StarterPlayerScripts/InventoryPanel)
--------------------------------------------------------------------------------

-- Rearrange the hotbar by dragging one slot onto another, or tapping one and then the other. The swap is
-- the server's (the SwapSlots remote, WeaponService.SwapSlots); the panel only shows it early. The tab
-- sits on the hotbar's top-left corner and scales with it (on a phone the layout block below turns it
-- into an icon on the grid's top-right instead); the Inventory key (B) opens it too, where there is one.
-- While it's open the mouse is freed the way the menu frees it (the MenuOpen attribute, which
-- CombatClient reads), without trampling the menu's own use of that attribute.
-- In a do-block: this script's main chunk is close to Luau's 200-local limit. The whole setup runs under
-- pcall, so if the panel module ever fails to load, the hotbar just has no tab and the rest of this
-- script carries on.
do
	local okInventory, inventoryError = pcall(function()
	local InventoryPanel = require(script.Parent:WaitForChild("InventoryPanel"))
	local MenuOpenClaims = require(script.Parent:WaitForChild("MenuOpenClaims"))
	local swapRemote = Remotes.Event("SwapSlots")

	-- Its own ScreenGui, above the HUD and the menu, keeping the top-bar inset (the panel's pointer maths
	-- relies on that).
	local inventoryGui = create("ScreenGui", {
		Name = "BrrInventory",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		DisplayOrder = 8,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})

	local releaseInventory = nil
	local panel

	-- Whether the menu's own big panel is up (a large visible Frame straight under its ScreenGui).
	local function menuPanelShowing()
		local menuGui = playerGui:FindFirstChild("BrrMenu")
		for _, child in ipairs(menuGui and menuGui:GetChildren() or {}) do
			if child:IsA("Frame") and child.Visible and child.AbsoluteSize.X &gt; 500 then
				return true
			end
		end
		return false
	end

	-- The claim's own release. It does NOT decide whether the cursor goes back: MenuOpenClaims counts
	-- every holder, so closing this while a picker still needs the cursor leaves it free, and closing
	-- it last gives it back. Releasing twice is the same as releasing once, which matters because two
	-- different paths close this panel -- closePanel for every external close, and the panel's own
	-- onClose when it closes itself.
	local function releaseMenuOpen()
		if releaseInventory then
			local release = releaseInventory
			releaseInventory = nil
			release()
		end
	end

	panel = InventoryPanel.new(inventoryGui, {
		onSwap = function(a, b)
			swapRemote:FireServer(a, b)
			Sfx.Play("UiClick", 0.08)
		end,
		onClose = function()
			releaseMenuOpen()
			Sfx.Play("UiClick", 0.08, 0.9)
		end,
		-- The same remote the hotbar's right-click has always used, so the server path is unchanged
		-- and already rate-limited; this only gives touch players and undecided desktop players a
		-- way to reach it (Oliver's #36).
		onDrop = function(index)
			dropRemote:FireServer(index)
			Sfx.Play("UiClick", 0.08, 0.8)
		end,
		keyLabel = function(index)
			return Settings.KeyLabel("Slot" .. index)
		end,
		closeKeyLabel = function()
			return Settings.KeyLabel("Inventory")
		end,
	})

	local function rescale()
		panel:SetViewport(camera.ViewportSize)
	end
	rescale()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	local function closePanel()
		if panel:IsOpen() then
			panel:Close()
			releaseMenuOpen()
		end
	end

	local function openPanel()
		if panel:IsOpen() then
			return
		end
		-- Opens even before the first loadout push (it shows eight empty slots): a key that does nothing
		-- at all reads as a broken key, and the panel is how you find out what the key even is.
		-- Not on top of the menu: that's already a modal of its own.
		if player:GetAttribute("MenuOpen") and menuPanelShowing() then
			return
		end
		-- A CLAIM, not a write. Reading the attribute to decide whether to take it is what broke:
		-- opening this under a picker's claim found it already true, so ownership was refused, and
		-- closing it later released nothing. The attribute then stayed true for the rest of the match
		-- with no owner -- inCombat() dead, cursor on screen (Oliver's #112, half of #100).
		if not releaseInventory then
			releaseInventory = MenuOpenClaims.Claim("Inventory")
		end
		panel:Open(loadout)
		Sfx.Play("UiClick", 0.08, 1.1)
	end

	local function togglePanel()
		if panel:IsOpen() then
			closePanel()
		else
			openPanel()
		end
	end

	-- The Inventory key, bound as early as possible: it is the only way in on a desktop screen (the
	-- mouse is locked to the middle in a match, so an on-screen button cannot be clicked), and binding
	-- it here means nothing built below -- the tab, its scaling, the phone layout -- can take it with
	-- it if it ever throws. Right on a gamepad's d-pad too (up and down are taken by CAM and MOVE).
	Settings.Bind("BRR_Inventory", "Inventory", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			togglePanel()
		end
		return Enum.ContextActionResult.Pass
	end, nil, Enum.KeyCode.DPadRight)

	-- The tab on the hotbar, TOUCH ONLY. On a desktop screen the inventory is a key (Inventory in
	-- Settings, B by default): the mouse is locked to the centre in a match, so an on-screen button you
	-- cannot click is worse than no button -- which is exactly how this was found. A phone has no
	-- keyboard, so there the button stays, and it is a plain HUD button rather than a
	-- ContextActionService one, so it costs nothing from the seven-button touch budget.
	-- Children of weaponFrame sit inside its 12 px padding, hence the -12s.
	local tab = create("TextButton", {
		Name = "InventoryTab",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, -12, 0, -12 - 4),
		Size = UDim2.fromOffset(176, 32),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.15,
		AutoButtonColor = false,
		Text = "",
		Visible = UserInputService.TouchEnabled,
		Parent = weaponFrame,
	}, { rounded(10) })
	-- A tablet that gains or loses a touch screen mid-session is rare, but the property is watchable.
	UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(function()
		tab.Visible = UserInputService.TouchEnabled
	end)
	local tabStroke = create("UIStroke", { Color = C.Panel, Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = tab })
	for row = 0, 1 do
		for column = 0, 1 do
			create("Frame", {
				Position = UDim2.fromOffset(11 + column * 8, 8 + row * 8),
				Size = UDim2.fromOffset(6, 6),
				BackgroundColor3 = C.Accent,
				BorderSizePixel = 0,
				Parent = tab,
			}, { rounded(2) })
		end
	end
	local tabLabel = create("TextLabel", {
		Position = UDim2.fromOffset(34, 0),
		Size = UDim2.new(1, -76, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = "INVENTORY",
		TextColor3 = C.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = tab,
	})
	local tabKey = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(30, 20),
		BackgroundColor3 = C.PanelAlt,
		Font = Enum.Font.GothamBold,
		Text = Settings.KeyLabel("Inventory"),
		TextColor3 = C.Muted,
		TextSize = 12,
		Parent = tab,
	}, { rounded(6) })
	-- A phone has no B key to press, so the key badge only shows where a keyboard exists (a tablet with
	-- one plugged in later counts, hence the property signal); the label takes the freed room.
	-- THREE devices. `KeyboardEnabled or not TouchEnabled` answers TRUE on a console, where neither
	-- flag is set, so a pad player was shown a KEYBOARD key for a control that is actually D-Pad
	-- Right. That is the worse half of this bug's family: the same two-device assumption spelled the
	-- other way round fails by confidently showing the wrong thing rather than by showing nothing,
	-- and a wrong label looks like a feature where a missing one looks like a bug.
	--
	-- On a pad the badge is HIDDEN rather than relabelled, deliberately and temporarily: `tabKey` is
	-- a fixed 30x20 box sized for "Tab", and "D-Pad R" in it is the clipped chip of #129 again. The
	-- CONTROLS legend names the control in the meantime, so nothing is unreachable — only unlabelled
	-- here. The badge comes back with a measured width in the next render batch.
	local function fitTabKey()
		local onPad = string.find(UserInputService:GetLastInputType().Name, "Gamepad", 1, true) ~= nil
		local hasKeyboard = not onPad and (UserInputService.KeyboardEnabled or not UserInputService.TouchEnabled)
		tabKey.Visible = hasKeyboard
		tabKey.Text = hasKeyboard and Settings.KeyLabel("Inventory") or ""
		tabLabel.Size = UDim2.new(1, hasKeyboard and -76 or -44, 1, 0)
	end
	UserInputService.LastInputTypeChanged:Connect(fitTabKey)
	fitTabKey()
	Settings.Changed:Connect(fitTabKey)
	UserInputService:GetPropertyChangedSignal("KeyboardEnabled"):Connect(fitTabKey)
	tab.MouseEnter:Connect(function()
		tabStroke.Color = C.Accent
	end)
	tab.MouseLeave:Connect(function()
		tabStroke.Color = C.Panel
	end)
	tab.Activated:Connect(togglePanel)

	-- The tab shrinks with the hotbar, but never below 0.8 of its size (1.0 on a touch screen, where it's
	-- a finger's target): its own UIScale makes up the difference, growing it upward off its bottom edge.
	local tabScale = create("UIScale", { Parent = tab })
	local function fitTab()
		local hotbarScale = weaponFrame:GetAttribute("HotbarScale") or 1
		local least = UserInputService.TouchEnabled and 1 or 0.8
		tabScale.Scale = math.max(1, least / math.max(hotbarScale, 0.01))
	end
	fitTab()
	weaponFrame:GetAttributeChangedSignal("HotbarScale"):Connect(fitTab)

	-- The menu and quest keys open the menu: the inventory gets out of its way first.
	UserInputService.InputBegan:Connect(function(input)
		if panel:IsOpen() and (input.KeyCode == Settings.Key("Menu") or input.KeyCode == Settings.Key("Quests")) then
			closePanel()
		end
	end)

	-- Every push is the truth; no loadout (eliminated, match over) closes it.
	loadoutChanged.OnClientEvent:Connect(function(newLoadout)
		panel:SetLoadout(newLoadout)
		if not newLoadout then
			closePanel()
		end
	end)
	end)
	if not okInventory then
		warn("[HudClient] the Inventory panel didn't load; the hotbar has no Inventory tab: " .. tostring(inventoryError))
	end
end

--------------------------------------------------------------------------------
-- Health tracking
--------------------------------------------------------------------------------

local function watchHumanoid(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end

	local function update()
		local ratio = humanoid.MaxHealth &gt; 0 and humanoid.Health / humanoid.MaxHealth or 0
		healthText.Text = string.format("%d", math.ceil(humanoid.Health))
		healthBar.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
		local color = ratio &gt; 0.5 and C.Green or (ratio &gt; 0.25 and C.Accent or C.Red)
		healthText.TextColor3 = color
		healthBar.BackgroundColor3 = color
	end

	humanoid:GetPropertyChangedSignal("Health"):Connect(update)
	humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(update)
	update()
end

if player.Character then
	task.spawn(watchHumanoid, player.Character)
end
player.CharacterAdded:Connect(watchHumanoid)

--------------------------------------------------------------------------------
-- Storm readout
--------------------------------------------------------------------------------

local stormLabel = create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 72),
	Size = UDim2.new(0, 440, 0, 24),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = C.Storm,
	TextSize = 15,
	Parent = screenGui,
})

-- `stormState` is declared up in "Screen-edge state", which reads it every frame.
stormState = nil

stormChanged.OnClientEvent:Connect(function(storm)
	stormState = storm.status ~= "Idle" and storm or nil

	if not stormState then
		stormLabel.Text = ""
		return
	end

	-- A STATIC boundary says nothing here. StormService.StartStatic (:140) -- which GameMode:418
	-- calls for every team mode -- sends `label` ("Stay in the arena") precisely because the phase
	-- countdown "means nothing for a circle that never moves" (StormService.lua:90-92). Nothing read
	-- it, so a whole team match showed "Storm moves in 0s   •   Zone 0/5   •   4 dmg/s": a countdown
	-- at zero, a phase that does not exist and a storm that is not coming.
	--
	-- The readout's job is to report what CHANGES -- when the next shrink lands and how much it
	-- hurts. In a team mode nothing changes, so a permanent line reporting a constant is furniture,
	-- not information, and it also sat in ModeScoreHud's slot at y=72. The boundary is still told
	-- twice where it matters: the minimap's zone ring draws it continuously, and the vignette plus
	-- OUTSIDE THE ZONE say "you are outside it, now".
	if storm.label then
		stormLabel.Text = ""
		return
	end

	-- The last circle does not move again, so "Storm moves in 0s" was a countdown to nothing (#86 C22);
	-- and "Zone 2/5" read as jargon: it is which circle of how many.
	if storm.status == "Final" then
		stormLabel.Text = string.format("Final circle   •   outside: %d dmg/s", storm.damagePerSecond)
		return
	end
	local verb = storm.status == "Shrinking" and "Storm closing" or "Storm moves in"
	stormLabel.Text = string.format("%s  %ds   •   Circle %d of %d   •   outside: %d dmg/s",
		verb, storm.secondsLeft, storm.phase, storm.totalPhases, storm.damagePerSecond)
end)

--------------------------------------------------------------------------------
-- Minimap
--------------------------------------------------------------------------------

local MAP_PX = 190

local minimap = create("Frame", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -16, 0, 108),
	Size = UDim2.fromOffset(MAP_PX, MAP_PX),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.25,
	BorderSizePixel = 0,
	ClipsDescendants = true,
	Visible = false,
	Parent = screenGui,
}, {
	rounded(math.floor(MAP_PX / 2)),
	create("UIStroke", { Color = C.Panel, Thickness = 2 }),
})

-- Safe zone: a circle sized and positioned in map space.
local zoneRing = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Parent = minimap,
}, {
	create("UICorner", { CornerRadius = UDim.new(1, 0) }),
	create("UIStroke", { Color = C.Storm, Thickness = 2, Transparency = 0.15 }),
})

local targetRing = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Parent = minimap,
}, {
	create("UICorner", { CornerRadius = UDim.new(1, 0) }),
	create("UIStroke", { Color = C.Accent, Thickness = 1, Transparency = 0.45 }),
})

local playerDot = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Size = UDim2.fromOffset(8, 8),
	BackgroundColor3 = C.Green,
	BorderSizePixel = 0,
	Parent = minimap,
}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

local dropDot = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Size = UDim2.fromOffset(10, 10),
	BackgroundColor3 = C.Accent,
	BorderSizePixel = 0,
	Rotation = 45,
	Visible = false,
	Parent = minimap,
})

--------------------------------------------------------------------------------
-- Drop selection
--
-- Once the map is built, the server holds for MatchConfig.DropSelectSeconds and broadcasts
-- `dropSelect`. Click the map to pick where to land; pick nothing and you keep the spawn the
-- spiral gave you, which is the old random behaviour unchanged. Shown only to people the match is
-- about to place — anyone readied up when loading began — though the server is the real gate and
-- rejects a pick from anyone else regardless.
--------------------------------------------------------------------------------

-- Everything this screen needs lives inside the do-block below, so it costs the main chunk one
-- local instead of ten. Luau allows 200 locals per function, the top level of this file was
-- already at 192, and the first version of this screen took it to 202 -- at which point the whole
-- script silently stopped compiling. Neither verify.py nor balance.py can see that: it isn't a
-- structural imbalance, it's a compiler limit. Locals declared in a do-block are released at its
-- end, so only `Drop` survives into the main chunk. The body is left unindented on purpose;
-- re-indenting two hundred lines to suit the block would bury the actual change.
local Drop = {}
do

local chooseDrop = Remotes.Event("ChooseDrop")
local DROP_PX = 440

local dropScreen = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(DROP_PX + 40, DROP_PX + 96),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.06,
	BorderSizePixel = 0,
	Visible = false,
	ZIndex = 40,
	Parent = screenGui,
}, {
	rounded(18),
	create("UIStroke", { Color = C.Accent, Thickness = 2 }),
})

-- 480x536 is taller than a phone screen, which would take the map and the CONFIRM row off the bottom:
-- PhoneLayout.FitPanel shrinks it to fit, and leaves it exactly as it is on any screen with the room.
pcall(function()
	require(script.Parent:WaitForChild("PhoneLayout")).FitPanel(dropScreen, Vector2.new(DROP_PX + 40, DROP_PX + 96))
end)

create("TextLabel", {
	Position = UDim2.new(0, 22, 0, 14),
	Size = UDim2.new(1, -44, 0, 24),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	Text = "CHOOSE YOUR DROP",
	TextColor3 = C.Accent,
	TextSize = 19,
	TextXAlignment = Enum.TextXAlignment.Left,
	ZIndex = 41,
	Parent = dropScreen,
})

local dropClock = create("TextLabel", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -22, 0, 12),
	Size = UDim2.fromOffset(60, 28),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	Text = "15",
	TextColor3 = C.Text,
	TextSize = 24,
	TextXAlignment = Enum.TextXAlignment.Right,
	ZIndex = 41,
	Parent = dropScreen,
})

local dropHint = create("TextLabel", {
	Position = UDim2.new(0, 22, 0, 38),
	Size = UDim2.new(1, -44, 0, 18),
	BackgroundTransparency = 1,
	Font = Enum.Font.Gotham,
	Text = "Click the map to pick a landing spot",
	TextColor3 = C.Muted,
	TextSize = 13,
	TextXAlignment = Enum.TextXAlignment.Left,
	ZIndex = 41,
	Parent = dropScreen,
})

local dropMap = create("TextButton", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 62),
	Size = UDim2.fromOffset(DROP_PX, DROP_PX),
	BackgroundColor3 = C.Panel,
	BorderSizePixel = 0,
	AutoButtonColor = false,
	Text = "",
	ClipsDescendants = true,
	ZIndex = 41,
	Parent = dropScreen,
}, {
	rounded(math.floor(DROP_PX / 2)),
	create("UIStroke", { Color = C.PanelAlt, Thickness = 2 }),
})

local dropMarker = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Size = UDim2.fromOffset(13, 13),
	BackgroundColor3 = C.Accent,
	BorderSizePixel = 0,
	Rotation = 45,
	Visible = false,
	ZIndex = 44,
	Parent = dropMap,
})

-- Town and landmark markers, rebuilt each time the window opens because the map is new every
-- match. Read off the same attributes the minimap and the compass use.
local dropPins = {}

local function refreshDropMap()
	for _, pin in ipairs(dropPins) do
		pin:Destroy()
	end
	table.clear(dropPins)

	local map = workspace:FindFirstChild("Map")
	local radius = matchState and matchState.mapRadius or 0
	if not map or radius &lt;= 0 then
		return
	end
	local scale = (DROP_PX / 2) / radius

	local function pin(center, name, color, dotSize)
		local dot = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, center.X * scale, 0.5, center.Z * scale),
			Size = UDim2.fromOffset(dotSize, dotSize),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = 42,
			Parent = dropMap,
		}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		table.insert(dropPins, dot)
		if name then
			table.insert(dropPins, create("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, center.X * scale, 0.5, center.Z * scale + 6),
				Size = UDim2.fromOffset(130, 13),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				Text = name,
				TextColor3 = color,
				TextStrokeTransparency = 0.5,
				TextSize = 11,
				ZIndex = 43,
				Parent = dropMap,
			}))
		end
	end

	for _, child in ipairs(map:GetChildren()) do
		local center = child:GetAttribute("TownCenter")
		if center then
			pin(center, child:GetAttribute("TownName"), C.Text, 9)
		end
	end
	local landmarks = map:FindFirstChild("Landmarks")
	if landmarks then
		for _, child in ipairs(landmarks:GetChildren()) do
			local center = child:GetAttribute("LandmarkCenter")
			if center then
				pin(center, child:GetAttribute("LandmarkName"), C.Accent, 8)
			end
		end
	end
end

dropMap.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	local radius = matchState and matchState.mapRadius or 0
	if not dropScreen.Visible or radius &lt;= 0 then
		return
	end

	local size, origin = dropMap.AbsoluteSize, dropMap.AbsolutePosition
	local px = input.Position.X - origin.X - size.X / 2
	local py = input.Position.Y - origin.Y - size.Y / 2

	-- Pixels back into studs: the disc's half-width is the map's radius.
	local scale = radius / math.max(size.X / 2, 1)
	local worldX, worldZ = px * scale, py * scale

	-- Held inside the playable disc, to the same limit the server uses. The marker follows the
	-- clamped point, so it shows where you will actually land rather than where you clicked.
	local limit = radius * 0.96
	local distance = math.sqrt(worldX * worldX + worldZ * worldZ)
	if distance &gt; limit then
		local pull = limit / math.max(distance, 1)
		worldX, worldZ = worldX * pull, worldZ * pull
		px, py = worldX / scale, worldZ / scale
	end

	chooseDrop:FireServer(worldX, worldZ)
	dropMarker.Position = UDim2.new(0.5, px, 0.5, py)
	dropMarker.Visible = true
	dropHint.Text = "Landing here. Click again to move it."
	dropHint.TextColor3 = C.Green
end)

function Drop.update()
	-- Superseded by StarterPlayerScripts/DropPicker.lua, which draws the real terrain and keeps
	-- this screen's modal-overlay cursor fix. Held at false rather than deleted so the old screen
	-- is one line away if the new one ever has to be pulled.
	local active = false
	if active and not dropScreen.Visible then
		-- A fresh window: drop last match's pick and redraw for the new map.
		dropMarker.Visible = false
		dropHint.Text = "Click the map to pick a landing spot"
		dropHint.TextColor3 = C.Muted
		refreshDropMap()
	end
	dropScreen.Visible = active
	if active then
		dropClock.Text = tostring(matchState.countdown or 0)
	end
end

end
-- End of the drop screen's block; its locals are released here.

-- The bounty on the match's kill leader, under the minimap.

local bountyLabel = create("TextLabel", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -16, 0, 108 + MAP_PX + 6),
	Size = UDim2.fromOffset(MAP_PX + 40, 22),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.25,
	BorderSizePixel = 0,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = C.Accent,
	TextTruncate = Enum.TextTruncate.AtEnd,
	TextSize = 12,
	Visible = false,
	Parent = screenGui,
}, { rounded(8) })

-- Town names, so "rotate toward Aura Farms" means something. Towns carry their centre and name
-- as attributes (MapGenerator), which replicate even while the town itself is streamed out.
-- Markers sit beneath the zone rings and dots, and are refreshed every couple of seconds —
-- only rebuilt when the set of towns changes, never per frame.
local townMarkers = {}

-- The river, drawn once per map from the Map folder's RiverPath attribute ("x,z;x,z;…").
local riverLines = {}
local riverKey = nil

local function refreshRiver(map, radius, scale)
	local path = map and radius and map:GetAttribute("RiverPath") or nil
	local key = path and (path .. "@" .. tostring(radius)) or nil
	if key == riverKey then
		return
	end
	riverKey = key
	for _, line in ipairs(riverLines) do
		line:Destroy()
	end
	riverLines = {}
	if not path then
		return
	end
	local points = {}
	for pair in string.gmatch(path, "[^;]+") do
		local x, z = string.match(pair, "(-?%d+),(-?%d+)")
		if x and z then
			table.insert(points, Vector2.new(tonumber(x), tonumber(z)))
		end
	end
	for index = 1, #points - 1 do
		local a, b = points[index] * scale, points[index + 1] * scale
		local delta = b - a
		local mid = (a + b) / 2
		table.insert(riverLines, create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, mid.X, 0.5, mid.Y),
			Size = UDim2.fromOffset(math.ceil(delta.Magnitude) + 2, 3),
			Rotation = math.deg(math.atan2(delta.Y, delta.X)),
			BackgroundColor3 = Color3.fromRGB(80, 150, 230),
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			ZIndex = 0,
			Parent = minimap,
		}, { rounded(2) }))
	end
end

local function refreshTownMarkers()
	local radius = matchState.mapRadius
	local map = workspace:FindFirstChild("Map")
	local seen = {}

	-- Landmarks (MapGenerator's Landmarks folder) are marked the same way, in gold.
	local function consider(child, centerAttribute, nameAttribute, color, scale)
		local center = child:GetAttribute(centerAttribute)
		local name = child:GetAttribute(nameAttribute)
		if not center or not name then
			return
		end
		seen[child] = true
		local marker = townMarkers[child]
		if not marker then
			-- 12 px names (9 was unreadable) in a box wide enough for most on one line; a long one
			-- ("Grass Toucher's Rest") wraps onto a second line under the first rather than spilling sideways.
			marker = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(112, 22),
				BackgroundTransparency = 1,
				ZIndex = 0,
				Parent = minimap,
			})
			create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 0),
				Size = UDim2.fromOffset(5, 5),
				BackgroundColor3 = color,
				BackgroundTransparency = 0.2,
				BorderSizePixel = 0,
				ZIndex = 0,
				Parent = marker,
			}, { rounded(3) })
			create("TextLabel", {
				Position = UDim2.new(0, 0, 0, 6),
				Size = UDim2.new(1, 0, 0, 14),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				Text = name,
				TextColor3 = color,
				TextStrokeTransparency = 0.6,
				TextWrapped = true,
				TextSize = 12,
				ZIndex = 0,
				Parent = marker,
			})
			townMarkers[child] = marker
		end
		-- The dot is at the top of the marker; shift down so the dot, not the label, sits on
		-- the spot.
		marker.Position = UDim2.new(0.5, center.X * scale, 0.5, center.Z * scale + 8)
	end

	if matchState.state == "InProgress" and radius and radius &gt; 0 and map then
		local scale = (MAP_PX / 2) / radius
		refreshRiver(map, radius, scale)
		for _, child in ipairs(map:GetChildren()) do
			consider(child, "TownCenter", "TownName", C.Muted, scale)
		end
		local landmarks = map:FindFirstChild("Landmarks")
		if landmarks then
			for _, child in ipairs(landmarks:GetChildren()) do
				consider(child, "LandmarkCenter", "LandmarkName", C.Accent, scale)
			end
		end
	else
		refreshRiver(nil)
	end

	for town, marker in pairs(townMarkers) do
		if not seen[town] then
			marker:Destroy()
			townMarkers[town] = nil
		end
	end

	-- No two names printed over each other on the minimap (Oliver's 16:58 screenshot: BONKINGTON
	-- across GRASS TOUCHER'S REST, THE BEACHED GALLEON across a town). Landmarks first, then towns;
	-- a name that would overlap one already shown is hidden and its dot stays.
	local ordered = {}
	for owner, marker in pairs(townMarkers) do
		table.insert(ordered, { marker = marker, landmark = owner:GetAttribute("LandmarkCenter") ~= nil })
	end
	table.sort(ordered, function(a, b)
		if a.landmark ~= b.landmark then
			return a.landmark
		end
		return a.marker.Position.Y.Offset &lt; b.marker.Position.Y.Offset
	end)
	local shown = {}
	for _, entry in ipairs(ordered) do
		local label = entry.marker:FindFirstChildOfClass("TextLabel")
		if label then
			local x, y = entry.marker.Position.X.Offset, entry.marker.Position.Y.Offset - 5
			local half = math.min(label.TextBounds.X, 84) / 2 + 2
			local free = true
			for _, box in ipairs(shown) do
				if math.abs(box.x - x) &lt; box.half + half and math.abs(box.y - y) &lt; 12 then
					free = false
					break
				end
			end
			label.Visible = free
			if free then
				table.insert(shown, { x = x, y = y, half = half })
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Compass
--
-- A strip under the storm readout showing which way you're looking. The cardinal points, the
-- towns (grey) and landmarks (gold) — read off the same attributes the minimap uses — the safe
-- zone's centre and the live supply drop slide along it as you turn; 180 degrees of view fit
-- across the strip. The "Compass" setting turns it off.
--------------------------------------------------------------------------------

local COMPASS_W, COMPASS_H = 440, 24
local COMPASS_SPAN = 180 -- degrees across the strip

local compass = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 104),
	Size = UDim2.fromOffset(COMPASS_W, COMPASS_H),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.35,
	BorderSizePixel = 0,
	ClipsDescendants = true,
	Visible = false,
	Parent = screenGui,
}, {
	rounded(8),
	-- The notch: where you're looking.
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(2, 7),
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		ZIndex = 2,
	}),
})

-- key -&gt; { frame, label, dot, bearing (cardinals) | position (places) }. Keyed by the town or
-- landmark instance, or a string for the cardinals, the zone and the drop.
local compassMarkers = {}

local function compassMarker(key, text, color, kind)
	local marker = compassMarkers[key]
	if marker then
		if marker.label.Text ~= text then
			marker.label.Text = text
		end
		if marker.label.TextColor3 ~= color then
			marker.label.TextColor3 = color
			if marker.dot then
				marker.dot.BackgroundColor3 = color
			end
		end
		return marker
	end

	local frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(96, COMPASS_H),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = compass,
	})
	local label, dot
	if kind == "cardinal" then
		label = create("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne,
			Text = text,
			TextColor3 = color,
			TextSize = #text &gt; 1 and 11 or 15,
			Parent = frame,
		})
	else
		dot = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 3),
			Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = color,
			BackgroundTransparency = kind == "zone" and 1 or 0.15,
			BorderSizePixel = 0,
			Rotation = kind == "drop" and 45 or 0,
			Parent = frame,
		})
		if kind == "zone" then
			create("UIStroke", { Color = color, Thickness = 2, Parent = dot })
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = dot })
		elseif kind ~= "drop" then
			create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = dot })
		end
		-- 12 px (9 was unreadable), filling the strip under the dot to its bottom edge. The box is as wide
		-- as the longest name ("GRASS TOUCHER'S REST" is about 150 px at this size); the de-clutter pass below
		-- hides a name that would print over another, by its TextBounds.
		label = create("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 10),
			Size = UDim2.fromOffset(180, COMPASS_H - 10),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = text,
			TextColor3 = color,
			TextStrokeTransparency = 0.6,
			TextSize = 12,
			Parent = frame,
		})
	end
	marker = { frame = frame, label = label, dot = dot }
	compassMarkers[key] = marker
	return marker
end

for _, cardinal in ipairs({ { "N", 0 }, { "NE", 45 }, { "E", 90 }, { "SE", 135 }, { "S", 180 }, { "SW", 225 }, { "W", 270 }, { "NW", 315 } }) do
	local color = cardinal[1] == "N" and C.Accent or (#cardinal[1] &gt; 1 and C.Muted or C.Text)
	compassMarker("cardinal:" .. cardinal[1], cardinal[1], color, "cardinal").bearing = cardinal[2]
end

-- Towns and landmarks come and go with the map; refreshed alongside the minimap markers.
local function refreshCompassPlaces()
	local map = workspace:FindFirstChild("Map")
	local seen = {}
	local function consider(child, centerAttribute, nameAttribute, color)
		local center = child:GetAttribute(centerAttribute)
		local name = child:GetAttribute(nameAttribute)
		if center and name then
			compassMarker(child, string.upper(name), color, "place").position = center
			seen[child] = true
		end
	end
	if map and matchState.state == "InProgress" then
		for _, child in ipairs(map:GetChildren()) do
			consider(child, "TownCenter", "TownName", C.Muted)
		end
		local landmarks = map:FindFirstChild("Landmarks")
		if landmarks then
			for _, child in ipairs(landmarks:GetChildren()) do
				consider(child, "LandmarkCenter", "LandmarkName", C.Accent)
			end
		end
	end
	for key, marker in pairs(compassMarkers) do
		if typeof(key) == "Instance" and not seen[key] then
			marker.frame:Destroy()
			compassMarkers[key] = nil
		end
	end
end

-- Bearings: 0 is north (−Z, up on the minimap), 90 east (+X).
local function bearingTo(from, to)
	return math.deg(math.atan2(to.X - from.X, -(to.Z - from.Z)))
end

local function placeCompassMarker(marker, bearing, heading)
	local delta = (bearing - heading + 540) % 360 - 180
	if math.abs(delta) &gt; COMPASS_SPAN / 2 + 8 then
		marker.frame.Visible = false
		return
	end
	marker.frame.Visible = true
	marker.x = COMPASS_W / 2 + delta * (COMPASS_W / COMPASS_SPAN)
	marker.delta = delta
	marker.frame.Position = UDim2.fromOffset(marker.x, 0)
	-- Fading out toward the ends of the strip.
	marker.label.TextTransparency = math.clamp((math.abs(delta) - (COMPASS_SPAN / 2 - 28)) / 28, 0, 1) * 0.85
end

local function updateCompass(root)
	if not root or not Settings.Get("Compass") then
		hudLayout.show(compass, false)
		return
	end
	hudLayout.show(compass, true)
	-- Always flush under whatever the top-centre HUD is showing right now (Oliver 17:16): the players-
	-- alive banner, the storm line under it, or a team mode's score bar -- measured off what is actually
	-- on screen, so it follows any of them changing size, hiding or scaling. A phone layout places the
	-- compass itself and is left alone.
	if not compass:GetAttribute("PhonePlaced") then
		local bottom = nil
		local function under(gui)
			if gui and gui.Visible and gui.AbsoluteSize.Y &gt; 0 then
				local edge = gui.AbsolutePosition.Y + gui.AbsoluteSize.Y
				bottom = bottom and math.max(bottom, edge) or edge
			end
		end
		under(banner)
		if stormLabel.Text ~= "" then
			under(stormLabel)
		end
		local scoreGui = playerGui:FindFirstChild("ModeScoreHud")
		if scoreGui and scoreGui.Enabled then
			under(scoreGui:FindFirstChild("Scoreline"))
		end
		local y = math.floor((bottom and (bottom - screenGui.AbsolutePosition.Y) or 6) + 4 + 0.5)
		if compass.Position.Y.Offset ~= y or compass.Position.Y.Scale ~= 0 then
			compass.Position = UDim2.new(0.5, 0, 0, y)
		end
	end
	local look = camera.CFrame.LookVector
	local heading = math.deg(math.atan2(look.X, -look.Z))
	local here = root.Position

	for _, marker in pairs(compassMarkers) do
		if marker.bearing then
			placeCompassMarker(marker, marker.bearing, heading)
		elseif marker.position then
			placeCompassMarker(marker, bearingTo(here, marker.position), heading)
		end
	end

	-- No two labels on top of each other (Oliver's 16:58 screenshot: THE BEACON and BRAINROT CARNIVAL
	-- printed over one another, with the N across LAG LAGOON). The cardinals keep theirs; then each
	-- place, the one nearest the middle of the strip first, shows its name only where it clears every
	-- label already shown. A place whose name doesn't fit still shows its dot.
	local taken = {}
	local function clear(x, width)
		for _, span in ipairs(taken) do
			if x + width / 2 &gt; span[1] and x - width / 2 &lt; span[2] then
				return false
			end
		end
		return true
	end
	local places = {}
	for _, marker in pairs(compassMarkers) do
		if marker.frame.Visible and marker.x then
			if marker.bearing then
				local width = marker.label.TextBounds.X + 6
				table.insert(taken, { marker.x - width / 2, marker.x + width / 2 })
			elseif marker.position then
				table.insert(places, marker)
			end
		end
	end
	table.sort(places, function(a, b)
		return math.abs(a.delta) &lt; math.abs(b.delta)
	end)
	for _, marker in ipairs(places) do
		local width = math.max(marker.label.TextBounds.X, 8) + 6
		local fits = clear(marker.x, width)
		marker.label.Visible = fits
		if fits then
			table.insert(taken, { marker.x - width / 2, marker.x + width / 2 })
		end
	end

	-- The zone (where it's heading, once it's moving) and the live drop are placed every frame,
	-- since they move.
	if stormState and stormState.center then
		local moving = stormState.status == "Shrinking" or stormState.status == "Waiting"
		local target = moving and stormState.targetCenter or stormState.center
		placeCompassMarker(compassMarker("zone", "ZONE", C.Storm, "zone"), bearingTo(here, target), heading)
	elseif compassMarkers.zone then
		compassMarkers.zone.frame.Visible = false
	end
	if activeDrop and activeDrop.position then
		local marker = compassMarker("drop", "DROP", Rarity.Color(activeDrop.rarity), "drop")
		placeCompassMarker(marker, bearingTo(here, activeDrop.position), heading)
	elseif compassMarkers.drop then
		compassMarkers.drop.frame.Visible = false
	end
	-- King of the Hill's objectives by letter (#86 C34): nothing on the HUD pointed at them. The mode
	-- builds each as workspace.Hill.Objective&lt;letter&gt; with its centre as HillX / HillZ
	-- (ModeKingOfTheHill.buildObjective), and takes the model down with the match.
	local hill = workspace:FindFirstChild("Hill")
	for _, letter in ipairs({ "A", "B" }) do
		local key = "objective:" .. letter
		local folder = hill and hill:FindFirstChild("Objective" .. letter)
		local x = folder and folder:GetAttribute("HillX")
		local z = folder and folder:GetAttribute("HillZ")
		if x and z then
			-- In the owner's colour (the pillar ModeKingOfTheHill paints) and with how far off it is, so the
			-- strip says which one to go for, not only where they are.
			local pillar = folder:FindFirstChild("HillPillar")
			local target = Vector3.new(x, here.Y, z)
			local text = string.format("%s %dm", letter, math.floor((target - here).Magnitude / 3.57 + 0.5))
			placeCompassMarker(compassMarker(key, text, pillar and pillar.Color or C.Accent, "zone"), bearingTo(here, target), heading)
		elseif compassMarkers[key] then
			compassMarkers[key].frame.Visible = false
		end
	end
end

task.spawn(function()
	while true do
		refreshTownMarkers()
		refreshCompassPlaces()
		task.wait(2)
	end
end)

-- Where you are: the town or landmark you're in, under the minimap, and a big "ENTERING …" that
-- fades in and out when it changes. Read off the same attributes the markers use.
local locationLabel = create("TextLabel", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -16, 0, 108 + MAP_PX + 34),
	Size = UDim2.fromOffset(MAP_PX + 40, 20),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = C.Text,
	TextStrokeTransparency = 0.5,
	TextXAlignment = Enum.TextXAlignment.Right,
	TextSize = 13,
	Parent = screenGui,
})

local enteringLabel = create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.24),
	Size = UDim2.fromOffset(600, 44),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "",
	TextColor3 = C.Accent,
	TextStrokeTransparency = 0.3,
	TextTransparency = 1,
	TextSize = 34,
	Parent = screenGui,
})

local currentLocation = nil
local enteringToken = 0

local function locationHere()
	local map = workspace:FindFirstChild("Map")
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not map or not root or matchState.state ~= "InProgress" then
		return nil
	end
	local radius = matchState.mapRadius or 900
	local townReach = math.max(110, radius * 0.17) + 30
	local here = root.Position
	local best, bestDistance = nil, math.huge

	local function consider(child, centerAttribute, nameAttribute, reach, color)
		local center = child:GetAttribute(centerAttribute)
		local name = child:GetAttribute(nameAttribute)
		if center and name then
			local distance = (Vector3.new(center.X, 0, center.Z) - Vector3.new(here.X, 0, here.Z)).Magnitude
			if distance &lt; reach and distance &lt; bestDistance then
				best, bestDistance = { name = name, color = color }, distance
			end
		end
	end

	for _, child in ipairs(map:GetChildren()) do
		consider(child, "TownCenter", "TownName", townReach, C.Text)
	end
	local landmarks = map:FindFirstChild("Landmarks")
	if landmarks then
		for _, child in ipairs(landmarks:GetChildren()) do
			consider(child, "LandmarkCenter", "LandmarkName", 75, C.Accent)
		end
	end
	return best
end

task.spawn(function()
	while true do
		task.wait(1)
		local location = locationHere()
		local name = location and location.name or nil
		if name ~= currentLocation then
			currentLocation = name
			locationLabel.Text = name and string.upper(name) or ""
			locationLabel.TextColor3 = location and location.color or C.Text
			if name then
				enteringToken += 1
				local token = enteringToken
				enteringLabel.Text = "ENTERING " .. string.upper(name)
				enteringLabel.TextColor3 = location.color
				enteringLabel.TextTransparency = 1
				TweenService:Create(enteringLabel, TweenInfo.new(0.3), { TextTransparency = 0 }):Play()
				task.delay(2.4, function()
					if token == enteringToken then
						TweenService:Create(enteringLabel, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
					end
				end)
			end
		end
	end
end)

RunService.RenderStepped:Connect(function()
	local radius = matchState.mapRadius
	-- The map and compass are for the match's own players: someone with a loadout, or someone
	-- eliminated and spectating (MatchService keeps `InMatch` true for them until they leave the
	-- match). A lobby player during a match (joined late, or never readied) has neither, and was
	-- shown a map of an arena they are not in.
	if matchState.state ~= "InProgress" or not radius or radius &lt;= 0
		or not (loadout or player:GetAttribute("InMatch") == true) then
		hudLayout.show(minimap, false)
		hudLayout.show(compass, false)
		return
	end

	hudLayout.show(minimap, true)
	local scale = (MAP_PX / 2) / radius

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		playerDot.Visible = true
		playerDot.Position = UDim2.new(0.5, root.Position.X * scale, 0.5, root.Position.Z * scale)
	else
		playerDot.Visible = false
	end
	updateCompass(root)

	if activeDrop and activeDrop.position then
		dropDot.Visible = true
		dropDot.BackgroundColor3 = Rarity.Color(activeDrop.rarity)
		dropDot.Position = UDim2.new(0.5, activeDrop.position.X * scale, 0.5, activeDrop.position.Z * scale)
	else
		dropDot.Visible = false
	end

	-- The readout is cleared here rather than beside the vignette, because `stormLabel` is declared
	-- below that loop: referencing it there compiles as a nil global and only fails when it runs.
	if matchState.state == "InProgress" and not loadout and stormLabel.Text ~= "" then
		stormLabel.Text = ""
	end

	if stormState and not (matchState.state == "InProgress" and not loadout) then
		local size = math.max(4, stormState.radius * 2 * scale)
		zoneRing.Size = UDim2.fromOffset(size, size)
		zoneRing.Position = UDim2.new(0.5, stormState.center.X * scale, 0.5, stormState.center.Z * scale)
		zoneRing.Visible = true

		-- Where it's heading, so you can rotate before it starts moving.
		local shrinking = stormState.status == "Shrinking" or stormState.status == "Waiting"
		if shrinking and stormState.targetRadius then
			local targetSize = math.max(4, stormState.targetRadius * 2 * scale)
			targetRing.Size = UDim2.fromOffset(targetSize, targetSize)
			targetRing.Position = UDim2.new(0.5, stormState.targetCenter.X * scale, 0.5, stormState.targetCenter.Z * scale)
			targetRing.Visible = true
		else
			targetRing.Visible = false
		end
	else
		zoneRing.Visible = false
		targetRing.Visible = false
	end
end)

--------------------------------------------------------------------------------
-- Kill feed
--------------------------------------------------------------------------------

-- Under the location line, not beside it (#80): at y 312 the first row (312-336) lay across the bounty
-- line (304-326) and the location line (332-352), which sit under the minimap. 108 + MAP_PX + 34 + 20 is
-- the location line's bottom; 6 clear of it.
local feed = create("Frame", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -16, 0, 108 + MAP_PX + 34 + 20 + 6),
	Size = UDim2.new(0, 300, 0, 200),
	BackgroundTransparency = 1,
	Parent = screenGui,
}, {
	create("UIListLayout", {
		Padding = UDim.new(0, 4),
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

local feedOrder = 0

killFeed.OnClientEvent:Connect(function(entry)
	feedOrder += 1

	-- `method` is the gun, or the companion brainrot that landed the last hit, when known.
	local text
	if entry.killer and entry.method then
		text = string.format("%s  ➜  %s   [%s]", entry.killer, entry.victim, entry.method)
	elseif entry.killer then
		text = string.format("%s  ➜  %s", entry.killer, entry.victim)
	else
		text = string.format("%s was eliminated", entry.victim)
	end

	local row = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		-- Placement is a battle-royale thing; a respawning mode's feed has none, and a nil here
		-- would throw before the row exists. It goes first, and a long row is cut with "…" rather
		-- than running off the screen's edge (#86 M8).
		Text = "  " .. (entry.placement and ("#" .. entry.placement .. "  ") or "") .. text .. "  ",
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Right,
		-- By UserId, not the shown name: a DisplayName is not unique (#86 C7). The server sends the
		-- killer's UserId beside the name (Combatants.GetUserId; nil for a bot).
		TextColor3 = entry.killerUserId ~= nil and entry.killerUserId == player.UserId and C.Accent or C.Text,
		TextSize = 13,
		LayoutOrder = feedOrder,
		Parent = feed,
	}, { rounded(6) })

	-- No more rows than the feed's box holds (#80): the rows stack down from its top and each lasts six
	-- seconds, so a burst of kills ran on past the box into whatever is under it (on a phone the slot is
	-- two rows tall and the bounty line is right under it). The newest rows show; the phone layout sets
	-- MaxRows for its slot, and the desktop box holds seven 24-pixel rows with their 4-pixel gaps.
	local live = {}
	for _, child in ipairs(feed:GetChildren()) do
		if child:IsA("TextLabel") then
			table.insert(live, child)
		end
	end
	table.sort(live, function(a, b)
		return a.LayoutOrder &gt; b.LayoutOrder
	end)
	for index, shown in ipairs(live) do
		shown.Visible = index &lt;= (feed:GetAttribute("MaxRows") or 7)
	end

	task.delay(6, function()
		TweenService:Create(row, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
		task.wait(0.4)
		row:Destroy()
	end)
end)

--------------------------------------------------------------------------------
-- Toasts
--------------------------------------------------------------------------------

-- Bottom centre, clear of the bottom row (#80): its bottom edge 8 above the hotbar's top (16 up, 150
-- tall). At -120 it sat inside the hotbar on any window narrower than about 1400 (253x36 px at 1366x768),
-- and across the companion ability tile's readout at 1920x1080.
local toast = create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -(16 + 150 + 8)),
	Size = UDim2.new(0, 460, 0, 36),
	BackgroundColor3 = C.Panel,
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = C.Text,
	TextTransparency = 1,
	TextSize = 15,
	-- A long message wraps onto a second line inside the box rather than running out of it (#86 C3).
	TextWrapped = true,
	AutomaticSize = Enum.AutomaticSize.Y,
	Parent = screenGui,
}, { rounded(8) })

-- Toasts come in bunches: a climb record and its coins, a chest's contents and the quest it finished,
-- the end-of-match quests. With one label and no queue the last of a bunch overwrote the others in the
-- same frame, so nobody ever read them. They queue now: each one stays up at least TOAST_GAP before the
-- next replaces it, in the order they came, and the last stays its full time. A line already showing
-- or already waiting is not queued a second time. In a do-block: the main chunk is near Luau's limit.
local showToast
do
	local TOAST_GAP = 1.2
	-- A burst bigger than this drops its OLDEST waiting lines, so the backlog never runs past ~7 s.
	local TOAST_QUEUE_MAX = 6
	local waiting = {} -- { message, isError }, oldest first
	local showing = nil -- the line on screen, until it fades
	local shownAt = 0
	local token = 0
	local pumping = false

	local function display(message, isError)
		token += 1
		local mine = token
		showing = message
		shownAt = tick()

		toast.Text = message
		toast.TextColor3 = isError and C.Red or C.Text
		-- In a vehicle on a desktop screen the driving HUD fills the band the toast normally uses (the speed
		-- panel 178-256 up, its hint to 280, the damage line to 304: VehicleClient), so the toast goes above
		-- it (#80). A phone places the toast itself, top-anchored (the phone layout block), and is left alone.
		if toast.AnchorPoint.Y == 1 then
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			local seat = humanoid and humanoid.SeatPart
			-- A gunner's panel sits in the same band as the driver's (VehicleWeaponClient), so a gunner counts.
			local driving = seat ~= nil and (seat:IsA("VehicleSeat") or seat.Name == "GunnerSeat" or seat:GetAttribute("Gunner") == true)
				or player:GetAttribute("VehicleGunActive") == true
			toast.Position = UDim2.new(0.5, 0, 1, driving and -(304 + 8) or -(16 + 150 + 8))
		end
		TweenService:Create(toast, TweenInfo.new(0.15), { BackgroundTransparency = 0.15, TextTransparency = 0 }):Play()

		-- Long enough to read: 2.6 s for a short line, more for a long one (#86 C3).
		task.delay(math.max(2.6, 1.5 + 0.05 * #message), function()
			if mine ~= token then
				return
			end
			showing = nil
			TweenService:Create(toast, TweenInfo.new(0.35), { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
		end)
	end

	local function alreadyQueued(message)
		for _, entry in ipairs(waiting) do
			if entry[1] == message then
				return true
			end
		end
		return false
	end

	-- One runner at a time works through the queue, holding each line up for its TOAST_GAP.
	local function pump()
		if pumping then
			return
		end
		pumping = true
		task.spawn(function()
			while #waiting &gt; 0 do
				local left = shownAt + TOAST_GAP - tick()
				if showing ~= nil and left &gt; 0 then
					task.wait(left)
				else
					local entry = table.remove(waiting, 1)
					display(entry[1], entry[2])
				end
			end
			pumping = false
		end)
	end

	showToast = function(message, isError)
		message = tostring(message)
		if alreadyQueued(message) then
			return
		end
		if message == showing and #waiting == 0 then
			-- The same line again with nothing behind it: keep it up for its full time from now.
			display(message, isError)
			return
		elseif message == showing then
			return
		end
		table.insert(waiting, { message, isError })
		if #waiting &gt; TOAST_QUEUE_MAX then
			table.remove(waiting, 1)
		end
		pump()
	end
end

notify.OnClientEvent:Connect(showToast)

-- The camera key flips a saved setting, so say which way it went.
Settings.Changed:Connect(function(id)
	if id == "ThirdPerson" then
		showToast(Settings.Get("ThirdPerson") and "Third-person camera" or "First-person camera")
	end
end)

-- Bounties: who's worth extra right now, and who just collected.
-- The remote is named here rather than kept in a local: the main chunk is at Luau's 200-local limit.
Remotes.Event("Bounty").OnClientEvent:Connect(function(info)
	if type(info) ~= "table" then
		hudLayout.show(bountyLabel, false)
		return
	end
	if info.claimed then
		hudLayout.show(bountyLabel, false)
		showToast(string.format("%s collected the %d coin bounty on %s!", info.by or "Someone", info.reward or 0, info.name or "?"))
		return
	end
	bountyLabel.Text = string.format("BOUNTY  •  %s  (%d kills)  •  %d C", info.name or "?", info.kills or 0, info.reward or 0)
	hudLayout.show(bountyLabel, matchState.state == "InProgress")
	-- "Is it me?" by UserId, which the server sends beside the name (Combatants.GetUserId, #86 C7): the
	-- name is a DisplayName and not unique, so comparing names gave a player who shares yours your "YOU"
	-- toast. (Comparing two different kinds of name is how it once went to everyone except its subject.)
	if info.userId == nil or info.userId ~= player.UserId then
		showToast(string.format("BOUNTY: %d SahurCoins on %s (%d kills)", info.reward or 0, info.name or "?", info.kills or 0))
	else
		showToast(string.format("There's a %d coin bounty on YOU — everyone knows.", info.reward or 0), true)
	end
end)

-- Companions downed: tell the owner, and the player who did it.
Remotes.Event("CompanionDown").OnClientEvent:Connect(function(info)
	if type(info) ~= "table" then
		return
	end
	if info.owner == player.UserId then
		showToast(string.format("%s was downed%s — it's back next match",
			info.name or "Your companion", info.killer and (" by " .. info.killer) or ""), true)
	elseif info.killerUserId == player.UserId then
		showToast(string.format("You downed %s!", info.name or "a companion"))
	end
end)

--------------------------------------------------------------------------------
-- Phone and tablet layout (StarterPlayerScripts/PhoneLayout)
--------------------------------------------------------------------------------

-- On a touch screen every piece above is drawn at its desktop size, which on an 844x390 phone covers
-- the middle of the screen and overlaps itself (measured: 27 overlapping pairs). PhoneLayout says where
-- each piece goes and how big it is; this block is what moves them, and puts every one of them back if
-- the device stops being a phone (a tablet with a keyboard plugged in, or the gallery's test hook).
-- Nothing here runs on a desktop screen. In a do-block, and the whole thing under pcall: if PhoneLayout
-- ever fails to load, the HUD stays exactly as it was.
do
	local ok, err = pcall(function()
		local PhoneLayout = require(script.Parent:WaitForChild("PhoneLayout"))
		-- What each piece is drawn at, before any scaling. The health block is the phone arrangement
		-- below (one row), not its desktop shape.
		local PIECES = {
			{ key = "banner", gui = banner, natural = Vector2.new(440, 56) },
			{ key = "stormLine", gui = stormLabel, natural = Vector2.new(440, 24) },
			{ key = "compass", gui = compass, natural = Vector2.new(COMPASS_W, COMPASS_H) },
			{ key = "minimap", gui = minimap, natural = Vector2.new(MAP_PX, MAP_PX) },
			{ key = "bounty", gui = bountyLabel, natural = Vector2.new(MAP_PX + 40, 22) },
			{ key = "location", gui = locationLabel, natural = Vector2.new(MAP_PX + 40, 20) },
			-- The feed's box is 200 tall and holds two 18-pixel lines, so it is scaled on width alone.
			{ key = "killFeed", gui = feed, natural = Vector2.new(300, 200) },
			{ key = "health", gui = healthFrame, natural = Vector2.new(280, 48) },
			{ key = "speedPill", gui = speedPill, natural = Vector2.new(150, 28) },
			-- Kept on a phone, not hidden: shrunk to the strip `setCompanionShape` rearranges it into.
			{ key = "companion", gui = companionFrame, natural = Vector2.new(300, 56) },
		}
		-- Centred strips: they keep their own anchor and only shrink, since they are wider than a phone.
		local CENTRED = {
			{ gui = usePanel, scale = 0.8, key = "useBar" },
			{ gui = toast, scale = 0.62, key = "toast" },
			{ gui = dropBanner, scale = 0.62 },
			{ gui = townLabel, scale = 0.62 },
			{ gui = streakLabel, scale = 0.7 },
			{ gui = enteringLabel, scale = 0.7 },
			{ gui = zoneWarning, scale = 0.7 },
		}

		-- Everything is put back exactly as it was built, so a change of mode is not a one-way trip.
		local saved = {}
		local function remember(gui)
			if gui and not saved[gui] then
				saved[gui] = { anchor = gui.AnchorPoint, position = gui.Position, size = gui.Size }
			end
		end
		local scales = {}
		local function scaleFor(gui)
			if not scales[gui] then
				scales[gui] = gui:FindFirstChildOfClass("UIScale") or create("UIScale", { Parent = gui })
			end
			return scales[gui]
		end

		-- The health block, from two stacked bars under a big number (280x80) to one row (280x48): the
		-- number on the left, both bars in the middle, the shield count on the right.
		local healthShape = {
			[healthText] = { row = UDim2.fromOffset(0, 0), rowSize = UDim2.new(0, 70, 0, 24) },
			[healsText] = { row = UDim2.new(1, -60, 0, 0), rowSize = UDim2.new(0, 60, 0, 24) },
			[shieldBarBg] = { row = UDim2.new(0, 76, 0, 2), rowSize = UDim2.new(1, -142, 0, 8) },
			[healthBarBg] = { row = UDim2.new(0, 76, 0, 12), rowSize = UDim2.new(1, -142, 0, 12) },
		}
		local function setHealthShape(phone)
			for gui, shape in pairs(healthShape) do
				remember(gui)
				gui.Position = phone and shape.row or saved[gui].position
				gui.Size = phone and shape.rowSize or saved[gui].size
			end
			remember(healthFrame)
			healthFrame.Size = phone and UDim2.fromOffset(280, 48) or saved[healthFrame].size
		end

		-- The hotbar: eight cells in a row is far too wide for a phone, so they go four across and two
		-- down, the ammo lines come off (the held cell shows its own count) and the Inventory tab loses
		-- its wording to become an icon at the grid's top-right.
		local rowLayout = slotRow:FindFirstChildOfClass("UIListLayout")
		local grid = create("UIGridLayout", {
			CellSize = UDim2.fromOffset(78, 64),
			CellPadding = UDim2.fromOffset(6, 6),
			FillDirectionMaxCells = 4,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = nil,
		})
		local tab = weaponFrame:FindFirstChild("InventoryTab")
		-- The tab's wording and its key badge: both go on a phone, leaving the four-square icon.
		local tabWords = {}
		for _, child in ipairs(tab and tab:GetChildren() or {}) do
			if child:IsA("TextLabel") then
				table.insert(tabWords, child)
			end
		end
		local function setHotbarShape(phone, spot, slots, invSpot)
			remember(weaponFrame)
			remember(slotRow)
			-- The cells word their ammo differently in the phone shape (renderSlots).
			if weaponFrame:GetAttribute("PhoneShape") ~= (phone == true) then
				weaponFrame:SetAttribute("PhoneShape", phone == true)
				renderSlots()
			end
			ammoText.Visible = not phone
			weaponName.Visible = not phone
			local itemDetail = weaponFrame:FindFirstChild("ItemDetail")
			if itemDetail then
				itemDetail.Visible = not phone and itemDetail.Text ~= ""
			end
			if rowLayout then
				rowLayout.Parent = phone and nil or slotRow
			end
			grid.Parent = phone and slotRow or nil
			slotRow.Position = phone and UDim2.fromOffset(0, 0) or saved[slotRow].position
			slotRow.Size = phone and UDim2.new(1, 0, 0, 134) or saved[slotRow].size
			if phone then
				-- 4 cells of 78 and 3 gaps of 6 across, 2 of 64 and one gap down, plus the plate's
				-- padding, which is halved on a phone so the plate hugs the cells: the frame's own box.
				-- Scaled so the CELLS land exactly on PhoneLayout's rect, with the plate just outside it.
				local pad = 6
				for _, child in ipairs(weaponFrame:GetChildren()) do
					if child:IsA("UIPadding") then
						child.PaddingTop = UDim.new(0, pad)
						child.PaddingBottom = UDim.new(0, pad)
						child.PaddingLeft = UDim.new(0, pad)
						child.PaddingRight = UDim.new(0, pad)
					end
				end
				-- Portrait keeps only the slots that fit -- PhoneLayout says how many, and on the shortest
				-- screens none at all, where the Inventory button stands alone and the panel holds the lot.
				local columns = slots and slots &gt; 0 and math.min(slots, 4) or 4
				local rows = slots and slots &gt; 0 and 1 or 2
				grid.FillDirectionMaxCells = columns
				for index, cell in ipairs(slotCells or {}) do
					cell.cell.Visible = not slots or slots &lt;= 0 or index &lt;= slots
				end
				local none = slots ~= nil and slots &lt;= 0
				-- No slots at all (the shortest vertical screens): the plate keeps nothing but the Inventory
				-- button, which is the way to all eight there. The frame itself stays, so whatever shows and
				-- hides it with the match still works.
				slotRow.Visible = not none
				local naturalW, naturalH = columns * 78 + (columns - 1) * 6 + 2 * pad, rows * 64 + (rows - 1) * 6 + 2 * pad
				if none then
					naturalW, naturalH = 34 + 2 * pad, 25 + 2 * pad
				end
				spot = spot or (none and invSpot or nil)
				if not spot then
					return
				end
				local scale = spot.w / (naturalW - 2 * pad)
				scaleFor(weaponFrame).Scale = scale
				weaponFrame:SetAttribute("HotbarScale", scale)
				weaponFrame.Size = UDim2.fromOffset(naturalW, naturalH)
				weaponFrame.AnchorPoint = Vector2.new(1, 1)
				weaponFrame.Position = UDim2.fromOffset(spot.x1 + pad * scale, spot.y1 + pad * scale)
			else
				for _, child in ipairs(weaponFrame:GetChildren()) do
					if child:IsA("UIPadding") then
						child.PaddingTop = UDim.new(0, 12)
						child.PaddingBottom = UDim.new(0, 12)
						child.PaddingLeft = UDim.new(0, 12)
						child.PaddingRight = UDim.new(0, 12)
					end
				end
				slotRow.Visible = true
				weaponFrame.Size = saved[weaponFrame].size
				weaponFrame.AnchorPoint = saved[weaponFrame].anchor
				weaponFrame.Position = saved[weaponFrame].position
			end
			if tab then
				remember(tab)
				local tabScale = tab:FindFirstChildOfClass("UIScale")
				if phone then
					local hotbar = weaponFrame:GetAttribute("HotbarScale") or 1
					-- Bottom-right corner exactly on PhoneLayout's Inventory slot: the cells' right edge,
					-- 10 px above their top. The offsets are in the frame's own units, so the 10 is
					-- divided by the frame's scale.
					tab.Size = UDim2.fromOffset(34, 25)
					tab.AnchorPoint = Vector2.new(1, 1)
					if slots ~= nil and slots &lt;= 0 then
						-- Nothing but the button on this screen: it fills the plate rather than perching above a
						-- row of cells that is not there.
						tab.Position = UDim2.new(1, 0, 1, 0)
						if tabScale then
							tabScale.Scale = 1
						end
					else
						tab.Position = UDim2.new(1, 0, 0, -10 / math.max(hotbar, 0.01))
						if tabScale then
							tabScale.Scale = math.max(1, 1.3 / math.max(hotbar, 0.01))
						end
					end
					for _, word in ipairs(tabWords) do
						word.Visible = false
					end
				else
					tab.Size = saved[tab].size
					tab.AnchorPoint = saved[tab].anchor
					tab.Position = saved[tab].position
					for _, word in ipairs(tabWords) do
						word.Visible = true
					end
				end
			end
		end

		-- The READY pill sits 232 px right of the middle, which on an 844-wide phone hangs 40 px off the
		-- edge of the screen. It can't take a UIScale of its own -- the one it has is its breathing
		-- animation -- so on a phone it moves inside a holder that carries the scale instead, into the
		-- corner slot the event pill shares with it.
		local readyHolder = create("Frame", {
			Name = "PhoneReadyHolder",
			Size = UDim2.fromOffset(230, 60),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = screenGui,
		})
		local readyHolderScale = create("UIScale", { Parent = readyHolder })
		local function setReadyShape(phone, spot)
			remember(readyButton)
			if phone then
				readyHolderScale.Scale = spot.w / 230
				readyHolder.Position = UDim2.fromOffset(spot.x, spot.y)
				readyHolder.Visible = true
				readyButton.Position = UDim2.fromOffset(0, 0)
				readyButton.Parent = readyHolder
			else
				readyHolder.Visible = false
				readyButton.Position = saved[readyButton].position
				readyButton.Parent = screenGui
			end
		end

		-- The companion panel stays on a phone -- the owner asked for it kept and shrunk rather than
		-- hidden -- but not in its desktop shape: 300x62 of name, move, status and bar squeezed into a
		-- 160-wide strip would be six-pixel text. On a phone it becomes one line: the companion's name on
		-- the left, its state (READY, a countdown, DOWNED) on the right, and the cooldown bar under them,
		-- all drawn big in a 300x56 frame so that scaling it to the strip's width leaves 13-pixel text.
		local companionShape = {
			[companionDot] = { phone = UDim2.new(0, 18, 0.5, -4), phoneSize = UDim2.fromOffset(22, 22) },
			[companionName] = { phone = UDim2.new(0, 40, 0, 2), phoneSize = UDim2.new(1, -150, 0, 26) },
			[companionStatus] = { phone = UDim2.new(1, -10, 0, 2), phoneSize = UDim2.fromOffset(110, 26) },
			[companionMove] = { phone = UDim2.new(0, 40, 0, 30), phoneSize = UDim2.new(1, -52, 0, 0) },
			[companionBar] = { phone = UDim2.new(0, 40, 0, 34), phoneSize = UDim2.new(1, -52, 0, 12) },
		}
		local companionText = { [companionName] = 24, [companionStatus] = 22 }
		local function setCompanionShape(phone)
			remember(companionFrame)
			companionFrame.Size = phone and UDim2.fromOffset(300, 56) or saved[companionFrame].size
			for gui, shape in pairs(companionShape) do
				remember(gui)
				gui.Position = phone and shape.phone or saved[gui].position
				gui.Size = phone and shape.phoneSize or saved[gui].size
			end
			for gui, size in pairs(companionText) do
				remember(gui)
				if not saved[gui].textSize then
					saved[gui].textSize = gui.TextSize
				end
				gui.TextSize = phone and size or saved[gui].textSize
			end
			-- The move's name is what gives way on a phone: the state on the right says the same thing in
			-- fewer words, and the bar under it says how long.
			companionMove.Visible = not phone
		end

		local function apply()
			local viewport = camera.ViewportSize
			local phone = PhoneLayout.Active(viewport)
			compass:SetAttribute("PhonePlaced", phone == true)
			local spots = phone and PhoneLayout.Rects(viewport) or nil
			-- Portrait is the simplified HUD: a piece PhoneLayout has no rect for there (the compass, the
			-- kill feed, the bounty and location lines, the speed pill) is hidden rather than left behind.
			setCompanionShape(phone)
			for _, piece in ipairs(PIECES) do
				if piece.gui then
					remember(piece.gui)
					local spot = phone and spots[piece.key] or nil
					if phone and spot then
						PhoneLayout.Place(piece.gui, spots[piece.key], piece.natural, scaleFor(piece.gui), 0, piece.key ~= "killFeed")
					elseif not phone then
						piece.gui.AnchorPoint = saved[piece.gui].anchor
						piece.gui.Position = saved[piece.gui].position
						scaleFor(piece.gui).Scale = 1
					end
					-- No place for it in this mode: dropped, and hudLayout.show keeps it hidden whatever its
					-- own code asks for. Back in a mode with room: shown as its code last asked (or as it
					-- was, for a piece nothing ever shows or hides, like the kill feed's box).
					local dropped = phone and not spot
					if dropped and not hudLayout.dropped[piece.gui] then
						if hudLayout.wanted[piece.gui] == nil then
							hudLayout.wanted[piece.gui] = piece.gui.Visible
						end
						hudLayout.dropped[piece.gui] = true
						piece.gui.Visible = false
					elseif not dropped and hudLayout.dropped[piece.gui] then
						hudLayout.dropped[piece.gui] = nil
						piece.gui.Visible = hudLayout.wanted[piece.gui] == true
					end
				end
			end
			for _, piece in ipairs(CENTRED) do
				if piece.gui then
					remember(piece.gui)
					scaleFor(piece.gui).Scale = phone and piece.scale or 1
					if piece.key and phone then
						local spot = spots[piece.key]
						piece.gui.AnchorPoint = Vector2.new(0.5, 0)
						piece.gui.Position = UDim2.new(0.5, 0, 0, spot.y)
					elseif piece.key then
						piece.gui.AnchorPoint = saved[piece.gui].anchor
						piece.gui.Position = saved[piece.gui].position
					end
				end
			end
			-- How many kill rows the feed's slot holds at the scale it was given (a row is 24 plus a 4 gap).
			local feedSpot = phone and spots.killFeed or nil
			feed:SetAttribute("MaxRows", feedSpot and math.max(1, math.floor((feedSpot.h / scaleFor(feed).Scale + 4) / 28)) or nil)
			setHealthShape(phone)
			setHotbarShape(phone, phone and spots.hotbar or nil, phone and spots.hotbarSlots or nil, phone and spots.inventory or nil)
			setReadyShape(phone, phone and spots.ready or nil)
		end

		apply()
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
		-- A tablet that gains or loses a keyboard changes which layout it should have.
		UserInputService:GetPropertyChangedSignal("KeyboardEnabled"):Connect(apply)
		PhoneLayout.Reapply = apply
	end)
	if not ok then
		warn("[HudClient] the phone layout didn't load; the HUD keeps its desktop sizes: " .. tostring(err))
	end
end

--------------------------------------------------------------------------------
-- Map vote
--------------------------------------------------------------------------------

local votePanel = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.5, 0),
	Size = UDim2.new(0, 620, 0, 260),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.08,
	BorderSizePixel = 0,
	Visible = false,
	Parent = screenGui,
}, { rounded(14), padding(16) })

create("TextLabel", {
	Size = UDim2.new(1, 0, 0, 28),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "VOTE FOR THE MAP",
	TextColor3 = C.Text,
	TextSize = 22,
	Parent = votePanel,
})

local voteRow = create("Frame", {
	Position = UDim2.new(0, 0, 0, 36),
	Size = UDim2.new(1, 0, 1, -36),
	BackgroundTransparency = 1,
	Parent = votePanel,
}, {
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

-- Cards are built once per set of candidates, then updated in place. Rebuilding them all on
-- every broadcast tore down and recreated ~20 instances each time anyone in the server voted.
local voteCards = {}
local voteCardsKey = nil

local function buildVoteCards(candidates)
	for _, entry in ipairs(voteCards) do
		entry.card:Destroy()
	end
	table.clear(voteCards)

	for index, candidate in ipairs(candidates) do
		local card = create("TextButton", {
			Size = UDim2.fromOffset(188, 188),
			BackgroundColor3 = C.Panel,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = index,
		}, { rounded(10), padding(12) })

		-- Border mode is required: on a text button the default Contextual mode strokes the
		-- text, and this button has none, so the highlight used to be invisible.
		local stroke = create("UIStroke", {
			Color = C.Accent,
			Thickness = 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Enabled = false,
			Parent = card,
		})

		create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = candidate.name,
			TextColor3 = C.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextSize = 16,
			Parent = card,
		})

		create("TextLabel", {
			Position = UDim2.new(0, 0, 0, 26),
			Size = UDim2.new(1, 0, 0, 74),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = candidate.description,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			TextSize = 12,
			Parent = card,
		})

		create("TextLabel", {
			Position = UDim2.new(0, 0, 1, -52),
			Size = UDim2.new(1, 0, 0, 18),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = string.format("Radius %d studs", candidate.radius),
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextSize = 11,
			Parent = card,
		})

		local tally = create("TextLabel", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 28),
			BackgroundColor3 = C.Background,
			BorderSizePixel = 0,
			Font = Enum.Font.FredokaOne,
			Text = "0 votes",
			TextColor3 = C.Text,
			TextSize = 15,
			Parent = card,
		}, { rounded(6) })

		card.Activated:Connect(function()
			castVote:InvokeServer(candidate.id)
		end)

		card.Parent = voteRow
		voteCards[index] = { card = card, stroke = stroke, tally = tally }
	end
end

local function renderVote(voteState)
	-- Superseded by StarterPlayerScripts/VoteScreen.lua, which votes on the MODE as well as the map
	-- (Oliver's #2). Same note as the drop screen: one line back if it is ever needed.
	votePanel.Visible = false
	if not votePanel.Visible then
		return
	end

	local ids = {}
	for index, candidate in ipairs(voteState.candidates) do
		ids[index] = candidate.id
	end
	local key = table.concat(ids, "|")
	if key ~= voteCardsKey then
		voteCardsKey = key
		buildVoteCards(voteState.candidates)
	end

	-- The server keys this by UserId as a string (see VoteService.Broadcast).
	local myVote = voteState.votes[tostring(player.UserId)]

	for index, candidate in ipairs(voteState.candidates) do
		local entry = voteCards[index]
		local picked = myVote == candidate.id
		entry.stroke.Enabled = picked
		entry.tally.Text = string.format("%d vote%s", candidate.votes, candidate.votes == 1 and "" or "s")
		entry.tally.BackgroundColor3 = picked and C.Accent or C.Background
		entry.tally.TextColor3 = picked and Color3.new(0, 0, 0) or C.Text
	end
end

local latestVote = { open = false, candidates = {}, votes = {} }

voteChanged.OnClientEvent:Connect(function(voteState)
	latestVote = voteState
	renderVote(latestVote)
end)

--------------------------------------------------------------------------------
-- Results card
--------------------------------------------------------------------------------

local resultsPanel = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.5, 0),
	Size = UDim2.new(0, 460, 0, 410),
	BackgroundColor3 = C.Background,
	BorderSizePixel = 0,
	Visible = false,
	Parent = screenGui,
}, { rounded(14), padding(20) })

local resultsRank = create("TextLabel", {
	Size = UDim2.new(1, 0, 0, 56),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "#1",
	TextColor3 = C.Accent,
	TextSize = 52,
	Parent = resultsPanel,
})

local resultsBody = create("TextLabel", {
	Position = UDim2.new(0, 0, 0, 64),
	Size = UDim2.new(1, 0, 1, -64),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = C.Text,
	TextWrapped = true,
	TextYAlignment = Enum.TextYAlignment.Top,
	TextSize = 16,
	Parent = resultsPanel,
})

--------------------------------------------------------------------------------
-- Winner celebration
--------------------------------------------------------------------------------

local celebrateWin
-- In a do-block: this script's main chunk is close to Luau's 200-local limit.
do
	local CONFETTI_COLORS = {
		C.Accent, C.Green, C.Storm, C.Red, Color3.fromRGB(80, 200, 255), Color3.fromRGB(255, 255, 255),
	}

	local championBanner = create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.2),
		Size = UDim2.fromOffset(760, 90),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = "BRAINROT CHAMPION",
		TextColor3 = C.Accent,
		TextStrokeTransparency = 1,
		TextScaled = true,
		TextTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = screenGui,
	})
	local championScale = create("UIScale", { Parent = championBanner })

	-- Taking #1: the banner pops in and confetti rains down the screen. GUI frames only, so it
	-- costs nothing in the world and needs no assets.
	function celebrateWin()
		championBanner.Visible = true
		championBanner.TextTransparency = 0
		championBanner.TextStrokeTransparency = 0.2
		championScale.Scale = 0.3
		TweenService:Create(championScale, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		Sfx.Play("CrateOpen")

		local viewport = camera.ViewportSize
		for _ = 1, 70 do
			local size = math.random(6, 12)
			local startX = math.random(0, math.floor(viewport.X))
			local piece = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(startX, -20 - math.random(0, 220)),
				Size = UDim2.fromOffset(size, math.floor(size * 1.6)),
				Rotation = math.random(0, 360),
				BackgroundColor3 = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
				BorderSizePixel = 0,
				ZIndex = 19,
				Parent = screenGui,
			})
			local fall = 2.2 + math.random() * 1.8
			TweenService:Create(piece, TweenInfo.new(fall, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.fromOffset(startX + math.random(-120, 120), viewport.Y + 40),
				Rotation = piece.Rotation + math.random(-540, 540),
			}):Play()
			task.delay(fall + 0.1, function()
				piece:Destroy()
			end)
		end

		task.delay(4.5, function()
			TweenService:Create(championBanner, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			task.wait(0.6)
			championBanner.Visible = false
		end)
	end
end

--------------------------------------------------------------------------------
-- Death recap
--------------------------------------------------------------------------------

-- Who did it, with what, from how far, what they had left, and where the last twelve seconds
-- of damage came from — shown under the banner while you go down, gone when the results come.
local recapPanel
-- In a do-block: this script's main chunk is close to Luau's 200-local limit.
do
	local deathRecap = Remotes.Event("DeathRecap")

	recapPanel = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.new(0, 480, 0, 104),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 12,
		Parent = screenGui,
	}, { rounded(12), padding(12) })

	-- Scaled down to fit rather than cut off: "DOWNED BY &lt;a long display name&gt; — BACK IN 5" is wider than
	-- the panel at 22 pt.
	local recapTitle = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = "",
		TextColor3 = C.Red,
		TextSize = 22,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 13,
		Parent = recapPanel,
	}, { create("UITextSizeConstraint", { MaxTextSize = 22 }) })

	local recapBody = create("TextLabel", {
		Position = UDim2.new(0, 0, 0, 30),
		Size = UDim2.new(1, 0, 1, -30),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = "",
		TextColor3 = C.Text,
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 13,
		Parent = recapPanel,
	})

	-- `token` retires an old recap's hide timer; `killer`, `title` and `backAt` feed the respawn countdown.
	local recap = { token = 0 }

	-- In a respawn mode the recap says when you are back (#86 M32): "DOWNED BY RIVAL — BACK IN 4", counting
	-- down. The wait used to be only in a 2.6 s toast. The time comes from the recap's own `respawnDelay`
	-- when it carries one, else from the RespawnAt attribute GameMode puts on the player at the moment it
	-- schedules the respawn (server time; GetServerTimeNow is the same clock here). The two can arrive in
	-- either order, so the title is re-judged every frame while the panel is up, and a stale RespawnAt
	-- from an earlier death is already in the past and says nothing.
	do
		local function respawnIn()
			local at = recap.backAt or player:GetAttribute("RespawnAt")
			if type(at) ~= "number" then
				return nil
			end
			local left = math.ceil(at - workspace:GetServerTimeNow())
			return left &gt; 0 and left or nil
		end
		function recap.update()
			local left = respawnIn()
			local text = recap.title or ""
			if left then
				text = (recap.killer and ("DOWNED BY " .. string.upper(recap.killer)) or "DOWNED") .. " — BACK IN " .. left
			end
			if recapTitle.Text ~= text then
				recapTitle.Text = text
			end
		end
		RunService.Heartbeat:Connect(function()
			if recapPanel.Visible then
				recap.update()
			end
		end)
	end

	deathRecap.OnClientEvent:Connect(function(info)
		recap.token += 1
		local token = recap.token
		recap.killer = info.killer
		recap.backAt = type(info.respawnDelay) == "number" and (workspace:GetServerTimeNow() + info.respawnDelay) or nil

		local lines = {}
		if info.killer then
			recapTitle.Text = "ELIMINATED BY " .. string.upper(info.killer)
			local how = {}
			if info.weapon then
				table.insert(how, info.weapon)
			end
			if info.distance then
				table.insert(how, string.format("%d studs", math.floor(info.distance + 0.5)))
			end
			if info.headshot then
				table.insert(how, "headshot")
			end
			if #how &gt; 0 then
				table.insert(lines, table.concat(how, "  •  "))
			end
			if info.killerHealth then
				table.insert(lines, string.format("They had %d HP%s left", info.killerHealth,
					info.killerShield and string.format(" + %d shield", info.killerShield) or ""))
			end
		else
			-- The storm's finishing blow is named as the storm's even after a shooter had hit you (#86 C6).
			recapTitle.Text = (info.finishedBy == "Storm" or (info.taken or 0) == 0) and "THE STORM GOT YOU" or "ELIMINATED"
		end
		if (info.taken or 0) &gt; 0 then
			local sources = {}
			for _, source in ipairs(info.sources or {}) do
				table.insert(sources, string.format("%s %d", source.name, source.amount))
			end
			table.insert(lines, string.format("%d damage in the last 12 s%s", info.taken,
				#sources &gt; 0 and ("  —  " .. table.concat(sources, ", ")) or ""))
		end
		recapBody.Text = table.concat(lines, "\n")
		recap.title = recapTitle.Text
		recap.update()
		recapPanel.Visible = true

		task.delay(10, function()
			if recap.token == token then
				recapPanel.Visible = false
			end
		end)
	end)
end

matchResults.OnClientEvent:Connect(function(result)
	recapPanel.Visible = false
	-- ResultsScreen.client.lua draws the end-of-match screen now (Oliver, 16:03). This card and its
	-- champion banner are the fallback for when that script is missing.
	if playerGui:FindFirstChild("BrrResults") then
		return
	end
	resultsPanel.Visible = true
	resultsRank.Text = "#" .. result.rank
	resultsRank.TextColor3 = result.rank == 1 and C.Accent or C.Text
	if result.rank == 1 then
		celebrateWin()
	end

	local lines = { string.format("out of %d", result.total) }

	if result.rank ~= 1 and result.winnerName then
		table.insert(lines, string.format("Won by %s%s",
			result.winnerName, result.winnerIsBot and " (bot)" or ""))
	end

	if result.kills and result.kills &gt; 0 then
		table.insert(lines, string.format("%d elimination%s", result.kills, result.kills == 1 and "" or "s"))
	end

	if result.eggsTotal and result.eggsTotal &gt; 0 then
		table.insert(lines, string.format("Easter eggs found: %d / %d", result.eggsFound or 0, result.eggsTotal))
	end

	-- The match in numbers.
	local tally = result.tally or {}
	local numbers = {}
	if (tally.damage or 0) &gt; 0 then
		table.insert(numbers, string.format("%s damage", formatNumber(math.floor(tally.damage))))
	end
	if (tally.chests or 0) &gt; 0 then
		table.insert(numbers, string.format("%d chest%s", tally.chests, tally.chests == 1 and "" or "s"))
	end
	if (tally.items or 0) &gt; 0 then
		table.insert(numbers, string.format("%d item%s used", tally.items, tally.items == 1 and "" or "s"))
	end
	if (tally.supply or 0) &gt; 0 then
		table.insert(numbers, string.format("%d supply drop%s", tally.supply, tally.supply == 1 and "" or "s"))
	end
	if (tally.bounties or 0) &gt; 0 then
		table.insert(numbers, string.format("%d bount%s collected", tally.bounties, tally.bounties == 1 and "y" or "ies"))
	end
	if #numbers &gt; 0 then
		table.insert(lines, table.concat(numbers, "  •  "))
	end

	-- How the shooting went.
	local combat = result.combat
	if combat and (combat.shots or 0) &gt; 0 then
		local aim = {}
		table.insert(aim, string.format("Accuracy %d%% (%d / %d)", math.floor(combat.hits / combat.shots * 100 + 0.5), combat.hits, combat.shots))
		if (combat.headshots or 0) &gt; 0 then
			table.insert(aim, string.format("%d headshot%s", combat.headshots, combat.headshots == 1 and "" or "s"))
		end
		table.insert(lines, table.concat(aim, "  •  "))
	end
	if combat and ((combat.longestKill or 0) &gt; 0 or (combat.damageTaken or 0) &gt; 0) then
		local more = {}
		if (combat.longestKill or 0) &gt; 0 then
			table.insert(more, string.format("Longest elimination %d studs", math.floor(combat.longestKill + 0.5)))
		end
		if (combat.damageTaken or 0) &gt; 0 then
			table.insert(more, string.format("%s damage taken", formatNumber(math.floor(combat.damageTaken))))
		end
		table.insert(lines, table.concat(more, "  •  "))
	end

	if result.companionDamage and result.companionDamage &gt; 0 then
		table.insert(lines, string.format("Your companion dealt %d damage", result.companionDamage))
	end

	if result.reward then
		table.insert(lines, "")
		-- Team modes award coins and XP with NO crate (GameMode's AwardResult sends `crate = nil`),
		-- so only the crate LINES are conditional. Coins, XP and the rank line below are not: a team
		-- reward still shows everything it actually contains. string.upper(nil) threw here, after the
		-- panel and rank were already drawn, so the card showed an empty body and never ran its 10 s
		-- hide -- it lingered until the 15 s Intermission broadcast.
		if result.reward.crate then
			table.insert(lines, string.upper(result.reward.crate) .. " CRATE")
			table.insert(lines, "open it from the menu")
			table.insert(lines, "")
		end
		table.insert(lines, string.format("+%d SahurCoins", result.reward.coins))
		table.insert(lines, string.format("+%d Brainrot Pass XP", result.reward.xp))
		-- Rot Rank this match (ProgressionService.MatchSummary). ONE line: the card is nearly full, and
		-- mastery tiers already get their own toasts.
		local progression = result.progression
		if progression and (progression.xp or 0) &gt; 0 then
			local rankText = progression.prestige ~= progression.prestigeFrom
				and string.format("PRESTIGE %d  •  ROT RANK %d", progression.prestige, progression.rank)
				or progression.rank ~= progression.rankFrom and string.format("ROT RANK %d → %d", progression.rankFrom, progression.rank)
				or string.format("ROT RANK %d", progression.rank)
			table.insert(lines, string.format("%s  •  +%s XP%s", rankText, formatNumber(progression.xp),
				(progression.cells or 0) &gt; 0 and string.format("  •  +%s Cells", formatNumber(progression.cells)) or ""))
		end
		-- Rarity.Color(nil) answers Common rather than failing, so without this a team card came out
		-- Common grey -- a wrong colour is harder to notice than a crash and lasts longer.
		resultsBody.TextColor3 = result.reward.crate and Rarity.Color(result.reward.crate) or C.Text
	else
		table.insert(lines, "")
		table.insert(lines, "No placement reward this time.")
		resultsBody.TextColor3 = C.Muted
	end

	resultsBody.Text = table.concat(lines, "\n")

	task.delay(10, function()
		resultsPanel.Visible = false
	end)
end)

--------------------------------------------------------------------------------
-- Wiring
--------------------------------------------------------------------------------

local function renderBanner()
	local ready = isReady()
	updateReadyButton()

	-- Oliver: the players-alive bubble is Battle Royale only. In a team mode the score bar takes
	-- this slot (ModeScoreHud moves up to it), so the banner hides while you're playing one.
	hudLayout.show(banner, not (matchState.state == "InProgress" and loadout
		and matchState.mode ~= nil and matchState.mode ~= "BattleRoyale"))

	if matchState.state == "Waiting" then
		bannerTitle.Text = ready and "WAITING FOR PLAYERS" or "READY UP TO PLAY"
		local idle = "Or hang out in the lobby as long as you like"
		-- Someone who hasn't played yet gets the basics, one at a time.
		if profileMatches == 0 then
			local tip = NEW_PLAYER_TIPS[(tipIndex % #NEW_PLAYER_TIPS) + 1]
			-- {ActionId} is that action's key as this player has it bound, read now so a rebind shows.
			-- On a gamepad or touch screen a keyboard key means nothing, so the key is dropped there,
			-- the same way KeyHintClient words world labels.
			local lastInput = UserInputService:GetLastInputType()
			if lastInput == Enum.UserInputType.Touch or string.find(lastInput.Name, "Gamepad", 1, true) or not UserInputService.KeyboardEnabled then
				tip = (string.gsub(tip, "press {%w+} to ", ""))
			end
			tip = (string.gsub(tip, "{(%w+)}", function(actionId)
				return Settings.KeyLabel(actionId)
			end))
			idle = "NEW HERE?  " .. tip
		end
		bannerSub.Text = ready
			and string.format("%d / %d ready  •  %d in server",
				matchState.readyCount or 0, matchState.minPlayers or 1, matchState.playerCount or 0)
			or idle
	elseif matchState.state == "Intermission" then
		local seconds = matchState.countdown or 0
		bannerTitle.Text = string.format("INTERMISSION  %d:%02d", seconds // 60, seconds % 60)
		bannerSub.Text = ready and "You're readied up — the countdown starts after the break"
			or "Ready up to join the next match"
	elseif matchState.state == "Countdown" then
		bannerTitle.Text = "STARTING IN " .. matchState.countdown
		bannerSub.Text = ready and "Vote for the map" or "You're staying in the lobby — ready up to join"
	elseif matchState.state == "Loading" then
		-- The same state covers building the map and the drop window that follows it.
		if matchState.dropSelect then
			bannerTitle.Text = "CHOOSE YOUR DROP  " .. (matchState.countdown or 0)
			bannerSub.Text = "Click the map, or leave it and land somewhere random"
		else
			bannerTitle.Text = "BUILDING MAP…"
			bannerSub.Text = "Generating terrain, towns and loot"
		end
	elseif matchState.state == "InProgress" then
		-- A count of the living means nothing in a respawn mode (#86 C36): there it names the mode.
		local modeDef = matchState.mode and matchState.mode ~= "BattleRoyale"
			and require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("GameModes")).Get(matchState.mode)
		bannerTitle.Text = modeDef and string.upper(modeDef.name) or (matchState.aliveCount .. " ALIVE")

		-- No loadout during a live match means this player isn't in it — they joined after
		-- it started, or they've been eliminated and are spectating.
		if not loadout then
			bannerSub.Text = ready and "Not in this match — you'll join the next one"
				or "Not in this match — ready up to join the next one"
		else
			local parts = {}
			if matchState.mapName then
				table.insert(parts, matchState.mapName)
			end
			if matchState.event then
				table.insert(parts, "EVENT: " .. string.upper(matchState.event.name))
			end
			if (matchState.botCount or 0) &gt; 0 then
				table.insert(parts, matchState.botCount .. " bots")
			end
			bannerSub.Text = table.concat(parts, "   •   ")
		end
	else
		bannerTitle.Text = "MATCH OVER"
		bannerSub.Text = ready and "Next match starting soon" or "Ready up to join the next match"
	end
end

-- Your own ready flag comes back as a replicated attribute; redraw when it lands.
player:GetAttributeChangedSignal("Ready"):Connect(renderBanner)

-- Which brainrot is following you, from the profile.
local function applyCompanionProfile(state)
	companionDef = state and state.companion and BrainrotData.Get(state.companion) or nil
	companionLevel = 1
	companionStars = 0
	if companionDef and state.brainrots then
		for _, entry in ipairs(state.brainrots) do
			if entry.name == companionDef.name then
				companionLevel = entry.level or 1
				companionStars = entry.stars or 0
				break
			end
		end
	end
	updateCompanionWidget()
	local matches = state and state.stats and state.stats.matches
	if matches ~= profileMatches then
		profileMatches = matches
		renderBanner()
	end
end

-- The tips rotate while the banner is showing them.
task.spawn(function()
	while true do
		task.wait(7)
		if profileMatches == 0 and matchState.state == "Waiting" then
			tipIndex += 1
			renderBanner()
		end
	end
end)

profileChanged.OnClientEvent:Connect(applyCompanionProfile)
task.spawn(function()
	local ok, result = pcall(function()
		return requestProfile:InvokeServer()
	end)
	if ok and result then
		applyCompanionProfile(result)
	end
end)

-- Your companion just struck: flash the panel in its colour.
companionAttackRemote.OnClientEvent:Connect(function(info)
	if not info or info.owner ~= player.UserId then
		return
	end
	abilityReadyAt = os.clock() + (tonumber(info.cooldown) or 0)
	if not companionFrame.Visible then
		return
	end
	companionStroke.Transparency = 0
	companionDot.Size = UDim2.fromOffset(30, 30)
	TweenService:Create(companionStroke, TweenInfo.new(0.45), { Transparency = 1 }):Play()
	TweenService:Create(companionDot, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(22, 22) }):Play()
end)

-- In a do-block: this script's main chunk is close to Luau's 200-local limit.
do
	-- The pill counts down. It used to read "SPEED BOOST" with no seconds, so a player could not tell
	-- whether they had eight seconds of it left or half of one -- and the moment it ends, their speed
	-- changes under them with nothing on screen having said it was about to.
	--
	-- `SpeedBoostUntil` is a SERVER-TIME stamp (MatchService:1040, cleared with the flag at :1052), and
	-- `workspace:GetServerTimeNow()` gives the client the same clock, so this needs no remote and cannot
	-- drift from the server's own idea of when the boost ends. If the stamp is ever missing the pill
	-- falls back to its old wording rather than showing a wrong number.
	--
	-- Driven off Heartbeat only while the pill is visible: a per-frame connection that exists for the
	-- eighteen seconds a boost lasts, not for the whole match.
	local speedBoostTick = nil
	local function stopSpeedBoostTick()
		if speedBoostTick then
			speedBoostTick:Disconnect()
			speedBoostTick = nil
		end
	end

	--
	-- The same pill carries the other things on you that run out (#86): Bounce Boots, counted down off
	-- `BounceBootsUntil` (MovementService, a server-time stamp like the soda's; C17), and spawn protection
	-- in a team mode, off the character's `SpawnProtected` (ModeTeams; C32), which ends the moment you
	-- shoot. One pill rather than three, so there is still one thing in that spot to keep clear.
	local function refreshSpeedPill()
		local function effects()
			local now = workspace:GetServerTimeNow()
			local out = {}
			if player:GetAttribute("SpeedBoosted") == true then
				local endsAt = player:GetAttribute("SpeedBoostUntil")
				local left = endsAt and endsAt - now or 0
				table.insert(out, left &gt; 0 and string.format("SPEED BOOST  %ds", math.ceil(left)) or "SPEED BOOST")
			end
			local boots = player:GetAttribute("BounceBootsUntil")
			if boots and boots - now &gt; 0 then
				table.insert(out, string.format("BOUNCE BOOTS  %ds", math.ceil(boots - now)))
			end
			if player.Character and player.Character:GetAttribute("SpawnProtected") == true then
				table.insert(out, "PROTECTED")
			end
			return out
		end
		local current = effects()
		hudLayout.show(speedPill, #current &gt; 0)
		if #current == 0 then
			stopSpeedBoostTick()
			speedPill.Text = "SPEED BOOST"
			return
		end
		speedPill.Text = table.concat(current, "  •  ")
		if speedBoostTick then
			return
		end
		speedBoostTick = RunService.Heartbeat:Connect(function()
			local live = effects()
			if #live == 0 then
				refreshSpeedPill()
			else
				speedPill.Text = table.concat(live, "  •  ")
			end
		end)
	end

	player:GetAttributeChangedSignal("SpeedBoosted"):Connect(refreshSpeedPill)
	player:GetAttributeChangedSignal("BounceBootsUntil"):Connect(refreshSpeedPill)
	player.CharacterAdded:Connect(function(character)
		character:GetAttributeChangedSignal("SpawnProtected"):Connect(refreshSpeedPill)
		refreshSpeedPill()
	end)
	if player.Character then
		player.Character:GetAttributeChangedSignal("SpawnProtected"):Connect(refreshSpeedPill)
	end
	refreshSpeedPill()
end

--------------------------------------------------------------------------------
-- Match event banner (StarterPlayerScripts/EventBanner draws it)
--------------------------------------------------------------------------------

-- A match's event lands as a big card under the compass (icon, name, what it does, a timer), holds for
-- a few seconds and shrinks into a pill beside the top banner for the rest of the match. Tapping the
-- pill brings the card back. It replaces the one-line toast the event used to get.
-- In a do-block: this script's main chunk is close to Luau's 200-local limit.
do
	-- Under pcall: if the module ever fails to load, the event still gets its old one-line toast and the
	-- rest of this script carries on.
	local okBanner, eventBanner = pcall(function()
		local EventBanner = require(script.Parent:WaitForChild("EventBanner"))
		return EventBanner.new(screenGui, {
			onAnnounce = function()
				Sfx.Play("CrateOpen", nil, 1.12)
			end,
		})
	end)
	if not okBanner then
		warn("[HudClient] EventBanner didn't load; events fall back to a toast: " .. tostring(eventBanner))
		local function none() end
		eventBanner = { SetViewport = none, SetDock = none, SetTimer = none, Clear = none, Dock = none }
		function eventBanner.Announce(_, event)
			showToast(string.format("EVENT: %s — %s", string.upper(event.name or ""), event.description or ""))
		end
	end
	local announcedEventId = nil
	local latest = nil
	local liveSince = nil

	local function rescale()
		eventBanner:SetViewport(camera.ViewportSize)
	end
	rescale()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	-- The pill takes the READY pill's place while that's hidden (you're in the match), and sits just
	-- under it while it shows (spectating, or staying in the lobby).
	local function redock()
		eventBanner:SetDock(readyButton.Visible and "below" or "slot")
	end
	readyButton:GetPropertyChangedSignal("Visible"):Connect(redock)
	redock()

	local function refreshTimer()
		if not latest then
			return
		end
		if latest.state == "Loading" then
			if latest.dropSelect then
				eventBanner:SetTimer("drop", latest.countdown or 0)
			else
				eventBanner:SetTimer("building")
			end
		else
			-- Only a match this client saw start has a clock; someone who joined mid-match gets "LIVE".
			eventBanner:SetTimer("live", liveSince and os.clock() - liveSince or nil)
		end
	end

	matchChanged.OnClientEvent:Connect(function(state)
		local previous = latest and latest.state
		latest = state
		if state.state == "InProgress" and previous ~= "InProgress" then
			liveSince = previous == "Loading" and os.clock() or nil
		elseif state.state ~= "InProgress" then
			liveSince = nil
		end

		-- MatchService keeps sending the last match's event after it ends, so it only counts while
		-- a match is loading or on. Clearing it at the end means the same event rolled twice in a
		-- row is announced both times.
		local event = (state.state == "Loading" or state.state == "InProgress") and state.event or nil
		local eventId = event and event.id or nil
		if eventId ~= announcedEventId then
			announcedEventId = eventId
			if event then
				refreshTimer()
				eventBanner:Announce(event)
			else
				eventBanner:Clear()
			end
		else
			refreshTimer()
		end
		-- The drop screen takes the middle of the screen: the card gets out of its way.
		if state.dropSelect then
			eventBanner:Dock()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			if announcedEventId then
				refreshTimer()
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Defense placement preview (StarterPlayerScripts/DefensePreview draws it)
--------------------------------------------------------------------------------

-- While a Rot Barricade, Pop-up Bunker or Brainrot Fortress is in hand: a see-through ghost of exactly
-- what DefenseService will build, where the throw will put it, green for a good site and red with the
-- reason for a bad one, under the dotted lob and a ring for where the kit comes to rest. A Rot Mine gets
-- the lob and the ring. In a do-block: this script's main chunk is close to Luau's 200-local limit.
do
	-- A module that fails to load, or a preview that errors, switches the preview off with one warning
	-- instead of an error every frame; throwing works exactly the same without it.
	local okModule, DefensePreview = pcall(function()
		return require(script.Parent:WaitForChild("DefensePreview"))
	end)
	if not okModule then
		warn("[HudClient] DefensePreview didn't load; no placement preview: " .. tostring(DefensePreview))
	end
	local preview = nil
	local broken = not okModule
	RunService.RenderStepped:Connect(function()
		if broken then
			return
		end
		local slot = loadout and loadout.equipped and loadout.slots[loadout.equipped]
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local holding = slot and slot.kind == "item" and slot.itemKind == "defense" and matchState.state == "InProgress"
			and humanoid ~= nil and humanoid.Health &gt; 0 and not player:GetAttribute("MenuOpen")
		local ok, err = pcall(function()
			-- Its parts live under the camera; a replaced camera takes them with it, so start afresh.
			if preview and not preview.root.Parent then
				preview = nil
			end
			if holding then
				preview = preview or DefensePreview.new()
				preview:Update(character, slot.id)
			elseif preview then
				preview:Hide()
			end
		end)
		if not ok then
			broken = true
			warn("[HudClient] the defense placement preview stopped: " .. tostring(err))
			pcall(function()
				preview:Destroy()
			end)
		end
	end)
end

-- Ambient particles for the map you're on: an invisible box that rides along ahead of the
-- camera, emitting whatever MapData.Ambient says — pollen, dust, blown sand, mist, fireflies.
-- In a do-block, so its five locals are released at its end rather than held by the main chunk:
-- this file sits within a handful of Luau's 200-locals-per-function limit, and one past it stops the
-- WHOLE HUD compiling (tools/local_limit_check.py measures the headroom). Left unindented, like Drop.
do
local ambientPart = nil
local ambientMap = nil

local function ambientPresetFor(mapName)
	for _, id in ipairs(MapData.Order) do
		local preset = MapData.Maps[id]
		if preset.name == mapName and MapData.Ambient[id] then
			return id, MapData.Ambient[id]
		end
	end
	return nil
end

local function updateAmbient()
	local id, settings = nil, nil
	if matchState.state == "InProgress" and matchState.mapName and Settings.Get("AmbientParticles") then
		id, settings = ambientPresetFor(matchState.mapName)
	end
	if id == ambientMap then
		return
	end
	ambientMap = id
	if ambientPart then
		ambientPart:Destroy()
		ambientPart = nil
	end
	if not settings then
		return
	end

	ambientPart = Instance.new("Part")
	ambientPart.Name = "BRR_Ambient"
	ambientPart.Size = Vector3.new(90, 36, 90)
	ambientPart.Transparency = 1
	ambientPart.Anchored = true
	ambientPart.CanCollide = false
	ambientPart.CanQuery = false
	ambientPart.CanTouch = false
	ambientPart.CastShadow = false

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(settings.color)
	emitter.Size = NumberSequence.new(settings.size)
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.15, settings.transparency),
		NumberSequenceKeypoint.new(0.85, settings.transparency),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.LightEmission = settings.lightEmission
	emitter.Lifetime = NumberRange.new(settings.lifetime * 0.7, settings.lifetime)
	emitter.Rate = settings.rate
	emitter.Speed = NumberRange.new(settings.speed * 0.5, settings.speed)
	emitter.Acceleration = settings.acceleration
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emitter.Parent = ambientPart
	ambientPart.Parent = workspace.CurrentCamera
end

RunService.RenderStepped:Connect(function()
	if ambientPart then
		local view = workspace.CurrentCamera.CFrame
		ambientPart.CFrame = CFrame.new(view.Position + view.LookVector * 24 + Vector3.new(0, 4, 0))
	end
end)

Settings.Changed:Connect(function(id)
	if id == "*" or id == "AmbientParticles" then
		updateAmbient()
	end
end)

local lastMatchState = nil

matchChanged.OnClientEvent:Connect(function(state)
	local previous = lastMatchState
	lastMatchState = state.state
	matchState = state
	updateAmbient()
	Drop.update()

	-- The map's name across the screen as the match begins (the event under it, if there is one).
	if state.state == "InProgress" and previous ~= "InProgress" and state.mapName and loadout then
		enteringToken += 1
		local token = enteringToken
		enteringLabel.Text = string.upper(state.mapName) .. (state.event and ("   •   " .. string.upper(state.event.name)) or "")
		enteringLabel.TextColor3 = state.event and (state.event.color or C.Accent) or C.Text
		enteringLabel.TextTransparency = 1
		TweenService:Create(enteringLabel, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
		task.delay(3.5, function()
			if token == enteringToken then
				TweenService:Create(enteringLabel, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
			end
		end)
	end
	if state.state ~= "InProgress" then
		activeDrop = nil
		hudLayout.show(bountyLabel, false)
	end
	-- The match's event is announced by the event banner ("Match event banner", above).
	renderBanner()
	renderVote(latestVote)
	if state.state ~= "Results" then
		resultsPanel.Visible = false
	end
end)
end -- the ambient and match-state block

loadoutChanged.OnClientEvent:Connect(function(newLoadout)
	loadout = newLoadout
	trackUse(newLoadout)
	renderWeapon()
	-- The banner's subtitle depends on whether we're in the match, which this tells us.
	renderBanner()

	-- "RAISING" only lasts a moment and no push arrives when it ends, so redraw ourselves —
	-- unless a newer push has already replaced this loadout.
	local raiseFor = newLoadout and newLoadout.equipReadyIn or 0
	if raiseFor &gt; 0.05 then
		local snapshot = newLoadout
		task.delay(raiseFor, function()
			if loadout == snapshot then
				loadout = table.clone(snapshot)
				loadout.equipReadyIn = 0
				renderWeapon()
			end
		end)
	end
end)

renderBanner()
renderWeapon()

--------------------------------------------------------------------------------
-- Companion ability tile (bottom-left, beside the companion panel): the brainrot's portrait,
-- the key that uses its move and a ring that refills with the cooldown. Shown in the lobby too,
-- where the move is a practice demo. The tile itself is StarterPlayerScripts/CompanionAbilityIcon.
-- A do-block, so none of it counts toward the main chunk's 200-local limit.
--------------------------------------------------------------------------------

do
	local CompanionAbilityIcon = require(script.Parent:WaitForChild("CompanionAbilityIcon"))
	local abilityIcon = CompanionAbilityIcon.new(screenGui)
	local statsFor, statsKey = nil, nil

	-- On a touch screen the tile goes in PhoneLayout's pet-tile slot (`Rects().petIcon`, above the
	-- thumbstick's rest). Its own spot is worked out from the desktop hotbar, which on an 844x390 phone
	-- put it on the thumbstick and on an upright one 400 px off the left edge (#80). Its UIScale is its
	-- pop animation, so the phone size comes from a holder with a scale of its own (as the READY pill's
	-- does). The holder is a bare box, so everything that shows, hides or animates the tile still works.
	-- In a function of its own under pcall: the main chunk is at Luau's 200-local limit, and if the layout
	-- fails to load the tile keeps its desktop spot.
	xpcall(function()
		local okLayout, PhoneLayout = pcall(require, script.Parent:WaitForChild("PhoneLayout"))
		local tile = abilityIcon.frame
		local home = { anchor = tile.AnchorPoint, position = tile.Position }
		local size = CompanionAbilityIcon.Size
		local holder = create("Frame", {
			Name = "PhoneAbilityHolder",
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 1,
			Parent = screenGui,
		})
		local holderScale = create("UIScale", { Parent = holder })
		local function placeTile()
			local viewport = camera.ViewportSize
			local spot = okLayout and PhoneLayout.Active(viewport) and PhoneLayout.Rects(viewport).petIcon or nil
			if spot then
				holderScale.Scale = math.min(spot.w, spot.h) / size
				holder.Position = UDim2.fromOffset(spot.x, spot.y)
				tile.AnchorPoint = Vector2.new(0, 0)
				tile.Position = UDim2.fromOffset(0, 0)
				tile.Parent = holder
			else
				tile.AnchorPoint = home.anchor
				tile.Position = home.position
				tile.Parent = screenGui
			end
			-- The move-and-stats line above the tile grows leftward from its right edge, which from the
			-- phone slot at the left edge is off the screen and over the companion strip. The tile hides it
			-- there once CompanionAbilityIcon has SetCompact (proposed with #80); until then this is a no-op.
			if abilityIcon.SetCompact then
				abilityIcon:SetCompact(spot ~= nil)
			end
		end
		placeTile()
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(placeTile)
		UserInputService:GetPropertyChangedSignal("KeyboardEnabled"):Connect(placeTile)
	end, function(err)
		warn("[HudClient] the ability tile's phone spot didn't load; it keeps its desktop spot: " .. tostring(err))
	end)

	-- The badge names the control this player would actually press: their own keyboard key, the
	-- gamepad's Y button, or nothing on a touch screen, where the on-screen button is the control.
	-- Same device test as KeyHintClient uses for world labels.
	local function refreshKey()
		local last = UserInputService:GetLastInputType()
		if last == Enum.UserInputType.Touch then
			abilityIcon:SetKey(nil)
		elseif string.find(last.Name, "Gamepad", 1, true) then
			abilityIcon:SetKey("Y")
		elseif UserInputService.KeyboardEnabled then
			abilityIcon:SetKey(Settings.KeyLabel("Companion"))
		else
			abilityIcon:SetKey(nil)
		end
	end
	refreshKey()
	Settings.Changed:Connect(refreshKey)
	UserInputService.LastInputTypeChanged:Connect(refreshKey)

	companionAttackRemote.OnClientEvent:Connect(function(info)
		if type(info) == "table" and info.owner == player.UserId then
			abilityIcon:Used()
		end
	end)

	RunService.RenderStepped:Connect(function()
		abilityIcon:SetBrainrot(companionDef)
		if not companionDef then
			return
		end
		local key = companionDef.name .. "|" .. tostring(companionLevel) .. "|" .. tostring(companionStars)
		if key ~= statsKey then
			statsKey, statsFor = key, BrainrotData.Stats(companionDef, companionLevel, companionStars)
			-- The same stats the cooldown already came from, now also said out loud on the tile
			-- (Oliver's #14). Only on a change, so it isn't rebuilt every frame.
			abilityIcon:SetStats(statsFor, companionDef.move)
		end
		abilityIcon:Update(abilityReadyAt - os.clock(), statsFor.cooldown, player:GetAttribute("CompanionFallen") == true,
			player:GetAttribute("MenuOpen") == true)
	end)
end

--------------------------------------------------------------------------------
-- Centred panels on a small screen (StarterPlayerScripts/PhoneLayout)
--------------------------------------------------------------------------------

-- The results card is 460x410 and the map vote 620x260, authored for a desktop screen; on a 390-tall
-- phone the card's last row is off the bottom. FitPanel gives each one a UIScale that keeps it inside
-- the viewport with a 16-pixel margin and never grows it, so on any screen with the room the scale is
-- exactly 1 and nothing changes. The drop screen does the same inside its own block above.
-- In a do-block under pcall: if PhoneLayout ever fails to load, the panels stay as they were.
do
	local ok, err = pcall(function()
		local PhoneLayout = require(script.Parent:WaitForChild("PhoneLayout"))
		PhoneLayout.FitPanel(votePanel, Vector2.new(620, 260))
		PhoneLayout.FitPanel(resultsPanel, Vector2.new(460, 410))
		PhoneLayout.FitPanel(recapPanel, Vector2.new(480, 104))
	end)
	if not ok then
		warn("[HudClient] the panel fitting didn't load; the results card and the map vote keep their size: " .. tostring(err))
	end
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX163"><Properties><string name="Name">InventoryPanel</string><ProtectedString name="Source">-- The Inventory panel: rearrange the hotbar. A ModuleScript so HudClient can open it and
-- tools/hud_ux_gallery.lua can render it without a match.
--
--   local panel = InventoryPanel.new(screenGui, {
--       onSwap = function(a, b) end,          -- ask the server to swap slots a and b (SwapSlots remote)
--       onClose = function() end,             -- the panel closed itself (overlay click, close button)
--       keyLabel = function(index) end,       -- "1".."8", or whatever each slot is bound to
--       closeKeyLabel = function() end,       -- the key that toggles the panel, for the hint
--   })
--   panel:SetViewport(camera.ViewportSize)
--   panel:Open(loadout) / panel:Close() / panel:SetLoadout(loadout) / panel:IsOpen()
--
-- Eight slots in two rows of four, in hotbar order. Two ways to move things, both on mouse and touch:
--   * drag a slot onto another and let go: they swap (onto an empty slot, it moves);
--   * tap a slot, then tap another: they swap. Tap the same one again to put it down.
-- The swap shows at once, and the server's loadout push confirms it; if no push comes (the server
-- refused), the panel goes back to what the server last said. What's in your hand stays in your hand:
-- its IN HAND tag moves with it, the same as on the server (WeaponService.SwapSlots).
--
-- The panel's pointer maths expects its ScreenGui to keep the top-bar inset (IgnoreGuiInset false),
-- where InputObject positions and GUI AbsolutePositions share one origin.

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GunModels = require(Shared:WaitForChild("GunModels"))
local ItemData = require(Shared:WaitForChild("ItemData"))
local ItemModels = require(Shared:WaitForChild("ItemModels"))
local Rarity = require(Shared:WaitForChild("Rarity"))
local WeaponData = require(Shared:WaitForChild("WeaponData"))

local UiKit = require(script.Parent:WaitForChild("UiKit"))

local create, rounded = UiKit.create, UiKit.rounded
local C = UiKit.Colors

local InventoryPanel = {}
InventoryPanel.__index = InventoryPanel

local SLOT_COUNT = 8
local COLUMNS = 4
local CARD_W, CARD_H = 156, 146
local GAP = 14
local PAD = 26
local HEADER_H = 84
local FOOTER_H = 50
-- The panel is four cards across on a screen with the room, and two across four down on an upright one:
-- 718 px of panel does not fit a 320-wide phone at any scale a finger can use, and on those screens the
-- panel IS the hotbar -- PhoneLayout's upright version has no room for slots on screen at all.
local function panelSize(columns)
	local rows = math.ceil(SLOT_COUNT / columns)
	return Vector2.new(PAD * 2 + columns * CARD_W + (columns - 1) * GAP,
		HEADER_H + rows * CARD_H + (rows - 1) * GAP + FOOTER_H + 18)
end

local PANEL_W = panelSize(COLUMNS).X
local PANEL_H = panelSize(COLUMNS).Y
InventoryPanel.Size = Vector2.new(PANEL_W, PANEL_H)

--------------------------------------------------------------------------------
-- What a slot is, in words (#86 C14, C39, C40, M13)
--------------------------------------------------------------------------------

-- A gun's name carries no type: "Scrolla Scrolla Brrrap" could be anything, and whether it is an SMG or a
-- sniper is the first thing a player needs to know. The word comes from the gun's `style` (the silhouette
-- WeaponService builds), so it cannot disagree with the model in the player's hands. LootService keeps a
-- copy of this table for the floor label -- the server cannot require a StarterPlayerScripts module --
-- and tools/player_eye_check.py ("gunword") fails the moment the two differ or a style has no word.
local GUN_TYPE_WORDS = {
	pistol = "PISTOL", revolver = "REVOLVER", smg = "SMG", rifle = "RIFLE", dmr = "MARKSMAN",
	shotgun = "SHOTGUN", doublebarrel = "SHOTGUN", crossbow = "CROSSBOW", sniper = "SNIPER",
	blaster = "BLASTER", launcher = "LAUNCHER", lmg = "MACHINE GUN", minigun = "MINIGUN",
	cannon = "CANNON", railgun = "RAILGUN",
}

-- The type word, or nil when the name already says it ("Rot SMG", "Bonker Double Barrel", "Grass
-- Toucher DMR"): "Rot SMG · SMG" is noise. Compared without case or spaces, against the word and the
-- style both, so "Double Barrel" matches "doublebarrel".
function InventoryPanel.GunTypeWord(name, style)
	local word = style and GUN_TYPE_WORDS[style]
	if not word then
		return nil
	end
	local flat = string.gsub(string.lower(name or ""), "%s", "")
	local wordFlat = string.gsub(string.lower(word), "%s", "")
	if string.find(flat, wordFlat, 1, true) or string.find(flat, style, 1, true) then
		return nil
	end
	return word
end

-- The longer text a card shows while it is hovered or selected, and the HUD's line under a held item:
-- an item's description and its standing rule (the structure cap, M13), or a gun's type, reach and hit.
function InventoryPanel.Describe(slot)
	if type(slot) ~= "table" then
		return ""
	end
	if slot.kind == "item" then
		local item = ItemData.Get(slot.id)
		if not item then
			return ""
		end
		local text = item.description or ""
		if item.capRule then
			text = text .. " " .. item.capRule
		end
		return text
	end
	local def = WeaponData.Get(slot.id)
	if not def then
		return ""
	end
	local parts = {}
	local word = GUN_TYPE_WORDS[slot.style or def.style]
	if word then
		table.insert(parts, word)
	end
	-- Range is where a hitscan shot stops doing anything at all (WeaponData's header: no falloff, nothing
	-- beyond it), so it is the number that explains a miss. A launcher's round flies until it lands.
	if def.range and not def.projectile then
		table.insert(parts, string.format("reach %d studs", def.range))
	end
	table.insert(parts, string.format("%d dmg%s", def.damage or 0, (def.pellets or 1) &gt; 1 and (" x" .. def.pellets) or ""))
	return table.concat(parts, "  •  ")
end

-- Two columns on a narrow upright screen, four everywhere else.
function InventoryPanel.ColumnsFor(viewport)
	return (viewport.Y &gt; viewport.X and viewport.X &lt; 520) and 2 or COLUMNS
end

local DRAG_START = 10
local CONFIRM_WAIT = 0.9
local ZINDEX = 50

local GOLD = C.Accent
local SELECT = Color3.fromRGB(255, 214, 90)
local TARGET = C.Green
local SHADOW = Color3.fromRGB(10, 11, 16)

-- The panel's UIScale for a viewport: full size on a 1080p screen, a little bigger above it, and on a
-- phone as big as fits (about 0.75 at 844x390, where the cards are still over 110 px across).
function InventoryPanel.ScaleFor(viewport)
	local size = panelSize(InventoryPanel.ColumnsFor(viewport))
	-- Half size is the floor, unless the screen cannot even fit that: then it is whatever does fit.
	local fit = math.min(viewport.X * 0.94 / size.X, viewport.Y * 0.92 / size.Y)
	return math.clamp(math.min(viewport.Y / 1080 * 1.1, fit), math.min(0.5, fit), 1.15)
end

local function tween(instance, seconds, goal, style, direction)
	local t = TweenService:Create(instance, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

--------------------------------------------------------------------------------
-- Icons: the item or gun itself in a ViewportFrame, framed to fit. Guns are slow to build, so each is
-- built once and cloned after that.
--------------------------------------------------------------------------------

local gunTemplates = {}

local function modelFor(slot)
	if slot.kind == "item" then
		local model = ItemModels.Build(slot.id)
		if model then
			model:PivotTo(CFrame.Angles(0, math.rad(35), 0))
		end
		return model
	end
	local template = gunTemplates[slot.id]
	if template == nil then
		local def = WeaponData.Get(slot.id)
		local ok, model = pcall(function()
			return def and GunModels.Build(def, Rarity.Color(def.rarity), Enum.Material.Metal)
		end)
		template = ok and model or false
		gunTemplates[slot.id] = template
	end
	if not template then
		return nil
	end
	local model = template:Clone()
	-- Side on, muzzle to the right, tipped a touch toward the camera.
	model:PivotTo(CFrame.Angles(0, math.rad(-90), 0) * CFrame.Angles(math.rad(-8), 0, 0))
	return model
end

local function setIcon(refs, slot)
	local key = slot and (slot.kind .. ":" .. slot.id) or nil
	if refs.iconKey == key then
		return
	end
	refs.iconKey = key
	refs.icon:ClearAllChildren()
	refs.icon.Visible = false
	if not slot then
		return
	end
	local model = modelFor(slot)
	if not model then
		return
	end
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
		end
	end
	model.Parent = refs.icon
	local box, size = model:GetBoundingBox()
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	local wide = slot.kind ~= "item"
	-- Fit the longest side: guns are long and flat, items roughly round.
	local reach = wide and math.max(size.X, size.Z) * 0.62 or size.Magnitude / 2
	local distance = reach / math.tan(math.rad(15)) * (wide and 0.92 or 1.05)
	camera.CFrame = CFrame.lookAt(box.Position + Vector3.new(0, distance * (wide and 0.12 or 0.3), -distance), box.Position)
	camera.Parent = refs.icon
	refs.icon.CurrentCamera = camera
	refs.icon.Visible = true
end

--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------

function InventoryPanel.new(parent, options)
	options = options or {}
	local self = setmetatable({}, InventoryPanel)
	self.options = options
	self.open = false
	self.loadout = nil
	self.shownSlots = nil
	self.selected = nil
	self.drag = nil
	self.token = 0

	-- The dim behind the panel; clicking it closes. It is also what frees the mouse: `Modal` on a
	-- VISIBLE GuiButton unlocks the cursor for as long as it is up, which is the one thing that beats a
	-- first-person camera relocking it every frame. The panel carries its own rather than relying on
	-- another script watching an attribute, because a panel you cannot click is a panel you cannot use --
	-- and this button is already alive for exactly the panel's lifetime. (HudClient still sets the
	-- MenuOpen attribute as well: CombatClient reads it to stop clicks firing the gun.)
	self.overlay = create("TextButton", {
		Name = "InventoryOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Modal = true,
		Selectable = false,
		Text = "",
		Visible = false,
		ZIndex = ZINDEX,
		Parent = parent,
	})
	self.overlay.Activated:Connect(function()
		if self.open and not self.drag then
			self:Close(true)
		end
	end)

	local root = create("CanvasGroup", {
		Name = "InventoryPanel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(PANEL_W, PANEL_H),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		ZIndex = ZINDEX + 1,
		Parent = parent,
	})
	self.root = root
	self.scale = create("UIScale", { Parent = root })

	-- The panel's own clicks shouldn't fall through to the overlay.
	local plate = create("TextButton", {
		Name = "Plate",
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.03,
		AutoButtonColor = false,
		Text = "",
		ZIndex = ZINDEX + 1,
		Parent = root,
	}, { rounded(18) })
	create("UIStroke", { Color = C.PanelAlt, Thickness = 2, Parent = plate })
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(205, 208, 220)),
		Parent = plate,
	})

	-- Header: a bag-of-slots mark, the title, how to use it, and the close button.
	local mark = create("Frame", {
		Name = "Mark",
		Position = UDim2.fromOffset(PAD, 22),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = GOLD,
		BorderSizePixel = 0,
		ZIndex = ZINDEX + 2,
		Parent = root,
	}, { rounded(10) })
	for row = 0, 1 do
		for column = 0, 1 do
			create("Frame", {
				Position = UDim2.fromOffset(9 + column * 12, 9 + row * 12),
				Size = UDim2.fromOffset(10, 10),
				BackgroundColor3 = SHADOW,
				BorderSizePixel = 0,
				ZIndex = ZINDEX + 3,
				Parent = mark,
			}, { rounded(3) })
		end
	end
	create("TextLabel", {
		Name = "Title",
		Position = UDim2.fromOffset(PAD + 54, 16),
		Size = UDim2.fromOffset(300, 34),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = "INVENTORY",
		TextColor3 = C.Text,
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = ZINDEX + 2,
		Parent = root,
	})
	self.hint = create("TextLabel", {
		Name = "Hint",
		Position = UDim2.fromOffset(PAD + 54, 50),
		Size = UDim2.fromOffset(PANEL_W - PAD * 2 - 54 - 60, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "Drag a slot onto another to swap them, or tap one and then the other.",
		TextColor3 = C.Muted,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = ZINDEX + 2,
		Parent = root,
	})
	-- DROP (Oliver's list #36). The server has been able to drop a slot all along -- Bootstrap's
	-- DropSlot behind a rate limit, WeaponService.TakeSlot, LootService putting a real pickup on the
	-- ground -- and the only way to ask for it was a RIGHT-CLICK on a hotbar cell. A phone has no
	-- right-click at all, so on touch the feature was unreachable, and on a desktop it was
	-- undiscoverable: nothing anywhere said it existed. This is the affordance, not the feature.
	--
	-- It appears only while a slot is selected, so it cannot be hit by accident: dropping a gun in a
	-- match is not something to put one stray tap away.
	self.dropButton = create("TextButton", {
		Name = "Drop",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -PAD - 48, 0, 20),
		Size = UDim2.fromOffset(96, 44),
		BackgroundColor3 = C.Red,
		AutoButtonColor = false,
		Font = Enum.Font.GothamBold,
		Text = "DROP",
		TextColor3 = C.Text,
		TextSize = 15,
		Visible = false,
		ZIndex = ZINDEX + 2,
		Parent = root,
	}, { rounded(12) })
	self.dropButton.Activated:Connect(function()
		local index = self.selected
		if not index then
			return
		end
		self.selected = nil
		if self.options.onDrop then
			self.options.onDrop(index)
		end
		self:_refresh()
	end)

	local close = create("TextButton", {
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -PAD + 4, 0, 20),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = C.Panel,
		AutoButtonColor = false,
		Text = "",
		ZIndex = ZINDEX + 2,
		Parent = root,
	}, { rounded(12) })
	self.closeStroke = create("UIStroke", { Color = C.PanelAlt, Thickness = 1.5, Parent = close })
	for _, angle in ipairs({ 45, -45 }) do
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(20, 3),
			BackgroundColor3 = C.Text,
			BorderSizePixel = 0,
			Rotation = angle,
			ZIndex = ZINDEX + 3,
			Parent = close,
		}, { rounded(2) })
	end
	close.Activated:Connect(function()
		self:Close(true)
	end)
	close.MouseEnter:Connect(function()
		close.BackgroundColor3 = C.Red
	end)
	close.MouseLeave:Connect(function()
		close.BackgroundColor3 = C.Panel
	end)

	-- The two rows.
	self.grid = create("Frame", {
		Name = "Grid",
		Position = UDim2.fromOffset(PAD, HEADER_H),
		Size = UDim2.fromOffset(PANEL_W - PAD * 2, 2 * CARD_H + GAP),
		BackgroundTransparency = 1,
		ZIndex = ZINDEX + 2,
		Parent = root,
	})
	self.cards = {}
	for index = 1, SLOT_COUNT do
		self.cards[index] = self:_buildCard(index)
	end

	-- Footer.
	self.footLeft = create("TextLabel", {
		Name = "FootLeft",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, PAD, 1, -18),
		Size = UDim2.fromOffset(420, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "What's in your hand stays in your hand.",
		TextColor3 = C.Muted,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = ZINDEX + 2,
		Parent = root,
	})
	self.footRight = create("TextLabel", {
		Name = "FootRight",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -PAD, 1, -18),
		Size = UDim2.fromOffset(240, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		RichText = true,
		Text = "",
		TextColor3 = C.Muted,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = ZINDEX + 2,
		Parent = root,
	})

	-- The card that follows the pointer while dragging, drawn over everything.
	self.lifted = self:_buildCard(0, parent)
	self.lifted.card.Visible = false
	self.lifted.card.AnchorPoint = Vector2.new(0.5, 0.5)
	self.lifted.card.ZIndex = ZINDEX + 20
	self.liftedScale = create("UIScale", { Parent = self.lifted.card })
	for _, item in ipairs(self.lifted.card:GetDescendants()) do
		if item:IsA("GuiObject") then
			item.ZIndex += 20
		end
	end

	self:_connectPointer()
	return self
end

-- One slot card. `index` 0 is the lifted copy used while dragging; `parent` defaults to the grid.
function InventoryPanel:_buildCard(index, parent)
	local columns = self.columns or COLUMNS
	local column = (math.max(index, 1) - 1) % columns
	local row = math.floor((math.max(index, 1) - 1) / columns)
	local card = create("TextButton", {
		Name = index &gt; 0 and ("Slot" .. index) or "Lifted",
		Position = UDim2.fromOffset(column * (CARD_W + GAP) + CARD_W / 2, row * (CARD_H + GAP) + CARD_H / 2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(CARD_W, CARD_H),
		BackgroundColor3 = C.Panel,
		AutoButtonColor = false,
		Text = "",
		ZIndex = ZINDEX + 3,
		Parent = parent or self.grid,
	}, { rounded(14) })
	local refs = { index = index, card = card }
	refs.scale = index &gt; 0 and create("UIScale", { Parent = card }) or nil
	refs.stroke = create("UIStroke", { Color = C.PanelAlt, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = card })
	refs.gradient = create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 194, 206)),
		Parent = card,
	})

	-- The rarity's colour pooling up from the bottom, under everything else.
	refs.glow = create("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0.7),
		BackgroundColor3 = C.Accent,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = ZINDEX + 3,
		Parent = card,
	}, {
		rounded(14),
		create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.72) }),
		}),
	})

	refs.icon = create("ViewportFrame", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 24),
		Size = UDim2.fromOffset(CARD_W - 20, 70),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(170, 170, 182),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, 0.6),
		Visible = false,
		ZIndex = ZINDEX + 4,
		Parent = card,
	})

	refs.key = create("TextLabel", {
		Name = "Key",
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(26, 24),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.1,
		Font = Enum.Font.GothamBlack,
		Text = tostring(index),
		TextColor3 = C.Text,
		TextSize = 14,
		ZIndex = ZINDEX + 5,
		Parent = card,
	}, { rounded(7) })

	refs.tag = create("TextLabel", {
		Name = "Tag",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(62, 20),
		BackgroundColor3 = GOLD,
		Font = Enum.Font.GothamBlack,
		Text = "IN HAND",
		TextColor3 = SHADOW,
		TextSize = 10,
		Visible = false,
		ZIndex = ZINDEX + 5,
		Parent = card,
	}, { rounded(10) })

	refs.name = create("TextLabel", {
		Name = "ItemName",
		Position = UDim2.new(0, 10, 1, -46),
		Size = UDim2.new(1, -20, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = "",
		TextColor3 = C.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = ZINDEX + 5,
		Parent = card,
	})
	refs.sub = create("TextLabel", {
		Name = "Sub",
		Position = UDim2.new(0, 10, 1, -27),
		-- The whole width: the ammo count is a chip on the icon above, not on this line.
		Size = UDim2.new(1, -20, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = C.Muted,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = ZINDEX + 5,
		Parent = card,
	})
	-- The ammo (or the stack's count) is a chip on the icon's bottom-right corner, the way the hotbar
	-- cells show it, and NOT on the line below: "LEGENDARY  •  240 reserve" needs that whole line, and a
	-- magazine like 100/100 is wide enough to run under it wherever the two share a row.
	refs.count = create("TextLabel", {
		Name = "Count",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -50),
		Size = UDim2.fromOffset(74, 22),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.3,
		Font = Enum.Font.FredokaOne,
		Text = "",
		TextColor3 = C.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = ZINDEX + 5,
		Parent = card,
	}, {
		rounded(7),
		create("UIPadding", { PaddingRight = UDim.new(0, 6) }),
	})
	refs.bar = create("Frame", {
		Name = "Bar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(1, -24, 0, 4),
		BackgroundColor3 = C.Muted,
		BorderSizePixel = 0,
		ZIndex = ZINDEX + 5,
		Parent = card,
	}, { rounded(2) })
	-- The card's detail (Describe): over the icon and the ammo chip, which it hides, while the card is
	-- hovered or selected. The name and the tier line stay where they are, so the card still says what
	-- it is. Scaled into the box rather than truncated: an item's description is the whole point, and the
	-- longest (Sticky Bomb, or a fortress with its cap rule) is about 150 characters.
	refs.detail = create("TextLabel", {
		Name = "Detail",
		Position = UDim2.fromOffset(10, 36),
		Size = UDim2.new(1, -20, 1, -84),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = C.Text,
		TextScaled = true,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Visible = false,
		ZIndex = ZINDEX + 5,
		Parent = card,
	}, { create("UITextSizeConstraint", { MaxTextSize = 13 }) })
	refs.empty = create("TextLabel", {
		Name = "Empty",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(CARD_W - 20, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "EMPTY",
		TextColor3 = C.Muted,
		TextTransparency = 0.35,
		TextSize = 13,
		ZIndex = ZINDEX + 5,
		Parent = card,
	})
	return refs
end

--------------------------------------------------------------------------------
-- Drawing
--------------------------------------------------------------------------------

-- Fills a card from a loadout slot (or `false` for empty) and its state.
function InventoryPanel:_paintCard(refs, slot, state)
	state = state or {}
	local filled = slot ~= nil and slot ~= false
	refs.key.Text = self.options.keyLabel and self.options.keyLabel(refs.index) or tostring(refs.index)
	refs.empty.Visible = not filled
	refs.name.Visible = filled
	refs.sub.Visible = filled
	refs.count.Visible = filled
	refs.bar.Visible = filled
	refs.glow.Visible = filled
	refs.tag.Visible = filled and state.held == true
	refs.card.BackgroundColor3 = filled and C.Panel or C.Background
	refs.card.BackgroundTransparency = filled and 0 or 0.25
	setIcon(refs, filled and slot or nil)

	-- Hovered or selected, and not being dragged: the words instead of the picture.
	local detailed = filled and state.detail == true and not state.source and not state.target
	refs.detail.Visible = detailed
	refs.detail.Text = detailed and InventoryPanel.Describe(slot) or ""
	if detailed then
		refs.icon.Visible = false
		refs.count.Visible = false
	end

	if filled then
		local color = Rarity.Color(slot.rarity)
		refs.name.Text = slot.name or slot.id
		refs.name.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.15)
		refs.bar.BackgroundColor3 = color
		refs.glow.BackgroundColor3 = color
		if slot.kind == "item" then
			refs.sub.Text = string.upper(slot.rarity or "")
			refs.count.Text = "x" .. tostring(slot.count or 1)
			refs.count.TextColor3 = C.Text
		else
			refs.sub.Text = string.format("%s  •  %d reserve", string.upper(slot.rarity or ""), slot.reserve or 0)
			refs.count.Text = string.format("%d/%d", slot.mag or 0, slot.magSize or 0)
			refs.count.TextColor3 = (slot.mag or 0) == 0 and C.Red or C.Text
		end
	end

	-- The outline says what's going on with this card.
	local stroke = refs.stroke
	if state.target then
		stroke.Color, stroke.Thickness, stroke.Transparency = TARGET, 4, 0
	elseif state.selected then
		stroke.Color, stroke.Thickness, stroke.Transparency = SELECT, 4, 0
	elseif state.held then
		stroke.Color, stroke.Thickness, stroke.Transparency = GOLD, 2.5, 0.2
	elseif filled then
		stroke.Color, stroke.Thickness, stroke.Transparency = Rarity.Color(slot.rarity), 1.5, 0.45
	else
		stroke.Color, stroke.Thickness, stroke.Transparency = C.PanelAlt, 1.5, 0.3
	end
	for _, item in ipairs({ refs.icon, refs.name, refs.sub, refs.count, refs.key, refs.tag, refs.bar }) do
		if item:IsA("TextLabel") then
			item.TextTransparency = state.source and 0.6 or 0
		end
	end
	refs.card.BackgroundTransparency = state.source and 0.6 or refs.card.BackgroundTransparency
	refs.icon.ImageTransparency = state.source and 0.7 or 0
end

-- The slots as shown: the server's, or the local guess after a swap until the server confirms.
function InventoryPanel:_render()
	local slots = self.shownSlots or (self.loadout and self.loadout.slots) or {}
	local held = self.shownEquipped
	if held == nil and self.loadout then
		held = self.loadout.equipped
	end
	local used = 0
	for index = 1, SLOT_COUNT do
		local slot = slots[index]
		if slot then
			used += 1
		end
		local drag = self.drag
		self:_paintCard(self.cards[index], slot, {
			held = held == index,
			selected = self.selected == index,
			target = drag ~= nil and drag.active and drag.hover == index and drag.hover ~= drag.from,
			source = drag ~= nil and drag.active and drag.from == index,
			detail = (self.selected == index or self.hovered == index) and not (drag ~= nil and drag.active),
		})
	end
	local closeKey = self.options.closeKeyLabel and self.options.closeKeyLabel()
	self.footRight.Text = string.format("%d / %d slots used%s", used, SLOT_COUNT, closeKey and ("   •   [" .. closeKey .. "] close") or "")
	-- DROP is offered only for a selected slot that actually holds something: an empty slot has
	-- nothing to put on the ground, and a button that refuses is worse than one that isn't there.
	local canDrop = self.selected ~= nil and slots[self.selected] ~= nil
	if self.dropButton then
		self.dropButton.Visible = canDrop
	end

	if self.selected then
		self.hint.Text = string.format("Now tap where slot %s goes, or DROP to put it on the ground.",
			self.options.keyLabel and self.options.keyLabel(self.selected) or tostring(self.selected))
		self.hint.TextColor3 = SELECT
	else
		self.hint.Text = "Drag a slot onto another to swap them. Tap one to move or drop it."
		self.hint.TextColor3 = C.Muted
	end
end

--------------------------------------------------------------------------------
-- Swapping
--------------------------------------------------------------------------------

function InventoryPanel:_swap(a, b)
	if a == b or not self.loadout then
		return
	end
	local slots = table.clone(self.shownSlots or self.loadout.slots)
	if not slots[a] and not slots[b] then
		return
	end
	slots[a], slots[b] = slots[b], slots[a]
	local held = self.shownEquipped
	if held == nil then
		held = self.loadout.equipped
	end
	if held == a then
		held = b
	elseif held == b then
		held = a
	end
	self.shownSlots, self.shownEquipped = slots, held
	self.selected = nil
	self:_render()
	for _, index in ipairs({ a, b }) do
		local refs = self.cards[index]
		refs.scale.Scale = 0.86
		tween(refs.scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	if self.options.onSwap then
		self.options.onSwap(a, b)
	end
	-- If the server doesn't answer with a new loadout, it refused: show what it last said.
	self.token += 1
	local token = self.token
	task.delay(CONFIRM_WAIT, function()
		if token == self.token and self.shownSlots then
			self.shownSlots, self.shownEquipped = nil, nil
			self:_render()
		end
	end)
end

function InventoryPanel:_tap(index)
	if not self.loadout then
		return
	end
	local slots = self.shownSlots or self.loadout.slots
	if self.selected == nil then
		if slots[index] then
			self.selected = index
		end
	elseif self.selected == index then
		self.selected = nil
	else
		self:_swap(self.selected, index)
		return
	end
	self:_render()
end

--------------------------------------------------------------------------------
-- Pointer: press, drag, release. Mouse and touch alike.
--------------------------------------------------------------------------------

function InventoryPanel:_cardAt(position)
	for index, refs in ipairs(self.cards) do
		local at, size = refs.card.AbsolutePosition, refs.card.AbsoluteSize
		if position.X &gt;= at.X and position.X &lt;= at.X + size.X and position.Y &gt;= at.Y and position.Y &lt;= at.Y + size.Y then
			return index
		end
	end
	return nil
end

-- `position` is in screen pixels. The lifted card lives in the panel's parent, which in a gallery is a
-- scaled mock screen rather than the ScreenGui itself, so undo that parent's scale too.
function InventoryPanel:_moveLifted(position)
	local parent = self.lifted.card.Parent
	local origin, scale = Vector2.zero, 1
	if parent:IsA("GuiObject") then
		origin = parent.AbsolutePosition
		if parent.Size.X.Offset &gt; 0 then
			scale = parent.AbsoluteSize.X / parent.Size.X.Offset
		end
	end
	self.lifted.card.Position = UDim2.fromOffset((position.X - origin.X) / scale, (position.Y - origin.Y) / scale)
end

function InventoryPanel:_connectPointer()
	for index, refs in ipairs(self.cards) do
		refs.card.InputBegan:Connect(function(input)
			if not self.open then
				return
			end
			local kind = input.UserInputType
			if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
				return
			end
			if self.drag then
				return
			end
			self.drag = { from = index, start = Vector2.new(input.Position.X, input.Position.Y), input = input, active = false, hover = nil }
		end)
		-- Hovering a card shows its detail (#86 C14); a tap does too, by selecting it. A gamepad's
		-- selection counts as hovering, since it has no pointer.
		local function hover(on)
			if on then
				self.hovered = index
			elseif self.hovered == index then
				self.hovered = nil
			end
			if self.open then
				self:_render()
			end
		end
		refs.card.MouseEnter:Connect(function()
			hover(true)
		end)
		refs.card.MouseLeave:Connect(function()
			hover(false)
		end)
		refs.card.SelectionGained:Connect(function()
			hover(true)
		end)
		refs.card.SelectionLost:Connect(function()
			hover(false)
		end)
		-- A gamepad pressing A on a selected card taps it (there's no pointer to drag with).
		refs.card.Activated:Connect(function(input)
			if self.open and input and string.sub(input.UserInputType.Name, 1, 7) == "Gamepad" then
				self:_tap(index)
			end
		end)
	end

	UserInputService.InputChanged:Connect(function(input)
		local drag = self.drag
		if not drag or not self.open then
			return
		end
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseMovement and not (kind == Enum.UserInputType.Touch and (input == drag.input or drag.input.UserInputType ~= Enum.UserInputType.Touch)) then
			return
		end
		local position = Vector2.new(input.Position.X, input.Position.Y)
		if not drag.active then
			local slots = self.shownSlots or (self.loadout and self.loadout.slots) or {}
			if (position - drag.start).Magnitude &lt; DRAG_START or not slots[drag.from] then
				return
			end
			drag.active = true
			self.selected = nil
			local lifted = self.lifted
			self:_paintCard(lifted, slots[drag.from], { selected = true })
			lifted.key.Text = self.options.keyLabel and self.options.keyLabel(drag.from) or tostring(drag.from)
			lifted.card.Size = UDim2.fromOffset(CARD_W * self.scale.Scale, CARD_H * self.scale.Scale)
			self.liftedScale.Scale = 1
			lifted.card.Rotation = -4
			lifted.card.Visible = true
		end
		self:_moveLifted(position)
		local hover = self:_cardAt(position)
		if hover ~= drag.hover then
			drag.hover = hover
			self:_render()
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local drag = self.drag
		if not drag then
			return
		end
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then
			return
		end
		if kind == Enum.UserInputType.Touch and drag.input.UserInputType == Enum.UserInputType.Touch and input ~= drag.input then
			return
		end
		self.drag = nil
		self.lifted.card.Visible = false
		if not self.open then
			return
		end
		if drag.active then
			local target = self:_cardAt(Vector2.new(input.Position.X, input.Position.Y))
			if target and target ~= drag.from then
				self:_swap(drag.from, target)
			else
				self:_render()
			end
		elseif self:_cardAt(Vector2.new(input.Position.X, input.Position.Y)) == drag.from then
			self:_tap(drag.from)
		end
	end)
end

--------------------------------------------------------------------------------
-- Opening, closing, updates
--------------------------------------------------------------------------------

-- The panel's size for a viewport. Kept as the target, so an open or a resize mid-animation always
-- settles at the right size rather than wherever the pop happened to be.
function InventoryPanel:SetViewport(viewport)
	self:_setColumns(InventoryPanel.ColumnsFor(viewport))
	self.targetScale = InventoryPanel.ScaleFor(viewport)
	self.scale.Scale = self.targetScale
end

-- Re-lays the same eight cards into a different grid when the shape of the screen changes.
function InventoryPanel:_setColumns(columns)
	if self.columns == columns then
		return
	end
	self.columns = columns
	local size = panelSize(columns)
	local rows = math.ceil(SLOT_COUNT / columns)
	self.root.Size = UDim2.fromOffset(size.X, size.Y)
	self.grid.Size = UDim2.fromOffset(size.X - PAD * 2, rows * CARD_H + (rows - 1) * GAP)
	for index, refs in ipairs(self.cards) do
		local column = (index - 1) % columns
		local row = math.floor((index - 1) / columns)
		refs.card.Position = UDim2.fromOffset(column * (CARD_W + GAP) + CARD_W / 2, row * (CARD_H + GAP) + CARD_H / 2)
	end
end

-- A fresh loadout from the server: it's the truth, so any local guess is dropped.
function InventoryPanel:SetLoadout(loadout)
	self.loadout = loadout
	self.shownSlots, self.shownEquipped = nil, nil
	self.token += 1
	if not loadout then
		self.selected = nil
	end
	if self.drag and loadout and not loadout.slots[self.drag.from] then
		self.drag = nil
		self.lifted.card.Visible = false
	end
	if self.open then
		self:_render()
	end
end

function InventoryPanel:IsOpen()
	return self.open
end

function InventoryPanel:Open(loadout)
	if loadout ~= nil then
		self.loadout = loadout
	end
	self.shownSlots, self.shownEquipped, self.selected, self.drag = nil, nil, nil, nil
	self.open = true
	self:_render()
	self.overlay.Visible = true
	self.root.Visible = true
	self.overlay.BackgroundTransparency = 1
	self.root.GroupTransparency = 1
	local scale = self.targetScale or self.scale.Scale
	tween(self.overlay, 0.2, { BackgroundTransparency = 0.45 })
	tween(self.root, 0.18, { GroupTransparency = 0 })
	self.scale.Scale = scale * 0.94
	tween(self.scale, 0.28, { Scale = scale }, Enum.EasingStyle.Back)
	-- A gamepad has no pointer: start its selection on the card in hand (or the first).
	if UserInputService.GamepadEnabled then
		local held = self.loadout and self.loadout.equipped
		GuiService.SelectedObject = self.cards[held or 1].card
	end
end

-- `byPanel` is true when the panel closed itself (overlay, close button), so the caller hears about it.
function InventoryPanel:Close(byPanel)
	if not self.open then
		return
	end
	self.open = false
	self.selected, self.drag, self.hovered = nil, nil, nil
	self.lifted.card.Visible = false
	local selected = GuiService.SelectedObject
	if selected and selected:IsDescendantOf(self.root) then
		GuiService.SelectedObject = nil
	end
	local token = self.token + 1
	self.token = token
	tween(self.overlay, 0.15, { BackgroundTransparency = 1 })
	tween(self.root, 0.15, { GroupTransparency = 1 })
	task.delay(0.16, function()
		if not self.open then
			self.overlay.Visible = false
			self.root.Visible = false
		end
	end)
	if byPanel and self.options.onClose then
		self.options.onClose()
	end
end

-- For galleries: open instantly, with a slot selected or a drag frozen part way (from, over, pointer).
function InventoryPanel:Snap(loadout, state)
	state = state or {}
	self.loadout = loadout
	self.open = true
	self.overlay.Visible = true
	self.overlay.BackgroundTransparency = 0.45
	self.root.Visible = true
	self.root.GroupTransparency = 0
	self.selected = state.selected
	self.drag = nil
	if state.dragFrom then
		self.drag = { from = state.dragFrom, active = true, hover = state.dragOver, start = Vector2.zero }
	end
	self:_render()
	if state.dragFrom and state.pointer then
		local lifted = self.lifted
		self:_paintCard(lifted, loadout.slots[state.dragFrom], { selected = true })
		lifted.key.Text = tostring(state.dragFrom)
		lifted.card.Size = UDim2.fromOffset(CARD_W * self.scale.Scale, CARD_H * self.scale.Scale)
		lifted.card.Rotation = -4
		lifted.card.Visible = true
		self:_moveLifted(state.pointer)
	end
end

InventoryPanel.CardAt = InventoryPanel._cardAt

return InventoryPanel
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX164"><Properties><string name="Name">KeyHintClient</string><ProtectedString name="Source">-- World labels that name a key: the ready pad's "(or press [F] anywhere)", the companion practice
-- sign. Every player can rebind those keys, so the server writes such a label without naming one
-- and tags it "KeyHint" with a template in its KeyHint attribute, {ActionId} standing for a
-- Settings action's key. This fills the template in with this player's own key, and again when a
-- binding changes. On a gamepad or a touch screen a keyboard key means nothing, so there the
-- server's key-free wording stays.

local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")

local Settings = require(script.Parent:WaitForChild("Settings"))

local TAG = "KeyHint"

-- The server's wording for each label, kept to go back to when the player picks up a gamepad.
--
-- A strong table cleared on Destroying, not a weak-keyed one: Roblox collects an Instance's Lua
-- handle as soon as nothing but a weak table holds it, so a weak table here would quietly lose the
-- original wording of a label that is still on screen — and the next fill would take the text it had
-- already written as the "server's" version, so a player who picked up a gamepad would be shown a
-- keyboard key anyway.
local serverText = {}

local function onKeyboard()
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch or string.find(last.Name, "Gamepad", 1, true) then
		return false
	end
	return UserInputService.KeyboardEnabled
end

local keyboard = onKeyboard()

local function fill(label)
	local template = label:GetAttribute("KeyHint")
	if not label:IsA("TextLabel") or type(template) ~= "string" then
		return
	end
	if serverText[label] == nil then
		serverText[label] = label.Text
		label.Destroying:Connect(function()
			serverText[label] = nil
		end)
	end
	if not keyboard then
		label.Text = serverText[label]
		return
	end
	local ok, text = pcall(function()
		return (string.gsub(template, "{(%w+)}", function(actionId)
			return Settings.KeyLabel(actionId)
		end))
	end)
	label.Text = ok and text or serverText[label]
end

local function fillAll()
	for _, label in ipairs(CollectionService:GetTagged(TAG)) do
		fill(label)
	end
end

CollectionService:GetInstanceAddedSignal(TAG):Connect(fill)
fillAll()

Settings.Changed:Connect(fillAll)

UserInputService.LastInputTypeChanged:Connect(function()
	local now = onKeyboard()
	if now ~= keyboard then
		keyboard = now
		fillAll()
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX165"><Properties><string name="Name">KillAnimFxClient</string><ProtectedString name="Source">-- The client half of KillAnimService (#24): the death effect ("kill animation" in the code and the
-- save) a player has equipped, played on their victim. The server sends { id, position, body }:
-- `body` is the victim's character when the server has claimed it for the effect (anchored it, and
-- will hide it once the effect is over), and nil when it couldn't (a gun's own kill effect already
-- has it, or it's gone). The effects themselves, and the engine they run on, are in Shared
-- (DeathEffectDesigns, DeathEffectFx), because the shop's previews play the very same ones.
--
-- Budgets, on top of each effect's own part, particle and light caps (DeathEffectFx):
--   * at most MAX_LIVE effects at once; one past that is skipped, not queued
--   * nothing further than CULL_DISTANCE studs from the camera is built at all
--   * each effect is destroyed at its design's `life`, never over MAX_LIFETIME
-- A skipped or culled effect still takes care of its body: a claimed body is faded out here, cheaply,
-- so it never stands frozen until the server hides it.
-- tools/killanim_check.py runs this file, the engine and every design on a stand-in clock and checks
-- all of it, and that nothing is left running once an effect's folder is gone.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local DeathEffectFx = require(Shared:WaitForChild("DeathEffectFx"))
local Designs = require(Shared:WaitForChild("DeathEffectDesigns"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local killAnimFx = Remotes.Event("KillAnimFx")

local MAX_LIVE = 4
local MAX_LIFETIME = DeathEffectFx.MAX_LIFETIME
local CULL_DISTANCE = 260

-- How far below the body's root the ground usually is (root half-height plus hip height), used
-- when the ray down finds nothing but bodies.
local ROOT_TO_GROUND = 3

-- How long a skipped effect's body takes to fade.
local FALLBACK_FADE = 0.5

local V = Vector3.new

-- Running effects: { fx, t, life }, stepped every frame by one Heartbeat connection that exists only
-- while something is running. Time is the sum of frame deltas (not os.clock, which is CPU time).
local running = {}
local connection

--------------------------------------------------------------------------------
-- Stepping
--------------------------------------------------------------------------------

local function stepAll(dt)
	for index = #running, 1, -1 do
		local entry = running[index]
		entry.t += dt
		if entry.t &gt;= entry.life then
			entry.fx:destroy()
			table.remove(running, index)
		else
			local ok, err = pcall(entry.fx.step, entry.fx, entry.t)
			if not ok then
				warn("[KillAnimFxClient] " .. entry.id .. ": " .. tostring(err))
				entry.fx:destroy()
				table.remove(running, index)
			end
		end
	end
	if #running == 0 and connection then
		connection:Disconnect()
		connection = nil
	end
end

local function start(entry)
	table.insert(running, entry)
	if not connection then
		connection = RunService.Heartbeat:Connect(stepAll)
	end
end

--------------------------------------------------------------------------------
-- Playing one
--------------------------------------------------------------------------------

-- The ground under the body. The ray skips every character and the body itself; if it still lands
-- on something with a Humanoid (a bot's body), or nothing, assume the usual height.
local function groundUnder(position, body)
	local skip = {}
	for _, other in ipairs(Players:GetPlayers()) do
		if other.Character then
			table.insert(skip, other.Character)
		end
	end
	if body then
		table.insert(skip, body)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = skip
	local hit = workspace:Raycast(position, V(0, -12, 0), params)
	if hit and not (hit.Instance.Parent and hit.Instance.Parent:FindFirstChildOfClass("Humanoid")) then
		return hit.Position
	end
	return position - V(0, ROOT_TO_GROUND, 0)
end

-- A claimed body whose effect isn't being built here: faded out, no parts made. Stepped like an
-- effect so it's torn down the same way.
local function fadeBody(body, position)
	local fx = DeathEffectFx.new({ parent = workspace, name = "KillAnimFx", origin = position, life = FALLBACK_FADE,
		body = body, ownsBody = true })
	fx:tween(0, FALLBACK_FADE, function(e)
		fx:bodyPose({ fade = e })
	end, DeathEffectFx.Ease.quadIn)
	start({ fx = fx, t = 0, life = FALLBACK_FADE, id = "fade", cheap = true })
end

-- Effects running now, not counting body fades (they make no parts, so they don't count against
-- MAX_LIVE).
local function liveCount()
	local count = 0
	for _, entry in ipairs(running) do
		if not entry.cheap then
			count += 1
		end
	end
	return count
end

local function play(id, position, body)
	local design = Designs.Get(id)
	if not design then
		return
	end
	local camera = workspace.CurrentCamera
	local far = camera and (camera.CFrame.Position - position).Magnitude &gt; CULL_DISTANCE
	if far or liveCount() &gt;= MAX_LIVE then
		if body then
			fadeBody(body, position)
		end
		return
	end

	local life = math.min(design.life, MAX_LIFETIME)
	local fx = DeathEffectFx.new({
		parent = workspace,
		name = "KillAnimFx",
		origin = position,
		ground = groundUnder(position, body),
		life = life,
		body = body,
		ownsBody = body ~= nil,
		seed = math.random(1, 1000000),
		sound = function(cue, at, jitter)
			Sfx.PlayAt(cue, at, jitter)
		end,
	})
	local entry = { fx = fx, t = 0, life = life, id = id }
	local ok, err = pcall(design.build, fx)
	if ok then
		ok, err = pcall(fx.step, fx, 0)
	end
	if not ok then
		warn("[KillAnimFxClient] " .. id .. ": " .. tostring(err))
		fx:destroy()
		if body then
			fadeBody(body, position)
		end
		return
	end
	start(entry)
end

killAnimFx.OnClientEvent:Connect(function(data)
	if type(data) ~= "table" or type(data.id) ~= "string" or typeof(data.position) ~= "Vector3" then
		return
	end
	-- Only a Model still in the world counts as a body; anything else plays without one.
	local body = typeof(data.body) == "Instance" and data.body:IsA("Model") and data.body:IsDescendantOf(workspace) and data.body or nil
	play(data.id, data.position, body)
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX166"><Properties><string name="Name">KillFeedback</string><ProtectedString name="Source">-- Kill feedback (Oliver, 2026-09-22: "make it more satisfying to get a kill").
--
-- HudClient already flashes "ELIM" on the hitmarker and plays the elimination thud. This adds the
-- payoff on top, for the shooter only:
--   * a two-note rising chime, higher with every kill in a chain (4 s between kills keeps it going)
--   * words that pop in under the crosshair with a bounce: ELIMINATED / HEADSHOT, then x2, x3...
--     (There was a ✕ mark above them; it read as a random red crosshair, so it was taken out.)
--   * a quick bright flash round the screen edge, gold for a headshot
--   * a skull that rises and fades where the target went down
-- It's its own script because HudClient's main chunk is at Luau's 200-local limit. It listens to the
-- same DamageDealt remote, so it needs no server change.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local player = Players.LocalPlayer
local damageDealt = Remotes.Event("DamageDealt")

local ACCENT = Color3.fromRGB(255, 214, 72)
local HEAD = Color3.fromRGB(255, 170, 40)
local WHITE = Color3.new(1, 1, 1)
local CHAIN_WINDOW = 4

local gui = Instance.new("ScreenGui")
gui.Name = "KillFeedback"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 6
gui.Parent = player:WaitForChild("PlayerGui")

-- The edge flash: four gradients, like the low-health vignette, so the middle stays clear.
local flashEdges = {}
for _, side in ipairs({ "Top", "Bottom", "Left", "Right" }) do
	local vertical = side == "Top" or side == "Bottom"
	local edge = Instance.new("Frame")
	edge.Size = vertical and UDim2.new(1, 0, 0.22, 0) or UDim2.new(0.18, 0, 1, 0)
	edge.Position = (side == "Bottom" and UDim2.fromScale(0, 0.78)) or (side == "Right" and UDim2.fromScale(0.82, 0))
		or UDim2.fromScale(0, 0)
	edge.BackgroundColor3 = ACCENT
	edge.BackgroundTransparency = 1
	edge.BorderSizePixel = 0
	edge.Parent = gui
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = (side == "Top" and 90) or (side == "Bottom" and 270) or (side == "Left" and 0) or 180
	gradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	gradient.Parent = edge
	table.insert(flashEdges, edge)
end

-- The badge under the crosshair.
local badge = Instance.new("Frame")
badge.AnchorPoint = Vector2.new(0.5, 0)
badge.Position = UDim2.new(0.5, 0, 0.5, 70)
badge.Size = UDim2.fromOffset(260, 74)
badge.BackgroundTransparency = 1
badge.Parent = gui
local badgeScale = Instance.new("UIScale")
badgeScale.Parent = badge

local words = Instance.new("TextLabel")
words.AnchorPoint = Vector2.new(0.5, 0)
words.Position = UDim2.new(0.5, 0, 0, 0)
words.Size = UDim2.fromOffset(260, 26)
words.BackgroundTransparency = 1
words.Font = Enum.Font.FredokaOne
words.Text = ""
words.TextSize = 22
words.TextColor3 = WHITE
words.TextStrokeColor3 = Color3.fromRGB(20, 12, 30)
words.TextStrokeTransparency = 1
words.TextTransparency = 1
words.Parent = badge

local chain, lastKillAt, token = 0, -math.huge, 0

local function skullAt(position)
	if typeof(position) ~= "Vector3" then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Position = position + Vector3.new(0, 2.5, 0)
	anchor.Parent = workspace.CurrentCamera
	local board = Instance.new("BillboardGui")
	board.Size = UDim2.fromOffset(80, 80)
	board.AlwaysOnTop = true
	board.LightInfluence = 0
	board.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = "☠"
	label.TextScaled = true
	label.TextColor3 = WHITE
	label.TextStrokeTransparency = 0.3
	label.Parent = board
	TweenService:Create(board, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ StudsOffset = Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.5),
		{ TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1.1, function()
		anchor:Destroy()
	end)
end

damageDealt.OnClientEvent:Connect(function(_, wasKill, position, _, headshot, kind)
	if not wasKill or kind == "structure" then
		return
	end
	-- Wall time: os.clock is CPU time in Roblox and stretches the chain window under load.
	local now = tick()
	chain = (now - lastKillAt &lt;= CHAIN_WINDOW) and chain + 1 or 1
	lastKillAt = now
	token += 1
	local mine = token

	-- Sound: two notes a step apart, the whole thing climbing with the chain.
	local base = 1 + math.min(chain - 1, 5) * 0.09
	Sfx.Play("KillConfirm", 0, base)
	task.delay(0.075, function()
		Sfx.Play("KillConfirm", 0, base * 1.26)
	end)
	if headshot then
		task.delay(0.15, function()
			Sfx.Play("KillConfirm", 0, base * 1.5)
		end)
	end

	-- Badge.
	local colour = headshot and HEAD or ACCENT
	-- The server's own streak banner already names DOUBLE KILL and up, so this only counts.
	local word = headshot and "HEADSHOT" or "ELIMINATED"
	if chain &gt;= 2 then
		word ..= "  x" .. chain
	end
	words.Text = word
	words.TextColor3 = colour
	words.TextTransparency = 0
	words.TextStrokeTransparency = 0.35
	badgeScale.Scale = 1.7 + math.min(chain - 1, 3) * 0.15
	TweenService:Create(badgeScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	-- Edge flash.
	for _, edge in ipairs(flashEdges) do
		edge.BackgroundColor3 = colour
		edge.BackgroundTransparency = 0.55
		TweenService:Create(edge, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 1 }):Play()
	end

	skullAt(position)

	task.delay(0.9, function()
		if mine ~= token then
			return
		end
		local fade = TweenInfo.new(0.35)
		TweenService:Create(words, fade, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX167"><Properties><string name="Name">LootFxClient</string><ProtectedString name="Source">-- Opening animations for chests and supply crates on the map.
--
-- The server marks a claimed container with an "Opened" attribute (and "LootRarity" for what
-- came out) and keeps it around for a moment before removing it. Here, locally: the lid swings
-- back on its hinge, a column of light in the loot's rarity colour shoots up, and sparks
-- scatter. Nothing replicates.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarity = require(Shared:WaitForChild("Rarity"))

local Sfx = require(script.Parent:WaitForChild("Sfx"))

local EFFECT_DISTANCE = 400
local CONTAINERS = { Chest = true, SupplyCrate = true }

local camera = workspace.CurrentCamera
-- Containers already wired up, dropped when they're destroyed. (A weak-keyed table loses live
-- Instances: Roblox collects an instance's Lua handle when only a weak table holds it.)
local watched = {}

local fxFolder = Instance.new("Folder")
fxFolder.Name = "LootFx"
fxFolder.Parent = workspace

local function neon(size, cframe, color, transparency)
	local part = Instance.new("Part")
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = Enum.Material.Neon
	part.Transparency = transparency or 0
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = fxFolder
	return part
end

local function swingLid(container)
	local lid = container:FindFirstChild("Lid")
	if not lid or not lid:IsA("BasePart") then
		return
	end

	-- Supply crate lids are welded so they fall with the crate; free this copy to animate it.
	local weld = lid:FindFirstChildOfClass("WeldConstraint")
	if weld then
		weld.Enabled = false
	end
	lid.Anchored = true

	-- Anything decorating the lid (bands, the lock) swings with it.
	local attached = {}
	for _, descendant in ipairs(lid:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(attached, { part = descendant, offset = lid.CFrame:ToObjectSpace(descendant.CFrame) })
		end
	end

	-- Hinged along the back edge (+Z; containers face -Z), swinging the front up and over.
	local length = lid.Size.Z
	local hinge = lid.CFrame * CFrame.new(0, 0, length / 2)

	local driver = Instance.new("NumberValue")
	driver.Changed:Connect(function(value)
		if not lid.Parent then
			return
		end
		local frame = hinge * CFrame.Angles(math.rad(105) * value, 0, 0) * CFrame.new(0, 0, -length / 2)
		lid.CFrame = frame
		for _, entry in ipairs(attached) do
			entry.part.CFrame = frame * entry.offset
		end
	end)
	TweenService:Create(driver, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = 1 }):Play()
	task.delay(0.6, function()
		driver:Destroy()
	end)
end

local function playOpen(container)
	if not container.Parent then
		return
	end
	local position = container.Position
	if (position - camera.CFrame.Position).Magnitude &gt; EFFECT_DISTANCE then
		return
	end

	local color = Rarity.Color(container:GetAttribute("LootRarity") or "Rare")
	local top = position + Vector3.new(0, container.Size.Y / 2, 0)

	swingLid(container)
	Sfx.PlayAt("CrateOpen", position, 0.1)

	-- Column of light.
	local column = neon(Vector3.new(1.4, 0.5, 1.4), CFrame.new(top), color, 0.15)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 20
	light.Brightness = 4
	light.Parent = column
	TweenService:Create(column, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.4, 16, 0.4),
		CFrame = CFrame.new(top + Vector3.new(0, 8, 0)),
		Transparency = 1,
	}):Play()
	TweenService:Create(light, TweenInfo.new(0.8), { Brightness = 0 }):Play()
	task.delay(0.85, function()
		column:Destroy()
	end)

	-- Sparks.
	for _ = 1, 10 do
		local spark = neon(Vector3.new(0.35, 0.35, 0.35), CFrame.new(top), color, 0)
		local direction = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
		direction = direction.Magnitude &gt; 0.01 and direction.Unit or Vector3.new(1, 0, 0)
		local goal = top + direction * (3 + math.random() * 3) + Vector3.new(0, 3 + math.random() * 4, 0)
		local time = 0.55 + math.random() * 0.35
		TweenService:Create(spark, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = CFrame.new(goal) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
			Transparency = 1,
		}):Play()
		task.delay(time + 0.05, function()
			spark:Destroy()
		end)
	end
end

local function watch(item)
	if watched[item] or not item:IsA("BasePart") or not CONTAINERS[item.Name] then
		return
	end
	watched[item] = true
	item.Destroying:Connect(function()
		watched[item] = nil
	end)
	item:GetAttributeChangedSignal("Opened"):Connect(function()
		if item:GetAttribute("Opened") then
			playOpen(item)
		end
	end)
end

-- Loot and SupplyDrops folders are recreated every match, so watch for them arriving.
local function watchFolder(name)
	local function hook(folder)
		if folder.Name ~= name or not folder:IsA("Folder") then
			return
		end
		for _, child in ipairs(folder:GetChildren()) do
			watch(child)
		end
		folder.ChildAdded:Connect(watch)
	end

	local existing = workspace:FindFirstChild(name)
	if existing then
		hook(existing)
	end
	workspace.ChildAdded:Connect(hook)
end

watchFolder("Loot")
watchFolder("SupplyDrops")
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX168"><Properties><string name="Name">MenuClient</string><ProtectedString name="Source">-- The lobby menu: brainrot collection, crates, cosmetics, the Brainrot Pass, and the
-- Robux shop. Everything is built in code; there is no GUI to assemble in Studio.

local ContextActionService = game:GetService("ContextActionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BattlePassData = require(Shared:WaitForChild("BattlePassData"))
local BrainrotData = require(Shared:WaitForChild("BrainrotData"))
local BrainrotModels = require(Shared:WaitForChild("BrainrotModels"))
local CrateModels = require(Shared:WaitForChild("CrateModels"))
local ParachuteModels = require(Shared:WaitForChild("ParachuteModels"))
local CosmeticData = require(Shared:WaitForChild("CosmeticData"))
local CrateData = require(Shared:WaitForChild("CrateData"))
local ShopRotation = require(Shared:WaitForChild("ShopRotation"))
local GamepassConfig = require(Shared:WaitForChild("GamepassConfig"))
local QuestData = require(Shared:WaitForChild("QuestData"))
local Rarity = require(Shared:WaitForChild("Rarity"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Settings = require(script.Parent:WaitForChild("Settings"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local UiParts = require(script.Parent:WaitForChild("UiParts"))
local MergeDialog = require(script.Parent:WaitForChild("MergeDialog"))
local ProgressionPanel = require(script.Parent:WaitForChild("ProgressionPanel"))
-- #78: which HUD button opens which tabs, each tab's look, row previews and the Death Effects tab.
local MenuScreens = require(script.Parent:WaitForChild("MenuScreens"))

local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local profileChanged = Remotes.Event("ProfileChanged")
local crateOpened = Remotes.Event("CrateOpened")
local bundleGranted = Remotes.Event("BundleGranted")
local requestProfile = Remotes.Function("RequestProfile")
local buyCrate = Remotes.Function("BuyCrate")
local openCrate = Remotes.Function("OpenCrate")
local sellBrainrot = Remotes.Function("SellBrainrot")
local sellAllOfRarity = Remotes.Function("SellAllOfRarity")
local sellDuplicates = Remotes.Function("SellDuplicates")
local mergeBrainrot = Remotes.Function("MergeBrainrot")
local buyBrainrot = Remotes.Function("BuyBrainrot")
local buyCosmetic = Remotes.Function("BuyCosmetic")
local equipCosmetic = Remotes.Function("EquipCosmetic")
local claimPassTier = Remotes.Function("ClaimPassTier")
local claimPassAll = Remotes.Function("ClaimPassAll")
local claimDaily = Remotes.Function("ClaimDaily")
local setTitle = Remotes.Function("SetTitle")
local setShowcase = Remotes.Function("SetShowcase")
local setCompanion = Remotes.Function("SetCompanion")
local requestTrade = Remotes.Function("RequestTrade")
local respondTrade = Remotes.Function("RespondTrade")
local tradeOffer = Remotes.Function("TradeOffer")
local tradeConfirm = Remotes.Function("TradeConfirm")
local tradeCancel = Remotes.Function("TradeCancel")
local tradeInvite = Remotes.Event("TradeInvite")
local tradeChanged = Remotes.Event("TradeChanged")

local create, rounded, padding = UiKit.create, UiKit.rounded, UiKit.padding
local clearItems, formatNumber = UiKit.clearItems, UiKit.formatNumber
local C = UiKit.Colors

local profile = nil
local activeTab = "Brainrots"
-- Which rarity the Brainrots tab is showing, or "All".
local brainrotFilter = "All"
local trade = { active = false }

local screenGui = create("ScreenGui", {
	Name = "BrrMenu",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})

--------------------------------------------------------------------------------
-- Coin counter + menu button
--------------------------------------------------------------------------------

local coinChip = create("Frame", {
	Position = UDim2.new(0, 16, 0, 78),
	Size = UDim2.new(0, 210, 0, 44),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.15,
	BorderSizePixel = 0,
	Parent = screenGui,
}, { rounded(10), padding(10) })

local coinIcon = create("Frame", {
	Size = UDim2.fromOffset(24, 24),
	Position = UDim2.new(0, 0, 0.5, -12),
	BackgroundColor3 = C.Accent,
	BorderSizePixel = 0,
	Parent = coinChip,
}, { rounded(12) })

create("TextLabel", {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "S",
	TextColor3 = Color3.fromRGB(90, 62, 0),
	TextSize = 15,
	Parent = coinIcon,
})

local coinLabel = create("TextLabel", {
	Position = UDim2.new(0, 32, 0, 0),
	Size = UDim2.new(1, -32, 1, 0),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "0",
	TextColor3 = C.Accent,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextSize = 22,
	Parent = coinChip,
})

--------------------------------------------------------------------------------
-- Panel scaffolding
--------------------------------------------------------------------------------

-- The frame is MenuShell's now (claude-ee, Oliver's #20 and the three-version work). It sizes itself
-- to the screen and picks one of three layouts — rail, icon rail or bottom bar — where this panel
-- used to be a fixed 760x480 whatever the screen was: 40% of a 1080p monitor and 123% of the HEIGHT
-- of a phone, with the bottom of every tab off the edge.
--
-- Nothing below this block changed. `panel` is the shell's full-screen layer, so the fifteen
-- `panel.Visible` reads and its two GetPropertyChangedSignal listeners mean what they always meant
-- ("is the menu open"), and `content` is a list-laid frame inside the shell's scrolling area, so all
-- eight renderers draw into exactly what they drew into before and keep their owners.
local MenuShell = require(script.Parent:WaitForChild("MenuShell"))
local shell = MenuShell.new({ parent = screenGui, title = "BRAINROT BATTLES" })
local panel = shell.layer

-- THE SHELL HAS TO BE TOLD WHAT SCREEN IT IS ON, and nothing told it (Oliver's #65).
--
-- `MenuShell.new` falls back to Vector2.new(1280, 720) when no viewport is passed, and this file
-- passed none and never called SetViewport afterwards -- the only caller anywhere in the project
-- was tools/menu_hud_gallery.lua. So the panel was a fixed 1100x619 on every screen in the game,
-- the fit scale was computed for a screen the player does not have, and `UiKit.form` was asked
-- about 1280x720 every single time: THE `short` AND `tall` VERSIONS NEVER RAN IN THE GAME AT ALL.
-- They ran in the gallery, which is why they looked finished.
--
-- The watching itself is the shell's (MenuShell:BindViewport) rather than a block here, because
-- this file is a LocalScript and nothing in the harness can run a LocalScript -- so wiring written
-- here is wiring no probe can check, which is exactly how its absence went unnoticed.
shell:BindViewport()

-- The title, the close button and the tab strip are the shell's header and navigation now. The
-- FitPanel call is gone too: the shell sizes the panel from the viewport and applies PhoneLayout's
-- own PanelScale itself, so fitting a fixed 760x480 would be fitting a size nothing draws.

-- What every renderer draws into. A frame rather than the ScrollingFrame itself, because the
-- renderers rely on the UIListLayout being right here on `content`, and because the shell owns the
-- scrolling. AutomaticSize Y feeds the shell's AutomaticCanvasSize, so tall tabs still scroll.
local content = create("Frame", {
	Size = UDim2.new(1, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	Parent = shell.Content,
}, {
	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

--------------------------------------------------------------------------------
-- Row builder
--------------------------------------------------------------------------------

-- Content narrower than this stacks a row instead of putting its buttons beside the text. It matters
-- because rows size their text as "parent width minus 320": a portrait phone leaves about 296 px of
-- content, where that is a NEGATIVE width and the label draws nothing at all rather than shrinking.
--
-- Other sections key their own layout off this rather than picking a second number: the parachute
-- rows drop their right-hand preview at NARROW_CONTENT - 8, because a stacked row's subtitle runs the
-- full width and would otherwise be drawn across the preview. Move this and they follow; add another
-- threshold nearby and you reintroduce a band where one section stacks and another doesn't.
local NARROW_CONTENT = 560

local function narrowContent()
	local width = content.AbsoluteSize.X
	if width &lt;= 0 then
		-- Before the first layout pass AbsoluteSize is 0; the viewport is the best estimate there.
		local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		width = viewport.X - 180
	end
	return width &lt; NARROW_CONTENT, width
end

-- On sizing a label below: `UiKit.textSpan(select(2, narrowContent()), reserve, height)`, rather
-- than a flat `UDim2.new(1, -reserve, ...)`. A fixed reserve becomes a NEGATIVE width once it
-- passes the content width, and a negative width draws nothing rather than truncating. Written out
-- at each site instead of wrapped in a helper because this chunk is at Luau's 200-local ceiling and
-- verify.py warns at 195 -- one more top-level local here costs more than the repetition does.
-- These rows sit inside cards a gutter narrower than the content, and textSpan's floor absorbs that.

-- Returns the row's button container so callers can append their own buttons.
local function makeRow(order, title, titleColor, subtitle)
	local narrow = (narrowContent())
	local row = create("Frame", {
		Size = UDim2.new(1, -8, 0, narrow and 112 or 64),
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = content,
	}, { rounded(10) })

	create("TextLabel", {
		Position = UDim2.new(0, 14, 0, 10),
		Size = UDim2.new(1, narrow and -28 or -320, 0, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = title,
		TextColor3 = titleColor or C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 16,
		Parent = row,
	})

	create("TextLabel", {
		Position = UDim2.new(0, 14, 0, 32),
		Size = UDim2.new(1, narrow and -28 or -320, 0, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = subtitle or "",
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 13,
		Parent = row,
	})

	local buttons = create("Frame", {
		AnchorPoint = narrow and Vector2.new(0, 1) or Vector2.new(1, 0.5),
		Position = narrow and UDim2.new(0, 14, 1, -12) or UDim2.new(1, -12, 0.5, 0),
		Size = narrow and UDim2.new(1, -28, 0, 38) or UDim2.new(0, 300, 0, 38),
		BackgroundTransparency = 1,
		Parent = row,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	return buttons
end

local function addButton(parent, order, text, color, onClick, enabled)
	-- Stacked, a row's strip is the row less 28, which on a 390 px phone is 285 px: three 94 px buttons
	-- and their gaps are 294, and the Pass header's DAILY SPIN ran off the left. There a button takes a
	-- third of the strip, never more than 94 (the constraint), so one or two look exactly as before.
	local stackedRow = (narrowContent())
	local button = create("TextButton", {
		Size = stackedRow and UDim2.new(1 / 3, -4, 0, 38) or UDim2.fromOffset(94, 38),
		BackgroundColor3 = enabled == false and C.PanelAlt or color,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = text,
		TextColor3 = enabled == false and C.Muted or Color3.new(0, 0, 0),
		TextSize = 13,
		AutoButtonColor = enabled ~= false,
		LayoutOrder = order,
		Parent = parent,
	}, { rounded(8), stackedRow and create("UISizeConstraint", { MaxSize = Vector2.new(94, 38) }) or nil })

	if enabled ~= false and onClick then
		button.Activated:Connect(function()
			Sfx.Play("UiClick", 0.08)
			onClick()
		end)
	end

	return button
end

local function emptyMessage(text)
	create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 90),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = text,
		TextColor3 = C.Muted,
		TextWrapped = true,
		TextSize = 14,
		Parent = content,
	})
end

--------------------------------------------------------------------------------
-- Tabs
--------------------------------------------------------------------------------

local renderTab

-- Fire-and-forget: the server toasts its own result, and every successful action pushes the
-- updated profile (ProfileChanged) or trade (TradeChanged), each of which re-renders with fresh
-- data. Re-rendering here as well drew the tab twice per click — the first time from the *old*
-- profile, since this runs before the push lands, so stale coin and crate counts flashed up.
local function invoke(remote, ...)
	pcall(function(...)
		return remote:InvokeServer(...)
	end, ...)
end

-- A live 3D portrait: the same model the companion uses, in a ViewportFrame. No image assets.
-- `silhouette` blacks it out, for brainrots you haven't found yet.
local function brainrotPhoto(parent, def, size, silhouette)
	local viewport = create("ViewportFrame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
		Ambient = Color3.fromRGB(170, 170, 182),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, 0.6),
		Parent = parent,
	}, { rounded(10) })

	local model = BrainrotModels.Build(def)
	if silhouette then
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") and part.Transparency &lt; 1 then
				part.Color = Color3.fromRGB(16, 16, 22)
				part.Material = Enum.Material.SmoothPlastic
			end
		end
	end
	model.Parent = viewport
	BrainrotModels.FrameViewport(viewport, def)
	return viewport
end

local function statLine(parent, y, text, color, font, size)
	return create("TextLabel", {
		Position = UDim2.new(0, 124, 0, y),
		-- 124 of photo on the left and 216 of buttons on the right: -44 px at the 296 a portrait
		-- phone gives, which drew nothing at all.
		Size = UiKit.textSpan(select(2, narrowContent()), 340, size + 6),
		BackgroundTransparency = 1,
		Font = font or Enum.Font.Gotham,
		Text = text,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = size,
		Parent = parent,
	})
end

-- The Codex: every brainrot in the game, found or not, with where the missing ones drop.
local codexMode = false

-- Which crates can roll a given rarity, for "how do I get this".
local function crateSourcesFor(rarity)
	local names = {}
	for _, tier in ipairs(CrateData.Order) do
		local crate = CrateData.Get(tier)
		if (crate.category or "Brainrot") == "Brainrot" and (crate.odds[rarity] or 0) &gt; 0 then
			table.insert(names, tier)
		end
	end
	return #names &gt; 0 and (table.concat(names, " / ") .. " crates") or "trades only"
end

local function codexRow(order, def, count)
	local color = Rarity.Color(def.rarity)
	local owned = count &gt; 0
	-- Every brainrot can be bought outright with Robux (one product per rarity; BrainrotShopService
	-- ties the pick to the purchase). Shown when that rarity's product is set up, or greyed in Studio.
	local product = GamepassConfig.BrainrotProduct(def.rarity)
	local buyable = product ~= nil and product.id &gt; 0
	local showBuy = product ~= nil and (buyable or RunService:IsStudio())
	local rightReserve = (showBuy and 100 or 0) + (owned and 100 or 0)
	local row = create("Frame", {
		Size = UDim2.new(1, -8, 0, 60),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = owned and 0 or 0.35,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = content,
	}, { rounded(10) })
	create("UIStroke", { Color = color, Thickness = 1.5, Transparency = owned and 0.3 or 0.75, Parent = row })

	brainrotPhoto(row, def, 48, not owned).Position = UDim2.fromOffset(6, 6)

	create("TextLabel", {
		Position = UDim2.fromOffset(64, 8),
		-- rightReserve is 0, 100 or 200 depending on the BUY and OWNED chips, so this ran from 76 px
		-- down to -124 at 296 of content.
		Size = UiKit.textSpan(select(2, narrowContent()), 220 + rightReserve, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = owned and def.name or "???  " .. def.name,
		TextColor3 = owned and color or C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 15,
		Parent = row,
	})
	create("TextLabel", {
		Position = UDim2.fromOffset(64, 32),
		Size = UiKit.textSpan(select(2, narrowContent()), 220 + rightReserve, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = owned and string.format("%s  •  %s coins each", string.upper(def.rarity), formatNumber(def.coinValue))
			or string.format("%s  •  from %s", string.upper(def.rarity), crateSourcesFor(def.rarity)),
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 12,
		Parent = row,
	})
	create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14 - rightReserve, 0.5, 0),
		Size = UDim2.fromOffset(140, 24),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = owned and string.format("OWNED  x%d", count) or "NOT FOUND YET",
		TextColor3 = owned and C.Green or C.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 15,
		Parent = row,
	})
	-- Owned ones can be equipped straight from the Codex too, so the list is never a dead end.
	if owned and profile then
		local following = profile.companion == def.name
		local button = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(94, 34),
			BackgroundColor3 = following and C.PanelAlt or C.Green,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Text = following and "UNEQUIP" or "EQUIP",
			TextColor3 = following and C.Text or Color3.new(0, 0, 0),
			TextSize = 13,
			Parent = row,
		}, { rounded(8) })
		button.Activated:Connect(function()
			Sfx.Play("UiClick", 0.08)
			invoke(setCompanion, following and nil or def.name)
		end)
	end
	if showBuy then
		local buy = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, owned and -110 or -10, 0.5, 0),
			Size = UDim2.fromOffset(94, 34),
			BackgroundColor3 = buyable and C.Accent or C.PanelAlt,
			BorderSizePixel = 0,
			AutoButtonColor = buyable,
			Font = Enum.Font.GothamBold,
			Text = string.format("%d R$", product.suggestedPrice),
			TextColor3 = buyable and Color3.new(0, 0, 0) or C.Muted,
			TextSize = 13,
			Parent = row,
		}, { rounded(8) })
		if buyable then
			buy.Activated:Connect(function()
				Sfx.Play("UiClick", 0.08)
				-- The server stores this pick and opens the purchase prompt itself.
				invoke(buyBrainrot, def.name)
			end)
		end
	end
end

-- MERGE opens a confirmation card first (MergeDialog) showing the stat change and the cost; only
-- CONFIRM sends anything. The star count it was opened at goes with the request, so a second
-- confirm for the same merge is refused by the server instead of spending more copies.
local function openMergeDialog(def, entry, level, stars)
	MergeDialog.Open(screenGui, {
		def = def,
		level = level,
		stars = stars,
		count = entry.count,
		onConfirm = function()
			task.spawn(function()
				-- The server's own message is NOT passed on: Bootstrap's `guard` now toasts whatever a
				-- menu remote returns, so repeating it here put the same words on screen twice at the
				-- same moment. The dialog keeps its generic line and the toast carries the reason.
				--
				-- The "couldn't reach the server" line below is different and stays: guard never ran,
				-- so nothing else will say anything at all.
				local reached, success = pcall(function()
					return mergeBrainrot:InvokeServer(entry.name, stars)
				end)
				if not reached then
					MergeDialog.Resolve(false, "Couldn't reach the server. Nothing was spent.")
					return
				end
				if success then
					Sfx.Play("Gold")
				end
				MergeDialog.Resolve(success == true)
			end)
		end,
	})
end

-- The card belongs to the menu: closing the menu closes it too.
panel:GetPropertyChangedSignal("Visible"):Connect(function()
	if not panel.Visible then
		MergeDialog.Close()
	end
end)

local function renderBrainrots()
	if not profile or (#profile.brainrots == 0 and not codexMode) then
		emptyMessage("No brainrots yet.\n\nPlace in a match or open a crate to start collecting.")
		if profile then
			local buttons = makeRow(1, "See everything there is to collect", C.Text, "The Codex lists all " .. #BrainrotData.Types .. " brainrots and where they drop")
			addButton(buttons, 1, "CODEX", C.Storm, function()
				codexMode = true
				renderTab()
			end)
		end
		return
	end

	local order = 0
	create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 30),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = string.format("Collection worth %s SahurCoins   •   discovered %d / %d brainrots   •   equip one to have it fight for you",
			formatNumber(profile.brainrotValue), #profile.brainrots, #BrainrotData.Types),
		TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 14,
		LayoutOrder = order,
		Parent = content,
	})

	-- Set progress per rarity. Owning every brainrot of a rarity pays a one-time bonus.
	local ownedNames = {}
	for _, entry in ipairs(profile.brainrots) do
		ownedNames[entry.name] = true
	end
	local bonuses = BrainrotData.CollectionBonus
	local progress = {}
	for _, rarityName in ipairs(Rarity.Order) do
		local set = BrainrotData.OfRarity(rarityName)
		local have = 0
		for _, def in ipairs(set) do
			if ownedNames[def.name] then
				have += 1
			end
		end
		local claimed = profile.collections and profile.collections[rarityName]
		table.insert(progress, string.format("%s %d/%d %s", rarityName, have, #set,
			claimed and "(done)" or ("(+" .. formatNumber(bonuses[rarityName] or 0) .. ")")))
	end
	-- Two rows: seven sets don't fit on one line. The top tiers get their own, in their colours.
	local rows = {
		{ text = "SETS   " .. table.concat(progress, "    ", 1, 4), color = C.Muted },
		{ text = "RARE SETS   " .. table.concat(progress, "    ", 5, #progress), color = Rarity.Color("Mythic") },
	}
	for _, row in ipairs(rows) do
		order += 1
		create("TextLabel", {
			Size = UDim2.new(1, -8, 0, 20),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = row.text,
			TextColor3 = row.color,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextSize = 12,
			LayoutOrder = order,
			Parent = content,
		})
	end

	-- Doubles: one button sells every copy beyond the first, leaving the collection intact.
	local duplicates, duplicateValue = 0, 0
	for _, entry in ipairs(profile.brainrots) do
		if entry.count &gt; 1 then
			duplicates += entry.count - 1
			duplicateValue += (entry.count - 1) * entry.coinValue
		end
	end
	if duplicates &gt; 0 then
		order += 1
		local dupButtons = makeRow(order,
			string.format("%d duplicate%s worth %s SahurCoins", duplicates, duplicates == 1 and "" or "s", formatNumber(duplicateValue)),
			C.Text, "Sells every copy beyond the first of each brainrot. Spare copies can be MERGED instead.")
		addButton(dupButtons, 1, "SELL DUPES", C.Red, function()
			invoke(sellDuplicates)
		end)
	end

	-- Merging, in two lines: what a star is worth and what it costs.
	local costs, totalCopies = {}, 0
	for _, copies in ipairs(BrainrotData.MergeCopies) do
		table.insert(costs, tostring(copies))
		totalCopies += copies
	end
	local mergeLines = {
		string.format("MERGE   fuse spare copies of a brainrot into it: +%d%% damage and health per star, up to %s",
			math.floor(BrainrotData.BonusPerStar * 100 + 0.5), string.rep("★", BrainrotData.MaxStars)),
		string.format("Spares per star: %s (%d for all %d)   •   stars stay yours when you sell or trade copies",
			table.concat(costs, ", "), totalCopies, BrainrotData.MaxStars),
	}
	for _, text in ipairs(mergeLines) do
		order += 1
		create("TextLabel", {
			Size = UDim2.new(1, -8, 0, 18),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = text,
			TextColor3 = Rarity.Color("Legendary"),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextSize = 12,
			LayoutOrder = order,
			Parent = content,
		})
	end

	-- Rarity filter: with 120-odd brainrots, one long list is a lot to scroll.
	order += 1
	local chips = create("Frame", {
		Size = UDim2.new(1, -8, 0, 30),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = content,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 5),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local filterOptions = { "All" }
	for _, rarityName in ipairs(Rarity.Order) do
		table.insert(filterOptions, rarityName)
	end
	for index, option in ipairs(filterOptions) do
		local selected = brainrotFilter == option
		local chipColor = option == "All" and C.Accent or Rarity.Color(option)
		local chip = create("TextButton", {
			Size = UDim2.fromOffset(option == "All" and 54 or 84, 28),
			BackgroundColor3 = selected and chipColor or C.Panel,
			BorderSizePixel = 0,
			AutoButtonColor = true,
			Font = Enum.Font.GothamBold,
			Text = string.upper(option),
			TextColor3 = selected and Color3.new(0, 0, 0) or chipColor,
			TextSize = 11,
			LayoutOrder = index,
			Parent = chips,
		}, { rounded(7) })
		chip.Activated:Connect(function()
			Sfx.Play("UiClick", 0.08)
			brainrotFilter = option
			renderTab()
		end)
	end

	-- The Codex toggle at the end of the chip row.
	-- Sized to its own label, because it has two of very different lengths: "CODEX" fits the 70 px
	-- this used to be fixed at and "BACK TO MY BRAINROTS" is twenty characters that did not, so the
	-- text ran out of the chip (Oliver's #129). Its siblings above are each sized for their own word
	-- (`option == "All" and 54 or 84`); this was the one that was not. AutomaticSize keeps both
	-- labels exact instead of trading one overflowing chip for one too wide for "CODEX".
	local codexChip = create("TextButton", {
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = codexMode and C.Storm or C.Panel,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Font = Enum.Font.GothamBold,
		Text = codexMode and "BACK TO MY BRAINROTS" or "CODEX",
		TextColor3 = codexMode and Color3.new(0, 0, 0) or C.Storm,
		TextSize = 11,
		LayoutOrder = 99,
		Parent = chips,
	}, {
		rounded(7),
		create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
	})
	codexChip.Activated:Connect(function()
		Sfx.Play("UiClick", 0.08)
		codexMode = not codexMode
		renderTab()
	end)

	if codexMode then
		-- Everything, rarest last, with what you own counted in.
		local counts = {}
		for _, entry in ipairs(profile.brainrots) do
			counts[entry.name] = entry.count
		end
		for _, rarityName in ipairs(Rarity.Order) do
			if brainrotFilter == "All" or brainrotFilter == rarityName then
				local set = BrainrotData.OfRarity(rarityName)
				local have = 0
				for _, def in ipairs(set) do
					if counts[def.name] then
						have += 1
					end
				end
				order += 1
				create("TextLabel", {
					Size = UDim2.new(1, -8, 0, 26),
					BackgroundTransparency = 1,
					Font = Enum.Font.FredokaOne,
					Text = string.format("%s   %d / %d", string.upper(rarityName), have, #set),
					TextColor3 = Rarity.Color(rarityName),
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Bottom,
					TextSize = 17,
					LayoutOrder = order,
					Parent = content,
				})
				-- THE ONE EDIT, when Oliver answers the sort question. The list is grouped by rarity
				-- (rarest last) and, within a rarity, follows BrainrotData's own order -- which is the
				-- order they were written, not a chosen one. The three candidates and the change each
				-- one costs, so whoever picks it up is not re-deriving this:
				--   * leave it as written      -- nothing to do
				--   * by name, A to Z          -- sort a copy of `set` on def.name
				--   * by coin value, low first -- sort a copy of `set` on def.coinValue
				-- Sort a COPY: BrainrotData.OfRarity returns a fresh table today, but sorting the
				-- module's own data in place would reorder it for the shop, the crate roll and the
				-- codex all at once.
				--
				-- Shared/BrainrotCodex holds a line of flavour text for all 126, keyed by name
				-- (`BrainrotCodex.Get(def.name)`, nil if there is none). It is drawn nowhere yet. The
				-- row is 60 px tall with two lines of text at x 64; a third line at y 46 is where it
				-- goes, and the row grows to about 80. verify.py already checks the file is complete
				-- and inside its own length limit, so the text is ready whenever the panel is.
				-- Oliver 09-24 (#130): A to Z within each rarity, on a copy (see above).
				local sorted = table.clone(set)
				table.sort(sorted, function(a, b)
					return a.name &lt; b.name
				end)
				for _, def in ipairs(sorted) do
					order += 1
					codexRow(order, def, counts[def.name] or 0)
				end
			end
		end
		return
	end

	for _, entry in ipairs(profile.brainrots) do
		local def = BrainrotData.Get(entry.name)
		if def and (brainrotFilter == "All" or def.rarity == brainrotFilter) then
			order += 1
			local level = entry.level or 1
			local stars = entry.stars or 0
			local stats = BrainrotData.Stats(def, level, stars)
			local starText = BrainrotData.StarText(stars)
			local color = Rarity.Color(def.rarity)
			local showcased = profile.showcase == entry.name
			local following = profile.companion == entry.name
			local levelText = level &gt;= BrainrotData.MaxLevel and string.format("Lv %d MAX", level)
				or string.format("Lv %d  •  %d / %d XP", level, BrainrotData.XpIntoLevel(entry.xp or 0), BrainrotData.XpPerLevel)

			local card = create("Frame", {
				Size = UDim2.new(1, -8, 0, 144),
				BackgroundColor3 = C.Panel,
				BorderSizePixel = 0,
				LayoutOrder = order,
				Parent = content,
			}, { rounded(10) })
			create("UIStroke", {
				Color = following and C.Green or color,
				Thickness = following and 2 or 1.5,
				Transparency = following and 0 or 0.4,
				Parent = card,
			})

			brainrotPhoto(card, def, 106).Position = UDim2.fromOffset(8, 19)

			statLine(card, 8, string.format("%s  x%d%s", entry.name, entry.count, starText ~= "" and ("   " .. starText) or ""),
				color, Enum.Font.GothamBold, 17)
			statLine(card, 32, string.format("%s  •  %s coins each  •  %s", string.upper(def.rarity), formatNumber(def.coinValue), levelText),
				color, Enum.Font.GothamBold, 12)
			statLine(card, 52, string.format("[%s] %s  (%s)   %d dmg   %.1fs cooldown   %d range   %d HP",
				Settings.KeyLabel("Companion"), stats.move, stats.kind, stats.damage, stats.cooldown, stats.range, stats.health),
				C.Text, Enum.Font.GothamBold, 13)
			statLine(card, 74, stats.description .. (stats.splash &gt; 0 and string.format(" (splash %d)", stats.splash) or ""),
				C.Muted, Enum.Font.Gotham, 12)

			local status = {}
			if following then
				table.insert(status, "FOLLOWING YOU")
			end
			if showcased then
				table.insert(status, "ON YOUR PODIUM")
			end
			if stars &gt; 0 then
				table.insert(status, string.format("MERGED +%d%%", math.floor((BrainrotData.StarBonus(stars) - 1) * 100 + 0.5)))
			end
			statLine(card, 96, table.concat(status, "   •   "), C.Green, Enum.Font.GothamBold, 12)

			-- The usual 2x2 grid, with a full-width MERGE button under it.
			local buttonColumn = create("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(196, 128),
				BackgroundTransparency = 1,
				Parent = card,
			})
			local buttons = create("Frame", {
				Size = UDim2.fromOffset(196, 84),
				BackgroundTransparency = 1,
				Parent = buttonColumn,
			}, {
				create("UIGridLayout", {
					CellSize = UDim2.fromOffset(95, 39),
					CellPadding = UDim2.fromOffset(6, 6),
					SortOrder = Enum.SortOrder.LayoutOrder,
				}),
			})

			addButton(buttons, 1, following and "UNEQUIP" or "EQUIP", C.Green, function()
				invoke(setCompanion, following and nil or entry.name)
			end)
			-- Not `showcased and nil or entry.name`: nil falls through the `or`, so that
			-- expression always yields entry.name and UNSHOW would never clear anything.
			addButton(buttons, 2, showcased and "UNSHOW" or "SHOW OFF", C.Storm, function()
				if showcased then
					invoke(setShowcase, nil)
				else
					invoke(setShowcase, entry.name)
				end
			end)
			addButton(buttons, 3, "SELL 1", C.Accent, function()
				invoke(sellBrainrot, entry.name)
			end)
			-- Confirmed before it acts, because it is irreversible and it is bigger than it looks.
			-- Drawn on one brainrot's card under "SELL 1", this sells every brainrot of the whole
			-- RARITY (RewardService.SellAllOfRarity :339), keeping one copy of each merged one. MERGE
			-- -- which leaves you better off -- has had a confirm card since it was written; this had
			-- none, and `invoke` discards the server's reply, so the first a player knew was a shorter
			-- list. The body names what is KEPT as well as what goes: "are you sure" helps nobody.
			--
			-- The LABEL still says "SELL ALL" and should say the rarity. That is deliberate and it is
			-- held for a render: a variable-length label in a fixed 95x39 grid cell is exactly the
			-- clipped chip that #129 was, and it is not going in unmeasured. The dialog prevents the
			-- loss; the label prevents the misunderstanding, and only the first is urgent.
			addButton(buttons, 4, "SELL ALL", C.Red, function()
				local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
					or Vector2.new(1280, 720)
				UiParts.dialog({
					parent = screenGui,
					viewport = viewport,
					title = "Sell every " .. entry.rarity .. " brainrot?",
					body = "This sells your whole " .. entry.rarity .. " collection, not just "
						.. entry.name .. ". One copy of each merged brainrot stays. It cannot be undone.",
					actions = {
						{ text = "CANCEL", kind = "secondary" },
						{ text = "SELL THEM", kind = "danger", onClick = function()
							invoke(sellAllOfRarity, entry.rarity)
						end },
					},
				})
			end)

			-- MERGE says what the next star needs: live once there are enough spare copies,
			-- otherwise greyed out with how far along you are.
			local mergeCost = BrainrotData.MergeCost(stars)
			local spare = entry.count - 1
			local canMerge = mergeCost ~= nil and spare &gt;= mergeCost
			local mergeText = not mergeCost and string.format("FULLY MERGED  +%d%%", math.floor((BrainrotData.StarBonus(stars) - 1) * 100 + 0.5))
				or canMerge and string.format("MERGE TO ★%d  (uses %d)", stars + 1, mergeCost)
				or string.format("MERGE  %d / %d SPARES", spare, mergeCost)
			local mergeButton = addButton(buttonColumn, 5, mergeText, Rarity.Color("Legendary"), function()
				openMergeDialog(def, entry, level, stars)
			end, canMerge)
			mergeButton.Position = UDim2.fromOffset(0, 90)
			mergeButton.Size = UDim2.fromOffset(196, 38)
		end
	end

	-- The rest of the collection, as silhouettes with only their rarity showing: something to
	-- chase in crates and placements.
	local owned = {}
	for _, entry in ipairs(profile.brainrots) do
		owned[entry.name] = true
	end
	local missing = {}
	for _, def in ipairs(BrainrotData.Types) do
		if not owned[def.name] and (brainrotFilter == "All" or def.rarity == brainrotFilter) then
			table.insert(missing, def)
		end
	end
	if #missing == 0 then
		return
	end

	order += 1
	create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 34),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = string.format("UNDISCOVERED  •  %d left to find%s", #missing,
			GamepassConfig.BrainrotProduct("Common") and GamepassConfig.BrainrotProduct("Common").id &gt; 0
				and "  •  open the CODEX to buy any of them with Robux" or ""),
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 15,
		LayoutOrder = order,
		Parent = content,
	})

	local perRow = 7
	order += 1
	local grid = create("Frame", {
		Size = UDim2.new(1, -8, 0, math.ceil(#missing / perRow) * 100),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = content,
	}, {
		create("UIGridLayout", {
			CellSize = UDim2.fromOffset(94, 94),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	for index, def in ipairs(missing) do
		local cell = create("Frame", {
			BackgroundColor3 = C.Panel,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Parent = grid,
		}, { rounded(8) })

		-- Live 3D silhouettes only once filtered to one rarity; the full list of a hundred-plus
		-- would build that many ViewportFrames on every refresh, so it gets plain tiles.
		if brainrotFilter == "All" then
			create("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 8),
				Size = UDim2.fromOffset(62, 62),
				BackgroundColor3 = C.PanelAlt,
				BorderSizePixel = 0,
				Font = Enum.Font.FredokaOne,
				Text = "?",
				TextColor3 = Rarity.Color(def.rarity),
				TextSize = 34,
				Parent = cell,
			}, { rounded(31) })
		else
			local photo = brainrotPhoto(cell, def, 70, true)
			photo.Position = UDim2.new(0.5, -35, 0, 4)
		end

		create("TextLabel", {
			Position = UDim2.new(0, 0, 1, -20),
			Size = UDim2.new(1, 0, 0, 16),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = "? " .. string.upper(def.rarity),
			TextColor3 = Rarity.Color(def.rarity),
			TextSize = 11,
			Parent = cell,
		})
	end
end

--------------------------------------------------------------------------------
-- Trading
--------------------------------------------------------------------------------

-- A trade row with a brainrot's photo, so both sides can see exactly what's on offer.
-- `brainrotName` picks the photo (nil for none); returns the button container.
local function tradeRow(order, title, titleColor, subtitle, brainrotName)
	local def = brainrotName and BrainrotData.Get(brainrotName) or nil

	local row = create("Frame", {
		Size = UDim2.new(1, -8, 0, 72),
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = content,
	}, { rounded(10) })

	local textLeft = 14
	if def then
		brainrotPhoto(row, def, 60).Position = UDim2.fromOffset(6, 6)
		textLeft = 76
	end

	create("TextLabel", {
		Position = UDim2.new(0, textLeft, 0, 12),
		Size = UDim2.new(1, -textLeft - 220, 0, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = title,
		TextColor3 = titleColor,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 16,
		Parent = row,
	})
	create("TextLabel", {
		Position = UDim2.new(0, textLeft, 0, 36),
		Size = UDim2.new(1, -textLeft - 220, 0, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = subtitle,
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 13,
		Parent = row,
	})

	return create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 200, 0, 38),
		BackgroundTransparency = 1,
		Parent = row,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

local function offerValue(offer)
	local total = 0
	for _, entry in ipairs(offer) do
		total += entry.coinValue or 0
	end
	return total
end

local function renderTradeSession()
	local headerButtons = makeRow(0,
		"Trading with " .. trade.partner,
		C.Accent,
		-- Both flags, four states. With only theirs, the header still read "Neither side has confirmed
		-- yet." straight after your own CONFIRM turned green, and a player who doubts the press toggles
		-- it off again -- which cancels a trade both wanted if the partner confirms in between (#86).
		(trade.youConfirmed and trade.theyConfirmed and "Both confirmed — trading…")
			or (trade.youConfirmed and ("You've confirmed — waiting on " .. trade.partner .. "."))
			or (trade.theyConfirmed and (trade.partner .. " has confirmed — waiting on you."))
			or "Neither side has confirmed yet.")

	addButton(headerButtons, 1, trade.youConfirmed and "UNCONFIRM" or "CONFIRM",
		trade.youConfirmed and C.Green or C.Accent, function()
			invoke(tradeConfirm, not trade.youConfirmed)
		end)
	addButton(headerButtons, 2, "CANCEL", C.Red, function()
		invoke(tradeCancel)
	end)

	create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = string.format("YOUR OFFER  (%d / %d, worth %s)  —  changing it clears both confirmations",
			#trade.yours, trade.maxOffer, formatNumber(offerValue(trade.yours))),
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 13,
		LayoutOrder = 1,
		Parent = content,
	})

	-- Merge stars live on each player's profile, never on a copy, so a trade moves plain copies:
	-- what you give keeps your stars with you, and what you get arrives at your own star count
	-- for that brainrot. Each row says which, so a merged brainrot shown off on a podium can't be
	-- traded as if its stars came with it.
	local function myStars(name)
		return BrainrotData.ClampStars(profile and profile.stars and profile.stars[name])
	end

	local order = 1
	for _, entry in ipairs(trade.yours) do
		order += 1
		local stars = myStars(entry.name)
		local buttons = tradeRow(order, entry.name, Rarity.Color(entry.rarity),
			string.format("%s  •  %s coins%s", entry.rarity, formatNumber(entry.coinValue),
				stars &gt; 0 and ("  •  your " .. BrainrotData.StarText(stars) .. " stay with you") or ""), entry.name)
		addButton(buttons, 1, "REMOVE", C.Red, function()
			invoke(tradeOffer, entry.name, false)
		end)
	end

	order += 1
	create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = string.format("THEIR OFFER  (%d, worth %s)  —  merge stars stay with their owner%s", #trade.theirs,
			formatNumber(offerValue(trade.theirs)), trade.theyConfirmed and "  ✓ CONFIRMED" or ""),
		TextColor3 = trade.theyConfirmed and C.Green or C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 13,
		LayoutOrder = order,
		Parent = content,
	})

	if #trade.theirs == 0 then
		order += 1
		create("TextLabel", {
			Size = UDim2.new(1, -8, 0, 40),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = "They haven't offered anything yet.",
			TextColor3 = C.Muted,
			TextSize = 13,
			LayoutOrder = order,
			Parent = content,
		})
	end

	for _, entry in ipairs(trade.theirs) do
		order += 1
		local stars = myStars(entry.name)
		tradeRow(order, entry.name, Rarity.Color(entry.rarity),
			string.format("%s  •  %s coins  •  %s", entry.rarity, formatNumber(entry.coinValue),
				stars &gt; 0 and ("arrives at your " .. BrainrotData.StarText(stars)) or "arrives unmerged for you"), entry.name)
	end

	order += 1
	create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "ADD FROM YOUR COLLECTION",
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 13,
		LayoutOrder = order,
		Parent = content,
	})

	for _, entry in ipairs(profile.brainrots) do
		order += 1
		local stars = myStars(entry.name)
		local buttons = tradeRow(order, string.format("%s  x%d", entry.name, entry.count),
			Rarity.Color(entry.rarity),
			string.format("%s  •  %s coins each%s", entry.rarity, formatNumber(entry.coinValue),
				stars &gt; 0 and ("  •  your " .. BrainrotData.StarText(stars) .. " stay with you") or ""), entry.name)
		addButton(buttons, 1, "ADD", C.Green, function()
			invoke(tradeOffer, entry.name, true)
		end, #trade.yours &lt; trade.maxOffer)
	end
end

local function renderTrade()
	if not profile then
		return
	end

	if trade.active then
		renderTradeSession()
		return
	end

	if #profile.others == 0 then
		emptyMessage("Nobody else is in the server right now.\n\nTrading is lobby-only — you can't trade mid-match.")
		return
	end

	create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = "Send a trade request. Both sides have to confirm before anything moves.",
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 13,
		LayoutOrder = 0,
		Parent = content,
	})

	for index, other in ipairs(profile.others) do
		local buttons = tradeRow(index, other.name, C.Text,
			other.showcase and ("Showing off: " .. other.showcase) or "No brainrot on their podium", other.showcase)

		addButton(buttons, 1, "TRADE", C.Accent, function()
			invoke(requestTrade, other.userId)
		end)
	end
end

-- A small 3D crate in its tier's colour — the same crate the opening animation uses, built
-- from parts in a ViewportFrame.
-- The crate on a card. It draws the SHARED crate (CrateModels), the same model the altar and the
-- reveal use, so claude-4a's per-tier identity — the dome, the peak, the crown, the present's ribbon
-- — reaches the card too. It used to build its own wooden block with two neon bands, which made the
-- card a third crate in the game and would have shown none of it. `tier` is optional: without one
-- (or with an unknown one) it falls back to that block, which is also what keeps this working for
-- callers that have only a colour.
local function crateIcon(parent, color, size, tier)
	local viewport = create("ViewportFrame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
		Ambient = Color3.fromRGB(160, 160, 172),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, 0.6),
		Parent = parent,
	}, { rounded(10) })

	local shared = nil
	if tier and CrateData.Get(tier) then
		local ok, built = pcall(CrateModels.Crate, tier, { color = color })
		shared = ok and built or nil
	end
	if shared then
		shared.Parent = viewport
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.CFrame = CFrame.lookAt(Vector3.new(4.5, 4, -9), Vector3.new(0, 0.4, 0))
		camera.Parent = viewport
		viewport.CurrentCamera = camera
		return viewport
	end

	local model = Instance.new("Model")
	local wood = Color3.fromRGB(150, 108, 62)
	local function block(blockSize, cframe, partColor, material)
		local part = Instance.new("Part")
		part.Size = blockSize
		part.CFrame = cframe
		part.Color = partColor
		part.Material = material
		part.Anchored = true
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = model
	end
	block(Vector3.new(4, 3, 3), CFrame.new(0, 0, 0), wood, Enum.Material.WoodPlanks)
	block(Vector3.new(4.1, 0.35, 3.1), CFrame.new(0, -0.95, 0), color, Enum.Material.Neon)
	block(Vector3.new(4.1, 0.35, 3.1), CFrame.new(0, 0.95, 0), color, Enum.Material.Neon)
	block(Vector3.new(4.2, 0.6, 3.2), CFrame.new(0, 1.8, 0), wood:Lerp(Color3.new(0, 0, 0), 0.12), Enum.Material.WoodPlanks)
	block(Vector3.new(4.26, 0.25, 3.26), CFrame.new(0, 1.8, 0), color, Enum.Material.Neon)
	block(Vector3.new(0.6, 0.7, 0.2), CFrame.new(0, 1.1, -1.6), Color3.fromRGB(255, 200, 60), Enum.Material.Foil)
	model.Parent = viewport

	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.CFrame = CFrame.lookAt(Vector3.new(4.5, 4, -9), Vector3.new(0, 0.4, 0))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport
end

local BEST_DROPS_SHOWN = 5

-- The restock countdown at the top of the Crates and Cosmetics tabs. The loop at the bottom of
-- this file ticks it in place rather than redrawing the whole tab every second.
local stockTimerLabel = nil

-- `noTimer` is for a tab whose stock never rotates (the Style Crates are always in stock, and
-- renderStyleCrates never reads the rotation): a countdown there promised a change that never came,
-- and players waited on it (#86). It still clears stockTimerLabel so the ticker leaves it alone.
local function stockHeader(order, text, noTimer)
	local label = create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = noTimer and text or (text .. "  •  new stock in " .. ShopRotation.FormatTimeLeft()),
		TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 14,
		LayoutOrder = order,
		Parent = content,
	})
	label:SetAttribute("Prefix", text)
	stockTimerLabel = not noTimer and label or nil
end

local function renderCrates()
	-- Portrait phones leave about 300 px of content (claude-ee's shell: panel = clamp(viewportX - 40,
	-- 320, 1180), content = panel - 24). The card's normal layout sizes its text as "parent width
	-- minus 340", which at that width is a NEGATIVE size: the text vanishes rather than shrinking. So
	-- below NARROW_CARD the card stacks instead — text across the full width, the odds line wrapped
	-- onto two lines, and the buttons underneath. Landscape phones (603 px) keep the normal layout.
	local narrow, contentWidth = narrowContent()
	-- Where the text column starts and how much width it gets, in each layout.
	local textX = narrow and 88 or 124
	local textWidth = narrow and -96 or -340
	local TextService = game:GetService("TextService")

	-- Moves a statLine into the narrow layout. `wrap` is for the odds line: a displayed probability
	-- for a crate people BUY must never be cut off, so it wraps rather than truncating.
	-- `wrap`, when given, is the HEIGHT to give a wrapped line -- measured by the caller, not a
	-- guess. It used to be a fixed two lines, which is the same mistake that cut "Myth 0.40%  Secr
	-- 0.10%" off the end of the Style Crate rows: a displayed probability on something people buy
	-- may never be cut off, so the box has to fit the text rather than the text fit the box.
	local function fitLine(label, y, wrap)
		if not narrow then
			return label
		end
		label.Position = UDim2.new(0, textX, 0, y)
		label.Size = UDim2.new(1, textWidth, 0, wrap or label.Size.Y.Offset)
		if wrap then
			label.TextWrapped = true
			label.TextTruncate = Enum.TextTruncate.None
		end
		return label
	end

	local crateLuck = profile and profile.crateLuck or 1
	stockHeader(0, crateLuck &gt; 1
		and string.format("CRATE SHOP  •  %dx CRATE LUCK ACTIVE: every open rolls %d times and keeps the rarest, and the odds below include it", crateLuck, crateLuck)
		or "CRATE SHOP  •  rarer crates are in stock less often")
	-- Two cards this tab should not draw (#86), filtered before the loop.
	-- The Style tiers have their own STYLE CRATES tab,
	-- and here the "You own" line counted CosmeticData.OfKind("Cosmetic") -- no such kind -- so a
	-- crate selling for 8,000 coins read "You own 0 / 0". And a Robux-only crate whose product id
	-- is still 0 is hidden the way the Robux Shop hides it (shopVisible), not shown as a first card
	-- whose only button is a greyed price beside "ALWAYS IN STOCK". Studio still shows it.
	local function drawn(tier)
		local crate = CrateData.Get(tier)
		local robuxProduct = crate.robuxOnly and crate.productKey and GamepassConfig.Products[crate.productKey]
		return not (crate.category == "Cosmetic"
			or (crate.robuxOnly and not (robuxProduct and robuxProduct.id &gt; 0) and not RunService:IsStudio()))
	end
	local tiers = {}
	for _, tier in ipairs(CrateData.Order) do
		if drawn(tier) then
			table.insert(tiers, tier)
		end
	end
	for index, tier in ipairs(tiers) do
		local crate = CrateData.Get(tier)
		local owned = profile and (profile.crates[tier] or 0) or 0
		local inStock = ShopRotation.IsCrateInStock(tier)
		local color = crate.color or Rarity.Color(tier)
		local category = crate.category or "Brainrot"

		-- The odds this player actually rolls with: CrateData.EffectiveOdds at the luck the server
		-- sends (crateLuck), the same function and value CrateService.Open uses. Roblox requires the
		-- odds shown for paid random items to be the real ones, so these must never be the base table
		-- for someone whose luck is boosted.
		-- A crate whose next open rolls at a different luck than the shop's table would print (the
		-- server says which, in crateBoosted) lists the rarities it can drop and no percentages: a
		-- percentage here would be a number the roll doesn't use, and that must never happen.
		local boosted = profile and profile.crateBoosted and profile.crateBoosted[tier] or false
		local luck = profile and profile.crateLuck or 1
		local odds = CrateData.OddsLine(crate, luck, boosted)

		-- How tall the odds line needs to be on THIS screen, and how far that pushes everything under
		-- it. Wide, the line has always fitted on one row (the render shows it); narrow, it is two
		-- rows on a landscape phone and three on a portrait one with 2x luck showing.
		local oddsText = table.concat(odds, "   ")
		local oddsHeight, shift = 18, 0
		if narrow then
			local column = math.max(80, contentWidth - 8 + textWidth)
			local bounds = TextService:GetTextSize(oddsText, 12, Enum.Font.GothamBold, Vector2.new(column, 10000))
			oddsHeight = math.max(32, bounds.Y + 2)
			shift = oddsHeight - 32
		end

		local card = create("Frame", {
			Size = UDim2.new(1, -8, 0, narrow and (200 + shift) or 118),
			BackgroundColor3 = C.Panel,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Parent = content,
		}, { rounded(10) })
		create("UIStroke", { Color = color, Thickness = 1.5, Transparency = 0.4, Parent = card })

		crateIcon(card, color, narrow and 72 or 102, tier).Position = UDim2.fromOffset(8, 8)

		local stockNote = crate.robuxOnly and "  •  ALWAYS IN STOCK" or (inStock and "" or "  •  SOLD OUT")
		fitLine(statLine(card, 8, string.format("%s  (owned: %d)%s", crate.name, owned, stockNote),
			color, Enum.Font.GothamBold, 17), 8)

		-- No pity counter on the card (Oliver, 2026-09-17: "get rid of the (rank) in 20 opens thing").
		-- The GUARANTEE itself is untouched — CrateService still forces the rarity up after a dry run,
		-- and the open still says "(guaranteed — your luck was due)" when it fires. Only the menu's
		-- running count is gone.
		local oddsLabel = statLine(card, 32, oddsText, C.Text, Enum.Font.GothamBold, 12)
		fitLine(oddsLabel, 30, oddsHeight)
		if not narrow then
			-- Wide, the line stays one row, so a long one (2x luck plus the accessory note) shrinks
			-- to fit instead of losing its last rarities off the end.
			oddsLabel.TextTruncate = Enum.TextTruncate.None
			oddsLabel.TextScaled = true
			create("UITextSizeConstraint", { MaxTextSize = 12, MinTextSize = 8, Parent = oddsLabel })
		end
		if category == "Brainrot" then
			fitLine(statLine(card, 52, (crate.description or "") .. "  Best possible drops:", C.Muted, Enum.Font.Gotham, 12), 86 + shift)

			-- The rarest brainrots this crate can actually roll, shown as photos.
			local best = {}
			for rarityIndex = #Rarity.Order, 1, -1 do
				local rarityName = Rarity.Order[rarityIndex]
				if (crate.odds[rarityName] or 0) &gt; 0 then
					for _, def in ipairs(BrainrotData.OfRarity(rarityName)) do
						if #best &lt; BEST_DROPS_SHOWN then
							table.insert(best, def)
						end
					end
				end
			end
			-- As many as the text column holds: five are 226 px, and a 320 px phone's column is 179.
			local fits = narrow and math.max(1, math.floor((contentWidth - 8 + textWidth + 4) / 46)) or #best
			for position, def in ipairs(best) do
				if position &lt;= fits then
					local photo = brainrotPhoto(card, def, 42)
					photo.Position = UDim2.fromOffset(textX + (position - 1) * 46, narrow and (106 + shift) or 70)
				end
			end
		else
			-- Item crates: what they hold, and how much of that set you already own.
			local total, have = 0, 0
			for _, id in ipairs(CosmeticData.OfKind(category)) do
				total += 1
				if profile and profile.cosmetics.owned[id] then
					have += 1
				end
			end
			fitLine(statLine(card, 52, crate.description or "", C.Muted, Enum.Font.Gotham, 12), 86 + shift)
			fitLine(statLine(card, 76, string.format("You own %d / %d  •  duplicates refund %d%%", have, total,
				math.floor((crate.duplicateRefund or 0.3) * 100)), color, Enum.Font.GothamBold, 13), 106 + shift)
		end

		local buttons = create("Frame", {
			AnchorPoint = narrow and Vector2.new(0, 1) or Vector2.new(1, 0.5),
			Position = narrow and UDim2.new(0, textX, 1, -10) or UDim2.new(1, -10, 0.5, 0),
			Size = narrow and UDim2.new(1, textWidth, 0, 39) or UDim2.fromOffset(196, 39),
			BackgroundTransparency = 1,
			Parent = card,
		}, {
			create("UIGridLayout", {
				-- Two across in the column, never wider than 95: at 95 a 320 px phone's 179 px column
				-- wrapped OPEN onto a second row, below the bottom of the card.
				CellSize = UDim2.fromOffset(narrow and math.min(95, math.floor((contentWidth - 8 + textWidth - 6) / 2)) or 95, 39),
				CellPadding = UDim2.fromOffset(6, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})

		if crate.robuxOnly then
			-- Robux crates prompt the developer product; until its ID is set in GamepassConfig the
			-- button shows the price but can't be pressed.
			local product = crate.productKey and GamepassConfig.Products[crate.productKey]
			local price = product and product.suggestedPrice or 0
			local configured = product ~= nil and product.id &gt; 0
			addButton(buttons, 1, price .. " R$", C.Accent, function()
				MarketplaceService:PromptProductPurchase(player, product.id)
			end, configured)
		else
			-- Out of stock only stops buying; crates you already have still open.
			local canAfford = profile and profile.coins &gt;= crate.coinPrice
			addButton(buttons, 1, inStock and (formatNumber(crate.coinPrice) .. " C") or "SOLD OUT", C.Accent, function()
				invoke(buyCrate, tier)
			end, inStock and canAfford)
		end

		addButton(buttons, 2, "OPEN", C.Green, function()
			-- The luck this card's odds were drawn with (captured when it was drawn): the server refuses
			-- the open if the player's luck has changed since. A card drawn without percentages has no
			-- odds to be wrong, so it sends none and the server just rolls.
			invoke(openCrate, tier, not boosted and luck or nil)
		end, owned &gt; 0)
	end
end

-- Skins, then auras, then accessories, then parachutes; within each, by rarity then price. `pairs`
-- order used to shuffle the list on every render.
local KIND_ORDER = { GunSkin = 1, Aura = 2, Accessory = 3, Parachute = 4 }

local function sortedCosmetics()
	local list = {}
	for _, item in pairs(CosmeticData.Items) do
		table.insert(list, item)
	end
	table.sort(list, function(a, b)
		local ka, kb = KIND_ORDER[a.kind] or 9, KIND_ORDER[b.kind] or 9
		if ka ~= kb then
			return ka &lt; kb
		end
		local ra, rb = Rarity.Index[a.rarity] or 0, Rarity.Index[b.rarity] or 0
		if ra ~= rb then
			return ra &lt; rb
		end
		local pa, pb = a.price or math.huge, b.price or math.huge
		if pa ~= pb then
			return pa &lt; pb
		end
		return a.name &lt; b.name
	end)
	return list
end

-- Parachute previews: the canopy itself, small, against the sky, left of the row's buttons, swinging
-- gently side to side. The tab redraws on every profile push, so each design is built once and
-- cloned after, and the swing only moves each preview's camera (one loop for all of them, which
-- drops a preview once its row is gone). In a do-block, since the main chunk is near Luau's limit
-- of 200 locals: only `parachutePreview` itself is a top-level local.
local parachutePreview
do
	-- A preview is decoration: if the designs module or one design fails, the row simply has no
	-- preview (and a warning says why) rather than the error taking the shop tab down with it.
	local loaded, ParachuteModels = pcall(require, Shared:WaitForChild("ParachuteModels"))
	if not loaded then
		warn("[MenuClient] parachute previews are off: " .. tostring(ParachuteModels))
	end
	local templates = {}
	local previews = {}

	function parachutePreview(row, id)
		if not loaded then
			return
		end
		local template = templates[id]
		if template == nil then
			local built, model = pcall(ParachuteModels.Build, id, { scale = ParachuteModels.WornScale })
			if not built or not model then
				warn(string.format("[MenuClient] no preview for parachute %s: %s", tostring(id), tostring(model)))
			end
			template = built and model or false
			templates[id] = template
		end
		if not template then
			return
		end
		local viewport = create("ViewportFrame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -118, 0.5, 0),
			Size = UDim2.fromOffset(96, 56),
			BackgroundColor3 = Color3.fromRGB(126, 182, 232),
			BorderSizePixel = 0,
			Ambient = Color3.fromRGB(170, 170, 182),
			LightColor = Color3.fromRGB(255, 250, 240),
			LightDirection = Vector3.new(-0.4, -1, 0.6),
			Parent = row,
		}, { rounded(8) })
		template:Clone().Parent = viewport
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.Parent = viewport
		viewport.CurrentCamera = camera
		ParachuteModels.FrameCamera(camera, template)
		table.insert(previews, { viewport = viewport, camera = camera, base = camera.CFrame, phase = #previews * 0.9 })
	end

	-- A preview is the first thing to go when there's no room: on a phone held upright the row is
	-- barely 300 px wide and the name and price come first. It reappears when there's width again
	-- (a rotation, a wider window), so this is checked as the previews turn rather than once.
	--
	-- The threshold is makeRow's own: under NARROW_CONTENT it stacks the row, and the stacked subtitle
	-- runs the full width (1, -28) straight under where the preview sits. So the preview goes exactly
	-- when the row stacks, not at some width of its own. A row is the content area less 8.
	local PREVIEW_MIN_ROW = NARROW_CONTENT - 8

	RunService.Heartbeat:Connect(function()
		-- Nothing to do with the menu closed: the rows are still there, but nobody can see them swing.
		if #previews == 0 or not panel.Visible then
			return
		end
		local now = os.clock()
		for index = #previews, 1, -1 do
			local preview = previews[index]
			local row = preview.viewport.Parent
			if not row then
				table.remove(previews, index)
			else
				preview.viewport.Visible = row.AbsoluteSize.X &gt;= PREVIEW_MIN_ROW
				if preview.viewport.Visible then
					-- The canopy is centred on the Y axis, so turning the camera about it swings round it.
					preview.camera.CFrame = CFrame.Angles(0, math.sin(now * 0.6 + preview.phase) * 0.55, 0) * preview.base
				end
			end
		end
	end)
end

-- What's on sale this rotation first, then everything you own, then the crate exclusives still to
-- find. Buyable items that aren't in stock right now are left out, with a note that more rotate in.
local function renderCosmetics()
	stockHeader(0, "SHOP  •  a new selection every 5 minutes, rarer items less often")
	local cosmetics = profile and profile.cosmetics
	local sections = {
		{ title = "ON SALE NOW", items = {} },
		{ title = "YOUR COSMETICS", items = {} },
		{ title = "CRATE EXCLUSIVES", items = {} },
		{ title = "BUNDLE EXCLUSIVES", items = {} },
		-- `rankOnly`: earned by prestige, gun mastery or Brain Cells (ProgressionData.RankCosmetics).
		{ title = "RANK REWARDS  •  prestige, mastery and the Cell Shop", items = {} },
	}
	local rotatingOut = 0

	for _, item in ipairs(sortedCosmetics()) do
		if item.kind == MenuScreens.KillAnimationKind then
			-- Nothing: they have their own tab (#24) and are bought and equipped there. Listed here as
			-- well they would be counted twice, and in the "more rotate through" line besides.
		elseif cosmetics and cosmetics.owned[item.id] then
			table.insert(sections[2].items, item)
		elseif item.rankOnly then
			table.insert(sections[5].items, item)
		elseif item.bundleOnly then
			table.insert(sections[4].items, item)
		elseif item.crateOnly or not item.price then
			table.insert(sections[3].items, item)
		elseif ShopRotation.IsCosmeticInStock(item.id) then
			table.insert(sections[1].items, item)
		else
			rotatingOut += 1
		end
	end

	local order = 0
	for sectionIndex, section in ipairs(sections) do
		if #section.items &gt; 0 then
			order += 1
			create("TextLabel", {
				Size = UDim2.new(1, -8, 0, 26),
				BackgroundTransparency = 1,
				Font = Enum.Font.FredokaOne,
				Text = section.title,
				TextColor3 = sectionIndex == 1 and C.Green or C.Muted,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Bottom,
				TextSize = 17,
				LayoutOrder = order,
				Parent = content,
			})
		end

		for _, item in ipairs(section.items) do
			order += 1
			local id = item.id
			local equipped = cosmetics
				and (cosmetics.gunSkin == id or cosmetics.aura == id or cosmetics.accessory == id or cosmetics.parachute == id
					or cosmetics.killAnimation == id)

			local subtitle
			if item.kind == "Accessory" then
				subtitle = string.format("%s Accessory  •  %s", item.rarity, item.description)
			else
				-- A word, not the kind's code id: "Legendary GunSkin" read as an identifier (#86).
				local KIND_WORDS = { GunSkin = "Gun Skin", KillAnimation = "Death Effect" }
				subtitle = string.format("%s %s  •  %s", item.rarity or "", KIND_WORDS[item.kind] or item.kind, item.description)
			end

			local buttons = makeRow(order, item.name, item.rarity and Rarity.Color(item.rarity) or item.color, subtitle)
			-- #78, previews everywhere: every row has one now, stacked rows included. A stacked row used to
			-- go without, because the only spot was the wide row's, where a stacked subtitle runs; the
			-- stacked spot is bottom left, level with the right-aligned button. Parachutes keep their own
			-- swinging preview on a wide row. Each tears itself down with the row.
			local stacked = buttons.Parent.Size.Y.Offset &gt; 64
			if item.kind == "Parachute" and not stacked then
				parachutePreview(buttons.Parent, id)
			else
				MenuScreens.RowPreview(buttons.Parent, id, stacked)
			end

			if sectionIndex == 5 then
				-- Where it's earned: the progression hub on the Pass tab. Rank cosmetic ids start with
				-- Prestige, Mastery or Cell (verify.py holds them to it), which picks the page.
				addButton(buttons, 1, "HOW", Color3.fromRGB(255, 150, 176), function()
					activeTab = string.find(id, "^Cell") and "CellShop" or string.find(id, "^Mastery") and "Mastery" or "Rank"
					renderTab()
				end)
			elseif sectionIndex == 4 then
				addButton(buttons, 1, "BUNDLES", C.Accent, function()
					activeTab = "Robux"
					renderTab()
				end)
			elseif sectionIndex == 3 then
				-- Live, like its BUNDLES and HOW neighbours: a greyed CRATES that did nothing left the
				-- player unsure how to get the item. The kind crates (Gun Skin, Aura, ...) are on Crates.
				addButton(buttons, 1, "FROM CRATES", C.Accent, function()
					activeTab = "Crates"
					renderTab()
				end)
			elseif sectionIndex == 1 then
				local canAfford = profile and profile.coins &gt;= item.price
				addButton(buttons, 1, formatNumber(item.price) .. " C", C.Accent, function()
					invoke(buyCosmetic, id)
				end, canAfford)
			elseif equipped then
				-- Toggles off on the server; clicking what's equipped removes it.
				addButton(buttons, 1, "UNEQUIP", C.Storm, function()
					invoke(equipCosmetic, id)
				end)
			else
				addButton(buttons, 1, "EQUIP", C.Green, function()
					invoke(equipCosmetic, id)
				end)
			end
		end
	end

	if rotatingOut &gt; 0 then
		order += 1
		create("TextLabel", {
			Size = UDim2.new(1, -8, 0, 40),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = string.format("%d more items rotate through the shop. Check back when the stock changes.", rotatingOut),
			TextColor3 = C.Muted,
			TextWrapped = true,
			TextSize = 13,
			LayoutOrder = order,
			Parent = content,
		})
	end
end

local function describeReward(reward)
	if reward.kind == "Coins" then
		return string.format("%s SahurCoins", formatNumber(reward.amount))
	elseif reward.kind == "Crate" then
		return reward.crate .. " Crate"
	end
	-- Name the cosmetic this claim will actually give: the first in the pool not yet owned, the same
	-- walk BattlePassService's grantCosmetic makes, and its 1,000-coin fallback. "Cosmetic" told the
	-- player nothing about what they were working towards (#86).
	local owned = profile and profile.cosmetics and profile.cosmetics.owned or {}
	for _, id in ipairs(BattlePassData.CosmeticPools[reward.pool] or {}) do
		if not owned[id] then
			local item = CosmeticData.Get(id)
			return "Cosmetic: " .. (item and item.name or id)
		end
	end
	return "1,000 SahurCoins (every cosmetic on this track owned)"
end

local function renderPass()
	if not profile then
		return
	end

	-- The progression hub shares this tab: a PASS | RANK | MASTERY | INDEX | CELL SHOP toggle on top,
	-- and every page but PASS is drawn by ProgressionPanel instead of the pass list below.
	if ProgressionPanel.Render(content, profile, { rerender = renderTab, noTabs = true }) then
		return
	end

	local pass = profile.pass

	-- Every unlocked, unclaimed reward, for the CLAIM ALL button.
	local claimable = 0
	for tier = 1, math.min(pass.tier, BattlePassData.MaxTier) do
		if not pass.claimedFree[tostring(tier)] then
			claimable += 1
		end
		if pass.premium and not pass.claimedPremium[tostring(tier)] then
			claimable += 1
		end
	end

	-- Your record at the top: the numbers the leaderboards and titles are built on.
	local stats = profile.stats or {}
	local unlockedTitles = 0
	if profile.achievements and profile.achievements.list then
		for _, achievement in ipairs(profile.achievements.list) do
			if achievement.unlocked then
				unlockedTitles += 1
			end
		end
	end
	local statsCard = create("Frame", {
		Size = UDim2.new(1, -8, 0, 64),
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		LayoutOrder = -1,
		Parent = content,
	}, { rounded(10), create("UIStroke", { Color = C.Accent, Thickness = 1.5, Transparency = 0.5 }) })
	local cells = {
		{ "LEVEL", tostring(pass.tier) },
		{ "WINS", formatNumber(stats.wins or 0) },
		{ "KILLS", formatNumber(stats.kills or 0) },
		{ "MATCHES", formatNumber(stats.matches or 0) },
		{ "K / MATCH", string.format("%.1f", (stats.kills or 0) / math.max(1, stats.matches or 0)) },
		{ "TITLES", string.format("%d / %d", unlockedTitles, profile.achievements and #profile.achievements.list or 0) },
		{ "COLLECTION", formatNumber(profile.brainrotValue or 0) .. " C" },
	}
	for index, cell in ipairs(cells) do
		local x = (index - 1) / #cells
		create("TextLabel", {
			Position = UDim2.new(x, 6, 0, 8),
			Size = UDim2.new(1 / #cells, -12, 0, 14),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = cell[1],
			TextColor3 = C.Muted,
			TextSize = 10,
			Parent = statsCard,
		})
		create("TextLabel", {
			Position = UDim2.new(x, 6, 0, 24),
			Size = UDim2.new(1 / #cells, -12, 0, 30),
			BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne,
			Text = cell[2],
			TextColor3 = index == 1 and C.Accent or C.Text,
			TextScaled = true,
			Parent = statsCard,
		}, { create("UITextSizeConstraint", { MaxTextSize = 22 }) })
	end

	local headerButtons = makeRow(0,
		string.format("Tier %d / %d", pass.tier, pass.maxTier),
		C.Accent,
		string.format("%d / %d XP to next tier%s",
			pass.xpIntoTier, pass.xpPerTier, pass.premium and "  •  PREMIUM ACTIVE" or ""))

	-- The Daily Spin, the same one as the booth on the island: coins, crates, an accessory, a
	-- brainrot or a pass for a day, with a streak that multiplies the coins.
	addButton(headerButtons, 1,
		profile.daily.available and "DAILY SPIN" or "SPUN TODAY",
		C.Green,
		function()
			invoke(claimDaily)
		end,
		profile.daily.available)
	-- The prize list follows DailySpinData.Segments: it used to leave out the wheel's two headline
	-- wedges (the Legendary Crate and the Legendary brainrot roll), and "day 0 streak" on a profile
	-- that has never spun read as an error (#86).
	local streak = profile.daily.streak or 0
	makeRow(0.5, streak &gt; 0 and string.format("Daily Spin  •  day %d streak", streak) or "Daily Spin  •  no streak yet", C.Green,
		"Coins (1,200 to 15,000), a Rare, Epic or Legendary Crate, an accessory, a Rare/Epic/Legendary brainrot, or any pass for 24 hours. Each streak day adds +10% to the coin prizes (up to 2x). The wheel at the Market Row booth is the same spin.")

	if not pass.premium then
		local passDef = GamepassConfig.Passes.BrainrotPassPremium
		if passDef.id &gt; 0 then
			addButton(headerButtons, 2, "GET PREMIUM", C.Accent, function()
				MarketplaceService:PromptGamePassPurchase(player, passDef.id)
			end)
		end
	end

	addButton(headerButtons, 3, claimable &gt; 0 and ("CLAIM ALL " .. claimable) or "CLAIM ALL", C.Green, function()
		invoke(claimPassAll)
	end, claimable &gt; 0)

	for tier = 1, BattlePassData.MaxTier do
		local tierDef = BattlePassData.Tiers[tier]
		local unlocked = pass.tier &gt;= tier
		local freeClaimed = pass.claimedFree[tostring(tier)]
		local premiumClaimed = pass.claimedPremium[tostring(tier)]

		-- Unlocked with something still to collect on either track.
		local ready = unlocked and (not freeClaimed or (pass.premium and not premiumClaimed))
		local buttons = makeRow(tier,
			ready and ("Tier " .. tier .. "  •  READY") or ("Tier " .. tier),
			ready and C.Green or (unlocked and C.Text or C.Muted),
			string.format("Free: %s    Premium: %s",
				describeReward(tierDef.free), describeReward(tierDef.premium)))

		addButton(buttons, 1, freeClaimed and "CLAIMED" or "FREE", C.Green, function()
			invoke(claimPassTier, tier, "free")
		end, unlocked and not freeClaimed)

		addButton(buttons, 2, premiumClaimed and "CLAIMED" or "PREMIUM", C.Accent, function()
			invoke(claimPassTier, tier, "premium")
		end, unlocked and pass.premium and not premiumClaimed)
	end
end

--------------------------------------------------------------------------------
-- Quests tab
--------------------------------------------------------------------------------

-- The reset countdown at the top of the tab; ticked in place by the loop at the bottom of the file.
local questTimerLabel = nil
-- When today's quests roll over, on our clock, from the last profile push.
local questResetAt = 0

local QUEST_TIER_COLOR = { easy = C.Green, medium = C.Accent, hard = Color3.fromRGB(255, 110, 200), weekly = Color3.fromRGB(110, 210, 255) }
local QUEST_TIER_LABEL = { easy = "EASY", medium = "MEDIUM", hard = "HARD", weekly = "WEEKLY" }

local function renderQuests()
	local quests = profile and profile.quests
	if not quests then
		emptyMessage("Loading your quests…")
		return
	end

	questTimerLabel = create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "DAILY QUESTS",
		TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 14,
		LayoutOrder = 0,
		Parent = content,
	})

	local function questCard(order, quest)
		-- On a narrow screen the reward moves under the title instead of beside it, and the card
		-- grows by that line. The title was sized `1, -310` to leave room for a 200 px reward on the
		-- right: correct at 728 of content, and MINUS 14 px at the 296 a portrait phone gives, where
		-- a negative width draws nothing at all rather than truncating. Measured by
		-- tools/menu_hud_audit.py's narrow check.
		local narrow = shell.Form ~= "large"
		local rewardDrop = narrow and 22 or 0
		local color = QUEST_TIER_COLOR[quest.tier] or C.Text
		local card = create("Frame", {
			Size = UDim2.new(1, -8, 0, 84 + rewardDrop),
			BackgroundColor3 = C.Panel,
			BorderSizePixel = 0,
			LayoutOrder = order,
			Parent = content,
		}, { rounded(10) })
		create("UIStroke", { Color = color, Thickness = 1.5, Transparency = quest.done and 0.15 or 0.6, Parent = card })

		create("TextLabel", {
			Position = UDim2.fromOffset(14, 10),
			Size = UDim2.fromOffset(0, 18),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBlack,
			Text = quest.done and "DONE" or (QUEST_TIER_LABEL[quest.tier] or "QUEST"),
			TextColor3 = Color3.new(0, 0, 0),
			TextSize = 11,
			Parent = card,
		}, {
			rounded(5),
			create("UIPadding", { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) }),
		})

		create("TextLabel", {
			Position = UDim2.fromOffset(92, 8),
			Size = narrow and UDim2.new(1, -106, 0, 22) or UDim2.new(1, -310, 0, 22),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = quest.title,
			TextColor3 = quest.done and C.Muted or C.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextSize = 16,
			Parent = card,
		})

		create("TextLabel", {
			AnchorPoint = narrow and Vector2.new(0, 0) or Vector2.new(1, 0),
			Position = narrow and UDim2.fromOffset(92, 30) or UDim2.new(1, -14, 0, 8),
			Size = narrow and UDim2.new(1, -106, 0, 20) or UDim2.fromOffset(200, 22),
			BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne,
			Text = string.format("+%s C  •  +%d XP%s", formatNumber(quest.coins), quest.xp, quest.crate and ("  •  " .. quest.crate .. " Crate") or ""),
			TextColor3 = color,
			TextXAlignment = narrow and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
			TextSize = quest.crate and 14 or 16,
			Parent = card,
		})

		local track = create("Frame", {
			Position = UDim2.fromOffset(14, 44 + rewardDrop),
			Size = UDim2.new(1, -28, 0, 12),
			BackgroundColor3 = C.PanelAlt,
			BorderSizePixel = 0,
			Parent = card,
		}, { rounded(6) })
		create("Frame", {
			Size = UDim2.fromScale(math.clamp(quest.progress / math.max(1, quest.target), 0, 1), 1),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = track,
		}, { rounded(6) })

		create("TextLabel", {
			Position = UDim2.fromOffset(14, 60 + rewardDrop),
			Size = UDim2.new(1, -28, 0, 18),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = string.format("%s / %s", formatNumber(quest.progress), formatNumber(quest.target)),
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextSize = 12,
			Parent = card,
		})
	end

	for index, quest in ipairs(quests.list) do
		questCard(index, quest)
	end

	local order = #quests.list + 1
	local bonusDone = quests.bonusClaimed
	local buttons = makeRow(order,
		bonusDone and "All three done — bonus claimed!" or string.format("Finish all three  •  %d / %d done", quests.doneCount, quests.total),
		bonusDone and C.Green or C.Text,
		string.format("+1 %s Crate on top, paid the moment the last one completes", quests.bonusCrate))
	addButton(buttons, 1, bonusDone and "CLAIMED" or "BONUS", bonusDone and C.Green or C.PanelAlt, nil, false)

	-- Weekly challenges: bigger targets, a crate each.
	if quests.weekly and #quests.weekly &gt; 0 then
		order += 1
		create("TextLabel", {
			Size = UDim2.new(1, -8, 0, 30),
			BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne,
			Text = string.format("WEEKLY CHALLENGES  •  %s left", QuestData.FormatReset(quests.weekResetIn or 0)),
			TextColor3 = QUEST_TIER_COLOR.weekly,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Bottom,
			TextSize = 17,
			LayoutOrder = order,
			Parent = content,
		})
		for _, quest in ipairs(quests.weekly) do
			order += 1
			questCard(order, quest)
		end
	end

	-- Achievements: lifetime milestones, each with a title to wear on your nameplate.
	local achievements = profile.achievements
	if achievements and achievements.list then
		order += 1
		local worn = achievements.title
		create("TextLabel", {
			Size = UDim2.new(1, -8, 0, 30),
			BackgroundTransparency = 1,
			Font = Enum.Font.FredokaOne,
			Text = "ACHIEVEMENTS &amp; TITLES" .. (worn and "" or "  •  unlock one to wear a title"),
			TextColor3 = C.Accent,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Bottom,
			TextSize = 17,
			LayoutOrder = order,
			Parent = content,
		})
		for _, achievement in ipairs(achievements.list) do
			order += 1
			local equipped = worn == achievement.id
			local buttons = makeRow(order,
				string.format("%s  —  \"%s\"", achievement.name, achievement.title),
				achievement.unlocked and C.Accent or C.Muted,
				string.format("%s  •  %s  •  +%s C", achievement.description,
					achievement.progressText
						or (formatNumber(achievement.progress) .. " / " .. formatNumber(achievement.target)),
					formatNumber(achievement.coins)))
			if not achievement.unlocked then
				addButton(buttons, 1, "LOCKED", C.PanelAlt, nil, false)
			elseif equipped then
				addButton(buttons, 1, "WEARING", C.Green, function()
					invoke(setTitle, nil)
				end)
			else
				addButton(buttons, 1, "WEAR", C.Accent, function()
					invoke(setTitle, achievement.id)
				end)
			end
		end
		order += 1
	end

	create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 40),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = "New quests every day at midnight UTC and new challenges every week — the same for everyone. Rewards land as soon as one completes, in any match on any server. The tracker on the left keeps today's in view wherever you are.",
		TextColor3 = C.Muted,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 12,
		LayoutOrder = order + 1,
		Parent = content,
	})
end

local function sortedByOrder(source)
	local entries = {}
	for _, definition in pairs(source) do
		table.insert(entries, definition)
	end
	table.sort(entries, function(a, b)
		return (a.order or 99) &lt; (b.order or 99)
	end)
	return entries
end

-- Products whose ID is still 0 can't be bought, so a live game hides them. Studio shows them with
-- the price greyed out, so the whole shop can be seen before monetization is set up.
local IS_STUDIO = RunService:IsStudio()

local function shopVisible(definition)
	return definition.id &gt; 0 or IS_STUDIO
end

-- A bundle with a `limit` the player has already bought up to.
local function bundleSoldOut(product)
	local bought = profile and profile.bundles and profile.bundles[product.key] or 0
	return product.limit ~= nil and bought &gt;= product.limit
end

local function cosmeticLabel(id)
	local item = CosmeticData.Get(id)
	if not item then
		return id
	end
	return item.kind == "GunSkin" and (item.name .. " Skin") or item.name
end

local function shopSection(order, text, color)
	create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = text,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextSize = 17,
		LayoutOrder = order,
		Parent = content,
	})
end

local LOOP_PULSE = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
local LOOP_SHINE = TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1, false, 1.4)

-- A big card for a featured product: its crate, a badge, everything inside, what it's worth and a
-- price button. Anything still buyable pulses, with a shine sweeping across it.
local function featuredCard(order, product)
	local color = product.color or C.Accent
	local configured = product.id &gt; 0
	local soldOut = bundleSoldOut(product)
	local canBuy = configured and not soldOut
	local lines = product.grant.kind == "Bundle" and GamepassConfig.DescribeContents(product.grant, cosmeticLabel) or nil
	local rows = lines and math.ceil(#lines / 2) or 0

	-- Every crate this card sells is a paid random item, so the card carries the odds that are rolled
	-- for each one (a bundle: one line per crate kind inside it), sized to wrap and never cut off.
	-- Same luck and crateBoosted rule as the Crates tab.
	local odds = {}
	do
		local tiers, seen = {}, {}
		if product.grant.kind == "Crate" then
			table.insert(tiers, product.grant.crate)
		end
		for _, entry in ipairs(product.grant.contents or {}) do
			if entry.kind == "Crate" and not seen[entry.crate] then
				seen[entry.crate] = true
				table.insert(tiers, entry.crate)
			end
		end
		local TextService = game:GetService("TextService")
		local _, width = narrowContent()
		local column = math.max(64, width - 8 - math.min(310, math.max(0, width - 64)))
		local top = lines and (66 + rows * 20 + 2)
			or (66 + TextService:GetTextSize(product.description or "", 13, Enum.Font.Gotham, Vector2.new(column, 10000)).Y + 6)
		for _, tier in ipairs(tiers) do
			local crate = CrateData.Get(tier)
			if crate then
				local boosted = profile and profile.crateBoosted and profile.crateBoosted[tier] or false
				local text = table.concat(CrateData.OddsLine(crate, profile and profile.crateLuck or 1, boosted), "   ")
				if lines then
					text = (crate.name or (tier .. " Crate")) .. ":   " .. text
				end
				local height = TextService:GetTextSize(text, 12, Enum.Font.GothamBold, Vector2.new(column, 10000)).Y + 2
				table.insert(odds, { text = text, top = top, height = height })
				top += height + 2
			end
		end
		odds.bottom = top
	end

	local card = create("Frame", {
		Size = UDim2.new(1, -8, 0, math.max(128, 70 + rows * 20 + 12, #odds &gt; 0 and odds.bottom + 12 or 0)),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		LayoutOrder = order,
		Parent = content,
	}, {
		rounded(12),
		create("UIGradient", {
			Rotation = 15,
			Color = ColorSequence.new(color:Lerp(C.Panel, 0.68), C.Panel),
		}),
	})
	local stroke = create("UIStroke", { Color = color, Thickness = 2, Transparency = 0.1, Parent = card })

	if not soldOut then
		TweenService:Create(stroke, LOOP_PULSE, { Transparency = 0.75 }):Play()
		local shine = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(-0.15, 0, 0, 0),
			Size = UDim2.new(0, 140, 1, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Parent = card,
		}, {
			create("UIGradient", {
				Rotation = 25,
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.5, 0.86),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}),
		})
		TweenService:Create(shine, LOOP_SHINE, { Position = UDim2.new(1.15, 0, 0, 0) }):Play()
	end

	-- A featured CRATE product shows that crate; a bundle keeps the generic one.
	crateIcon(card, color, 104, product.grant.kind == "Crate" and product.grant.crate or nil).Position = UDim2.fromOffset(12, 12)

	create("TextLabel", {
		Position = UDim2.fromOffset(130, 10),
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = soldOut and C.PanelAlt or color,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBlack,
		Text = soldOut and "OWNED" or (product.badge or "FEATURED"),
		TextColor3 = soldOut and C.Muted or Color3.new(0, 0, 0),
		TextSize = 12,
		Parent = card,
	}, {
		rounded(6),
		create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }),
	})

	create("TextLabel", {
		Position = UDim2.fromOffset(130, 32),
		Size = UiKit.textSpan(select(2, narrowContent()), 310, 30),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = product.name,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 26,
		Parent = card,
	})

	if lines then
		-- Two columns between the crate and the price.
		for index, text in ipairs(lines) do
			local column = (index - 1) % 2
			local row = (index - 1) // 2
			create("TextLabel", {
				Position = UDim2.new(column * 0.5, column == 0 and 130 or -25, 0, 66 + row * 20),
				Size = UDim2.new(0.5, -159, 0, 18),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				Text = "+ " .. text,
				TextColor3 = C.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				TextSize = 13,
				Parent = card,
			})
		end
	else
		create("TextLabel", {
			Position = UDim2.fromOffset(130, 66),
			Size = UiKit.textSpan(select(2, narrowContent()), 310, 52),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = product.description,
			TextColor3 = C.Text,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextSize = 13,
			Parent = card,
		})
	end

	for _, entry in ipairs(odds) do
		create("TextLabel", {
			Position = UDim2.fromOffset(130, entry.top),
			Size = UiKit.textSpan(select(2, narrowContent()), 310, entry.height),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = entry.text,
			TextColor3 = C.Text,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextSize = 12,
			Parent = card,
		})
	end

	local side = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(160, 100),
		BackgroundTransparency = 1,
		Parent = card,
	})
	create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = product.worth or "",
		TextColor3 = color,
		TextWrapped = true,
		TextSize = 13,
		Parent = side,
	})
	local button = create("TextButton", {
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = canBuy and color or C.PanelAlt,
		BorderSizePixel = 0,
		AutoButtonColor = canBuy,
		Font = Enum.Font.FredokaOne,
		Text = soldOut and "OWNED" or (product.suggestedPrice .. " R$"),
		TextColor3 = canBuy and Color3.new(0, 0, 0) or C.Muted,
		TextSize = 22,
		Parent = side,
	}, { rounded(10) })

	if canBuy then
		button.Activated:Connect(function()
			Sfx.Play("UiClick", 0.08)
			MarketplaceService:PromptProductPurchase(player, product.id)
		end)
	elseif not configured and not soldOut then
		create("TextLabel", {
			Position = UDim2.fromOffset(0, 84),
			Size = UDim2.new(1, 0, 0, 14),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = "Studio: set its ID in GamepassConfig",
			TextColor3 = C.Muted,
			TextSize = 10,
			Parent = side,
		})
	end
end

local function renderRobuxShop()
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	local featured = {}
	for _, product in ipairs(GamepassConfig.Featured()) do
		if shopVisible(product) then
			table.insert(featured, product)
		end
	end
	if #featured &gt; 0 then
		shopSection(nextOrder(), "FEATURED DEALS", C.Accent)
		for _, product in ipairs(featured) do
			featuredCard(nextOrder(), product)
		end
	end

	local passes = {}
	for _, pass in ipairs(sortedByOrder(GamepassConfig.Passes)) do
		if shopVisible(pass) then
			table.insert(passes, pass)
		end
	end
	if #passes &gt; 0 then
		shopSection(nextOrder(), "GAMEPASSES  •  yours forever", C.Storm)
		for _, pass in ipairs(passes) do
			local owned = profile and profile.ownedPasses[pass.key]
			local tempLeft = profile and profile.tempPasses and profile.tempPasses[pass.key]
			local buttons = makeRow(nextOrder(), pass.name, C.Text,
				tempLeft and string.format("%s   •   ACTIVE from the Daily Spin, %dh %02dm left", pass.description, math.floor(tempLeft / 3600), math.floor(tempLeft % 3600 / 60))
					or pass.description)
			if owned and not tempLeft then
				addButton(buttons, 1, "OWNED", C.Green, nil, false)
			else
				addButton(buttons, 1, pass.suggestedPrice .. " R$", C.Accent, function()
					MarketplaceService:PromptGamePassPurchase(player, pass.id)
				end, pass.id &gt; 0)
			end
		end
	end

	-- Brainrots for Robux: one row per rarity. Each product only sells through the brainrot picker
	-- (the Codex's buy buttons), which tells the server exactly which brainrot is being bought, so
	-- these rows open the Codex at that rarity rather than prompting a purchase directly.
	local brainrotRows = {}
	for index = #Rarity.Order, 1, -1 do
		local rarityName = Rarity.Order[index]
		local product = GamepassConfig.BrainrotProduct(rarityName)
		if product and shopVisible(product) then
			table.insert(brainrotRows, { rarity = rarityName, product = product })
		end
	end
	if #brainrotRows &gt; 0 then
		shopSection(nextOrder(), "BRAINROTS  •  pick exactly the one you want", Rarity.Color("Mythic"))
		for _, entry in ipairs(brainrotRows) do
			local buttons = makeRow(nextOrder(), string.format("Any %s brainrot  •  %d R$", entry.rarity, entry.product.suggestedPrice),
				Rarity.Color(entry.rarity), string.format("Choose any of the %d %s brainrots and it goes straight into your collection.",
					#BrainrotData.OfRarity(entry.rarity), entry.rarity))
			addButton(buttons, 1, "CHOOSE", Rarity.Color(entry.rarity), function()
				codexMode = true
				brainrotFilter = entry.rarity
				activeTab = "Brainrots"
				renderTab()
			end, entry.product.id &gt; 0 or IS_STUDIO)
		end
	end

	local products = {}
	for _, product in ipairs(sortedByOrder(GamepassConfig.Products)) do
		-- A one-match boost that can't beat a pass they own would never be spent (GamepassConfig.PlanBoosts).
		if not product.featured and not product.brainrotShop and shopVisible(product)
			and not GamepassConfig.Outclassed(product, profile and profile.ownedPasses, profile and profile.tempPasses) then
			table.insert(products, product)
		end
	end
	if #products &gt; 0 then
		shopSection(nextOrder(), "CRATES, BOOSTS &amp; COINS", C.Green)
		for _, product in ipairs(products) do
			local buttons = makeRow(nextOrder(), product.name, C.Text, product.description)
			-- A crate here is a paid random item, so its row carries the odds that are rolled, the same
			-- line the Crates tab draws (same luck, same crateBoosted rule), wrapped and never cut off.
			local crate = product.grant.kind == "Crate" and CrateData.Get(product.grant.crate)
			if crate then
				local row = buttons.Parent
				local narrow, width = narrowContent()
				local boosted = profile and profile.crateBoosted and profile.crateBoosted[product.grant.crate] or false
				local oddsText = table.concat(CrateData.OddsLine(crate, profile and profile.crateLuck or 1, boosted), "   ")
				local reserve = narrow and -28 or -320
				local column = math.max(80, width - 8 + reserve)
				local height = math.max(16, game:GetService("TextService"):GetTextSize(oddsText, 12, Enum.Font.GothamBold, Vector2.new(column, 10000)).Y + 2)
				row.Size += UDim2.fromOffset(0, height + 4)
				create("TextLabel", {
					Position = UDim2.fromOffset(14, 54),
					Size = UDim2.new(1, reserve, 0, height),
					BackgroundTransparency = 1,
					Font = Enum.Font.GothamBold,
					Text = oddsText,
					TextColor3 = C.Text,
					TextWrapped = true,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Top,
					TextSize = 12,
					Parent = row,
				})
			end
			addButton(buttons, 1, product.suggestedPrice .. " R$", C.Green, function()
				MarketplaceService:PromptProductPurchase(player, product.id)
			end, product.id &gt; 0)
		end
	end

	if order == 0 then
		emptyMessage("No passes or products set up yet.\n\nCreate them on the Roblox Creator Dashboard, then paste their IDs into ReplicatedStorage.Shared.GamepassConfig.")
	elseif IS_STUDIO then
		create("TextLabel", {
			Size = UDim2.new(1, -8, 0, 40),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = "Studio preview: greyed-out prices have no ID yet and are hidden in a live game. Paste IDs into GamepassConfig.",
			TextColor3 = C.Muted,
			TextWrapped = true,
			TextSize = 12,
			LayoutOrder = nextOrder(),
			Parent = content,
		})
	end
end

--------------------------------------------------------------------------------
-- Settings tab
--------------------------------------------------------------------------------

-- The action waiting for a new key, and when a key was last captured: the press that sets a
-- binding must not also do what that key does (capturing M would otherwise close the menu).
local listeningFor = nil
local listenConnection = nil
local lastKeyCaptureAt = 0
local settingsNotice = nil

local function stopListening()
	listeningFor = nil
	if listenConnection then
		listenConnection:Disconnect()
		listenConnection = nil
	end
end

local function settingsHeader(order, text, onReset)
	local row = create("Frame", {
		Size = UDim2.new(1, -8, 0, 32),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = content,
	})
	create("TextLabel", {
		Size = UDim2.new(1, -110, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = text,
		TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextSize = 19,
		Parent = row,
	})
	local reset = create("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(100, 26),
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "RESET",
		TextColor3 = C.Muted,
		TextSize = 12,
		Parent = row,
	}, { rounded(6) })
	reset.Activated:Connect(function()
		Sfx.Play("UiClick", 0.08)
		stopListening()
		settingsNotice = text .. " reset to defaults."
		onReset()
		renderTab()
	end)
end

local function settingsRow(order, label)
	local row = create("Frame", {
		Size = UDim2.new(1, -8, 0, 42),
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = content,
	}, { rounded(8) })
	create("TextLabel", {
		Position = UDim2.new(0, 14, 0, 0),
		Size = UDim2.new(0.45, -14, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = label,
		TextColor3 = C.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		-- Cut with an ellipsis inside its 45%: unclipped, a long label ("Crouch - slides if you're
		-- sprinting") ran on under the 150 px key button, which painted over its tail (#86).
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 14,
		Parent = row,
	})
	return row
end

local function formatSetting(entry, value)
	if entry.percent then
		return string.format("%d%%", math.floor(value * 100 + 0.5))
	elseif entry.id == "FieldOfView" then
		return string.format("%d°", value)
	end
	return string.format("%.2fx", value)
end

local function keyRow(order, action)
	local row = settingsRow(order, action.label)
	local listening = listeningFor == action.id
	local button = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(150, 30),
		BackgroundColor3 = listening and C.Accent or C.PanelAlt,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = listening and "Press a key…" or Settings.KeyLabel(action.id),
		TextColor3 = listening and Color3.new(0, 0, 0) or C.Text,
		TextSize = 14,
		Parent = row,
	}, { rounded(6) })

	button.Activated:Connect(function()
		Sfx.Play("UiClick", 0.08)
		stopListening()
		listeningFor = action.id
		settingsNotice = "Press the new key for " .. action.label .. " (Escape cancels)."
		listenConnection = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				return
			end
			lastKeyCaptureAt = os.clock()
			if input.KeyCode == Enum.KeyCode.Escape then
				settingsNotice = nil
			elseif Settings.SetKey(action.id, input.KeyCode) then
				settingsNotice = action.label .. " is now " .. Settings.KeyLabel(action.id) .. "."
			else
				settingsNotice = input.KeyCode.Name .. " is kept for movement, chat or Roblox itself. Pick another key."
			end
			stopListening()
			renderTab()
		end)
		renderTab()
	end)
end

local function sliderRow(order, entry)
	local row = settingsRow(order, entry.label)
	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(60, 30),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 14,
		Parent = row,
	})
	local track = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -84, 0.5, 0),
		-- 240 wide where there is room, and otherwise what is left right of the label (which takes
		-- 0.45 of the row). A flat 240 plus the 84 for the value ran 11 px off the left of a 313 px row
		-- on a 390 px phone, across the setting's own name.
		Size = UDim2.new(0.55, -92, 0, 10),
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	}, { rounded(5), create("UISizeConstraint", { MaxSize = Vector2.new(240, 10) }) })
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Parent = track,
	}, { rounded(5) })
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = C.Text,
		BorderSizePixel = 0,
		Parent = track,
	}, { rounded(9) })

	local function show(value)
		local alpha = (value - entry.min) / (entry.max - entry.min)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		valueLabel.Text = formatSetting(entry, value)
	end
	show(Settings.Get(entry.id))

	local function setFromX(x)
		local alpha = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		Settings.Set(entry.id, entry.min + alpha * (entry.max - entry.min))
		show(Settings.Get(entry.id))
	end

	-- Drag listeners exist only while the button is held, so re-rendering never leaks them.
	track.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		setFromX(input.Position.X)
		local moved, ended
		moved = UserInputService.InputChanged:Connect(function(change)
			if change.UserInputType == Enum.UserInputType.MouseMovement or change.UserInputType == Enum.UserInputType.Touch then
				setFromX(change.Position.X)
			end
		end)
		ended = UserInputService.InputEnded:Connect(function(finish)
			if finish.UserInputType == input.UserInputType then
				moved:Disconnect()
				ended:Disconnect()
			end
		end)
	end)
end

local function toggleRow(order, entry)
	local row = settingsRow(order, entry.label)
	local on = Settings.Get(entry.id)
	local button = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(90, 30),
		BackgroundColor3 = on and C.Green or C.PanelAlt,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = on and "ON" or "OFF",
		TextColor3 = on and Color3.new(0, 0, 0) or C.Muted,
		TextSize = 14,
		Parent = row,
	}, { rounded(6) })
	button.Activated:Connect(function()
		Sfx.Play("UiClick", 0.08)
		Settings.Set(entry.id, not Settings.Get(entry.id))
		renderTab()
	end)
end

local SETTINGS_SECTIONS = {
	{ title = "CONTROLS", groups = { "Combat", "Loadout", "General" }, list = Settings.Actions, row = keyRow },
	{ title = "AUDIO", groups = { "Audio" }, list = Settings.Sliders, row = sliderRow },
	{ title = "CAMERA", groups = { "Camera" }, list = Settings.Sliders, row = sliderRow },
	{ title = "GAMEPLAY", groups = { "Gameplay" }, list = Settings.Toggles, row = toggleRow },
}

local function renderSettings()
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = settingsNotice or "Click a key to rebind it. Everything saves to your profile automatically.",
		TextColor3 = settingsNotice and C.Accent or C.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextSize = 13,
		LayoutOrder = nextOrder(),
		Parent = content,
	})

	for _, section in ipairs(SETTINGS_SECTIONS) do
		settingsHeader(nextOrder(), section.title, function()
			for _, group in ipairs(section.groups) do
				Settings.ResetGroup(group)
			end
		end)
		for _, group in ipairs(section.groups) do
			for _, entry in ipairs(section.list) do
				if entry.group == group then
					section.row(nextOrder(), entry)
				end
			end
		end
	end
end

-- The STYLE CRATES: cosmetic crates in tiers (Oliver, 2026-09-18). One renderer, two placements —
-- its own destination on desktop and landscape phones, and a filter inside CRATES on a portrait
-- phone, where five destinations is the budget. The shell decides which; this draws the same cards.
--
-- Every tier is sold for coins AND Robux, so each card carries two prices and an odds line. That
-- makes it the densest row in the menu, which is why it is built on UiParts.splitRow: the odds line
-- is a `disclosure`, so it wraps and never truncates at any width — a cut-off probability on
-- something people buy is a wrong number, not an untidy one. These crates are never touched by
-- Beginner's Luck (CrateData.BeginnerBoosted is brainrot-only), so their odds are always exact.
local STYLE_TIERS = { "Style", "DeluxeStyle", "PrestigeStyle" }

local function renderStyleCrates()
	local _, width = narrowContent()
	stockHeader(0, "STYLE CRATES  •  accessories, gun skins, auras and parachutes, never one you own", true)
	for index, tier in ipairs(STYLE_TIERS) do
		local crate = CrateData.Get(tier)
		local owned = profile and (profile.crates[tier] or 0) or 0
		local luck = profile and profile.crateLuck or 1
		local product = crate.productKey and GamepassConfig.Products[crate.productKey]
		local canAfford = profile and crate.coinPrice and profile.coins &gt;= crate.coinPrice
		local actions = {
			{ kind = "primary", text = "OPEN", width = 92, enabled = owned &gt; 0, onClick = function()
				Sfx.Play("UiClick", 0.08)
				invoke(openCrate, tier, luck)
			end },
			{ kind = "secondary", text = formatNumber(crate.coinPrice) .. " C", width = 104, enabled = canAfford == true, onClick = function()
				Sfx.Play("UiClick", 0.08)
				invoke(buyCrate, tier)
			end },
			{ kind = "secondary", text = (product and product.suggestedPrice or 0) .. " R$", width = 96,
				enabled = product ~= nil and product.id &gt; 0, onClick = function()
					MarketplaceService:PromptProductPurchase(player, product.id)
				end },
		}
		-- Room for the heading, the description and THREE lines of odds. A Style tier lists up to
		-- seven rarities, which is about 90 characters: at the row's text width that is two lines at
		-- best and three when the panel is narrow, and the row has to be tall enough for the worst
		-- case before the label is measured.
		local lineHeight = UiKit.Type.Caption.Size + 6
		-- Measured, not assumed: three lines was the worst case down to about 360 px, and on a 320 px
		-- phone the odds wrap to four and ran out of the bottom of the row. The column's width is
		-- splitRow's own (media 72 or 102, 16 padding, and the three buttons beside the text when wide).
		local oddsText = table.concat(CrateData.OddsLine(crate, luck, false), "   ")
		local oddsColumn = width &lt; 560 and (width - 16 - 72 - 12 - 16) or (width - 16 - 102 - 12 - (92 + 104 + 96 + 16) - 12 - 16)
		local oddsHeight = game:GetService("TextService"):GetTextSize(oddsText, UiKit.Type.Caption.Size, UiKit.Type.Caption.Font,
			Vector2.new(math.max(oddsColumn, 80), 10000)).Y
		local row = UiParts.splitRow(content, {
			width = width,
			mediaInstance = crateIcon(nil, crate.color or Rarity.Color(tier), 102, tier),
			textHeight = UiKit.Type.Heading.Size + 6 + lineHeight * 2 + math.max(lineHeight * 2, oddsHeight + 6),
			layoutOrder = index,
			actions = actions,
		})
		row.Line({ text = string.format("%s  (owned: %d)", crate.name, owned), style = UiKit.Type.Heading,
			color = crate.color or Rarity.Color(tier) })
		row.Line({ text = crate.description or "", style = UiKit.Type.Caption, color = UiKit.Role.TextMuted })
		-- The odds are drawn here rather than through row.Line because a Line is a fixed one or two
		-- lines tall and CLIPS what doesn't fit -- which cut "Myth 0.40%  Secr 0.10%" off the end of
		-- the Style Crate's odds, the two rarities somebody spending 8,000 coins is buying for. A
		-- displayed probability on something sold may never be cut off, so this label grows to fit
		-- (AutomaticSize) and truncation is off outright.
		UiParts.text(row.Text, UiKit.Type.Caption, oddsText,
			UiKit.Role.Text, {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextWrapped = true,
				TextTruncate = Enum.TextTruncate.None,
				TextYAlignment = Enum.TextYAlignment.Top,
				LayoutOrder = 3,
			})
		-- No guarantee line here either, for the same reason the brainrot cards lost theirs (Oliver,
		-- 2026-09-17: "get rid of the (rank) in 20 opens thing"). The guarantee still fires -- pity
		-- lives in CrateService and the open says "(guaranteed -- your luck was due)" when it does --
		-- and the odds on the row stay the real per-roll odds, which pity only ever improves on.
	end
end

local TABS = {
	{ key = "Brainrots", label = "Brainrots", render = renderBrainrots },
	{ key = "Trade", label = "Trade", render = renderTrade },
	{ key = "Crates", label = "Crates", render = renderCrates },
	{ key = "Style", label = "Style Crates", render = renderStyleCrates },
	{ key = "Cosmetics", label = "Cosmetics", render = renderCosmetics },
	-- #24, Death Effects (kind "KillAnimation"; the key keeps the first name). Drawn from
	-- CosmeticData.OfKind("KillAnimation") with this file's own rows under a live preview stage, and
	-- bought and equipped through the same two remotes as every other cosmetic.
	{ key = "KillAnimations", label = "Death Effects", render = function()
		MenuScreens.RenderKillAnimations({
			profile = profile,
			content = content,
			makeRow = makeRow,
			addButton = addButton,
			emptyMessage = emptyMessage,
			stockHeader = stockHeader,
			formatNumber = formatNumber,
			narrow = (narrowContent()),
			buy = function(id)
				invoke(buyCosmetic, id)
			end,
			equip = function(id)
				invoke(equipCosmetic, id)
			end,
		})
	end },
	-- Oliver 09-22 14:15: rank, mastery and the cell shop were all under the Pass tab. Each progression
	-- page is its own tab now; they share the Pass renderer, which hands every page but PASS to
	-- ProgressionPanel.
	{ key = "Pass", label = "Pass", render = function() ProgressionPanel.View = "Pass"; renderPass() end },
	{ key = "Rank", label = "Rank", render = function() ProgressionPanel.View = "Rank"; renderPass() end },
	{ key = "Mastery", label = "Mastery", render = function() ProgressionPanel.View = "Mastery"; renderPass() end },
	{ key = "Index", label = "Rot Index", render = function() ProgressionPanel.View = "Index"; renderPass() end },
	{ key = "CellShop", label = "Cell Shop", render = function() ProgressionPanel.View = "Shop"; renderPass() end },
	{ key = "Quests", label = "Quests", render = renderQuests },
	{ key = "Robux", label = "Robux Shop", render = renderRobuxShop },
	{ key = "Settings", label = "Settings", render = renderSettings },
}

-- The tabs, handed to the shell as destinations -- only the tabs of the screen the active one is on
-- (Oliver, 2026-09-22 13:59: "separate buttons, each its own page"). Which screen holds which tab,
-- each tab's glyph and subtitle, and how many a portrait phone's bar can carry, live in MenuScreens;
-- this only says what each tab is called and which renderer it runs.
local function renderTabStrip()
	local destinations, screen = MenuScreens.Destinations(activeTab, function(key)
		for _, tab in ipairs(TABS) do
			if tab.key == key then
				return tab.label
			end
		end
		return nil
	end, shell.phone)
	shell:SetTitle(screen and screen.title or "BRAINROT BATTLES")
	shell:SetDestinations(destinations, activeTab)
end

-- Selecting a destination does exactly what the old tab button's Activated handler did.
shell.onSelect = function(key)
	stopListening()
	settingsNotice = nil
	activeTab = key
	renderTab()
end

renderTab = function()
	if not panel.Visible then
		return
	end

	renderTabStrip()
	clearItems(content)

	for _, tab in ipairs(TABS) do
		if tab.key == activeTab then
			tab.render()
			return
		end
	end
end

--------------------------------------------------------------------------------
-- Crate reveal
--------------------------------------------------------------------------------
-- IN A DO-BLOCK, and it is the whole crate reveal. This file's main chunk reached 200 top-level
-- locals -- Luau's hard limit -- at which point one more anywhere in the file stops it compiling,
-- SILENTLY: no error at build time, and the entire menu simply does not run. Locals declared inside
-- a do-block are released at its end, so the 35 declared below cost the main chunk nothing.
--
-- The reveal was chosen because it is genuinely self-contained: none of its 35 names is referenced
-- anywhere before this block or after it (checked by name across the whole file, both directions),
-- so enclosing it changes no behaviour. It is the same treatment HudClient already gives its drop
-- screen and its inventory, and for the same reason.
--
-- If you add a top-level local to this file, check `verify.py`'s "main-chunk locals" line first.
do

-- Full-screen opening. Everything is built from parts in a ViewportFrame, so there are no image
-- assets. Click to skip to the reveal, click again to close.
--
-- The build-up scales with what's inside: the crate's bands climb the rarity ladder one tier per
-- beat, each beat a notch higher in pitch, and the climb only stops at the prize's tier. A Common
-- pops almost at once; a Secret keeps climbing through every colour while the crate shakes itself
-- apart. Epic and up add light rays behind the prize, Legendary and up a screen shake and confetti,
-- Secret a rainbow finale — and a coin jackpot rains coins on top of whatever came out.

local CLIMB_START = 0.55
local CLIMB_STEP = 0.32
local AUTO_CLOSE_AFTER = 4.5
local MAX_RAYS = 16
local TIER_SHOUT = { Epic = "EPIC!", Legendary = "LEGENDARY!!", Mythic = "MYTHIC!!!", Secret = "S E C R E T" }

local revealOverlay = create("TextButton", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 1,
	AutoButtonColor = false,
	Text = "",
	Visible = false,
	ZIndex = 50,
	Parent = screenGui,
})

-- Light rays: bars through the centre of the prize, each fading out towards both ends.
local revealRays = create("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	ClipsDescendants = true,
	Parent = revealOverlay,
})

local rayBars = {}
for index = 1, MAX_RAYS / 2 do
	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(46, 1400),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Visible = false,
		Parent = revealRays,
	}, {
		create("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.25),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	rayBars[index] = bar
end

local revealViewport = create("ViewportFrame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.4),
	Size = UDim2.fromOffset(420, 340),
	BackgroundTransparency = 1,
	Ambient = Color3.fromRGB(150, 150, 162),
	LightColor = Color3.fromRGB(255, 250, 240),
	LightDirection = Vector3.new(-0.3, -1, 0.5),
	Parent = revealOverlay,
})

local revealCamera = Instance.new("Camera")
revealCamera.FieldOfView = 40
revealCamera.CFrame = CFrame.lookAt(Vector3.new(0, 3.2, -13), Vector3.new(0, 1.6, 0))
revealCamera.Parent = revealViewport
revealViewport.CurrentCamera = revealCamera

local revealFlash = create("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(1, 1, 1),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Parent = revealOverlay,
})

-- Confetti and coins live here so closing the reveal can sweep them all at once.
local revealParticles = create("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	ClipsDescendants = true,
	Parent = revealOverlay,
})

local function revealText(yOffset, height, font, size, color)
	return create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.4, yOffset),
		Size = UDim2.fromOffset(720, height),
		BackgroundTransparency = 1,
		Font = font,
		Text = "",
		TextColor3 = color,
		TextStrokeTransparency = 0.5,
		TextTransparency = 1,
		TextSize = size,
		Parent = revealOverlay,
	})
end

local revealRarity = revealText(176, 28, Enum.Font.GothamBold, 22, C.Accent)
local revealName = revealText(206, 60, Enum.Font.FredokaOne, 52, C.Text)
local revealValue = revealText(270, 26, Enum.Font.Gotham, 17, C.Muted)
local revealJackpot = revealText(300, 34, Enum.Font.FredokaOne, 30, Color3.fromRGB(255, 214, 64))
local revealHint = revealText(342, 22, Enum.Font.Gotham, 14, C.Muted)

-- The big tier shout above the crate ("LEGENDARY!!"), punched in with a UIScale.
local revealShout = create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.13),
	Size = UDim2.fromOffset(900, 90),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "",
	TextColor3 = C.Text,
	TextSize = 78,
	TextStrokeTransparency = 0.2,
	TextTransparency = 1,
	Parent = revealOverlay,
})
local revealShoutScale = Instance.new("UIScale")
revealShoutScale.Parent = revealShout

local function revealPart(parent, name, size, cframe, color, material, shape)
	local part = Instance.new("Part")
	part.Name = name
	if shape then
		part.Shape = shape
	end
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- The crate is the shared one (CrateModels), which hands back every part that takes the tier
-- colour so the climb can recolour them. The lid's decorations ride on the lid.
local function buildRevealCrate(color, tier)
	local model, lid, lidBand, tinted = CrateModels.Crate(tier, { color = color })
	return model, lid, lidBand, tinted
end

-- A parachute comes out as its real canopy (ParachuteModels, which falls back to the Rot Glider for
-- an unknown id). It's built once at its normal size to measure it, then again at the scale that makes
-- its longest side about as big as the other prizes, so the reveal camera needs no change. Its pivot
-- is moved to its centre, so the rise-and-turn spins it in place rather than swinging it round a corner.
-- An accessory prize is the REAL accessory (claude-df's CosmeticBuild, the same geometry
-- AccessoryService welds to a head), so what the reveal shows can't drift from what the player gets.
-- Built once at scale 1 to measure it, then once more at the scale that makes it sit with the other
-- prizes — not rebuilt per frame, because the z-fight pass can nudge pieces and that would jitter.
-- Anything without buildable geometry still falls back to the coloured orb.
local function buildPrizeAccessory(id, fallbackColor)
	local ACCESSORY_PRIZE_SIZE = 4.5
	local CosmeticBuild = require(Shared:WaitForChild("CosmeticBuild"))
	local item = id and CosmeticData.Get(id)
	if not item or type(item.parts) ~= "table" or #item.parts == 0 then
		return nil
	end
	local ok, measure = pcall(CosmeticBuild.Model, item, CFrame.new(), 1, "PrizeAccessoryMeasure")
	if not ok or not measure then
		return nil
	end
	local _, size = measure:GetBoundingBox()
	measure:Destroy()
	local longest = math.max(size.X, size.Y, size.Z)
	local built, model = pcall(CosmeticBuild.Model, item, CFrame.new(), longest &gt; 0 and ACCESSORY_PRIZE_SIZE / longest or 1,
		"PrizeAccessory")
	if not built or not model then
		return nil
	end
	local body = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if body then
		model.PrimaryPart = body
		local box = model:GetBoundingBox()
		body.PivotOffset = body.CFrame:ToObjectSpace(box)
	end
	return model
end

local function buildPrizeParachute(id)
	local PARACHUTE_PRIZE_SIZE = 5.5
	local measure = ParachuteModels.Build(id, { scale = 1 })
	local _, size = measure:GetBoundingBox()
	measure:Destroy()
	local longest = math.max(size.X, size.Y, size.Z)
	local model = ParachuteModels.Build(id, { scale = longest &gt; 0 and PARACHUTE_PRIZE_SIZE / longest or 1 })
	local body = model.PrimaryPart
	if body then
		-- GetBoundingBox returns the box's CFrame AND its size; only the CFrame may reach ToObjectSpace,
		-- which takes any number of CFrames and errors on the size.
		local box = model:GetBoundingBox()
		body.PivotOffset = body.CFrame:ToObjectSpace(box)
	end
	return model
end

-- Accessories and auras have no creature to show, so they come out as a glowing prize orb.
local function buildPrizeOrb(color)
	local model = Instance.new("Model")
	revealPart(model, "Orb", Vector3.new(2.2, 2.2, 2.2), CFrame.new(), color, Enum.Material.Neon, Enum.PartType.Ball)
	for index = 0, 7 do
		local angle = index / 8 * math.pi * 2
		revealPart(model, "Ring", Vector3.new(0.5, 0.15, 0.2),
			CFrame.Angles(0.4, angle, 0) * CFrame.new(0, 0, 1.8), Color3.fromRGB(255, 220, 110), Enum.Material.Neon)
	end
	return model
end

-- A chunky toy blaster painted in the skin's colour.
local function buildPrizeGun(color)
	local model = Instance.new("Model")
	local dark = Color3.fromRGB(40, 42, 48)
	revealPart(model, "Body", Vector3.new(0.9, 1, 3), CFrame.new(0, 0.2, 0), color, Enum.Material.SmoothPlastic)
	revealPart(model, "Barrel", Vector3.new(2.2, 0.45, 0.45), CFrame.new(0, 0.35, -2.4) * CFrame.Angles(0, math.pi / 2, 0),
		dark, Enum.Material.Metal, Enum.PartType.Cylinder)
	revealPart(model, "Grip", Vector3.new(0.7, 1.4, 0.8), CFrame.new(0, -0.7, 0.8) * CFrame.Angles(-0.3, 0, 0), dark, Enum.Material.SmoothPlastic)
	revealPart(model, "Sight", Vector3.new(0.3, 0.35, 0.6), CFrame.new(0, 0.85, -0.6), color:Lerp(Color3.new(1, 1, 1), 0.4), Enum.Material.Neon)
	revealPart(model, "Mag", Vector3.new(0.5, 1, 0.6), CFrame.new(0, -0.6, -0.6), color:Lerp(Color3.new(0, 0, 0), 0.3), Enum.Material.SmoothPlastic)
	model:PivotTo(CFrame.Angles(0, math.pi / 2, 0))
	return model
end

-- A refund comes out as a little stack of SahurCoins.
local function buildPrizeCoins()
	local model = Instance.new("Model")
	local gold = Color3.fromRGB(255, 200, 60)
	for index = 0, 3 do
		revealPart(model, "Coin", Vector3.new(0.35, 2, 2), CFrame.new(math.sin(index) * 0.15, index * 0.4 - 0.6, 0) * CFrame.Angles(0, 0, math.pi / 2),
			gold, Enum.Material.Foil, Enum.PartType.Cylinder)
	end
	return model
end

local revealToken = 0
local revealConnection = nil
local revealPhase = "closed"
local revealSkip = false

local function clearReveal()
	revealToken += 1
	if revealConnection then
		revealConnection:Disconnect()
		revealConnection = nil
	end
	for _, child in ipairs(revealViewport:GetChildren()) do
		if not child:IsA("Camera") then
			child:Destroy()
		end
	end
	for _, child in ipairs(revealParticles:GetChildren()) do
		child:Destroy()
	end
	for _, bar in ipairs(rayBars) do
		bar.Visible = false
	end
	revealViewport.Position = UDim2.fromScale(0.5, 0.4)
	revealOverlay.Visible = false
	revealPhase = "closed"
end

revealOverlay.Activated:Connect(function()
	if revealPhase == "reveal" then
		clearReveal()
	else
		revealSkip = true
	end
end)

-- Confetti (rarity-coloured squares) or coins (gold circles) bursting up and falling back down.
local function spawnParticles(list, count, colorFor, isCoin)
	for _ = 1, count do
		local size = isCoin and math.random(18, 28) or math.random(8, 14)
		local frame = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.4),
			Size = UDim2.fromOffset(size, isCoin and size or size * 0.6),
			BackgroundColor3 = colorFor(),
			BorderSizePixel = 0,
			Parent = revealParticles,
		}, isCoin and { rounded(size), create("UIStroke", { Color = Color3.fromRGB(180, 120, 20), Thickness = 2 }) } or nil)
		local angle = math.random() * math.pi * 2
		local speed = 0.25 + math.random() * 0.55
		table.insert(list, {
			frame = frame,
			x = 0.5,
			y = 0.4,
			vx = math.cos(angle) * speed * 0.6,
			vy = -math.abs(math.sin(angle)) * speed - 0.25,
			spin = (math.random() - 0.5) * 720,
		})
	end
end

local function stepParticles(list, dt)
	for index = #list, 1, -1 do
		local particle = list[index]
		particle.vy += 1.1 * dt
		particle.vx *= 0.99
		particle.x += particle.vx * dt
		particle.y += particle.vy * dt
		particle.frame.Position = UDim2.fromScale(particle.x, particle.y)
		particle.frame.Rotation += particle.spin * dt
		if particle.y &gt; 1.1 then
			particle.frame:Destroy()
			table.remove(list, index)
		end
	end
end

local CATEGORY_LABEL = { Brainrot = " BRAINROT", Accessory = " ACCESSORY", GunSkin = " GUN SKIN", Aura = " AURA", Parachute = " PARACHUTE", KillAnimation = " DEATH EFFECT", Refund = "" }

crateOpened.OnClientEvent:Connect(function(result)
	clearReveal()
	local token = revealToken
	revealSkip = false
	revealPhase = "crate"

	local tierIndex = Rarity.Index[result.rarity] or 1
	local isSecret = result.rarity == "Secret"
	local popAt = CLIMB_START + tierIndex * CLIMB_STEP
	local crateColor = typeof(result.crateColor) == "Color3" and result.crateColor or Rarity.Color("Common")
	local prizeColor = Rarity.Color(result.rarity)
	local kind = result.kind or "Brainrot"

	local crate, lid, lidBand, tinted = buildRevealCrate(crateColor, result.crateId)
	crate.Parent = revealViewport

	local crateBase = {}
	for _, part in ipairs(crate:GetDescendants()) do
		if part:IsA("BasePart") then
			crateBase[part] = part.CFrame
		end
	end
	-- The lid and everything riding on it (dome, band, padlock) swing together on the lid's hinge.
	-- CrateModels puts that hinge at the middle of the lid's back edge and repeats it as the "Hinge"
	-- attribute for animation by CFrame, which is what this is; PivotOffset is the same value and is
	-- the fallback if a tier is ever built without the attribute.
	local lidStart = lid.CFrame
	-- The swing itself is in Shared/CrateOpen, so the reveal, the world containers and the gallery
	-- that renders it frame by frame all play the same curve. (Required here rather than at the top
	-- of the file: the main chunk is near Luau's limit of 200 locals.)
	local CrateOpen = require(Shared:WaitForChild("CrateOpen"))
	local lidHinge = CrateOpen.Hinge(lid)
	local lidSwing = CrateOpen.Duration(result.crateId)
	local lidParts = { { part = lid, offset = CFrame.identity } }
	for _, part in ipairs(lid:GetDescendants()) do
		if part:IsA("BasePart") then
			table.insert(lidParts, { part = part, offset = lidStart:ToObjectSpace(part.CFrame) })
		end
	end

	if kind == "Refund" then
		revealRarity.Text = "NOTHING NEW LEFT AT " .. string.upper(result.rarity)
		revealValue.Text = "You own every one of those, so here's a refund instead."
	else
		revealRarity.Text = string.upper(result.rarity) .. (CATEGORY_LABEL[kind] or "")
		if kind == "Brainrot" then
			revealValue.Text = string.format("Worth %s SahurCoins  •  equip it from Brainrots to have it fight for you",
				formatNumber(result.coinValue or 0))
		else
			revealValue.Text = kind == "KillAnimation" and "New! Equip it from Shop → Death Effects."
				or "New! Equip it from the Cosmetics tab."
		end
	end
	revealRarity.TextColor3 = prizeColor
	revealName.Text = result.name or "?"
	revealName.TextColor3 = prizeColor
	revealJackpot.Text = result.jackpot and string.format("+%s SAHURCOIN JACKPOT!", formatNumber(result.jackpot)) or ""
	revealHint.Text = "Click to continue"
	for _, label in ipairs({ revealRarity, revealName, revealValue, revealJackpot, revealHint, revealShout }) do
		label.TextTransparency = 1
		label.TextStrokeTransparency = 1
	end
	revealFlash.BackgroundTransparency = 1

	local rayCount = tierIndex &gt;= 4 and math.min(MAX_RAYS / 2, (tierIndex - 3) * 2) or 0

	revealOverlay.Visible = true
	revealOverlay.BackgroundTransparency = 1
	TweenService:Create(revealOverlay, TweenInfo.new(0.25), { BackgroundTransparency = 0.25 }):Play()

	local start = os.clock()
	local last = start
	local prize = nil
	local climbed = 0
	local shake = 0
	local particles = {}
	local closeAfter = AUTO_CLOSE_AFTER + tierIndex * 0.5

	revealConnection = RunService.RenderStepped:Connect(function()
		if token ~= revealToken then
			return
		end
		local now = os.clock()
		local dt = math.min(now - last, 0.1)
		last = now
		local t = now - start
		if revealSkip and t &lt; popAt then
			start = now - popAt
			t = popAt
			climbed = tierIndex
		end

		stepParticles(particles, dt)

		if not prize then
			-- Drop in with a bounce...
			local drop = math.clamp(t / 0.4, 0, 1)
			local height = (1 - drop) ^ 2 * 8

			-- ...then climb the rarity ladder, one tier per beat, until the prize's tier.
			local step = math.clamp(math.floor((t - CLIMB_START) / CLIMB_STEP) + 1, 0, tierIndex)
			while climbed &lt; step do
				climbed += 1
				local stepColor = Rarity.Color(Rarity.Order[climbed])
				for _, part in ipairs(tinted) do
					part.Color = stepColor
				end
				Sfx.Play("UiClick", nil, 0.8 + climbed * 0.2)
				revealFlash.BackgroundColor3 = stepColor
				revealFlash.BackgroundTransparency = 0.82
				TweenService:Create(revealFlash, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
			end

			-- The rattle grows with every tier climbed.
			local rattle = 0
			if t &gt; CLIMB_START then
				local intensity = math.clamp((t - CLIMB_START) / (popAt - CLIMB_START), 0, 1) * (0.5 + climbed * 0.12)
				rattle = math.sin(t * (30 + intensity * 40)) * intensity * 0.3
			end
			local bump = climbed &gt; 0 and math.max(0, 1 - ((t - CLIMB_START) % CLIMB_STEP) / 0.12) * 0.25 or 0
			local offset = CFrame.new(0, height + bump, 0) * CFrame.Angles(0, 0, rattle)
			for part, base in pairs(crateBase) do
				part.CFrame = offset * base
			end

			if t &gt;= popAt then
				revealPhase = "reveal"
				Sfx.Play("CrateOpen", nil, math.max(0.55, 1 - tierIndex * 0.06))

				revealFlash.BackgroundColor3 = prizeColor:Lerp(Color3.new(1, 1, 1), 0.5)
				revealFlash.BackgroundTransparency = tierIndex &gt;= 5 and 0 or 0.1
				TweenService:Create(revealFlash, TweenInfo.new(0.4 + tierIndex * 0.1), { BackgroundTransparency = 1 }):Play()

				local def = kind == "Brainrot" and BrainrotData.Get(result.name) or nil
				local itemColor = typeof(result.color) == "Color3" and result.color or prizeColor
				if def then
					prize = BrainrotModels.Build(def, { glow = prizeColor })
				elseif kind == "GunSkin" then
					prize = buildPrizeGun(itemColor)
				elseif kind == "Accessory" then
					prize = buildPrizeAccessory(result.id, itemColor) or buildPrizeOrb(itemColor)
				elseif kind == "Parachute" then
					prize = buildPrizeParachute(result.id)
				elseif kind == "Refund" then
					prize = buildPrizeCoins()
				else
					prize = buildPrizeOrb(itemColor)
				end
				prize.Parent = revealViewport

				for index, label in ipairs({ revealRarity, revealName, revealValue, revealJackpot, revealHint }) do
					TweenService:Create(label, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out,
						0, false, 0.15 + index * 0.1), { TextTransparency = 0, TextStrokeTransparency = 0.5 }):Play()
				end

				local shout = TIER_SHOUT[result.rarity]
				if shout and kind ~= "Refund" then
					revealShout.Text = shout
					revealShout.TextColor3 = prizeColor
					revealShout.TextTransparency = 0
					revealShout.TextStrokeTransparency = 0.2
					revealShoutScale.Scale = 2.6
					TweenService:Create(revealShoutScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
				end

				for index, bar in ipairs(rayBars) do
					bar.Visible = index &lt;= rayCount
					bar.BackgroundColor3 = prizeColor
					bar.BackgroundTransparency = 1
					TweenService:Create(bar, TweenInfo.new(0.5), { BackgroundTransparency = 0.35 }):Play()
				end

				if tierIndex &gt;= 5 then
					shake = Settings.Get("ScreenShake") and 6 + (tierIndex - 5) * 6 or 0
					spawnParticles(particles, (tierIndex - 4) * 30, function()
						return isSecret and Color3.fromHSV(math.random(), 0.7, 1)
							or Rarity.Color(Rarity.Order[math.random(math.max(1, tierIndex - 2), tierIndex)])
					end, false)
				end
				if result.jackpot then
					spawnParticles(particles, 45, function()
						return Color3.fromRGB(255, 206, 64)
					end, true)
				end
			end
			return
		end

		local since = t - popAt

		-- Screen shake that dies away over half a second.
		if shake &gt; 0 then
			shake = math.max(0, shake - dt * 18)
			revealViewport.Position = UDim2.new(0.5, (math.random() - 0.5) * shake * 2, 0.4, (math.random() - 0.5) * shake * 2)
		else
			revealViewport.Position = UDim2.fromScale(0.5, 0.4)
		end

		-- Rays turn slowly; Secret cycles every colour through the rays, name and shout.
		for index = 1, rayCount do
			rayBars[index].Rotation = (index - 1) * (180 / rayCount) + since * (12 + tierIndex * 3)
			if isSecret then
				rayBars[index].BackgroundColor3 = Color3.fromHSV((since * 0.35 + index / rayCount) % 1, 0.55, 1)
			end
		end
		if isSecret then
			local rainbow = Color3.fromHSV((since * 0.5) % 1, 0.6, 1)
			revealName.TextColor3 = rainbow
			revealShout.TextColor3 = rainbow
			revealRarity.TextColor3 = rainbow
		end

		-- The crate OPENS: the lid presses down a moment, gives, and swings up and over on its hinge,
		-- overshooting a little and settling back the way a lid with weight in it does. It used to be
		-- launched into the air on a tumble, which read as the crate coming apart rather than opening
		-- -- and threw away the hinge claude-4a built into every tier's lid.
		local lidNow = CrateOpen.LidCFrame(lidStart, lidHinge, CrateOpen.Angle(since, result.crateId))
		for _, entry in ipairs(lidParts) do
			entry.part.CFrame = lidNow * entry.offset
		end
		-- Then the whole crate, open lid and all, fades away beneath the prize -- starting once this
		-- tier's lid is most of the way up, so a slow Prestige swing isn't fading while it opens.
		local fade = math.clamp((since - lidSwing * 0.75) / 0.5, 0, 1)
		for part in pairs(crateBase) do
			part.Transparency = fade
		end

		-- The prize grows as it rises, then keeps turning. Rarer prizes come out a little bigger.
		local rise = math.clamp(since / 0.55, 0, 1)
		local eased = 1 - (1 - rise) ^ 3
		local finalScale = 1.1 + tierIndex * 0.04
		prize:ScaleTo(math.max(0.05, eased * finalScale))
		local bob = math.sin(since * 2.2) * 0.12 * rise
		prize:PivotTo(CFrame.new(0, 0.8 + eased * 1.2 + bob, 0) * CFrame.Angles(0, since * (1.6 + tierIndex * 0.15), 0))

		if since &gt; closeAfter then
			clearReveal()
		end
	end)
end)
end
-- End of the crate reveal's block; its 35 locals are released here.

--------------------------------------------------------------------------------
-- Trade invite popup
--------------------------------------------------------------------------------

local invitePanel = create("Frame", {
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -16, 1, -200),
	Size = UDim2.new(0, 320, 0, 128),
	BackgroundColor3 = C.Background,
	BorderSizePixel = 0,
	Visible = false,
	Parent = screenGui,
}, { rounded(12), padding(14) })

local inviteLabel = create("TextLabel", {
	Size = UDim2.new(1, 0, 0, 52),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = C.Text,
	TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	TextSize = 15,
	Parent = invitePanel,
})

local inviteRow = create("Frame", {
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 0, 1, 0),
	Size = UDim2.new(1, 0, 0, 38),
	BackgroundTransparency = 1,
	Parent = invitePanel,
}, {
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

local function respond(accept)
	invitePanel.Visible = false
	local ok, success = pcall(function()
		return respondTrade:InvokeServer(accept)
	end)
	if ok and success and accept then
		activeTab = "Trade"
		if not panel.Visible then
			shell:Open()
		end
		renderTab()
	end
end

create("TextButton", {
	Size = UDim2.fromOffset(140, 38),
	BackgroundColor3 = C.Green,
	BorderSizePixel = 0,
	Font = Enum.Font.GothamBold,
	Text = "ACCEPT",
	TextColor3 = Color3.new(0, 0, 0),
	TextSize = 14,
	LayoutOrder = 1,
	Parent = inviteRow,
}, { rounded(8) }).Activated:Connect(function()
	respond(true)
end)

create("TextButton", {
	Size = UDim2.fromOffset(140, 38),
	BackgroundColor3 = C.Panel,
	BorderSizePixel = 0,
	Font = Enum.Font.GothamBold,
	Text = "DECLINE",
	TextColor3 = C.Muted,
	TextSize = 14,
	LayoutOrder = 2,
	Parent = inviteRow,
}, { rounded(8) }).Activated:Connect(function()
	respond(false)
end)

local inviteToken = 0

tradeInvite.OnClientEvent:Connect(function(invite)
	inviteToken += 1
	local token = inviteToken

	invitePanel.Visible = true

	-- A live countdown to the server's 30 s expiry (TradeService INVITE_TIMEOUT): the invite used to
	-- vanish without warning, and both players thought the other had ignored them (#86). Wall-clock
	-- seconds, not os.clock (CPU time in Roblox); a newer invite's token ends this loop.
	task.spawn(function()
		local expiresAt = os.time() + 30
		while token == inviteToken do
			local left = expiresAt - os.time()
			if left &lt;= 0 then
				invitePanel.Visible = false
				return
			end
			inviteLabel.Text = string.format("%s wants to trade brainrots with you.\nExpires in %ds", invite.fromName, left)
			task.wait(1)
		end
	end)
end)

tradeChanged.OnClientEvent:Connect(function(state)
	trade = state or { active = false }
	if trade.active then
		activeTab = "Trade"
		if not panel.Visible then
			shell:Open()
		end
	end
	renderTab()
end)

--------------------------------------------------------------------------------
-- Open / close
--------------------------------------------------------------------------------

-- Compact (Oliver 14:01: "small enough to fit on the screen without taking too much space") and
-- stacked top to bottom (14:06): five 100 x 28 buttons, 4 px apart, y 130-286. The bundle nudge and the
-- quest tracker below were moved down by the same 114 px to make room.
local HUD_BUTTON_W = 104
local HUD_BUTTON_H = 26
local HUD_BUTTON_GAP = 3
-- Oliver 14:16/14:21: snug and neat by size and arrangement, same look as the old MENU button.
local function hudButtonLook()
	return { rounded(8) }
end
local menuButton = create("TextButton", {
	Position = UDim2.new(0, 16, 0, 130),
	Size = UDim2.new(0, HUD_BUTTON_W, 0, HUD_BUTTON_H),
	BackgroundColor3 = C.Accent,
	BorderSizePixel = 0,
	Font = Enum.Font.GothamBold,
	Text = "SHOP",
	TextColor3 = Color3.new(0, 0, 0),
	TextSize = 13,
	Parent = screenGui,
}, hudButtonLook())

-- CombatClient reads this. While the menu is open mid-match the mouse has to be free — first
-- person otherwise keeps it locked to centre, leaving the panel unclickable — and clicks must
-- not fire the gun. Driven off Visible rather than set in toggleMenu, because the trade
-- invite path opens the panel directly and would otherwise be missed.
panel:GetPropertyChangedSignal("Visible"):Connect(function()
	player:SetAttribute("MenuOpen", panel.Visible)
end)

local function toggleMenu()
	shell:Toggle()
	-- IsOpen, not panel.Visible: closing runs a 0.12 s tween and the layer stays visible until it
	-- finishes, so reading Visible here would re-render the tab on the way out.
	if shell:IsOpen() then
		renderTab()
	else
		stopListening()
		settingsNotice = nil
	end
end

-- Declared here, assigned below once openTab exists.
local hudButtonOpen
menuButton.Activated:Connect(function()
	hudButtonOpen(MenuScreens.Screens[1].tabs[1])
end)
-- The other four buttons ride on the SHOP button as children, so every place that shows, hides or
-- stacks menuButton (phone layout, MenuStackToggle) moves all five together.
-- One per MenuScreens screen after the first (SHOP is menuButton itself), labelled and landing where
-- that list says, so a button and the screen it opens cannot disagree.
for index = 1, #MenuScreens.Screens - 1 do
	local screen = MenuScreens.Screens[index + 1]
	local spec = { screen.button, screen.tabs[1] }
	local button = create("TextButton", {
		Position = UDim2.new(0, 0, 0, index * (HUD_BUTTON_H + HUD_BUTTON_GAP)),
		Size = UDim2.new(0, HUD_BUTTON_W, 0, HUD_BUTTON_H),
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = spec[1],
		TextColor3 = Color3.new(0, 0, 0),
		TextSize = 13,
		Parent = menuButton,
	}, hudButtonLook())
	button.Activated:Connect(function()
		hudButtonOpen(spec[2])
	end)
end
shell.onBack = toggleMenu
-- Oliver's #66. `onBack` alone was not enough: the scrim and Backspace read that field at click
-- time, but the header's X captured `options.onClose` at CONSTRUCTION -- line 138, before this
-- function exists -- so it was built with no connection at all. The shell reads both at click time
-- now and falls back to closing itself, so this line is belt and braces rather than the only thing
-- holding the X up. It is here so the X does exactly what the scrim, Backspace and the MENU pill
-- do: stop listening, clear the settings notice, close.
shell.onClose = toggleMenu
-- Backspace / pad B go through toggleMenu too, so a key capture in Settings stops listening and a
-- later key press can't silently rebind an action after the menu closed.
shell:BindBack("BrrMenuBack", function()
	toggleMenu()
	return true
end)

-- A CONTROLLER COULD NOT OPEN THE MENU AT ALL. This has always been a ContextActionService
-- binding, which takes gamepad KeyCodes perfectly well (Settings.lua:243 forwards `extras` into
-- BindAction); it simply passed none, so the action existed on a keyboard and nowhere else. A whole
-- match with no menu, no settings and no quests, and it is not a crash so nothing reported it.
--
-- ButtonSelect (Back/View), not ButtonStart: Roblox very likely reserves Start for its own console
-- menu the way it reserves Escape on a keyboard, and a binding it swallows would LOOK fixed and do
-- nothing -- the exact failure this fix exists to undo. Somebody with a controller can settle it in
-- one press; until then this takes the button nobody reserves.
--
-- `nil` is the touch argument; extras follow it.
Settings.Bind("BRR_Menu", "Menu", function(_, inputState)
	if inputState == Enum.UserInputState.Begin and not listeningFor and os.clock() - lastKeyCaptureAt &gt; 0.25 then
		toggleMenu()
	end
	return Enum.ContextActionResult.Pass
end, nil, Enum.KeyCode.ButtonSelect)

local function labelMenuButton()
	menuButton.Text = "SHOP"
end
labelMenuButton()
Settings.Changed:Connect(labelMenuButton)

-- Opens the menu straight onto one tab; on that tab already, closes it.
local function openTab(key)
	if panel.Visible and activeTab == key then
		toggleMenu()
		return
	end
	stopListening()
	settingsNotice = nil
	activeTab = key
	shell:Open()
	renderTab()
end
-- The header gear: straight to Settings from any screen (the shell's fallback only finds a Settings
-- destination on the SETTINGS screen itself, so on the other four the gear did nothing).
shell.onSettings = function()
	if not (shell:IsOpen() and activeTab == "Settings") then
		openTab("Settings")
	end
end

-- A HUD button: open its group, or close it if that group is what is showing.
hudButtonOpen = function(key)
	if panel.Visible and MenuScreens.ScreenOf(activeTab) == MenuScreens.ScreenOf(key) then
		toggleMenu()
		return
	end
	openTab(key)
end

--------------------------------------------------------------------------------
-- Quest tracker
--------------------------------------------------------------------------------

-- Today's quests and the weekly count, always on screen (lobby and match), under the menu
-- button. Click it, or press the Quests key, for the full tab with the weeklies and rewards.
local TRACKER_WIDTH = 250

local tracker = create("TextButton", {
	Position = UDim2.new(0, 16, 0, 318),
	Size = UDim2.fromOffset(TRACKER_WIDTH, 40),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.25,
	BorderSizePixel = 0,
	AutoButtonColor = false,
	Text = "",
	Visible = false,
	Parent = screenGui,
}, {
	rounded(10),
	create("UIStroke", { Color = C.Panel, Thickness = 1.5 }),
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }),
	create("UIPadding", {
		PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
	}),
})

local trackerRows = {}

local function renderTracker()
	for _, row in ipairs(trackerRows) do
		row:Destroy()
	end
	trackerRows = {}
	local quests = profile and profile.quests
	if not quests or not quests.list or #quests.list == 0 then
		tracker.Visible = false
		return
	end
	tracker.Visible = true

	local function row(order, height)
		local frame = create("Frame", {
			Size = UDim2.new(1, 0, 0, height),
			BackgroundTransparency = 1,
			LayoutOrder = order,
			Parent = tracker,
		})
		table.insert(trackerRows, frame)
		return frame
	end

	local header = row(0, 18)
	create("TextLabel", {
		Size = UDim2.new(1, -60, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = "DAILY QUESTS  [" .. Settings.KeyLabel("Quests") .. "]",
		TextColor3 = C.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 12,
		Parent = header,
	})
	create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(60, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = string.format("%d / %d", quests.doneCount or 0, quests.total or #quests.list),
		TextColor3 = (quests.doneCount or 0) &gt;= (quests.total or #quests.list) and C.Green or C.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = 12,
		Parent = header,
	})

	for index, quest in ipairs(quests.list) do
		local color = QUEST_TIER_COLOR[quest.tier] or C.Text
		local line = row(index, 30)
		create("Frame", {
			Position = UDim2.fromOffset(0, 5),
			Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = line,
		}, { rounded(3) })
		create("TextLabel", {
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -70, 0, 16),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = quest.title,
			TextColor3 = quest.done and C.Muted or C.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextSize = 12,
			Parent = line,
		})
		create("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(56, 16),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = quest.done and "DONE" or string.format("%s/%s", formatNumber(quest.progress), formatNumber(quest.target)),
			TextColor3 = quest.done and C.Green or C.Muted,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextSize = 11,
			Parent = line,
		})
		local track = create("Frame", {
			Position = UDim2.fromOffset(12, 20),
			Size = UDim2.new(1, -12, 0, 5),
			BackgroundColor3 = C.PanelAlt,
			BorderSizePixel = 0,
			Parent = line,
		}, { rounded(3) })
		create("Frame", {
			Size = UDim2.fromScale(math.clamp((quest.progress or 0) / math.max(1, quest.target or 1), 0, 1), 1),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = track,
		}, { rounded(3) })
	end

	-- The weeklies in one line: how many are done, and a nudge to open the tab for the rest.
	local weekly = quests.weekly or {}
	if #weekly &gt; 0 then
		local done = 0
		for _, quest in ipairs(weekly) do
			if quest.done then
				done += 1
			end
		end
		local line = row(#quests.list + 1, 16)
		create("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = string.format("WEEKLY CHALLENGES  %d / %d  •  %s left", done, #weekly, QuestData.FormatReset(quests.weekResetIn or 0)),
			TextColor3 = QUEST_TIER_COLOR.weekly,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextSize = 11,
			Parent = line,
		})
	end
end

tracker.Activated:Connect(function()
	Sfx.Play("UiClick", 0.08)
	openTab("Quests")
end)

-- DPadLeft, and the walk to it is worth recording. DPadUp is the camera toggle
-- (CombatClient:840), DPadRight is the inventory (HudClient:1659) and DPadDown is the movement item
-- (MovementClient:984) -- so the d-pad is already three-quarters spoken for, and Left is the only
-- face of it free. ButtonL1 looked free and is the vehicle's (VehicleClient:327): a weapon control
-- that also drives is a collision built on purpose.
Settings.Bind("BRR_Quests", "Quests", function(_, inputState)
	if inputState == Enum.UserInputState.Begin and not listeningFor and os.clock() - lastKeyCaptureAt &gt; 0.25 then
		openTab("Quests")
	end
	return Enum.ContextActionResult.Pass
end, nil, Enum.KeyCode.DPadLeft)
Settings.Changed:Connect(renderTracker)

-- The lobby's booths (Trading Hall, Cosmetics, Codex) open straight onto their tab.
Remotes.Event("OpenMenuTab").OnClientEvent:Connect(function(tab)
	if type(tab) == "string" then
		for _, entry in ipairs(TABS) do
			if entry.key == tab then
				if tab == "Brainrots" then
					codexMode = true
				end
				-- Walking back through the booth while reading that tab must not close it (openTab toggles).
				if not (shell:IsOpen() and activeTab == tab) then
					openTab(tab)
				end
				return
			end
		end
	end
end)

-- The tracker is in the way of nothing while the menu is closed, and out of the way while it's open.
panel:GetPropertyChangedSignal("Visible"):Connect(function()
	tracker.Visible = not panel.Visible and profile ~= nil and profile.quests ~= nil and profile.quests.list ~= nil and #profile.quests.list &gt; 0
end)

-- A pulsing shortcut under the menu button to the best deal still open to you: the Starter Bundle
-- until it's been bought, then the Pro Bundle. Only for products whose ID is set (or in Studio).
local bundleNudge = create("TextButton", {
	Position = UDim2.new(0, 16, 0, 278),
	Size = UDim2.new(0, 210, 0, 34),
	BackgroundColor3 = C.Green,
	BorderSizePixel = 0,
	Font = Enum.Font.GothamBlack,
	Text = "",
	TextColor3 = Color3.new(0, 0, 0),
	TextSize = 14,
	Visible = false,
	Parent = screenGui,
}, { rounded(10) })

local nudgeStroke = create("UIStroke", {
	Color = Color3.new(1, 1, 1),
	Thickness = 2,
	Transparency = 0.1,
	ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	Parent = bundleNudge,
})
TweenService:Create(nudgeStroke, LOOP_PULSE, { Transparency = 0.9 }):Play()

local function refreshBundleNudge()
	local pick = nil
	for _, key in ipairs({ "StarterBundle", "ProBundle" }) do
		local product = GamepassConfig.Products[key]
		if product and shopVisible(product) and not bundleSoldOut(product) then
			pick = product
			break
		end
	end
	bundleNudge.Visible = pick ~= nil and profile ~= nil
	if pick then
		bundleNudge.Text = string.format("%s  •  %d R$", string.upper(pick.name), pick.suggestedPrice)
		bundleNudge.BackgroundColor3 = pick.color or C.Accent
	end
end

bundleNudge.Activated:Connect(function()
	Sfx.Play("UiClick", 0.08)
	activeTab = "Robux"
	shell:Open()
	renderTab()
end)

-- The left stack (MENU, the bundle nudge, the quest tracker) tucks away behind a tab beside MENU and
-- slides back out (StarterPlayerScripts/MenuStackToggle; saved as the MenuStackCollapsed setting).
-- Tucked away, the tab shows today's quest count and lights up when something new comes in: a quest
-- or weekly challenge done, the daily spin ready, a pass reward to claim, a bundle delivered. M and J
-- work either way. In a do-block: this script's main chunk is close to Luau's 200-local limit.
do
	-- Under pcall: if the module ever fails to load, the stack simply stays as it's built above, rather
	-- than the error stopping the rest of this script (the menu itself, the tracker, trading...).
	local okToggle, stackToggle = pcall(function()
		local MenuStackToggle = require(script.Parent:WaitForChild("MenuStackToggle"))
		return MenuStackToggle.new(screenGui, { items = { menuButton, bundleNudge, tracker }, settings = Settings })
	end)
	if not okToggle then
		warn("[MenuClient] MenuStackToggle didn't load; the menu stack stays as it is: " .. tostring(stackToggle))
		stackToggle = { SetSummary = function() end, Attention = function() end, SetHidden = function() end }
	end

	-- The left stack goes away while the panel is open, and comes back when it closes. Oliver's
	-- screenshot on 2026-09-21 has the stack tab's chevron drawn on top of the first rail tile: the
	-- stack is at a fixed screen position, the panel is centred, and on a window narrower than the
	-- two together they occupy the same pixels. Driven off `panel.Visible` rather than from
	-- toggleMenu, because the trade-invite path and openTab open the panel directly and would
	-- otherwise be missed -- the same reason the MenuOpen attribute is driven off it.
	local function followMenu()
		if stackToggle.SetHidden then
			stackToggle:SetHidden(panel.Visible)
		end
	end
	followMenu()
	panel:GetPropertyChangedSignal("Visible"):Connect(followMenu)

	local seen = nil
	local function watch(state)
		if type(state) ~= "table" then
			return
		end
		local quests = type(state.quests) == "table" and state.quests or {}
		local weekly = 0
		for _, quest in ipairs(quests.weekly or {}) do
			if quest.done then
				weekly += 1
			end
		end
		local rewards = 0
		local pass = state.pass
		if type(pass) == "table" and pass.claimedFree then
			for tier = 1, math.min(pass.tier or 0, BattlePassData.MaxTier) do
				if not pass.claimedFree[tostring(tier)] then
					rewards += 1
				end
				if pass.premium and pass.claimedPremium and not pass.claimedPremium[tostring(tier)] then
					rewards += 1
				end
			end
		end
		local now = {
			done = quests.doneCount or 0,
			weekly = weekly,
			spin = state.daily ~= nil and state.daily.available == true,
			rewards = rewards,
		}
		local total = quests.total or (quests.list and #quests.list) or 0
		stackToggle:SetSummary(total &gt; 0 and string.format("%d/%d", now.done, total) or "")
		if seen and (now.done &gt; seen.done or now.weekly &gt; seen.weekly or (now.spin and not seen.spin) or now.rewards &gt; seen.rewards) then
			stackToggle:Attention()
		end
		seen = now
	end
	profileChanged.OnClientEvent:Connect(watch)
	bundleGranted.OnClientEvent:Connect(function()
		stackToggle:Attention()
	end)
	task.spawn(function()
		local ok, result = pcall(function()
			return requestProfile:InvokeServer()
		end)
		if ok and seen == nil then
			watch(result)
		end
	end)

	-- Phones and small tablets: the wide MENU pill and the coin chip are two of the biggest things on a
	-- 390-tall screen. MENU becomes an icon in the top-right corner (PhoneLayout's slot, beside the
	-- stack tab), the stack itself hangs under that tab, and the coin chip shrinks and steps aside
	-- during a match, where the minimap wants that corner and coins can wait for the lobby.
	local okPhone, phoneErr = pcall(function()
		local PhoneLayout = require(script.Parent:WaitForChild("PhoneLayout"))
		local camera = workspace.CurrentCamera
		local icon = create("TextButton", {
			Name = "PhoneMenu",
			Size = UDim2.fromOffset(44, 44),
			BackgroundColor3 = C.Accent,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			Visible = false,
			Parent = screenGui,
		}, { rounded(10) })
		for row = 1, 3 do
			create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0, 8 + row * 7),
				Size = UDim2.fromOffset(20, 3),
				BackgroundColor3 = Color3.fromRGB(20, 16, 6),
				BorderSizePixel = 0,
				Parent = icon,
			}, { rounded(2) })
		end
		icon.Activated:Connect(toggleMenu)

		local coinScale = create("UIScale", { Parent = coinChip })
		local coinHome = coinChip.Position
		local function apply()
			local viewport = camera.ViewportSize
			local spots = PhoneLayout.Active(viewport) and PhoneLayout.Rects(viewport) or nil
			icon.Visible = spots ~= nil
			menuButton.Visible = spots == nil
			if spots then
				local inset = spots.inset or 0
				icon.Position = UDim2.fromOffset(spots.menu.x, spots.menu.y - inset)
				icon.Size = UDim2.fromOffset(spots.menu.w, spots.menu.h)
				-- The coin chip stays on a phone, in a match as well as in the lobby: the owner asked for
				-- it kept and shrunk, not hidden. 210 wide down to the slot's 120 is about 0.57, which
				-- leaves its number at 12 or 13 pixels -- small, still readable.
				coinScale.Scale = spots.coins.w / 210
				coinChip.Position = UDim2.fromOffset(spots.coins.x, spots.coins.y - inset)
				coinChip.Visible = true
			else
				coinScale.Scale = 1
				coinChip.Position = coinHome
				coinChip.Visible = true
			end
			if stackToggle.SetPhone then
				stackToggle:SetPhone(spots, spots and spots.inset or 0)
			end
		end
		apply()
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
		UserInputService:GetPropertyChangedSignal("KeyboardEnabled"):Connect(apply)
		PhoneLayout.ReapplyMenu = apply
	end)
	if not okPhone then
		warn("[MenuClient] the phone layout didn't load; the menu stack keeps its desktop sizes: " .. tostring(phoneErr))
	end
end

--------------------------------------------------------------------------------
-- Bundle unlocked
--------------------------------------------------------------------------------

-- A card that pops in and deals out everything a bundle just gave you, one line at a time.
local bundleOverlay = create("TextButton", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.35,
	AutoButtonColor = false,
	Text = "",
	Visible = false,
	ZIndex = 60,
	Parent = screenGui,
})

local bundleCard = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(460, 430),
	BackgroundColor3 = C.Background,
	BorderSizePixel = 0,
	ZIndex = 61,
	Parent = bundleOverlay,
}, { rounded(16) })
local bundleStroke = create("UIStroke", { Thickness = 3, Parent = bundleCard })
local bundleScale = create("UIScale", { Scale = 1, Parent = bundleCard })

local bundleTitle = create("TextLabel", {
	Position = UDim2.fromOffset(20, 18),
	Size = UDim2.new(1, -40, 0, 40),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "",
	TextColor3 = C.Text,
	TextSize = 32,
	ZIndex = 62,
	Parent = bundleCard,
})

create("TextLabel", {
	Position = UDim2.fromOffset(20, 58),
	Size = UDim2.new(1, -40, 0, 20),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "UNLOCKED! Everything is already in your inventory.",
	TextColor3 = C.Muted,
	TextSize = 14,
	ZIndex = 62,
	Parent = bundleCard,
})

local bundleList = create("Frame", {
	Position = UDim2.fromOffset(20, 92),
	Size = UDim2.new(1, -40, 1, -136),
	BackgroundTransparency = 1,
	ZIndex = 62,
	Parent = bundleCard,
}, {
	create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
})

create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -12),
	Size = UDim2.new(1, -40, 0, 20),
	BackgroundTransparency = 1,
	Font = Enum.Font.Gotham,
	Text = "Click anywhere to close",
	TextColor3 = C.Muted,
	TextSize = 13,
	ZIndex = 62,
	Parent = bundleCard,
})

local bundleToken = 0

local function closeBundle()
	bundleToken += 1
	bundleOverlay.Visible = false
end
bundleOverlay.Activated:Connect(closeBundle)

bundleGranted.OnClientEvent:Connect(function(productKey, refunded)
	local product = GamepassConfig.Products[productKey]
	if not product then
		return
	end
	bundleToken += 1
	local token = bundleToken
	local color = product.color or C.Accent

	bundleTitle.Text = string.upper(product.name)
	bundleTitle.TextColor3 = color
	bundleStroke.Color = color
	clearItems(bundleList)

	local lines = GamepassConfig.DescribeContents(product.grant, cosmeticLabel)
	if refunded and refunded &gt; 0 then
		table.insert(lines, formatNumber(refunded) .. " SahurCoins for exclusives you already had")
	end

	bundleOverlay.Visible = true
	bundleScale.Scale = 0.6
	TweenService:Create(bundleScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	Sfx.Play("CrateOpen")

	for index, text in ipairs(lines) do
		task.delay(0.3 + index * 0.18, function()
			if token ~= bundleToken then
				return
			end
			local row = create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = C.Panel,
				BorderSizePixel = 0,
				Font = Enum.Font.GothamBold,
				Text = "   +  " .. text,
				TextColor3 = index == #lines and refunded and refunded &gt; 0 and C.Accent or C.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTransparency = 1,
				TextSize = 15,
				LayoutOrder = index,
				ZIndex = 63,
				Parent = bundleList,
			}, { rounded(6) })
			TweenService:Create(row, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
			Sfx.Play("UiClick", nil, 0.9 + index * 0.08)
		end)
	end

	task.delay(12, function()
		if token == bundleToken then
			closeBundle()
		end
	end)
end)

--------------------------------------------------------------------------------
-- Wiring
--------------------------------------------------------------------------------

local function applyProfile(newProfile)
	profile = newProfile
	if not profile then
		return
	end
	coinLabel.Text = formatNumber(profile.coins)
	questResetAt = os.clock() + (profile.quests and profile.quests.resetIn or 0)
	refreshBundleNudge()
	renderTracker()
	renderTab()
end

profileChanged.OnClientEvent:Connect(applyProfile)

task.spawn(function()
	local ok, result = pcall(function()
		return requestProfile:InvokeServer()
	end)
	if ok and result then
		applyProfile(result)
	end
end)

-- Keep the restock countdown ticking, and redraw the shop tabs the moment the stock changes.
task.spawn(function()
	local lastWindow = ShopRotation.Window()
	while true do
		task.wait(0.5)
		if stockTimerLabel and stockTimerLabel.Parent then
			stockTimerLabel.Text = (stockTimerLabel:GetAttribute("Prefix") or "") .. "  •  new stock in " .. ShopRotation.FormatTimeLeft()
		end
		if questTimerLabel and questTimerLabel.Parent then
			questTimerLabel.Text = "DAILY QUESTS  •  new quests in " .. QuestData.FormatReset(questResetAt - os.clock())
		end
		-- Once the day rolls over the server has a fresh set; fetch it rather than showing 0:00.
		if questResetAt &gt; 0 and os.clock() &gt; questResetAt + 2 then
			questResetAt = 0
			task.spawn(function()
				local ok, result = pcall(function()
					return requestProfile:InvokeServer()
				end)
				if ok and result then
					applyProfile(result)
				end
			end)
		end
		local window = ShopRotation.Window()
		if window ~= lastWindow then
			lastWindow = window
			if panel.Visible and (activeTab == "Crates" or activeTab == "Cosmetics" or activeTab == "KillAnimations") then
				renderTab()
			end
		end
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX169"><Properties><string name="Name">MenuCursor</string><ProtectedString name="Source">-- MenuOpen is shared by the inventory and main menu. A one-time MouseBehavior write loses to
-- Roblox's camera on the next frame, even in Classic mode when the camera is still zoomed into
-- first person. Keep a modal GUI alive for the whole menu lifetime and reassert the cursor after
-- the camera has updated.
--
-- SOLE OWNER OF MouseIconEnabled (Oliver's #112, "can still see my cursor in FPS"). CombatClient
-- owns MouseBehavior -- LockCenter for FPS combat, Default otherwise -- and never touches the
-- icon; nothing else in the project ever did either, so the icon sat on whatever this script last
-- wrote, forever. The old code SNAPSHOTTED MouseIconEnabled on open and RESTORED that snapshot on
-- close. That is wrong on its face: nothing upstream of the snapshot ever set the property false,
-- so the snapshot's reachable value was always true, and "restore" meant "set it back to true" on
-- every close, in FPS or not. This derives the icon LIVE from the mouse lock instead, so it is
-- correct after every exit path (death, respawn, a vehicle, spectating, a settings change) with no
-- path to enumerate: whatever CombatClient currently has MouseBehavior set to IS the answer, read
-- back rather than guessed.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local gui = Instance.new("ScreenGui")
gui.Name = "BrrMenuCursor"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = -100
gui.Parent = playerGui

-- A visible but transparent one-pixel modal flag. It occupies no menu hit area
-- and never enters gamepad navigation. Existing buttons keep receiving clicks.
local modal = Instance.new("TextButton")
modal.Name = "CursorRelease"
modal.Size = UDim2.fromOffset(1, 1)
modal.BackgroundTransparency = 1
modal.Text = ""
modal.AutoButtonColor = false
modal.Selectable = false
modal.Active = false
modal.Modal = true
modal.Visible = false
modal.Parent = gui

local open = false

-- The invariant this whole script exists to hold: the icon is wanted whenever a menu has the
-- mouse (so it can be seen and clicked with), and otherwise wanted exactly when the mouse ISN'T
-- locked to the crosshair. Locked with no menu open is FPS combat -- the one place a visible OS
-- cursor is a bug, not a convenience.
-- One more case: a vehicle gun's aim mark IS the cursor while its gunner aims with a free mouse
-- (VehicleWeaponClient sets the local `AimCursor` attribute), and the OS arrow on top of it is a
-- second cursor. That script asks through the attribute rather than writing the icon itself, so this
-- stays the only writer and every path above still ends in one answer.
local function desiredIcon()
	if open then
		return true
	end
	return UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter and player:GetAttribute("AimCursor") ~= true
end

local function reconcileIcon()
	UserInputService.MouseIconEnabled = desiredIcon()
end

local function releaseCursor()
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	reconcileIcon()
end

local function sync()
	local wanted = player:GetAttribute("MenuOpen") == true
	if wanted == open then return end
	open = wanted
	modal.Visible = wanted
	if wanted then
		releaseCursor()
		RunService:BindToRenderStep("BRR_MenuCursor", Enum.RenderPriority.Last.Value, releaseCursor)
	else
		RunService:UnbindFromRenderStep("BRR_MenuCursor")
		-- CombatClient's own MenuOpen listener restores MouseBehavior to whatever the current mode
		-- wants; reconcileIcon reads that back live. If this runs before CombatClient's listener
		-- does (connection order between two LocalScripts is not guaranteed), the MouseBehavior
		-- property-changed listener below catches the correction the moment CombatClient writes it,
		-- so the result is right either way, not just on the order this script happens to see first.
		reconcileIcon()
	end
end

player:GetAttributeChangedSignal("MenuOpen"):Connect(sync)
-- The lock can also change with no menu involved at all: entering or leaving FPS combat, a
-- vehicle, death. The icon has to follow every one of those, not only a menu's open/close.
UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(function()
	if not open then
		reconcileIcon()
	end
end)
player:GetAttributeChangedSignal("AimCursor"):Connect(function()
	if not open then
		reconcileIcon()
	end
end)
sync()
reconcileIcon()

script.Destroying:Connect(function()
	RunService:UnbindFromRenderStep("BRR_MenuCursor")
	gui:Destroy()
end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX170"><Properties><string name="Name">MenuOpenClaims</string><ProtectedString name="Source">-- Who is holding the mouse free: the `MenuOpen` player attribute, owner-counted.
--
-- THE ATTRIBUTE IS ONE BOOLEAN WITH FOUR WRITERS, and a boolean cannot say "two things want this".
-- MenuCursor reads it and frees or re-locks the cursor; CombatClient reads it at five sites so a
-- click on a panel does not also fire the gun. Both of the ways that goes wrong are things Oliver
-- has reported, and both are a second writer clearing what a first writer still needs:
--
--   STUCK LOCKED. The menu is open (MenuClient set the attribute from its panel's `Visible`
--   change), something else opens and closes over the top of it and clears the attribute on the way
--   out. MenuClient never writes again — its handler only fires on a CHANGE of `Visible`, and the
--   panel never changed — so the menu is left on screen with the mouse locked to the middle of it.
--
--   STUCK FREE, AND CLICKS FIRE THE GUN. Something is holding the attribute, the player opens and
--   closes the menu, and the menu's close clears it. The holder thinks it still has it, so it never
--   re-asserts; the cursor comes unstuck from the panel it belongs to and the next click on that
--   panel goes through to the weapon.
--
-- So: claims, not writes. `Claim` hands back a release function, the attribute is true while any
-- claim is outstanding, and the last release clears it only if nobody unmigrated is still holding
-- it. Any writer that clears the attribute while claims are outstanding is corrected at once.
--
-- MIGRATION. HudClient's inventory, MenuClient's panel and the drop picker each write the attribute
-- directly today; the picker uses this module and the other two are one line each when their owners
-- take them. Until then `LegacyHolder` below is what keeps this module from clearing the attribute
-- out from under them, and the re-assert is what keeps them from clearing it out from under this.
-- When the last one migrates, delete `LegacyHolder` and the special case goes with it.

local Players = game:GetService("Players")

local MenuOpenClaims = {}

local ATTRIBUTE = "MenuOpen"

-- [token] = name. A strong table: these are claims, not a cache, and this project has lost live
-- entries out of weak ones before.
local claims = {}
local count = 0

-- True while this module is the one writing, so its own write does not come back through the
-- changed signal and re-enter the re-assert below.
local writing = false

local subject = nil
local connection = nil

-- Declared HERE, above the first reader, not next to Claim. Every public entry point binds through
-- it, because this module used to bind only on the first Claim() — so a caller that merely ASKED who
-- was holding the cursor, before anything had claimed, was answered from `subject == nil`: "nobody",
-- with no claim table and no PlayerGui to look at. The vote screen is exactly that caller, and it
-- would have read a wide-open main menu as an empty lobby and drawn straight over it.
-- Binding on a read is safe: `if subject then return end` means it only ever fires when nothing is
-- bound, and when nothing is bound there are no claims for Bind's table-clear to lose.
-- AND IT NEVER CALLS Bind(nil). `Bind` clears the claim table and zeroes the count, so binding to
-- nothing is DESTRUCTIVE: with no LocalPlayer — a server-side runtest, a gallery, a probe that has
-- not bound yet — every call would wipe claims that `Claim` had already booked (Claim can book one
-- while unbound: `apply` returns early, but the entry is on the books). A read would then silently
-- release screens it was only being asked about. With no subject the honest answer is "nobody is
-- holding it", which is what the readers below return without touching anything.
local function ensureBound()
	if subject then
		return
	end
	local player = Players.LocalPlayer
	if not player then
		return
	end
	MenuOpenClaims.Bind(player)
end

-- Whether an UNMIGRATED writer is holding the attribute right now, and WHICH ONE. The menu's own big
-- panel is the first: MenuClient sets the attribute from that panel's visibility and never writes
-- again until it changes, so clearing the attribute while it is up strands the cursor.
--
-- This is the same test HudClient's inventory already makes for the same reason (HudClient around
-- line 1548), deliberately rather than by coincidence: two different answers to "is the menu up"
-- would be a third bug of this exact shape. Replaced wholesale by a test.
--
-- IT RETURNS THE DETECTOR'S NAME AS A SECOND VALUE, and `Detectors` below says how many there are,
-- because a filter is a claim about what it matched: "no legacy holder" has to be distinguishable
-- from "nothing was looked at". `apply()` pcalls this and reads the first value only, so the second
-- costs it nothing.
--
-- KEYED ON GUI NAMES, WHICH IS A LISTED BUG PATTERN IN THIS PROJECT, and accepted here for exactly as
-- long as the migration lasts. Each detector is one line; when its owner takes the attribute through
-- Claim(), delete the line. When the list is empty, delete the function.
local LEGACY_DETECTORS = {
	-- MenuClient.client.lua:3373 — SetAttribute driven off the big panel's Visible.
	{
		name = "MenuClient/BrrMenu",
		held = function(playerGui)
			local menuGui = playerGui:FindFirstChild("BrrMenu")
			for _, child in ipairs(menuGui and menuGui:GetChildren() or {}) do
				if child:IsA("Frame") and child.Visible and child.AbsoluteSize.X &gt; 500 then
					return true
				end
			end
			return false
		end,
	},
}

-- How many unmigrated writers this module knows how to see. Printed by the probes next to what they
-- found, so a green "nobody else is holding it" can never be a measurement of nothing.
MenuOpenClaims.Detectors = #LEGACY_DETECTORS

function MenuOpenClaims.LegacyHolder()
	ensureBound()
	local player = subject
	if not player or not player.FindFirstChild then
		return false
	end
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then
		return false
	end
	for _, detector in ipairs(LEGACY_DETECTORS) do
		-- pcall per detector: one gui shape this does not expect must not blind the others.
		local ok, held = pcall(detector.held, playerGui)
		if ok and held == true then
			return true, detector.name
		end
	end
	return false
end

-- Is anybody OTHER THAN `name` holding the cursor right now?
--
-- ANSWERED FROM THE HOLDER SET, NEVER FROM `Count()` MINUS ONE. A count is a snapshot, and a
-- count-based test fails in the direction that LOCKS THE MOUSE: a screen that claims twice, or that
-- misses a release on one of its exit paths, would read as "somebody else is holding" forever, with
-- nothing in the log and no probe able to see it. Excluding by name is idempotent — our own claim can
-- be outstanding once, twice, or leaked, and the answer does not change.
function MenuOpenClaims.HeldByOthers(name)
	for _, held in pairs(claims) do
		if held ~= name then
			return true
		end
	end
	local ok, legacy = pcall(MenuOpenClaims.LegacyHolder)
	return ok and legacy == true
end

local function apply()
	if not subject then
		return
	end
	local wanted = count &gt; 0
	if not wanted then
		-- Only the LAST release consults this: while anything is claimed the answer is true anyway.
		local ok, held = pcall(MenuOpenClaims.LegacyHolder)
		wanted = ok and held == true
	end
	writing = true
	subject:SetAttribute(ATTRIBUTE, wanted)
	writing = false
end

-- The thing the attribute lives on. `Players.LocalPlayer` in the game; a probe or a gallery binds
-- any Instance instead — a Folder has real attributes and a real `GetAttributeChangedSignal`, so
-- the tests drive the genuine article rather than a mock of it. Neither a runtest nor a gallery has
-- a LocalPlayer, and a helper that cannot be exercised is a helper nobody has tested.
function MenuOpenClaims.Bind(instance)
	if connection then
		connection:Disconnect()
		connection = nil
	end
	subject = instance
	table.clear(claims)
	count = 0
	if not subject then
		return
	end
	-- THE RE-ASSERT. Somebody else clearing the attribute while a claim is outstanding is the
	-- "stuck free, clicks fire the gun" bug; it is put back the moment it happens.
	connection = subject:GetAttributeChangedSignal(ATTRIBUTE):Connect(function()
		if writing or count == 0 then
			return
		end
		if subject:GetAttribute(ATTRIBUTE) ~= true then
			apply()
		end
	end)
	apply()
end

-- Claims the cursor for `name` and returns the release. Releasing twice is the same as releasing
-- once: a screen that closes on both a button and a key would otherwise drop the count below zero
-- and leave the next claimant unable to hold it at all.
function MenuOpenClaims.Claim(name)
	ensureBound()
	local token = {}
	claims[token] = name or "unnamed"
	count += 1
	apply()

	local released = false
	return function()
		if released then
			return
		end
		released = true
		-- A release whose claim is not on the books any more does NOTHING. `Bind` clears the table
		-- and zeroes the count, so a closure handed out before a re-bind is a claim on a subject
		-- that no longer exists; letting it decrement would take a claim off the NEW binding that
		-- was never added to it. The count would go negative, `wanted = count &gt; 0` would be false
		-- for the rest of the session, and the cursor would simply stop being freed — silently,
		-- with nothing in the log. Production only re-binds through `ensureBound` and so cannot
		-- reach this today; the probe binds twice, and one refactor would be enough.
		if claims[token] == nil then
			return
		end
		claims[token] = nil
		-- Floored as well as guarded. Belt and braces on the one value whose going negative is
		-- invisible and permanent.
		count = math.max(0, count - 1)
		apply()
	end
end

-- How many claims are outstanding, and who holds them. For probes and for anyone debugging a
-- cursor that will not come back: the names are the answer to "what is holding this".
function MenuOpenClaims.Count()
	ensureBound()
	return count
end

function MenuOpenClaims.Holders()
	ensureBound()
	local names = {}
	for _, name in pairs(claims) do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

return MenuOpenClaims
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX171"><Properties><string name="Name">MenuScreens</string><ProtectedString name="Source">-- The menu's screens (#78): which HUD button opens which tabs, how each tab looks in its screen's
-- navigation, and the two pieces more than one tab needs -- a preview beside a listed item and the
-- Death Effects tab (#24; tab key "KillAnimations", after the kind's first name).
--
-- Oliver, 2026-09-22 13:59: "no single menu -- separate buttons, each its own page". MenuClient used
-- to carry this as two loose tables (TAB_GROUP, DESTINATION_LOOK) that had already drifted apart once
-- (`Style` had a group and no look, so it drew in the rail with an empty icon). Here one list says
-- everything about a screen, so a tab cannot be in a screen without a look, or in two screens, and
-- tools/menu_screens_check.py holds the list to that.
--
-- A ModuleScript rather than more of MenuClient because that file's main chunk sits at Luau's
-- 200-local ceiling, and because a LocalScript cannot be required by a probe or a harness.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CosmeticData = require(Shared:WaitForChild("CosmeticData"))
local ShopRotation = require(Shared:WaitForChild("ShopRotation"))
local Rarity = require(Shared:WaitForChild("Rarity"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local create, rounded = UiKit.create, UiKit.rounded
local C = UiKit.Colors

local MenuScreens = {}

-- One entry per HUD button, in the order the buttons stack. `tabs` is the order of the screen's own
-- navigation; the first is where the button lands. A screen with one tab draws no navigation at all
-- (MenuShell gives the content the whole panel), which is what makes ROBUX and SETTINGS whole pages
-- rather than a page with a one-item rail beside it.
--
-- The tall (portrait phone) bar fits five cells a row at a 44 px touch target on the narrowest panel,
-- so a screen with more than five tabs costs a second row of bar there. PROGRESS has six; the harness
-- prints what that costs at every size rather than this comment guessing.
MenuScreens.Screens = {
	{ key = "Shop", button = "SHOP", title = "SHOP", tabs = { "Crates", "Style", "Cosmetics", "KillAnimations" } },
	{ key = "Brainrots", button = "BRAINROTS", title = "BRAINROTS", tabs = { "Brainrots", "Trade" } },
	{ key = "Progress", button = "PROGRESS", title = "PROGRESS", tabs = { "Pass", "Rank", "Mastery", "Index", "CellShop", "Quests" } },
	{ key = "Robux", button = "ROBUX", title = "ROBUX SHOP", tabs = { "Robux" } },
	{ key = "Settings", button = "SETTINGS", title = "SETTINGS", tabs = { "Settings" } },
}

-- How each tab draws in its screen's navigation. Glyphs are ones already drawn by the rail in the
-- built place: U+2715 came out as a tofu box in a render, so a new glyph is a render risk and the
-- death effects tab borrows a star rather than bringing in a skull nobody has seen render.
MenuScreens.Look = {
	Brainrots = { glyph = "★", sub = "Your collection" },
	Trade = { glyph = "⇄", sub = "Swap with players" },
	Crates = { glyph = "▣", sub = "Open and buy" },
	Style = { glyph = "✦", sub = "Cosmetic crates" },
	Cosmetics = { glyph = "◆", sub = "Skins and auras" },
	KillAnimations = { glyph = "★", sub = "On your eliminations" },
	Pass = { glyph = "▲", sub = "Brainrot Pass" },
	Rank = { glyph = "★", sub = "Rot Rank" },
	Mastery = { glyph = "◎", sub = "Gun mastery" },
	Index = { glyph = "▦", sub = "Every brainrot" },
	CellShop = { glyph = "✚", sub = "Spend Brain Cells" },
	Quests = { glyph = "✓", sub = "Daily and weekly" },
	Robux = { glyph = "$", sub = "Robux" },
	Settings = { glyph = "⚙", sub = "Keys and audio" },
}

local screenOf = {}
for _, screen in ipairs(MenuScreens.Screens) do
	for _, key in ipairs(screen.tabs) do
		screenOf[key] = screen
	end
end

-- The screen a tab belongs to. nil for a key no screen lists.
function MenuScreens.ScreenOf(tabKey)
	return screenOf[tabKey]
end

-- The shell's destination list for the screen `tabKey` is on. `labelOf(key)` is the host's own tab
-- label, so the words stay where the renderers are.
-- `otherScreens`: also list every other screen, by its button name, landing on its first tab. A
-- phone hides the HUD's five screen buttons (the menu opens from one icon), so without these a phone
-- player could never leave the screen the menu opened on.
function MenuScreens.Destinations(tabKey, labelOf, otherScreens)
	local screen = screenOf[tabKey]
	local destinations = {}
	if not screen then
		return destinations, nil
	end
	for _, key in ipairs(screen.tabs) do
		local look = MenuScreens.Look[key] or {}
		table.insert(destinations, { key = key, label = string.upper(labelOf(key) or key), glyph = look.glyph, sub = look.sub })
	end
	if otherScreens then
		for _, other in ipairs(MenuScreens.Screens) do
			if other ~= screen then
				local look = MenuScreens.Look[other.tabs[1]] or {}
				table.insert(destinations, { key = other.tabs[1], label = other.button, glyph = look.glyph, sub = other.title })
			end
		end
	end
	return destinations, screen
end

-- Everything wrong between the screens and a host's tab list, as strings: a tab with no screen, a
-- screen tab with no renderer, a tab in two screens, a tab with no look. Empty when right.
function MenuScreens.Problems(tabs)
	local problems, rendered, seen = {}, {}, {}
	for _, tab in ipairs(tabs) do
		rendered[tab.key] = true
		if not screenOf[tab.key] then
			table.insert(problems, "tab " .. tab.key .. " is on no screen")
		end
	end
	for _, screen in ipairs(MenuScreens.Screens) do
		for _, key in ipairs(screen.tabs) do
			if seen[key] then
				table.insert(problems, "tab " .. key .. " is on two screens")
			end
			seen[key] = true
			if not rendered[key] then
				table.insert(problems, "screen " .. screen.key .. " lists " .. key .. ", which has no renderer")
			end
			if not (MenuScreens.Look[key] and MenuScreens.Look[key].glyph) then
				table.insert(problems, "tab " .. key .. " has no look")
			end
		end
	end
	return problems
end

-- Whether `id` is what the player has on in any slot. Read across every slot rather than a list of
-- named ones, so a new kind (kill animations get a slot of their own) is right the day its slot
-- exists, and not after somebody remembers this line.
function MenuScreens.Equipped(cosmetics, id)
	if not cosmetics then
		return false
	end
	for key, value in pairs(cosmetics) do
		if key ~= "owned" and value == id then
			return true
		end
	end
	return false
end

--------------------------------------------------------------------------------
-- Previews
--------------------------------------------------------------------------------

local loadedPreview, CosmeticPreview = pcall(require, Shared:WaitForChild("CosmeticPreview"))
if not loadedPreview then
	warn("[MenuScreens] cosmetic previews are off: " .. tostring(CosmeticPreview))
	CosmeticPreview = nil
end

-- Whether CosmeticPreview can build `id`, asked once per id. Asked of the builder rather than of a
-- list of kinds, so when kill animations get a model the swatch below gives way to it unprompted.
local buildable = {}
local function canPreview(id)
	if not CosmeticPreview then
		return false
	end
	if buildable[id] == nil then
		local ok, model = pcall(CosmeticPreview.Model, id)
		buildable[id] = ok and model ~= nil
		if ok and model then
			model:Destroy()
		end
	end
	return buildable[id]
end
MenuScreens.CanPreview = canPreview

-- Where a row's preview goes, for both of makeRow's shapes:
--
--   wide (64 tall)      right of the text, left of a one- or two-button strip: the spot the
--                       parachute previews have always used, 118 px in from the right
--   stacked (112 tall)  bottom left, under the subtitle and level with the buttons, which are
--                       right-aligned. Two 94 px buttons leave 76 px of a 300 px row, so it is
--                       64 wide; the harness checks it never meets a button at 296 px.
MenuScreens.PreviewWide = { anchor = Vector2.new(1, 0.5), position = UDim2.new(1, -118, 0.5, 0), size = UDim2.fromOffset(72, 56) }
MenuScreens.PreviewStacked = { anchor = Vector2.new(0, 1), position = UDim2.new(0, 14, 1, -9), size = UDim2.fromOffset(64, 44) }
-- A wide row with TWO buttons (the Death Effects rows: PREVIEW and buy/equip) has a 194 px strip, so
-- its preview moves 100 px further in: 218 from the right, ending 12 px short of the strip and 16 px
-- clear of the title's -320 column.
MenuScreens.PreviewWideTwo = { anchor = Vector2.new(1, 0.5), position = UDim2.new(1, -218, 0.5, 0), size = UDim2.fromOffset(72, 56) }

-- A preview of cosmetic `id` on a row from makeRow (`row` is the row frame, not its button strip).
-- The real model through CosmeticPreview where one can be built; otherwise a swatch in the item's
-- colour with its rarity, so a listed item never has an empty hole where every other row has a
-- picture. `spot` overrides where it goes (one of the Preview* above). Returns the holder frame.
function MenuScreens.RowPreview(row, id, stacked, spot)
	local item = CosmeticData.Get(id)
	spot = spot or (stacked and MenuScreens.PreviewStacked or MenuScreens.PreviewWide)
	local holder = create("Frame", {
		Name = "RowPreview",
		AnchorPoint = spot.anchor,
		Position = spot.position,
		Size = spot.size,
		BackgroundColor3 = C.PanelAlt,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = row,
	}, { rounded(8) })
	if item and canPreview(id) and pcall(CosmeticPreview.Fill, holder, id) then
		return holder
	end
	holder.BackgroundTransparency = 0
	local color = (item and (item.color or (item.rarity and Rarity.Color(item.rarity)))) or C.Muted
	create("Frame", {
		Name = "Swatch",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = holder,
	}, { rounded(13) })
	create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -2),
		Size = UDim2.new(1, -4, 0, 12),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = item and string.upper(item.rarity or item.kind or "") or "",
		TextColor3 = color,
		TextScaled = true,
		Parent = holder,
	})
	return holder
end

--------------------------------------------------------------------------------
-- Death Effects (#24)
--------------------------------------------------------------------------------

-- The kind's id is still its first name, so saves and the equip slot never change.
MenuScreens.KillAnimationKind = "KillAnimation"

-- What each death effect's row offers, worked out apart from drawing so the harness can hold it to
-- the server's own rules (RewardService.BuyCosmetic: owned, crate-only, in stock, affordable, in that
-- order; EquipCosmetic: owned). `at` is the stock time, for a test.
--
-- Listed from CosmeticData.OfKind, which leaves out bundle exclusives and rank rewards: one of those
-- is still shown once OWNED, so the player can equip it, and is otherwise somewhere else's to sell.
function MenuScreens.KillAnimationRows(profile, at)
	local cosmetics = profile and profile.cosmetics
	local owned = cosmetics and cosmetics.owned or {}
	local ids, listed = {}, {}
	for _, id in ipairs(CosmeticData.OfKind(MenuScreens.KillAnimationKind)) do
		listed[id] = true
		table.insert(ids, id)
	end
	for id in pairs(owned) do
		local item = CosmeticData.Get(id)
		if not listed[id] and item and item.kind == MenuScreens.KillAnimationKind then
			table.insert(ids, id)
		end
	end
	local rows = {}
	for _, id in ipairs(ids) do
		local item = CosmeticData.Get(id)
		local row = { id = id, item = item }
		if owned[id] then
			row.action = MenuScreens.Equipped(cosmetics, id) and "unequip" or "equip"
			row.enabled = true
		elseif item.crateOnly or not item.price then
			row.action, row.enabled = "crate", false
		elseif not ShopRotation.IsCosmeticInStock(id, at) then
			row.action, row.enabled = "outofstock", false
		else
			row.action = "buy"
			row.enabled = profile ~= nil and (profile.coins or 0) &gt;= item.price
		end
		table.insert(rows, row)
	end
	-- Owned first (equipped at the very top), then what you can buy now, then the rest; rarity, then
	-- price, then name inside each.
	local rank = { unequip = 1, equip = 2, buy = 3, outofstock = 4, crate = 5 }
	table.sort(rows, function(a, b)
		if rank[a.action] ~= rank[b.action] then
			return rank[a.action] &lt; rank[b.action]
		end
		local ra, rb = Rarity.Index[a.item.rarity] or 0, Rarity.Index[b.item.rarity] or 0
		if ra ~= rb then
			return ra &lt; rb
		end
		local pa, pb = a.item.price or math.huge, b.item.price or math.huge
		if pa ~= pb then
			return pa &lt; pb
		end
		return a.item.name &lt; b.item.name
	end)
	return rows
end

-- One line saying where a row stands, for the stage: owned and worn, owned, on sale (and the price),
-- sold out this rotation, or a crate exclusive. `formatNumber` is the host's.
function MenuScreens.KillAnimationState(entry, formatNumber)
	local item = entry.item
	local kind = string.upper((item.rarity or "") .. " death effect")
	if entry.action == "unequip" then
		return kind .. "  •  YOURS, EQUIPPED"
	elseif entry.action == "equip" then
		return kind .. "  •  YOURS"
	elseif entry.action == "buy" then
		return kind .. "  •  " .. formatNumber(item.price) .. " C, IN THE SHOP NOW"
	elseif entry.action == "outofstock" then
		return kind .. "  •  " .. formatNumber(item.price) .. " C WHEN IT ROTATES BACK IN"
	end
	return kind .. "  •  CRATE EXCLUSIVE: DEATH EFFECT CRATE"
end

-- The effect on the stage, remembered across re-renders (a purchase re-renders the tab, and the stage
-- should still be showing what was just bought).
MenuScreens.StageId = nil

-- The stage card: one effect, big, looping on a stand-in body, with its name, where it stands and its
-- description. No buttons on it (each row's PREVIEW puts its effect here), so it is never mistaken for
-- a row. Wide: the picture left, the words right. Narrow: the picture across the top.
local function stageCard(host, layoutOrder)
	local narrow = host.narrow
	local card = create("Frame", {
		Name = "DeathEffectStage",
		Size = UDim2.new(1, -8, 0, narrow and 290 or 190),
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		LayoutOrder = layoutOrder,
		Parent = host.content,
	}, { rounded(10) })
	local view = create("Frame", {
		Name = "Stage",
		Position = UDim2.fromOffset(10, 10),
		Size = narrow and UDim2.new(1, -20, 0, 172) or UDim2.fromOffset(236, 170),
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = card,
	}, { rounded(8) })
	local textX = narrow and 10 or 258
	local textTop = narrow and 190 or 14
	local function label(y, height, font, size, color, wrapped)
		return create("TextLabel", {
			Position = UDim2.fromOffset(textX, textTop + y),
			Size = UDim2.new(1, -(textX + 10), 0, height),
			BackgroundTransparency = 1,
			Font = font,
			Text = "",
			TextColor3 = color,
			TextSize = size,
			TextWrapped = wrapped == true,
			TextTruncate = wrapped and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = card,
		})
	end
	local result = {
		view = view,
		name = label(0, 26, Enum.Font.FredokaOne, narrow and 20 or 24, C.Text),
		state = label(narrow and 26 or 32, 18, Enum.Font.GothamBold, 12, C.Accent),
		description = label(narrow and 46 or 56, narrow and 36 or 66, Enum.Font.Gotham, 13, C.Muted, true),
		hint = label(narrow and 84 or 146, 14, Enum.Font.GothamBold, 11, C.Muted),
	}
	result.hint.Text = "PRESS PREVIEW ON ANY EFFECT TO WATCH IT HERE"
	return result
end

local stage

-- Puts `entry` on the stage: the live preview (through CosmeticPreview, looping) and its words.
-- `withSound` plays the effect's sounds on its first loop, for a PREVIEW press, not for the tab opening.
local function showOnStage(entry, host, withSound)
	if not stage or not stage.view.Parent then
		return
	end
	MenuScreens.StageId = entry.id
	local item = entry.item
	stage.name.Text = item.name
	stage.name.TextColor3 = item.rarity and Rarity.Color(item.rarity) or C.Text
	stage.state.Text = MenuScreens.KillAnimationState(entry, host.formatNumber)
	stage.description.Text = item.description or ""
	local options = { stage = true, turn = 0.35, background = C.PanelAlt }
	if withSound then
		options.sound = function(cue, jitter)
			Sfx.Play(cue, jitter)
		end
	end
	if CosmeticPreview then
		pcall(CosmeticPreview.Fill, stage.view, entry.id, options)
	end
	if stage.button and stage.button.Parent then
		stage.button.Text = "PREVIEW"
	end
	stage.button = entry.previewButton
	if stage.button then
		stage.button.Text = "REPLAY"
	end
end

-- Draws the tab through the host's own row pieces, so its rows look exactly like the Cosmetics tab
-- beside it, under a stage that plays the chosen effect live. host = { profile, content, makeRow,
-- addButton, emptyMessage, stockHeader, narrow, buy(id), equip(id), formatNumber }. `buy` and `equip`
-- are the existing BuyCosmetic / EquipCosmetic remotes: a death effect is a cosmetic like any other,
-- so it needs no remote of its own.
function MenuScreens.RenderKillAnimations(host)
	host.stockHeader(0, "DEATH EFFECTS  •  what plays on the players you eliminate")
	local rows = MenuScreens.KillAnimationRows(host.profile)
	if #rows == 0 then
		stage = nil
		host.emptyMessage("No death effects yet. When they arrive they are sold here, and one you own is equipped here too.")
		return 0
	end
	stage = host.content and stageCard(host, 1) or nil

	local chosen
	for order, entry in ipairs(rows) do
		local item, id = entry.item, entry.id
		local buttons = host.makeRow(order + 1, item.name, item.rarity and Rarity.Color(item.rarity) or item.color,
			string.format("%s Death Effect  •  %s", item.rarity or "", item.description or ""))
		MenuScreens.RowPreview(buttons.Parent, id, host.narrow, (not host.narrow) and MenuScreens.PreviewWideTwo or nil)
		entry.previewButton = host.addButton(buttons, 1, "PREVIEW", UiKit.Role.Info, function()
			showOnStage(entry, host, true)
		end)
		if entry.action == "buy" then
			host.addButton(buttons, 2, host.formatNumber(item.price) .. " C", C.Accent, function()
				host.buy(id)
			end, entry.enabled)
		elseif entry.action == "equip" then
			host.addButton(buttons, 2, "EQUIP", C.Green, function()
				host.equip(id)
			end)
		elseif entry.action == "unequip" then
			-- The server toggles it off when what's equipped is equipped again.
			host.addButton(buttons, 2, "UNEQUIP", C.Storm, function()
				host.equip(id)
			end)
		elseif entry.action == "outofstock" then
			host.addButton(buttons, 2, "SOLD OUT", C.PanelAlt, nil, false)
		else
			host.addButton(buttons, 2, "CRATES", C.PanelAlt, nil, false)
		end
		if id == MenuScreens.StageId or (not chosen and entry.action == "unequip") then
			chosen = entry
		end
	end
	showOnStage(chosen or rows[1], host, false)
	return #rows
end

return MenuScreens
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX172"><Properties><string name="Name">MenuShell</string><ProtectedString name="Source">-- The menu's frame: the panel, its header, its navigation and the area a tab draws into.
--
-- The old panel was a fixed 760x480 in the middle of the screen whatever the screen was: 40% of a
-- 1920x1080 monitor, and 123% of the HEIGHT of an 844x390 phone, where its tabs and buttons fell
-- off the bottom. MenuClient never read ViewportSize at all. This sizes itself from the viewport
-- every time it changes, and lays its navigation out to match:
--
--   desktop / tablet   a rail down the left, each destination with a subtitle
--   phone              a bar across the bottom, inside the thumb's reach
--
-- The shell owns no content. A host (MenuClient) gives it destinations and draws into `Content`,
-- so the tabs keep their own renderers and their own owners.
--
-- A ModuleScript, so tools/menu_hud_gallery.lua can render it without a running client.

local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UiKit = require(script.Parent:WaitForChild("UiKit"))
local UiParts = require(script.Parent:WaitForChild("UiParts"))

local create, rounded, padding = UiKit.create, UiKit.rounded, UiKit.padding
local Role, Type, Space, Radius, Stroke = UiKit.Role, UiKit.Type, UiKit.Space, UiKit.Radius, UiKit.Stroke

local MenuShell = {}
MenuShell.__index = MenuShell

local RAIL_WIDE, RAIL_NARROW, RAIL_ICON = 208, 168, 64

-- How the phone's bottom bar is laid out: how many cells fit across the panel at a full 44 px touch
-- target, how many rows that needs, and the room they have. Both the height (measured in
-- SetViewport) and the cells (built in SetDestinations) come from here, so they cannot disagree.
-- `count` may be 0 — the shell is built before it has destinations.
local function barLayout(panelWidth, count)
	local room = panelWidth - Space.MD * 2
	local perRow = math.max(1, math.floor((room + Space.SM) / (UiKit.Touch + Space.SM)))
	count = math.max(count, 1)
	perRow = math.min(perRow, count)
	return perRow, math.ceil(count / perRow), room
end

-- options: parent (a ScreenGui or Frame), title, viewport, onClose, onSettings, onBack
function MenuShell.new(options)
	local self = setmetatable({}, MenuShell)
	self.destinations = {}
	self.active = nil
	self.onSelect = nil
	self.onBack = options.onBack

	self.layer = create("Frame", {
		Name = "MenuShell",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = options.parent,
	})
	-- A dim behind the panel: mid-match the menu used to sit on a live HUD with nothing between.
	self.scrimFrame = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Role.Scrim,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = self.layer,
	})
	self.scrimFrame.Activated:Connect(function()
		if self.onBack then
			self.onBack()
		end
	end)

	self.panel = create("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(760, 480),
		BackgroundColor3 = Role.Base,
		BorderSizePixel = 0,
		Parent = self.layer,
	}, { rounded(Radius.Panel) })
	create("UIStroke", { Color = Role.Line, Thickness = Stroke.Hairline, Parent = self.panel })
	self.scale = create("UIScale", { Parent = self.panel })

	self.onClose = options.onClose
	self.onSettings = options.onSettings

	-- Oliver's #66, "the x button on the menu is broken". It was not a hit-test and not a z-order:
	-- the button had NO Activated connection at all.
	--
	-- These two used to be built as `onClick = options.onClose` / `options.onSettings`. MenuClient
	-- constructs the shell at its line 138, long before `toggleMenu` exists, so it passes neither --
	-- and UiParts.button (UiParts.lua:146) only reaches `Activated:Connect` when `onClick` is
	-- non-nil. So the X was built dead, while UiParts.interactive still gave it hover and press
	-- states: it looked alive, which is why it reads as "broken" rather than as "missing".
	--
	-- The scrim above never had this bug, and the difference is the whole lesson: it
	-- reads `self.onBack` at CLICK time, and MenuClient assigns that field later. So these read
	-- their handler at click time too -- and, more to the point, the closures themselves are never
	-- nil, so the X can no longer be CONSTRUCTED without a connection whatever a host forgets to
	-- pass. The failure mode is removed rather than patched at one call site.
	local actions = {
		{
			glyph = "⚙",
			onClick = function()
				self:Settings()
			end,
		},
		-- The letter, not a multiplication sign: U+2715 isn't in the font Roblox ships and drew a
		-- tofu box in the render. MenuClient's own close button has always used "X".
		{
			glyph = "X",
			onClick = function()
				self:Dismiss()
			end,
		},
	}
	local header, walletSlot = UiParts.header({
		parent = self.panel,
		title = options.title or "BRAINROT BATTLES",
		actions = actions,
	})
	self.header = header
	self.WalletSlot = walletSlot

	-- The header's only TextButtons are its actions: its title and labels are TextLabels and its
	-- wallet slot is a Frame. Held by name so a probe, a gallery or a later tab can reach the REAL
	-- X rather than one it built itself, which would say nothing about what the shell builds.
	self.HeaderActions = {}
	do
		local buttons = {}
		for _, child in ipairs(header:GetDescendants()) do
			if child:IsA("TextButton") then
				table.insert(buttons, child)
			end
		end
		table.sort(buttons, function(a, b)
			return a.LayoutOrder &lt; b.LayoutOrder
		end)
		self.HeaderActions.settings, self.HeaderActions.close = buttons[1], buttons[2]
	end

	-- What was actually put in each action's `onClick` slot. UiParts.button connects Activated if
	-- and only if that value is non-nil, so this table IS the wiring -- a nil here is precisely the
	-- shipped bug. Exposed because Studio's plugin sandbox refuses synthetic input
	-- ("lacking capability RobloxScript"), so a probe cannot click the button and this is the next
	-- thing down that is still a measurement of the real construction rather than an assumption.
	self.HeaderHandlers = { settings = actions[1].onClick, close = actions[2].onClick }

	-- Oliver's #65, "the tabs in the menu aren't fitting inside the menu hud". This was a plain
	-- Frame, so a destination stack taller than the nav simply drew on past the bottom of the
	-- PANEL: nothing clipped it, nothing scrolled it, nothing shrank it. A ScrollingFrame cannot
	-- draw outside itself, so containment is structural now rather than something the arithmetic
	-- has to keep getting right as the destination list changes.
	self.nav = create("ScrollingFrame", {
		Name = "Nav",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		-- Explicit, and not because a ScrollingFrame is believed to clip anyway. The WHOLE of the
		-- #65 containment claim rests on this one property, and the probe reads it back off the
		-- instance rather than assuming it -- so if this line is ever removed the probe goes red
		-- instead of quietly reporting that nothing is drawn outside the panel.
		ClipsDescendants = true,
		-- 0, not hidden: on every screen the game is designed for the stack fits, so a visible bar
		-- would appear only on a shape nobody has, and it would eat width the rail needs.
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = self.panel,
	})
	self.navLayout = create("UIListLayout", {
		Padding = UDim.new(0, Space.SM),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = self.nav,
	})

	-- What a tab draws into. Scrolls on its own so a tab never has to think about height.
	self.Content = create("ScrollingFrame", {
		Name = "Content",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = Role.Line,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = self.panel,
	})

	self:SetViewport(options.viewport or Vector2.new(1280, 720))
	return self
end

-- Lays the panel, the navigation and the content out for a screen. Called on open and whenever the
-- viewport changes, so a window resize or a phone rotation is handled by the same path.
function MenuShell:SetViewport(viewport, touch)
	self.viewport = viewport
	self.touch = touch == nil and self.touch or touch
	-- Three versions, chosen by which dimension has run out. `phone` is kept as the name for the
	-- bottom-bar case so existing reads keep working, but it now means "tall" specifically:
	-- a LANDSCAPE phone is "short" and gets an icon rail, not a bar.
	local mode = UiKit.form(viewport)
	local size = UiKit.panelSize(viewport, self.touch)
	local safe = UiKit.safeArea(viewport, self.touch)
	local phone = mode == "tall"
	self.Form = mode
	self.phone = phone
	self.short = mode == "short"

	self.panel.Size = UDim2.fromOffset(size.X, size.Y)
	self.panelWidth = size.X
	-- The panel is already sized to the screen, so this is a belt-and-braces shrink: PhoneLayout's
	-- own maths, the same call the rest of the phone work uses, so a screen it considers too small
	-- still can't lose the bottom of the menu. PanelScale rather than FitPanel because the shell
	-- already redraws on a viewport change, and FitPanel would add a second connection each time.
	--
	-- This looks redundant, and on every screen the menu is drawn for it IS a no-op, because the
	-- panel sizes itself (measured, panel size -&gt; fit): 1920x1080 1180x760 -&gt; 1.000, 1366x768
	-- 1174x660 -&gt; 1.000, 1280x720 1100x619 -&gt; 1.000, 1024x768 880x612 -&gt; 1.000, 844x390 804x260 -&gt;
	-- 1.000, 640x360 600x260 -&gt; 1.000. It first bites at 600x320 (560x260 -&gt; 0.969), where the
	-- panel's 260-tall minimum beats the room. Don't delete it for looking idle: it is the only
	-- thing holding the sizes below this list.
	local fitter = self.phoneLayout
	if fitter == nil then
		local module = script.Parent:FindFirstChild("PhoneLayout")
		fitter = module and require(module) or false
		self.phoneLayout = fitter
	end
	-- Held, because the open and close animations drive this same UIScale and have to return to the
	-- fitted size rather than to 1.
	self.fitScale = fitter and fitter.PanelScale(size, viewport, { inset = true }) or 1
	self.scale.Scale = self.fitScale
	-- Nudged down by half the difference between the insets, so the panel sits in the space the
	-- player can actually see rather than under the top bar.
	self.panel.Position = UDim2.new(0.5, 0, 0.5, math.floor((safe.Top - safe.Bottom) / 2))

	-- The small version's header is 44, not 64: it is the single cheapest 20 px on a screen with
	-- 260 px of panel, and the title still reads at Heading size.
	-- 44 rather than 40 since #20: the header's buttons are full 44 px touch targets, and at 40 they
	-- hung 2 px over the header's top and bottom (tools/menu_screens_check.py).
	local headerHeight = (mode == "short" and UiKit.Touch) or (phone and 52) or 64
	self.header.Size = UDim2.new(1, 0, 0, headerHeight)
	local headerTitle = self.header:FindFirstChildOfClass("TextLabel")
	if headerTitle then
		headerTitle.TextSize = (phone and Type.Heading or Type.Title).Size
		headerTitle.Font = (phone and Type.Heading or Type.Title).Font
		-- UiParts.header works its title width out from the panel width, but the header is built
		-- before the shell has been given one, so the reserve is redone here on every viewport
		-- change. Without this the title kept the width it was born with and the portrait render
		-- came back with no title at all.
		local actionsWidth = 2 * (UiKit.Touch + Space.SM)
		local slotWidth = 168
		local room = size.X - Space.LG * 2 - actionsWidth - Space.SM
		local showSlot = room - slotWidth &gt;= 150
		self.WalletSlot.Visible = showSlot
		headerTitle.Size = UDim2.new(1, -(actionsWidth + Space.SM + (showSlot and slotWidth + Space.SM or 0)), 1, 0)
	end

	-- #78: a screen with one tab (ROBUX, SETTINGS) is a whole page, not a page beside a one-item rail
	-- that goes nowhere. No navigation at all, and the content has the panel's full width.
	local solo = #self.destinations &lt;= 1
	self.Solo = solo
	self.nav.Visible = not solo
	local railWidth = ((phone or solo) and 0)
		or (mode == "short" and RAIL_ICON)
		or (viewport.X &lt; 1280 and RAIL_NARROW or RAIL_WIDE)

	-- How many bar cells fit across at a full touch target, and therefore how many rows the bar
	-- needs. A narrow screen is the case that forces this: eight destinations across a 320-wide
	-- portrait panel works out at 30 px a cell, and a 30 px target is not a target. The bar wraps
	-- instead, and stays as tall as it has to be.
	local perRow, rows = #self.destinations, 1
	if phone then
		perRow, rows = barLayout(size.X, #self.destinations)
	end
	local barHeight = (phone and not solo) and (rows * UiKit.Touch + (rows - 1) * Space.SM + Space.MD * 2) or 0
	self.railWidth, self.barHeight = railWidth, barHeight
	self.navPerRow, self.navRows = perRow, rows

	if phone then
		self.nav.AnchorPoint = Vector2.new(0.5, 1)
		self.nav.Position = UDim2.new(0.5, 0, 1, 0)
		self.nav.Size = UDim2.new(1, 0, 0, barHeight)
		self.nav.BackgroundColor3 = Role.Surface
		self.nav.BackgroundTransparency = 0
		-- The bar is a column of rows, each row a line of cells, so one row and four behave the same.
		self.navLayout.FillDirection = Enum.FillDirection.Vertical
		self.navLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		self.navLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		-- The bar sizes ITSELF to its rows (barHeight above comes from the same wrap), so it never
		-- has more content than window and must not scroll. Left automatic, a centred list inside a
		-- growing canvas fights itself; this keeps the bar exactly what it was.
		self.nav.AutomaticCanvasSize = Enum.AutomaticSize.None
		self.nav.CanvasSize = UDim2.new()
		self.nav.ScrollingEnabled = false
	else
		self.nav.AnchorPoint = Vector2.zero
		self.nav.Position = UDim2.fromOffset(Space.LG, headerHeight)
		self.nav.Size = UDim2.new(0, railWidth - Space.LG, 1, -headerHeight - Space.LG)
		self.nav.BackgroundTransparency = 1
		self.navLayout.FillDirection = Enum.FillDirection.Vertical
		self.navLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
		self.navLayout.VerticalAlignment = Enum.VerticalAlignment.Top
		-- The rail is the case that overflowed (#65). It scrolls only when the stack is taller than
		-- the room; on the screens the game is designed for it is not, so nothing visible changes
		-- and no destination can be drawn outside the panel at any count.
		self.nav.AutomaticCanvasSize = Enum.AutomaticSize.Y
		self.nav.ScrollingEnabled = true
	end

	-- Without a rail the content still wants a gutter on its left, or it runs into the panel's edge.
	local left = (phone and Space.MD) or (solo and Space.LG) or 0
	self.Content.Position = UDim2.fromOffset(railWidth + left, headerHeight)
	self.Content.Size = UDim2.new(1, -railWidth - left - (phone and Space.MD or Space.LG), 1, -headerHeight - barHeight - Space.MD)
	self.ContentWidth = size.X - railWidth - left - (phone and Space.MD or Space.LG)

	if #self.destinations &gt; 0 then
		self:SetDestinations(self.destinations, self.active)
	end
end

-- destinations: { { key, label, glyph, sub } }. Rebuilt on a viewport change because a rail item
-- and a bar cell are different shapes, not the same shape resized.
function MenuShell:SetDestinations(destinations, active)
	self.destinations = destinations
	self.active = active or self.active or (destinations[1] and destinations[1].key)

	-- A changed count changes how many rows the bar wraps to, and therefore how tall the bar is and
	-- how much height is left for content -- so the panel has to be re-laid BEFORE the cells are
	-- built, not after. SetViewport's own tail calls straight back in here to do the building, and
	-- `laying` stops that becoming a loop: the re-entrant call skips this block and goes to the
	-- build, and this one returns having already had its cells made.
	if self.viewport and not self.laying then
		self.laying = true
		local ok, err = pcall(function()
			self:SetViewport(self.viewport, self.touch)
		end)
		self.laying = false
		if not ok then
			error(err, 0)
		end
		return
	end
	for _, child in ipairs(self.nav:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end

	-- Measured against the PANEL, not the screen. The panel is inset from the screen edges, so
	-- sizing eight cells from the viewport overflowed it: at 844 wide the bar came to 816 px inside
	-- a 780 px panel, and the last destination ran off the end.
	local perRow, _, barRoom = barLayout(self.panelWidth or self.viewport.X, #destinations)
	local width = nil
	local row = nil
	if self.phone then
		width = math.floor((barRoom - Space.SM * (perRow - 1)) / perRow)
	end
	for index, destination in ipairs(destinations) do
		if self.phone and (index - 1) % perRow == 0 then
			-- One frame per line of cells. The rows are what the bar's height was measured from.
			row = create("Frame", {
				Size = UDim2.new(1, 0, 0, UiKit.Touch),
				BackgroundTransparency = 1,
				LayoutOrder = math.floor((index - 1) / perRow) + 1,
				Parent = self.nav,
			}, {
				create("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalAlignment = Enum.HorizontalAlignment.Center,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					Padding = UDim.new(0, Space.SM),
					SortOrder = Enum.SortOrder.LayoutOrder,
				}),
			})
		end
		UiParts.navItem({
			parent = self.phone and row or self.nav,
			rail = not self.phone,
			-- The short version's rail is 64 wide: glyph only. Without this the cells drew their
			-- label and subtitle at full rail width and lay across the cards beside them.
			compact = self.short,
			-- A bar cell under 72 px cannot hold "COSMETICS" at any size worth reading, so it shows
			-- the glyph alone rather than a clipped word. Eight destinations at 320 wide is 52 px.
			glyphOnly = self.phone and width and width &lt; 72 or nil,
			width = width,
			glyph = destination.glyph,
			label = destination.label,
			sub = destination.sub,
			selected = destination.key == self.active,
			layoutOrder = index,
			onClick = function()
				self:Select(destination.key)
			end,
		})
	end
end

-- The header's title: each HUD button's screen names itself (#78), so SHOP reads SHOP rather than the
-- game's name over every page.
function MenuShell:SetTitle(text)
	local title = self.header:FindFirstChildOfClass("TextLabel")
	if title then
		title.Text = text
	end
	self.Title = text
end

function MenuShell:Select(key)
	if self.active == key then
		return
	end
	self.active = key
	self:SetDestinations(self.destinations, key)
	if self.onSelect then
		self.onSelect(key)
	end
end

-- What the X does, read at CLICK time so a host can assign the field after construction the way
-- MenuClient already does with `onBack`.
--
-- The last branch is deliberate: a close button that does nothing is the bug this replaced, so a
-- shell nobody has given a handler still CLOSES rather than sitting there looking pressable. There
-- is no arrangement of options that produces a dead X.
function MenuShell:Dismiss()
	local handler = self.onClose or self.onBack
	if handler then
		handler()
	else
		self:Close()
	end
end

-- What the gear does. Dead in the built place for exactly the same reason the X was, and fixed the
-- same way even though the revamp moves Settings into the destination list and drops the gear: if
-- anything re-adds it, it has to work by construction rather than by someone remembering to pass a
-- handler. With no handler it selects a "Settings" destination if the host has one.
function MenuShell:Settings()
	if self.onSettings then
		self.onSettings()
		return
	end
	for _, destination in ipairs(self.destinations) do
		if destination.key == "Settings" then
			self:Select(destination.key)
			return
		end
	end
end

-- Closing counts as closed: during the close tween the layer is still visible, and a press then
-- (M, a HUD button) must reopen the menu rather than be swallowed or close it again.
function MenuShell:IsOpen()
	return self.layer.Visible and not self.closing
end

function MenuShell:Open()
	if self.layer.Visible and not self.closing then
		return
	end
	-- Reopened mid-close: the close tween's callback sees `closing` cleared and leaves the layer up.
	self.closing = false
	self.layer.Visible = true
	self.scrimFrame.BackgroundTransparency = 1
	TweenService:Create(self.scrimFrame, TweenInfo.new(UiKit.Motion.Fade), { BackgroundTransparency = 0.45 }):Play()
	UiParts.openPanel(self.panel, self.scale, self.fitScale)
end

function MenuShell:Close()
	if not self.layer.Visible or self.closing then
		return
	end
	self.closing = true
	TweenService:Create(self.scrimFrame, TweenInfo.new(UiKit.Motion.Press), { BackgroundTransparency = 1 }):Play()
	UiParts.closePanel(self.panel, self.scale, function()
		if not self.closing then
			-- Reopened before the tween ended: closePanel has just hidden the panel, so show it again.
			self.panel.Visible = true
			return
		end
		self.closing = false
		self.layer.Visible = false
		self.panel.Visible = true
	end, self.fitScale)
end

function MenuShell:Toggle()
	if self:IsOpen() then
		self:Close()
	else
		self:Open()
	end
end

-- WHO ASKS "what screen is this?", and why it lives here rather than in the host.
--
-- This wiring used to be MenuClient's, and MenuClient never did it (#65) -- the shell kept the
-- 1280x720 its constructor falls back to, on every screen, so the `short` and `tall` versions never
-- ran in the game at all. The reason that hid for months is worth writing down: MenuClient is a
-- LocalScript, and a LocalScript never runs in the runtest harness, so the missing wiring was also
-- wiring that nothing could test. `SetViewport` itself always worked and was easy to test; its
-- CALLER was neither. Moving the call in here makes it reachable by a probe, so the gap cannot
-- reopen silently.
--
-- Re-laid on three signals, not one: the viewport (a resize or a rotation), the camera being
-- REPLACED (workspace.CurrentCamera is swapped out, and a listener left on the old one feeds
-- nothing), and TouchEnabled, which decides the safe area that keeps the panel clear of Roblox's
-- own controls.
function MenuShell:BindViewport(camera)
	self:UnbindViewport()
	self.viewportBinding = {}
	local function relayout()
		local live = camera or workspace.CurrentCamera
		if live then
			self:SetViewport(live.ViewportSize, UserInputService.TouchEnabled)
		end
	end
	local function watch()
		local live = camera or workspace.CurrentCamera
		if not live then
			return
		end
		if self.viewportWatch then
			self.viewportWatch:Disconnect()
		end
		self.viewportWatch = live:GetPropertyChangedSignal("ViewportSize"):Connect(relayout)
		relayout()
	end
	watch()
	if not camera then
		table.insert(self.viewportBinding, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watch))
	end
	table.insert(self.viewportBinding, UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(relayout))
	return self
end

function MenuShell:UnbindViewport()
	if self.viewportWatch then
		self.viewportWatch:Disconnect()
		self.viewportWatch = nil
	end
	for _, connection in ipairs(self.viewportBinding or {}) do
		connection:Disconnect()
	end
	self.viewportBinding = nil
end

-- Back, on a pad and on a keyboard.
--
-- Not Escape: Roblox keeps that for its own menu and a game can't take it, so a player who presses
-- it gets the Roblox menu, not ours. Backspace is the keyboard stand-in, the gamepad's B button is
-- what a pad player already expects, and the scrim and the X are there for a mouse or a thumb.
-- `handler` is called for each press; it should close the top-most layer and return true if it
-- handled it, so a dialog closes before the menu does.
function MenuShell:BindBack(name, handler)
	self.backName = name or "BrrMenuShellBack"
	ContextActionService:BindAction(self.backName, function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if not self:IsOpen() then
			return Enum.ContextActionResult.Pass
		end
		if handler and handler() then
			return Enum.ContextActionResult.Sink
		end
		self:Close()
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Backspace, Enum.KeyCode.ButtonB)
end

function MenuShell:UnbindBack()
	if self.backName then
		ContextActionService:UnbindAction(self.backName)
		self.backName = nil
	end
end

-- Clears the content area, keeping its layout, ready for a tab to draw.
function MenuShell:ClearContent()
	UiKit.clearItems(self.Content)
end

return MenuShell
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX173"><Properties><string name="Name">MenuStackToggle</string><ProtectedString name="Source">-- Tucks the left-hand stack (MENU, the bundle nudge, the quest tracker) away behind a small tab, and
-- brings it back. A ModuleScript so MenuClient can mount it and tools/hud_ux_gallery.lua can render it.
--
--   local toggle = MenuStackToggle.new(screenGui, { items = { menuButton, bundleNudge, tracker }, settings = Settings })
--   toggle:SetSummary("2/3")          -- what the collapsed tab shows beside its icon (quests done)
--   toggle:Attention()                -- something new while it's tucked away: the tab lights up and pulses
--   toggle:SetCollapsed(true)         -- by hand (the tab and the setting both come through here)
--
-- The items move into one container that slides and fades; each keeps its own Visible, so whatever
-- MenuClient shows or hides carries on exactly as before. Collapsed, the tab sits where MENU was,
-- showing a menu icon and today's quest count, and it lights up and pulses when a quest or challenge
-- completes, the daily spin comes round, a pass reward is ready or a gift lands; expanding clears
-- that. Nothing is ever out of reach: M and J still open the menu and quests, and the tab is a tap
-- away. The choice is the "MenuStackCollapsed" setting, so it's saved to the profile (and RESET under
-- Gameplay brings the stack back).
--
-- On a touch screen the whole thing moves: MenuClient calls `SetPhone(PhoneLayout.Rects(viewport), inset)`
-- and the tab goes to the top-right corner beside the MENU icon, with the stack hanging underneath it at
-- 0.8 and starting at whatever is actually showing (MENU is its own icon there, not part of the stack).
-- `SetPhone(nil)` puts it all back on the left edge.

local TweenService = game:GetService("TweenService")

local UiKit = require(script.Parent:WaitForChild("UiKit"))

local create, rounded = UiKit.create, UiKit.rounded
local C = UiKit.Colors

local MenuStackToggle = {}
MenuStackToggle.__index = MenuStackToggle

MenuStackToggle.SettingId = "MenuStackCollapsed"

-- The stack's pixel layout in MenuClient's ScreenGui: the SHOP button (top of the five) at (16, 130),
-- 104x26 (Oliver 14:41: the minimize tab floated away from the buttons when they shrank).
local STACK_TOP = 124
local STACK_SIZE = Vector2.new(300, 460)
local MENU_X, MENU_Y, MENU_W, MENU_H = 16, 130, 104, 26
local SLIDE = 56

-- 40 wide rather than a sliver: it's a finger's target on a phone.
local EXPANDED_TAB = { x = MENU_X + MENU_W + 3, w = 30 }
local COLLAPSED_TAB = { x = MENU_X, w = 78 }

local DARK = Color3.fromRGB(20, 16, 6)
local ALERT = Color3.fromRGB(255, 84, 84)

local function tween(instance, seconds, goal, style, direction)
	local t = TweenService:Create(instance, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

local function bar(parent, x, y, w, h, rotation, color)
	return create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Rotation = rotation or 0,
		Parent = parent,
	}, { rounded(math.ceil(h / 2)) })
end

function MenuStackToggle.new(screenGui, options)
	options = options or {}
	local self = setmetatable({}, MenuStackToggle)
	self.settings = options.settings
	self.collapsed = false
	self.pending = false
	self.token = 0

	-- Everything in the stack moves into one group, at the same place on screen.
	local stack = create("CanvasGroup", {
		Name = "LeftStack",
		Position = UDim2.fromOffset(0, STACK_TOP),
		Size = UDim2.fromOffset(STACK_SIZE.X, STACK_SIZE.Y),
		BackgroundTransparency = 1,
		GroupTransparency = 0,
		Parent = screenGui,
	})
	self.stack = stack
	for _, item in ipairs(options.items or {}) do
		local p = item.Position
		item.Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset - STACK_TOP)
		item.Parent = stack
	end

	local tab = create("TextButton", {
		Name = "StackToggle",
		Position = UDim2.fromOffset(EXPANDED_TAB.x, MENU_Y),
		Size = UDim2.fromOffset(EXPANDED_TAB.w, MENU_H),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Parent = screenGui,
	}, { rounded(10) })
	self.tab = tab
	-- ONE UIScale on the tab. Its resting value is self.fit (the stack's own scale, so the tab is the
	-- buttons' size); the open/close and attention bounces go relative to that and settle back on it.
	self.fit = 1
	self.tabScale = create("UIScale", { Parent = tab })
	self.tabStroke = create("UIStroke", {
		Color = C.Panel,
		Thickness = 1.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = tab,
	})

	-- Expanded: a chevron pointing left, "tuck it away".
	local tuck = create("Frame", { Name = "Tuck", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = tab })
	self.tuckBars = {
		-- Sized for the 30x26 tab beside the 26 px buttons (was drawn for 40x42 and hung out of it).
		bar(tuck, 14, 10, 9, 3, -45, C.Muted),
		bar(tuck, 14, 16, 9, 3, 45, C.Muted),
	}
	self.tuck = tuck

	-- Collapsed: a menu icon, today's quests, a chevron pointing right.
	local open = create("Frame", { Name = "Open", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = tab })
	self.openBars = {
		bar(open, 19, 7, 18, 3, 0, DARK),
		bar(open, 19, 13, 18, 3, 0, DARK),
		bar(open, 19, 19, 18, 3, 0, DARK),
	}
	self.summary = create("TextLabel", {
		Name = "Summary",
		Position = UDim2.fromOffset(32, 0),
		Size = UDim2.new(1, -44, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = "",
		TextColor3 = DARK,
		TextSize = 15,
		Parent = open,
	})
	self.openChevron = {
		bar(open, 69, 17, 9, 3, 45, DARK),
		bar(open, 69, 24, 9, 3, -45, DARK),
	}
	self.open = open

	-- The "something new" dot, on the collapsed tab's corner.
	local dot = create("Frame", {
		Name = "Attention",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -3, 0, 3),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = ALERT,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 3,
		Parent = tab,
	}, { rounded(7) })
	create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Parent = dot })
	self.dot = dot
	self.ring = create("Frame", {
		Name = "Ring",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = dot,
	}, { rounded(99) })
	self.ringStroke = create("UIStroke", { Color = ALERT, Thickness = 2, Transparency = 1, Parent = self.ring })

	tab.Activated:Connect(function()
		self:SetCollapsed(not self.collapsed, false, true)
	end)
	tab.MouseEnter:Connect(function()
		self.hovered = true
		self:_paintHover()
	end)
	tab.MouseLeave:Connect(function()
		self.hovered = false
		self:_paintHover()
	end)

	self.stackScale = create("UIScale", { Parent = stack })
	-- Oliver 15:24: the column ran into the health / shield / stamina block on a short window, and "make
	-- the hud scale with resolution". On desktop the whole stack (buttons, bundle, quest tracker) shrinks
	-- to whatever height is left above that block, and re-fits when the window or the tracker changes.
	local function refit()
		self:_fitHeight()
	end
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
	for _, item in ipairs(options.items or {}) do
		item:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
		item:GetPropertyChangedSignal("Visible"):Connect(refit)
	end
	task.defer(refit)

	if self.settings then
		self.settings.Changed:Connect(function(id)
			if id == "*" or id == MenuStackToggle.SettingId then
				self:SetCollapsed(self.settings.Get(MenuStackToggle.SettingId) == true, false, false)
			end
		end)
		self:SetCollapsed(self.settings.Get(MenuStackToggle.SettingId) == true, true, false)
	end
	return self
end

-- Height the bottom-left health / shield / stamina block takes (HudClient anchors it up to 1, -202, plus
-- its label), kept clear of the stack.
local BOTTOM_RESERVED = 150

function MenuStackToggle:_fitHeight()
	if self.phoneStack then
		return
	end
	local gui = self.stack.Parent
	if not gui then
		return
	end
	local current = math.max(self.stackScale.Scale, 0.01)
	local bottom = 0
	for _, item in ipairs(self.stack:GetChildren()) do
		if item:IsA("GuiObject") and item.Visible then
			bottom = math.max(bottom, item.Position.Y.Offset + item.AbsoluteSize.Y / current)
		end
	end
	if bottom &lt;= 0 then
		return
	end
	-- On a screen too narrow for the stamina bar to sit bottom-centre it moves up above the bottom-left
	-- stack (StaminaBar.Layout), so the column has to stop above IT, not just above the health block --
	-- it used to run into the bar (Oliver 17:10, STARTER BUNDLE under STAMINA).
	local reserved = BOTTOM_RESERVED
	local okStamina, StaminaBar = pcall(require, script.Parent:FindFirstChild("StaminaBar"))
	if okStamina and StaminaBar and StaminaBar.Layout then
		local anchor, position, scale = StaminaBar.Layout(gui.AbsoluteSize)
		if anchor.X == 0 then
			reserved = math.max(reserved, -position.Y.Offset + 50 * scale + 10)
		end
	end
	local room = gui.AbsoluteSize.Y - reserved - STACK_TOP
	-- Never below 0.85 (Oliver 15:37: at 0.55 it was too small to read), and grows up to 1.25x where
	-- there is room (Oliver 16:16: "the quest menu and buttons are still a bit too small").
	local scale = math.clamp(room / bottom, 0.85, 1.25)
	self.stackScale.Scale = scale
	-- The collapse tab sits outside the stack, so it scales and moves with it (Oliver 16:22: "the
	-- minimize button is floating"). It used to bounce back to a scale of 1 after every open/close
	-- while its position still assumed the stack's 1.25, so it hung off the buttons' corner.
	if math.abs(self.fit - scale) &gt; 0.001 then
		self.fit = scale
		self:_placeTab()
	end
end

-- The tab straight to where it belongs at the current fit: position, size and scale, no animation.
function MenuStackToggle:_placeTab()
	local position, size = self:_tabGoal(self.collapsed and COLLAPSED_TAB or EXPANDED_TAB)
	self.tab.Position, self.tab.Size = position, size
	self.tabScale.Scale = self.fit
end

function MenuStackToggle:_paintHover()
	if self.collapsed then
		self.tabStroke.Color = self.hovered and Color3.new(1, 1, 1) or C.Accent
	else
		self.tabStroke.Color = self.hovered and C.Muted or C.Panel
		for _, b in ipairs(self.tuckBars) do
			b.BackgroundColor3 = self.hovered and C.Text or C.Muted
		end
	end
end

-- Where the tab sits and how big it is, and where the stack hangs from it. On a desktop screen that is
-- the left edge beside MENU; on a touch screen it is the top-right corner, where PhoneLayout puts it
-- (the MENU icon is to its right and the camera button to its left), with the stack hanging underneath.
function MenuStackToggle:_tabGoal(target)
	if self.phoneTab then
		local w = target == COLLAPSED_TAB and self.phoneTab.w or math.min(self.phoneTab.w, 40)
		-- Right-aligned in its slot, so the icons beside it never shift when the tab changes width.
		return UDim2.fromOffset(self.phoneTab.x + self.phoneTab.w - w, self.phoneTab.y), UDim2.fromOffset(w, self.phoneTab.h)
	end
	-- Size stays in unscaled units: tabScale grows it with the stack. The position follows the scaled
	-- button column so the tab stays snug beside it.
	local s = self.fit or 1
	local x = target == EXPANDED_TAB and (MENU_X + MENU_W) * s + 3 or MENU_X * s
	return UDim2.fromOffset(x, STACK_TOP + (MENU_Y - STACK_TOP) * s), UDim2.fromOffset(target.w, MENU_H)
end

function MenuStackToggle:_stackHome()
	if self.phoneStack then
		return UDim2.fromOffset(self.phoneStack.X, self.phoneStack.Y)
	end
	return UDim2.fromOffset(0, STACK_TOP)
end

function MenuStackToggle:_stackAway()
	if self.phoneStack then
		-- Up and out of the way, back towards the tab it came from.
		return UDim2.fromOffset(self.phoneStack.X, self.phoneStack.Y - SLIDE)
	end
	return UDim2.fromOffset(-SLIDE, STACK_TOP)
end

-- Called by MenuClient when the screen changes. `spots` is PhoneLayout.Rects for a touch screen, or nil
-- for a desktop one; `inset` is the Roblox top bar, which MenuClient's ScreenGui keeps.
function MenuStackToggle:SetPhone(spots, inset)
	inset = inset or 0
	if spots then
		self.fit = 1
		self.phoneTab = { x = spots.stackTab.x, y = spots.stackTab.y - inset, w = spots.stackTab.w, h = spots.stackTab.h }
		-- Right-aligned under the tab, and pulled up so that whatever is actually showing starts right
		-- under it: MENU is its own icon on a phone and hidden in here, so the stack would otherwise
		-- open with its space empty at the top.
		local first = nil
		for _, item in ipairs(self.stack:GetChildren()) do
			if item:IsA("GuiObject") and item.Visible then
				local top = item.Position.Y.Offset
				first = first and math.min(first, top) or top
			end
		end
		self.phoneStack = Vector2.new(spots.stackTab.x + spots.stackTab.w - STACK_SIZE.X * 0.8,
			spots.stackTab.y1 + 6 - inset - (first or 0) * 0.8)
		self.stackScale.Scale = 0.8
		-- The collapsed tab is 52 wide here rather than 78, so the chevron goes and the count moves in.
		for index, b in ipairs(self.openBars) do
			b.Position = UDim2.fromOffset(13, 8 + index * 7)
			b.Size = UDim2.fromOffset(16, 3)
		end
		for _, b in ipairs(self.openChevron) do
			b.Visible = false
		end
		self.summary.Position = UDim2.fromOffset(24, 0)
		self.summary.Size = UDim2.new(1, -28, 1, 0)
		self.summary.TextSize = 14
	else
		self.phoneTab, self.phoneStack = nil, nil
		self.stackScale.Scale = 1
		self:_fitHeight()
		for index, b in ipairs(self.openBars) do
			b.Position = UDim2.fromOffset(19, 1 + index * 6)
			b.Size = UDim2.fromOffset(18, 3)
		end
		for _, b in ipairs(self.openChevron) do
			b.Visible = true
		end
		self.summary.Position = UDim2.fromOffset(32, 0)
		self.summary.Size = UDim2.new(1, -44, 1, 0)
		self.summary.TextSize = 15
	end
	-- Put the tab and the stack where they now belong, with no animation.
	self:SetCollapsed(self.collapsed, true, false)
end

-- `instant` skips the animation (first load, galleries). `save` writes the setting (a click).
function MenuStackToggle:SetCollapsed(collapsed, instant, save)
	collapsed = collapsed == true
	if save and self.settings then
		-- Settings.Changed comes straight back through here with save = false.
		self.settings.Set(MenuStackToggle.SettingId, collapsed)
		if self.settings.Get(MenuStackToggle.SettingId) == collapsed and self.collapsed == collapsed then
			return
		end
	end
	if collapsed == self.collapsed and not instant then
		return
	end
	self.collapsed = collapsed
	self.token += 1
	local token = self.token
	local tab, stack = self.tab, self.stack
	local target = collapsed and COLLAPSED_TAB or EXPANDED_TAB

	if not collapsed then
		-- Opening it is looking at it.
		self.pending = false
	end
	self:_paintDot()
	self:_paintHover()
	self.tuck.Visible = not collapsed
	self.open.Visible = collapsed
	tab.BackgroundColor3 = collapsed and C.Accent or C.Background
	tab.BackgroundTransparency = collapsed and 0 or 0.25
	self.tabStroke.Thickness = collapsed and 2 or 1.5

	local tabPosition, tabSize = self:_tabGoal(target)
	local home, away = self:_stackHome(), self:_stackAway()

	if instant then
		stack.Visible = (not collapsed) and not self.hidden
		stack.Position = home
		stack.GroupTransparency = 0
		tab.Position = tabPosition
		tab.Size = tabSize
		self.tabScale.Scale = self.fit
		return
	end

	if collapsed then
		tween(stack, 0.22, { Position = away, GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.23, function()
			if token == self.token then
				stack.Visible = false
			end
		end)
		tab.Position = tabPosition + UDim2.fromOffset(self.phoneTab and 0 or -20, self.phoneTab and -10 or 0)
		tween(tab, 0.34, { Position = tabPosition, Size = tabSize }, Enum.EasingStyle.Back)
	else
		-- `and not self.hidden`: expanding the stack while the menu is open must not put it back on
		-- top of the panel.
		stack.Visible = not self.hidden
		stack.Position = away
		stack.GroupTransparency = 1
		tween(stack, 0.3, { Position = home, GroupTransparency = 0 })
		tween(tab, 0.3, { Position = tabPosition, Size = tabSize }, Enum.EasingStyle.Back)
	end
	self.tabScale.Scale = 0.9 * self.fit
	tween(self.tabScale, 0.3, { Scale = self.fit }, Enum.EasingStyle.Back)
end

-- What the collapsed tab shows beside the menu icon: "2/3" for today's quests, or "" for nothing.
-- Out of the way while the full menu is open.
--
-- The stack is drawn at a fixed screen position and the menu panel is centred, so on a window
-- narrower than the two together the stack is drawn ON the panel -- Oliver's screenshot has this
-- tab's chevron sitting on top of the BRAINROTS rail tile. It is also redundant there: it exists to
-- REACH the menu, which is already open. The X, the scrim, Backspace and the menu key all still
-- close, so nothing is lost by taking it away.
--
-- Separate from `collapsed` on purpose. That is the player's own choice and it is remembered in
-- Settings; this is temporary and must not overwrite it, which is why SetCollapsed's writes are
-- gated on this flag rather than this sharing them.
function MenuStackToggle:SetHidden(hidden)
	hidden = hidden == true
	if hidden == self.hidden then
		return
	end
	self.hidden = hidden
	self.tab.Visible = not hidden
	self.stack.Visible = (not hidden) and not self.collapsed
end

function MenuStackToggle:SetSummary(text)
	self.summary.Text = text or ""
end

function MenuStackToggle:_paintDot()
	local show = self.collapsed and self.pending
	self.dot.Visible = show
	self.summary.TextColor3 = DARK
end

-- Something new happened. While tucked away, the tab lights up, bumps, and keeps a pulsing dot until
-- the stack is opened again. While the stack is out, it's already on screen, so nothing extra.
function MenuStackToggle:Attention()
	if not self.collapsed then
		return
	end
	self.pending = true
	self:_paintDot()
	self.tabScale.Scale = 1.18 * self.fit
	tween(self.tabScale, 0.45, { Scale = self.fit }, Enum.EasingStyle.Elastic)
	if not self.pulsing then
		self.pulsing = true
		task.spawn(function()
			while self.pending and self.collapsed do
				self.ring.Size = UDim2.fromScale(1, 1)
				self.ringStroke.Transparency = 0.1
				tween(self.ring, 0.9, { Size = UDim2.fromScale(2.6, 2.6) })
				tween(self.ringStroke, 0.9, { Transparency = 1 })
				tween(self.tabStroke, 0.45, { Thickness = 3.5 }).Completed:Wait()
				tween(self.tabStroke, 0.45, { Thickness = 2 }).Completed:Wait()
				task.wait(0.5)
			end
			self.pulsing = false
			self.ringStroke.Transparency = 1
			-- The last beat may have finished after the stack opened: put the outline back to its state's.
			self.tabStroke.Thickness = self.collapsed and 2 or 1.5
		end)
	end
end

return MenuStackToggle
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX174"><Properties><string name="Name">MergeDialog</string><ProtectedString name="Source">-- The merge confirmation card, opened from a brainrot's MERGE button in the Brainrots tab.
--
-- Merging spends copies for good, so nothing is sent until the player has seen exactly what they
-- get: the stars now and after, damage, health and total bonus now and after, how many copies it
-- uses, how many stay, and the sell value those copies would have fetched. The menu makes the
-- server call; this module only draws the card and reports CONFIRM or CANCEL.
--
-- It's a ModuleScript rather than part of MenuClient so tools/merge_gallery.lua can build the
-- real card in edit mode and screenshot it.
--
--   MergeDialog.Open(parent, { def, level, stars, count, onConfirm, instant })
--   MergeDialog.Resolve(ok, message)   the server's answer; success celebrates and closes
--   MergeDialog.Close()
--   MergeDialog.IsOpen()

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BrainrotData = require(Shared:WaitForChild("BrainrotData"))
local BrainrotModels = require(Shared:WaitForChild("BrainrotModels"))
local Rarity = require(Shared:WaitForChild("Rarity"))

local UiKit = require(script.Parent:WaitForChild("UiKit"))

local create, rounded, formatNumber = UiKit.create, UiKit.rounded, UiKit.formatNumber
local C = UiKit.Colors

local MergeDialog = {}

local GOLD = Rarity.Color("Legendary")
local NEW_STAR = Color3.fromRGB(255, 244, 190)
local EMPTY_STAR = Color3.fromRGB(70, 74, 92)

local CARD_WIDTH = 500
local CARD_HEIGHT = 436
-- Stat table columns: label, now, after, change.
local COLUMNS = { { x = 164, w = 70 }, { x = 234, w = 96 }, { x = 330, w = 96 }, { x = 426, w = 54 } }
-- Seconds the "merged" state stays up before the card closes itself. A field so the gallery can
-- hold it open long enough to capture.
MergeDialog.CloseAfterSuccess = 1.1

-- The open card, or nil: { overlay, card, scale, status, confirm, cancel, busy, onConfirm }.
local current = nil
-- Bumped on every open and close, so a delayed close from an older card can't shut a newer one.
local token = 0

local function hex(color)
	return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5))
end

-- Five stars as rich text: earned ones gold, the one this merge adds (if any) brighter, the rest dim.
local function starsText(stars, newStar)
	local parts = {}
	for index = 1, BrainrotData.MaxStars do
		local color = index == newStar and NEW_STAR or index &lt;= stars and GOLD or EMPTY_STAR
		table.insert(parts, string.format('&lt;font color="%s"&gt;★&lt;/font&gt;', hex(color)))
	end
	return table.concat(parts)
end

local function label(parent, props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or C.Text
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.Parent = parent
	return create("TextLabel", props)
end

-- A live 3D portrait, the same model the companion uses (as the inventory cards draw it).
local function photo(parent, def, size)
	local viewport = create("ViewportFrame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
		Ambient = Color3.fromRGB(170, 170, 182),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, 0.6),
		Parent = parent,
	}, { rounded(12) })
	BrainrotModels.Build(def).Parent = viewport
	BrainrotModels.FrameViewport(viewport, def)
	return viewport
end

local function setButton(button, enabled, color, text)
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.BackgroundColor3 = enabled and color or C.PanelAlt
	button.TextColor3 = enabled and Color3.new(0, 0, 0) or C.Muted
	if text then
		button.Text = text
	end
end

function MergeDialog.IsOpen()
	return current ~= nil
end

function MergeDialog.Close()
	token += 1
	if current then
		current.overlay:Destroy()
		current = nil
	end
end

-- Returns the overlay, or nil if this brainrot can't be merged any further.
function MergeDialog.Open(parent, info)
	MergeDialog.Close()

	local def = info.def
	local stars = BrainrotData.ClampStars(info.stars)
	local cost = BrainrotData.MergeCost(stars)
	if not def or not cost then
		return nil
	end
	local level = info.level or 1
	local count = info.count or 1
	local now = BrainrotData.Stats(def, level, stars)
	local after = BrainrotData.Stats(def, level, stars + 1)
	local color = Rarity.Color(def.rarity)

	token += 1
	local myToken = token

	-- A full-screen button so clicks can't reach the menu behind the card. It deliberately does
	-- nothing itself: only CANCEL closes the card, so a click that lands on the card can never be
	-- mistaken for a dismissal.
	local overlay = create("TextButton", {
		Name = "MergeDialog",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 70,
		Parent = parent,
	})

	local card = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(CARD_WIDTH, CARD_HEIGHT),
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		Parent = overlay,
	}, { rounded(16) })
	create("UIStroke", { Color = GOLD, Thickness = 3, Parent = card })
	-- The card is 500x436 and nothing scaled it, so on a 390-tall phone it overflowed the screen and
	-- took CANCEL and MERGE (y 372..416) with it: a player could open a merge and had no way to
	-- confirm it. claude-ee, 2026-09-18, for Oliver's #62.
	--
	-- NOT PhoneLayout.FitPanel, which was the obvious fix and is the wrong one here: FitPanel reuses
	-- the card's existing UIScale, and that scale is the open animation, tweened back to 1 in four
	-- places below. The fit would have been wiped the moment the card animated in and the bug would
	-- have looked fixed in a still render. So the fit is computed once and every one of those four
	-- rest values is expressed in terms of it. `fit` is 1 on any screen with the room.
	local fit = 1
	pcall(function()
		local PhoneLayout = require(script.Parent:WaitForChild("PhoneLayout"))
		local camera = workspace.CurrentCamera
		fit = PhoneLayout.PanelScale(Vector2.new(CARD_WIDTH, CARD_HEIGHT),
			camera and camera.ViewportSize or Vector2.new(1920, 1080), { inset = true })
	end)
	local scale = create("UIScale", { Scale = (info.instant and 1 or 0.85) * fit, Parent = card })

	label(card, { Position = UDim2.fromOffset(20, 16), Size = UDim2.new(1, -40, 0, 16), Text = "MERGE", TextColor3 = GOLD, TextSize = 13 })
	label(card, {
		Position = UDim2.fromOffset(20, 32),
		Size = UDim2.new(1, -40, 0, 34),
		Font = Enum.Font.FredokaOne,
		Text = def.name,
		TextColor3 = color,
		TextSize = 28,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	label(card, {
		Position = UDim2.fromOffset(20, 68),
		Size = UDim2.new(1, -40, 0, 18),
		Text = string.format("%s  •  Lv %d  •  %s  •  you own %d", string.upper(def.rarity), level, now.move, count),
		TextColor3 = C.Muted,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local portrait = photo(card, def, 124)
	portrait.Position = UDim2.fromOffset(20, 96)
	create("UIStroke", { Color = color, Thickness = 2, Parent = portrait })

	-- The before/after table.
	for index, heading in ipairs({ "", "NOW", "AFTER", "" }) do
		label(card, {
			Position = UDim2.fromOffset(COLUMNS[index].x + 8, 96),
			Size = UDim2.fromOffset(COLUMNS[index].w - 8, 18),
			Text = heading,
			TextColor3 = C.Muted,
			TextSize = 12,
		})
	end

	local function percent(stats)
		return math.floor((BrainrotData.LevelBonus(level) * BrainrotData.StarBonus(stats.stars) - 1) * 100 + 0.5)
	end
	local rows = {
		{ "STARS", starsText(stars), starsText(stars + 1, stars + 1), "", true },
		{ "DAMAGE", tostring(now.damage), tostring(after.damage), string.format("+%d", after.damage - now.damage) },
		{ "HEALTH", tostring(now.health), tostring(after.health), string.format("+%d", after.health - now.health) },
		{ "BONUS", string.format("+%d%%", percent(now)), string.format("+%d%%", percent(after)),
			string.format("+%d%%", percent(after) - percent(now)) },
	}
	for rowIndex, row in ipairs(rows) do
		local y = 118 + (rowIndex - 1) * 30
		create("Frame", {
			Position = UDim2.fromOffset(COLUMNS[1].x, y),
			Size = UDim2.fromOffset(CARD_WIDTH - 20 - COLUMNS[1].x, 26),
			BackgroundColor3 = C.Panel,
			BorderSizePixel = 0,
			Parent = card,
		}, { rounded(6) })
		local isStars = row[5] == true
		for column = 1, 4 do
			label(card, {
				Position = UDim2.fromOffset(COLUMNS[column].x + 8, y),
				Size = UDim2.fromOffset(COLUMNS[column].w - 8, 26),
				Text = row[column],
				RichText = isStars and (column == 2 or column == 3),
				TextColor3 = column == 1 and C.Muted or column == 3 and C.Text or column == 4 and C.Green or C.Muted,
				-- ★ draws noticeably smaller than letters at the same size (see the gallery's glyph sheet).
				TextSize = (isStars and column &gt; 1) and 21 or column == 3 and 15 or 13,
			})
		end
	end

	label(card, {
		Position = UDim2.fromOffset(20, 248),
		Size = UDim2.new(1, -40, 0, 34),
		Font = Enum.Font.Gotham,
		Text = "Cooldown, range and move stay the same. Stars belong to you: selling or trading copies later never takes them away.",
		TextColor3 = C.Muted,
		TextSize = 12,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	})

	-- What it costs.
	local costPanel = create("Frame", {
		Position = UDim2.fromOffset(20, 290),
		Size = UDim2.new(1, -40, 0, 48),
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Parent = card,
	}, { rounded(10) })
	label(costPanel, {
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(0.42, -14, 1, 0),
		Text = string.format("USES %d SPARE COP%s", cost, cost == 1 and "Y" or "IES"),
		TextSize = 15,
	})
	-- Two short right-aligned lines rather than one long one that wraps wherever it likes.
	label(costPanel, {
		Position = UDim2.new(0.42, 0, 0, 7),
		Size = UDim2.new(0.58, -14, 0, 16),
		Text = string.format("you keep %d", count - cost),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	label(costPanel, {
		Position = UDim2.new(0.42, 0, 0, 25),
		Size = UDim2.new(0.58, -14, 0, 16),
		Text = string.format("gives up %s coins of sell value", formatNumber(cost * def.coinValue)),
		TextColor3 = C.Muted,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	local status = label(card, {
		Position = UDim2.fromOffset(20, 346),
		Size = UDim2.new(1, -40, 0, 18),
		Text = "",
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local cancel = create("TextButton", {
		Position = UDim2.fromOffset(20, 372),
		Size = UDim2.fromOffset(140, 44),
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "CANCEL",
		TextSize = 15,
		Parent = card,
	}, { rounded(10) })
	setButton(cancel, true, C.PanelAlt)
	cancel.TextColor3 = C.Text

	local confirmText = string.format("MERGE TO %d STAR%s", stars + 1, stars + 1 == 1 and "" or "S")
	local confirm = create("TextButton", {
		Position = UDim2.fromOffset(172, 372),
		Size = UDim2.new(1, -192, 0, 44),
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		Parent = card,
	}, { rounded(10) })
	setButton(confirm, true, GOLD, confirmText)

	current = {
		overlay = overlay,
		card = card,
		scale = scale,
		fit = fit,
		status = status,
		confirm = confirm,
		cancel = cancel,
		confirmText = confirmText,
		busy = false,
		onConfirm = info.onConfirm,
	}
	local mine = current

	cancel.Activated:Connect(function()
		if current == mine and not mine.busy then
			MergeDialog.Close()
		end
	end)
	confirm.Activated:Connect(MergeDialog.Confirm)

	if not info.instant then
		TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = fit }):Play()
		-- Guards against a tween that never plays (the card must never be left small).
		task.delay(0.4, function()
			if token == myToken and scale.Parent then
				scale.Scale = fit
			end
		end)
	end

	return overlay
end

-- What CONFIRM does: lock both buttons and hand over to the menu's onConfirm, once. Also callable
-- directly (the gallery uses it to capture the in-progress and result states).
function MergeDialog.Confirm()
	local mine = current
	if not mine or mine.busy then
		return
	end
	mine.busy = true
	setButton(mine.confirm, false, GOLD, "MERGING...")
	setButton(mine.cancel, false, C.PanelAlt)
	mine.status.Text = ""
	if mine.onConfirm then
		mine.onConfirm()
	end
end

-- The server's answer to the confirm. Success pops the card and closes it; a refusal shows why
-- and hands the buttons back, since nothing was spent.
function MergeDialog.Resolve(ok, message)
	local mine = current
	if not mine or not mine.busy then
		return
	end
	mine.busy = false

	if ok then
		mine.status.Text = message or "Merged!"
		mine.status.TextColor3 = GOLD
		setButton(mine.confirm, false, GOLD, "MERGED!")
		mine.confirm.BackgroundColor3 = GOLD
		mine.confirm.TextColor3 = Color3.new(0, 0, 0)
		mine.scale.Scale = 1.06 * (mine.fit or 1)
		TweenService:Create(mine.scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = mine.fit or 1 }):Play()
		local myToken = token
		task.delay(MergeDialog.CloseAfterSuccess, function()
			if token == myToken and current == mine then
				MergeDialog.Close()
			end
		end)
	else
		mine.status.Text = message or "Couldn't merge that."
		mine.status.TextColor3 = C.Red
		setButton(mine.confirm, true, GOLD, mine.confirmText)
		setButton(mine.cancel, true, C.PanelAlt)
		mine.cancel.TextColor3 = C.Text
	end
end

return MergeDialog
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX175"><Properties><string name="Name">ModeScoreHud</string><ProtectedString name="Source">-- The team-mode scoreline at the top of the screen (Oliver's list #10 and #54).
--
--   Team Deathmatch   each team's progress to 100 eliminations
--   King of the Hill  match time, who has held the hill longest, and by how much
--
-- One readout for both, because they are the same question — who is ahead and by how much — and
-- because two separate HUDs would be two things to keep out of each other's way at the top of the
-- screen. In KOTH the score IS seconds held (GameModes calls it "seconds held", target 250), so
-- "held longest and by how much" is the leading score and the gap, with no extra plumbing.
--
-- It needs no new remote: GameMode already pushes ModeChanged with scores, target, secondsLeft,
-- hillStatus and hillHolder, and the server owns all of it.
--
-- "Sized so it does not get in the way" is the requirement Oliver wrote, so: 420x44 at the top
-- centre, under the match banner, in the slot the storm readout uses in the battle royale — which
-- is inert in a team mode, since there is no storm. It is 4% of a 1080p screen and it is never
-- drawn at all outside the two team modes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local GameModes = require(Shared:WaitForChild("GameModes"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))

local create = UiKit.create
local Role, Type, Space, Radius = UiKit.Role, UiKit.Type, UiKit.Space, UiKit.Radius

local player = Players.LocalPlayer
local modeChanged = Remotes.Event("ModeChanged")
local matchChanged = Remotes.Event("MatchChanged")

local WIDTH, HEIGHT = 420, 44
local BAR_HEIGHT = 8

local gui = create("ScreenGui", {
	Name = "ModeScoreHud",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local root = create("Frame", {
	Name = "Scoreline",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 72),
	Size = UDim2.fromOffset(WIDTH, HEIGHT),
	BackgroundColor3 = Role.Base,
	BackgroundTransparency = 0.25,
	BorderSizePixel = 0,
	Visible = false,
	Parent = gui,
}, { UiKit.rounded(Radius.Card) })
create("UIStroke", { Color = Role.Line, Thickness = 1, Transparency = 0.4, Parent = root })
local scale = create("UIScale", { Parent = root })

-- Left team, centre caption, right team. The two bars grow toward the middle so the gap between
-- them reads as the lead without anyone having to subtract.
local function side(anchorX, align)
	local holder = create("Frame", {
		AnchorPoint = Vector2.new(anchorX, 0),
		Position = UDim2.new(anchorX, anchorX == 0 and Space.MD or -Space.MD, 0, 6),
		Size = UDim2.fromOffset(150, HEIGHT - 12),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local value = UiKit.create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Type.Heading.Font,
		Text = "0",
		TextColor3 = Role.Text,
		TextSize = Type.Heading.Size,
		TextXAlignment = align,
		Size = UDim2.new(1, 0, 0, 20),
		Parent = holder,
	})
	local track = create("Frame", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, BAR_HEIGHT),
		BackgroundColor3 = Role.SurfaceAlt,
		BorderSizePixel = 0,
		Parent = holder,
	}, { UiKit.rounded(Radius.Pill) })
	local fill = create("Frame", {
		AnchorPoint = Vector2.new(anchorX, 0),
		Position = UDim2.fromScale(anchorX, 0),
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Role.Accent,
		BorderSizePixel = 0,
		Parent = track,
	}, { UiKit.rounded(Radius.Pill) })
	return value, fill
end

local leftValue, leftFill = side(0, Enum.TextXAlignment.Left)
local rightValue, rightFill = side(1, Enum.TextXAlignment.Right)

-- Oliver, 2026-09-23: "make it easier to tell what team youre on". Your side is always on the LEFT,
-- in the same green your teammates' outlines use, tagged YOUR TEAM; the other side is on the right in
-- the enemy red. The team names stay in the tags so a callout of "Blue is pushing" still means something.
local FRIEND = Color3.fromRGB(80, 230, 110)
local ENEMY = Color3.fromRGB(232, 92, 92)
-- The tags leave the middle of their row to the objectives line (OBJECTIVES_W, King of the Hill only),
-- and say the team's short name ("YOUR TEAM · EMBER"), which fits beside it.
local OBJECTIVES_W = 110
local function tag(anchorX, align)
	return create("TextLabel", {
		AnchorPoint = Vector2.new(anchorX, 0),
		Position = UDim2.new(anchorX, 0, 1, 3),
		Size = UDim2.fromOffset((WIDTH - OBJECTIVES_W) / 2 - 4, 16),
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = "",
		TextSize = 13,
		TextStrokeTransparency = 0.4,
		TextXAlignment = align,
		Parent = root,
	})
end
local leftTag = tag(0, Enum.TextXAlignment.Left)
local rightTag = tag(1, Enum.TextXAlignment.Right)
local sideStroke = create("Frame", {
	Size = UDim2.new(0, 4, 1, -12),
	Position = UDim2.fromOffset(3, 6),
	BackgroundColor3 = FRIEND,
	BorderSizePixel = 0,
	Parent = root,
}, { UiKit.rounded(Radius.Pill) })

-- Who holds each objective (#86 C37), in the middle of the tags row: "A YOU  B OPEN", each word in its
-- side's colour. The scoreline's lead says who is ahead; this says where to go. It reads the server's
-- own status string (ModeKingOfTheHill.Tick: "A Ember Squad · B open"), the only per-objective state
-- that reaches the client today.
local objectivesLabel = create("TextLabel", {
	Name = "Objectives",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 1, 3),
	Size = UDim2.fromOffset(OBJECTIVES_W, 16),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	RichText = true,
	Text = "",
	TextColor3 = Role.TextMuted,
	TextSize = 12,
	TextStrokeTransparency = 0.4,
	Visible = false,
	Parent = root,
})

local function shortName(index)
	local team = GameModes.Teams[index]
	return team and team.short or string.upper(GameModes.TeamName(index))
end

local function hex(colour)
	return string.format("#%02X%02X%02X", math.floor(colour.R * 255 + 0.5), math.floor(colour.G * 255 + 0.5),
		math.floor(colour.B * 255 + 0.5))
end

-- Each lettered objective's owner from the status string: a team index, false for open, or absent.
local function objectiveOwners(status)
	local owners = {}
	for _, letter in ipairs({ "A", "B" }) do
		local word = string.match(status, "%f[%w]" .. letter .. " (.-) · ") or string.match(status, "%f[%w]" .. letter .. " (.-)$")
		if word == "open" then
			owners[letter] = false
		elseif word == GameModes.TeamName(1) then
			owners[letter] = 1
		elseif word == GameModes.TeamName(2) then
			owners[letter] = 2
		end
	end
	return owners
end

local function objectivesLine(status, mine, friend, enemy)
	if type(status) ~= "string" then
		return ""
	end
	local owners = objectiveOwners(status)
	local parts = {}
	for _, letter in ipairs({ "A", "B" }) do
		local owner = owners[letter]
		if owner ~= nil then
			local word, colour = "OPEN", Role.TextMuted
			if owner and (mine == 1 or mine == 2) then
				word = owner == mine and "YOU" or "FOE"
				colour = owner == mine and friend or enemy
			elseif owner then
				word, colour = shortName(owner), GameModes.TeamColor(owner)
			end
			table.insert(parts, string.format('%s &lt;font color="%s"&gt;%s&lt;/font&gt;', letter, hex(colour), word))
		end
	end
	return table.concat(parts, "  ")
end

local function myTeam()
	local character = player.Character
	return character and character:GetAttribute("Team")
end

local caption = create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(120, HEIGHT),
	BackgroundTransparency = 1,
	Font = Type.Label.Font,
	Text = "",
	TextColor3 = Role.TextMuted,
	TextSize = Type.Label.Size,
	Parent = root,
})

local function clock(seconds)
	seconds = math.max(math.floor(seconds or 0), 0)
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- A phone gets the same readout a little smaller, and never wider than the screen it is on. The
-- rest of the phone HUD is PhoneLayout's map; this is one element placing itself inside it.
--
-- WHICH HUD is PhoneLayout.Mode's call, not UiKit.form's (#80). The two disagree on purpose (see the
-- long note in PhoneLayout.lua): a tablet held upright is "large" to UiKit.form and "upright" to the
-- HUD, so this drew at its DESKTOP spot over the upright HUD; and a small desktop window is "short" to
-- UiKit.form but keeps the desktop HUD, so this went into a phone slot the desktop HUD doesn't use.
local function fit()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	local layout = script.Parent:FindFirstChild("PhoneLayout")
	local ok, PhoneLayout = pcall(require, layout)
	local spots = ok and type(PhoneLayout) == "table" and PhoneLayout.Active(viewport) and PhoneLayout.Rects(viewport) or nil
	-- The banner's slot, as on a desktop screen: this is up exactly while HudClient hides the
	-- players-alive banner (in a team match), so the slot is empty. The storm line's band, which this
	-- used before, is 18 px tall; the scoreline at 0.8 is 35, and hung over the coin chip and the event
	-- pill below it.
	local band = spots and spots.banner
	if not band then
		-- Measured against every other HUD cluster at 1920x1080, 1366x768, 1280x720 and 1024x768:
		-- zero overlaps in the storm readout's slot, which no team mode uses.
		scale.Scale = 1
		root.AnchorPoint = Vector2.new(0.5, 0)
		-- The top slot: HudClient hides the players-alive banner in team modes, so the score bar sits
		-- there and clears the compass below it (it used to overlap the compass at y 100).
		root.Position = UDim2.new(0.5, 0, 0, 10)
	else
		-- Scaled to fit the slot both ways, centred in it.
		scale.Scale = math.min(band.w / WIDTH, band.h / HEIGHT, 1)
		root.AnchorPoint = Vector2.new(0.5, 0)
		root.Position = UDim2.new(0, band.x + band.w / 2, 0, band.y)
	end
end

-- Oliver's #104: "the tdm hud at the top stays after the game". `state.scores ~= nil` below is
-- this HUD's only hide predicate, and nothing on the server ever sends a scores=nil push when a
-- team match ends -- GameMode.stopWorld (ServerScriptService/Modules/GameMode.lua, Match-flow's
-- file) tears down every other piece of server state and fires no client signal at all, so the
-- last real score just sits here forever: through the results screen, into the lobby, and into
-- whatever match comes next if it isn't a team mode (which raises no ModeChanged of its own).
-- Rather than depend on the server remembering to fire a hide event on every teardown path, this
-- also hides itself the moment the match itself isn't InProgress. MatchChanged already fires
-- reliably on every state change -- 27 other sites in HudClient key off the same field the same
-- way -- so this is ONE predicate that covers every path, not one that has to be threaded through
-- each of them.
local inProgress = false
-- The mode the CURRENT match is (MatchChanged carries it). A scoreline cached from an earlier team match
-- used to come back when the next match was a battle royale: `lastState` below is only replaced by a
-- ModeChanged push, which a battle royale never sends, so the loadout arriving re-rendered the old
-- TDM score (Oliver's 17:10 screenshot: 84-77 FIRST TO 100 over a battle royale's storm and ALIVE bar).
local currentMode = nil
local forgetScores -- set below, once lastState exists
matchChanged.OnClientEvent:Connect(function(state)
	inProgress = state ~= nil and state.state == "InProgress"
	local mode = state and state.mode or nil
	if mode ~= currentMode then
		currentMode = mode
		-- Only a switch to a mode with no scoreline drops the cache: a team match's first ModeChanged can
		-- arrive before this, and render() already refuses a cached push from a different mode.
		if (mode == nil or mode == "BattleRoyale") and forgetScores then
			forgetScores()
		end
	end
	if not inProgress or currentMode == nil or currentMode == "BattleRoyale" then
		root.Visible = false
	end
end)

local function render(state)
	local teams = inProgress and state and state.scores ~= nil and currentMode ~= nil and currentMode ~= "BattleRoyale"
		and (state.mode == nil or state.mode == currentMode)
	if not teams then
		root.Visible = false
		return
	end

	local scores = state.scores or { 0, 0 }
	local target = math.max(state.target or 1, 1)
	local koth = state.hillHolder ~= nil or state.hillStatus ~= nil

	-- Mine on the left. Before the server has given me a side, fall back to team 1 on the left in the
	-- teams' own colours, as it always was.
	local mine = myTeam()
	local left = mine == 2 and 2 or 1
	local right = left == 1 and 2 or 1
	local known = mine == 1 or mine == 2
	local leftColour = known and FRIEND or GameModes.TeamColor(left)
	local rightColour = known and ENEMY or GameModes.TeamColor(right)
	leftValue.Text = tostring(scores[left] or 0)
	rightValue.Text = tostring(scores[right] or 0)
	leftValue.TextColor3 = leftColour
	rightValue.TextColor3 = rightColour
	leftFill.BackgroundColor3 = leftColour
	rightFill.BackgroundColor3 = rightColour
	leftFill.Size = UDim2.fromScale(math.clamp((scores[left] or 0) / target, 0, 1), 1)
	rightFill.Size = UDim2.fromScale(math.clamp((scores[right] or 0) / target, 0, 1), 1)
	sideStroke.Visible = known
	leftTag.Visible, rightTag.Visible = known, known
	if known then
		leftTag.Text = "YOUR TEAM · " .. shortName(left)
		leftTag.TextColor3 = FRIEND
		rightTag.Text = "ENEMY · " .. shortName(right)
		rightTag.TextColor3 = ENEMY
	end

	objectivesLabel.Text = koth and objectivesLine(state.hillStatus, mine, FRIEND, ENEMY) or ""
	objectivesLabel.Visible = objectivesLabel.Text ~= ""

	if koth then
		-- "Who has held it longest and by how much", said as a gap rather than two numbers to
		-- subtract. The clock is what a player checks first, so it is the biggest thing here.
		local lead = math.abs((scores[1] or 0) - (scores[2] or 0))
		local leader = (scores[1] or 0) == (scores[2] or 0) and nil or ((scores[1] or 0) &gt; (scores[2] or 0) and 1 or 2)
		caption.Text = clock(state.secondsLeft)
		if leader then
			if known then
				caption.Text = clock(state.secondsLeft) .. "\n" .. (leader == mine and "YOU" or "ENEMY") .. " +" .. lead
				caption.TextColor3 = leader == mine and FRIEND or ENEMY
			else
				caption.Text = clock(state.secondsLeft) .. "\n" .. GameModes.TeamName(leader) .. " +" .. lead
				caption.TextColor3 = GameModes.TeamColor(leader)
			end
		else
			-- "TIED", not "level", which read as a rank word rather than a draw (#86).
			caption.Text = clock(state.secondsLeft) .. "\nTIED"
			caption.TextColor3 = Role.TextMuted
		end
	else
		-- The time limit too: the server sends secondsLeft on every push, and without it a TDM match
		-- simply flipped to MATCH OVER mid-fight and a losing team never knew how long it had (#86).
		-- Red for the last thirty seconds.
		local left = state.secondsLeft
		caption.Text = left and ("FIRST TO " .. target .. "\n" .. clock(left)) or ("FIRST TO " .. target)
		caption.TextColor3 = (left and left &lt;= 30) and Role.Negative or Role.TextMuted
	end
	caption.RichText = false
	caption.TextWrapped = true

	root.Visible = true
	fit()
end

-- Same test the HUD makes, from the same remote: no loadout during a live match means this player
-- is not in it -- they joined late, or were eliminated and are watching. A team scoreline for a
-- match you are not playing is what Oliver saw stay up after the game (#104). This script has no
-- access to HudClient's `loadout`, and it does not need one: LoadoutChanged is a client remote and
-- any client script may listen, so this reads the same authority rather than inventing a signal.
--
-- The last state is cached because the two signals are independent and either can arrive first.
-- Hiding on the nil push alone is not enough: when the non-nil push arrives at spawn there may be
-- no further ModeChanged for a long time -- on TDM the next one is the first KILL, on KOTH the
-- first hill tick -- so the scoreline would stay blank for the opening seconds of the match, and a
-- player spawning into a game already at 3-1 would see nothing until someone scored again.
local inMatch = false
local lastState = nil
function forgetScores()
	lastState = nil
	root.Visible = false
end

Remotes.Event("LoadoutChanged").OnClientEvent:Connect(function(newLoadout)
	local joined = newLoadout ~= nil
	if joined == inMatch then
		return
	end
	inMatch = joined
	if not inMatch then
		root.Visible = false
	elseif lastState then
		render(lastState)
	end
end)

modeChanged.OnClientEvent:Connect(function(state)
	lastState = state
	if not inMatch then
		root.Visible = false
		return
	end
	render(state)
end)

-- My side arriving (or changing on a respawn) re-draws the scoreline the right way round.
local function watchMine(character)
	character:GetAttributeChangedSignal("Team"):Connect(function()
		if lastState and inMatch then
			render(lastState)
		end
	end)
	if lastState and inMatch then
		render(lastState)
	end
end
player.CharacterAdded:Connect(watchMine)
if player.Character then
	watchMine(player.Character)
end

local camera = workspace.CurrentCamera
if camera then
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
end
fit()
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX176"><Properties><string name="Name">MovementClient</string><ProtectedString name="Source">-- The local player's movement: stamina, the slide, ledge climbing and vaulting, keeping a launch's
-- speed through the air, the Bounce Boots' double jump and the Rot Glider — plus the slide / climb /
-- vault poses on everyone's bodies. Tuning is in Shared/MovementConfig; ledges and paths come from
-- Shared/Parkour; MovementState is the table CombatClient (sprint and slide keys, the gun dip) and
-- HudClient (the stamina bar) read.
--
-- The character is simulated on this client, so moves run here and the server is told:
--   * Stamina is predicted here with the server's own numbers and corrected by StaminaSync. The
--     server's ledger is the real one: it takes the sprint factor off when you're exhausted and
--     refuses slides and vaults you can't pay for, whatever this script thinks.
--   * A slide asks the server (Slide), which puts a speed CEILING on (Slide.PeakMultiplier). This
--     script shapes the real speed under it each frame through the humanoid's move vector — a burst
--     that bleeds off, faster downhill, steerable — and says when it's over (SlideEnd).
--   * A climb or vault is a path from Parkour.Find: the root follows it with its velocity held at zero,
--     then leaves with the plan's exit velocity. The server is told (Parkour) to charge stamina and to
--     pose the body for everyone else.
--   * Launches (Launch) from a Rot Rocket, Launch Pad or Blink Bean keep their horizontal speed until
--     you land, instead of the humanoid's air control braking them to walking pace; you can steer and
--     pull back. A launch with no kind (the geyser) is applied exactly as it always was.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemData = require(Shared:WaitForChild("ItemData"))
local CrouchAnimation = require(Shared:WaitForChild("CrouchAnimation"))
local MatchConfig = require(Shared:WaitForChild("MatchConfig"))
local MovementConfig = require(Shared:WaitForChild("MovementConfig"))
local Parkour = require(Shared:WaitForChild("Parkour"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local SafeValue = require(Shared:WaitForChild("SafeValue"))

local MovementState = require(script.Parent:WaitForChild("MovementState"))
local Settings = require(script.Parent:WaitForChild("Settings"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local STAMINA = MovementConfig.Stamina
local SLIDE = MovementConfig.Slide
local AIR = MovementConfig.AirMomentum
local CROUCH = MovementConfig.Crouch
local PARKOUR = MovementConfig.Parkour

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local slideRemote = Remotes.Event("Slide")
local slideEndRemote = Remotes.Event("SlideEnd")
local parkourRemote = Remotes.Event("Parkour")
local staminaSync = Remotes.Event("StaminaSync")
local crouchRemote = Remotes.Event("SetCrouching")

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

--------------------------------------------------------------------------------
-- Context: the character, and whether a match is on for us
--------------------------------------------------------------------------------

local character, humanoid, root = nil, nil, nil
-- The slide and the climb or vault under way, and the slide's ender. Declared up here because the
-- launch handler, above their own sections, cancels them.
local slide = nil
local active = nil
local endSlide
-- Crouch's setter, declared here because the slide's ending and the climb/vault transitions above its
-- own section use it.
local setCrouching
-- How tall the body is right now. Crouching and sliding BOTH lower it, so one function owns the write
-- and the slide's start and end — which are above the crouch's own section — call it too.
local applyBodyHeight
local matchState = "Waiting"
local hasLoadout = false
local loadout = nil
local rangeActive = false

local function alive()
	return humanoid ~= nil and root ~= nil and humanoid.Health &gt; 0 and root.Parent ~= nil
end

-- Stamina, climbing and vaulting are for matches: in the lobby the bar hides and sprint is free.
local function inMatch()
	return matchState == "InProgress" and hasLoadout and not rangeActive
end

Remotes.Event("MatchChanged").OnClientEvent:Connect(function(state)
	if type(state) == "table" and type(state.state) == "string" then
		matchState = state.state
	end
end)
Remotes.Event("LoadoutChanged").OnClientEvent:Connect(function(newLoadout)
	loadout = type(newLoadout) == "table" and newLoadout or nil
	hasLoadout = loadout ~= nil
end)
Remotes.Event("RangeState").OnClientEvent:Connect(function(on)
	rangeActive = on == true
end)

-- The player module's move vector, for steering a slide (A/D) while this script holds the move.
local controls = nil
task.spawn(function()
	local ok, module = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 20))
	end)
	if ok and module and module.GetControls then
		controls = module:GetControls()
	end
end)

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.RespectCanCollide = true
groundParams.IgnoreWater = true

local function groundHit(distance)
	groundParams.FilterDescendantsInstances = { character }
	local reach = humanoid.HipHeight + root.Size.Y / 2 + (distance or 1.5)
	return workspace:Raycast(root.Position, Vector3.new(0, -reach, 0), groundParams)
end

--------------------------------------------------------------------------------
-- Stamina (predicted)
--------------------------------------------------------------------------------

local lastSpend = 0

-- Running out of stamina makes no sound: the bar already says it, in red, pulsing, with a tick at the
-- line where sprinting comes back. A noise on top of that was just nagging.
local function setExhausted(value)
	MovementState._SetExhausted(value)
end

-- Mirrors MatchService.SpendStamina, so the HUD bites at once and a refused move isn't attempted.
local function predictSpend(amount, allowDebt)
	if not inMatch() or MovementState.rush or amount &lt;= 0 then
		return true
	end
	if not allowDebt and (MovementState.exhausted or MovementState.stamina &lt; amount) then
		return false
	end
	MovementState.stamina = math.max(MovementState.stamina - amount, 0)
	lastSpend = os.clock()
	if MovementState.stamina &lt;= 0 then
		setExhausted(true)
	end
	return true
end

staminaSync.OnClientEvent:Connect(function(value, exhausted, rush)
	if not SafeValue.Number(value, 1000) then
		return
	end
	MovementState.rush = rush == true
	-- Small differences are latency (the server sampled a moment ago): ease toward it. Big ones are
	-- a real disagreement: take the server's number.
	local difference = value - MovementState.stamina
	if math.abs(difference) &gt; 6 then
		MovementState.stamina = value
	else
		MovementState.stamina += difference * 0.5
	end
	-- The server's exhaustion always wins (it has already taken the sprint off). Its "not exhausted" only
	-- overrides ours once it has really recovered, or clearly has more than we think: right at zero the
	-- two sides cross a few frames apart, and flipping on every sync would flicker the sprint.
	if exhausted == true then
		setExhausted(true)
	elseif MovementState.exhausted and (value &gt;= STAMINA.ExhaustedUntil or value &gt; MovementState.stamina + 6) then
		setExhausted(false)
	end
end)

local function stepStamina(dt)
	local now = os.clock()
	if not inMatch() or MovementState.rush then
		MovementState.stamina = STAMINA.Max
		MovementState.draining = false
		setExhausted(false)
		return
	end
	local draining = false
	-- Only running on the ground drains, as on the server: not a seat, not a flight through the air.
	if MovementState.sprinting and not MovementState.exhausted and alive() and not humanoid.Sit
		and humanoid.FloorMaterial ~= Enum.Material.Air then
		draining = flat(root.AssemblyLinearVelocity).Magnitude &gt; STAMINA.MovingSpeed
	end
	MovementState.draining = draining
	if draining then
		MovementState.stamina = math.max(MovementState.stamina - STAMINA.SprintDrainPerSecond * dt, 0)
		lastSpend = now
		if MovementState.stamina &lt;= 0 then
			setExhausted(true)
		end
	elseif now - lastSpend &gt;= (MovementState.exhausted and STAMINA.ExhaustedRegenDelay or STAMINA.RegenDelay) then
		MovementState.stamina = math.min(MovementState.stamina + STAMINA.RegenPerSecond * dt, STAMINA.Max)
		if MovementState.exhausted and MovementState.stamina &gt;= STAMINA.ExhaustedUntil then
			setExhausted(false)
		end
	end
end

--------------------------------------------------------------------------------
-- Air momentum
--------------------------------------------------------------------------------

-- { velocity = flat Vector3, floor = speed it ends under, started, slowFrames }
local carry = nil

local function startCarry(velocity, floorSpeed)
	local horizontal = flat(velocity)
	local floor = (floorSpeed or (humanoid and humanoid.WalkSpeed or 18)) + AIR.MinExcess
	if horizontal.Magnitude &lt;= floor then
		carry = nil
		return
	end
	carry = { velocity = horizontal, floor = floor, started = os.clock(), slowFrames = 0 }
end

local function stepCarry(dt, busy)
	if not carry then
		return
	end
	local now = os.clock()
	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	if busy or not alive() or humanoid.Sit or humanoid:GetState() == Enum.HumanoidStateType.Swimming
		or (grounded and now - carry.started &gt; 0.12) then
		carry = nil
		return
	end
	-- Ran into something: physics has already stopped us, so stop pushing.
	local actual = flat(root.AssemblyLinearVelocity)
	if now - carry.started &gt; 0.1 and actual.Magnitude &lt; carry.velocity.Magnitude * 0.35 then
		carry.slowFrames += 1
		if carry.slowFrames &gt;= 3 then
			carry = nil
			return
		end
	else
		carry.slowFrames = 0
	end

	local m = carry.velocity
	local speed = m.Magnitude
	local input = flat(humanoid.MoveDirection)
	if input.Magnitude &gt; 0.1 and speed &gt; 0 then
		input = input.Unit
		local heading = m.Unit
		if heading:Dot(input) &lt; -0.2 then
			speed = math.max(speed - AIR.Brake * dt, 0)
		else
			local angle = math.acos(math.clamp(heading:Dot(input), -1, 1))
			if angle &gt; 1e-3 then
				local blended = heading:Lerp(input, math.min(1, math.rad(AIR.TurnRate) * dt / angle))
				if blended.Magnitude &gt; 1e-3 then
					heading = blended.Unit
				end
			end
		end
		m = heading * speed
	end
	m *= math.max(1 - AIR.Drag * dt, 0)
	if m.Magnitude &lt; carry.floor then
		carry = nil
		return
	end
	carry.velocity = m
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(m.X, velocity.Y, m.Z)
end

--------------------------------------------------------------------------------
-- Glider (the Rot Glider and the match drop-in)
--------------------------------------------------------------------------------

-- While it lasts, falling is capped to a gentle drift; the canopy over your head is added by the
-- server so everyone sees it.
local GLIDE_FALL_SPEED = 8
-- What a canopy sails at if the server's number ever fails its check. Never 0: that lands in the branch
-- that only caps the fall, which is the one nobody had tested.
local GLIDE_FORWARD = 34
local glideUntil = 0
local glideFallSpeed = GLIDE_FALL_SPEED
-- How fast the glider carries you forward, the way the camera looks: it's a glider, not a
-- parachute, so you cover ground with it. Steer by looking.
local glideForward = 0
-- Set once the glide has actually had air under it, so touching down ends it — but a glider
-- popped while still standing on the ground isn't cancelled before it's done anything.
local glideAirborne = false
-- The wing's own horizontal velocity. Written in full every frame: blending from the body's velocity
-- each frame let the humanoid's air control brake it back down (a glider opened 80 up with no key
-- held sailed 4 studs, measured by tools/movement_probe.lua).
local glideVelocity = nil

local function gliding()
	return os.clock() &lt;= glideUntil
end

-- The match drop-in uses the same canopy with a faster fall, so it ends in seconds, not a minute.
-- `lift`: a Rot Glider opened near the ground throws you up on an updraft first.
-- `mode` "steer" (the match drop-in): sail only where you push, at up to `forward`, and straight down with
-- nothing held, so looking around never carries you off the spot you picked on the drop map. The Rot
-- Glider sails where you look on its own.
local glideSteered = false
-- When the last Glide event arrived, so a character swap moments later can tell "this glide is for the
-- body that just appeared" from "this glide belonged to the old body".
local glideStartedAt = -math.huge
-- Frames since the glide opened, and consecutive frames reporting a floor. A drop-in fires as the server
-- teleports the body to drop height, so for a frame or two the client can still report the floor it left:
-- one grounded frame must not read as a landing.
local glideFrames = 0
local glideGroundedFrames = 0
-- TEMPORARY, for Oliver's live check of the drop-in: prints the first frames of a glide to the client
-- console (F9). Remove once the drop is confirmed good.
local GLIDE_TRACE = true

Remotes.Event("Glide").OnClientEvent:Connect(function(duration, fallSpeed, forward, lift, mode)
	if not SafeValue.Number(duration, 1000) then
		return
	end
	glideStartedAt = os.clock()
	glideFrames = 0
	glideGroundedFrames = 0
	glideUntil = os.clock() + math.clamp(duration, 0, 30)
	glideFallSpeed = SafeValue.Number(fallSpeed, 1000) and math.clamp(fallSpeed, 4, 60) or GLIDE_FALL_SPEED
	glideForward = SafeValue.Number(forward, 1000) and math.clamp(forward, 0, 80) or GLIDE_FORWARD
	glideSteered = mode == "steer"
	glideAirborne = false
	glideVelocity = nil
	carry = nil
	if SafeValue.Number(lift, 1000) and lift &gt; 0 and alive() then
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(velocity.X, math.clamp(lift, 0, 200), velocity.Z)
		Sfx.Play("LaunchWhoosh", 0.1, 0.85)
	end
end)

local function stepGlide(dt)
	if not gliding() or not alive() then
		return
	end
	glideFrames += 1
	local inAir = humanoid.FloorMaterial == Enum.Material.Air
	if GLIDE_TRACE and glideFrames &lt;= 10 then
		print(string.format("[Glide] frame %d floor=%s airborne=%s y=%.1f vy=%.1f cap=%.0f forward=%.0f",
			glideFrames, humanoid.FloorMaterial.Name, tostring(glideAirborne), root.Position.Y,
			root.AssemblyLinearVelocity.Y, glideFallSpeed, glideForward))
	end
	if inAir then
		glideAirborne = true
		glideGroundedFrames = 0
	elseif glideAirborne then
		-- Only a real landing ends it: several frames in a row on a floor, and never in the first moments
		-- of a drop, when the body may still be reported at the pad it was teleported from.
		glideGroundedFrames += 1
		if glideGroundedFrames &gt;= 3 and os.clock() - glideStartedAt &gt; 0.4 then
			glideUntil = 0
			return
		end
	end
	local velocity = root.AssemblyLinearVelocity
	-- The canopy caps how fast you fall: never faster than glideFallSpeed downward. This took math.min
	-- of the two, which is the FASTER of them, so anyone already falling faster than the canopy's speed
	-- had their own fall speed written straight back and dropped like a stone — everyone on the drop-in,
	-- who is doing well over it by the time the canopy opens.
	local fall = math.max(velocity.Y, -glideFallSpeed)
	if glideAirborne and glideForward &gt; 0 then
		-- Sail forward where the camera points (or, steered, where you push), easing toward it so turns
		-- feel like banking.
		local look = camera.CFrame.LookVector
		local heading = Vector3.new(look.X, 0, look.Z)
		heading = heading.Magnitude &gt; 0.05 and heading.Unit or flat(root.CFrame.LookVector).Unit
		local wanted = heading * glideForward
		if glideSteered then
			local push = flat(humanoid.MoveDirection)
			if push.Magnitude &gt; 0.1 then
				heading = push.Unit
				wanted = heading * glideForward * math.min(push.Magnitude, 1)
			else
				wanted = Vector3.zero
			end
		end
		glideVelocity = (glideVelocity or flat(velocity)):Lerp(wanted, math.clamp(dt * 2.5, 0, 1))
		-- `fall` is the cap, worked out once above: the sailing branch wrote the same rule out a
		-- second time, and two copies of a rule are how the first one came to be inverted.
		root.AssemblyLinearVelocity = Vector3.new(glideVelocity.X, fall, glideVelocity.Z)
		-- Face the way you're sailing.
		if heading.Magnitude &gt; 0.05 and wanted.Magnitude &gt; 0 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + heading)
		end
	elseif velocity.Y &lt; -glideFallSpeed then
		root.AssemblyLinearVelocity = Vector3.new(velocity.X, fall, velocity.Z)
	end
end

--------------------------------------------------------------------------------
-- Launches (Rot Rocket, Launch Pad, Blink Bean, the geyser)
--------------------------------------------------------------------------------

-- A rocket keeps its launch speed but takes its direction from the camera: looking up raises the
-- climb angle (higher, shorter), looking down flattens it (lower, about as far).
local ROCKET_MIN_ANGLE, ROCKET_MAX_ANGLE, ROCKET_PITCH_SHARE = 30, 76, 0.55

local function aimRocket(velocity)
	local speed = velocity.Magnitude
	local horizontal = flat(velocity)
	local baseAngle = math.deg(math.atan2(velocity.Y, math.max(horizontal.Magnitude, 1e-3)))
	local look = camera.CFrame.LookVector
	local pitch = math.deg(math.asin(math.clamp(look.Y, -1, 1)))
	local angle = math.rad(math.clamp(baseAngle + pitch * ROCKET_PITCH_SHARE, ROCKET_MIN_ANGLE, ROCKET_MAX_ANGLE))
	local heading = flat(look)
	heading = heading.Magnitude &gt; 0.05 and heading.Unit or (horizontal.Magnitude &gt; 0.05 and horizontal.Unit or flat(root.CFrame.LookVector).Unit)
	return heading * speed * math.cos(angle) + Vector3.new(0, speed * math.sin(angle), 0)
end

Remotes.Event("Launch").OnClientEvent:Connect(function(velocity, kind)
	if not SafeValue.Vector3(velocity, 2000) or not alive() then
		return
	end
	if kind == "blast" then
		-- An explosion's knockback: capped, it throws you out of a climb or slide, and keeps its speed
		-- through the air like any other launch.
		local horizontal = flat(velocity)
		if horizontal.Magnitude &gt; 60 then
			horizontal = horizontal.Unit * 60
		end
		velocity = horizontal + Vector3.new(0, math.clamp(velocity.Y, -40, 70), 0)
		active = nil
		if slide then
			endSlide(false)
		end
		MovementState.move = nil
		-- Entering Jumping would raise a small knock-up to a full jump (the humanoid applies its own jump
		-- speed over anything slower), so a weak blast only leaves the ground in Freefall.
		local jumpSpeed = humanoid.UseJumpPower and humanoid.JumpPower or math.sqrt(2 * workspace.Gravity * humanoid.JumpHeight)
		humanoid:ChangeState(velocity.Y &gt;= jumpSpeed and Enum.HumanoidStateType.Jumping or Enum.HumanoidStateType.Freefall)
		root.AssemblyLinearVelocity = velocity
		startCarry(velocity)
		return
	end
	if kind == "blink" then
		-- Out of the dash at speed, with any fall cancelled.
		root.AssemblyLinearVelocity = flat(velocity)
		startCarry(velocity)
		Sfx.Play("LaunchWhoosh", 0.1, 1.35)
		return
	end
	if kind == "rocket" then
		velocity = aimRocket(velocity)
	elseif kind == "pad" then
		-- Thrown along the way you're running, if you are.
		local run = flat(humanoid.MoveDirection)
		if run.Magnitude &gt; 0.1 then
			velocity = run.Unit * flat(velocity).Magnitude + Vector3.new(0, velocity.Y, 0)
		end
	end
	-- Entering the jumping state first stops the humanoid's ground friction eating the launch on the
	-- first frame.
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	root.AssemblyLinearVelocity = velocity
	if kind == "rocket" or kind == "pad" then
		startCarry(velocity)
		Sfx.Play("LaunchWhoosh", 0.1)
	else
		Sfx.Play("Pickup", 0.2)
	end
end)

--------------------------------------------------------------------------------
-- Jump input
--------------------------------------------------------------------------------

local lastJumpRequest = 0
-- A fresh press (not a held key repeating), for the double jump and the slide-jump.
local pressedAt = 0

-- The keys are read directly rather than from InputBegan's `processed` flag: the default controls bind
-- Space and ButtonA through ContextActionService, which marks them processed, so filtering on it would
-- ignore every jump. Typing in a text box (chat) doesn't count.
-- The touch jump button has no key, so its held state is read from the player module, the same way
-- the module itself decides humanoid.Jump each frame.
local function controlsJumping()
	if not controls then
		return false
	end
	local ok, jumping = pcall(function()
		local activeController = controls:GetActiveController()
		if activeController and activeController:GetIsJumping() then
			return true
		end
		local touchJump = controls.touchJumpController
		return touchJump ~= nil and touchJump:GetIsJumping()
	end)
	return ok and jumping == true
end

local function jumpKeyDown()
	if UserInputService:GetFocusedTextBox() then
		return false
	end
	return UserInputService:IsKeyDown(Enum.KeyCode.Space)
		or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA)
		or controlsJumping()
end

UserInputService.InputBegan:Connect(function(input)
	if (input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA) and not UserInputService:GetFocusedTextBox() then
		pressedAt = os.clock()
	end
end)
-- JumpRequest covers the touch jump button, which has no key to watch.
UserInputService.JumpRequest:Connect(function()
	local now = os.clock()
	if not jumpKeyDown() and now - lastJumpRequest &gt; 0.3 then
		pressedAt = now
	end
	lastJumpRequest = now
end)

local function wantsJump(now)
	return jumpKeyDown() or now - lastJumpRequest &lt; 0.2
end

--------------------------------------------------------------------------------
-- Slide
--------------------------------------------------------------------------------

-- `slide` (declared at the top): { dir, speed, started, runSpeed, airSince, slowFrames, jumpPressedBefore }
local slideReadyAt = 0

function endSlide(jumped)
	local ended = slide
	if not ended then
		return
	end
	slide = nil
	slideReadyAt = os.clock() + SLIDE.Cooldown
	slideEndRemote:FireServer()
	if MovementState.move == "slide" then
		MovementState.move = nil
	end
	applyBodyHeight()
	if jumped and alive() then
		-- Slide-jump: whatever speed the slide had carries through the air.
		local speed = math.max(flat(root.AssemblyLinearVelocity).Magnitude, math.min(ended.speed, humanoid.WalkSpeed))
		startCarry(ended.dir * speed, ended.runSpeed)
	elseif MovementState.crouchHeld and alive() then
		-- Still holding crouch as the slide runs out: settle into the crouch rather than standing up.
		setCrouching(true)
	end
end

-- Starts a slide if everything allows one, and says whether it did. The caller is the CROUCH key
-- (crouchPressed): the slide has no control of its own, so a `false` here becomes a plain crouch and the
-- press is never swallowed.
local function tryStartSlide()
	if slide or MovementState.move or not alive() then
		return false
	end
	local now = os.clock()
	if now &lt; slideReadyAt or not MovementState.sprinting then
		return false
	end
	if humanoid.FloorMaterial == Enum.Material.Air or humanoid.Sit then
		return false
	end
	local velocity = flat(root.AssemblyLinearVelocity)
	local runSpeed = humanoid.WalkSpeed
	if velocity.Magnitude &lt; SLIDE.MinEntryFraction * runSpeed then
		return false
	end
	local floor = groundHit()
	if floor and Parkour.IsExcluded(floor.Instance) then
		return false
	end
	-- Everything but stamina says yes: flash the bar so the refusal reads. You still crouch.
	if not predictSpend(STAMINA.SlideCost, false) then
		MovementState.refusedAt = now
		return false
	end
	slideRemote:FireServer()
	slide = {
		dir = velocity.Unit,
		speed = math.max(velocity.Magnitude, runSpeed) * SLIDE.StartMultiplier,
		started = now,
		runSpeed = runSpeed,
		airSince = nil,
		slowFrames = 0,
		jumpPressedBefore = pressedAt,
	}
	MovementState.move = "slide"
	carry = nil
	-- A slide lowers the body exactly as a crouch does, so you can take one under a gap you couldn't
	-- walk through. The server does the same in MatchService.updateHeight.
	applyBodyHeight()
	Sfx.Play("SlideStart", 0.08)
	return true
end

-- The public request still works (MovementState.RequestSlide), though nothing calls it now that the
-- slide is the crouch key.
MovementState.SlideRequested:Connect(tryStartSlide)

local function stepSlide(dt)
	if not slide then
		return
	end
	if not alive() then
		endSlide(false)
		return
	end
	local now = os.clock()
	local elapsed = now - slide.started
	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	if grounded then
		slide.airSince = nil
	elseif not slide.airSince then
		slide.airSince = now
	end

	-- Downhill feeds it, uphill eats it: the ground normal leans the way the ground falls away.
	local ground = grounded and groundHit()
	if ground then
		slide.speed += SLIDE.SlopeGain * workspace.Gravity * flat(ground.Normal):Dot(slide.dir) * dt
	end
	slide.speed = SLIDE.FloorSpeed + (slide.speed - SLIDE.FloorSpeed) * math.exp(-SLIDE.Friction * dt)

	-- A/D bends it.
	local move = controls and controls:GetMoveVector() or Vector3.zero
	if math.abs(move.X) &gt; 0.1 then
		slide.dir = CFrame.Angles(0, -move.X * math.rad(SLIDE.TurnRate) * dt, 0):VectorToWorldSpace(slide.dir)
	end

	-- Stopped by something in the way.
	local actual = flat(root.AssemblyLinearVelocity):Dot(slide.dir)
	if elapsed &gt; 0.2 and actual &lt; 0.35 * math.min(slide.speed, humanoid.WalkSpeed) then
		slide.slowFrames += 1
	else
		slide.slowFrames = 0
	end

	local jumped = pressedAt &gt; slide.jumpPressedBefore or humanoid:GetState() == Enum.HumanoidStateType.Jumping
	if jumped or slide.speed &lt; SLIDE.EndSpeed or elapsed &gt; SLIDE.MaxTime or slide.slowFrames &gt;= 4
		or (slide.airSince and now - slide.airSince &gt; SLIDE.AirGrace) then
		endSlide(jumped)
	end
end

--------------------------------------------------------------------------------
-- Climbing and vaulting
--------------------------------------------------------------------------------

-- `active` (declared at the top) is the move under way: { plan, started }.
local recoveryUntil = 0
local lastGroundY = nil
local groundedAt = 0

local function finishMove()
	local finished = active
	active = nil
	recoveryUntil = os.clock() + PARKOUR.Recovery
	if MovementState.move == finished.plan.kind then
		MovementState.move = nil
	end
	if not alive() then
		return
	end
	root.AssemblyLinearVelocity = finished.plan.exitVelocity
	if finished.plan.kind == "vault" then
		startCarry(finished.plan.exitVelocity)
	end
	if MovementState.crouchHeld then
		setCrouching(true)
	end
	-- Holding jump through a climb would hop straight off the ledge you just got onto.
	if jumpKeyDown() then
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		local body = humanoid
		task.delay(0.25, function()
			if body.Parent then
				body:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
			end
		end)
	end
end

local function startMove(plan)
	active = { plan = plan, started = os.clock() }
	MovementState.move = plan.kind
	carry = nil
	-- You stand to climb; if the key is still held you drop back into it when you land (finishMove).
	setCrouching(false, true)
	if slide then
		endSlide(false)
	end
	parkourRemote:FireServer(plan.kind, plan.rise, plan.duration)
	Sfx.Play(plan.kind == "vault" and "Vault" or "Mantle", 0.08)
end

local function stepMove()
	if not active then
		return
	end
	if not alive() then
		active = nil
		MovementState.move = nil
		return
	end
	local plan = active.plan
	local position, done = Parkour.PositionAt(plan, os.clock() - active.started)
	root.CFrame = CFrame.lookAt(position, position + plan.forward)
	root.AssemblyLinearVelocity = Vector3.zero
	if done then
		finishMove()
	end
end

-- THE RUN-UP (#132 "vaulting still hard"). A vault needs VaultMinSpeed toward the obstacle, and the
-- speed used to be read on the frame jump was pressed. Run at a window and press jump as you reach it --
-- the natural moment -- and the wall has already stopped the body: 0 studs/s, no vault, and the climb
-- that is tried instead is refused because the pane fills the space over the sill. So the speed a vault
-- is judged by is the best of the last RUN_UP_WINDOW seconds toward where you're going, the speed you
-- ARRIVED with. It can't make a standing body vault: 0.3 s after stopping, the run-up is gone.
local RUN_UP_WINDOW = 0.3
local runUp = {}

local function noteRunUp(now)
	table.insert(runUp, { at = now, velocity = flat(root.AssemblyLinearVelocity) })
	while runUp[1] and now - runUp[1].at &gt; RUN_UP_WINDOW do
		table.remove(runUp, 1)
	end
end

-- Pure, for tools/remote_pose_vault_check.py: the best speed toward `direction` among samples
-- no older than `window`.
local function arrivalSpeed(samples, direction, now, window)
	local best = 0
	for _, sample in ipairs(samples) do
		if now - sample.at &lt;= window then
			best = math.max(best, sample.velocity:Dot(direction))
		end
	end
	return best
end

-- Looks for a climb or vault while jump is held (or was just pressed), and starts one.
local function tryParkour(now)
	if active or now &lt; recoveryUntil or not inMatch() or not alive() or gliding() or humanoid.Sit then
		return false
	end
	if not wantsJump(now) then
		return false
	end
	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	local direction = flat(humanoid.MoveDirection)
	if direction.Magnitude &lt; 0.1 then
		direction = flat(camera.CFrame.LookVector)
	end
	if direction.Magnitude &lt; 0.05 then
		return false
	end
	direction = direction.Unit
	local velocity = flat(root.AssemblyLinearVelocity)
	local speed = math.max(velocity:Dot(direction), 0)
	local recentlyGrounded = grounded or now - groundedAt &lt; 0.35
	local plan = Parkour.Find(character, direction, {
		groundY = lastGroundY,
		speed = math.max(speed, arrivalSpeed(runUp, direction, now, RUN_UP_WINDOW)),
		grounded = grounded,
		allowVault = recentlyGrounded,
		windowDrop = true,
		exhausted = MovementState.exhausted and not MovementState.rush,
	})
	if not plan then
		return false
	end
	-- On the move, a climb only takes over where the jump itself wouldn't clear the ledge: running onto a
	-- crate or a step stays a plain jump that keeps its speed, not a slow pull-up. Standing still, a
	-- climb is always the smoother way up.
	if plan.kind == "mantle" and speed &gt;= 8 then
		local feet = root.Position.Y - humanoid.HipHeight - root.Size.Y / 2
		local jumpHeight = humanoid.UseJumpPower and humanoid.JumpPower ^ 2 / (2 * workspace.Gravity) or humanoid.JumpHeight
		local rising = math.max(root.AssemblyLinearVelocity.Y, 0)
		local apex = grounded and feet + jumpHeight or feet + rising * rising / (2 * workspace.Gravity)
		if plan.topY &lt; apex - 0.6 then
			return false
		end
	end
	-- In the air, a vault only takes over where the jump itself would NOT clear the obstacle (the same
	-- rule as the climb above): a knee-high rail you jumped at early stays a free hop, no stamina, no
	-- pose. A window always takes over: its pane is in the plan's clearance box, and a body cannot fit a
	-- window at the top of a jump anyway. Cleared means the feet are still above the top, with margin,
	-- both where the body reaches the near edge and where it leaves the far one.
	if plan.kind == "vault" and not grounded and not (plan.panes and #plan.panes &gt; 0) then
		local feet = root.Position.Y - humanoid.HipHeight - root.Size.Y / 2
		local velocity = root.AssemblyLinearVelocity
		local toward = flat(velocity):Dot(plan.forward)
		if toward &gt; 1 then
			local near = math.max((flat(plan.points[2]) - flat(root.Position)):Dot(plan.forward), 0)
			local far = near + plan.depth + root.Size.Z + 0.6
			local clears = true
			for _, distance in ipairs({ near, far }) do
				local t = distance / toward
				if feet + velocity.Y * t - 0.5 * workspace.Gravity * t * t &lt; plan.topY + 0.3 then
					clears = false
				end
			end
			if clears then
				return false
			end
		end
	end
	if not predictSpend(plan.cost, plan.kind == "mantle") then
		plan = Parkour.Find(character, direction, { groundY = lastGroundY, speed = speed, allowVault = false,
			exhausted = MovementState.exhausted })
		if not plan or not predictSpend(plan.cost, true) then
			MovementState.refusedAt = now
			return false
		end
	end
	startMove(plan)
	return true
end

--------------------------------------------------------------------------------
-- Bounce Boots: one mid-air double jump per airtime
--------------------------------------------------------------------------------

-- The second jump's launch speed as a share of the boots' own jump. At 0.85 a double jump at the apex
-- reached 42 studs, over two-storey roofs; at 0.6 it adds about 7 to the boots' 21, which reaches
-- nothing a single boots jump plus a climb couldn't, and mostly buys distance and a second chance.
local DOUBLE_JUMP_SHARE = 0.6
local doubleJumpUsed = false
local handledPress = 0

local function tryDoubleJump(now)
	if pressedAt &lt;= handledPress or now - pressedAt &gt; 0.15 then
		return
	end
	handledPress = pressedAt
	if doubleJumpUsed or active or gliding() or not alive() or humanoid.Sit or humanoid.FloorMaterial ~= Enum.Material.Air then
		return
	end
	if now - groundedAt &lt; 0.12 then
		return
	end
	local untilTime = player:GetAttribute("BounceBootsUntil")
	if type(untilTime) ~= "number" or workspace:GetServerTimeNow() &gt; untilTime then
		return
	end
	doubleJumpUsed = true
	local jumpSpeed = humanoid.UseJumpPower and humanoid.JumpPower or math.sqrt(2 * workspace.Gravity * humanoid.JumpHeight)
	-- No ChangeState(Jumping) here: entering Jumping makes the humanoid apply its own full jump speed
	-- over anything slower, which turned this into a second full boots jump (42 studs, measured).
	-- Already in the air, a plain velocity write is enough.
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(velocity.X, jumpSpeed * DOUBLE_JUMP_SHARE, velocity.Z)
	Sfx.Play("DoubleJump", 0.08)
end

--------------------------------------------------------------------------------
-- Crouch
--------------------------------------------------------------------------------

-- The state is the server's (MatchService.SetCrouching holds the speed factor and the HipHeight); this
-- predicts the height locally so the body drops on the same frame as the key, and eases the camera and
-- the gun down with it. Shared/CrouchAnimation draws the fold, here and on every other client.
local crouchHeld = false
local crouchReadyAt = 0
-- How long the server has to agree that we are crouching before we give up and stand.
local CROUCH_SETTLE = 1.2
local crouchChangedAt = -math.huge
local baseHipHeight = nil

-- The body's height, predicted locally so it drops on the same frame as the key rather than a round trip
-- later. MatchService.updateHeight is the same rule on the server: LOW while crouching or sliding.
function applyBodyHeight()
	if not alive() then
		return
	end
	if baseHipHeight == nil then
		baseHipHeight = humanoid:GetAttribute("BaseHipHeight") or humanoid.HipHeight
	end
	local low = MovementState.crouching or slide ~= nil
	humanoid.HipHeight = low and math.max(baseHipHeight * CROUCH.HipScale, CROUCH.MinHipHeight) or baseHipHeight
end

-- Split out because the reconcile below has to put the body back without telling the server anything
-- (it is the server it is agreeing with).
local function applyCrouchHeight(value)
	MovementState.crouching = value
	crouchChangedAt = os.clock()
	applyBodyHeight()
end

-- `keepReady` suspends a crouch without arming its cooldown, for the climb and vault that stand you up
-- and put you straight back down again (finishMove); a quick vault lands inside those 0.15s.
function setCrouching(value, keepReady)
	value = value == true
	if MovementState.crouching == value then
		return
	end
	if value and (not alive() or humanoid.Sit or active or os.clock() &lt; crouchReadyAt) then
		return
	end
	crouchRemote:FireServer(value)
	if value then
		-- Crouching and sprinting cancel each other, the way sprinting and aiming do.
		MovementState._RequestSprintOff()
	elseif not keepReady then
		crouchReadyAt = os.clock() + CROUCH.Cooldown
	end
	applyCrouchHeight(value)
end

-- How far into the crouch the body is, on the same easing the animation uses.
local function crouchLevel()
	if MovementState.crouching then
		return CrouchAnimation.Weight(os.clock() - crouchChangedAt, true)
	end
	return CrouchAnimation.Weight(os.clock() - crouchChangedAt, false)
end

-- ONE KEY, TWO MOVES: crouch while sprinting and you slide; crouch otherwise and you crouch. The slide
-- has no control of its own. Every case, decided deliberately rather than left to fall out of the order:
--
--   sprinting, at speed, on the ground   -&gt; slide. When it ends, you are left CROUCHING if the key is
--                                           still held (endSlide), because standing up would be taking
--                                           the player's input away from them.
--   sprinting but too slow, or airborne, or on ground a slide is refused on
--                                        -&gt; plain crouch. The press is never swallowed.
--   sprint just ended, or stamina just ran out mid-stride
--                                        -&gt; plain crouch: by the time the key is read the sprint is
--                                           already off, and a crouch is what "crouch" should give you.
--   out of stamina for the slide         -&gt; the bar flashes the refusal AND you crouch. Getting neither
--                                           reads as the game ignoring the button.
--   already sliding                      -&gt; nothing. The slide is running; crouching on top of it would
--                                           multiply its ceiling by the crouch factor and drop it below
--                                           walking pace. It settles into a crouch by itself.
local function crouchPressed()
	if slide then
		return
	end
	if tryStartSlide() then
		return
	end
	setCrouching(true)
end

Settings.Bind("BRR_Crouch", "Crouch", function(_, inputState, inputObject)
	-- A toggle by setting, and always a toggle on touch (a thumb can't hold it and shoot).
	local toggles = Settings.Get("CrouchToggle") == true
		or (inputObject ~= nil and inputObject.UserInputType == Enum.UserInputType.Touch)
	if inputState == Enum.UserInputState.Begin then
		if toggles and (crouchHeld or MovementState.crouching) then
			crouchHeld = false
			MovementState.crouchHeld = false
			setCrouching(false)
			return Enum.ContextActionResult.Pass
		end
		crouchHeld = true
		MovementState.crouchHeld = true
		crouchPressed()
	elseif not toggles and (inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel) then
		crouchHeld = false
		MovementState.crouchHeld = false
		setCrouching(false)
	end
	return Enum.ContextActionResult.Pass
-- Touch: this button IS the slide button now — the slide has no control of its own, so it takes over the
-- "slide" slot in TouchControls and the free CAS position under PET. Without a button here a phone
-- player could neither crouch NOR slide. The branch above that makes touch always a toggle exists
-- precisely because a thumb can't hold this and shoot.
--
-- The slot is named explicitly because TouchControls maps action names to slots by a table it owns, and
-- it has no entry for BRR_Crouch: an unnamed slot would simply not be drawn once that system is on.
end, { title = "CROUCH", position = UDim2.new(1, -360, 1, -280), slot = "slide" }, Enum.KeyCode.ButtonR3)

--------------------------------------------------------------------------------
-- Quick movement item
--------------------------------------------------------------------------------

-- Uses the first movement item you carry without switching off your gun (WeaponService.StartUse with
-- a slot index; the server checks the slot really holds a movement item).
local useRemote = Remotes.Event("UseSelected")

local function firstMovementSlot()
	if not loadout or type(loadout.slots) ~= "table" then
		return nil
	end
	for index = 1, 8 do
		local slot = loadout.slots[index]
		local item = type(slot) == "table" and slot.kind == "item" and ItemData.Get(slot.id)
		if item and item.kind == "movement" then
			return index
		end
	end
	return nil
end

Settings.Bind("BRR_MovementItem", "MovementItem", function(_, inputState)
	if inputState ~= Enum.UserInputState.Begin or not inMatch() or not alive() or player:GetAttribute("MenuOpen") then
		return Enum.ContextActionResult.Pass
	end
	local index = firstMovementSlot()
	if index then
		useRemote:FireServer(nil, index)
	end
	return Enum.ContextActionResult.Pass
-- Touch: (1, -470, 1, -280), above SLIDE (1, -470, 1, -180) in the 4th column left of PET/CAM; the full
-- button map is beside the Slide bind in CombatClient. (380 up would sit at the top edge of a 390-tall phone.)
end, { title = "MOVE", position = UDim2.new(1, -470, 1, -280) }, Enum.KeyCode.DPadDown)

--------------------------------------------------------------------------------
-- The frame
--------------------------------------------------------------------------------

-- While a slide runs this holds the move vector (after the player module has written it); during a
-- climb or vault it holds it still.
RunService:BindToRenderStep("BRR_MovementSteer", Enum.RenderPriority.Input.Value + 1, function()
	if not alive() then
		return
	end
	if slide then
		local ceiling = math.max(humanoid.WalkSpeed, 1)
		humanoid:Move(slide.dir * math.clamp(slide.speed / ceiling, 0, 1), false)
	elseif active then
		humanoid:Move(Vector3.zero, false)
	end
end)

local cameraDrop = 0

RunService.Heartbeat:Connect(function(delta)
	local dt = math.min(delta, 0.1)
	local now = os.clock()
	MovementState.inMatch = inMatch()
	stepStamina(dt)
	if not alive() then
		slide, active, carry = nil, nil, nil
		MovementState.move = nil
		MovementState.dip = 0
		return
	end

	if humanoid.FloorMaterial ~= Enum.Material.Air and not active then
		lastGroundY = root.Position.Y - humanoid.HipHeight - root.Size.Y / 2
		groundedAt = now
		doubleJumpUsed = false
	end

	stepMove()
	if active then
		table.clear(runUp)
	else
		noteRunUp(now)
		stepSlide(dt)
		if not tryParkour(now) then
			tryDoubleJump(now)
		end
	end
	stepCarry(dt, active ~= nil or gliding())
	stepGlide(dt)

	-- The view drops into a slide and dips through a climb or vault; the gun follows (slideDip).
	local wantedDip = (MovementState.move == "slide" and 1) or (MovementState.move == "vault" and 0.8)
		or (MovementState.move == "mantle" and 0.65) or 0
	MovementState.dip += (wantedDip - MovementState.dip) * math.clamp(dt * (wantedDip &gt; MovementState.dip and 12 or 5), 0, 1)
	-- Sprint stands you up, the way it does in anything else with a crouch. Without this the two can both
	-- be on at once: the server drops the sprint and keeps the crouch speed, while the client goes on
	-- predicting a sprint's stamina drain for a crouch-walk that is costing nothing.
	if MovementState.crouching and MovementState.sprinting then
		crouchHeld = false
		MovementState.crouchHeld = false
		setCrouching(false)
	end

	-- The server has the last word on crouching. If it never took ours — refused, rate-limited, or the
	-- body changed underneath us — stand back up rather than walk around lowered (a smaller target) at
	-- a speed the server never cut. One way only: the server can end our crouch, never start one.
	if MovementState.crouching and now - crouchChangedAt &gt; CROUCH_SETTLE
		and character:GetAttribute("Crouching") ~= true
	then
		crouchHeld = false
		MovementState.crouchHeld = false
		applyCrouchHeight(false)
		crouchReadyAt = now + CROUCH.Cooldown
	end
	local crouched = crouchLevel()
	MovementState.dip = math.max(MovementState.dip, crouched * CROUCH.GunDip)
	local wantedDrop = math.max(MovementState.move == "slide" and SLIDE.CameraDrop or 0, crouched * CROUCH.CameraDrop)
	cameraDrop += (wantedDrop - cameraDrop) * math.clamp(dt * (wantedDrop &gt; cameraDrop and 14 or 6), 0, 1)
	if cameraDrop &gt; 0.01 or humanoid.CameraOffset.Y ~= 0 then
		humanoid.CameraOffset = Vector3.new(0, cameraDrop &gt; 0.01 and -cameraDrop or 0, 0)
	end
end)

local function onCharacter(newCharacter)
	-- EVERY reset happens before the WaitForChilds below, because those YIELD. The match drop-in fires
	-- its Glide within milliseconds of the character appearing, so a reset after the yield would wipe the
	-- glide that had already arrived and drop the player at full speed under an open canopy. (That is
	-- exactly what happened when this moved out of CombatClient, where the reset was the first line.)
	slide, active, carry = nil, nil, nil
	-- ...and a glide that arrived in the last couple of seconds belongs to THIS body (the drop-in fires as
	-- the character appears), so it is never reset here. Belt and braces with the ordering above.
	if os.clock() - glideStartedAt &gt; 2 then
		glideUntil = 0
		glideVelocity = nil
		glideAirborne = false
	end
	lastGroundY = nil
	cameraDrop = 0
	MovementState.move = nil
	MovementState.dip = 0
	MovementState.crouching = false
	MovementState.crouchHeld = false
	crouchHeld = false
	baseHipHeight = nil

	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid", 10)
	root = newCharacter:WaitForChild("HumanoidRootPart", 10)
	-- A sprint toggled on (touch RUN, stick click) never carries over to a new body, a death or a seat.
	MovementState._RequestSprintOff()
	if humanoid then
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		humanoid.Died:Connect(MovementState._RequestSprintOff)
		humanoid.Seated:Connect(function(seated)
			if seated then
				MovementState._RequestSprintOff()
				crouchHeld = false
				MovementState.crouchHeld = false
				setCrouching(false)
			end
		end)
	end
end

player:GetAttributeChangedSignal("MenuOpen"):Connect(function()
	if player:GetAttribute("MenuOpen") then
		MovementState._RequestSprintOff()
		crouchHeld = false
		MovementState.crouchHeld = false
		setCrouching(false)
	end
end)

if player.Character then
	task.spawn(onCharacter, player.Character)
end
player.CharacterAdded:Connect(onCharacter)

--------------------------------------------------------------------------------
-- Poses on every body, and the sounds of other people's moves
--------------------------------------------------------------------------------

local POSE_DISTANCE = 250
local HEAR_CUES = { slide = "SlideStart", mantle = "Mantle", vault = "Vault" }
-- Every body with a Humanoid is watched (false until it first poses); `posing` holds only the ones
-- sliding, climbing, vaulting or crouching (and the ones still easing out of it), so the per-frame loop
-- doesn't visit every bot in the match. character -&gt; {
--   joints, root, weight, kind,            the slide/climb/vault pose
--   crouchOn, crouchAt, crouchTravel, stride, lastPosition   the crouch animation
-- }
local posed = {}
local posing = {}

-- Every bot is a PHYSICS rig (CreateHumanoidModelFromDescription): its joints are AnimationConstraints
-- driven by torque, not Motor6Ds, so a leg we fold sags back under gravity and the pose reads wrong from
-- outside — which is the only way anyone ever sees a bot. Kinematic joints hold the Transform exactly.
-- Done per body while it is posed and handed back the way we found it, so nothing else that leans on
-- those joints (a death ragdoll, say) is changed by our having been here. Client-side only: a property
-- set here never leaves this machine.
local function holdJoints(joints)
	local restore = nil
	for _, joint in pairs(joints) do
		if joint:IsA("AnimationConstraint") and not joint.IsKinematic then
			restore = restore or {}
			restore[joint] = true
			pcall(function()
				joint.IsKinematic = true
			end)
		end
	end
	return restore
end

local function releaseJoints(restore)
	for joint in pairs(restore or {}) do
		if joint.Parent then
			pcall(function()
				joint.IsKinematic = false
			end)
		end
	end
end

local function watchCharacter(model)
	if not model:IsA("Model") or posed[model] ~= nil then
		return
	end
	local body = model:FindFirstChildOfClass("Humanoid")
	if not body then
		return
	end
	posed[model] = false
	model:GetAttributeChangedSignal("Parkour"):Connect(function()
		local kind = model:GetAttribute("Parkour")
		if kind then
			posing[model] = true
		end
		local cue = kind and HEAR_CUES[kind]
		local bodyRoot = model:FindFirstChild("HumanoidRootPart")
		if cue and model ~= character and bodyRoot then
			Sfx.PlayAt(cue, bodyRoot.Position, 0.08)
		end
	end)
	-- Crouching is a state, not a moment: it can already be on by the time this body is first seen
	-- (a bot that spawned crouched, someone who crouched before we streamed them in), so the attribute
	-- is read as well as watched.
	model:GetAttributeChangedSignal("Crouching"):Connect(function()
		if model:GetAttribute("Crouching") then
			posing[model] = true
		end
	end)
	if model:GetAttribute("Crouching") then
		posing[model] = true
	end
end

task.spawn(function()
	while true do
		for _, child in ipairs(workspace:GetChildren()) do
			watchCharacter(child)
		end
		for model in pairs(posed) do
			if not model.Parent then
				posed[model] = nil
				posing[model] = nil
			end
		end
		task.wait(1)
	end
end)

-- What one body's pose is this frame, written onto its joints. Kept apart from the loop below so the
-- same frame's pose can be written a second time, in Stepped, for everyone but ourselves (see there).
local function drawPose(entry, draw)
	if draw.parkour then
		Parkour.ApplyPose(entry.joints, entry.kind, entry.weight)
	elseif draw.crouch then
		CrouchAnimation.Apply(entry.joints, draw.crouch, draw.crouchWeight, draw.legs)
	end
end

-- Bound just AFTER the character update rather than to Stepped, because that is the one place a pose
-- written onto OUR OWN body survives the frame: the Animator evaluates our character's animations as part
-- of its own render step, and anything written before that is simply overwritten. Other bodies (other
-- players, every bot) are animated in the engine's animation step instead, which comes after the render
-- step and before Stepped, so a pose written here is overwritten before it is ever drawn — the reason a
-- slide made its sound on someone else and never its shape (#89). So their pose is ALSO written in
-- Stepped, below, from the same frame's numbers. Whichever of the two writes the engine draws, it was
-- blended from what the Animator had just written, so doing both is never wrong.
RunService:BindToRenderStep("BRR_MovementPoses", Enum.RenderPriority.Character.Value + 1, function(delta)
	local dt = math.min(delta, 0.1)
	local now = os.clock()
	local focus = camera.CFrame.Position
	-- Our own body animates from the local state, before the server's attributes come back.
	if character and posed[character] ~= nil and (MovementState.move or MovementState.crouching) then
		posing[character] = true
	end
	for model in pairs(posing) do
		local entry = posed[model]
		local isSelf = model == character
		local kind = (isSelf and MovementState.move) or model:GetAttribute("Parkour")
		local crouchOn = (isSelf and MovementState.crouching) or model:GetAttribute("Crouching") == true
		if (kind or crouchOn) and not entry then
			local joints = model.Parent and Parkour.PoseJoints(model)
			if joints then
				entry = {
					joints = joints, root = model:FindFirstChild("HumanoidRootPart"), weight = 0, kind = kind,
					body = model:FindFirstChildOfClass("Humanoid"),
					segments = CrouchAnimation.Segments(model),
					crouchOn = false, crouchAt = -math.huge, phase = 0,
					hold = holdJoints(joints),
					-- Roblox's own character sounds live here. Bots don't have them (the default sound
					-- script only runs for player characters), so this is nil for them and the block below
					-- simply does nothing.
					steps = (function()
						local part = model:FindFirstChild("HumanoidRootPart")
						local sound = part and part:FindFirstChild("Running")
						return sound and sound:IsA("Sound") and sound or nil
					end)(),
				}
				posed[model] = entry
			else
				posing[model] = nil
			end
		end
		if entry then
			if kind then
				entry.kind = kind
			end
			entry.weight += ((kind and 1 or 0) - entry.weight) * math.clamp(dt * (kind and 14 or 9), 0, 1)

			-- Crouch: the cycle is driven by how far the body has actually travelled, not by the clock,
			-- so the feet stay planted whatever the speed.
			if crouchOn ~= entry.crouchOn then
				entry.crouchOn, entry.crouchAt = crouchOn, now
			end
			-- Crouching is quiet, for whoever is listening. The default sound script sets this volume on
			-- state changes, so it is written every frame while the crouch lasts and handed back exactly as
			-- found when it ends — never left turned down on a body that has stood up.
			if entry.steps and entry.steps.Parent then
				if crouchOn then
					entry.loudness = entry.loudness or entry.steps.Volume
					entry.steps.Volume = entry.loudness * CROUCH.StepVolume
				elseif entry.loudness then
					entry.steps.Volume = entry.loudness
					entry.loudness = nil
				end
			end
			local crouchWeight = CrouchAnimation.Weight(now - entry.crouchAt, entry.crouchOn)
			-- How deep this body is sitting, from its own HipHeight against the one it stands at, so the
			-- legs fold exactly as far as MatchService lowered it (a bot, a scaled avatar, a retuned
			-- HipScale: all the same code).
			local drop, crouchSpeed = 0, nil
			if entry.body then
				drop = (entry.body:GetAttribute("BaseHipHeight") or entry.body.HipHeight) - entry.body.HipHeight
				crouchSpeed = entry.body.WalkSpeed
			end
			if drop &lt;= 0.05 and entry.body then
				-- Nothing has lowered it yet (the crouch is still on its way to the server, or this is a
				-- body we only just started watching), so its HipHeight IS the standing one: fold to the
				-- depth the config asks for rather than wait on the round trip.
				drop = entry.body.HipHeight * (1 - CROUCH.HipScale)
			end
			if not crouchSpeed or crouchSpeed &lt; 1 then
				crouchSpeed = MatchConfig.BaseWalkSpeed * CROUCH.SpeedMultiplier
			end
			local depth = CrouchAnimation.Depth(entry.segments, drop)
			local stride = CrouchAnimation.Stride(entry.segments)
			local speed = 0
			local position = entry.root and entry.root.Parent and entry.root.Position
			if position then
				if entry.lastPosition then
					local moved = (Vector3.new(position.X, 0, position.Z)
						- Vector3.new(entry.lastPosition.X, 0, entry.lastPosition.Z)).Magnitude
					speed = moved / math.max(dt, 1e-3)
					if crouchWeight &gt; 0 then
						entry.phase = CrouchAnimation.Advance(entry.phase, moved, stride,
							CrouchAnimation.Walk(speed, crouchSpeed))
					end
				end
				entry.lastPosition = position
			end

			local done = entry.weight &lt; 0.02 and not kind and crouchWeight &lt;= 0 and not crouchOn
			entry.draw = nil
			if done then
				releaseJoints(entry.hold)
				if entry.loudness and entry.steps and entry.steps.Parent then
					entry.steps.Volume = entry.loudness
				end
				posed[model] = model.Parent and false or nil
				posing[model] = nil
			elseif entry.root and entry.root.Parent and (entry.root.Position - focus).Magnitude &lt; POSE_DISTANCE then
				-- A climb or vault takes the body over from the crouch while it runs.
				local draw = nil
				if entry.weight &gt; 0.02 then
					draw = { parkour = true }
				elseif crouchOn or crouchWeight &gt; 0.01 then
					-- `crouchOn` is in that test because the eased weight is still 0 on the first frame of
					-- a crouch, while the hips are already down: one frame with the legs unfolded is one
					-- frame with the feet through the floor.
					-- The pose is built at full depth and Apply does the blending, so easing in and out
					-- lerps from whatever the Animator is playing. (Scaling the ANGLES by the weight
					-- instead would blend from the rig's rest pose, and the legs would snap out of the
					-- walk the moment a crouch started.)
					draw = {
						crouch = CrouchAnimation.Pose({
							phase = entry.phase,
							walk = CrouchAnimation.Walk(speed, crouchSpeed),
							segments = entry.segments,
							depth = depth,
							stride = stride,
							clock = now,
						}),
						crouchWeight = crouchWeight,
						legs = crouchOn and 1 or 0,
					}
				end
				if draw then
					drawPose(entry, draw)
					if not isSelf then
						entry.draw = draw
					end
				end
			end
		elseif not kind and not crouchOn then
			posing[model] = nil
		end
	end
end)

-- The second write for everyone but ourselves: Stepped runs straight after the engine's animation step,
-- so the pose lands on top of this frame's walk and run and is what the physics step then places the
-- limbs from. The same technique GunPoseClient uses for the arms. Only what the render step decided this
-- frame is drawn; a body that finished, left range or was removed has no `draw` and is left alone.
RunService.Stepped:Connect(function()
	for model in pairs(posing) do
		local entry = posed[model]
		local draw = entry and entry.draw
		if draw then
			entry.draw = nil
			if model.Parent and model ~= character then
				drawPose(entry, draw)
			end
		end
	end
end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX177"><Properties><string name="Name">MovementState</string><ProtectedString name="Source">-- What the local player's movement is doing right now, shared between client scripts. ModuleScript,
-- so CombatClient (the sprint and slide binds, the viewmodel dip), HudClient (the stamina bar) and
-- MovementClient (which runs everything and writes these fields) all see one table.
--
-- MovementClient owns the writes. Other scripts read the fields and call the two requests:
--   MovementState.SetSprintHeld(held)  the sprint key's state; MovementClient decides the real sprint
--   MovementState.RequestSlide()       the slide key was pressed
-- and can listen to:
--   MovementState.ExhaustedChanged     (exhausted: boolean)
--   MovementState.SprintAllowedChanged (allowed: boolean) — CombatClient turns the sprint on or off

local MovementState = {
	-- Stamina as the client predicts it (corrected by the server's StaminaSync).
	stamina = 100,
	maxStamina = 100,
	exhausted = false,
	-- A Speed Soda's rush: nothing costs stamina.
	rush = false,
	-- Stamina is only in play during a match; outside one the bar is hidden.
	inMatch = false,
	-- True while sprinting is actually draining (for the HUD).
	draining = false,
	-- The sprint key is held.
	sprintHeld = false,
	-- The sprint is actually on (written by CombatClient's setSprinting).
	sprinting = false,
	-- Crouching right now, and whether the crouch input is held (a slide settles back into a crouch when
	-- it ends if it is). MovementClient owns both.
	crouching = false,
	crouchHeld = false,
	-- "slide" | "mantle" | "vault" | nil
	move = nil,
	-- 0..1: how far the view and the gun are dipped (slide, climb, vault). CombatClient hands it to the
	-- viewmodel as slideDip.
	dip = 0,
	-- os.clock() of the last slide or vault refused for want of stamina (the bar flashes).
	refusedAt = 0,
}

local exhaustedEvent = Instance.new("BindableEvent")
MovementState.ExhaustedChanged = exhaustedEvent.Event
local sprintAllowedEvent = Instance.new("BindableEvent")
MovementState.SprintAllowedChanged = sprintAllowedEvent.Event
local slideRequestEvent = Instance.new("BindableEvent")
MovementState.SlideRequested = slideRequestEvent.Event
-- Fired when a toggled (or held) sprint must not survive: respawn, death, sitting down (a vehicle), the
-- menu opening. CombatClient's sprint block clears the request and turns the sprint off.
local sprintOffEvent = Instance.new("BindableEvent")
MovementState.SprintOffRequested = sprintOffEvent.Event

-- MovementClient only.
function MovementState._RequestSprintOff()
	MovementState.sprintHeld = false
	sprintOffEvent:Fire()
end

function MovementState.SetSprintHeld(held)
	MovementState.sprintHeld = held == true
end

-- Whether a sprint may run right now (not exhausted).
function MovementState.CanSprint()
	return not MovementState.exhausted
end

function MovementState.RequestSlide()
	slideRequestEvent:Fire()
end

-- MovementClient only.
function MovementState._SetExhausted(value)
	value = value == true
	if MovementState.exhausted == value then
		return
	end
	MovementState.exhausted = value
	exhaustedEvent:Fire(value)
	sprintAllowedEvent:Fire(not value)
end

return MovementState
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX178"><Properties><string name="Name">PhoneLayout</string><ProtectedString name="Source">-- PhoneLayout: where every HUD element goes on a touch screen, in screen pixels.
--
-- Phones and small tablets are not small desktops. At 844x390 the desktop HUD draws a 440-wide banner,
-- a 190 minimap, a 690 hotbar and a 300 kill feed at full size on a screen a third the height, so the
-- pieces cover the middle of the screen and each other: measured, 27 overlapping pairs at 844x390 and 44
-- at 667x375. This module is the one place that decides the touch layout, so the pieces cannot drift
-- apart again, and it is a straight port of scratchpad/phone_layout_map.py, which sweeps 2395 landscape
-- sizes looking for overlaps, anything off screen, anything tappable inside the thumbstick's zone,
-- anything over the crosshair, and hotbar cells too small for a finger.
--
-- The rules behind the numbers:
--   * Roblox owns the lower-left (the dynamic thumbstick's zone is the left 40% below a third of the
--     way down) and the lower-right (the jump button), and the top-left (its own bar). Nothing of ours
--     goes in any of them, and nothing tappable of ours goes in the thumbstick's zone at all.
--   * While TouchControls.Enabled is false, ContextActionService draws the game's touch buttons in a
--     frame covering the right 30% of the screen from a quarter of the way down; the bottom band keeps
--     out of that, so this layout holds both before and after that flag is flipped.
--   * The middle of the screen is for aiming: the crosshair's box stays clear, and the bottom stack
--     (hotbar, health, stamina) sits below it.
--   * A finger is 44 pixels wherever it is, so that minimum never scales with the screen (40 on phones
--     under 700 across, where nothing else fits, which is about Roblox's own 45-pixel buttons).
--
-- Every rect is in SCREEN pixels from the top-left of the viewport, the same frame ScreenGui offsets use
-- when IgnoreGuiInset is true. HudClient's own ScreenGui does ignore the inset; MenuClient's does not, so
-- MenuClient subtracts the inset itself (Rects().inset carries it).

local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local PhoneLayout = {}

-- Test hook: "desktop", "handheld" or "upright" forces the version whatever the device says (the probe
-- and the gallery set it; nothing in the game does).
PhoneLayout.Force = nil

-- WHICH VERSION A DEVICE GETS -- the one decision, in one place.
--
-- There are three HUDs, not one that stretches: the owner asked for separate versions after seeing the
-- big one work and the small ones not.
--   "desktop"   the big HUD, as it has always been drawn. Untouched by this module.
--   "handheld"  a touch screen held on its side: everything smaller, and laid out round Roblox's own
--               thumbstick, jump button and top bar. Phones and tablets alike; `k` scales it up on a
--               tablet, which is the one place a size still matters inside a version.
--   "upright"   a touch screen held upright, where the lower half belongs to Roblox's controls and there
--               is no band for a hotbar: a deliberately smaller HUD (see portraitRects).
--
-- A laptop with a touch screen stays "desktop": it has a keyboard and a mouse, and its viewport is not the
-- problem this module solves. Studio's device emulator is the exception -- it reports a keyboard while
-- pretending to be a phone -- or the whole thing could only be tested on a real handset.
--
-- NOT THE SAME AS UiKit.form, AND DELIBERATELY SO. There are two of these in the project and they are
-- meant to disagree:
--   * `UiKit.form(viewport)` (large / short / tall) asks WHAT SHAPE THE SCREEN IS, because the menu draws
--     into a panel and what matters is which dimension has run out.
--   * `PhoneLayout.Mode(viewport)` (desktop / handheld / upright) asks WHAT THE DEVICE IS, because the HUD
--     has to dodge Roblox's thumbstick zone, jump button and touch buttons, and those only exist on a
--     touch screen at all. No word is shared with the menu's three, on purpose.
-- Worked example, the one that catches people: a tablet held upright at 768x1024 is "large" to
-- UiKit.form -- 728 pixels of panel is not a small screen -- and "upright" here, because the bottom half
-- of that screen belongs to Roblox's thumbstick and buttons and the HUD has to be a different, smaller
-- one. A laptop with a touch screen is the mirror image: "tall" or "short" to the menu when its window is
-- small, always "desktop" here because it has a mouse and a keyboard.
-- Do not unify them. Using the same words would imply they agree, and both surfaces break when they are
-- made to.
function PhoneLayout.Mode(viewport)
	if PhoneLayout.Force then
		return PhoneLayout.Force
	end
	if not UserInputService.TouchEnabled then
		return "desktop"
	end
	if UserInputService.KeyboardEnabled and not RunService:IsStudio() then
		return "desktop"
	end
	if viewport.Y &gt; viewport.X then
		return "upright"
	end
	return math.min(viewport.X, viewport.Y) &lt;= 1100 and "handheld" or "desktop"
end

function PhoneLayout.Active(viewport)
	return PhoneLayout.Mode(viewport) ~= "desktop"
end

local function rect(x, y, w, h)
	return { x = x, y = y, w = w, h = h, x1 = x + w, y1 = y + h }
end

-- The driving HUD, laid out inside a region: VehicleClient's speed panel (250x78 as drawn on a desktop)
-- and VehicleWeaponClient's gun panel (150x78) side by side, or the gun panel under the speed panel when
-- that lets both be bigger; the damage line (260x20) above them and the controls hint (300x18, which the
-- touch wording needs) below. `vehicleScale` is the panels' scale. On a desktop screen those pieces sit
-- above the hotbar at their own literals; on a touch screen those literals put them over the crosshair
-- (844x390) and across the hotbar (upright) (#80, tools/hud_layout_check.py).
local function vehicleRects(out, x, y, w, h)
	local beside = math.min(w / 408, (h - 4) / 116)
	local stacked = math.min(w / 250, (h - 6) / 194)
	local k = math.min(math.max(beside, stacked), 1)
	local kw, kh = math.min(k, w / 260), math.min(k, w / 300)
	out.vehicleScale = k
	out.vehicleWarning = rect(x, y, 260 * kw, 20 * kw)
	local panelY = out.vehicleWarning.y1 + 2
	out.vehicle = rect(x, panelY, 250 * k, 78 * k)
	if beside &gt;= stacked then
		out.vehicleGun = rect(x + 258 * k, panelY, 150 * k, 78 * k)
	else
		out.vehicleGun = rect(x, out.vehicle.y1 + 2, 150 * k, 78 * k)
	end
	out.vehicleHint = rect(x, math.max(out.vehicle.y1, out.vehicleGun.y1) + 2, 300 * kh, 18 * kh)
end

-- Portrait is not the landscape layout turned on its side. Roblox owns the lower half of a portrait
-- screen -- the thumbstick's zone is the left 40% below a third of the way down, and the fire buttons
-- climb the right side from the jump button -- so there is no band between them for a hotbar, and
-- anything a finger presses has to be above that zone or to the right of it. The owner's answer to
-- "portrait doesn't fit" was to simplify the HUD until it does, so this is a smaller HUD, not a second
-- full one: no compass, no kill feed, no bounty or location line, no speed pill; the hotbar keeps the
-- slots that fit (and on the shortest screens none at all, just the button that opens the panel); and
-- the minimap, the coin chip and the companion strip are all still here, small.
local function portraitRects(W, H)
	local g = 8
	local out = { k = 1, small = true, portrait = true }
	local jumpX, jumpY, jumpSize = W - 95, H - 90, 70
	local stickX, stickY, stickD = 66, H - 56, 74
	out.jump = rect(jumpX, jumpY, jumpSize, jumpSize)
	out.stick = rect(stickX - stickD / 2, stickY - stickD / 2, stickD, stickD)
	out.topBar = rect(0, 0, 200, 52)
	out.moveZone = rect(0, H / 3, 0.4 * W, H * 2 / 3)

	local B, F = 48, 72
	local fireX, fireY = jumpX - g - F, jumpY + jumpSize - F
	out.fire = rect(fireX, fireY, F, F)
	local colA, colB = fireX + (F - B) / 2, jumpX + (jumpSize - B) / 2
	local row = math.min(fireY, jumpY)
	for _, pair in ipairs({ { "aim", "reload" }, { "run", "pet" }, { "slide", "move" } }) do
		row = row - g - B
		out[pair[1]] = rect(colA, row, B, B)
		out[pair[2]] = rect(colB, row, B, B)
	end
	local clusterLeft, clusterTop = fireX, row

	local m, iconsY, mm = 44, 58, 72
	out.menu = rect(W - g - m, iconsY, m, m)
	out.stackTab = rect(W - g - m - 6 - 52, iconsY, 52, m)
	local camX = W - g - m - 6 - 52 - 6 - m
	out.cam = rect(camX, iconsY, m, m)
	out.minimap = rect(16, iconsY, mm, mm)
	local bannerY = iconsY + mm + 4
	out.banner = rect(16, bannerY, W - 32, 42)
	local stormY = bannerY + 42 + 2
	out.stormLine = rect(16, stormY, W - 32, 18)
	out.compass = nil

	local pillW, pillH = 236 * 0.62, 56 * 0.62
	local pillY = stormY + 18 + 6
	out.eventPill = rect(W - g - pillW, pillY, pillW, pillH)
	out.ready = rect(W - g - math.max(pillW, 169), pillY, math.max(pillW, 169), 44)
	out.eventPillBelow = rect(W - g - pillW, out.ready.y1 + 6, pillW, pillH)
	out.coins = rect(16, pillY, 120, 28)
	local compY = pillY + 28
	out.companion = rect(16, compY, math.clamp(W - g - pillW - 6 - 16, 96, 138), 24)
	out.petIcon = rect(16, compY + 28, 56, 56)
	-- The toast and the use prompt are full-width-ish strips, and the top of an upright screen has no such
	-- row left under the coin chip, the companion strip, the pet tile and the event pills: at the old
	-- spots the toast lay across the companion strip and the pet tile, and the prompt across the coin chip
	-- and the event pill (#80, measured by tools/hud_layout_check.py). They go under the crosshair's box
	-- instead, where nothing else of ours is drawn on an upright screen. The prompt's rect is what
	-- HudClient actually draws there (250x46 at 0.8), not a guess.
	local crossBottom = H / 2 + 32 + 12
	out.toast = rect(16, crossBottom, W - 32, 22)
	out.useBar = rect(W / 2 - 100, crossBottom + 22 + 4, 200, 37)

	-- The hotbar row: the Inventory button and as many slots as fit between the thumbstick's zone and
	-- the right edge, above the buttons and clear of the crosshair's band.
	local cell, gap, inv = 44, 3, 44
	local room = (W - g) - (0.4 * W + 4) - inv - 6
	local cells = math.clamp(math.floor((room + gap) / (cell + gap)), 2, 4)
	local gridW = cells * cell + (cells - 1) * gap
	local hotY = clusterTop - 6 - cell
	local hotX = W - g - gridW - 6 - inv
	local rowClear = hotY &gt; H / 2 + 12 or hotY + cell &lt; H / 2 - 12 or hotX &gt; W / 2 + 12
	local rowBelowPill = hotY &gt; pillY + pillH or hotX &gt; W - g - pillW
	if rowClear and rowBelowPill then
		out.hotbar = rect(hotX + inv + 6, hotY, gridW, cell)
		out.inventory = rect(hotX, hotY, inv, cell)
		out.hotbarSlots = cells
	else
		-- The shortest portrait screens have nowhere for a row: between the top strip and the buttons
		-- there is only the crosshair's own band. The slots live in the panel and the screen keeps the
		-- button that opens it.
		out.hotbarSlots = 0
		local fallbackY = pillY + pillH + 6
		if fallbackY + inv &gt; clusterTop - 6 then
			out.inventory = rect(camX - 6 - inv, iconsY, inv, m)
		else
			out.inventory = rect(W - g - inv, fallbackY, inv, inv)
		end
	end
	out.hotbarCell, out.hotbarGap, out.hotbarTight = cell, gap, false

	-- Health and stamina are readouts, not buttons, so they can sit in the thumbstick's corner where a
	-- player already looks for them.
	local stickTop = out.stick.y
	local healthY = stickTop - 6 - 30
	local readoutW = math.clamp(clusterLeft - 6 - 16, 96, 138)
	out.health = rect(16, healthY, readoutW, 30)
	out.stamina = rect(16, healthY - 4 - 14, readoutW, 14)
	-- Driving: the left-hand block between the use prompt (and the hotbar row, when it is there) and the
	-- health readout, left of the buttons. The stamina bar that sits in it is hidden in a vehicle.
	local driveTop = out.useBar.y1 + 6
	if out.hotbar then
		driveTop = math.max(driveTop, out.inventory.y1 + 6)
	end
	vehicleRects(out, 16, driveTop, clusterLeft - 6 - 16, math.max(out.health.y - 6 - driveTop, 40))
	-- The companion-buffs panel (BoonHud): down the left edge under the pet tile, narrow enough to stay
	-- left of the crosshair's box, and no lower than the toast. A readout, so the thumbstick's zone is
	-- allowed; BoonHud scales it down to fit the height when there are many buffs.
	local boonsY = out.petIcon.y1 + 6
	out.boons = rect(16, boonsY, math.min(152, W / 2 - 44 - 16), math.max(crossBottom - 6 - boonsY, 40))
	out.inset = GuiService:GetGuiInset().Y
	return out
end

-- The whole layout for a viewport: a table of rects by name, plus the numbers the callers need (the
-- scale k, the hotbar's cell size, and the Roblox inset). Cheap enough to call on every viewport change.
function PhoneLayout.Rects(viewport)
	local W, H = viewport.X, viewport.Y
	if H &gt; W then
		return portraitRects(W, H)
	end
	local small = math.min(W, H) &lt;= 500
	-- Clamped at 1 below, not just 1.5 above, so the 500-to-512 band matches TouchControls.Layout,
	-- which works the same numbers out for itself (the probe compares the two).
	local k = small and 1 or math.clamp(math.min(W, H) / 512, 1, 1.5)
	local g = 8 * k
	local out = { k = k, small = small }

	-- Roblox's own controls, from its CoreScripts (TouchJump, DynamicThumbstick).
	local jumpX, jumpY, jumpSize, stickX, stickY, stickD
	if small then
		jumpX, jumpY, jumpSize = W - 95, H - 90, 70
		stickX, stickY, stickD = 66, H - 56, 74
	else
		jumpX, jumpY, jumpSize = W - 170, H - 210, 120
		stickX, stickY, stickD = 132, H - 112, 148
	end
	out.jump = rect(jumpX, jumpY, jumpSize, jumpSize)
	out.stick = rect(stickX - stickD / 2, stickY - stickD / 2, stickD, stickD)
	out.topBar = rect(0, 0, 200 * (small and 1 or 1.1), 52)
	out.moveZone = rect(0, H / 3, 0.4 * W, H * 2 / 3)

	-- The right thumb cluster, two columns built up from the jump button (TouchControls draws these).
	local B, F = 48 * k, 72 * k
	local fireX = jumpX - g - F
	local fireY = jumpY + jumpSize - F
	out.fire = rect(fireX, fireY, F, F)
	local colA = fireX + (F - B) / 2
	local colB = jumpX + (jumpSize - B) / 2
	local row = math.min(fireY, jumpY)
	local PAIRS = { { "aim", "reload" }, { "run", "pet" }, { "slide", "move" } }
	for _, pair in ipairs(PAIRS) do
		row = row - g - B
		out[pair[1]] = rect(colA, row, B, B)
		out[pair[2]] = rect(colB, row, B, B)
	end
	local clusterLeft, clusterTop = fireX, row

	-- Top strip: the banner and compass centred in what's left between Roblox's bar and the icons.
	local sTop = small and 0.75 or 1
	local m = 44 * k
	local camLeft = W - g - m - 6 - 52 * k - 6 - m
	local roomLeft, roomRight = out.topBar.x1 + 8, camLeft - 8
	local bw = math.min(440 * sTop, roomRight - roomLeft)
	local bx = math.min(math.max(W / 2 - bw / 2, roomLeft), roomRight - bw)
	-- Banner, then the storm line, then the compass: one thin stack at the top, in the order they have on
	-- a desktop screen, with the storm line pulled up under the banner so the right-hand column (the
	-- event pill and the kill feed) can start below the whole strip. The storm line is narrower than the
	-- banner because it is one centred line of text.
	out.banner = rect(bx, 4, bw, 56 * sTop)
	local stormY = 4 + 56 * sTop + 2
	local stormW = math.min(250 * k, bw)
	out.stormLine = rect(bx + (bw - stormW) / 2, stormY, stormW, 18 * sTop)
	local compassY = stormY + 18 * sTop + 2
	out.compass = rect(bx, compassY, bw, 24 * sTop)
	local topStripBottom = compassY + 24 * sTop
	out.menu = rect(W - g - m, 6, m, m)
	out.stackTab = rect(W - g - m - 6 - 52 * k, 6, 52 * k, m)
	out.cam = rect(camLeft, 6, m, m)

	local pillW, pillH = 236 * 0.62 * (small and 1 or 1.3), 56 * 0.62 * (small and 1 or 1.3)
	local underTop = math.max(6 + m + 6, topStripBottom + 4)
	local mm = small and 96 * k or 150
	local feedH = 2 * 18 * k
	-- The pill sits under the icons, unless the button cluster reaches that high on a short screen: then
	-- it ends just left of the cluster instead.
	local pillRight = W - g
	if clusterTop &lt; underTop + math.max(pillH, feedH) + g then
		pillRight = clusterLeft - g
	end
	out.eventPill = rect(pillRight - pillW, underTop, pillW, pillH)
	-- The lobby's READY pill takes the same corner (there is no event pill in a match at the same time
	-- as a READY pill), at a finger's height, and the event pill drops below it while it is there.
	local readyW, readyH = math.max(pillW, 169), 44
	out.ready = rect(pillRight - readyW, underTop, readyW, readyH)
	out.eventPillBelow = rect(pillRight - pillW, out.ready.y1 + 6, pillW, pillH)
	local feedW = math.min(200 * k, pillRight - pillW - 6 - (16 + mm + g))
	local feedBottom
	if feedW &gt;= 140 then
		out.killFeed = rect(pillRight - pillW - 6 - feedW, underTop, feedW, feedH)
		feedBottom = underTop + math.max(feedH, pillH)
	else
		feedW = math.min(200 * k, W - 2 * g - (16 + mm + g))
		out.killFeed = rect(pillRight - feedW, underTop + pillH + 4, feedW, feedH)
		feedBottom = underTop + pillH + 4 + feedH
	end
	out.useBar = rect(W / 2 - 110 * k, topStripBottom + 6, 220 * k, 30 * k)
	-- Below the kill feed's slot too: the toast is centred and 286 wide, and reaches into the right-hand
	-- column the feed starts (#80: 3 px into its second row at 844x390, 5 px at 1024x768).
	out.toast = rect(W / 2 - 143 * k, math.max(topStripBottom + 6 + 30 * k, out.killFeed.y1 + 4), 286 * k, 22 * k)
	-- The bounty and location lines, right-aligned under the kill feed, never under the button cluster
	-- and never back into the left column.
	local textRight = math.min(pillRight, clusterLeft - g)
	local leftColumnRight = 16 + math.max(mm, 120 * k + 6 + 160 * k) + 8
	local textW = math.max(textRight - math.max(textRight - 200 * k, leftColumnRight), 120)
	-- Below the toast as well as the feed: the toast is centred and 286 wide, and on a phone its right
	-- end reaches into this column (#80: 104x14 px over the bounty line at 844x390, the very moment the
	-- bounty's own toast is up).
	local textY = math.max(feedBottom, out.toast.y1) + 4
	out.bounty = rect(textRight - textW, textY, textW, 19 * k)
	out.location = rect(textRight - textW, textY + 19 * k + 2, textW, 17 * k)

	-- Left edge: the minimap under Roblox's bar, then the two things the owner asked to keep but shrink
	-- (the coin chip and the companion strip) sharing one row, then the pet tile above the thumbstick's
	-- rest. The bounty and location lines move to the right column: this is the tightest column on the
	-- screen and those two are the least urgent things in it.
	out.minimap = rect(16, 58, mm, mm)
	local pt = 56 * k
	out.petIcon = rect(16, out.stick.y - g - pt, pt, pt)
	-- Sized so the text inside is still readable once it is scaled: the chip is drawn at 210 wide and the
	-- companion strip at 300, so 120 and 160 keep them at about 0.55 -- 12 to 14 pixel text, not 8.
	local statusH = 32 * k
	local statusY = 58 + mm + 4
	if statusY + statusH &gt; out.petIcon.y - 4 then
		statusY = out.petIcon.y - 4 - statusH
	end
	out.coins = rect(16, statusY, 120 * k, 28 * k)
	out.companion = rect(16 + 120 * k + 6, statusY, 160 * k, statusH)

	-- The bottom band, between the thumbstick's zone and the buttons: hotbar, health row, stamina.
	local bandLeft = math.max(out.stick.x1 + 10, 0.4 * W + 4)
	local bandRight = math.min(clusterLeft, 0.7 * W) - 6
	local bandW = bandRight - bandLeft
	local cellGap = small and 3 * k or 4 * k
	local bottom = H - 8
	local inv, invH = 44 * k, 32 * k
	local cellMin = W &gt;= 700 and 44 or 40
	-- The crosshair's own 24-pixel box is in the middle of the screen; the stack's top stays below it.
	local topLimit = H / 2 + 14
	local cell = math.min((bandW - 3 * cellGap) / 4, 60 * k)
	local healthH, gridW = 0, 0
	while true do
		gridW = 4 * cell + 3 * cellGap
		-- The health row is the real block scaled to the width it gets, so its height follows its shape
		-- (280x48 in the phone arrangement HudClient switches to) rather than a guessed number.
		healthH = 48 * (gridW - inv - 6) / 280
		-- 10 above the grid, not 6: the hotbar's plate has its own padding round the cells, and that gap
		-- is what keeps the plate's edge off the health row.
		local stack = 2 * cell + cellGap + 10 + math.max(healthH, invH) + 4 + 14 * k
		if bottom - stack &gt;= topLimit or cell &lt;= cellMin + 0.01 then
			break
		end
		cell -= 1
	end
	-- A band too narrow for a finger (a portrait screen, where the game has no layout of its own yet)
	-- gets cells at the minimum anyway, overflowing the band rather than drawing eight 10-pixel slots
	-- nobody can hit. `hotbarTight` says so, and the probe's sweep treats it as a problem.
	out.hotbarTight = cell &lt; cellMin - 0.01
	cell = math.max(cell, cellMin)
	local gridH = 2 * cell + cellGap
	local row2H = math.max(healthH, invH)
	local x0 = bandLeft + (bandW - gridW) / 2
	out.hotbar = rect(x0, bottom - gridH, gridW, gridH)
	out.hotbarCell, out.hotbarGap = cell, cellGap
	local hy = bottom - gridH - 10 - row2H
	out.inventory = rect(x0 + gridW - inv, hy + row2H - invH, inv, invH)
	out.health = rect(x0, hy + row2H - healthH, gridW - inv - 6, healthH)
	local sy = hy - 4 - 14 * k
	local pill = 84 * k
	out.stamina = rect(x0, sy, gridW - pill - 6, 14 * k)
	out.speedPill = rect(x0 + gridW - pill, sy - 6 * k, pill, 20 * k)
	-- The companion-buffs panel (BoonHud): right of the pet tile, under the coin chip and the companion
	-- strip, and clear of the thumbstick's rest and of the health row. A readout, so the thumbstick's zone
	-- is allowed; BoonHud scales it down to fit the height when there are many buffs.
	local boonsX, boonsY = out.petIcon.x1 + 6, statusY + statusH + 6
	out.boons = rect(boonsX, boonsY, math.min(152 * k, out.health.x - 6 - boonsX), math.max(out.stick.y - 6 - boonsY, 40))
	-- Driving: the block right of the pet tile, from under the coin chip and companion strip down to the
	-- thumbstick's rest, left of the health row. The buffs panel that shares it hides in a vehicle
	-- (BoonHud), which is why the block can be this big.
	vehicleRects(out, boonsX, boonsY, out.health.x - 6 - boonsX, math.max(out.stick.y - 6 - boonsY, 40))

	out.inset = GuiService:GetGuiInset().Y
	return out
end

-- A centred panel (the menu, the drop screen, the results card) is authored at one size in pixels, and
-- several of them are taller than a phone screen: the menu's 760x480 hangs 90 px off a 390-tall screen
-- and the drop screen's 480x536 loses its map and its CONFIRM row. This gives the panel a UIScale that
-- keeps it inside the viewport with a margin, and never grows it: on any screen big enough the scale is
-- exactly 1, so nothing changes on a desktop. `natural` is the size the panel is authored at; `inset` is
-- true for a ScreenGui that keeps Roblox's top bar (MenuClient's does, HudClient's does not).
-- Returns the function it connected, so a caller can re-fit after changing the panel.
-- The scale on its own, so it can be checked without a screen: 1 whenever the panel already fits.
function PhoneLayout.PanelScale(natural, viewport, options)
	options = options or {}
	local margin = options.margin or 16
	local inset = options.inset and (options.insetY or GuiService:GetGuiInset().Y) or 0
	local room = Vector2.new(viewport.X - 2 * margin, viewport.Y - inset - 2 * margin)
	return math.clamp(math.min(1, room.X / math.max(natural.X, 1), room.Y / math.max(natural.Y, 1)), 0.2, 1)
end

function PhoneLayout.FitPanel(panel, natural, options)
	options = options or {}
	local scaleObject = panel:FindFirstChildOfClass("UIScale")
	if not scaleObject then
		scaleObject = Instance.new("UIScale")
		scaleObject.Parent = panel
	end
	local camera = workspace.CurrentCamera
	local function fit()
		local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
		scaleObject.Scale = PhoneLayout.PanelScale(natural, viewport, options)
	end
	fit()
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	end
	return fit
end

-- Puts `instance` in `spot`, scaling it by `scaleObject` so that its natural width fills the rect. The
-- element keeps its own drawing: only where it sits and how big it is change. Returns the scale used.
-- `fit` also holds it inside the rect's height; leave it off for a frame that is a container taller than
-- what it draws (the kill feed's box is 200 tall and holds two 18-pixel lines).
function PhoneLayout.Place(instance, spot, natural, scaleObject, insetY, fit)
	if not (instance and spot and natural and scaleObject) then
		return 1
	end
	local scale = math.max(spot.w / math.max(natural.X, 1), 0.05)
	if fit and natural.Y * scale &gt; spot.h + 0.5 then
		scale = spot.h / math.max(natural.Y, 1)
	end
	scaleObject.Scale = scale
	instance.AnchorPoint = Vector2.new(0, 0)
	instance.Position = UDim2.fromOffset(spot.x, spot.y - (insetY or 0))
	return scale
end

return PhoneLayout
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX179"><Properties><string name="Name">ProgressionPanel</string><ProtectedString name="Source">-- The progression hub on the menu's Pass tab: a PASS | RANK | MASTERY | INDEX | CELL SHOP toggle,
-- and every page but PASS drawn here. The numbers come from the profile's `progression` snapshot
-- (Shared/ProgressionData.Snapshot) and are worked out with the same ProgressionData functions the
-- server uses.
--
-- A ModuleScript rather than part of MenuClient so tools/progression_gallery.lua can build the real
-- pages in edit mode and screenshot them.
--
--   ProgressionPanel.Render(content, profile, ctx)
--     Draws the toggle row into `content` (the menu's list), then the chosen page. Returns true when
--     it drew a page, meaning the Pass tab should draw nothing else; false on PASS.
--     ctx.rerender()  redraws the tab (after a server answer lands)
--     ctx.now         optional clock override, for the gallery
--   ProgressionPanel.View / SetView(name)   "Pass", "Rank", "Mastery", "Index" or "Shop"
--
-- Every server call shows its own answer on the page: success in green, a refusal in red. (The
-- menu's shared invoke() throws results away, so these calls don't use it.)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BrainrotData = require(Shared:WaitForChild("BrainrotData"))
local BrainrotModels = require(Shared:WaitForChild("BrainrotModels"))
local CosmeticData = require(Shared:WaitForChild("CosmeticData"))
local ProgressionData = require(Shared:WaitForChild("ProgressionData"))
local Rarity = require(Shared:WaitForChild("Rarity"))
local WeaponData = require(Shared:WaitForChild("WeaponData"))

local UiKit = require(script.Parent:WaitForChild("UiKit"))
local UiParts = require(script.Parent:WaitForChild("UiParts"))

local create, rounded, formatNumber = UiKit.create, UiKit.rounded, UiKit.formatNumber
local C = UiKit.Colors

local ProgressionPanel = {}

-- Style tokens. Everything else comes from UiKit.Colors (C). A menu-wide restyle should only need to
-- change UiKit and this block: these are the panel's only own colours and fonts.
local BRAIN = Color3.fromRGB(255, 150, 176) -- Brain Cells: the currency's colour
local BRAIN_DARK = Color3.fromRGB(120, 44, 70)
local DIM = Color3.fromRGB(70, 74, 92) -- locked / not yet earned outlines
local BLACK = Color3.new(0, 0, 0) -- text on bright buttons
local FONT = {
	Display = Enum.Font.FredokaOne, -- big numbers and headings
	Bold = Enum.Font.GothamBold, -- labels and buttons
	Body = Enum.Font.Gotham, -- descriptions
}

-- `short` is used when five tabs have to share a phone's width in portrait. "CELL SHOP" at 55 px
-- would be clipped to "CELL S", which reads as a different word rather than a shorter one.
local VIEWS = {
	{ key = "Pass", label = "PASS", short = "PASS" },
	{ key = "Rank", label = "RANK", short = "RANK" },
	{ key = "Mastery", label = "MASTERY", short = "GUNS" },
	{ key = "Index", label = "INDEX", short = "INDEX" },
	{ key = "Shop", label = "CELL SHOP", short = "SHOP" },
}

ProgressionPanel.View = "Pass"
-- Mastery list filter ("All" or a rarity) and the Index page on show.
ProgressionPanel.MasteryFilter = "All"
ProgressionPanel.IndexRarity = "Common"

-- The last server answer: { text, ok, at }. Shown for STATUS_SECONDS.
local status = nil
local STATUS_SECONDS = 6
-- PRESTIGE takes two presses: the first arms it for CONFIRM_SECONDS.
local prestigeArmedAt = nil
local CONFIRM_SECONDS = 5
-- One call at a time, so a double-click can't send twice.
local busy = false

-- When the current snapshot arrived, to tick the shop countdown down between pushes.
local snapshotSeen, snapshotAt = nil, 0

function ProgressionPanel.SetView(name)
	for _, view in ipairs(VIEWS) do
		if view.key == name then
			ProgressionPanel.View = name
			return true
		end
	end
	return false
end

local function now(ctx)
	return ctx and ctx.now or os.clock()
end

local function hex(color)
	return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5))
end

--------------------------------------------------------------------------------
-- How much room the page has
--------------------------------------------------------------------------------
-- The menu's list is 728 wide on a desktop, 603 on a landscape phone and as little as 296 in
-- portrait. Rows here used to size their text as `UDim2.new(1, -350, ...)`, which is right at 728 and
-- NEGATIVE at 296 -- and a negative width in Roblox doesn't truncate the text, it draws nothing at
-- all, so the row goes blank with no sign of what happened. Everything now measures instead, and
-- below NARROW the pages stop laying out in columns and stack (Oliver: "simplify the hud to make it
-- fit"). tools/progression_width_probe.lua renders every page from 728 down to 296 and fails on
-- anything that comes out at zero.
local page = { width = 728, narrow = false, mode = "large" }

-- Which VERSION of the pages a device gets: `large`, `short` or `tall`. Oliver asked for separate
-- versions rather than one layout shrinking through breakpoints, and the decision has to be one
-- function the menu shell and these pages both call, or the shell places a page one version thinks it
-- is in while the page draws another. `UiKit.form(viewport)` is that function (claude-ee's, ruled by
-- claude-43); this defers to it and falls back to the same rule until it lands.
--
-- The names say WHICH DIMENSION RAN OUT, which is the whole insight: a 768x1024 tablet in portrait
-- has 728 px of panel and is `large`, not small, because nothing has run out. `tall` is a screen
-- whose width ran out (a phone in portrait, 296-350 px of content) and `short` one whose height did
-- (an 844x390 phone in landscape: desktop-wide, almost no rows).
-- Set by tools/progression_width_probe.lua only, to render a version this machine's window can't
-- produce: `short` depends on the viewport's HEIGHT, and a probe frame can only choose a width.
-- Game code never sets it.
ProgressionPanel.ViewportForTest = nil

local function modeFor(width)
	local camera = workspace.CurrentCamera
	local viewport = ProgressionPanel.ViewportForTest or (camera and camera.ViewportSize) or Vector2.new(1920, 1080)
	-- The measured width of the LIST these pages draw into, not the viewport: a row inside a 356 px
	-- card is `tall` on a 1920 monitor, because the row has 356 px whatever the screen has.
	return UiKit.form(viewport, width)
end

local function measure(content)
	-- AbsoluteSize is 0 for a frame that hasn't been laid out yet (the first render of a fresh menu),
	-- and a 0 would make every row take its minimum. The desktop width is the safer guess, and the
	-- watcher below redraws the moment the real size arrives.
	local width = content.AbsoluteSize.X
	page.width = width &gt; 0 and width or 728
	page.mode = modeFor(page.width)
	-- `narrow` is the stacked version, which is what a screen out of WIDTH needs. A `short` screen has
	-- the width for the large layout and wants fewer, flatter rows instead -- a different job, not this
	-- one, so it keeps the large layout until that version is built rather than being handed a stacked
	-- page 780 px wide.
	page.narrow = page.mode == "tall"
	-- What the last render actually measured, so tools/progression_width_probe.lua can prove it drew
	-- the page at the width it meant to rather than at the fallback.
	ProgressionPanel.LastWidth = page.width
	ProgressionPanel.LastMode = page.mode
	return page
end

-- The width of a column starting at `left` that keeps `right` px clear on the other side. Never
-- returns less than `minimum`, so a row can be tight or clipped but never invisible.
--
-- Everything on these pages sits inside a card or a row built as `UDim2.new(1, -CARD_INSET, ...)`,
-- so the room a column really has is the page minus that inset. Measuring against the page itself
-- would make every column 8 px too wide -- invisible at 728, an overlap at 296.
local CARD_INSET = 8
local function span(left, right, minimum)
	return math.max(minimum or 80, page.width - CARD_INSET - left - (right or 14))
end

-- True when a column starting at `left` with `right` px kept clear really has `needed` px, before any
-- minimum is applied. `span` floors its result so nothing can vanish, but a floored width is a column
-- overlapping its neighbour -- fine for a label on its own, wrong for a secondary one that would sit
-- on top of the numbers beside it. Those ask this first and are dropped when the answer is no. It
-- matters at the boundary: `large` starts at 600 px of content, not 728, and a 603 px landscape phone
-- has 133 px less room than the layout was drawn against.
local function roomFor(left, right, needed)
	return page.width - CARD_INSET - left - right &gt;= needed
end

-- Redraw when the menu changes width, once per content frame: the pages pick a different shape either
-- side of NARROW, and a player who rotates their phone would otherwise keep the old one until
-- something else happened to redraw.
local watched = setmetatable({}, { __mode = "k" })
local function watchWidth(content, ctx)
	if watched[content] or not (ctx and ctx.rerender) then
		return
	end
	watched[content] = true
	content:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		local width = content.AbsoluteSize.X
		if width &gt; 0 and modeFor(width) ~= page.mode then
			ctx.rerender()
		end
	end)
end

local function label(parent, props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or FONT.Bold
	props.TextColor3 = props.TextColor3 or C.Text
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.Parent = parent
	return create("TextLabel", props)
end

local function card(content, order, height, stroke)
	local frame = create("Frame", {
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = content,
	}, { rounded(10) })
	if stroke then
		create("UIStroke", { Color = stroke, Thickness = 1.5, Transparency = 0.45, Parent = frame })
	end
	return frame
end

local function button(parent, props, enabled, color, onClick)
	props.BackgroundColor3 = enabled and color or C.PanelAlt
	props.BorderSizePixel = 0
	props.Font = props.Font or FONT.Bold
	props.TextColor3 = enabled and BLACK or C.Muted
	props.TextSize = props.TextSize or 13
	props.AutoButtonColor = enabled
	props.Parent = parent
	local instance = create("TextButton", props, { rounded(8) })
	if enabled and onClick then
		instance.Activated:Connect(onClick)
	end
	return instance
end

-- The fill is named so tools/progression_width_probe.lua can tell a bar at 0%% -- which is legitimately
-- zero pixels wide -- from a row that vanished because its width went negative.
local function bar(parent, props, ratio, color)
	local back = create("Frame", {
		Name = "Meter",
		Position = props.Position,
		Size = props.Size,
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
		Parent = parent,
	}, { rounded(props.radius or 6) })
	create("Frame", {
		Name = "MeterFill",
		Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = back,
	}, { rounded(props.radius or 6) })
	return back
end

-- A little pink brain-cell coin: the currency's icon everywhere on these pages.
-- Upgraded 2026-09-22 (Oliver: "upgrade the icons in the progression menu"): a minted coin rather
-- than a flat disc -- a lit face, a darker rim, a highlight, and a little brain in place of the "b".
local function cellIcon(parent, size, position)
	local icon = create("Frame", {
		Position = position,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = BRAIN,
		BorderSizePixel = 0,
		Parent = parent,
	}, { rounded(size) })
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(255, 196, 212), Color3.fromRGB(232, 104, 140)),
		Parent = icon,
	})
	create("UIStroke", { Color = BRAIN_DARK, Thickness = math.max(1, size / 10), Parent = icon })
	-- The inner ring of a struck coin.
	local face = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.74, 0.74),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = icon,
	}, { rounded(size) })
	create("UIStroke", { Color = Color3.fromRGB(255, 226, 234), Thickness = math.max(1, size / 20), Transparency = 0.35, Parent = face })
	-- Highlight, top left.
	create("Frame", {
		Position = UDim2.fromScale(0.2, 0.14),
		Size = UDim2.fromScale(0.3, 0.16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Rotation = -30,
		Parent = icon,
	}, { rounded(size) })
	label(icon, {
		Size = UDim2.fromScale(1, 1),
		Font = FONT.Display,
		Text = "🧠",
		TextColor3 = BRAIN_DARK,
		TextSize = math.floor(size * 0.58),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	return icon
end

local function photo(parent, def, size, silhouette)
	local viewport = create("ViewportFrame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
		Ambient = Color3.fromRGB(170, 170, 182),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-0.4, -1, 0.6),
		Parent = parent,
	}, { rounded(10) })
	local model = BrainrotModels.Build(def)
	if silhouette then
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") and part.Transparency &lt; 1 then
				part.Color = Color3.fromRGB(16, 16, 22)
				part.Material = Enum.Material.SmoothPlastic
			end
		end
	end
	model.Parent = viewport
	BrainrotModels.FrameViewport(viewport, def)
	return viewport
end

-- The prestige emblem: a turned square in the prestige's colour with its number on top.
local function emblem(parent, prestige, size, position)
	local info = ProgressionData.PrestigeInfo(prestige)
	local holder = create("Frame", {
		Position = position,
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local inner = size * 0.7
	local diamond = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(inner, inner),
		Rotation = 45,
		BackgroundColor3 = prestige &gt; 0 and info.color or C.PanelAlt,
		BorderSizePixel = 0,
		Parent = holder,
	}, { rounded(math.floor(size * 0.12)) })
	create("UIStroke", { Color = prestige &gt; 0 and C.Text or DIM, Thickness = 2, Transparency = prestige &gt; 0 and 0.2 or 0, Parent = diamond })
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 180)),
		Parent = diamond,
	})
	if prestige &gt; 0 then
		-- An outer frame a step out from the gem, in the prestige colour, and a soft glow behind.
		local glow = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size * 0.98, size * 0.98),
			BackgroundColor3 = info.color,
			BackgroundTransparency = 0.8,
			BorderSizePixel = 0,
			Parent = holder,
		}, { rounded(size) })
		-- Behind the gem and the number, which are its siblings.
		glow.ZIndex = diamond.ZIndex - 1
		local frame = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(inner * 1.2, inner * 1.2),
			Rotation = 45,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = holder,
		}, { rounded(math.floor(size * 0.14)) })
		create("UIStroke", { Color = info.color, Thickness = math.max(1, size / 28), Transparency = 0.25, Parent = frame })
		-- A light facet across the top half of the gem.
		create("Frame", {
			Position = UDim2.fromScale(0, 0),
			Size = UDim2.fromScale(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.7,
			BorderSizePixel = 0,
			Parent = diamond,
		}, { rounded(math.floor(size * 0.1)) })
		if prestige &gt;= 5 then
			label(holder, {
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, -math.floor(size * 0.12)),
				Size = UDim2.fromOffset(size, math.floor(size * 0.3)),
				Font = FONT.Display,
				Text = prestige &gt;= 10 and "★★★" or "★",
				TextColor3 = Color3.fromRGB(255, 220, 90),
				TextSize = math.floor(size * 0.24),
				TextXAlignment = Enum.TextXAlignment.Center,
			})
		end
	end
	label(holder, {
		Size = UDim2.fromScale(1, 1),
		Font = FONT.Display,
		Text = prestige &gt; 0 and tostring(prestige) or "—",
		TextColor3 = prestige &gt; 0 and BLACK or C.Muted,
		TextSize = math.floor(size * 0.36),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	return holder
end

local function cosmeticName(entry)
	local item = entry and CosmeticData.Get(entry.id)
	if not item then
		return "reward"
	end
	local kindWord = item.kind == "GunSkin" and "gun skin" or string.lower(item.kind)
	-- "Silver Rot Aura", not "Silver Rot Aura aura".
	if string.find(string.lower(item.name), string.lower(item.kind == "GunSkin" and "skin" or item.kind), 1, true) then
		return item.name
	end
	return string.format("%s %s", item.name, kindWord)
end

-- A rank cosmetic as a small tile: a gun silhouette in the skin's colour, or a glowing ring for an
-- aura, with a caption on top and the name underneath. Dimmed until owned, unless `forSale` (a shop
-- listing, where it should look its best and needs no tick).
local function cosmeticSwatch(parent, item, isOwned, caption, width, height, forSale)
	local tile = create("Frame", {
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = isOwned and C.PanelAlt or C.Panel,
		BorderSizePixel = 0,
		Parent = parent,
	}, { rounded(10) })
	create("UIStroke", { Color = isOwned and item.color or DIM, Thickness = isOwned and 2 or 1, Transparency = isOwned and 0.1 or 0.3, Parent = tile })
	label(tile, {
		Position = UDim2.fromOffset(0, 5),
		Size = UDim2.new(1, 0, 0, 13),
		Text = caption,
		TextColor3 = isOwned and C.Text or C.Muted,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local art = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 22),
		Size = UDim2.fromOffset(44, 34),
		BackgroundTransparency = 1,
		Parent = tile,
	})
	local fade = (isOwned or forSale) and 0 or 0.55
	-- The real thing, turning, through Shared/CosmeticPreview (the same builder the shop uses). The flat
	-- drawing below is only the fallback if the preview module can't load.
	local okPreview, preview = pcall(require, Shared:WaitForChild("CosmeticPreview"))
	if okPreview and preview and item.id then
		art.Position = UDim2.new(0.5, 0, 0, 20)
		art.Size = UDim2.fromOffset(math.min(width - 10, 58), math.min(height - 38, 44))
		create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = art })
		local shown = pcall(preview.Fill, art, item.id, { background = C.Panel, backgroundTransparency = 1 })
		if shown then
			local viewport = art:FindFirstChild("CosmeticPreview")
			if viewport and not (isOwned or forSale) then
				-- Not earned yet: the same model, dimmed.
				viewport.ImageTransparency = 0.45
				viewport.ImageColor3 = Color3.fromRGB(150, 150, 165)
			end
		end
		if shown then
			if forSale then
				return tile
			end
			label(tile, {
				Position = UDim2.new(0, 3, 1, -34),
				Size = UDim2.new(1, -6, 0, 28),
				Font = FONT.Bold,
				Text = isOwned and ("✓ " .. item.name) or item.name,
				TextColor3 = isOwned and C.Green or C.Muted,
				TextWrapped = true,
				TextSize = 10,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Top,
			})
			return tile
		end
	end
	if item.kind == "Aura" then
		local ring = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = item.color,
			BackgroundTransparency = 0.55 + fade * 0.4,
			BorderSizePixel = 0,
			Parent = art,
		}, { rounded(15) })
		create("UIStroke", { Color = item.color, Thickness = 3, Transparency = fade, Parent = ring })
	else
		-- Body, barrel and grip.
		for _, piece in ipairs({ { 4, 10, 30, 10 }, { 32, 12, 12, 5 }, { 8, 19, 8, 12 } }) do
			create("Frame", {
				Position = UDim2.fromOffset(piece[1], piece[2]),
				Size = UDim2.fromOffset(piece[3], piece[4]),
				BackgroundColor3 = item.color,
				BackgroundTransparency = fade,
				BorderSizePixel = 0,
				Parent = art,
			}, { rounded(2) })
		end
	end
	if forSale then
		return tile
	end
	label(tile, {
		Position = UDim2.new(0, 3, 1, -34),
		Size = UDim2.new(1, -6, 0, 28),
		Font = FONT.Bold,
		Text = isOwned and not forSale and ("✓ " .. item.name) or item.name,
		TextColor3 = isOwned and not forSale and C.Green or C.Muted,
		TextWrapped = true,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	return tile
end

local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	if seconds &gt;= 3600 then
		return string.format("%dh %02dm", seconds // 3600, (seconds % 3600) // 60)
	end
	return string.format("%dm %02ds", seconds // 60, seconds % 60)
end

--------------------------------------------------------------------------------
-- Server calls
--------------------------------------------------------------------------------

-- Invokes a progression remote off the render thread and shows its answer on the page.
local function call(ctx, remoteName, ...)
	if busy then
		return
	end
	busy = true
	local args = table.pack(...)
	task.spawn(function()
		local ok, success, message = pcall(function()
			local Remotes = require(Shared:WaitForChild("Remotes"))
			return Remotes.Function(remoteName):InvokeServer(table.unpack(args, 1, args.n))
		end)
		busy = false
		if not ok then
			status = { text = "Couldn't reach the server. Try again.", ok = false, at = os.clock() }
		else
			status = { text = tostring(message or (success and "Done." or "Couldn't do that.")), ok = success == true, at = os.clock() }
		end
		pcall(function()
			local Sfx = require(script.Parent:WaitForChild("Sfx"))
			Sfx.Play(status.ok and "Gold" or "UiClick", 0.05)
		end)
		if ctx and ctx.rerender then
			ctx.rerender()
		end
	end)
end

local function click()
	pcall(function()
		require(script.Parent:WaitForChild("Sfx")).Play("UiClick", 0.08)
	end)
end

--------------------------------------------------------------------------------
-- Toggle row and status line
--------------------------------------------------------------------------------

local function claimableCount(progression)
	local count = 0
	for _, state in pairs(progression.index) do
		if state == ProgressionData.Recorded then
			count += 1
		end
	end
	return count
end

local function renderToggle(content, progression, ctx)
	-- Wide: five tabs with the Brain Cells chip beside them. Narrow: the chip takes its own line and
	-- the tabs share the full width below it, with short labels, because five tabs and a 172 px chip
	-- on one 296 px line is how you get tabs nobody can read or hit.
	local narrow = page.narrow
	local tabPad = narrow and 4 or 6
	local tabWidth = narrow and math.max(46, math.floor((span(0, 8, 260) - tabPad * 4) / 5)) or nil
	local row = create("Frame", {
		Size = UDim2.new(1, -8, 0, narrow and 82 or 40),
		BackgroundTransparency = 1,
		LayoutOrder = -1000,
		Parent = content,
	})
	local strip = create("Frame", {
		Position = narrow and UDim2.fromOffset(0, 42) or UDim2.new(),
		Size = narrow and UDim2.new(1, 0, 0, 36) or UDim2.fromOffset(span(0, 188, 200), 40),
		BackgroundTransparency = 1,
		Parent = row,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, tabPad),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local claimable = progression and claimableCount(progression) or 0
	for index, view in ipairs(VIEWS) do
		-- Each page is its own menu tab now (MenuClient, Oliver 09-22 14:15), so the in-page tabs are
		-- skipped and only the Brain Cells chip is drawn.
		if ctx and ctx.noTabs then
			break
		end
		local selected = ProgressionPanel.View == view.key
		local text = narrow and view.short or view.label
		-- A count fits on a 96 px tab and not on a 54 px one: "INDEX 10" measured 52 px wide in the
		-- probe, which is a tab you can see is there and can't read. Narrow keeps the word and says
		-- "there is something here" with a dot instead, which is the part that has to survive.
		local dot = false
		if view.key == "Index" and claimable &gt; 0 then
			text = narrow and view.short or string.format("INDEX  %d", claimable)
			dot = narrow
		elseif view.key == "Rank" and progression and progression.canPrestige then
			text = narrow and view.short or "RANK  !"
			dot = narrow
		end
		local tab = create("TextButton", {
			Size = UDim2.fromOffset(tabWidth or (view.key == "Shop" and 104 or 96), 36),
			TextSize = narrow and 11 or 13,
			BackgroundColor3 = selected and BRAIN or C.Panel,
			BorderSizePixel = 0,
			Font = FONT.Bold,
			Text = text,
			TextColor3 = selected and BLACK or ((view.key == "Index" and claimable &gt; 0) and C.Green or C.Muted),
			LayoutOrder = index,
			Parent = strip,
		}, { rounded(8) })
		if dot then
			create("Frame", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -6, 0, 6),
				Size = UDim2.fromOffset(8, 8),
				BackgroundColor3 = view.key == "Index" and C.Green or C.Accent,
				BorderSizePixel = 0,
				Parent = tab,
			}, { rounded(4) })
		end
		tab.Activated:Connect(function()
			click()
			ProgressionPanel.View = view.key
			prestigeArmedAt = nil
			if ctx and ctx.rerender then
				ctx.rerender()
			end
		end)
	end

	local chip = create("Frame", {
		AnchorPoint = narrow and Vector2.zero or Vector2.new(1, 0),
		Position = narrow and UDim2.new() or UDim2.new(1, 0, 0, 0),
		Size = narrow and UDim2.fromOffset(span(0, 8, 160), 36) or UDim2.fromOffset(172, 36),
		BackgroundColor3 = C.Background,
		BorderSizePixel = 0,
		Parent = row,
	}, { rounded(8) })
	create("UIStroke", { Color = BRAIN, Thickness = 1.5, Transparency = 0.4, Parent = chip })
	cellIcon(chip, 22, UDim2.fromOffset(9, 7))
	label(chip, {
		Position = UDim2.fromOffset(38, 0),
		Size = UDim2.new(1, -46, 1, 0),
		Font = FONT.Display,
		Text = progression and formatNumber(progression.cells) or "…",
		TextColor3 = BRAIN,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	if status and os.clock() - status.at &lt; STATUS_SECONDS and ProgressionPanel.View ~= "Pass" then
		label(content, {
			Size = UDim2.new(1, -8, 0, 22),
			LayoutOrder = -999,
			Font = FONT.Bold,
			Text = status.text,
			TextColor3 = status.ok and C.Green or C.Red,
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
	end
end

local function sectionHeader(content, order, text, color)
	return label(content, {
		Size = UDim2.new(1, -8, 0, 28),
		LayoutOrder = order,
		Font = FONT.Display,
		Text = text,
		TextColor3 = color or C.Accent,
		TextSize = 17,
		TextYAlignment = Enum.TextYAlignment.Bottom,
	})
end

local function footnote(content, order, text)
	return label(content, {
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Font = FONT.Body,
		Text = text,
		TextColor3 = C.Muted,
		TextWrapped = true,
		TextSize = 12,
	})
end

--------------------------------------------------------------------------------
-- RANK
--------------------------------------------------------------------------------

local function renderRank(content, progression, ctx, owned)
	local prestige = progression.prestige
	local info = ProgressionData.PrestigeInfo(prestige)
	local rank = progression.rank
	local atMax = rank &gt;= ProgressionData.MaxRank

	-- Wide: the emblem, the rank beside it, and the lifetime numbers in a right-hand column.
	-- Narrow: a smaller emblem, the rank taking all the room left, and the lifetime numbers as one
	-- row underneath. The column is what gets dropped, because squeezing it costs the rank itself.
	local narrow = page.narrow
	-- A screen that ran out of HEIGHT gets fewer and flatter rows rather than narrower ones: the hero
	-- loses the lifetime numbers (they are a record, not a goal) and the COMING UP track goes below the
	-- fold, so rank, progress and PRESTIGE are all on the first screen. Content height on a 500 px
	-- viewport is about 270 px, against roughly 430 for the large layout.
	local short = page.mode == "short"
	local emblemSize = narrow and 64 or (short and 72 or 104)
	local textLeft = 14 + emblemSize + (narrow and 10 or 14)
	-- Short keeps 178 clear on the right for the PRESTIGE button that moves into the hero.
	local statsColumn = narrow and 0 or (short and 178 or 214)
	-- 116 on short, not 108: the bar sits 32 px off the bottom and the "XP to rank N" line ends at 80,
	-- so 108 had them overlapping -- visible in the gallery render, not in the arithmetic I did first.
	local hero = card(content, 1, narrow and 196 or (short and 116 or 158), prestige &gt; 0 and info.color or C.Accent)
	emblem(hero, prestige, emblemSize, UDim2.fromOffset(14, 12))

	local headWidth = span(textLeft, statsColumn + 14, 90)
	label(hero, {
		Position = UDim2.fromOffset(textLeft, 12),
		Size = UDim2.fromOffset(headWidth, 18),
		Text = prestige &gt; 0 and string.format("PRESTIGE %d  •  %s", prestige, string.upper(info.name)) or "NO PRESTIGE YET",
		TextColor3 = prestige &gt; 0 and info.color or C.Muted,
		TextSize = 13,
	})
	label(hero, {
		Position = UDim2.fromOffset(textLeft - 2, narrow and 28 or 30),
		Size = UDim2.fromOffset(headWidth, narrow and 38 or (short and 34 or 50)),
		Font = FONT.Display,
		RichText = true,
		Text = string.format('ROT RANK &lt;font color="%s"&gt;%d&lt;/font&gt;', hex(C.Accent), rank),
		TextSize = narrow and 28 or (short and 26 or 40),
	})
	label(hero, {
		Position = UDim2.fromOffset(textLeft, narrow and 68 or (short and 64 or 80)),
		Size = UDim2.fromOffset(headWidth, narrow and 32 or 18),
		Font = FONT.Body,
		Text = atMax and (progression.canPrestige and "Max rank — prestige to climb again with bigger rewards."
			or "Max rank at max prestige. Extra XP keeps paying Brain Cells.")
			or string.format("%s XP to rank %d", ProgressionData.Commas(progression.xpNeed - progression.xpInto), rank + 1),
		TextColor3 = C.Muted,
		TextWrapped = narrow,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextSize = 13,
	})

	-- Lifetime numbers: a right-hand column when there's room, a row under the rank when there isn't.
	local stats = {
		{ "LIFETIME XP", formatNumber(progression.total) },
		{ "CELLS EARNED", formatNumber(progression.cellsEarned) },
		{ "RANK CELL BONUS", string.format("+%d%%", math.floor((ProgressionData.PrestigeMultiplier(prestige) - 1) * 100 + 0.5)) },
	}
	local statWidth = narrow and math.max(64, math.floor((span(14, 14, 200) - 16) / 3)) or 200
	for index, stat in ipairs(short and {} or stats) do
		local statX = narrow and (14 + (index - 1) * (statWidth + 8)) or 0
		local statY = narrow and 116 or (12 + (index - 1) * 30)
		label(hero, {
			AnchorPoint = narrow and Vector2.zero or Vector2.new(1, 0),
			Position = narrow and UDim2.fromOffset(statX, statY) or UDim2.new(1, -14, 0, statY),
			Size = UDim2.fromOffset(statWidth, 12),
			Text = stat[1],
			TextColor3 = C.Muted,
			TextSize = 10,
			TextXAlignment = narrow and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
		})
		label(hero, {
			AnchorPoint = narrow and Vector2.zero or Vector2.new(1, 0),
			Position = narrow and UDim2.fromOffset(statX, statY + 13) or UDim2.new(1, -14, 0, statY + 11),
			Size = UDim2.fromOffset(statWidth, 18),
			Font = FONT.Display,
			Text = stat[2],
			TextColor3 = index == 2 and BRAIN or C.Text,
			TextSize = narrow and 15 or 17,
			TextXAlignment = narrow and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
		})
	end

	-- XP bar: into this rank, or the overflow toward the next Cells payout at max rank.
	local ratio, barText, barColor
	if atMax then
		ratio = progression.over / ProgressionData.OverflowXp
		barText = string.format("OVERFLOW  %s / %s XP  →  +%s", ProgressionData.Commas(progression.over),
			ProgressionData.Commas(ProgressionData.OverflowXp), ProgressionData.Cells(ProgressionData.OverflowReward(prestige)))
		barColor = BRAIN
	else
		ratio = progression.xpInto / progression.xpNeed
		barText = string.format("%s / %s XP", ProgressionData.Commas(progression.xpInto), ProgressionData.Commas(progression.xpNeed))
		barColor = C.Accent
	end
	-- Short keeps the bar clear of the PRESTIGE button that moved into this card; wide it spans the lot.
	local barWidth = short and span(14, statsColumn + 14, 120) or nil
	local barY = short and -32 or -40
	bar(hero, {
		Position = UDim2.new(0, 14, 1, barY),
		Size = barWidth and UDim2.fromOffset(barWidth, 26) or UDim2.new(1, -28, 0, 26),
		radius = 8,
	}, ratio, barColor)
	label(hero, {
		Position = UDim2.new(0, 14, 1, barY),
		Size = barWidth and UDim2.fromOffset(barWidth, 26) or UDim2.new(1, -28, 0, 26),
		Text = barText,
		TextSize = 13,
		TextStrokeTransparency = 0.5,
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	-- The next rewards along the track. On a short screen this moves BELOW the prestige card: it is
	-- the thing a player reads once a session, and PRESTIGE is the thing they came to press.
	-- 7 and 8 on a short screen, not 5 and 6: PRESTIGE REWARDS already owns those, and a tie in
	-- LayoutOrder is resolved by name, which is not an order anyone chose.
	sectionHeader(content, short and 7 or 2, "COMING UP")
	local track = create("Frame", {
		LayoutOrder = short and 8 or 3,
		Size = UDim2.new(1, -8, 0, 96),
		BackgroundTransparency = 1,
		Parent = content,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	-- The next four ranks, then the next milestones after them (crates and the big Cell payouts at
	-- every tenth rank), so a goal a few hours away is always on screen.
	local firstRank = atMax and (progression.canPrestige and 2 or nil) or rank + 1
	local nextPrestige = atMax and progression.canPrestige and prestige + 1 or prestige
	local upcoming = {}
	if firstRank then
		for candidate = firstRank, ProgressionData.MaxRank do
			local isMilestone = ProgressionData.RankCrates[candidate] ~= nil or candidate % 10 == 0 or candidate % 25 == 0
			if candidate &lt; firstRank + 4 or isMilestone then
				table.insert(upcoming, candidate)
			end
			-- Seven tiles need 700 px. Narrow, three fill the width instead of seven spilling off it; in
			-- between (a landscape phone's 632 px) as many as fit, which tools/menu_screens_check.py
			-- found running two tiles off the side.
			if #upcoming &gt;= (narrow and 3 or math.clamp(math.floor((page.width - CARD_INSET + 6) / 103), 3, 7)) then
				break
			end
		end
	end
	local shown = 0
	for index, nextRank in ipairs(upcoming) do
		local reward = ProgressionData.RankReward(nextRank, nextPrestige)
		local milestone = reward.crate or nextRank % 25 == 0 or nextRank % 10 == 0
		local skipped = index &gt; 1 and nextRank &gt; upcoming[index - 1] + 1
		local tile = create("Frame", {
			Size = UDim2.fromOffset(narrow and math.max(80, math.floor((span(0, 8, 260) - 12) / 3)) or 97, 96),
			BackgroundColor3 = milestone and C.PanelAlt or C.Panel,
			BorderSizePixel = 0,
			LayoutOrder = index,
			Parent = track,
		}, { rounded(10) })
		if milestone then
			create("UIStroke", { Color = reward.crate and C.Accent or BRAIN, Thickness = 1.5, Transparency = 0.3, Parent = tile })
		end
		label(tile, {
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.new(1, 0, 0, 14),
			Text = (skipped and "… " or "") .. (atMax and string.format("P%d  RANK %d", nextPrestige, nextRank) or ("RANK " .. nextRank)),
			TextColor3 = milestone and C.Text or C.Muted,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		local amount = create("Frame", {
			Position = UDim2.fromOffset(0, 30),
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundTransparency = 1,
			Parent = tile,
		}, {
			create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 5),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		cellIcon(amount, 18, UDim2.new()).LayoutOrder = 1
		label(amount, {
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 24),
			Font = FONT.Display,
			Text = formatNumber(reward.cells),
			TextColor3 = BRAIN,
			TextSize = 20,
			LayoutOrder = 2,
		})
		label(tile, {
			Position = UDim2.fromOffset(4, 60),
			Size = UDim2.new(1, -8, 0, 28),
			Font = FONT.Bold,
			Text = reward.crate and (string.upper(reward.crate) .. " CRATE") or (milestone and "BIG PAYOUT" or ""),
			TextColor3 = reward.crate and Rarity.Color(reward.crate) or BRAIN,
			TextWrapped = true,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		shown += 1
	end
	if shown == 0 then
		label(track, {
			Size = UDim2.new(1, 0, 1, 0),
			Font = FONT.Body,
			Text = string.format("Nothing left to unlock. Every %s XP still pays %s.",
				ProgressionData.Commas(ProgressionData.OverflowXp), ProgressionData.Cells(ProgressionData.OverflowReward(prestige))),
			TextColor3 = C.Muted,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
	end

	-- Prestige. Narrow, the button can't sit beside the text -- it drops to its own full-width row
	-- underneath, which is also a bigger tap target than a 140 px button squeezed against the edge.
	local prestigeEmblem = narrow and 44 or 62
	local prestigeLeft = 12 + prestigeEmblem + 10
	local prestigeText = span(prestigeLeft, narrow and 14 or 166, 90)
	local prestigeCard = card(content, 4, narrow and 164 or 86, progression.canPrestige and info.color or nil)
	local nextInfo = ProgressionData.PrestigeInfo(math.min(prestige + 1, ProgressionData.MaxPrestige))
	emblem(prestigeCard, math.min(prestige + 1, ProgressionData.MaxPrestige), prestigeEmblem, UDim2.fromOffset(12, 12))
	label(prestigeCard, {
		Position = UDim2.fromOffset(prestigeLeft, 12),
		Size = UDim2.fromOffset(prestigeText, 22),
		Font = FONT.Display,
		Text = prestige &gt;= ProgressionData.MaxPrestige and "MAX PRESTIGE" or string.format("PRESTIGE %d  •  %s", prestige + 1, nextInfo.name),
		TextColor3 = prestige &gt;= ProgressionData.MaxPrestige and info.color or nextInfo.color,
		TextSize = 19,
	})
	label(prestigeCard, {
		Position = UDim2.fromOffset(narrow and 14 or prestigeLeft, narrow and 62 or 36),
		Size = UDim2.fromOffset(narrow and span(14, 14, 120) or prestigeText, narrow and 44 or 40),
		Font = FONT.Body,
		Text = prestige &gt;= ProgressionData.MaxPrestige and string.format("You've reached the top. Every %s XP from here still pays Brain Cells.", ProgressionData.Commas(ProgressionData.OverflowXp))
			or string.format("At rank %d: back to rank 1, every rank reward again with +%d%% Cells, plus %s Brain Cells, the %s and a new nameplate star. Cells, mastery and Index are kept.",
				ProgressionData.MaxRank, math.floor(ProgressionData.PrestigeCellBonus * 100 * (prestige + 1) + 0.5),
				ProgressionData.Commas(ProgressionData.PrestigeReward(prestige + 1).cells), cosmeticName(ProgressionData.PrestigeCosmetic(prestige + 1))),
		TextColor3 = C.Muted,
		TextWrapped = true,
		TextSize = 12,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local armed = prestigeArmedAt and os.clock() - prestigeArmedAt &lt; CONFIRM_SECONDS
	-- On a short screen the button goes in the HERO, not in this card. An 844x390 phone gives the list
	-- 208 px: toggle, hero and this card come to about 250, so PRESTIGE would sit just below the fold —
	-- the one thing the short version exists to prevent. In the hero it lands at about 156. The card
	-- below keeps the explanation and loses its own button, because two buttons doing the same thing
	-- is worse than either.
	local prestigeHome = short and hero or prestigeCard
	button(prestigeHome, {
		AnchorPoint = (narrow and not short) and Vector2.zero or Vector2.new(1, 0.5),
		Position = short and UDim2.new(1, -14, 0.5, 0)
			or (narrow and UDim2.fromOffset(12, 108) or UDim2.new(1, -12, 0.5, 0)),
		Size = short and UDim2.fromOffset(150, 44)
			or (narrow and UDim2.fromOffset(span(12, 12, 120), 44) or UDim2.fromOffset(140, 44)),
		Text = not progression.canPrestige and (prestige &gt;= ProgressionData.MaxPrestige and "MAXED" or "RANK " .. ProgressionData.MaxRank)
			or (armed and "CONFIRM?" or "PRESTIGE"),
		TextSize = 15,
	}, progression.canPrestige and not busy, armed and C.Red or info.color, function()
		click()
		if prestigeArmedAt and os.clock() - prestigeArmedAt &lt; CONFIRM_SECONDS then
			prestigeArmedAt = nil
			call(ctx, "Prestige", prestige)
		else
			prestigeArmedAt = os.clock()
			if ctx and ctx.rerender then
				ctx.rerender()
			end
			task.delay(CONFIRM_SECONDS + 0.1, function()
				if prestigeArmedAt and os.clock() - prestigeArmedAt &gt;= CONFIRM_SECONDS and ctx and ctx.rerender then
					prestigeArmedAt = nil
					ctx.rerender()
				end
			end)
		end
	end)

	-- Every prestige's cosmetic, owned or still to earn.
	sectionHeader(content, 5, "PRESTIGE REWARDS")
	-- A grid that wraps, not a row: ten 66 px tiles are 714 px, and in a row they ran off the side of
	-- every phone (tools/menu_screens_check.py, 313 px of content on a 390 px portrait phone).
	local strip = create("Frame", {
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 6,
		Parent = content,
	}, {
		create("UIGridLayout", {
			CellSize = UDim2.fromOffset(66, 92),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for level = 1, ProgressionData.MaxPrestige do
		local entry = ProgressionData.PrestigeCosmetic(level)
		local item = entry and CosmeticData.Get(entry.id)
		if item then
			local tile = cosmeticSwatch(strip, item, owned and owned[entry.id], "P" .. level, 66, 92)
			tile.LayoutOrder = level
		end
	end

	footnote(content, 7, "Rot Rank climbs with every bit of XP you earn: placements, eliminations, quests and challenges, "
		.. "plus a bonus each time a gun reaches a new mastery tier. The Brainrot Pass is unaffected. Brain Cells can't be bought "
		.. "with Robux, and no pass boosts them.")
end

--------------------------------------------------------------------------------
-- MASTERY
--------------------------------------------------------------------------------

local function renderMastery(content, progression, ctx, owned)
	local mastery = progression.mastery
	local tiers = ProgressionData.MasteryTiers
	-- Staged guns (not in loot yet) are left out, unless this player already has points on one.
	local weapons = ProgressionData.MasteryWeapons(mastery)

	local mastered, rotmasters, started = 0, 0, 0
	for _, id in ipairs(weapons) do
		local tier = ProgressionData.MasteryTier(mastery[id])
		if tier &gt;= ProgressionData.MasteredTier then
			mastered += 1
		end
		if tier &gt;= #tiers then
			rotmasters += 1
		end
		if (mastery[id] or 0) &gt; 0 then
			started += 1
		end
	end

	-- Narrow: the three numbers share the width, the six tier pills wrap onto two rows, and the
	-- explainer on the right is dropped -- the pills below it say the same thing in numbers.
	local narrow = page.narrow
	-- Short: the three numbers, no tier ladder. The ladder is reference a player reads once; the
	-- numbers are the progress they came back for.
	local short = page.mode == "short"
	local statWidth = narrow and math.floor((span(14, 14, 120) - 12) / 3) or 124
	local statStep = statWidth + 6
	local pillColumns = narrow and 3 or 6
	-- Six 110 px pills are 690 px; a tablet's content is 683, so wide they shrink to what fits rather
	-- than the last one running off the card.
	local pillWidth = math.min(110, math.floor((span(14, 14, 120) - 6 * (pillColumns - 1)) / pillColumns))
	local pillStep = pillWidth + 6
	local summary = card(content, 1, narrow and 148 or (short and 52 or 92), C.Accent)
	-- "GOLD OR BETTER" is 96 px of text in an 81 px column, so narrow it ran into the heading beside
	-- it. The short forms say the same thing in the room there is.
	local numbers = narrow and {
		{ "GUNS", string.format("%d / %d", started, #weapons) },
		{ "GOLD+", string.format("%d / %d", mastered, #weapons) },
		{ "ROTMASTER", tostring(rotmasters) },
	} or {
		{ "GUNS USED", string.format("%d / %d", started, #weapons) },
		{ "GOLD OR BETTER", string.format("%d / %d", mastered, #weapons) },
		{ "ROTMASTER", tostring(rotmasters) },
	}
	for index, entry in ipairs(numbers) do
		label(summary, {
			Position = UDim2.fromOffset(14 + (index - 1) * statStep, 10),
			Size = UDim2.fromOffset(statWidth, 12),
			Text = entry[1],
			TextColor3 = C.Muted,
			TextSize = 10,
		})
		label(summary, {
			Position = UDim2.fromOffset(14 + (index - 1) * statStep, 22),
			Size = UDim2.fromOffset(statWidth, 26),
			Font = FONT.Display,
			Text = entry[2],
			TextColor3 = index == 3 and tiers[#tiers].color or C.Text,
			TextSize = 22,
		})
	end
	-- The tier ladder.
	for index, tier in ipairs(short and {} or tiers) do
		local column = (index - 1) % pillColumns
		local pillRow = math.floor((index - 1) / pillColumns)
		local pill = create("Frame", {
			Position = UDim2.fromOffset(14 + column * pillStep, 56 + pillRow * 32),
			Size = UDim2.fromOffset(pillWidth, 26),
			BackgroundColor3 = C.PanelAlt,
			BorderSizePixel = 0,
			Parent = summary,
		}, { rounded(13) })
		create("UIStroke", { Color = tier.color, Thickness = 1.5, Transparency = 0.2, Parent = pill })
		label(pill, {
			Size = UDim2.fromScale(1, 1),
			RichText = true,
			Text = string.format('&lt;font color="%s"&gt;%s&lt;/font&gt;  %d', hex(tier.color), string.upper(tier.name), tier.points),
			TextSize = narrow and 10 or 11,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
	end
	label(summary, {
		-- Sits to the right of the three numbers, which run to about 410 px; dropped rather than
		-- overlapping them on a narrower large screen.
		Visible = not (narrow or short) and roomFor(410, 14, 180),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.fromOffset(math.min(300, span(320, 14, 120)), 36),
		Font = FONT.Body,
		Text = string.format("Eliminations with a gun earn its mastery:\n%d per bot, %d per player.",
			ProgressionData.KillPoints.bot, ProgressionData.KillPoints.player),
		TextColor3 = C.Muted,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	-- The mastery skins, with how far along each one is.
	-- Three cards in a row while they fit, wrapping to as many as do otherwise. A grid that shares
	-- the width beats a fixed 236 that spills off the side of a phone with no sign it has.
	local skins = create("Frame", {
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = content,
	})
	UiParts.grid(skins, span(0, 0, 120), 58, 236)
	local _, bestTier = ProgressionData.MasterySummary(mastery)
	local skinOrder = 0
	for _, entry in ipairs(ProgressionData.RankCosmetics) do
		local item = (entry.mastered or entry.masteryTier) and CosmeticData.Get(entry.id)
		if item then
			skinOrder += 1
			local isOwned = owned and owned[entry.id]
			local skinCard = create("Frame", {
				BackgroundColor3 = C.Panel,
				BorderSizePixel = 0,
				LayoutOrder = skinOrder,
				Parent = skins,
			}, { rounded(10) })
			create("UIStroke", { Color = isOwned and item.color or DIM, Thickness = isOwned and 2 or 1, Transparency = 0.2, Parent = skinCard })
			local swatch = create("Frame", {
				Position = UDim2.fromOffset(10, 12),
				Size = UDim2.fromOffset(34, 34),
				BackgroundColor3 = item.color,
				BackgroundTransparency = isOwned and 0 or 0.55,
				BorderSizePixel = 0,
				Parent = skinCard,
			}, { rounded(8) })
			create("UIStroke", { Color = C.Text, Thickness = 1, Transparency = 0.6, Parent = swatch })
			local progressText
			if isOwned then
				progressText = "✓ UNLOCKED — equip it from Cosmetics"
			elseif entry.mastered then
				progressText = string.format("%d / %d guns at Gold", math.min(mastered, entry.mastered), entry.mastered)
			else
				progressText = string.format("best gun: %s", bestTier &gt; 0 and tiers[bestTier].name or "unranked")
			end
			label(skinCard, {
				Position = UDim2.fromOffset(52, 8),
				Size = UDim2.new(1, -58, 0, 18),
				Text = item.name .. " skin",
				TextColor3 = isOwned and item.color or C.Text,
				TextSize = 14,
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
			label(skinCard, {
				Position = UDim2.fromOffset(52, 27),
				Size = UDim2.new(1, -58, 0, 24),
				Font = FONT.Body,
				Text = isOwned and progressText or (ProgressionData.CosmeticRequirement(entry) .. "  •  " .. progressText),
				TextColor3 = isOwned and C.Green or C.Muted,
				TextWrapped = true,
				TextSize = 11,
				TextYAlignment = Enum.TextYAlignment.Top,
			})
		end
	end

	-- Rarity filter.
	-- Eight chips need 690 px in a row; at 296 the last four ran off the side. Narrow they wrap, and so
	-- does any width without the 690 -- a landscape phone has 632 and lost SECRET off the end.
	local wrapChips = narrow or not roomFor(0, 0, 690)
	local filterChip = wrapChips and math.max(64, math.floor((span(0, 0, 200) - 18) / 4)) or nil
	local filters = create("Frame", {
		Size = UDim2.new(1, -8, 0, wrapChips and 0 or 30),
		AutomaticSize = wrapChips and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = content,
	}, {
		wrapChips and create("UIGridLayout", {
			CellSize = UDim2.fromOffset(filterChip, 28),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}) or create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local options = { "All" }
	for _, rarity in ipairs(Rarity.Order) do
		for _, id in ipairs(weapons) do
			if WeaponData.Get(id).rarity == rarity then
				table.insert(options, rarity)
				break
			end
		end
	end
	for index, option in ipairs(options) do
		local selected = ProgressionPanel.MasteryFilter == option
		local chip = create("TextButton", {
			-- Up to eight chips (All + seven rarities) have to fit 720: 60 + 7 * 84 + 7 * 6 = 690.
			Size = UDim2.fromOffset(filterChip or (option == "All" and 60 or 84), 28),
			BackgroundColor3 = selected and (option == "All" and C.Accent or Rarity.Color(option)) or C.Panel,
			BorderSizePixel = 0,
			Font = FONT.Bold,
			Text = string.upper(option),
			TextColor3 = selected and BLACK or (option == "All" and C.Muted or Rarity.Color(option)),
			TextSize = 12,
			LayoutOrder = index,
			Parent = filters,
		}, { rounded(14) })
		chip.Activated:Connect(function()
			click()
			ProgressionPanel.MasteryFilter = option
			if ctx and ctx.rerender then
				ctx.rerender()
			end
		end)
	end

	-- Guns you've used first, most points first; then the rest in rarity order.
	local list = {}
	for index, id in ipairs(weapons) do
		local def = WeaponData.Get(id)
		if ProgressionPanel.MasteryFilter == "All" or def.rarity == ProgressionPanel.MasteryFilter then
			table.insert(list, { id = id, def = def, points = mastery[id] or 0, order = index })
		end
	end
	table.sort(list, function(a, b)
		if a.points ~= b.points then
			return a.points &gt; b.points
		end
		return a.order &lt; b.order
	end)

	for index, entry in ipairs(list) do
		local tier = ProgressionData.MasteryTier(entry.points)
		local current = tiers[tier]
		local nextTier = tiers[tier + 1]
		local rarityColor = Rarity.Color(entry.def.rarity)
		-- Wide: name and points, tier badge, then the bar and what the next tier pays, in three
		-- columns. Narrow: the same four things stacked, because the bar column is the one that goes
		-- negative first and the reward line is a promise -- it wraps rather than being cut.
		local narrow = page.narrow
		-- Tall rows are 136 because UiParts.meterLine comes to 76 px with a wrapping caption
		-- (label 20 + bar 12 + caption 36 + spacing) and it starts 48 px down, under the name.
		local row = card(content, 10 + index, narrow and 136 or 52, current and current.color or nil)
		if not current then
			row.BackgroundTransparency = 0.25
		end
		local nameWidth = narrow and span(14, 116, 90) or 230
		local meterLeft = narrow and 14 or 358
		local meterWidth = narrow and span(14, 14, 120) or span(358, 14, 120)

		create("Frame", {
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.fromOffset(4, 36),
			BackgroundColor3 = rarityColor,
			BorderSizePixel = 0,
			Parent = row,
		}, { rounded(2) })
		label(row, {
			Position = UDim2.fromOffset(14, 7),
			Size = UDim2.fromOffset(nameWidth, 20),
			Text = entry.def.name,
			TextColor3 = entry.points &gt; 0 and C.Text or C.Muted,
			TextSize = 15,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		label(row, {
			Position = UDim2.fromOffset(14, 27),
			Size = UDim2.fromOffset(narrow and nameWidth or 230, 16),
			Font = FONT.Body,
			Text = string.format("%s  •  %s mastery point%s", entry.def.rarity, ProgressionData.Commas(entry.points), entry.points == 1 and "" or "s"),
			TextColor3 = rarityColor,
			TextSize = 12,
		})

		local badge = create("Frame", {
			AnchorPoint = narrow and Vector2.new(1, 0) or Vector2.zero,
			Position = narrow and UDim2.new(1, -14, 0, 8) or UDim2.fromOffset(250, 13),
			Size = UDim2.fromOffset(96, 26),
			BackgroundColor3 = current and current.color or C.PanelAlt,
			BorderSizePixel = 0,
			Parent = row,
		}, { rounded(13) })
		label(badge, {
			Size = UDim2.fromScale(1, 1),
			Text = current and string.upper(current.name) or "UNRANKED",
			TextColor3 = current and BLACK or C.Muted,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Center,
		})

		if nextTier then
			local base = current and current.points or 0
			local fraction = (entry.points - base) / (nextTier.points - base)
			if narrow then
				-- The tall version uses the menu's shared metered line: label, bar, then what the tier
				-- pays as a caption that WRAPS. The large version keeps the shape it has -- Oliver's
				-- word on the desktop menu was that it looks good, so it isn't being redesigned here.
				local holder = create("Frame", {
					Position = UDim2.fromOffset(meterLeft, 48),
					Size = UDim2.fromOffset(meterWidth, 76),
					BackgroundTransparency = 1,
					Parent = row,
				})
				UiParts.meterLine(holder, {
					label = string.format("%d / %d to %s", entry.points, nextTier.points, string.upper(nextTier.name)),
					fraction = fraction,
					color = nextTier.color,
					caption = string.format("+%d Cells  •  +%s Rank XP at %s", nextTier.cells,
						ProgressionData.Commas(nextTier.xp), string.upper(nextTier.name)),
					narrow = true,
				})
			else
				bar(row, { Position = UDim2.fromOffset(meterLeft, 12), Size = UDim2.fromOffset(meterWidth, 12) },
					fraction, nextTier.color)
				label(row, {
					Position = UDim2.fromOffset(meterLeft, 27),
					Size = UDim2.fromOffset(meterWidth, 16),
					Font = FONT.Body,
					RichText = true,
					Text = string.format('%d / %d to &lt;font color="%s"&gt;%s&lt;/font&gt;  •  +%d Cells  +%s Rank XP',
						entry.points, nextTier.points, hex(nextTier.color), nextTier.name, nextTier.cells, ProgressionData.Commas(nextTier.xp)),
					TextColor3 = C.Muted,
					TextSize = 12,
				})
			end
		else
			label(row, {
				Position = UDim2.fromOffset(meterLeft, narrow and 52 or 0),
				Size = UDim2.fromOffset(meterWidth, narrow and 40 or 52),
				Font = FONT.Display,
				Text = "FULLY MASTERED",
				TextColor3 = current.color,
				TextSize = 18,
			})
		end
	end
end

--------------------------------------------------------------------------------
-- INDEX
--------------------------------------------------------------------------------

local function renderIndex(content, progression, ctx)
	local index = progression.index
	local counts = ProgressionData.IndexCounts(index)

	local found, total, claimableCells, claimable = 0, 0, 0, 0
	for _, rarity in ipairs(Rarity.Order) do
		found += counts[rarity].found
		total += counts[rarity].total
	end
	for name, state in pairs(index) do
		local def = BrainrotData.Get(name)
		if def and state == ProgressionData.Recorded then
			claimable += 1
			claimableCells += ProgressionData.DiscoverCells[def.rarity] or 0
		end
	end

	-- Wide: the count and its bar on the left, the explainer beside them, CLAIM ALL on the right.
	-- Narrow: count, bar, then CLAIM ALL as its own full-width row, and the explainer is dropped --
	-- the page's own contents say what it is, and a tap target beats a sentence at 296 px.
	local narrow = page.narrow
	-- Short: the same card without the explainer and with the bar tucked under the count, so the
	-- rarity pages and the first row of portraits are on the first screen.
	local short = page.mode == "short"
	local countWidth = narrow and span(14, 14, 120) or 300
	local summary = card(content, 1, narrow and 142 or (short and 64 or 86), claimable &gt; 0 and C.Green or BRAIN)
	label(summary, {
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.fromOffset(countWidth, 14),
		Text = "ROT INDEX",
		TextColor3 = C.Muted,
		TextSize = 11,
	})
	label(summary, {
		Position = UDim2.fromOffset(14, short and 20 or 24),
		Size = UDim2.fromOffset(countWidth, short and 26 or 34),
		Font = FONT.Display,
		RichText = true,
		Text = string.format('%d &lt;font color="%s"&gt;/ %d discovered&lt;/font&gt;', found, hex(C.Muted), total),
		TextSize = 30,
	})
	bar(summary, { Position = UDim2.fromOffset(14, short and 48 or 62), Size = UDim2.fromOffset(countWidth, short and 8 or 12) },
		total &gt; 0 and found / total or 0, BRAIN)
	label(summary, {
		-- Dropped when it doesn't fit: the pages below say what the Index is anyway.
		Visible = not (narrow or short) and roomFor(330, 196, 150),
		Position = UDim2.fromOffset(330, 14),
		Size = UDim2.fromOffset(span(330, 196, 120), 60),
		Font = FONT.Body,
		Text = "Every brainrot you ever own stays here for good. Claim each one once for Brain Cells; a full page pays a bonus.",
		TextColor3 = C.Muted,
		TextWrapped = true,
		TextSize = 12,
	})
	button(summary, {
		AnchorPoint = narrow and Vector2.zero or Vector2.new(1, 0.5),
		Position = narrow and UDim2.fromOffset(12, 86) or UDim2.new(1, -12, 0.5, 0),
		Size = narrow and UDim2.fromOffset(span(12, 12, 120), 44) or UDim2.fromOffset(170, 48),
		Text = claimable &gt; 0 and string.format("CLAIM ALL %d\n+%s CELLS", claimable, formatNumber(claimableCells)) or "ALL CLAIMED",
		TextSize = 14,
	}, claimable &gt; 0 and not busy, C.Green, function()
		click()
		call(ctx, "ClaimIndex", nil)
	end)

	-- Rarity pages.
	-- Seven rarity chips need 721 px in a row. At 296 only three fitted and the other four ran off the
	-- side with nothing to say they were there, so narrow they wrap onto as many rows as it takes.
	-- Wide without the 721 px (a landscape phone) they wrap too.
	local wrapPages = narrow or not roomFor(0, 0, 721)
	local pageChip = wrapPages and math.max(64, math.floor((span(0, 0, 200) - 15) / 4)) or 98
	local pages = create("Frame", {
		Size = UDim2.new(1, -8, 0, wrapPages and 0 or 40),
		AutomaticSize = wrapPages and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = content,
	}, {
		wrapPages and create("UIGridLayout", {
			CellSize = UDim2.fromOffset(pageChip, 40),
			CellPadding = UDim2.fromOffset(5, 5),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}) or create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for order, rarity in ipairs(Rarity.Order) do
		local count = counts[rarity]
		local selected = ProgressionPanel.IndexRarity == rarity
		local color = Rarity.Color(rarity)
		local waiting = 0
		for name, state in pairs(index) do
			local def = state == ProgressionData.Recorded and BrainrotData.Get(name)
			if def and def.rarity == rarity then
				waiting += 1
			end
		end
		local chip = create("TextButton", {
			Size = UDim2.fromOffset(pageChip, 40),
			BackgroundColor3 = selected and color or C.Panel,
			BorderSizePixel = 0,
			Font = FONT.Bold,
			RichText = true,
			Text = string.format("%s\n%d/%d%s", string.upper(rarity), count.found, count.total, waiting &gt; 0 and "  •" or ""),
			TextColor3 = selected and BLACK or color,
			TextSize = 11,
			LayoutOrder = order,
			Parent = pages,
		}, { rounded(8) })
		if progression.pages[rarity] then
			-- Border mode: on a TextButton a contextual stroke outlines the TEXT, which garbled the label.
			create("UIStroke", { Color = C.Accent, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = chip })
		end
		chip.Activated:Connect(function()
			click()
			ProgressionPanel.IndexRarity = rarity
			if ctx and ctx.rerender then
				ctx.rerender()
			end
		end)
	end

	-- The chosen page.
	local rarity = ProgressionPanel.IndexRarity
	local count = counts[rarity]
	local color = Rarity.Color(rarity)
	local pageDone = progression.pages[rarity] == true
	-- Narrow this used to truncate to "…page bon", which reads as a broken sentence rather than a
	-- shorter one. The short form says the same thing in the room there is.
	sectionHeader(content, 3, narrow
		and string.format("%s  •  %d/%d  •  BONUS %s%s", string.upper(rarity), count.claimed, count.total,
			ProgressionData.Commas(ProgressionData.PageBonus[rarity] or 0), pageDone and " (paid)" or "")
		or string.format("%s PAGE  •  %d / %d claimed  •  page bonus %s Cells%s", string.upper(rarity),
			count.claimed, count.total, ProgressionData.Commas(ProgressionData.PageBonus[rarity] or 0), pageDone and " (paid)" or ""), color)

	local grid = create("Frame", {
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 4,
		Parent = content,
	})
	-- As many columns as fit, sharing the width between them, through the menu's own grid helper --
	-- one implementation of this sum in the project rather than one per page. Tiles stay tall enough
	-- for a 32-pixel CLAIM button: a comfortable tap.
	UiParts.grid(grid, span(0, 0, 120), 80, 170)
	for order, def in ipairs(BrainrotData.OfRarity(rarity)) do
		local state = index[def.name]
		local tile = create("Frame", {
			BackgroundColor3 = C.Panel,
			BackgroundTransparency = state and 0 or 0.4,
			BorderSizePixel = 0,
			LayoutOrder = order,
			Parent = grid,
		}, { rounded(10) })
		create("UIStroke", {
			Color = state == ProgressionData.Recorded and C.Green or color,
			Thickness = state == ProgressionData.Recorded and 2 or 1.25,
			Transparency = state and 0.2 or 0.8,
			Parent = tile,
		})
		photo(tile, def, 60, not state).Position = UDim2.fromOffset(7, 10)
		label(tile, {
			Position = UDim2.fromOffset(70, 8),
			Size = UDim2.new(1, -76, 0, 30),
			Text = state and def.name or "???",
			TextColor3 = state and C.Text or C.Muted,
			TextWrapped = true,
			TextSize = 12,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		local reward = ProgressionData.DiscoverCells[rarity] or 0
		if state == ProgressionData.Recorded then
			button(tile, {
				Position = UDim2.new(0, 70, 1, -38),
				Size = UDim2.new(1, -78, 0, 32),
				Text = "CLAIM +" .. formatNumber(reward),
				TextSize = 12,
			}, not busy, C.Green, function()
				click()
				call(ctx, "ClaimIndex", def.name)
			end)
		elseif state == ProgressionData.Purchased then
			-- Bought with Robux: shown, but it pays only once it turns up in a crate or the Cell Shop.
			label(tile, {
				Position = UDim2.new(0, 70, 1, -32),
				Size = UDim2.new(1, -78, 0, 28),
				Font = FONT.Body,
				-- Plain words at the old line lengths (the tile is not re-laid out): "pull it in play" was
				-- jargon, and it must say COIN crate -- a Robux-crate pull is logged as Purchased too (#86).
				Text = "BOUGHT — get one\nfrom a coin crate",
				TextColor3 = C.Muted,
				TextSize = 11,
				TextYAlignment = Enum.TextYAlignment.Top,
			})
		else
			label(tile, {
				Position = UDim2.new(0, 70, 1, -28),
				Size = UDim2.new(1, -78, 0, 20),
				Text = state and "✓ CLAIMED" or string.format("%s Cells", ProgressionData.Commas(reward)),
				TextColor3 = state and color or DIM,
				TextSize = 12,
			})
		end
	end
end

--------------------------------------------------------------------------------
-- CELL SHOP
--------------------------------------------------------------------------------

local function renderShop(content, progression, profile, ctx)
	local shop = progression.shop
	local offers = ProgressionData.ShopOffers(shop.day)
	local resetIn = shop.resetIn - (now(ctx) - snapshotAt)

	-- Narrow: the restock clock takes its own line under the title instead of sitting to the right of
	-- it, and the explainer wraps rather than running past the edge on one line.
	local narrow = page.narrow
	-- Short: title and restock clock only. The sentence explaining the shop is the first thing to go
	-- when rows are the scarce thing.
	local short = page.mode == "short"
	local header = card(content, 1, narrow and 104 or (short and 40 or 58), BRAIN)
	label(header, {
		Position = UDim2.fromOffset(14, short and 6 or 8),
		Size = UDim2.new(1, -28, 0, 26),
		Font = FONT.Display,
		Text = "CELL SHOP",
		TextColor3 = BRAIN,
		TextSize = 22,
	})
	label(header, {
		Visible = not short,
		Position = UDim2.fromOffset(14, narrow and 56 or 32),
		Size = UDim2.new(1, -28, 0, narrow and 40 or 18),
		Font = FONT.Body,
		Text = narrow and "Today's picks, the same for everyone: each brainrot once a day, two snacks."
			or "Today's picks, the same for everyone: each brainrot once a day, two snacks — spend Brain Cells on the exact brainrot you're after.",
		TextColor3 = C.Muted,
		TextWrapped = narrow,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextSize = 12,
	})
	label(header, {
		AnchorPoint = narrow and Vector2.zero or Vector2.new(1, 0),
		Position = narrow and UDim2.fromOffset(14, 34) or UDim2.new(1, -14, 0, 10),
		Size = UDim2.fromOffset(narrow and span(14, 14, 120) or 220, 20),
		TextXAlignment = narrow and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
		Text = "RESTOCKS IN " .. formatTime(resetIn),
		TextColor3 = C.Text,
		TextSize = 13,
	})

	-- Four offer tiles across a desktop menu; on a phone they wrap instead of running off the page.
	local row = create("Frame", {
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = content,
	})
	local _, _, offerCell = UiParts.grid(row, span(0, 0, 120), 244, 174)

	local owned = {}
	for _, entry in ipairs(profile.brainrots or {}) do
		owned[entry.name] = entry.count
	end

	local snack = nil
	for order, offer in ipairs(offers) do
		if offer.kind == "Snack" then
			snack = offer
		elseif offer.kind == "Brainrot" then
			local def = offer.brainrot and BrainrotData.Get(offer.brainrot)
			local color = def and Rarity.Color(def.rarity) or C.Muted
			local bought = shop.bought[offer.id] or 0
			local soldOut = bought &gt;= offer.limit
			local tile = create("Frame", {
				BackgroundColor3 = C.Panel,
				BorderSizePixel = 0,
				LayoutOrder = order,
				Parent = row,
			}, { rounded(12) })
			create("UIStroke", { Color = color, Thickness = 2, Transparency = soldOut and 0.7 or 0.2, Parent = tile })
			if def then
				-- Centred in whatever the cell turned out to be, rather than 27 px from the left of a
				-- tile that is no longer always 174 wide.
				photo(tile, def, 120, false).Position = UDim2.fromOffset(math.floor((offerCell - 120) / 2), 10)
			end
			label(tile, {
				Position = UDim2.fromOffset(8, 134),
				Size = UDim2.new(1, -16, 0, 34),
				Text = def and def.name or "—",
				TextWrapped = true,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Center,
			})
			local copies = def and owned[def.name] or 0
			local isNew = def and not progression.index[def.name]
			label(tile, {
				Position = UDim2.fromOffset(8, 168),
				Size = UDim2.new(1, -16, 0, 30),
				Font = FONT.Body,
				RichText = true,
				Text = string.format('&lt;font color="%s"&gt;&lt;b&gt;%s&lt;/b&gt;&lt;/font&gt;\n%s', hex(color), def and string.upper(def.rarity) or "",
					isNew and '&lt;font color="#5ED67A"&gt;NEW FOR YOUR INDEX&lt;/font&gt;' or string.format("you own %d", copies)),
				TextColor3 = C.Muted,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Center,
			})
			local affordable = progression.cells &gt;= offer.price
			local buy = button(tile, {
				Position = UDim2.new(0, 8, 1, -42),
				Size = UDim2.new(1, -16, 0, 34),
				Text = soldOut and "BOUGHT TODAY" or "",
				TextSize = 15,
			}, not soldOut and affordable and not busy and def ~= nil, BRAIN, function()
				click()
				call(ctx, "BuyCellOffer", offer.id, shop.day)
			end)
			if not soldOut then
				cellIcon(buy, 18, UDim2.new(0.5, -34, 0.5, -9))
				label(buy, {
					Position = UDim2.new(0.5, -12, 0, 0),
					Size = UDim2.new(0, 60, 1, 0),
					Font = FONT.Display,
					Text = formatNumber(offer.price),
					TextColor3 = affordable and BLACK or C.Muted,
					TextSize = 17,
				})
			end
		end
	end

	if snack then
		local bought = shop.bought[snack.id] or 0
		local companion = profile.companion
		local def = companion and BrainrotData.Get(companion)
		local xp = progression.companionXp or 0
		local cap = (BrainrotData.MaxLevel - 1) * BrainrotData.XpPerLevel
		local level = BrainrotData.LevelForXp(xp)
		local after = BrainrotData.LevelForXp(math.min(cap, xp + snack.xp))
		-- Taller narrow: the buy button sits under the text instead of beside it.
		local snackCard = card(content, 3, page.narrow and 186 or 84, C.Green)
		if def then
			photo(snackCard, def, 64, false).Position = UDim2.fromOffset(10, 10)
		else
			local empty = create("Frame", {
				Position = UDim2.fromOffset(10, 10),
				Size = UDim2.fromOffset(64, 64),
				BackgroundColor3 = C.PanelAlt,
				BorderSizePixel = 0,
				Parent = snackCard,
			}, { rounded(10) })
			label(empty, {
				Size = UDim2.fromScale(1, 1),
				Font = FONT.Display,
				Text = "?",
				TextColor3 = C.Muted,
				TextSize = 30,
				TextXAlignment = Enum.TextXAlignment.Center,
			})
		end
		local snackNarrow = page.narrow
		local snackText = snackNarrow and span(86, 14, 100) or span(86, 194, 120)
		label(snackCard, {
			Position = UDim2.fromOffset(86, 10),
			Size = UDim2.fromOffset(snackText, 22),
			Font = FONT.Display,
			Text = string.format("COMPANION SNACK  •  %d / %d today", bought, snack.limit),
			TextColor3 = C.Green,
			TextSize = 18,
		})
		label(snackCard, {
			-- Below the companion portrait, not across it.
			Position = UDim2.fromOffset(snackNarrow and 14 or 86, snackNarrow and 84 or 34),
			Size = UDim2.fromOffset(snackNarrow and span(14, 14, 120) or snackText, 44),
			Font = FONT.Body,
			Text = not def and string.format("+%d companion XP for the brainrot following you. Equip a companion on the Brainrots tab first.", snack.xp)
				or xp &gt;= cap and string.format("%s is max level (%d). Nothing left to feed.", companion, BrainrotData.MaxLevel)
				or string.format("+%d XP for %s: level %d → %d. Every level adds %d%% damage and health.", snack.xp, companion, level, after,
					math.floor(BrainrotData.BonusPerLevel * 100 + 0.5)),
			TextColor3 = C.Muted,
			TextWrapped = true,
			TextSize = 12,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		local affordable = progression.cells &gt;= snack.price
		local enabled = def ~= nil and xp &lt; cap and bought &lt; snack.limit and affordable and not busy
		local buy = button(snackCard, {
			AnchorPoint = snackNarrow and Vector2.zero or Vector2.new(1, 0.5),
			Position = snackNarrow and UDim2.fromOffset(12, 132) or UDim2.new(1, -12, 0.5, 0),
			Size = snackNarrow and UDim2.fromOffset(span(12, 12, 120), 44) or UDim2.fromOffset(170, 44),
			Text = bought &gt;= snack.limit and "FED TODAY" or "",
			TextSize = 15,
		}, enabled, C.Green, function()
			click()
			call(ctx, "BuyCellOffer", snack.id, shop.day, companion)
		end)
		if bought &lt; snack.limit then
			cellIcon(buy, 20, UDim2.new(0.5, -38, 0.5, -10))
			label(buy, {
				Position = UDim2.new(0.5, -12, 0, 0),
				Size = UDim2.new(0, 70, 1, 0),
				Font = FONT.Display,
				Text = formatNumber(snack.price),
				TextColor3 = enabled and BLACK or C.Muted,
				TextSize = 18,
			})
		end
	end

	-- The permanent cosmetic listings: the long-term thing to save Brain Cells for.
	sectionHeader(content, 4, "ALWAYS IN STOCK", BRAIN)
	-- Two cards side by side while they fit; one above the other when they don't. AutomaticSize keeps
	-- the container honest either way, so a third listing later doesn't need this height edited.
	-- Two 356 px cards and their gap are 720 px; a landscape phone has 632, where the second card ran
	-- 88 px off the side. Without the room they stack, drawn the narrow way.
	local stackListings = page.narrow or not roomFor(0, 0, 720)
	local listings = create("Frame", {
		Size = stackListings and UDim2.new(1, -8, 0, 0) or UDim2.new(1, -8, 0, 84),
		AutomaticSize = stackListings and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
		BackgroundTransparency = 1,
		LayoutOrder = 5,
		Parent = content,
	}, {
		create("UIListLayout", {
			FillDirection = stackListings and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local ownedCosmetics = profile.cosmetics and profile.cosmetics.owned or {}
	local listingOrder = 0
	for _, entry in ipairs(ProgressionData.RankCosmetics) do
		local item = entry.offer and CosmeticData.Get(entry.id)
		if item then
			listingOrder += 1
			local isOwned = ownedCosmetics[entry.id] == true
			local listing = create("Frame", {
				-- Narrow, these stop being a two-up grid of 356 px cards and become full-width rows.
				Size = stackListings and UDim2.new(1, -8, 0, 160) or UDim2.fromOffset(356, 84),
				BackgroundColor3 = C.Panel,
				BorderSizePixel = 0,
				LayoutOrder = listingOrder,
				Parent = listings,
			}, { rounded(12) })
			create("UIStroke", { Color = item.color, Thickness = 2, Transparency = isOwned and 0.6 or 0.2, Parent = listing })
			cosmeticSwatch(listing, item, isOwned, item.kind == "GunSkin" and "SKIN" or "AURA", 66, 72, true).Position = UDim2.fromOffset(6, 6)
			local listingNarrow = stackListings
			-- These sit inside a card, not on the page: wide it is a fixed 356 in a two-up row, narrow
			-- it is a full-width row. Sizing against the page would run the text 144 px past the card.
			-- Narrow the card is a full-width row inside the listings frame, which is itself inset from
			-- the page, so it is two insets in, not one.
			local listingCell = listingNarrow and span(0, CARD_INSET, 120) or 356
			local listingText = math.max(90, listingCell - 82 - (listingNarrow and 14 or 138))
			label(listing, {
				Position = UDim2.fromOffset(82, 10),
				Size = UDim2.fromOffset(listingText, 22),
				Font = FONT.Display,
				Text = item.name,
				TextColor3 = Rarity.Color(item.rarity),
				TextSize = 18,
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
			label(listing, {
				Position = UDim2.fromOffset(listingNarrow and 14 or 82, listingNarrow and 62 or 34),
				Size = UDim2.fromOffset(listingNarrow and math.max(90, listingCell - 28) or listingText, 40),
				Font = FONT.Body,
				Text = string.format("%s %s. Only here.", item.rarity, item.kind == "GunSkin" and "gun skin" or "aura"),
				TextColor3 = C.Muted,
				TextWrapped = true,
				TextSize = 12,
				TextYAlignment = Enum.TextYAlignment.Top,
			})
			local affordable = progression.cells &gt;= entry.cells
			local buy = button(listing, {
				AnchorPoint = listingNarrow and Vector2.zero or Vector2.new(1, 0.5),
				Position = listingNarrow and UDim2.fromOffset(12, 108) or UDim2.new(1, -10, 0.5, 0),
				Size = listingNarrow and UDim2.fromOffset(math.max(90, listingCell - 24), 40) or UDim2.fromOffset(112, 40),
				Text = isOwned and "OWNED" or "",
				TextSize = 15,
			}, not isOwned and affordable and not busy, BRAIN, function()
				click()
				call(ctx, "BuyCellOffer", entry.offer, shop.day)
			end)
			if not isOwned then
				cellIcon(buy, 18, UDim2.new(0.5, -38, 0.5, -9))
				label(buy, {
					Position = UDim2.new(0.5, -14, 0, 0),
					Size = UDim2.new(0, 60, 1, 0),
					Font = FONT.Display,
					Text = formatNumber(entry.cells),
					TextColor3 = affordable and BLACK or C.Muted,
					TextSize = 17,
				})
			end
		end
	end

	footnote(content, 6, "Brain Cells come from Rot Rank, gun mastery and Index discoveries. They can't be bought with Robux, and no pass boosts them. "
		.. "The shop never stocks Legendary or rarer brainrots; those still come from crates and trades.")
end

--------------------------------------------------------------------------------
-- Entry point
--------------------------------------------------------------------------------

function ProgressionPanel.Render(content, profile, ctx)
	local progression = profile and profile.progression
	if progression ~= snapshotSeen then
		snapshotSeen, snapshotAt = progression, now(ctx)
	end

	-- Every page below sizes itself from this, so it has to happen before anything is drawn.
	measure(content)
	watchWidth(content, ctx)

	renderToggle(content, progression, ctx)
	if ProgressionPanel.View == "Pass" then
		return false
	end

	if not progression then
		label(content, {
			Size = UDim2.new(1, -8, 0, 90),
			LayoutOrder = 1,
			Font = FONT.Body,
			Text = "Loading your progression…",
			TextColor3 = C.Muted,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		return true
	end

	if ProgressionPanel.View == "Rank" then
		renderRank(content, progression, ctx, profile.cosmetics and profile.cosmetics.owned)
	elseif ProgressionPanel.View == "Mastery" then
		renderMastery(content, progression, ctx, profile.cosmetics and profile.cosmetics.owned)
	elseif ProgressionPanel.View == "Index" then
		renderIndex(content, progression, ctx)
	elseif ProgressionPanel.View == "Shop" then
		renderShop(content, progression, profile, ctx)
	end
	return true
end

return ProgressionPanel
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX180"><Properties><string name="Name">ProjectileClient</string><ProtectedString name="Source">-- Launcher rounds, grenades and smoke bombs on the client: the things you see fly, bounce and go
-- off, the arc that shows where your throw will land, cooking a frag, the warning when one lands
-- beside you, the grey-out inside a smoke cloud, and the kick a blast gives the camera.
--
-- The server (ProjectileService) owns every projectile and sends ProjectileFx events: "round" and
-- "throw" when something is launched, "state" at a bounce or a rest, "detonate", "impact",
-- "smoke", "remove", "cook" and "clear". Flight is replayed here with the same Ballistics maths
-- from the launch event, so nothing streams position by position: a straight round is exact from
-- its launch time; a bouncing one is stepped locally against the same world and nudged onto the
-- server's answer at each bounce, with the difference eased out over a few frames so it never pops.
--
-- Throwing: with a grenade in hand, this script takes the fire button ahead of CombatClient. Press
-- pulls the pin (the server starts the fuse), release throws it toward the crosshair through the
-- normal UseSelected use. A smoke bomb throws on the press. Hold a frag too long and the server sets
-- it off in your hand. The dotted arc runs the same simulation the server will, first bounce
-- included, and ends in a ring the size of the blast (or the cloud).

local ContextActionService = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Ballistics = require(Shared:WaitForChild("Ballistics"))
local ItemData = require(Shared:WaitForChild("ItemData"))
local ItemModels = require(Shared:WaitForChild("ItemModels"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local ThrowableModels = require(Shared:WaitForChild("ThrowableModels"))
local ExplosiveFx = require(script.Parent:WaitForChild("ExplosiveFx"))
local Settings = require(script.Parent:WaitForChild("Settings"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local UP = Vector3.yAxis

local fx = Remotes.Event("ProjectileFx")
local cookRemote = Remotes.Event("ThrowCook")
local useRemote = Remotes.Event("UseSelected")
local loadoutChanged = Remotes.Event("LoadoutChanged")
local matchChanged = Remotes.Event("MatchChanged")

-- Rounds and grenades launched further than this from the camera aren't drawn; blasts further
-- than the second aren't either (their sound still carries).
local ROUND_CULL = 450
local BLAST_CULL = 650
-- A blast heard from further than its cue carries is a rumble instead, out to this far.
local FAR_RUMBLE = 1800
-- How long a bounce correction takes to ease out, and the biggest one eased rather than snapped.
local SMOOTH_TIME = 0.08
local SMOOTH_LIMIT = 3
-- The sound cue and the visual kind for each blast.
local BLAST_CUE = { rocket = "ExplosionRocket", grenade = "ExplosionGrenade", frag = "ExplosionFrag", impact = "ExplosionFrag", sticky = "ExplosionFrag" }
local BLAST_LOOK = { rocket = "rocket", grenade = "grenade", frag = "frag", impact = "frag", sticky = "frag" }
local CUE_REACH = { ExplosionRocket = 900, ExplosionGrenade = 750, ExplosionFrag = 850 }

local loadout = nil
local matchState = "Waiting"

local function serverNow()
	return workspace:GetServerTimeNow()
end

local function inCombat()
	if matchState ~= "InProgress" or not loadout or player:GetAttribute("MenuOpen") then
		return false
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health &gt; 0
end

-- The throwable in hand: its slot, item and Ballistics spec, or nil.
local function throwableInHand()
	local slot = loadout and loadout.equipped and loadout.slots[loadout.equipped]
	if not slot or slot.kind ~= "item" then
		return nil
	end
	local item = ItemData.Get(slot.id)
	local spec = Ballistics.Throwables[slot.id]
	if not item or item.kind ~= "throwable" or not spec then
		return nil
	end
	return slot, item, spec
end

--------------------------------------------------------------------------------
-- Aiming (the same ray CombatClient fires along, so the arc ends where the crosshair points)
--------------------------------------------------------------------------------

local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude

local function aimFilter(character)
	local filter = { ExplosiveFx.Folder() }
	if character then
		table.insert(filter, character)
	end
	for _, name in ipairs({ "Effects", "Loot", "BRR_GunFx", "DeathFx" }) do
		local instance = workspace:FindFirstChild(name)
		if instance then
			table.insert(filter, instance)
		end
	end
	local companions = workspace:FindFirstChild("Companions")
	if companions then
		for _, model in ipairs(companions:GetChildren()) do
			if model:GetAttribute("OwnerUserId") == player.UserId then
				table.insert(filter, model)
			end
		end
	end
	return filter
end

-- CombatClient's own crosshair point (AimState, its raycast and filters), so the arc, the throw and
-- the crosshair agree. The ray below is only the fallback for before CombatClient has started.
local AimState = nil
do
	local module = script.Parent:FindFirstChild("AimState")
	if module then
		local ok, loaded = pcall(require, module)
		if ok and type(loaded) == "table" and type(loaded.Get) == "function" then
			AimState = loaded
		end
	end
end

local function aimPoint()
	local character = player.Character
	if not character then
		return nil
	end
	if AimState then
		local point = AimState.Get()
		if typeof(point) == "Vector3" then
			return point
		end
	end
	local viewport = camera.ViewportSize
	local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
	aimParams.FilterDescendantsInstances = aimFilter(character)
	local result = workspace:Raycast(ray.Origin, ray.Direction * 1500, aimParams)
	return result and result.Position or ray.Origin + ray.Direction * 1500
end

--------------------------------------------------------------------------------
-- Sweeping thrown things against the world, the way the server does
--------------------------------------------------------------------------------

local castParams = RaycastParams.new()
castParams.FilterType = Enum.RaycastFilterType.Exclude
castParams.IgnoreWater = true
local castFilter = {}

local function prepareCast(thrower)
	castFilter = aimFilter(thrower)
	castParams.FilterDescendantsInstances = castFilter
end

-- Glass is swept past: the server breaks it and flies on, and a pane still standing here for a
-- frame must not bounce the grenade back.
local function cast(origin, radius, displacement)
	for _ = 1, 3 do
		local result = workspace:Spherecast(origin, radius, displacement, castParams)
		if not result then
			return nil
		end
		if result.Instance.Name == "WindowGlass" then
			table.insert(castFilter, result.Instance)
			castParams.FilterDescendantsInstances = castFilter
		else
			return { Position = result.Position, Normal = result.Normal, Distance = result.Distance, Instance = result.Instance }
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Screen: the smoke grey-out, the blast flash, the fuse bar, the danger markers
--------------------------------------------------------------------------------

local screen = {}
do
	local playerGui = player:WaitForChild("PlayerGui")

	local underlay = Instance.new("ScreenGui")
	underlay.Name = "BRR_SmokeOverlay"
	underlay.IgnoreGuiInset = true
	underlay.ResetOnSpawn = false
	underlay.DisplayOrder = -5
	underlay.Parent = playerGui

	local grey = Instance.new("Frame")
	grey.Name = "Smoke"
	grey.Size = UDim2.fromScale(1, 1)
	grey.BackgroundColor3 = Color3.fromRGB(188, 190, 194)
	grey.BackgroundTransparency = 1
	grey.BorderSizePixel = 0
	grey.Parent = underlay

	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = Color3.fromRGB(255, 236, 200)
	flash.BackgroundTransparency = 1
	flash.BorderSizePixel = 0
	flash.Parent = underlay

	local overlay = Instance.new("ScreenGui")
	overlay.Name = "BRR_Throwables"
	overlay.IgnoreGuiInset = true
	overlay.ResetOnSpawn = false
	overlay.DisplayOrder = 5
	overlay.Parent = playerGui

	-- The fuse: a thin bar under the crosshair that empties as the fuse burns, reddening.
	local fuseBack = Instance.new("Frame")
	fuseBack.Name = "Fuse"
	fuseBack.AnchorPoint = Vector2.new(0.5, 0.5)
	fuseBack.Position = UDim2.new(0.5, 0, 0.5, 46)
	fuseBack.Size = UDim2.fromOffset(128, 7)
	fuseBack.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	fuseBack.BackgroundTransparency = 0.35
	fuseBack.BorderSizePixel = 0
	fuseBack.Visible = false
	fuseBack.Parent = overlay
	local fuseCorner = Instance.new("UICorner")
	fuseCorner.CornerRadius = UDim.new(0, 4)
	fuseCorner.Parent = fuseBack
	local fuseFill = Instance.new("Frame")
	fuseFill.Size = UDim2.fromScale(1, 1)
	fuseFill.BackgroundColor3 = Color3.fromRGB(255, 140, 50)
	fuseFill.BorderSizePixel = 0
	fuseFill.Parent = fuseBack
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 4)
	fillCorner.Parent = fuseFill
	local fuseLabel = Instance.new("TextLabel")
	fuseLabel.AnchorPoint = Vector2.new(0.5, 1)
	fuseLabel.Position = UDim2.new(0.5, 0, 0, -3)
	fuseLabel.Size = UDim2.fromOffset(160, 16)
	fuseLabel.BackgroundTransparency = 1
	fuseLabel.Font = Enum.Font.FredokaOne
	fuseLabel.TextSize = 14
	fuseLabel.TextColor3 = Color3.fromRGB(255, 220, 180)
	fuseLabel.TextStrokeTransparency = 0.5
	fuseLabel.Text = "COOKING"
	fuseLabel.Parent = fuseBack

	-- Danger markers: a red disc with "!" and an arrow that points at the grenade when it's off
	-- screen. A few, pooled.
	local markers = {}
	for _ = 1, 3 do
		local marker = Instance.new("Frame")
		marker.AnchorPoint = Vector2.new(0.5, 0.5)
		marker.Size = UDim2.fromOffset(34, 34)
		marker.BackgroundColor3 = Color3.fromRGB(225, 40, 36)
		marker.BorderSizePixel = 0
		marker.Visible = false
		marker.Parent = overlay
		local round = Instance.new("UICorner")
		round.CornerRadius = UDim.new(1, 0)
		round.Parent = marker
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(255, 230, 230)
		stroke.Thickness = 2
		stroke.Parent = marker
		local bang = Instance.new("TextLabel")
		bang.Size = UDim2.fromScale(1, 1)
		bang.BackgroundTransparency = 1
		bang.Font = Enum.Font.FredokaOne
		bang.TextSize = 24
		bang.TextColor3 = Color3.fromRGB(255, 255, 255)
		bang.Text = "!"
		bang.Parent = marker
		local arrow = Instance.new("Frame")
		arrow.AnchorPoint = Vector2.new(0.5, 0.5)
		arrow.Size = UDim2.fromOffset(14, 14)
		arrow.Position = UDim2.new(0.5, 0, 0.5, -28)
		arrow.BackgroundColor3 = Color3.fromRGB(225, 40, 36)
		arrow.BorderSizePixel = 0
		arrow.Rotation = 45
		arrow.Visible = false
		arrow.Parent = marker
		table.insert(markers, { frame = marker, arrow = arrow })
	end

	local blur = Instance.new("BlurEffect")
	blur.Name = "BRR_SmokeBlur"
	blur.Size = 0
	blur.Enabled = false
	blur.Parent = Lighting

	screen.grey = grey
	screen.flash = flash
	screen.blur = blur
	screen.fuseBack = fuseBack
	screen.fuseFill = fuseFill
	screen.fuseLabel = fuseLabel
	screen.markers = markers
end

--------------------------------------------------------------------------------
-- Things in flight
--------------------------------------------------------------------------------

-- id -&gt; entry. A round: { kind, spec, model, motion, origin, direction, gravity, t0, position,
-- velocity, whoosh }. A thrown item or a dud: those plus body { position, velocity, resting },
-- rotation, spin, fuseAt (server time), glows.
local flying = {}
-- Thrown models left lying where they stopped (a smoke bomb's cup in its cloud): { model, until }.
local props = {}

local function glowParts(model)
	local glows = {}
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part.Name == "Glow" then
			table.insert(glows, part)
		end
	end
	return glows
end

local function dropEntry(entry)
	if entry.whoosh then
		entry.whoosh:Stop()
	end
	if entry.model then
		entry.model:Destroy()
	end
	flying[entry.id] = nil
end

-- What a steering round's own `steer` may ask of the client: the living characters near it, the way
-- the server's Combatants gives them (players and bots alike), each with its root part. The
-- shooter is left out, as the server leaves the owner out.
local clientApi = {}
-- The characters in the workspace, rescanned at most every 0.1 s and shared by every homing round in
-- flight: steer asks every frame, and a workspace scan per round per frame grows with the map.
local bodies, bodiesAt = {}, -math.huge
function clientApi.Targets(position, range, exceptCharacter)
	local now = os.clock()
	if now - bodiesAt &gt; 0.1 then
		bodiesAt = now
		table.clear(bodies)
		for _, model in ipairs(workspace:GetChildren()) do
			local humanoid = model:IsA("Model") and model:FindFirstChildOfClass("Humanoid")
			local root = humanoid and model:FindFirstChild("HumanoidRootPart")
			if root then
				table.insert(bodies, { root = root, humanoid = humanoid, character = model })
			end
		end
	end
	local found = {}
	for _, body in ipairs(bodies) do
		if body.character ~= exceptCharacter and body.root.Parent and body.humanoid.Health &gt; 0
			and (body.root.Position - position).Magnitude &lt;= range then
			table.insert(found, body)
		end
	end
	table.sort(found, function(a, b)
		return (a.root.Position - position).Magnitude &lt; (b.root.Position - position).Magnitude
	end)
	return found
end

local function onRound(info)
	local spec = Ballistics.Rounds[info.kind]
	if not spec or typeof(info.origin) ~= "Vector3" or typeof(info.direction) ~= "Vector3" then
		return
	end
	if (info.origin - camera.CFrame.Position).Magnitude &gt; ROUND_CULL then
		return
	end
	-- Any registered kind: a hand-built model, its look, or a plain ball. Never nothing.
	local model = ThrowableModels.Round(info.kind, 1)
	model.Parent = ExplosiveFx.Folder()
	local spin = ThrowableModels.SpinOf(info.kind)
	local entry = {
		id = info.id,
		kind = info.kind,
		spec = spec,
		model = model,
		motion = info.motion or "line",
		origin = info.origin,
		direction = info.direction,
		gravity = info.gravity or workspace.Gravity,
		t0 = info.t or serverNow(),
		age = 0,
		position = info.origin,
		velocity = info.velocity or info.direction * spec.speed,
		smooth = Vector3.zero,
		shooter = info.shooter,
		owner = info.shooter,
		look = spin,
		spinAngle = 0,
		radius = type(info.radius) == "number" and info.radius or nil,
		rotation = CFrame.lookAt(Vector3.zero, info.direction),
	}
	if entry.motion == "body" then
		entry.body = { position = info.origin, velocity = entry.velocity, spec = spec, resting = false }
		entry.spin = Vector3.new(1, 0.3, 0).Unit
		entry.spinRate = spin == "tumble" and 8 or 0
	end
	if info.kind == "rocket" then
		ExplosiveFx.Trail(model.PrimaryPart, Vector3.new(0, 0, 1.5))
		entry.whoosh = ExplosiveFx.Loop("RocketWhoosh", model.PrimaryPart)
	end
	flying[info.id] = entry
	model:PivotTo(Ballistics.RoundOrientation(spin, info.origin, entry.velocity, 0))
end

local function onThrow(info)
	local spec = Ballistics.Throwables[info.item]
	local item = ItemData.Get(info.item)
	if not spec or not item or typeof(info.position) ~= "Vector3" or typeof(info.velocity) ~= "Vector3" then
		return
	end
	if (info.position - camera.CFrame.Position).Magnitude &gt; ROUND_CULL then
		return
	end
	local model = ItemModels.Build(info.item, { name = "BRR_Thrown" })
	if not model then
		return
	end
	model.Parent = ExplosiveFx.Folder()
	local rng = Random.new()
	local entry = {
		id = info.id,
		kind = spec.kind,
		item = item,
		spec = spec,
		model = model,
		motion = "body",
		gravity = info.gravity or workspace.Gravity,
		t0 = info.t or serverNow(),
		body = { position = info.position, velocity = info.velocity, spec = spec, resting = false },
		smooth = Vector3.zero,
		rotation = CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)),
		spin = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.4, 0.4), rng:NextNumber(-1, 1)).Unit,
		spinRate = rng:NextNumber(7, 11),
		fuseAt = info.fuseAt,
		thrower = info.thrower,
		glows = glowParts(model),
	}
	flying[info.id] = entry
	model:PivotTo(CFrame.new(info.position) * entry.rotation)
end

local function onState(info)
	local entry = flying[info.id]
	if not entry or typeof(info.position) ~= "Vector3" or typeof(info.velocity) ~= "Vector3" then
		return
	end
	local visual = entry.body and (entry.body.position + entry.smooth) or entry.position
	if info.body or entry.body then
		entry.motion = "body"
		entry.body = { position = info.position, velocity = info.velocity, spec = entry.spec, resting = info.resting == true }
		if not entry.spin then
			entry.spin = Vector3.new(1, 0.2, 0.3).Unit
			entry.spinRate = 9
			entry.rotation = entry.rotation or CFrame.identity
		end
		local offset = visual - info.position
		entry.smooth = offset.Magnitude &lt;= SMOOTH_LIMIT and offset or Vector3.zero
		-- A dud round now has a fuse of its own.
		if type(info.fuseAt) == "number" then
			entry.fuseAt = info.fuseAt
		end
	else
		-- A steering round's periodic correction: eased out like a bounce, never snapped.
		local offset = visual - info.position
		entry.smooth = offset.Magnitude &lt;= SMOOTH_LIMIT and offset or Vector3.zero
		entry.position = info.position
		entry.velocity = info.velocity
	end
	if info.bounce and info.bounce &gt; 4 and (info.position - camera.CFrame.Position).Magnitude &lt; 160 then
		Sfx.PlayAt("GrenadeBounce", info.position, 0.25)
	end
end

-- A sticky has stuck to something, or someone: from now on its model rides on that part with its
-- underside to the surface, and its timer blinks and beeps down to the blast.
local function onStuck(info)
	local entry = flying[info.id]
	if not entry or not entry.body or typeof(info.part) ~= "Instance" or not info.part:IsA("BasePart") then
		return
	end
	if typeof(info.position) ~= "Vector3" or typeof(info.normal) ~= "Vector3" then
		return
	end
	entry.stuck = { part = info.part, localPosition = info.position, localNormal = info.normal }
	-- Its timer lights now, not before: unlit, the one in your hand isn't mistaken for a detonator.
	if entry.model then
		entry.glows = ThrowableModels.Arm(entry.model)
	end
	entry.body.resting = true
	entry.body.velocity = Vector3.zero
	entry.smooth = Vector3.zero
	entry.spinRate = 0
	if type(info.fuseAt) == "number" then
		entry.fuseAt = info.fuseAt
	end
	entry.nextBeepAt = os.clock()
	if typeof(info.at) == "Vector3" and (info.at - camera.CFrame.Position).Magnitude &lt; 160 then
		Sfx.PlayAt("StickySquelch", info.at, 0.15)
	end
end

-- The camera's kick from a blast, decaying; applied around Roblox's own camera update the way
-- CombatClient's recoil is (undone before it runs, put back after), so it never becomes aim.
local shake = 0
local appliedShake = nil
local shakeSeed = Random.new()

RunService:BindToRenderStep("BRR_BlastShakeUndo", Enum.RenderPriority.Camera.Value - 2, function()
	if appliedShake then
		camera.CFrame = camera.CFrame * appliedShake:Inverse()
		appliedShake = nil
	end
end)

RunService:BindToRenderStep("BRR_BlastShake", Enum.RenderPriority.Camera.Value + 3, function(delta)
	if shake &lt;= 0.002 then
		shake = 0
		return
	end
	local offset = CFrame.new(
		shakeSeed:NextNumber(-1, 1) * shake * 0.35,
		shakeSeed:NextNumber(-1, 1) * shake * 0.35,
		0
	) * CFrame.Angles(shakeSeed:NextNumber(-1, 1) * shake * 0.045, shakeSeed:NextNumber(-1, 1) * shake * 0.045, shakeSeed:NextNumber(-1, 1) * shake * 0.025)
	camera.CFrame = camera.CFrame * offset
	appliedShake = offset
	shake -= shake * math.clamp(delta * 5, 0, 1)
end)

local flashUntil = 0
local flashStrength = 0

local function onDetonate(info)
	local entry = flying[info.id]
	if entry then
		dropEntry(entry)
	end
	if typeof(info.position) ~= "Vector3" then
		return
	end
	local position = info.position
	local normal = typeof(info.normal) == "Vector3" and info.normal or nil
	local radius = type(info.radius) == "number" and info.radius or 10
	local kind = info.kind or "frag"
	local distance = (position - camera.CFrame.Position).Magnitude

	if distance &lt; BLAST_CULL then
		ExplosiveFx.Explosion(position, normal, BLAST_LOOK[kind] or "frag", radius)
	end

	local cue = BLAST_CUE[kind] or "ExplosionFrag"
	if distance &lt;= (CUE_REACH[cue] or 800) then
		Sfx.PlayAt(cue, position, 0.12)
	elseif distance &lt; FAR_RUMBLE then
		Sfx.PlayDistant("ExplosionFar", position, 0.2)
	end

	-- The kick: hard at point blank, nothing past a few radii. A smaller blast kicks less.
	local strength = math.clamp(1 - distance / (radius * 4.5), 0, 1) * (kind == "grenade" and 0.7 or 1)
	if strength &gt; 0 and Settings.Get("ScreenShake") ~= false then
		shake = math.max(shake, strength)
	end
	if strength &gt; 0.35 then
		flashStrength = math.max(flashStrength, (strength - 0.35) / 0.65 * 0.55)
		-- Wall time (and below where it fades), not os.clock: CPU time in Roblox.
		flashUntil = tick() + 0.3
	end
end

local function onImpact(info)
	local entry = flying[info.id]
	if entry then
		dropEntry(entry)
	end
	if typeof(info.position) == "Vector3" and (info.position - camera.CFrame.Position).Magnitude &lt; BLAST_CULL then
		ExplosiveFx.Impact(info.position, typeof(info.normal) == "Vector3" and info.normal or nil)
		Sfx.PlayAt("GrenadeBounce", info.position, 0.2)
	end
end

local function onSmoke(info)
	local spec = Ballistics.Throwables[info.item]
	if not spec or typeof(info.position) ~= "Vector3" then
		return
	end
	local startsAt = type(info.t) == "number" and info.t or serverNow()
	local elapsed = serverNow() - startsAt
	ExplosiveFx.Cloud(info.position, spec, elapsed)
	Sfx.PlayAt("SmokeHiss", info.position, 0.1)
	task.delay(math.max(0, -elapsed), function()
		Sfx.PlayAt("SmokeBillow", info.position, 0.1)
	end)
	-- The cup stays where it stopped, in its own cloud.
	local entry = flying[info.id]
	if entry then
		flying[info.id] = nil
		table.insert(props, { model = entry.model, expiresAt = os.clock() + spec.grow + spec.hold + spec.fade })
	end
end

local function onRemove(info)
	local entry = flying[info.id]
	if entry then
		dropEntry(entry)
	end
end

local function clearAll()
	for _, entry in pairs(flying) do
		dropEntry(entry)
	end
	for _, prop in ipairs(props) do
		prop.model:Destroy()
	end
	table.clear(props)
	ExplosiveFx.Clear()
end

--------------------------------------------------------------------------------
-- Cooking and throwing
--------------------------------------------------------------------------------

-- { slot, item, spec, index, startedAt, ticks } while a frag's pin is out in our hand.
local cook = nil

-- The arc preview goes the moment a throw leaves the hand (#63). Without this it stayed drawn until
-- the server's LoadoutChanged came back -- a whole round trip, arc, ring and sticky ghost still up
-- while the thing flew -- and for a stack it never visibly went at all. So: hidden for a beat after
-- every throw, and past that beat for as long as the loadout it answers hasn't arrived, up to a
-- second (a refused throw sends no loadout, and must not blind the preview for good). Wall time,
-- not os.clock (CPU time on a client). The block between the markers is what
-- tools/throwable_preview_check.py runs.
-- BEGIN throwGate
local throwGate = {}
do
	local HIDE_MIN = 0.3
	local HIDE_MAX = 1
	local thrownAt = -math.huge
	local waiting = false
	function throwGate.Thrown(now)
		thrownAt = now
		waiting = true
	end
	function throwGate.LoadoutArrived()
		waiting = false
	end
	function throwGate.Hidden(now)
		local since = now - thrownAt
		return since &lt; HIDE_MIN or (waiting and since &lt; HIDE_MAX)
	end
end
-- END throwGate

local function stopCook()
	cook = nil
	screen.fuseBack.Visible = false
end

local function startCook(slot, item, spec)
	cook = { slot = slot, item = item, spec = spec, index = loadout.equipped, startedAt = os.clock(), ticks = 0 }
	cookRemote:FireServer()
	Sfx.Play("CoconutPinPull", 0.05)
	screen.fuseFill.BackgroundColor3 = item.color
	screen.fuseFill.Size = UDim2.fromScale(1, 1)
	screen.fuseBack.Visible = true
end

local function throwNow()
	useRemote:FireServer(aimPoint())
	throwGate.Thrown(serverNow())
	stopCook()
end

local function throwHeld()
	return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR2)
end

-- At the wheel of a vehicle (a VehicleSeat; passengers sit on plain Seats): no throwing. The server
-- refuses it too; this just keeps the click from doing anything.
local function driving()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	return seat ~= nil and seat:IsA("VehicleSeat")
end

local function onThrowInput(_, inputState)
	local slot, item, spec = throwableInHand()
	if not slot or not inCombat() then
		return Enum.ContextActionResult.Pass
	end
	if inputState == Enum.UserInputState.Begin then
		if cook or driving() then
			return Enum.ContextActionResult.Sink
		end
		if os.clock() &lt; (loadout and loadout.equipReadyAt or 0) then
			return Enum.ContextActionResult.Sink
		end
		if spec.cookable then
			startCook(slot, item, spec)
		else
			useRemote:FireServer(aimPoint())
			throwGate.Thrown(serverNow())
		end
		return Enum.ContextActionResult.Sink
	elseif inputState == Enum.UserInputState.End then
		if cook then
			throwNow()
		end
		return Enum.ContextActionResult.Sink
	end
	-- Cancel: the button may still be down; the frame loop watches it and throws on release.
	return Enum.ContextActionResult.Sink
end

ContextActionService:BindActionAtPriority("BRR_Throw", onThrowInput, false,
	Enum.ContextActionPriority.High.Value, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)

-- ON A PHONE. The binding above never sees a touch: it lists MouseButton1 and ButtonR2 and draws no
-- button, so the only thing a touch screen has is CombatClient's FIRE button, whose item branch fires
-- the use remote on press -- which throws a coconut with its whole fuse still on it. Cooking was
-- unreachable on the entire platform.
--
-- So while a COOKABLE throwable is in hand, and only then, a second binding of the same handler draws
-- its own button. Only then, because ContextActionService draws at most seven touch buttons and this
-- game already binds more than that (CombatClient's CAM note): a button that exists for the few
-- seconds a coconut is in your hand costs a slot nobody else is using at that moment. Held, exactly
-- like the mouse: press starts the fuse, release throws.
--
-- The real home for this is StarterPlayerScripts/TouchControls (it has "extra1"/"extra2" slots and
-- draws every touch button in one place), but its feature flag is off, so nothing it binds appears.
-- When that flag goes live this should move there and lose its own button.
local COOK_ACTION = "BRR_Cook"
local cookButtonBound = false

local function refreshCookButton()
	local _, _, spec = throwableInHand()
	local wanted = UserInputService.TouchEnabled and spec ~= nil and spec.cookable == true and inCombat()
	if wanted == cookButtonBound then
		return
	end
	cookButtonBound = wanted
	if wanted then
		ContextActionService:BindActionAtPriority(COOK_ACTION, onThrowInput, true,
			Enum.ContextActionPriority.High.Value, Enum.UserInputType.Touch)
		pcall(function()
			ContextActionService:SetTitle(COOK_ACTION, "COOK")
			ContextActionService:SetPosition(COOK_ACTION, UDim2.new(1, -140, 1, -400))
		end)
	else
		ContextActionService:UnbindAction(COOK_ACTION)
	end
end

local function onCook(info)
	if info.thrower == player.Character then
		return
	end
	if typeof(info.position) == "Vector3" and (info.position - camera.CFrame.Position).Magnitude &lt; 60 then
		Sfx.PlayAt("CoconutPinPull", info.position, 0.05)
	end
end

--------------------------------------------------------------------------------
-- The arc preview and the danger rings
--------------------------------------------------------------------------------

local preview = {}
do
	-- The sticky's placement ghost (a translucent copy of the item where the throw will stick).
	local StickyPreview = require(script.Parent:WaitForChild("StickyPreview"))
	local DOTS = 40
	local dots = {}
	local ring = nil

	local function ensure()
		if ring and ring.Parent then
			return
		end
		ring = Instance.new("CylinderHandleAdornment")
		ring.Name = "BRR_LandingRing"
		ring.Adornee = workspace.Terrain
		ring.Height = 0.25
		ring.AlwaysOnTop = false
		ring.ZIndex = 1
		ring.Transparency = 0.4
		ring.Visible = false
		ring.Parent = workspace.Terrain
		for index = 1, DOTS do
			local dot = dots[index]
			if not dot or not dot.Parent then
				dot = Instance.new("Part")
				dot.Name = "ArcDot"
				dot.Shape = Enum.PartType.Ball
				dot.Size = Vector3.new(0.26, 0.26, 0.26)
				dot.Material = Enum.Material.Neon
				dot.Anchored = true
				dot.CanCollide = false
				dot.CanQuery = false
				dot.CanTouch = false
				dot.CastShadow = false
				dot.Transparency = 1
				dot.Parent = ExplosiveFx.Folder()
				dots[index] = dot
			end
		end
	end

	local shown = false
	local nextSimAt = 0
	local function hide()
		-- The ghost goes whatever `shown` says: it is placed before `shown` is set, so an error in
		-- between would otherwise leave it standing for good.
		StickyPreview.Hide()
		-- Re-simulated on the first frame it comes back, not up to a 30th later from a stale arc.
		nextSimAt = 0
		if not shown then
			return
		end
		shown = false
		if ring then
			ring.Visible = false
		end
		for _, dot in ipairs(dots) do
			dot.Transparency = 1
		end
	end

	-- Where a ring should sit: on the ground under `position`, or at the position itself in the air.
	local groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Include
	local function groundUnder(position, reach)
		local include = { workspace.Terrain }
		for _, name in ipairs({ "Map", "Defenses", "Deployables" }) do
			local instance = workspace:FindFirstChild(name)
			if instance then
				table.insert(include, instance)
			end
		end
		groundParams.FilterDescendantsInstances = include
		local hit = workspace:Raycast(position + UP * 0.5, -UP * (reach + 0.5), groundParams)
		return hit and hit.Position + UP * 0.08 or position
	end
	preview.groundUnder = groundUnder

	-- The arc is re-simulated thirty times a second, not every frame: ninety sweeps a pass is plenty
	-- at that rate and nothing about it changes faster.
	function preview.update()
		local slot, item, spec = throwableInHand()
		local character = player.Character
		local head = character and character:FindFirstChild("Head")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not slot or not head or not root or not inCombat() or throwGate.Hidden(serverNow()) then
			hide()
			return
		end
		if os.clock() &lt; nextSimAt then
			return
		end
		nextSimAt = os.clock() + 1 / 30
		ensure()

		local target = aimPoint() or head.Position + camera.CFrame.LookVector * 30
		local velocity = Ballistics.ThrowVelocity(spec, head.Position, target, root.AssemblyLinearVelocity)
		local direction = Ballistics.ThrowDirection(spec, head.Position, target)
		prepareCast(character)
		local origin = Ballistics.ThrowOrigin(head.Position, direction)
		local wall = workspace:Raycast(head.Position, origin - head.Position, castParams)
		if wall then
			origin = head.Position + direction * math.max(0, wall.Distance - spec.radius - 0.05)
		end

		-- The flight the server will compute, stepped the same way, until it rests or (cooking) the
		-- fuse runs out in the air.
		local body = { position = origin, velocity = velocity, spec = spec, resting = false }
		local remaining = cook and math.max(0, spec.fuse - (os.clock() - cook.startedAt)) or 3
		local path = { origin }
		local firstContact, stickHit = nil, nil
		-- A sticky's flight ends at its first touch: that is where it will be.
		local sticky = spec.kind == "sticky"
		local elapsed = 0
		local step = 1 / 30
		for _ = 1, 90 do
			local contact = Ballistics.StepBody(body, step, workspace.Gravity, cast)
			elapsed += step
			table.insert(path, body.position)
			if contact and not firstContact then
				firstContact = #path
				stickHit = contact
				if sticky then
					break
				end
			end
			if body.resting or elapsed &gt;= remaining then
				break
			end
		end

		-- Dots every stud and a half along the path; the ones after the first bounce fainter.
		local spacing = 1.5
		local used = 0
		local carried = 0
		for index = 2, #path do
			local from, to = path[index - 1], path[index]
			local length = (to - from).Magnitude
			local at = spacing - carried
			while at &lt;= length and used &lt; DOTS do
				used += 1
				local dot = dots[used]
				dot.Position = from + (to - from) * (at / length)
				dot.Color = item.color
				local after = firstContact ~= nil and index &gt; firstContact
				dot.Transparency = after and 0.65 or 0.15
				dot.Size = after and Vector3.new(0.18, 0.18, 0.18) or Vector3.new(0.26, 0.26, 0.26)
				at += spacing
			end
			carried = length - (at - spacing)
		end
		for index = used + 1, DOTS do
			dots[index].Transparency = 1
		end

		-- The ring: the blast (or the cloud) where it comes to rest or goes off.
		local landing = path[#path]
		local radius = spec.kind == "smoke" and spec.smokeRadius or (spec.blastRadius or 8)
		local onGround = body.resting or (cook == nil)
		-- The sticky's ghost: on the surface it will stick to, green; where the throw met nothing
		-- it could hold (out of range, over the edge), red, and the ring goes with it.
		if sticky then
			if stickHit then
				StickyPreview.Show(item.id, stickHit.position, stickHit.normal, true)
				landing = stickHit.position
			else
				StickyPreview.Show(item.id, landing, UP, false)
			end
			onGround = true
		else
			StickyPreview.Hide()
		end
		local centre = onGround and groundUnder(landing, 6) or landing
		ring.CFrame = CFrame.new(centre) * CFrame.Angles(math.pi / 2, 0, 0)
		ring.Radius = radius
		ring.InnerRadius = math.max(0, radius - 0.4)
		ring.Color3 = cook and Color3.fromRGB(255, 70, 50) or item.color
		ring.Transparency = cook and 0.25 + 0.15 * math.sin(os.clock() * 12) or 0.4
		ring.Visible = true
		shown = true
	end

	preview.hide = hide
end

-- Rings under live grenades that could reach us, and the screen markers pointing at them.
local danger = {}
do
	local rings = {}
	local MAX = 3

	local function ensure(index)
		local ring = rings[index]
		if ring and ring.Parent then
			return ring
		end
		ring = Instance.new("CylinderHandleAdornment")
		ring.Name = "BRR_DangerRing"
		ring.Adornee = workspace.Terrain
		ring.Height = 0.25
		ring.AlwaysOnTop = false
		ring.ZIndex = 1
		ring.Color3 = Color3.fromRGB(235, 40, 36)
		ring.Visible = false
		ring.Parent = workspace.Terrain
		rings[index] = ring
		return ring
	end

	function danger.update()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local shown = 0
		if root and inCombat() then
			for _, entry in pairs(flying) do
				if shown &gt;= MAX then
					break
				end
				-- A thrown item's blast from its spec; a round's from its launch event (nil when it
				-- doesn't blow up).
				local radius = entry.spec.blastRadius or entry.radius
				if entry.body and entry.fuseAt and radius and entry.kind ~= "smoke" then
					local position = entry.body.position
					if (position - root.Position).Magnitude &lt;= radius + 3 then
						shown += 1
						local left = entry.fuseAt - serverNow()
						local pulse = 0.35 + 0.3 * math.sin(os.clock() * (left &lt; 1 and 22 or 10))
						local ring = ensure(shown)
						ring.CFrame = CFrame.new(preview.groundUnder(position, 8)) * CFrame.Angles(math.pi / 2, 0, 0)
						ring.Radius = radius
						ring.InnerRadius = radius - 0.5
						ring.Transparency = pulse
						ring.Visible = true

						local marker = screen.markers[shown]
						local viewport = camera.ViewportSize
						local point, onScreen = camera:WorldToViewportPoint(position + UP * 1.2)
						if onScreen and point.Z &gt; 0 then
							marker.frame.Position = UDim2.fromOffset(point.X, point.Y)
							marker.arrow.Visible = false
						else
							-- Off screen: at the edge, in its direction, with the arrow pointing out.
							local centre = Vector2.new(viewport.X / 2, viewport.Y / 2)
							local direction = Vector2.new(point.X - centre.X, point.Y - centre.Y)
							if point.Z &lt; 0 then
								direction = -direction
							end
							direction = direction.Magnitude &gt; 1 and direction.Unit or Vector2.new(0, 1)
							local edge = centre + direction * (math.min(viewport.X, viewport.Y) / 2 - 60)
							marker.frame.Position = UDim2.fromOffset(edge.X, edge.Y)
							marker.arrow.Visible = true
							marker.arrow.Rotation = 45
							marker.arrow.Position = UDim2.new(0.5, direction.X * 28, 0.5, direction.Y * 28)
						end
						marker.frame.Visible = true
					end
				end
			end
		end
		for index = shown + 1, MAX do
			if rings[index] then
				rings[index].Visible = false
			end
			screen.markers[index].frame.Visible = false
		end
	end
end

--------------------------------------------------------------------------------
-- Per frame
--------------------------------------------------------------------------------

local function stepFlying(dt, now)
	for _, entry in pairs(flying) do
		local spec = entry.spec
		if entry.look == "flat" or entry.look == "roll" then
			entry.spinAngle += (Ballistics.SpinRate[entry.look] or 20) * dt
		end
		if entry.motion == "line" then
			local position, velocity = Ballistics.RoundState(spec, entry.origin, entry.direction, entry.gravity, now - entry.t0)
			entry.position = position
			entry.velocity = velocity
			entry.model:PivotTo(Ballistics.RoundOrientation(entry.look, position, velocity, entry.spinAngle))
		elseif entry.motion == "free" then
			-- The same step the server takes (its steer with our Targets), so the path curves here the
			-- way it curves there; the server's periodic state sends ease out whatever is left.
			entry.age += dt
			local position, velocity = Ballistics.FreeStep(entry, dt, entry.gravity, clientApi)
			entry.position = position
			entry.velocity = velocity
			entry.smooth *= math.max(0, 1 - dt / SMOOTH_TIME)
			entry.model:PivotTo(Ballistics.RoundOrientation(entry.look, position + entry.smooth, velocity, entry.spinAngle))
		else
			local body = entry.body
			if entry.stuck then
				-- Riding on the part it stuck to, underside to the surface.
				local part = entry.stuck.part
				if part.Parent then
					body.position = part.CFrame:PointToWorldSpace(entry.stuck.localPosition)
					local normal = part.CFrame:VectorToWorldSpace(entry.stuck.localNormal)
					entry.model:PivotTo(Ballistics.StuckFrame(body.position - normal * spec.radius, normal, spec.stickOffset or 0))
				end
				-- The timer: a neon blink and a beep, both quickening toward the blast.
				if entry.glows and entry.fuseAt then
					local left = math.max(0, entry.fuseAt - now)
					local period = math.clamp(left * 0.3, 0.08, 0.6)
					local on = (os.clock() % period) / period &lt; 0.5
					local color = on and Color3.fromRGB(255, 250, 220) or entry.item.color
					for _, glow in ipairs(entry.glows) do
						glow.Color = color
					end
					if os.clock() &gt;= (entry.nextBeepAt or 0) then
						entry.nextBeepAt = os.clock() + period
						if (body.position - camera.CFrame.Position).Magnitude &lt; 90 then
							Sfx.PlayAt("StickyBeep", body.position, 0.02)
						end
					end
				end
			else
				if not body.resting then
					prepareCast(entry.thrower or entry.shooter)
					Ballistics.StepBody(body, dt, entry.gravity, cast)
					entry.rotation = entry.rotation * CFrame.fromAxisAngle(entry.spin, entry.spinRate * dt)
					if body.resting then
						entry.spinRate = 0
					end
				end
				entry.smooth *= math.max(0, 1 - dt / SMOOTH_TIME)
				entry.model:PivotTo(CFrame.new(body.position + entry.smooth) * entry.rotation)

				-- A frag's crack glows hotter as the fuse runs down; the last second flickers.
				if entry.glows and entry.fuseAt then
					local left = math.max(0, entry.fuseAt - now)
					local rate = left &lt; 1 and 26 or (left &lt; 2 and 12 or 6)
					local pulse = 0.5 + 0.5 * math.sin(os.clock() * rate)
					local heat = math.clamp(pulse * (1.25 - math.clamp(left / 3.2, 0, 1)), 0, 1)
					local color = entry.item.color:Lerp(Color3.fromRGB(255, 250, 220), heat)
					for _, glow in ipairs(entry.glows) do
						glow.Color = color
					end
				end
			end
		end
	end
	for index = #props, 1, -1 do
		local prop = props[index]
		if os.clock() &gt;= prop.expiresAt or not prop.model.Parent then
			prop.model:Destroy()
			table.remove(props, index)
		end
	end
end

local function stepScreen(dt)
	-- Inside a cloud: the deeper in, the greyer and blurrier.
	local inside = 0
	local eye = camera.CFrame.Position
	for _, cloud in ipairs(ExplosiveFx.Clouds) do
		local depth = cloud.radius - (eye - cloud.position).Magnitude
		if depth &gt; 0 then
			inside = math.max(inside, math.clamp(depth / 5, 0, 1) * cloud.density)
		end
	end
	screen.grey.BackgroundTransparency = 1 - 0.93 * inside
	screen.blur.Size = 30 * inside
	screen.blur.Enabled = inside &gt; 0.01

	-- The blast flash.
	local flashNow = tick()
	if flashNow &lt; flashUntil then
		screen.flash.BackgroundTransparency = 1 - flashStrength * ((flashUntil - flashNow) / 0.3)
	else
		screen.flash.BackgroundTransparency = 1
		flashStrength = 0
	end

	-- The fuse bar, and the tick each second.
	if cook then
		local elapsed = os.clock() - cook.startedAt
		local left = math.clamp(1 - elapsed / cook.spec.fuse, 0, 1)
		screen.fuseFill.Size = UDim2.fromScale(left, 1)
		screen.fuseFill.BackgroundColor3 = cook.item.color:Lerp(Color3.fromRGB(255, 50, 40), 1 - left)
		screen.fuseLabel.Text = left &lt; 0.3 and "THROW IT" or "COOKING"
		if elapsed &gt;= cook.ticks + 1 then
			cook.ticks += 1
			Sfx.Play("CoconutCook", nil, 1 + cook.ticks * 0.18)
		end
		-- The crack on the coconut in your hands (CombatClient's first-person item) burns hotter
		-- as the fuse runs down, flickering fast in the last second.
		local held = camera:FindFirstChild("BRR_ItemViewmodel")
		if held then
			local remaining = cook.spec.fuse - elapsed
			local rate = remaining &lt; 1 and 26 or (remaining &lt; 2 and 12 or 6)
			local pulse = 0.5 + 0.5 * math.sin(os.clock() * rate)
			local heat = math.clamp(pulse * (1.25 - left), 0, 1)
			local color = cook.item.color:Lerp(Color3.fromRGB(255, 250, 220), heat)
			for _, part in ipairs(held:GetDescendants()) do
				if part.Name == "Glow" and part:IsA("BasePart") then
					part.Color = color
				end
			end
		end
		if elapsed &gt;= cook.spec.fuse then
			-- Too late: the server sets it off in our hand.
			stopCook()
		elseif not inCombat() or driving() then
			stopCook()
		elseif not throwHeld() then
			throwNow()
		end
	end
end

RunService.RenderStepped:Connect(function(dt)
	dt = math.min(dt, 0.1)
	local now = serverNow()
	stepFlying(dt, now)
	refreshCookButton()
	preview.update()
	danger.update()
	stepScreen(dt)
end)

--------------------------------------------------------------------------------
-- Wiring
--------------------------------------------------------------------------------

fx.OnClientEvent:Connect(function(action, info)
	if type(info) ~= "table" then
		if action == "clear" then
			clearAll()
		end
		return
	end
	if action == "round" then
		onRound(info)
	elseif action == "throw" then
		onThrow(info)
	elseif action == "state" then
		onState(info)
	elseif action == "stuck" then
		onStuck(info)
	elseif action == "detonate" then
		onDetonate(info)
	elseif action == "impact" then
		onImpact(info)
	elseif action == "smoke" then
		onSmoke(info)
	elseif action == "remove" then
		onRemove(info)
	elseif action == "cook" then
		onCook(info)
	elseif action == "clear" then
		clearAll()
	end
end)

loadoutChanged.OnClientEvent:Connect(function(newLoadout)
	loadout = newLoadout
	throwGate.LoadoutArrived()
	if newLoadout and newLoadout.equipReadyIn then
		newLoadout.equipReadyAt = os.clock() + newLoadout.equipReadyIn
	end
	-- Swapping away from the frag puts the pin back (the server drops the cook too).
	if cook then
		local slot = newLoadout and newLoadout.equipped and newLoadout.slots[newLoadout.equipped]
		if not slot or newLoadout.equipped ~= cook.index or slot.id ~= cook.slot.id then
			stopCook()
		end
	end
end)

matchChanged.OnClientEvent:Connect(function(state)
	if type(state) == "table" and type(state.state) == "string" then
		matchState = state.state
		if matchState ~= "InProgress" then
			stopCook()
			preview.hide()
		end
	end
end)

player:GetAttributeChangedSignal("MenuOpen"):Connect(function()
	if player:GetAttribute("MenuOpen") then
		stopCook()
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX181"><Properties><string name="Name">ResultsScreen</string><ProtectedString name="Source">-- The end-of-match screen (Oliver, 2026-09-22 16:03: "the winning screen huds need serious
-- improvement"). Replaces HudClient's old results card, which was one centred text block: "#1",
-- then a wall of lines. In team modes it read "#2 out of 28" for a lost Team Deathmatch and
-- "+0 SahurCoins", and the win banner said BRAINROT CHAMPION whatever the mode.
--
-- Now: a dimmed backdrop and one card with
--   * a mode chip and a headline that fits the mode: BRAINROT CHAMPION / #N of M in Battle Royale,
--     VICTORY / DEFEAT / DRAW in the team modes
--   * who won (Battle Royale) or the final scoreline in team colours (team modes)
--   * the match in stat tiles that count up: eliminations, damage, accuracy, headshots, longest
--     elimination, damage taken, chests, companion damage (only the ones that happened, after the
--     first two)
--   * rewards as chips: crate in its rarity colour, coins, Pass XP, Rot Rank (nothing that is zero)
--   * in the team modes, every line of the pay above the chips (result, kills, assists, multi-kills,
--     revenge, captures, time on the objective, defends, time played, and the TEAM BONUS lines in gold:
--     MVP, first win of the day, win streak, a team cosmetic unlocked), a TEAM BONUS chip with its total
--     and the first win's crate, each MVP by name, and the match numbers as one line instead of tiles so
--     the card still fits a phone
--   * a countdown back to the lobby and a close button
-- Confetti on a win. Scales down to fit a phone.
--
-- HudClient's MatchResults handler returns early while this ScreenGui ("BrrResults") exists, so
-- the two never draw at once. Delete this file and the old card comes back on its own.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarity = require(Shared:WaitForChild("Rarity"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local GameModes = require(Shared:WaitForChild("GameModes"))

local UiKit = require(script.Parent:WaitForChild("UiKit"))
local RunService = game:GetService("RunService")
-- The crate you won, as the real 3D crate (the same model the menu opens). Loaded softly: if the
-- builder fails, the crate still shows as its name and colour.
local okCrates, CrateModels = pcall(require, Shared:WaitForChild("CrateModels"))
local okSfx, Sfx = pcall(require, script.Parent:WaitForChild("Sfx"))

local create, rounded, padding = UiKit.create, UiKit.rounded, UiKit.padding
local formatNumber = UiKit.formatNumber
local C = UiKit.Colors
local R = UiKit.Role

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

local matchResults = Remotes.Event("MatchResults")
local matchChanged = Remotes.Event("MatchChanged")

local SHOW_FOR = 12 -- seconds; the server's results phase is 15
local CARD_WIDTH = 580
-- The crate tile, and the team modes' shorter one; the reward breakdown's row height, the most lines it
-- draws (RewardService.TeamBreakdown makes at most 14 with the 2x line), and the width of its right-hand "paid" column.
-- Sized so the tallest team card fits a 640x360 phone at a scale of 0.5 or more, clear of fitScale's 0.45
-- floor where the card would start to leave the screen (tools/team_rewards_layout_check.py).
local CRATE_TILE, CRATE_TILE_TEAM = 92, 64
local BREAKDOWN_ROW, BREAKDOWN_MAX, BREAKDOWN_PAID = 18, 16, 112
local GOLD = C.Accent
local CONFETTI_COLORS = { C.Accent, C.Green, C.Storm, C.Red, R.Info, Color3.fromRGB(255, 255, 255) }

local screenGui = create("ScreenGui", {
	Name = "BrrResults",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 20,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Enabled = false,
	Parent = playerGui,
})

local scrim = create("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = R.Scrim,
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Parent = screenGui,
})

-- A soft glow behind the card, tinted by the outcome.
local glow = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(CARD_WIDTH + 160, 620),
	BackgroundColor3 = GOLD,
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Parent = screenGui,
}, {
	rounded(300),
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}),
})

local card = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(CARD_WIDTH, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundColor3 = R.Base,
	BorderSizePixel = 0,
	Parent = screenGui,
}, {
	rounded(18),
	padding(22),
	create("UIStroke", { Color = R.Line, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
	create("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 12),
	}),
})
local cardStroke = card:FindFirstChildOfClass("UIStroke")
local cardScale = create("UIScale", { Parent = card })

-- Fits the card to the screen: full size on a desktop, smaller on a phone.
local function fitScale()
	local viewport = camera.ViewportSize
	local height = math.max(card.AbsoluteSize.Y / math.max(cardScale.Scale, 0.01), 400)
	return math.clamp(math.min((viewport.X - 24) / CARD_WIDTH, (viewport.Y - 24) / height), 0.45, 1)
end

--------------------------------------------------------------------------------
-- Building blocks
--------------------------------------------------------------------------------

local function label(props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or R.Text
	return create("TextLabel", props)
end

local function chip(parent, text, color, order)
	return create("Frame", {
		Size = UDim2.fromOffset(0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = color,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		LayoutOrder = order or 0,
		Parent = parent,
	}, {
		rounded(15),
		create("UIStroke", { Color = color, Thickness = 1.5, Transparency = 0.2 }),
		create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }),
		label({
			Size = UDim2.fromScale(0, 1),
			AutomaticSize = Enum.AutomaticSize.X,
			Font = Enum.Font.GothamBlack,
			Text = text,
			TextColor3 = color,
			TextSize = 14,
		}),
	})
end

local function row(order, height, gap)
	return create("Frame", {
		Size = UDim2.new(1, 0, 0, height or 0),
		AutomaticSize = height and Enum.AutomaticSize.None or Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = card,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, gap or 8),
		}),
	})
end

-- Numbers count up from zero when the card opens.
local counters = {}
local function countUp(textLabel, target, format)
	table.insert(counters, { label = textLabel, target = target, format = format })
	textLabel.Text = format(0)
end

local function runCounters(token, stillShowing)
	local list = counters
	counters = {}
	task.spawn(function()
		-- Wall time, not os.clock (CPU time in Roblox): a busy frame must not slow the count-up.
		local started = tick()
		local duration = 0.9
		while stillShowing(token) do
			local t = math.clamp((tick() - started) / duration, 0, 1)
			local eased = 1 - (1 - t) ^ 3
			for _, entry in ipairs(list) do
				entry.label.Text = entry.format(entry.target * eased)
			end
			if t &gt;= 1 then
				break
			end
			task.wait()
		end
	end)
end

local function statTile(parent, value, caption, format, accent, order)
	local tile = create("Frame", {
		BackgroundColor3 = R.Surface,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = parent,
	}, {
		rounded(12),
		create("UIStroke", { Color = R.Line, Thickness = 1 }),
	})
	create("Frame", { -- accent bar on the left edge
		Size = UDim2.new(0, 4, 1, -16),
		Position = UDim2.fromOffset(0, 8),
		BackgroundColor3 = accent or GOLD,
		BorderSizePixel = 0,
		Parent = tile,
	}, { rounded(2) })
	local number = label({
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -20, 0, 30),
		Font = Enum.Font.FredokaOne,
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Parent = tile,
	})
	label({
		Position = UDim2.fromOffset(14, 40),
		Size = UDim2.new(1, -20, 0, 16),
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = R.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = string.upper(caption),
		Parent = tile,
	})
	countUp(number, value, format)
	return tile
end

local function whole(n)
	return formatNumber(math.floor(n + 0.5))
end

--------------------------------------------------------------------------------
-- Confetti
--------------------------------------------------------------------------------

local function confetti(count)
	local viewport = camera.ViewportSize
	for _ = 1, count do
		local size = math.random(6, 12)
		local startX = math.random(0, math.floor(viewport.X))
		local piece = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(startX, -20 - math.random(0, 260)),
			Size = UDim2.fromOffset(size, math.floor(size * 1.6)),
			Rotation = math.random(0, 360),
			BackgroundColor3 = CONFETTI_COLORS[math.random(1, #CONFETTI_COLORS)],
			BorderSizePixel = 0,
			ZIndex = 30,
			Parent = screenGui,
		})
		local fall = 2.4 + math.random() * 2
		TweenService:Create(piece, TweenInfo.new(fall, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.fromOffset(startX + math.random(-140, 140), viewport.Y + 40),
			Rotation = piece.Rotation + math.random(-600, 600),
		}):Play()
		task.delay(fall + 0.1, function()
			piece:Destroy()
		end)
	end
end

--------------------------------------------------------------------------------
-- Show / hide
--------------------------------------------------------------------------------

local showToken = 0

local function isCurrent(token)
	return showToken == token and screenGui.Enabled
end

local function hide()
	showToken += 1
	local token = showToken
	if not screenGui.Enabled then
		return
	end
	TweenService:Create(scrim, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(glow, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(cardScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Scale = cardScale.Scale * 0.9 }):Play()
	task.delay(0.25, function()
		if showToken == token then
			screenGui.Enabled = false
		end
	end)
end

local function clearCard()
	for _, child in ipairs(card:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	counters = {}
end

local function render(result)
	clearCard()

	local modeId = result.mode or "BattleRoyale"
	local modeInfo = GameModes.Get and GameModes.Get(modeId) or nil
	local modeName = modeInfo and modeInfo.name or "Battle Royale"
	local modeColor = modeInfo and modeInfo.color or C.Storm
	local teams = result.modeResults
	local teamMode = modeId ~= "BattleRoyale" and teams ~= nil and teams.scores ~= nil

	-- The outcome.
	local headline, headColor, won
	local sub = nil
	if teamMode then
		if teams.winner == nil then
			headline, headColor, won = "DRAW", R.TextMuted, false
		elseif result.rank == 1 then
			headline, headColor, won = "VICTORY", C.Green, true
		else
			headline, headColor, won = "DEFEAT", C.Red, false
		end
	else
		won = result.rank == 1
		if won then
			headline, headColor = "BRAINROT CHAMPION", GOLD
			sub = string.format("Last one standing out of %d", result.total or 0)
		else
			headline = "#" .. tostring(result.rank)
			headColor = result.rank &lt;= 3 and GOLD or (result.rank &lt;= 10 and R.Text or R.TextMuted)
			sub = string.format("of %d", result.total or 0)
			if result.winnerName then
				sub ..= string.format("   •   won by %s%s", result.winnerName, result.winnerIsBot and " (bot)" or "")
			end
		end
	end

	glow.BackgroundColor3 = headColor
	cardStroke.Color = won and headColor or R.Line

	-- 1. Mode chip (plus a Top 10 tag in Battle Royale).
	local chips = row(1, 30)
	chip(chips, string.upper(modeName), modeColor, 1)
	if not teamMode and not won and result.rank &lt;= 10 then
		chip(chips, result.rank &lt;= 3 and "PODIUM" or "TOP 10", GOLD, 2)
	end

	-- 2. Headline.
	local title = label({
		Size = UDim2.new(1, 0, 0, 72),
		Font = Enum.Font.FredokaOne,
		Text = headline,
		TextColor3 = headColor,
		TextScaled = true,
		LayoutOrder = 2,
		Parent = card,
	}, nil)
	create("UITextSizeConstraint", { MaxTextSize = #headline &gt; 8 and 52 or 72, Parent = title })
	create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2, Transparency = 0.4, Parent = title })
	local titleScale = create("UIScale", { Scale = 0.4, Parent = title })

	-- 3. Subline: who won, or the final score.
	if teamMode then
		local scoreRow = row(3, 64, 14)
		for index = 1, 2 do
			local color = GameModes.TeamColor(index)
			local block = create("Frame", {
				Size = UDim2.fromOffset(200, 64),
				BackgroundColor3 = color,
				BackgroundTransparency = teams.winner == index and 0.7 or 0.9,
				BorderSizePixel = 0,
				LayoutOrder = index == 1 and 1 or 3,
				Parent = scoreRow,
			}, {
				rounded(12),
				create("UIStroke", { Color = color, Thickness = teams.winner == index and 2 or 1, Transparency = teams.winner == index and 0 or 0.5 }),
			})
			label({
				Position = UDim2.fromOffset(0, 4),
				Size = UDim2.new(1, 0, 0, 36),
				Font = Enum.Font.FredokaOne,
				TextSize = 34,
				TextColor3 = color,
				Text = tostring(teams.scores[index] or 0),
				Parent = block,
			})
			label({
				Position = UDim2.fromOffset(0, 40),
				Size = UDim2.new(1, 0, 0, 16),
				Font = Enum.Font.GothamBlack,
				TextSize = 12,
				TextColor3 = R.Text,
				Text = string.upper((teams.teams and teams.teams[index]) or GameModes.TeamName(index)),
				Parent = block,
			})
		end
		label({
			Size = UDim2.fromOffset(40, 64),
			Font = Enum.Font.GothamBlack,
			TextSize = 16,
			TextColor3 = R.TextMuted,
			Text = "VS",
			LayoutOrder = 2,
			Parent = scoreRow,
		})
		if teams.target then
			sub = string.format("First to %d", teams.target)
		end
		-- Each side's MVP (GameMode.pickMvps), a list of { team, name }.
		local mvpNames = {}
		for _, entry in ipairs(type(teams.mvps) == "table" and teams.mvps or {}) do
			if type(entry) == "table" and entry.name then
				table.insert(mvpNames, tostring(entry.name))
			end
		end
		if #mvpNames &gt; 0 then
			sub = (sub and sub .. "   •   " or "") .. "MVP " .. table.concat(mvpNames, ", ")
		end
	end
	if sub then
		label({
			Size = UDim2.new(1, 0, 0, 20),
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			TextColor3 = R.TextMuted,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = sub,
			LayoutOrder = 4,
			Parent = card,
		})
	end

	-- 4. The match in numbers.
	local tally = result.tally or {}
	local combat = result.combat or {}
	local stats = {
		{ result.kills or 0, "Eliminations", whole, C.Red },
		{ tally.damage or 0, "Damage dealt", whole, GOLD },
	}
	if (combat.shots or 0) &gt; 0 then
		table.insert(stats, { math.floor((combat.hits or 0) / combat.shots * 100 + 0.5), "Accuracy", function(n)
			return string.format("%d%%", math.floor(n + 0.5))
		end, R.Info })
	end
	if (combat.headshots or 0) &gt; 0 then
		table.insert(stats, { combat.headshots, "Headshots", whole, C.Storm })
	end
	if (combat.longestKill or 0) &gt; 0 then
		table.insert(stats, { combat.longestKill, "Longest elim", function(n)
			return string.format("%d studs", math.floor(n + 0.5))
		end, C.Green })
	end
	if (combat.damageTaken or 0) &gt; 0 then
		table.insert(stats, { combat.damageTaken, "Damage taken", whole, R.TextMuted })
	end
	if (tally.chests or 0) &gt; 0 then
		table.insert(stats, { tally.chests, "Chests opened", whole, GOLD })
	end
	if (result.companionDamage or 0) &gt; 0 then
		table.insert(stats, { result.companionDamage, "Companion dmg", whole, C.Green })
	end
	-- Three to a row; two rows at most. In a team mode the numbers go on one quiet line instead: the reward
	-- breakdown below lists the eliminations and needs the room on a phone (tools/team_rewards_layout_check.py).
	if teamMode then
		local parts = {}
		for index = 1, math.min(#stats, 3) do
			local stat = stats[index]
			table.insert(parts, stat[3](stat[1]) .. " " .. string.lower(stat[2]))
		end
		label({
			Size = UDim2.new(1, 0, 0, 16),
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = R.TextMuted,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = table.concat(parts, "   •   "),
			LayoutOrder = 5,
			Parent = card,
		})
	else
		while #stats &gt; 6 do
			table.remove(stats)
		end
		local grid = create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = 5,
			Parent = card,
		}, {
			create("UIGridLayout", {
				CellSize = UDim2.new(1 / 3, -6, 0, 64),
				CellPadding = UDim2.fromOffset(9, 9),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for index, stat in ipairs(stats) do
			statTile(grid, stat[1], stat[2], stat[3], stat[4], index)
		end
	end

	-- Extras on one quiet line: items, supply drops, bounties, easter eggs.
	local extras = {}
	if (tally.items or 0) &gt; 0 then
		table.insert(extras, string.format("%d item%s used", tally.items, tally.items == 1 and "" or "s"))
	end
	if (tally.supply or 0) &gt; 0 then
		table.insert(extras, string.format("%d supply drop%s", tally.supply, tally.supply == 1 and "" or "s"))
	end
	if (tally.bounties or 0) &gt; 0 then
		table.insert(extras, string.format("%d bount%s", tally.bounties, tally.bounties == 1 and "y" or "ies"))
	end
	if (result.eggsTotal or 0) &gt; 0 then
		table.insert(extras, string.format("Easter eggs %d / %d", result.eggsFound or 0, result.eggsTotal))
	end
	-- Not in a team mode: the breakdown takes its room.
	if #extras &gt; 0 and not teamMode then
		label({
			Size = UDim2.new(1, 0, 0, 16),
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = R.TextMuted,
			Text = table.concat(extras, "   •   "),
			TextWrapped = true,
			LayoutOrder = 6,
			Parent = card,
		})
	end

	-- 5. Rewards. The crate first and big (Oliver 16:42: the screen didn't show your reward crate -- it
	-- was one chip of five in a row that ran off both sides of the card), then the rest as chips that wrap.
	local reward = result.reward
	if reward and reward.crate then
		local tint = Rarity.Color(reward.crate)
		-- Shorter in a team mode, for the breakdown's room.
		local tileHeight = teamMode and CRATE_TILE_TEAM or CRATE_TILE
		local tile = create("Frame", {
			Size = UDim2.new(1, 0, 0, tileHeight),
			BackgroundColor3 = tint,
			BackgroundTransparency = 0.86,
			BorderSizePixel = 0,
			LayoutOrder = 7,
			Parent = card,
		}, {
			rounded(14),
			create("UIStroke", { Color = tint, Thickness = 2, Transparency = 0.15 }),
		})
		local viewport = create("ViewportFrame", {
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.fromOffset(96, tileHeight - 12),
			BackgroundTransparency = 1,
			Ambient = Color3.fromRGB(170, 170, 182),
			LightColor = Color3.fromRGB(255, 250, 240),
			LightDirection = Vector3.new(-0.4, -1, 0.6),
			Parent = tile,
		})
		if okCrates and CrateModels and CrateModels.Crate then
			local built, model = pcall(CrateModels.Crate, reward.crate)
			if built and model then
				model.Parent = viewport
				local camera = Instance.new("Camera")
				camera.FieldOfView = 34
				camera.Parent = viewport
				viewport.CurrentCamera = camera
				local _, size = model:GetBoundingBox()
				local focus = Vector3.new(0, size.Y * 0.5, 0)
				local distance = math.max(size.X, size.Y, size.Z) * 2.1
				local spin
				spin = RunService.RenderStepped:Connect(function()
					if not viewport.Parent then
						spin:Disconnect()
						return
					end
					local angle = os.clock() * 0.9
					camera.CFrame = CFrame.lookAt(focus + Vector3.new(math.sin(angle) * distance, size.Y * 0.45, -math.cos(angle) * distance), focus)
				end)
			end
		end
		label({
			Position = UDim2.fromOffset(118, tileHeight / 2 - 28),
			Size = UDim2.new(1, -130, 0, 32),
			Font = Enum.Font.FredokaOne,
			TextSize = 28,
			TextColor3 = tint,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = string.upper(reward.crate) .. " CRATE",
			Parent = tile,
		})
		label({
			Position = UDim2.fromOffset(118, tileHeight / 2 + 6),
			Size = UDim2.new(1, -130, 0, 18),
			Font = Enum.Font.GothamMedium,
			TextSize = 14,
			TextColor3 = R.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "Added to your crates. Open it from the menu.",
			Parent = tile,
		})
	end
	-- The team modes' itemised pay (RewardService.TeamBreakdown): every line the card paid, two to a row,
	-- name on the left and what it paid on the right. The chips below are the totals, which the lines sum
	-- to exactly (a 2x SahurCoins pass is a line of its own).
	local lines = reward and type(reward.lines) == "table" and reward.lines or nil
	if lines and #lines &gt; 0 then
		local breakdown = create("Frame", {
			Name = "Breakdown",
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = 8,
			Parent = card,
		}, {
			create("UIGridLayout", {
				CellSize = UDim2.new(0.5, -5, 0, BREAKDOWN_ROW),
				CellPadding = UDim2.fromOffset(10, 3),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		for index, line in ipairs(lines) do
			if index &gt; BREAKDOWN_MAX then
				break
			end
			local name = tostring(line.label or "")
			local count = tonumber(line.count)
			if count and line.id == "hold" then
				name ..= string.format(" %ds", count)
			elseif count and line.id == "time" then
				name ..= string.format(" %d min", count)
			elseif count and count &gt; 0 then
				name ..= string.format(" ×%d", count)
			end
			local coins, xp = tonumber(line.coins) or 0, tonumber(line.xp) or 0
			local paid
			if coins &gt; 0 and xp &gt; 0 then
				paid = string.format("+%s  ·  %s XP", formatNumber(coins), formatNumber(xp))
			elseif xp &gt; 0 then
				paid = string.format("+%s XP", formatNumber(xp))
			elseif line.id == "unlock" then
				paid = "NEW COSMETIC"
			else
				paid = "+" .. formatNumber(coins)
			end
			-- TEAM BONUS lines (what only the team modes pay) are gold-edged, so the extra is seen as extra.
			local cell = create("Frame", {
				BackgroundColor3 = line.bonus and GOLD or R.Surface,
				-- The grid sizes the cell; the same size written here keeps a measuring harness honest.
				Size = UDim2.new(0.5, -5, 0, BREAKDOWN_ROW),
				BackgroundTransparency = line.id == "result" and 0 or (line.bonus and 0.82 or 0.4),
				BorderSizePixel = 0,
				LayoutOrder = index,
				Parent = breakdown,
			}, {
				rounded(6),
				line.bonus and create("UIStroke", { Color = GOLD, Thickness = 1, Transparency = 0.3 }) or nil,
			})
			label({
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(1, -(BREAKDOWN_PAID + 12), 1, 0),
				Font = line.id == "result" and Enum.Font.GothamBlack or Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = line.id == "result" and headColor or (line.bonus and GOLD or R.Text),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = name,
				Parent = cell,
			})
			label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -8, 0, 0),
				Size = UDim2.new(0, BREAKDOWN_PAID, 1, 0),
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = GOLD,
				TextXAlignment = Enum.TextXAlignment.Right,
				Text = paid,
				Parent = cell,
			})
		end
	end

	local rewardRow = row(9, nil)
	rewardRow:FindFirstChildOfClass("UIListLayout").Wraps = true
	local any = false
	if reward then
		-- The team modes' extras, named: TEAM BONUS and its total, and the first win's Epic Crate.
		if (tonumber(reward.bonusCoins) or 0) &gt; 0 then
			chip(rewardRow, "TEAM BONUS +" .. formatNumber(reward.bonusCoins), GOLD, 1)
			any = true
		end
		if type(reward.bonusCrate) == "string" then
			chip(rewardRow, "+1 " .. string.upper(reward.bonusCrate) .. " CRATE", Rarity.Color(reward.bonusCrate), 1)
			any = true
		end
		if (reward.coins or 0) &gt; 0 then
			chip(rewardRow, "+" .. formatNumber(reward.coins) .. " COINS", GOLD, 2)
			any = true
		end
		if (reward.xp or 0) &gt; 0 then
			chip(rewardRow, "+" .. formatNumber(reward.xp) .. " PASS XP", C.Storm, 3)
			any = true
		end
	end
	local progression = result.progression
	if progression and (progression.xp or 0) &gt; 0 then
		local rankText
		if progression.prestige ~= progression.prestigeFrom then
			rankText = string.format("PRESTIGE %d", progression.prestige)
		elseif progression.rank ~= progression.rankFrom then
			rankText = string.format("RANK %d → %d", progression.rankFrom, progression.rank)
		else
			rankText = string.format("RANK %d  +%s XP", progression.rank, formatNumber(progression.xp))
		end
		chip(rewardRow, rankText, C.Green, 4)
		if (progression.cells or 0) &gt; 0 then
			chip(rewardRow, "+" .. formatNumber(progression.cells) .. " CELLS", R.Info, 5)
		end
		any = true
	end
	if not any then
		rewardRow:Destroy()
		if not reward then
			label({
				Size = UDim2.new(1, 0, 0, 18),
				Font = Enum.Font.GothamMedium,
				TextSize = 14,
				TextColor3 = R.TextMuted,
				Text = "No placement reward this time",
				LayoutOrder = 7,
				Parent = card,
			})
		end
	end

	-- 6. Footer: countdown and close.
	local footer = create("Frame", {
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		LayoutOrder = 10,
		Parent = card,
	})
	local countdown = label({
		Size = UDim2.new(1, -130, 1, 0),
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = R.TextMuted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
		Parent = footer,
	})
	local close = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(120, 36),
		BackgroundColor3 = won and headColor or R.SurfaceAlt,
		AutoButtonColor = true,
		Font = Enum.Font.GothamBlack,
		Text = "CONTINUE",
		TextColor3 = won and R.AccentInk or R.Text,
		TextSize = 14,
		Parent = footer,
	}, { rounded(10) })
	close.Activated:Connect(hide)

	return won, titleScale, countdown
end

matchResults.OnClientEvent:Connect(function(result)
	if type(result) ~= "table" or result.rank == nil then
		return
	end
	showToken += 1
	local token = showToken

	local ok, won, titleScale, countdown = pcall(render, result)
	if not ok then
		warn("[ResultsScreen] couldn't draw the results: " .. tostring(won))
		clearCard()
		label({
			Size = UDim2.new(1, 0, 0, 72),
			Font = Enum.Font.FredokaOne,
			Text = "#" .. tostring(result.rank),
			TextColor3 = GOLD,
			TextSize = 56,
			Parent = card,
		})
		won, titleScale, countdown = false, nil, nil
	end

	screenGui.Enabled = true
	scrim.BackgroundTransparency = 1
	glow.BackgroundTransparency = 1
	TweenService:Create(scrim, TweenInfo.new(0.35), { BackgroundTransparency = 0.35 }):Play()
	TweenService:Create(glow, TweenInfo.new(0.6), { BackgroundTransparency = won and 0.25 or 0.6 }):Play()

	-- Layout first, then scale to fit and pop in.
	task.defer(function()
		if showToken ~= token then
			return
		end
		local target = fitScale()
		cardScale.Scale = target * 0.85
		TweenService:Create(cardScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target }):Play()
		if titleScale then
			TweenService:Create(titleScale, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
		runCounters(token, isCurrent)
	end)

	if won then
		confetti(90)
		if okSfx and Sfx and Sfx.Play then
			pcall(Sfx.Play, "CrateOpen")
		end
	end

	task.spawn(function()
		for left = SHOW_FOR, 1, -1 do
			if not isCurrent(token) then
				return
			end
			if countdown then
				countdown.Text = string.format("Back to the lobby in %d", left)
			end
			task.wait(1)
		end
		if showToken == token then
			hide()
		end
	end)
end)

-- Gone as soon as the server leaves the results phase.
matchChanged.OnClientEvent:Connect(function(state)
	if type(state) == "table" and state.state and state.state ~= "Results" then
		hide()
	end
end)

camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
	if screenGui.Enabled then
		cardScale.Scale = fitScale()
	end
end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX182"><Properties><string name="Name">Settings</string><ProtectedString name="Source">-- Player settings: rebindable keys, audio volumes, camera and a few gameplay toggles. ModuleScript,
-- shared by every client script (a ModuleScript is only run once per client, so they all see the
-- same table).
--
-- Saved on the player's profile through the SaveSettings remote, debounced so dragging a slider
-- doesn't fire a request per frame. Anything that depends on a setting listens to
-- `Settings.Changed`, which passes the id that changed — or "*" after a load or a reset.
--
-- Keyboard actions bound through `Settings.Bind` rebind themselves when their key changes.
-- Mouse buttons and gamepad inputs stay fixed and are passed as extra inputs.

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Settings = {}

Settings.Actions = {
	{ id = "Reload", label = "Reload", default = "R", group = "Combat" },
	{ id = "Sprint", label = "Sprint", default = "LeftShift", group = "Combat" },
	{ id = "Companion", label = "Companion ability", default = "G", group = "Combat" },
	{ id = "Inspect", label = "Inspect weapon", default = "V", group = "Combat" },
	{ id = "ToggleCamera", label = "Toggle first / third person", default = "T", group = "Combat" },
	{ id = "Zoom", label = "Zoom the camera out a step (the wheel switches hotbar items)", default = "Z", group = "Combat" },
	{ id = "MovementItem", label = "Use the first movement item in your bag (keeps your gun out)", default = "X", group = "Combat" },
	{ id = "Crouch", label = "Crouch — slides if you're sprinting (hold, or a toggle in Gameplay)", default = "C", group = "Combat" },
	{ id = "Slot1", label = "Slot 1", default = "One", group = "Loadout" },
	{ id = "Slot2", label = "Slot 2", default = "Two", group = "Loadout" },
	{ id = "Slot3", label = "Slot 3", default = "Three", group = "Loadout" },
	{ id = "Slot4", label = "Slot 4", default = "Four", group = "Loadout" },
	{ id = "Slot5", label = "Slot 5", default = "Five", group = "Loadout" },
	{ id = "Slot6", label = "Slot 6", default = "Six", group = "Loadout" },
	{ id = "Slot7", label = "Slot 7", default = "Seven", group = "Loadout" },
	{ id = "Slot8", label = "Slot 8", default = "Eight", group = "Loadout" },
	{ id = "NextSlot", label = "Next slot", default = "Q", group = "Loadout" },
	{ id = "Inventory", label = "Inventory (rearrange the hotbar)", default = "B", group = "Loadout" },
	{ id = "Menu", label = "Open menu", default = "M", group = "General" },
	{ id = "Quests", label = "Quests and challenges", default = "J", group = "General" },
	{ id = "Ready", label = "Ready up", default = "F", group = "General" },
	{ id = "SpectateNext", label = "Spectate next player", default = "E", group = "General" },
	{ id = "SpectateLeave", label = "Leave spectating (back to the lobby)", default = "L", group = "General" },
}

Settings.Sliders = {
	{ id = "MasterVolume", label = "Master volume", default = 1, min = 0, max = 1, step = 0.05, percent = true, group = "Audio" },
	{ id = "WeaponVolume", label = "Weapons and hits", default = 1, min = 0, max = 1, step = 0.05, percent = true, group = "Audio" },
	{ id = "EffectsVolume", label = "Effects and pickups", default = 1, min = 0, max = 1, step = 0.05, percent = true, group = "Audio" },
	{ id = "InterfaceVolume", label = "Menus and crates", default = 1, min = 0, max = 1, step = 0.05, percent = true, group = "Audio" },
	{ id = "FieldOfView", label = "Field of view", default = 70, min = 60, max = 95, step = 1, group = "Camera" },
	{ id = "LookSensitivity", label = "Look sensitivity", default = 1, min = 0.2, max = 2.5, step = 0.05, group = "Camera" },
	{ id = "AimSensitivity", label = "Aiming sensitivity", default = 0.7, min = 0.2, max = 1.5, step = 0.05, group = "Camera" },
}

Settings.Toggles = {
	{ id = "ThirdPerson", label = "Third-person camera (over the shoulder)", default = false, group = "Gameplay" },
	{ id = "ScreenShake", label = "Screen shake", default = true, group = "Gameplay" },
	{ id = "DamageNumbers", label = "Damage numbers", default = true, group = "Gameplay" },
	{ id = "GunSway", label = "Gun sway and bob", default = true, group = "Gameplay" },
	{ id = "AmbientParticles", label = "Ambient particles (pollen, dust, fireflies)", default = true, group = "Gameplay" },
	{ id = "AutoReload", label = "Auto-reload when the magazine runs dry", default = true, group = "Gameplay" },
	{ id = "Compass", label = "Compass strip under the storm timer", default = true, group = "Gameplay" },
	{ id = "CrouchToggle", label = "Crouch is a toggle instead of hold", default = false, group = "Gameplay" },
	-- The tab beside MENU sets this too (StarterPlayerScripts/MenuStackToggle).
	{ id = "MenuStackCollapsed", label = "Tuck the menu, bundle and quest buttons behind a tab", default = false, group = "Gameplay" },
}

-- Keys that would break the game or Roblox itself if an action took them.
Settings.ReservedKeys = {
	Escape = true, Slash = true, Tab = true, Backquote = true, Unknown = true,
	W = true, A = true, S = true, D = true, Space = true,
	Up = true, Down = true, Left = true, Right = true,
}

local KEY_LABELS = {
	One = "1", Two = "2", Three = "3", Four = "4", Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9", Zero = "0",
	LeftShift = "L-Shift", RightShift = "R-Shift", LeftControl = "L-Ctrl", RightControl = "R-Ctrl",
	LeftAlt = "L-Alt", RightAlt = "R-Alt", CapsLock = "Caps", Return = "Enter", Backspace = "Backspace",
	KeypadOne = "Num 1", KeypadTwo = "Num 2", KeypadThree = "Num 3", KeypadFour = "Num 4", KeypadFive = "Num 5",
	KeypadSix = "Num 6", KeypadSeven = "Num 7", KeypadEight = "Num 8", KeypadNine = "Num 9", KeypadZero = "Num 0",
	Minus = "-", Equals = "=", LeftBracket = "[", RightBracket = "]", Semicolon = ";", Quote = "'",
	Comma = ",", Period = ".", BackSlash = "\\",
}

local changedEvent = Instance.new("BindableEvent")
Settings.Changed = changedEvent.Event

local byId = {}
for _, list in ipairs({ Settings.Actions, Settings.Sliders, Settings.Toggles }) do
	for _, entry in ipairs(list) do
		byId[entry.id] = entry
	end
end

local values = { keys = {}, numbers = {}, toggles = {} }

local function keyCodeFromName(name)
	if type(name) ~= "string" then
		return nil
	end
	local ok, keyCode = pcall(function()
		return Enum.KeyCode[name]
	end)
	return ok and keyCode or nil
end

function Settings.Key(actionId)
	local entry = byId[actionId]
	local name = values.keys[actionId] or (entry and entry.default)
	return keyCodeFromName(name) or Enum.KeyCode.Unknown
end

function Settings.KeyLabel(actionId)
	local keyCode = Settings.Key(actionId)
	return KEY_LABELS[keyCode.Name] or keyCode.Name
end

function Settings.Get(id)
	local entry = byId[id]
	if not entry then
		return nil
	end
	if type(entry.default) == "boolean" then
		local value = values.toggles[id]
		if value == nil then
			return entry.default
		end
		return value
	end
	local value = values.numbers[id]
	if type(value) ~= "number" then
		return entry.default
	end
	return value
end

--------------------------------------------------------------------------------
-- Saving
--------------------------------------------------------------------------------

local SAVE_DELAY = 1.5
local saveToken = 0

local function scheduleSave()
	saveToken += 1
	local token = saveToken
	task.delay(SAVE_DELAY, function()
		if token ~= saveToken then
			return
		end
		-- Looked up here rather than at require time: on the client that lookup waits for the
		-- server to create the remote, and every script requiring Sfx would wait along with it.
		pcall(function()
			Remotes.Function("SaveSettings"):InvokeServer(values)
		end)
	end)
end

local function fire(id)
	changedEvent:Fire(id)
end

-- Binding a key another action already uses swaps the two, so no action is ever left unbound
-- and no key does two things. Returns false for reserved or unknown keys.
function Settings.SetKey(actionId, keyCode)
	local entry = byId[actionId]
	if not entry or entry.default == nil or type(entry.default) ~= "string" then
		return false
	end
	if typeof(keyCode) ~= "EnumItem" or Settings.ReservedKeys[keyCode.Name] then
		return false
	end

	local previous = Settings.Key(actionId)
	if previous == keyCode then
		return true
	end
	for _, other in ipairs(Settings.Actions) do
		if other.id ~= actionId and Settings.Key(other.id) == keyCode then
			values.keys[other.id] = previous.Name
			fire(other.id)
		end
	end
	values.keys[actionId] = keyCode.Name
	fire(actionId)
	scheduleSave()
	return true
end

function Settings.Set(id, value)
	local entry = byId[id]
	if not entry then
		return
	end
	if type(entry.default) == "boolean" then
		values.toggles[id] = value == true
	elseif type(entry.default) == "number" and type(value) == "number" then
		local stepped = math.floor((value - entry.min) / entry.step + 0.5) * entry.step + entry.min
		values.numbers[id] = math.clamp(stepped, entry.min, entry.max)
	else
		return
	end
	fire(id)
	scheduleSave()
end

function Settings.ResetGroup(group)
	for _, list in ipairs({ Settings.Actions, Settings.Sliders, Settings.Toggles }) do
		for _, entry in ipairs(list) do
			if not group or entry.group == group then
				values.keys[entry.id] = nil
				values.numbers[entry.id] = nil
				values.toggles[entry.id] = nil
			end
		end
	end
	fire("*")
	scheduleSave()
end

--------------------------------------------------------------------------------
-- Binding
--------------------------------------------------------------------------------

local bindings = {}

-- The shared touch buttons (StarterPlayerScripts/TouchControls), looked up the first time a binding
-- with a touch button is made. Only when its flag is on does a touch button go there instead of to
-- ContextActionService; with the flag off everything below behaves exactly as it always has.
local touchControls = nil
local function touchControlsOn()
	if touchControls == nil then
		local ok, module = pcall(function()
			return require(script.Parent:WaitForChild("TouchControls", 5))
		end)
		touchControls = ok and module or false
	end
	return touchControls and touchControls.Enabled == true
end

local function applyBinding(binding)
	ContextActionService:UnbindAction(binding.name)
	local forward = binding.touch ~= nil and touchControlsOn()
	ContextActionService:BindAction(binding.name, binding.handler, binding.touch ~= nil and not forward, Settings.Key(binding.actionId),
		table.unpack(binding.extras))
	if forward then
		-- The slot comes from the action's name inside TouchControls; `touch.slot` overrides it.
		touchControls.Bind(binding.name, { slot = binding.touch.slot, label = binding.touch.title, handler = binding.handler })
	elseif binding.touch then
		ContextActionService:SetTitle(binding.name, binding.touch.title)
		ContextActionService:SetPosition(binding.name, binding.touch.position)
	end
end

-- Binds `handler` to the action's current key plus any fixed `extras` (gamepad buttons, mouse
-- buttons), and keeps it bound to the right key through rebinds. `touch`, when given, is
-- { title, position } for an on-screen mobile button.
function Settings.Bind(name, actionId, handler, touch, ...)
	local binding = { name = name, actionId = actionId, handler = handler, touch = touch, extras = { ... } }
	bindings[name] = binding
	applyBinding(binding)
end

-- Gamepad face names, for a legend on a console. Declared HERE and not beside KeyLabel: `bindings`
-- is a local declared further down the file than KeyLabel is, so a copy of this next to KeyLabel
-- would read a nil upvalue and fail only once somebody plugged a pad in.
--
-- A second hand-written table of "which button is inventory" would drift from the binds the first
-- time anybody moved one, so this reads the ACTUAL extras handed to Settings.Bind, and answers nil
-- when an action has no gamepad button at all -- the honest answer for Zoom and Inspect, and the
-- reason a legend drops those rows on a pad rather than printing a key that does nothing.
local GAMEPAD_LABELS = {
	ButtonA = "A", ButtonB = "B", ButtonX = "X", ButtonY = "Y",
	ButtonL1 = "LB", ButtonR1 = "RB", ButtonL2 = "LT", ButtonR2 = "RT",
	ButtonL3 = "LS", ButtonR3 = "RS", ButtonSelect = "Back", ButtonStart = "Start",
	-- ASCII, not arrow glyphs. An arrow would be shorter and read better, and it assumes
	-- GothamBold renders that codepoint -- if it does not, every d-pad row becomes a tofu box,
	-- which is exactly what the menu's close button did with U+2715. Nothing can be seen on a
	-- screen tonight, so these stay ASCII until a render says the glyph is safe.
	DPadUp = "D-Pad Up", DPadDown = "D-Pad Dn", DPadLeft = "D-Pad L", DPadRight = "D-Pad R",
}

function Settings.GamepadLabel(actionId)
	for _, binding in pairs(bindings) do
		if binding.actionId == actionId then
			for _, extra in ipairs(binding.extras) do
				local label = typeof(extra) == "EnumItem" and GAMEPAD_LABELS[extra.Name]
				if label then
					return label
				end
			end
		end
	end
	return nil
end

Settings.Changed:Connect(function(id)
	for _, binding in pairs(bindings) do
		if id == "*" or binding.actionId == id then
			applyBinding(binding)
		end
	end
end)

--------------------------------------------------------------------------------
-- Loading
--------------------------------------------------------------------------------

local function adopt(saved)
	if type(saved) ~= "table" then
		return
	end
	for id, name in pairs(type(saved.keys) == "table" and saved.keys or {}) do
		local entry = byId[id]
		local keyCode = keyCodeFromName(name)
		if entry and type(entry.default) == "string" and keyCode and not Settings.ReservedKeys[keyCode.Name] then
			values.keys[id] = keyCode.Name
		end
	end
	for id, value in pairs(type(saved.numbers) == "table" and saved.numbers or {}) do
		local entry = byId[id]
		if entry and type(entry.default) == "number" and type(value) == "number" and value == value then
			values.numbers[id] = math.clamp(value, entry.min, entry.max)
		end
	end
	for id, value in pairs(type(saved.toggles) == "table" and saved.toggles or {}) do
		local entry = byId[id]
		if entry and type(entry.default) == "boolean" and type(value) == "boolean" then
			values.toggles[id] = value
		end
	end
end

task.spawn(function()
	local ok, saved = pcall(function()
		return Remotes.Function("GetSettings"):InvokeServer()
	end)
	if ok then
		adopt(saved)
		fire("*")
	end
end)

return Settings
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX183"><Properties><string name="Name">Sfx</string><ProtectedString name="Source">-- Client sound playback. ModuleScript, not a LocalScript.
--
-- A cue in SoundConfig is a recipe: one or more source files stacked at their own pitch, volume
-- and start delay, optionally run through a SoundEffect chain. This builds each recipe into real
-- Sound instances and plays them together.
--
-- Sounds are pooled per cue rather than created per play: spawning instances for every rifle shot
-- would churn hundreds a second. A pool entry holds one Sound per layer, so a three-layer gunshot
-- costs three instances per voice.
--
-- Every sound plays through a SoundGroup for its category (SoundConfig `category`), and the
-- groups follow the volume sliders in Settings, so changing a slider affects sounds already
-- playing too.
--
-- What changes with where a sound is heard from (#120: rolloff per class, the top end lost to
-- distance, travel time, a rifle's crack arriving before its report, reverb only under a roof)
-- is worked out by SoundConfig.Plan; this file only applies the plan. Two effects per Sound are
-- switched per play rather than rebuilt: an equaliser for the air (the cue's own one when it
-- has one, so the chain doesn't grow) and the room reverb.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local SoundConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SoundConfig"))
local Settings = require(script.Parent:WaitForChild("Settings"))

local Acoustics = SoundConfig.Acoustics

local Sfx = {}

local POOL_SIZE = 4

local CATEGORY_SETTING = { Weapons = "WeaponVolume", Effects = "EffectsVolume", Interface = "InterfaceVolume" }

local groups = {}

local function applyVolumes()
	local master = Settings.Get("MasterVolume")
	for category, group in pairs(groups) do
		group.Volume = master * Settings.Get(CATEGORY_SETTING[category] or "EffectsVolume")
	end
end

local function groupFor(config)
	local category = CATEGORY_SETTING[config.category] and config.category or "Effects"
	local group = groups[category]
	if not group then
		group = Instance.new("SoundGroup")
		group.Name = "BRR_" .. category
		group.Parent = SoundService
		groups[category] = group
		applyVolumes()
	end
	return group
end

Settings.Changed:Connect(function(id)
	if id == "*" or id == "MasterVolume" or id == "WeaponVolume" or id == "EffectsVolume" or id == "InterfaceVolume" then
		applyVolumes()
	end
end)

-- The SoundGroup a category's cues play through ("Weapons", "Effects" or "Interface"), created on
-- demand, for a Sound built outside the pools (a looping cue riding on a moving part): parented to
-- this group it follows the volume sliders from its first play, whether or not any pooled cue of
-- the category has played yet.
function Sfx.GroupFor(category)
	return groupFor({ category = category })
end

-- The cue's effect chain, rebuilt on each voice. Effects live on the Sound, so a cue with two
-- layers gets the chain twice; the alternative is a SoundGroup per cue, which can't be nested
-- under the category group that the volume sliders drive.
local function newEffect(sound, className, properties)
	local ok, effect = pcall(Instance.new, className)
	if not ok or not effect then
		return nil
	end
	for property, value in pairs(properties or {}) do
		pcall(function()
			effect[property] = value
		end)
	end
	effect.Parent = sound
	return effect
end

-- Builds the chain and returns what it made, each with the config entry it came from, so the
-- per-play code can find the cue's own reverb and equaliser and their authored settings.
local function applyEffects(sound, config)
	local made = {}
	if type(config.effects) ~= "table" then
		return made
	end
	for _, entry in ipairs(config.effects) do
		if #made &gt;= Acoustics.MAX_EFFECTS_PER_SOUND then
			break
		end
		local effect = newEffect(sound, entry[1], entry[2])
		if effect then
			table.insert(made, { effect = effect, className = entry[1], properties = entry[2] or {} })
		end
	end
	return made
end

-- The per-play effects for one layer's Sound, within MAX_EFFECTS_PER_SOUND. The room reverb comes
-- first (it is what tells indoors from out); the air equaliser reuses the cue's own when it has
-- one. Its authored gains are kept from the CONFIG, never read back off the effect, because the
-- effect's gains are rewritten on every play.
local function addPerPlay(entry, sound, made, name, config, positional)
	if SoundConfig.RoomGated(name, config) then
		local rooms = {}
		for _, item in ipairs(made) do
			if item.className == "ReverbSoundEffect" then
				table.insert(rooms, item.effect)
			end
		end
		if #rooms == 0 and #made &lt; Acoustics.MAX_EFFECTS_PER_SOUND then
			local room = newEffect(sound, "ReverbSoundEffect", Acoustics.ROOM)
			if room then
				room.Name = "BRR_Room"
				table.insert(made, { effect = room, className = "ReverbSoundEffect", properties = Acoustics.ROOM })
				table.insert(rooms, room)
			end
		end
		entry.rooms = rooms
	end
	if positional then
		for _, item in ipairs(made) do
			if item.className == "EqualizerSoundEffect" then
				local p = item.properties
				entry.air = item.effect
				entry.airBase = { p.LowGain or 0, p.MidGain or 0, p.HighGain or 0 }
				break
			end
		end
		if not entry.air and #made &lt; Acoustics.MAX_EFFECTS_PER_SOUND then
			local air = newEffect(sound, "EqualizerSoundEffect", { LowGain = 0, MidGain = 0, HighGain = 0 })
			if air then
				air.Name = "BRR_Air"
				table.insert(made, { effect = air, className = "EqualizerSoundEffect", properties = {} })
				entry.air = air
				entry.airBase = { 0, 0, 0 }
			end
		end
	end
end

-- One voice of a cue: a Sound per layer, already pitched and mixed, parented to `parent`.
-- `perPlay` adds the switchable room and air effects (pools do; a loop is never re-planned).
local function buildVoice(name, config, layers, parent, positional, perPlay)
	local voice = {}
	local near, far = SoundConfig.Rolloff(name, config)
	for _, layer in ipairs(layers) do
		local sound = Instance.new("Sound")
		sound.SoundId = layer.id
		sound.Volume = layer.volume
		sound.PlaybackSpeed = layer.pitch
		sound.SoundGroup = groupFor(config)
		if positional then
			sound.RollOffMode = Enum.RollOffMode.InverseTapered
			sound.RollOffMinDistance = near
			sound.RollOffMaxDistance = far
		end
		local made = applyEffects(sound, config)
		local entry = { sound = sound, pitch = layer.pitch, delay = layer.delay, volume = layer.volume }
		if perPlay then
			addPerPlay(entry, sound, made, name, config, positional)
		end
		sound.Parent = parent
		table.insert(voice, entry)
	end
	return voice
end

-- Start every layer of a voice, honouring each layer's delay. `scale` multiplies the whole cue's
-- pitch (jitter, or a caller-supplied override), so the layers keep their relative tuning. `plan`
-- (SoundConfig.Plan) sets each layer's delay and gain, the room and the air; `gain` scales the
-- whole voice (a far rumble fading with distance).
local function playVoice(voice, scale, plan, gain)
	for index, layer in ipairs(voice) do
		local sound = layer.sound
		local shape = plan and plan.layers[index]
		local level = (shape and shape.gain or 1) * (gain or 1)
		sound.PlaybackSpeed = layer.pitch * scale
		sound.Volume = layer.volume * level
		if layer.rooms then
			local on = not plan or plan.room ~= false
			for _, room in ipairs(layer.rooms) do
				room.Enabled = on
			end
		end
		if layer.air then
			local base = layer.airBase
			layer.air.LowGain = base[1] + (plan and plan.low or 0)
			layer.air.MidGain = base[2] + (plan and plan.mid or 0)
			layer.air.HighGain = base[3] + (plan and plan.high or 0)
		end
		local delay = shape and shape.delay or layer.delay
		if level &lt;= 0 then
			-- A layer for the other environment (an outdoor echo under a roof): silent this play,
			-- and cut short if the last play of this voice left it ringing.
			sound:Stop()
		elseif delay &gt; 0 then
			task.delay(delay, function()
				if sound.Parent then
					sound.TimePosition = 0
					sound:Play()
				end
			end)
		else
			sound.TimePosition = 0
			sound:Play()
		end
	end
end

-- How much to multiply a cue's pitch by for this play: an explicit override, or the cue's own
-- tuning with optional jitter so repeats don't sound mechanical.
local function pitchScale(config, pitchJitter, pitch)
	local base = config.pitch or 1
	local wanted = pitch or base
	if pitchJitter then
		wanted += (math.random() - 0.5) * pitchJitter
	end
	if base == 0 then
		return 1
	end
	return wanted / base
end

--------------------------------------------------------------------------------
-- The room around the listener
--------------------------------------------------------------------------------

-- Whether the listener (the camera, which is where Roblox hears from) has a roof overhead: one
-- ray straight up, remembered for a quarter of a second so a 13-round burst costs one ray, not
-- thirteen. Only things you would bump your head on count (RespectCanCollide), so a canopy of
-- leaves or a smoke cloud is not a ceiling; your own character is left out.
local ENCLOSURE_TTL = 0.25
local enclosedAt = -math.huge
local enclosed = false

function Sfx.IsEnclosed()
	-- `time()` is game time. Not os.clock, which is CPU time in Roblox and runs slow under load.
	local now = time()
	if now - enclosedAt &lt; ENCLOSURE_TTL then
		return enclosed
	end
	enclosedAt = now
	local camera = workspace.CurrentCamera
	if not camera then
		enclosed = false
		return enclosed
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local character = Players.LocalPlayer and Players.LocalPlayer.Character
	params.FilterDescendantsInstances = character and { character } or {}
	params.RespectCanCollide = true
	params.IgnoreWater = true
	enclosed = workspace:Raycast(camera.CFrame.Position, Vector3.new(0, Acoustics.CEILING_REACH, 0), params) ~= nil
	return enclosed
end

--------------------------------------------------------------------------------
-- Non-positional
--------------------------------------------------------------------------------

local pools = {}
local cursors = {}

local function ensurePool(name)
	if pools[name] then
		return pools[name]
	end

	local config = SoundConfig.Get(name)
	local layers = config and SoundConfig.LayersOf(config)
	if not layers then
		return nil
	end

	local pool = {}
	for _ = 1, POOL_SIZE do
		table.insert(pool, buildVoice(name, config, layers, SoundService, false, true))
	end

	pools[name] = pool
	cursors[name] = 1
	return pool
end

-- The next voice of a flat cue, played at distance 0 unless `plan` says otherwise.
local function playFlat(name, pitchJitter, pitch, plan, gain)
	local pool = ensurePool(name)
	if not pool then
		return
	end

	local config = SoundConfig.Get(name)
	local index = cursors[name]
	cursors[name] = (index % #pool) + 1
	playVoice(pool[index], pitchScale(config, pitchJitter, pitch), plan, gain)
end

-- `pitchJitter` keeps repeated cues from sounding mechanical. `pitch` overrides the cue's base
-- pitch, for rising sequences like the crate-opening tier climb. Your own gun indoors rings in
-- the room; outside it doesn't. `gain`, optional, scales this one play (a crouched step).
function Sfx.Play(name, pitchJitter, pitch, gain)
	local config = SoundConfig.Get(name)
	if not config then
		return
	end
	playFlat(name, pitchJitter, pitch, SoundConfig.Plan(name, config, 0, Sfx.IsEnclosed()), gain or 1)
end

-- A far-off event heard as a whole rather than from a direction (the ExplosionFar rumble): played
-- flat, at a level that fades with distance (SoundConfig.DistantGain), and late by the time the
-- sound takes to get here. `gain` scales it further.
function Sfx.PlayDistant(name, position, pitchJitter, gain)
	local config = SoundConfig.Get(name)
	local camera = workspace.CurrentCamera
	if not config or not camera then
		return
	end
	local distance = (camera.CFrame.Position - position).Magnitude
	local level = SoundConfig.DistantGain(config, distance) * (gain or 1)
	if level &lt;= 0 then
		return
	end
	local plan = SoundConfig.Plan(name, config, distance, Sfx.IsEnclosed())
	-- Flat: its top end is already gone in the recipe, so no air on top.
	plan.low, plan.mid, plan.high = 0, 0, 0
	task.delay(plan.start, playFlat, name, pitchJitter, nil, plan, level)
end

--------------------------------------------------------------------------------
-- Positional
--------------------------------------------------------------------------------

-- Other people's gunfire. Sounds under an Attachment play from that point in the world, so you
-- can hear which direction a fight is in — the main way anyone finds one in a battle royale.
-- Pooled the same way; the attachments are just moved to each new shot.
local POSITIONAL_POOL_SIZE = 8

local positionalPools = {}
local positionalCursors = {}

local function ensurePositionalPool(name)
	if positionalPools[name] then
		return positionalPools[name]
	end

	local config = SoundConfig.Get(name)
	local layers = config and SoundConfig.LayersOf(config)
	if not layers then
		return nil
	end

	local pool = {}
	for _ = 1, POSITIONAL_POOL_SIZE do
		local attachment = Instance.new("Attachment")
		attachment.Name = "Sfx_" .. name
		-- Terrain sits at the origin, so an attachment's Position under it is its world position.
		attachment.Parent = workspace.Terrain
		table.insert(pool, { attachment = attachment, voice = buildVoice(name, config, layers, attachment, true, true) })
	end

	positionalPools[name] = pool
	positionalCursors[name] = 1
	return pool
end

-- The voice is picked and moved when the sound ARRIVES, not when it was made: a far shot waits
-- for its travel time first, so a pool slot is never retargeted with a play still pending on it.
local function arriveAt(name, position, scale, plan, gain)
	local pool = ensurePositionalPool(name)
	if not pool then
		return
	end
	local index = positionalCursors[name]
	positionalCursors[name] = (index % #pool) + 1

	local entry = pool[index]
	entry.attachment.Position = position
	playVoice(entry.voice, scale, plan, gain or 1)
end

-- How far the listener is from the line a shot took, for whether its crack passes them.
local function missDistance(listener, from, to)
	local line = to - from
	local length = line.Magnitude
	if length &lt; 1e-3 then
		return (listener - from).Magnitude
	end
	local along = math.clamp((listener - from):Dot(line) / (length * length), 0, 1)
	return (listener - (from + line * along)).Magnitude
end

-- `towards`, optional: where the shot went. A supersonic shot whose line passes within
-- CRACK_REACH of you cracks before its report arrives; one that doesn't is heard as a report.
-- Without it the shot is taken as passing near (the crack is the more telling sound).
-- `gain`, optional, scales this one play (a crouched or sprinting step).
function Sfx.PlayAt(name, position, pitchJitter, towards, gain)
	local config = SoundConfig.Get(name)
	local camera = workspace.CurrentCamera
	if not config or not camera then
		return
	end

	-- Out of earshot: don't steal a pool slot from a shot that could actually be heard.
	local listener = camera.CFrame.Position
	local distance = (listener - position).Magnitude
	local _, far = SoundConfig.Rolloff(name, config)
	if distance &gt; far then
		return
	end

	local nearPath = nil
	if typeof(towards) == "Vector3" then
		nearPath = missDistance(listener, position, towards) &lt;= Acoustics.CRACK_REACH
	end
	local plan = SoundConfig.Plan(name, config, distance, Sfx.IsEnclosed(), nearPath)
	local scale = pitchScale(config, pitchJitter, nil)
	if plan.start &gt; 0.005 then
		task.delay(plan.start, arriveAt, name, position, scale, plan, gain)
	else
		arriveAt(name, position, scale, plan, gain)
	end

	-- A big blast far enough off that its crack is fading gets its rumble underneath.
	if plan.distant &gt; 0 and type(config.distant) == "table" and config.distant.cue then
		Sfx.PlayDistant(config.distant.cue, position, pitchJitter, plan.distant)
	end
end

--------------------------------------------------------------------------------
-- Loops
--------------------------------------------------------------------------------

-- A cue that runs until it is stopped, riding on an Attachment so it plays from that point in the
-- world and follows whatever the attachment is on: an engine, and anything else that hums.
--
--   local engine = Sfx.Loop("VehicleEngine", attachment)
--   engine:SetPitch(1.6)  engine:SetVolume(0.8)  engine:Stop()
--
-- A missing cue returns nil rather than erroring, so a caller can ship before its cue does. A loop
-- stops itself when its attachment (or the part under it) goes away, so nothing is ever left
-- humming in an empty world. Only the LOOP_LIMIT nearest the camera are audible at once: the rest
-- keep their handles but fall silent, so a queue of traffic can't stack thirty engines.
local LOOP_LIMIT = 6
local LOOP_TRIM_EVERY = 0.4

local loops = {}
local loopCount = 0
local trimConnection = nil

local Loop = {}
Loop.__index = Loop

local function loopDistance(handle)
	local camera = workspace.CurrentCamera
	local attachment = handle.attachment
	if not camera or not attachment.Parent then
		return math.huge
	end
	return (camera.CFrame.Position - attachment.WorldPosition).Magnitude
end

local function trimLoops()
	local ordered = {}
	for handle in pairs(loops) do
		table.insert(ordered, handle)
	end
	table.sort(ordered, function(a, b)
		return loopDistance(a) &lt; loopDistance(b)
	end)
	for index, handle in ipairs(ordered) do
		handle:setAudible(index &lt;= LOOP_LIMIT)
	end
end

function Loop:setAudible(on)
	if self.audible == on then
		return
	end
	self.audible = on
	for _, layer in ipairs(self.voice) do
		if layer.sound.Parent then
			if on then
				layer.sound:Play()
			else
				layer.sound:Stop()
			end
		end
	end
end

-- Multiplies the cue's own tuning, so its layers keep their relative pitch.
function Loop:SetPitch(scale)
	self.pitch = scale
	for _, layer in ipairs(self.voice) do
		layer.sound.PlaybackSpeed = layer.pitch * scale
	end
end

function Loop:SetVolume(scale)
	self.volume = scale
	for _, layer in ipairs(self.voice) do
		layer.sound.Volume = layer.volume * scale
	end
end

function Loop:Stop()
	if self.stopped then
		return
	end
	self.stopped = true
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
	for _, layer in ipairs(self.voice) do
		layer.sound:Destroy()
	end
	if loops[self] then
		loops[self] = nil
		loopCount -= 1
	end
	if loopCount == 0 and trimConnection then
		trimConnection:Disconnect()
		trimConnection = nil
	end
end

function Sfx.Loop(name, attachment)
	local config = SoundConfig.Get(name)
	local layers = config and SoundConfig.LayersOf(config)
	if not layers or typeof(attachment) ~= "Instance" or not attachment:IsA("Attachment") then
		return nil
	end

	local voice = buildVoice(name, config, layers, attachment, true, false)
	local handle = setmetatable({
		voice = voice,
		attachment = attachment,
		audible = true,
		pitch = 1,
		volume = 1,
	}, Loop)
	for _, layer in ipairs(voice) do
		layer.sound.Looped = true
		layer.sound:Play()
	end

	-- Covers the attachment being destroyed, its part being destroyed, and the whole model going.
	handle.connection = attachment.AncestryChanged:Connect(function()
		if not attachment:IsDescendantOf(workspace) and not attachment:IsDescendantOf(SoundService) then
			handle:Stop()
		end
	end)

	loops[handle] = true
	loopCount += 1
	if not trimConnection then
		local since = 0
		trimConnection = game:GetService("RunService").Heartbeat:Connect(function(dt)
			since += dt
			if since &gt;= LOOP_TRIM_EVERY then
				since = 0
				trimLoops()
			end
		end)
	end
	trimLoops()
	return handle
end

-- How many loops are running, and how many of those can be heard: for the probe that proves the
-- cap and the clean-up.
function Sfx.LoopCount()
	local audible = 0
	for handle in pairs(loops) do
		if handle.audible then
			audible += 1
		end
	end
	return loopCount, audible, LOOP_LIMIT
end

return Sfx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX184"><Properties><string name="Name">StaminaBar</string><ProtectedString name="Source">-- The stamina bar: a ModuleScript so HudClient can mount it and tools/stamina_gallery.lua can render
-- every state of it without a match running.
--
--   local bar = StaminaBar.new(screenGui)
--   bar:Update(dt, { value = 62, max = 100, exhausted = false, rush = false, hidden = false })
--
-- What it shows:
--   * the fill, and a pale "ghost" of what you just spent that hangs for a moment and then drains
--     away behind it, so a slide or a vault reads as a visible bite out of the bar;
--   * a sheen sweeping along the fill while it refills;
--   * low stamina turns the fill amber;
--   * EXHAUSTED: red, pulsing, with a tick at the line where sprinting comes back
--     (MovementConfig.Stamina.ExhaustedUntil);
--   * RUSH (a Speed Soda): gold with a moving shimmer, since nothing drains while it lasts;
--   * full and untouched for a couple of seconds, it dims but never disappears, so it's always
--     findable at a glance.
-- Sized in pixels for a 1080p screen. `StaminaBar.Layout(viewport)` / `bar:Place(viewport)` pick the scale and
-- the spot that clears the rest of the bottom HUD on any screen size.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MovementConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MovementConfig"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))

local create, rounded = UiKit.create, UiKit.rounded
local C = UiKit.Colors

local StaminaBar = {}
StaminaBar.__index = StaminaBar

-- Sized for a 1080p screen; bigger than the first cut, which read as a thin sliver at 1920 wide.
local WIDTH, TRACK_HEIGHT, HEIGHT = 360, 16, 50

local GREEN = Color3.fromRGB(104, 226, 134)
local GREEN_BRIGHT = Color3.fromRGB(176, 248, 170)
local AMBER = Color3.fromRGB(255, 190, 64)
local RED = Color3.fromRGB(255, 88, 64)
local RED_DARK = Color3.fromRGB(150, 40, 34)
local GOLD = Color3.fromRGB(255, 212, 84)
local GHOST = Color3.fromRGB(255, 240, 170)
local LOW = 0.3

-- The UIScale for a viewport: 1 at 1080 tall, never so small the bar stops being readable on a phone.
function StaminaBar.ScaleFor(viewport)
	return math.clamp(viewport.Y / 1080, 0.9, 1.25)
end

-- Where the rest of the bottom HUD sits, in raw unscaled pixels from the screen edges. These were this
-- file's own constants, read out of HudClient; they live in UiKit.BottomRow now (claude-ee's revamp owns
-- that row), so when the health panel or the hotbar moves, the bar follows with no edit here.
--   bottom-left   health panel 16..HealthRight across, 16..96 up; companion panel above it to 166 up;
--                 the SPEED BOOST pill to LeftStackTop; the ability icon 326..404 across, 94..172 up
--   bottom-right  the hotbar, HotbarInset in from the right edge and 16..166 up, its tab to 196 up
local ROW = UiKit.BottomRow
local HEALTH_RIGHT = ROW.HealthRight
local HOTBAR_INSET = ROW.HotbarInset
local LEFT_STACK_TOP = ROW.LeftStackTop
local GAP = ROW.Gap
-- The companion ability tile stands just left of the hotbar (CompanionAbilityIcon.Position: HotbarInset +
-- Gap in from the right edge, CompanionAbilityIcon.Size = 72 wide), so the row's right-hand obstacle is
-- the tile, not the hotbar: measured, the bar ran 14 px into it at 1920x1080 (#80). A literal rather than
-- a require, because that module pulls in the brainrot models.
local ABILITY_TILE = 72

-- AnchorPoint, Position and UIScale for the bar on a viewport. Bottom-centre when it fits between the
-- health panel and the hotbar (slid left of centre if it has to be, never touching either); on screens
-- too narrow for that (phones, small tablets) it sits above the bottom-left stack instead.
function StaminaBar.Layout(viewport)
	local preferred = StaminaBar.ScaleFor(viewport)
	-- The largest scale, down to 0.72, that fits between the two.
	local scale = preferred
	while scale &gt;= 0.72 do
		local width = (WIDTH + 8) * scale
		local minCentre = HEALTH_RIGHT + GAP + width / 2
		local maxCentre = viewport.X - HOTBAR_INSET - GAP - ABILITY_TILE - GAP - width / 2
		if maxCentre &gt;= minCentre then
			return Vector2.new(0.5, 1), UDim2.new(0, math.floor(math.clamp(viewport.X / 2, minCentre, maxCentre)), 1, -30), scale
		end
		scale -= 0.02
	end
	return Vector2.new(0, 1), UDim2.new(0, 16, 1, -(LEFT_STACK_TOP + 10)), preferred
end

-- On a touch screen PhoneLayout owns the HUD, and it has a slot for this bar: `Rects().stamina`, just
-- above the health readout. The rule above is the DESKTOP one, and on a phone it put the bar at 331 px
-- wide over the minimap and the buffs panel (844x390) and across the thumbstick's corner upright (#80,
-- measured by tools/hud_layout_check.py). Nil on a desktop screen, or if PhoneLayout is missing.
local function phoneSpots(viewport)
	local module = script.Parent:FindFirstChild("PhoneLayout")
	local ok, PhoneLayout = pcall(require, module)
	if ok and type(PhoneLayout) == "table" and PhoneLayout.Active(viewport) then
		return PhoneLayout.Rects(viewport)
	end
	return nil
end

function StaminaBar:Place(viewport)
	local spots = phoneSpots(viewport)
	if spots and spots.stamina then
		-- Hanging from the slot's top edge, as wide as the slot, and no taller than the slot plus the 4 px
		-- PhoneLayout leaves between it and the health row. Standing on the slot's bottom edge instead, it
		-- rose 5 px over the slot's top, which is the crosshair's clear line on an 844x390 phone (#80,
		-- tools/hud_layout_check.py: 2x3 px into the crosshair).
		local spot = spots.stamina
		self.Frame.AnchorPoint = Vector2.new(0, 0)
		self.Frame.Position = UDim2.fromOffset(spot.x, spot.y)
		self.scale.Scale = math.min(spot.w / (WIDTH + 8), (spot.h + 4) / HEIGHT)
		return
	end
	local anchor, position, scale = StaminaBar.Layout(viewport)
	self.Frame.AnchorPoint = anchor
	self.Frame.Position = position
	self.scale.Scale = scale
end

function StaminaBar.new(parent)
	local self = setmetatable({}, StaminaBar)

	local frame = create("CanvasGroup", {
		Name = "StaminaBar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.fromOffset(WIDTH + 8, HEIGHT),
		BackgroundTransparency = 1,
		GroupTransparency = 0,
		Parent = parent,
	})
	self.Frame = frame
	self.scale = create("UIScale", { Parent = frame })

	-- A soft dark plate behind everything, so the bar reads over bright sky and snow alike.
	create("Frame", {
		Name = "Plate",
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Parent = frame,
	}, { rounded(10) })

	self.title = create("TextLabel", {
		Name = "Title",
		Position = UDim2.fromOffset(11, 5),
		Size = UDim2.fromOffset(140, 17),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "STAMINA",
		TextColor3 = C.Muted,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})

	self.number = create("TextLabel", {
		Name = "Number",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -11, 0, 3),
		Size = UDim2.fromOffset(140, 21),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "100",
		TextColor3 = C.Text,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = frame,
	})

	-- EXHAUSTED / RUSH, centred over the track.
	self.status = create("TextLabel", {
		Name = "Status",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 3),
		Size = UDim2.fromOffset(180, 21),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = "",
		TextColor3 = RED,
		TextSize = 19,
		Visible = false,
		Parent = frame,
	})

	local track = create("Frame", {
		Name = "Track",
		Position = UDim2.fromOffset(4, 28),
		Size = UDim2.fromOffset(WIDTH, TRACK_HEIGHT),
		BackgroundColor3 = Color3.fromRGB(12, 13, 18),
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = frame,
	}, { rounded(TRACK_HEIGHT // 2) })
	self.track = track
	self.stroke = create("UIStroke", {
		Color = Color3.fromRGB(70, 74, 92),
		Thickness = 1.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = track,
	})

	self.ghost = create("Frame", {
		Name = "Ghost",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = GHOST,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Parent = track,
	}, { rounded(TRACK_HEIGHT // 2) })

	self.fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = GREEN,
		BorderSizePixel = 0,
		Parent = track,
	}, { rounded(TRACK_HEIGHT // 2) })
	-- A lighter top half, so the fill reads as a lit tube rather than a flat stripe.
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(0.45, Color3.fromRGB(235, 235, 235)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 170, 170)),
		}),
		Parent = self.fill,
	})

	-- The sheen: a bright band that sweeps along the fill while it refills (or all the time on RUSH).
	self.sheen = create("Frame", {
		Name = "Sheen",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Visible = false,
		Parent = self.fill,
	})
	self.sheenGradient = create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.4, 1),
			NumberSequenceKeypoint.new(0.5, 0.45),
			NumberSequenceKeypoint.new(0.6, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Offset = Vector2.new(-1, 0),
		Parent = self.sheen,
	})

	-- Where sprinting comes back after exhaustion.
	local restart = MovementConfig.Stamina.ExhaustedUntil / MovementConfig.Stamina.Max
	self.tick = create("Frame", {
		Name = "RestartTick",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0, 4 + WIDTH * restart, 0, 25),
		Size = UDim2.fromOffset(2, TRACK_HEIGHT + 6),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 3,
		Parent = frame,
	})

	self.shown = 1
	self.ghostValue = 1
	self.ghostHold = 0
	self.lastTarget = 1
	self.idle = 0
	self.clock = 0
	self.rising = 0
	return self
end

function StaminaBar:SetScale(scale)
	self.scale.Scale = scale
end

-- Jump straight to a state with no easing (the gallery uses this).
function StaminaBar:Snap(state, ghost)
	local target = math.clamp((state.value or 0) / (state.max or MovementConfig.Stamina.Max), 0, 1)
	self.shown, self.lastTarget = target, target
	self.ghostValue = math.max(target, ghost or target)
	self.ghostHold = ghost and 1 or 0
	self.idle = state.idleFor or 0
	self.rising = state.rising and 1 or 0
	self:Update(0, state)
end

function StaminaBar:Update(dt, state)
	local frame = self.Frame
	if state.hidden then
		frame.Visible = false
		return
	end
	frame.Visible = true
	self.clock += dt

	local target = math.clamp((state.value or 0) / (state.max or MovementConfig.Stamina.Max), 0, 1)
	local blend = math.clamp(dt * 16, 0, 1)
	self.shown += (target - self.shown) * blend

	-- The ghost holds the level from before a drop, then drains toward the fill.
	if target &lt; self.lastTarget - 0.004 then
		if self.ghostValue &lt; self.lastTarget then
			self.ghostValue = self.lastTarget
		end
		-- A big bite (slide, vault, climb) hangs longer than the steady trickle of a sprint.
		self.ghostHold = (self.lastTarget - target) &gt; 0.05 and 0.45 or math.max(self.ghostHold, 0.15)
	end
	if target &gt; self.lastTarget + 0.0005 then
		self.rising = 0.25
	else
		self.rising = math.max(self.rising - dt, 0)
	end
	self.lastTarget = target
	if self.ghostHold &gt; 0 then
		self.ghostHold -= dt
	else
		self.ghostValue = math.max(self.ghostValue - dt * 0.55, self.shown)
	end
	if self.ghostValue &lt; self.shown then
		self.ghostValue = self.shown
	end

	self.fill.Size = UDim2.fromScale(self.shown, 1)
	self.ghost.Size = UDim2.fromScale(self.ghostValue, 1)
	self.ghost.Visible = self.ghostValue &gt; self.shown + 0.002

	-- Colour and status.
	local color, statusText, statusColor = GREEN, nil, nil
	local pulse = (math.sin(self.clock * 9) + 1) / 2
	if state.rush then
		color = GOLD
		statusText, statusColor = "RUSH", GOLD
	elseif state.exhausted then
		color = RED:Lerp(RED_DARK, pulse * 0.6)
		statusText, statusColor = "EXHAUSTED", RED:Lerp(Color3.new(1, 1, 1), pulse * 0.35)
	elseif self.shown &lt; LOW then
		color = AMBER
	elseif state.draining then
		color = GREEN_BRIGHT
	end
	-- A slide or vault refused for want of stamina: two quick red-white blinks of the border.
	local refused = state.refusedAt and (os.clock() - state.refusedAt) or math.huge
	local flashing = refused &gt;= 0 and refused &lt; 0.45
	self.fill.BackgroundColor3 = color
	if flashing then
		local blink = math.floor(refused / 0.11) % 2 == 0
		self.stroke.Color = blink and Color3.new(1, 1, 1) or RED
		self.stroke.Thickness = 2.5
	else
		self.stroke.Color = state.exhausted and RED:Lerp(RED_DARK, pulse) or (state.rush and GOLD or Color3.fromRGB(70, 74, 92))
		self.stroke.Thickness = (state.exhausted or state.rush) and 2 or 1.5
	end

	self.status.Visible = statusText ~= nil
	if statusText then
		self.status.Text = statusText
		self.status.TextColor3 = statusColor
	end
	self.title.Visible = statusText == nil
	self.number.Text = state.rush and "" or tostring(math.floor((state.value or 0) + 0.5))
	self.tick.Visible = state.exhausted == true

	-- The sheen runs while refilling, and constantly on RUSH.
	local sweeping = state.rush or (self.rising &gt; 0 and self.shown &lt; 0.995)
	self.sheen.Visible = sweeping
	if sweeping then
		local period = state.rush and 0.9 or 1.3
		local phase = (self.clock % period) / period
		self.sheenGradient.Offset = Vector2.new(-1 + phase * 2, 0)
	end

	-- Dim when full and untouched for a while; never fully hidden during a match.
	local active = state.exhausted or state.rush or state.draining or target &lt; 0.995 or flashing
	if active then
		self.idle = 0
	else
		self.idle += dt
	end
	local wanted = self.idle &gt; 2 and 0.55 or 0
	if dt &lt;= 0 then
		frame.GroupTransparency = wanted
	else
		frame.GroupTransparency += (wanted - frame.GroupTransparency) * math.clamp(dt * 6, 0, 1)
	end
end

return StaminaBar
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX185"><Properties><string name="Name">StickyPreview</string><ProtectedString name="Source">-- The placement ghost for a sticky throwable (the Clingy Crumpet): a translucent copy of the item's
-- own model standing where the throw will stick, underside on the surface, green when the throw
-- meets something it can hold and red when it meets nothing (out of range, over the edge). No
-- text: the ghost, its tint and ProjectileClient's dotted arc say it, the way DefensePreview does
-- for a barricade. A ModuleScript so ProjectileClient drives it and tools/throwables_gallery.lua
-- renders it without a match.
--
--   StickyPreview.Show(itemId, position, normal, valid)   the ghost at a surface point, facing out
--   StickyPreview.Hide()
--
-- The ghost's parts never collide, query or touch, so neither the throw preview's own sweeps nor
-- anyone's raycasts see it, and it lives in BRR_Throwables, one of the folders DefensePreview
-- already leaves out of its site checks.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Ballistics = require(Shared:WaitForChild("Ballistics"))
local ItemModels = require(Shared:WaitForChild("ItemModels"))

local StickyPreview = {}

StickyPreview.ValidColor = Color3.fromRGB(94, 214, 122)
StickyPreview.InvalidColor = Color3.fromRGB(232, 92, 92)
StickyPreview.Transparency = 0.55

-- { itemId, model, parts = { { part, color } }, valid, placed }
local ghost = nil

local function folder()
	local existing = workspace:FindFirstChild("BRR_Throwables")
	if existing then
		return existing
	end
	local created = Instance.new("Folder")
	created.Name = "BRR_Throwables"
	created.Parent = workspace
	return created
end

local function build(itemId)
	local model = ItemModels.Build(itemId, { name = "BRR_StickyGhost" })
	if not model then
		return nil
	end
	local parts = {}
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
			if part.Transparency &lt; 1 then
				part.Material = Enum.Material.SmoothPlastic
				part.Transparency = StickyPreview.Transparency
				table.insert(parts, { part = part, color = part.Color })
			end
		end
	end
	return { itemId = itemId, model = model, parts = parts, valid = nil }
end

function StickyPreview.Show(itemId, position, normal, valid)
	-- Another item's ghost, or ours taken out of the world by something else (its folder cleared):
	-- a destroyed model's Parent is locked, so it is rebuilt rather than put back.
	if ghost and (ghost.itemId ~= itemId or (ghost.placed and ghost.model.Parent == nil)) then
		StickyPreview.Hide()
	end
	if not ghost then
		ghost = build(itemId)
		if not ghost then
			return
		end
	end
	if ghost.valid ~= valid then
		ghost.valid = valid
		local tint = valid and StickyPreview.ValidColor or StickyPreview.InvalidColor
		for _, entry in ipairs(ghost.parts) do
			entry.part.Color = entry.color:Lerp(tint, 0.65)
		end
	end
	local spec = Ballistics.Throwables[itemId]
	ghost.model:PivotTo(Ballistics.StuckFrame(position, normal, spec and spec.stickOffset or 0))
	if ghost.model.Parent == nil then
		ghost.model.Parent = folder()
		ghost.placed = true
	end
end

function StickyPreview.Hide()
	if ghost then
		ghost.model:Destroy()
		ghost = nil
	end
end

-- For the gallery and probes: the live ghost model, or nil.
function StickyPreview.Model()
	return ghost and ghost.model or nil
end

return StickyPreview
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX186"><Properties><string name="Name">StormClient</string><ProtectedString name="Source">-- Draws the storm wall locally, as a hollow ring.
--
-- The server used to build the wall as solid volumes: a giant cylinder you stood inside and a
-- 6-stud neon disc across the whole safe zone. From inside the circle both tinted everything,
-- which read as fog lying on the ground. This builds a ring of thin wall segments instead, so
-- the view inside the zone is completely clear and the storm only shows where its edge is.
--
-- Doing it here also means a shrinking storm costs no replication, and it can smooth between
-- the server's half-second radius updates instead of stepping.

-- #45: the storm is brainrot now. The wall is a deep rot purple (the HUD's storm purple, so the
-- vignette and the wall still read as one thing), the eye-level band is brain pink, and slow
-- swirls of pink-to-lime rot drift up off the band. The swirls are deliberately few: an emitter on
-- every fourth band segment, and only the ones near the camera run at all (#131, lag). Nothing
-- here changes where the edge is or how solid it looks from inside; the band is still the
-- brightest thing at eye level, which is what tells you where the storm starts.
--
-- Sound: crossing out into the storm plays the "StormEnter" cue and crossing back plays
-- "StormLeave" (both in SoundConfig).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MatchConfig = require(Shared:WaitForChild("MatchConfig"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local stormChanged = Remotes.Event("StormChanged")

local SEGMENTS = 96
-- The wall runs well below and above the terrain, so hills never poke out of it.
local WALL_BOTTOM, WALL_TOP = -60, 900
-- A brighter strip low down marks the edge at eye level.
local BAND_BOTTOM, BAND_TOP = -20, 45

local WALL_COLOR = Color3.fromRGB(140, 74, 236)
local BAND_COLOR = Color3.fromRGB(255, 112, 206)
local WALL_TRANSPARENCY = 0.84
local BAND_TRANSPARENCY = 0.5

-- The rot swirls: one emitter per EMIT_EVERY band segments, running only within EMIT_RANGE of the
-- camera. At the rate and lifetime below one emitter holds at most about 10 particles, so even a
-- final circle small enough to bring all 24 in range stays near 240 in the whole ring.
local EMIT_EVERY = 4
local EMIT_RANGE = 320
local EMIT_RATE = 2
local SWIRL_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"

local folder = Instance.new("Folder")
folder.Name = "StormWall"

-- Local-only parts. CanQuery is off so they never intercept the crosshair raycast.
local function segment(color, transparency)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = transparency
	part.Parent = folder
	return part
end

-- Pink curling up into rot green: brain matter going off. Sized in studs, and spun both ways so
-- the wall looks like it is churning rather than steaming.
local function swirl(host)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "RotSwirl"
	emitter.Texture = SWIRL_TEXTURE
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 130, 214)),
		ColorSequenceKeypoint.new(0.6, Color3.fromRGB(196, 110, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 255, 90)),
	})
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 9) })
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.LightEmission = 0.35
	emitter.Lifetime = NumberRange.new(3.5, 5)
	emitter.Rate = EMIT_RATE
	emitter.Speed = NumberRange.new(1.5, 4)
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.Acceleration = Vector3.new(0, 2.5, 0)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-70, 70)
	emitter.Enabled = false
	emitter.Parent = host
	return emitter
end

local walls, bands, swirls = {}, {}, {}
for index = 1, SEGMENTS do
	walls[index] = segment(WALL_COLOR, WALL_TRANSPARENCY)
	bands[index] = segment(BAND_COLOR, BAND_TRANSPARENCY)
	if index % EMIT_EVERY == 0 then
		swirls[index] = swirl(bands[index])
	end
end

local target = nil
local shownCenter, shownRadius = Vector3.zero, 0
local drawnCenter, drawnRadius = nil, nil
local bandTransparency = BAND_TRANSPARENCY

local function layout(center, radius)
	-- A stud of overlap closes the seams between neighbouring segments.
	local length = 2 * radius * math.tan(math.pi / SEGMENTS) + 0.02
	local flatCenter = Vector3.new(center.X, 0, center.Z)

	for index = 1, SEGMENTS do
		local angle = (index - 0.5) / SEGMENTS * math.pi * 2
		local base = flatCenter + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		-- Facing the centre puts each segment's X axis along the ring.
		local look = CFrame.lookAt(base, flatCenter)

		walls[index].Size = Vector3.new(length, WALL_TOP - WALL_BOTTOM, 1.5)
		walls[index].CFrame = look + Vector3.new(0, (WALL_TOP + WALL_BOTTOM) / 2, 0)

		-- A tenth longer than the wall, so the two never share an end face.
		bands[index].Size = Vector3.new(length + 0.1, BAND_TOP - BAND_BOTTOM, 2)
		bands[index].CFrame = look + Vector3.new(0, (BAND_TOP + BAND_BOTTOM) / 2, 0)
	end
end

-- Swirls near the camera run; the rest of the ring's are switched off. Re-judged a few times a
-- second rather than every frame: the camera cannot cross an emitter's worth of range that fast.
local swirlClock = 0
local function gateSwirls(force)
	local camera = workspace.CurrentCamera
	local eye = camera and camera.CFrame.Position
	for index, emitter in pairs(swirls) do
		local wanted = false
		if eye and target then
			local offset = bands[index].Position - eye
			wanted = Vector3.new(offset.X, 0, offset.Z).Magnitude &lt; EMIT_RANGE
		end
		if force or emitter.Enabled ~= wanted then
			emitter.Enabled = wanted
		end
	end
end

-- Whether the local player's body is out in the storm, for the enter/leave cues. A body at lobby
-- height is not in the match (a spectator stands on the pier at MatchConfig.LobbyPosition), so it
-- counts as not outside whatever the circle does.
local wasOutside = false
local function outsideNow()
	local player = Players.LocalPlayer
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not target or root.Position.Y &gt; MatchConfig.LobbyPosition.Y - 100 then
		return false
	end
	local flat = Vector3.new(root.Position.X - target.center.X, 0, root.Position.Z - target.center.Z)
	return flat.Magnitude &gt; target.radius
end

-- The storm's bite (#86 M19). StormService hurts everyone outside once a second, silently: the only
-- sound was the groan on the way out, so a player looting outside the wall heard nothing while their
-- health went. Each tick that takes health while you are outside plays a quiet, higher StormEnter --
-- the same voice, so it reads as the storm, at a third of its volume so it nags rather than alarms.
-- Judged on the 0.4 s poll below from the health actually lost, so it only sounds when damage lands.
local TICK_GAIN, TICK_PITCH, TICK_GAP = 0.3, 1.25, 0.8
local lastHealth, lastTickAt = nil, -math.huge
local function stormTickDue(outside, health, before, now, lastAt)
	return outside and before ~= nil and health &gt; 0 and health &lt; before - 0.5 and now - lastAt &gt;= TICK_GAP
end

stormChanged.OnClientEvent:Connect(function(info)
	-- A tiny or zero radius is sudden death closing (MatchConfig.StormSuddenDeath), not "no storm": the
	-- wall is drawn down to layout's 2-stud floor and outsideNow keeps the storm's cues going.
	if not info or info.status == "Idle" or not info.radius then
		target = nil
		wasOutside = false
		gateSwirls(true)
		folder.Parent = nil
		return
	end

	-- First update of a storm: jump straight there rather than sweeping in from wherever the
	-- last match's circle ended.
	if not target then
		shownCenter, shownRadius = info.center, info.radius
		drawnCenter, drawnRadius = nil, nil
	end
	target = info
	folder.Parent = workspace
end)

RunService.RenderStepped:Connect(function(delta)
	if not target then
		return
	end

	local alpha = math.clamp(delta * 3, 0, 1)
	shownRadius += (target.radius - shownRadius) * alpha
	shownCenter = shownCenter:Lerp(target.center, alpha)

	if not drawnRadius or math.abs(drawnRadius - shownRadius) &gt; 0.05 or (drawnCenter - shownCenter).Magnitude &gt; 0.05 then
		drawnCenter, drawnRadius = shownCenter, shownRadius
		layout(shownCenter, math.max(shownRadius, 2))
	end

	swirlClock += delta
	if swirlClock &gt;= 0.4 then
		swirlClock = 0
		gateSwirls(false)
		local outside = outsideNow()
		local crossed = outside ~= wasOutside
		if crossed then
			wasOutside = outside
			Sfx.Play(outside and "StormEnter" or "StormLeave")
		end
		local character = Players.LocalPlayer and Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local health = humanoid and humanoid.Health or nil
		-- `time()` is game time; os.clock is CPU time in Roblox and runs slow under load.
		if health and not crossed and stormTickDue(outside, health, lastHealth, time(), lastTickAt) then
			lastTickAt = time()
			Sfx.Play("StormEnter", 0.05, TICK_PITCH, TICK_GAIN)
		end
		lastHealth = health
	end

	-- The band pulses while the circle is closing.
	local wanted = BAND_TRANSPARENCY
	if target.status == "Shrinking" then
		wanted = 0.3 + math.abs(math.sin(os.clock() * 3)) * 0.25
	end
	if math.abs(wanted - bandTransparency) &gt; 0.01 then
		bandTransparency = wanted
		for index = 1, SEGMENTS do
			bands[index].Transparency = wanted
		end
	end
end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX187"><Properties><string name="Name">TouchControls</string><ProtectedString name="Source">-- Every on-screen touch button, in one place. ModuleScript: owners register their actions here instead of
-- asking ContextActionService to draw a button, and this module draws, sizes and places them all.
--
-- Why: ContextActionService draws at most SEVEN touch buttons (the game bound eight, and the last came up
-- blank), sizes them all 45 px whatever the screen, and places them wherever each owner guessed, so they
-- overlapped the minimap, the hotbar and each other. Here the buttons follow one layout, measured against
-- Roblox's own jump button and thumbstick (the phone layout map, 2026-09-17), with no cap.
--
-- FEATURE FLAG: nothing here does anything until `TouchControls.Enabled` is true. With it false, Bind does
-- nothing, no ScreenGui is ever made, and Settings.Bind and CombatClient keep ContextActionService's own
-- buttons exactly as before. It's flipped in one edit once the probe, the renders and a phone playtest pass.
--
--   TouchControls.Bind(name, {
--       slot = "fire",          -- a slot below; nil uses DefaultSlots[name], and failing that extra1/extra2
--       label = "FIRE",         -- text on the button
--       handler = fn,           -- a ContextActionService-style handler: (name, UserInputState, InputObject)
--       hold = true,            -- true: Begin on touch, End when that finger lifts (anywhere);
--                               -- false: Begin then End at once on touch (a press)
--       -- The handler always gets the REAL touch InputObject (UserInputType Touch) for Begin and for End,
--       -- never nil and never Cancel; exactly one End per Begin, and a button that goes away mid-hold
--       -- (unbound, hidden, disabled, a menu opening, death) sends its End first, with the same object.
--       contexts = { "match" }, -- where it shows: match / lobby / range / spectate (nil: the slot's defaults)
--       priority = 0,           -- two binds on one slot: the higher shows, the other waits
--       menuSafe = false,       -- stays up while a menu is open
--       onDrag = fn,            -- optional fn(delta: Vector2) while a finger is held on the button
--   })
--   TouchControls.Unbind(name)
--   TouchControls.SetState(name, { lit = bool, cooldown = 0..1, disabled = bool, label = "..." })
--   TouchControls.SlotRect(slot) -&gt; { x, y, size } in screen pixels, or nil when that slot isn't showing
--   TouchControls.Layout(viewport) -&gt; slot -&gt; { x, y, size } (every slot, shown or not)
--   TouchControls.Changed          -- fires when anything shown or its layout changes
--
-- Where buttons show (contexts): "match" while you're alive in a match, "range" on the firing range,
-- "spectate" while spectating, "lobby" otherwise; and nothing (menuSafe excepted) while a menu is open. If
-- the context can't be worked out (a signal missing, an error), it counts as "match", with one warning:
-- nobody is ever left in a match without a fire button.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local UiKit = require(script.Parent:WaitForChild("UiKit"))

local create, rounded = UiKit.create, UiKit.rounded
local C = UiKit.Colors

local TouchControls = {}

-- THE FLAG. False until the probe, the renders and a phone playtest have passed and the owners agree.
TouchControls.Enabled = false

-- For probes and galleries only: draw as if on a touch screen, into this parent, with this viewport.
TouchControls.ForceTouch = false
TouchControls.TestParent = nil
TouchControls.TestViewport = nil

-- Action name -&gt; slot. Action names don't change when a button's title does.
TouchControls.DefaultSlots = {
	BRR_Fire = "fire",
	BRR_Aim = "aim",
	BRR_Sprint = "run",
	BRR_Slide = "slide",
	BRR_Reload = "reload",
	BRR_Companion = "pet",
	BRR_MovementItem = "move",
	BRR_ToggleCamera = "cam",
	BRR_SpectateNext = "spectate",
}

TouchControls.Slots = { "fire", "aim", "run", "slide", "reload", "pet", "move", "cam", "extra1", "extra2", "spectate" }

local SLOT_DEFAULTS = {
	fire = { contexts = { "match", "range" }, hold = true },
	aim = { contexts = { "match", "range" }, hold = true },
	run = { contexts = { "match", "lobby", "range" }, hold = true },
	slide = { contexts = { "match" }, hold = false },
	reload = { contexts = { "match", "range" }, hold = false },
	pet = { contexts = { "match", "lobby", "range" }, hold = false },
	move = { contexts = { "match" }, hold = false },
	cam = { contexts = { "match", "range" }, hold = false },
	extra1 = { contexts = { "match" }, hold = false },
	extra2 = { contexts = { "match" }, hold = false },
	spectate = { contexts = { "spectate" }, hold = false },
}

local changedEvent = Instance.new("BindableEvent")
TouchControls.Changed = changedEvent.Event

--------------------------------------------------------------------------------
-- Layout (the approved phone layout map; tools/hud_ux_probe.lua checks these numbers)
--------------------------------------------------------------------------------

-- Every slot's square on a viewport, in screen pixels (top-left x, y and the side), built out from where
-- Roblox puts its jump button: 70 px at (W-95, H-90) when the short side is 500 or less, else 120 px at
-- (W-170, H-210) (PlayerModule TouchJump.lua).
function TouchControls.Layout(viewport)
	local W, H = viewport.X, viewport.Y
	local small = math.min(W, H) &lt;= 500
	local k = small and 1 or math.clamp(math.min(W, H) / 512, 1, 1.5)
	local g = 8 * k
	local jx, jy, js
	if small then
		jx, jy, js = W - 95, H - 90, 70
	else
		jx, jy, js = W - 170, H - 210, 120
	end
	local B, F = 48 * k, 72 * k
	local slots = {}
	local fireX, fireY = jx - g - F, jy + js - F
	slots.fire = { x = fireX, y = fireY, size = F }
	local colA = fireX + (F - B) / 2
	local colB = jx + (js - B) / 2
	local colC = colA - g - B
	local row = math.min(fireY, jy)
	local rows = {}
	for index = 1, 3 do
		row = row - g - B
		rows[index] = row
	end
	slots.aim = { x = colA, y = rows[1], size = B }
	slots.run = { x = colA, y = rows[2], size = B }
	slots.slide = { x = colA, y = rows[3], size = B }
	slots.reload = { x = colB, y = rows[1], size = B }
	slots.pet = { x = colB, y = rows[2], size = B }
	slots.move = { x = colB, y = rows[3], size = B }
	slots.extra1 = { x = colC, y = rows[1], size = B }
	slots.extra2 = { x = colC, y = rows[2], size = B }
	-- CAM at the top right, left of the MENU icon and the quest tab (44k each, 6 apart).
	local m = 44 * k
	-- On an upright screen that row drops below Roblox's own top bar, which reaches across 200 px of
	-- the top-left: the same rule PhoneLayout uses for the icons, and the probe checks the two agree.
	local iconsY = H &gt; W and 58 or 6
	slots.cam = { x = W - g - m - 6 - 52 * k - 6 - m, y = iconsY, size = m }
	slots.spectate = { x = W / 2 - 32 * k, y = H - 8 - 44 * k, size = 44 * k, width = 64 * k }
	return slots
end

--------------------------------------------------------------------------------
-- State
--------------------------------------------------------------------------------

local binds = {}       -- name -&gt; bind
local widgets = {}     -- slot -&gt; widget
local gui = nil
local warnedContext = false
local held = {}        -- InputObject -&gt; { bind, widget }

local state = { known = false, matchState = nil, hasLoadout = false, range = false, spectating = false }

local function isTouchScreen()
	if TouchControls.ForceTouch then
		return true
	end
	local ok, preferred = pcall(function()
		return UserInputService.PreferredInput == Enum.PreferredInput.Touch
	end)
	local touch
	if ok then
		touch = preferred
	else
		touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and not UserInputService.GamepadEnabled
	end
	local controls = true
	pcall(function()
		controls = GuiService.TouchControlsEnabled
	end)
	return touch and controls
end

local function viewport()
	if TouchControls.TestViewport then
		return TouchControls.TestViewport
	end
	local camera = workspace.CurrentCamera
	return camera and camera.ViewportSize or Vector2.new(844, 390)
end

-- The contexts in force right now, and whether a menu is open. Anything that can't be told counts as a
-- match, so the fire button never goes missing in one.
function TouchControls._Contexts()
	local ok, contexts, menuOpen = pcall(function()
		if TouchControls._ContextOverride then
			return TouchControls._ContextOverride()
		end
		local player = Players.LocalPlayer
		local menu = player ~= nil and player:GetAttribute("MenuOpen") == true
		if not state.known then
			return { match = true }, menu
		end
		if state.spectating then
			return { spectate = true }, menu
		end
		if state.range then
			return { range = true, lobby = true }, menu
		end
		if state.matchState == "InProgress" and state.hasLoadout then
			return { match = true }, menu
		end
		return { lobby = true }, menu
	end)
	if not ok then
		if not warnedContext then
			warnedContext = true
			warn("[TouchControls] couldn't tell where the player is, so the match buttons show: " .. tostring(contexts))
		end
		return { match = true }, false
	end
	return contexts, menuOpen
end

--------------------------------------------------------------------------------
-- Drawing
--------------------------------------------------------------------------------

local function ensureGui()
	if gui and gui.Parent then
		return gui
	end
	local parent = TouchControls.TestParent
	if not parent then
		local player = Players.LocalPlayer
		parent = player and player:FindFirstChildOfClass("PlayerGui")
	end
	if not parent then
		return nil
	end
	if parent:IsA("GuiBase2d") and not parent:IsA("LayerCollector") then
		gui = create("Frame", { Name = "BrrTouchControls", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = parent })
	else
		gui = create("ScreenGui", {
			Name = "BrrTouchControls",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			DisplayOrder = 2,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			Parent = parent,
		})
		-- Laid out against the whole screen, like Roblox's own jump button beside it.
		pcall(function()
			gui.ScreenInsets = Enum.ScreenInsets.None
		end)
	end
	return gui
end

-- Whether an input on a button presses it: a touch, just starting (a finger sliding onto the button
-- mid-drag arrives with another state).
function TouchControls._AcceptsInput(input)
	return input ~= nil and input.UserInputType == Enum.UserInputType.Touch and input.UserInputState == Enum.UserInputState.Begin
end

local function releaseWidget(widget)
	for input, entry in pairs(held) do
		if entry.widget == widget then
			held[input] = nil
			if entry.bind.hold then
				task.spawn(entry.bind.handler, entry.bind.name, Enum.UserInputState.End, input)
			end
		end
	end
	widget.scale.Scale = 1
end

local function press(widget, input)
	local bind = widget.bind
	if not bind or bind.disabled or held[input] then
		return
	end
	held[input] = { bind = bind, widget = widget }
	widget.scale.Scale = 0.9
	TweenService:Create(widget.plate, TweenInfo.new(0.08), { BackgroundTransparency = 0.05 }):Play()
	task.spawn(bind.handler, bind.name, Enum.UserInputState.Begin, input)
	if not bind.hold then
		held[input] = nil
		task.spawn(bind.handler, bind.name, Enum.UserInputState.End, input)
		task.delay(0.1, function()
			widget.scale.Scale = 1
			TweenService:Create(widget.plate, TweenInfo.new(0.15), { BackgroundTransparency = 0.3 }):Play()
		end)
	end
end

local function release(input)
	local entry = held[input]
	if not entry then
		return
	end
	held[input] = nil
	entry.widget.scale.Scale = 1
	TweenService:Create(entry.widget.plate, TweenInfo.new(0.15), { BackgroundTransparency = 0.3 }):Play()
	task.spawn(entry.bind.handler, entry.bind.name, Enum.UserInputState.End, input)
end

local function widgetFor(slot)
	local widget = widgets[slot]
	if widget then
		return widget
	end
	local root = ensureGui()
	if not root then
		return nil
	end
	local button = create("TextButton", {
		Name = "Touch_" .. slot,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Active = true,
		Text = "",
		Visible = false,
		ZIndex = 5,
		Parent = root,
	})
	local scale = create("UIScale", { Parent = button })
	local plate = create("Frame", {
		Name = "Plate",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = button,
	}, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local stroke = create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, Transparency = 0.35, Parent = plate })
	-- The cooldown: a dark fill that drains from the top as the move comes back.
	local cooldown = create("Frame", {
		Name = "Cooldown",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = plate,
	}, { create("UICorner", { CornerRadius = UDim.new(0.5, 0) }) })
	local label = create("TextLabel", {
		Name = "Label",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = "",
		TextColor3 = C.Text,
		TextScaled = true,
		ZIndex = 7,
		Parent = button,
	}, { create("UITextSizeConstraint", { MaxTextSize = 16, MinTextSize = 8 }), create("UIPadding", {
		PaddingLeft = UDim.new(0.14, 0), PaddingRight = UDim.new(0.14, 0), PaddingTop = UDim.new(0.3, 0), PaddingBottom = UDim.new(0.3, 0),
	}) })
	widget = { slot = slot, button = button, scale = scale, plate = plate, stroke = stroke, cooldown = cooldown, label = label }
	widgets[slot] = widget

	-- Only a finger that STARTS on the button presses it: a camera drag sliding across it doesn't. Only
	-- touches, and the real touch InputObject goes to the handler (owners read its UserInputType).
	button.InputBegan:Connect(function(input)
		if TouchControls._AcceptsInput(input) then
			press(widget, input)
		end
	end)
	return widget
end

-- Which bind holds each slot: the highest priority, then the earliest bound.
local function assign()
	local winners = {}
	local order = {}
	for _, bind in pairs(binds) do
		table.insert(order, bind)
	end
	table.sort(order, function(a, b)
		if a.priority ~= b.priority then
			return a.priority &gt; b.priority
		end
		return a.serial &lt; b.serial
	end)
	for _, bind in ipairs(order) do
		local slot = bind.slot
		if not slot or not SLOT_DEFAULTS[slot] then
			slot = nil
			for _, extra in ipairs({ "extra1", "extra2" }) do
				if not winners[extra] then
					slot = extra
					break
				end
			end
			if not slot and not bind.warnedFull then
				bind.warnedFull = true
				warn(string.format("[TouchControls] no free slot for %s; its keyboard and gamepad binds still work", bind.name))
			end
		end
		if slot and not winners[slot] then
			winners[slot] = bind
		end
	end
	return winners
end

-- Draws what should be showing now. Cheap; called on every change.
function TouchControls.Refresh()
	if not TouchControls.Enabled or not isTouchScreen() then
		for _, widget in pairs(widgets) do
			if widget.button.Visible then
				releaseWidget(widget)
				widget.button.Visible = false
			end
		end
		return
	end
	local winners = assign()
	local contexts, menuOpen = TouchControls._Contexts()
	local layout = TouchControls.Layout(viewport())
	for _, slot in ipairs(TouchControls.Slots) do
		local bind = winners[slot]
		local show = false
		if bind then
			for _, context in ipairs(bind.contexts) do
				if contexts[context] then
					show = true
				end
			end
			if menuOpen and not bind.menuSafe then
				show = false
			end
		end
		local widget = widgets[slot]
		if show then
			widget = widget or widgetFor(slot)
		end
		if widget then
			-- A held button that's about to go (unbound, hidden, disabled, out of its context, or handed to
			-- another bind) gets its End first, then goes.
			if widget.bind ~= bind or not show or (bind and bind.disabled) then
				releaseWidget(widget)
			end
			widget.bind = show and bind or nil
			widget.button.Visible = show
			if show then
				local rect = layout[slot]
				widget.button.Position = UDim2.fromOffset(rect.x, rect.y)
				widget.button.Size = UDim2.fromOffset(rect.width or rect.size, rect.size)
				widget.label.Text = bind.label or ""
				widget.stroke.Color = bind.lit and C.Accent or Color3.new(1, 1, 1)
				widget.stroke.Transparency = bind.lit and 0 or 0.35
				widget.plate.BackgroundColor3 = slot == "fire" and C.Red:Lerp(C.Background, 0.35) or C.Background
				widget.cooldown.Size = UDim2.fromScale(1, math.clamp(bind.cooldown or 0, 0, 1))
				widget.label.TextTransparency = bind.disabled and 0.6 or 0
			end
		end
	end
	changedEvent:Fire()
end

--------------------------------------------------------------------------------
-- API
--------------------------------------------------------------------------------

local serial = 0

local function bindNow(name, spec)
	spec = spec or {}
	serial += 1
	local slot = spec.slot or TouchControls.DefaultSlots[name]
	local defaults = SLOT_DEFAULTS[slot] or SLOT_DEFAULTS.extra1
	local bind = {
		name = name,
		slot = slot,
		label = spec.label,
		handler = spec.handler or function() end,
		hold = spec.hold,
		contexts = spec.contexts or defaults.contexts,
		priority = spec.priority or 0,
		menuSafe = spec.menuSafe == true,
		onDrag = spec.onDrag,
		serial = serial,
	}
	if bind.hold == nil then
		bind.hold = defaults.hold
	end
	local old = binds[name]
	if old then
		-- Rebinding (a key change) keeps its place in line.
		bind.serial = old.serial
		bind.lit, bind.cooldown, bind.disabled = old.lit, old.cooldown, old.disabled
	end
	binds[name] = bind
	TouchControls.Refresh()
end

function TouchControls.Unbind(name)
	if binds[name] then
		binds[name] = nil
		TouchControls.Refresh()
	end
end

function TouchControls.SetState(name, changes)
	local bind = binds[name]
	if not bind or type(changes) ~= "table" then
		return
	end
	for _, key in ipairs({ "lit", "cooldown", "disabled", "label" }) do
		if changes[key] ~= nil then
			bind[key] = changes[key]
		end
	end
	TouchControls.Refresh()
end

function TouchControls.SlotRect(slot)
	local widget = widgets[slot]
	if not widget or not widget.button.Visible then
		return nil
	end
	return TouchControls.Layout(viewport())[slot]
end

-- For probes: what a slot is showing (the bind's name, or nil).
function TouchControls._Showing(slot)
	local widget = widgets[slot]
	return widget and widget.button.Visible and widget.bind and widget.bind.name or nil
end

-- For probes: press and lift a slot's button with a stand-in InputObject, through the same code a finger
-- goes through.
function TouchControls._Press(slot, input)
	local widget = widgets[slot]
	if widget and widget.button.Visible then
		press(widget, input)
	end
end
TouchControls._Release = release

-- For probes: forget everything (binds, widgets, the gui).
function TouchControls._Reset()
	for input in pairs(held) do
		held[input] = nil
	end
	binds = {}
	widgets = {}
	if gui then
		gui:Destroy()
		gui = nil
	end
	warnedContext = false
	TouchControls._ContextOverride = nil
end

--------------------------------------------------------------------------------
-- Wiring (only once there's something to do: nothing runs while the flag is off)
--------------------------------------------------------------------------------

local wired = false

function TouchControls.Wire()
	if wired or not TouchControls.Enabled then
		return
	end
	wired = true
	UserInputService.InputEnded:Connect(function(input)
		release(input)
	end)
	UserInputService.InputChanged:Connect(function(input)
		local entry = held[input]
		if entry and entry.bind.onDrag and input.UserInputType == Enum.UserInputType.Touch then
			entry.bind.onDrag(Vector2.new(input.Delta.X, input.Delta.Y))
		end
	end)
	pcall(function()
		UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(TouchControls.Refresh)
	end)
	pcall(function()
		GuiService:GetPropertyChangedSignal("TouchControlsEnabled"):Connect(TouchControls.Refresh)
	end)
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(TouchControls.Refresh)
	end
	local player = Players.LocalPlayer
	if player then
		player:GetAttributeChangedSignal("MenuOpen"):Connect(TouchControls.Refresh)
	end
	-- Where the player is, from the same remotes the HUD reads. Looked up in the background: a missing
	-- remote leaves `known` false, which shows the match buttons.
	task.spawn(function()
		local ok, err = pcall(function()
			local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
			Remotes.Event("MatchChanged").OnClientEvent:Connect(function(match)
				state.known = true
				state.matchState = type(match) == "table" and match.state or nil
				TouchControls.Refresh()
			end)
			Remotes.Event("LoadoutChanged").OnClientEvent:Connect(function(loadout)
				state.hasLoadout = loadout ~= nil
				TouchControls.Refresh()
			end)
			Remotes.Event("RangeState").OnClientEvent:Connect(function(on)
				state.range = on == true
				TouchControls.Refresh()
			end)
			Remotes.Event("Spectate").OnClientEvent:Connect(function(on)
				state.spectating = on == true
				TouchControls.Refresh()
			end)
		end)
		if not ok then
			warn("[TouchControls] couldn't listen for the match state; the match buttons stay up: " .. tostring(err))
		end
	end)
end

-- Wires itself on first use, so an owner never has to call Wire. Does nothing at all with the flag off.
function TouchControls.Bind(name, spec)
	if not TouchControls.Enabled then
		return
	end
	TouchControls.Wire()
	bindNow(name, spec)
end

return TouchControls
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX188"><Properties><string name="Name">TrafficClient</string><ProtectedString name="Source">-- Traffic lights. Every signal lamp on the map (MapDecor.TrafficSignal) is tagged TrafficLamp and
-- carries everything needed to run it as attributes: which lamp it is (Lamp red / amber / green),
-- which way its approach runs (Axis x or z), its junction's Phase, the GreenTime / AmberTime /
-- AllRedTime of the cycle, and its OnColor and OffColor. This lights whichever lamp should be on,
-- on the client, so the server never has to replicate a colour change.
--
-- Every client works the cycle out from the server's clock, so all players see the same light at
-- the same moment. Approaches along X are green while approaches along Z are red and the other way
-- round, with an all-red pause between; each junction has its own phase, so neighbours don't all
-- change together. Lamps stream in and out with the map, so they're tracked by tag rather than
-- looked up once.

local CollectionService = game:GetService("CollectionService")

local TAG = "TrafficLamp"

-- Strong tables, cleared when a lamp goes: weak Instance keys lose live entries.
local lamps = {}
local shown = {}

local function track(lamp)
	if lamp:IsA("BasePart") then
		lamps[lamp] = true
	end
end

local function untrack(lamp)
	lamps[lamp] = nil
	shown[lamp] = nil
end

for _, lamp in ipairs(CollectionService:GetTagged(TAG)) do
	track(lamp)
end
CollectionService:GetInstanceAddedSignal(TAG):Connect(track)
CollectionService:GetInstanceRemovedSignal(TAG):Connect(untrack)

-- Which lamp is lit on a signal `t` seconds into its junction's cycle.
local function litLamp(lamp, now)
	local green = lamp:GetAttribute("GreenTime") or 9
	local amber = lamp:GetAttribute("AmberTime") or 2.5
	local allRed = lamp:GetAttribute("AllRedTime") or 1.5
	local half = green + amber + allRed
	local t = (now + (lamp:GetAttribute("Phase") or 0)) % (half * 2)
	if lamp:GetAttribute("Axis") == "z" then
		t = (t + half) % (half * 2)
	end
	if t &lt; green then
		return "green"
	elseif t &lt; green + amber then
		return "amber"
	end
	return "red"
end

while true do
	local now = workspace:GetServerTimeNow()
	for lamp in pairs(lamps) do
		if lamp.Parent then
			local kind = lamp:GetAttribute("Lamp")
			local onColor, offColor = lamp:GetAttribute("OnColor"), lamp:GetAttribute("OffColor")
			if kind and typeof(onColor) == "Color3" and typeof(offColor) == "Color3" then
				local on = litLamp(lamp, now) == kind
				if shown[lamp] ~= on then
					shown[lamp] = on
					lamp.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
					lamp.Color = on and onColor or offColor
				end
			end
		else
			untrack(lamp)
		end
	end
	task.wait(0.2)
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX189"><Properties><string name="Name">UiKit</string><ProtectedString name="Source">-- Shared UI helpers for the client scripts. ModuleScript, not a LocalScript.

local UiKit = {}

UiKit.Colors = {
	Background = Color3.fromRGB(20, 22, 30),
	Panel = Color3.fromRGB(32, 35, 46),
	PanelAlt = Color3.fromRGB(42, 46, 60),
	Accent = Color3.fromRGB(255, 184, 48),
	Green = Color3.fromRGB(94, 214, 122),
	Red = Color3.fromRGB(232, 92, 92),
	Storm = Color3.fromRGB(158, 132, 255),
	Text = Color3.fromRGB(240, 242, 248),
	Muted = Color3.fromRGB(146, 152, 170),
}

--------------------------------------------------------------------------------
-- Design tokens
--
-- The interface grew one panel at a time and ended up with 7 fonts, 24 text sizes, 20 corner radii
-- and 14 tween durations (counted by tools/menu_hud_audit.py). These are the values everything is
-- being moved onto, one section at a time. Nothing reads them until a section is converted, so
-- adding them changes nothing on screen.
--
-- `Colors` above stays as the old names; `Role` is the same palette said once, plus the roles it
-- was missing. New work uses Role.
--------------------------------------------------------------------------------

UiKit.Role = {
	Scrim = Color3.fromRGB(8, 9, 13),
	Base = UiKit.Colors.Background,
	Surface = UiKit.Colors.Panel,
	SurfaceAlt = UiKit.Colors.PanelAlt,
	Line = Color3.fromRGB(58, 63, 78),
	Text = UiKit.Colors.Text,
	TextMuted = UiKit.Colors.Muted,
	Accent = UiKit.Colors.Accent,
	-- What goes ON accent: near-black, so accent buttons keep their contrast.
	AccentInk = Color3.fromRGB(28, 20, 0),
	Positive = UiKit.Colors.Green,
	Negative = UiKit.Colors.Red,
	Storm = UiKit.Colors.Storm,
	Info = Color3.fromRGB(86, 200, 255),
}

-- Six steps. Nothing below 14 carries meaning on its own; Caption is for a line sitting next to
-- something bigger that already says what it is.
UiKit.Type = {
	Display = { Size = 34, Font = Enum.Font.FredokaOne },
	Title = { Size = 26, Font = Enum.Font.FredokaOne },
	Heading = { Size = 20, Font = Enum.Font.GothamBold },
	Body = { Size = 16, Font = Enum.Font.Gotham },
	Label = { Size = 14, Font = Enum.Font.GothamBold },
	Caption = { Size = 12, Font = Enum.Font.Gotham },
}

UiKit.Space = { XS = 4, SM = 8, MD = 12, LG = 16, XL = 24, XXL = 32 }
UiKit.Radius = { Control = 8, Card = 12, Panel = 16, Pill = 999 }
UiKit.Stroke = { Hairline = 1, Focus = 2 }
-- Quad Out for everything; Back Out only where something is meant to feel like a prize.
UiKit.Motion = { Press = 0.12, Fade = 0.18, Panel = 0.28, Celebrate = 0.45 }
-- The smallest anything tappable may be, on any device.
UiKit.Touch = 44

-- Where the bottom row of the HUD sits, in raw unscaled pixels from the screen edges. StaminaBar
-- worked these out by reading HudClient and kept its own copies; they live here now so the bar,
-- the hotbar and anything else placed along the bottom read one set of numbers. Change these when
-- the revamp moves the health panel or the hotbar, and everything that reads them follows.
UiKit.BottomRow = {
	-- Bottom-left: the health panel's right edge, and the top of the stack above it (companion
	-- panel, then the speed-boost pill).
	HealthRight = 296,
	LeftStackTop = 202,
	-- Bottom-right: how far in from the right edge the hotbar starts.
	HotbarInset = 706,
	-- The clear space to leave between two things along this row.
	Gap = 12,
}

-- WHICH VERSION OF THE INTERFACE A SCREEN GETS. One function; nothing else may decide this.
--
-- Oliver, after seeing the gallery: "the menu and hud in the gallary here looks good but doesnt sem
-- to work for smaller screens and vertical screens, make seperate versions for them."
--
-- The boundary is not how BIG a screen is, it is WHICH DIMENSION HAS RUN OUT, because that is what
-- decides the design:
--
--   large   nothing is scarce                   rail on the left, 2-3 columns
--   short   HEIGHT has run out                  landscape phone: 780 px wide, 208 px tall
--   tall    WIDTH has run out                   portrait phone: 296-350 px of content
--
-- Named for the dimension, not the device. "small" and "vertical" were the other candidates and
-- were rejected for a concrete reason: a portrait TABLET is upright and is `large`, so a name
-- containing "vertical" would be a lie at the one boundary people get wrong.
--
-- Which is why `short` puts navigation in a 64-wide ICON RAIL and `tall` puts it in a bottom
-- bar. On an 844x390 phone a bottom bar costs 68 px out of a 260 px panel; a rail spends width,
-- which that shape has 716 px of, and buys height, which it has none of — content height goes from
-- 128 to 208. A bottom bar is right on a portrait phone and wrong on a landscape one, and no rule
-- based on size alone could say that.
--
-- THE NUMBERS ARE MEASURED. Do not move them on instinct; re-measure and change this comment.
--
--   600 of panel width: below it a two-column grid stops fitting, since a card needs ~260 plus a
--   12 px gutter and the panel spends 24 on its own padding.
--
--   500 of viewport height, and the reason is NOT the one you would guess. Measured after layout by
--   claude-a4's probe, the large Rank page needs 476 px of content before PRESTIGE is reachable
--   without scrolling (Index 115, Shop 78, Mastery 70). Content is roughly viewport.Y − 232 on a
--   touch screen, so the LARGE Rank page does not fit above the fold until about 708 — and the
--   threshold is still 500, deliberately.
--
--   500 works BECAUSE the short version exists: the short Rank page puts PRESTIGE inside the hero
--   card, where the lifetime numbers used to be, at about 156 px — well inside the 208 px of list
--   an 844x390 phone actually has. (An earlier draft put it at ~250, which would have been 42 px
--   below the fold on the very screen the short version exists for.) Raising this number to 708
--   would send most laptops to the
--   short version to fix a page that the short version already fixes. If someone later measures the
--   large Rank page and concludes this boundary is too low, that is the mistake they are making.
--
-- NOT THE SAME QUESTION AS PhoneLayout.Mode, and the names are deliberately different so nobody
-- mistakes them for each other. That one answers "what DEVICE is this" — it requires touch, and it
-- calls any upright touch screen "vertical" because Roblox owns the lower half of one whatever its
-- size. This answers "what SHAPE is this screen": a portrait TABLET is a touch device and an
-- upright one, and it is still `large` here, because 728 px of panel is not a small screen. Both
-- are right for what they decide; they return different words on purpose. The only place they could
-- disagree in a way that matters is how big a tappable thing must be, and that is 44 px everywhere
-- regardless, so it cannot bite. Do NOT unify them: one question would answer neither.
--
-- `contentWidth` is optional, for a caller drawing into a container rather than a whole panel.
function UiKit.form(viewport, contentWidth)
	local width = contentWidth
	if not width then
		local safe = UiKit.safeArea(viewport, true)
		width = math.clamp(viewport.X - safe.Left - safe.Right, 320, 1180)
	end
	if width &lt; 600 then
		return "tall"
	elseif viewport.Y &lt; 500 then
		return "short"
	end
	return "large"
end

-- What to keep clear: Roblox's top bar, and room for thumbs on a touch screen.
function UiKit.safeArea(viewport, touch)
	return {
		Top = 52 + UiKit.Space.SM,
		Bottom = touch and 96 or UiKit.Space.LG,
		Left = touch and 20 or UiKit.Space.LG,
		Right = touch and 20 or UiKit.Space.LG,
	}
end

-- A panel that fills a phone inside its safe area, and is a share of a bigger screen without ever
-- growing past the width text still reads well at.
function UiKit.panelSize(viewport, touch)
	local safe = UiKit.safeArea(viewport, touch)
	local width = math.clamp(viewport.X - safe.Left - safe.Right, 320, 1180)
	local height = math.clamp(viewport.Y - safe.Top - safe.Bottom, 260, 760)
	if UiKit.form(viewport) ~= "tall" then
		width = math.min(width, math.max(720, viewport.X * 0.86))
		height = math.min(height, math.max(420, viewport.Y * 0.86))
	end
	return Vector2.new(math.floor(width), math.floor(height))
end

-- A TEXT WIDTH THAT CANNOT COME OUT NEGATIVE.
--
-- `UDim2.new(1, -N, ...)` where N exceeds the parent's width does NOT truncate the text. Roblox
-- draws nothing at all, so the row comes up blank with no sign of what happened -- invisible in
-- review, invisible in any landscape test, and only reachable at all once the menu's `tall` form
-- started running. Five labels in MenuClient were one viewport away from going blank on a portrait
-- phone, and the crate odds line and the progression rows had already vanished this way at 296 px.
--
-- Below the width where the reserve stops fitting, THE RESERVE IS GIVEN UP RATHER THAN THE TEXT,
-- because the text is what the player came to read. `MIN` is what a label keeps whatever else has
-- to give; a caller wanting a different floor passes one.
--
-- Pure, and it lives here rather than in MenuClient for the reason the shell's viewport wiring
-- does: MenuClient is a LocalScript and nothing in the harness can run one, so logic written there
-- is logic no probe can ever check. Here it is one require away.
function UiKit.textSpan(width, reservePx, height, minimum)
	local floor = minimum or 64
	local capped = math.min(reservePx, math.max(0, (width or 0) - floor))
	return UDim2.new(1, -capped, 0, height)
end

function UiKit.create(className, props, children)
	local instance = Instance.new(className)
	local parent = props and props.Parent

	for key, value in pairs(props or {}) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end

	return instance
end

function UiKit.rounded(radius)
	return UiKit.create("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UiKit.padding(px)
	return UiKit.create("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

function UiKit.formatNumber(value)
	value = math.floor(value or 0)
	local suffixes = { "", "K", "M", "B", "T" }
	local index, scaled = 1, value

	while scaled &gt;= 1000 and index &lt; #suffixes do
		scaled /= 1000
		index += 1
	end

	if index == 1 then
		return tostring(value)
	end
	return string.format("%.1f%s", scaled, suffixes[index])
end

-- Clears a layout container but keeps its UIListLayout/UIGridLayout intact.
function UiKit.clearItems(container)
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

return UiKit
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX190"><Properties><string name="Name">UiParts</string><ProtectedString name="Source">-- The pieces every panel is built from, drawn once here instead of by hand in each tab.
--
-- The menu and the HUD grew a panel at a time and ended up with 7 fonts, 24 text sizes, 20 corner
-- radii and 14 tween durations (tools/menu_hud_audit.py counts them). Everything here takes its
-- numbers from UiKit's tokens, so a change to a token moves every screen at once.
--
-- Three rules hold throughout:
--   * anything tappable is at least UiKit.Touch (44 px) on its shortest side, on every device;
--   * every control answers rest / hover / press / disabled / focus, so a tap or a gamepad always
--     shows it landed;
--   * meaning is never carried by colour alone — a rarity has a label as well as an edge.
--
-- A ModuleScript, so tools/menu_hud_gallery.lua can render these without a running client.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local UiKit = require(script.Parent:WaitForChild("UiKit"))

local create, rounded, padding = UiKit.create, UiKit.rounded, UiKit.padding
local Role, Type, Space, Radius, Stroke, Motion = UiKit.Role, UiKit.Type, UiKit.Space, UiKit.Radius, UiKit.Stroke, UiKit.Motion

local UiParts = {}

-- The SAME function as UiKit.form, not a copy: claude-a4's width probe renders pages into its own
-- frame with no shell around them and needs it as a pure call, and two implementations of "which
-- version is this screen" is precisely what everyone agreed not to have. Returns "large", "short"
-- or "tall". Pass a content width when you are inside a container rather than a whole panel — and
-- pass the CONTAINER's width, not the page's, or a row nested in a card measures the wrong thing.
UiParts.form = UiKit.form

local PRESS = TweenInfo.new(Motion.Press, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FADE = TweenInfo.new(Motion.Fade, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PANEL_IN = TweenInfo.new(Motion.Panel, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Button kinds: the colour and the ink that keeps its contrast.
local KINDS = {
	primary = { fill = Role.Accent, ink = Role.AccentInk },
	positive = { fill = Role.Positive, ink = Role.AccentInk },
	danger = { fill = Role.Negative, ink = Role.Text },
	secondary = { fill = Role.SurfaceAlt, ink = Role.Text },
	ghost = { fill = Role.Surface, ink = Role.TextMuted },
}

--------------------------------------------------------------------------------
-- Text
--------------------------------------------------------------------------------

-- A label at one of the six type steps. `style` is a UiKit.Type entry.
function UiParts.text(parent, style, value, color, props)
	local label = create("TextLabel", {
		BackgroundTransparency = 1,
		Font = style.Font,
		Text = value,
		TextColor3 = color or Role.Text,
		TextSize = style.Size,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	})
	for key, value2 in pairs(props or {}) do
		label[key] = value2
	end
	return label
end

--------------------------------------------------------------------------------
-- Controls
--------------------------------------------------------------------------------

-- Gives any button the four states. Kept separate so a tab, a chip and a card action all feel the
-- same under the finger.
function UiParts.interactive(button, fill, ink, enabled)
	if enabled == false then
		button.AutoButtonColor = false
		button.BackgroundColor3 = Role.SurfaceAlt
		button.TextColor3 = Role.TextMuted
		button.Active = false
		button.Selectable = false
		return button
	end

	-- AutoButtonColor's own shading fights the tweens below, so the states are all done here.
	button.AutoButtonColor = false
	local hover = fill:Lerp(Color3.new(1, 1, 1), 0.12)
	local press = fill:Lerp(Color3.new(0, 0, 0), 0.18)
	local focusStroke = create("UIStroke", {
		Color = Role.Text,
		Thickness = Stroke.Focus,
		Transparency = 1,
		Parent = button,
	})

	local function to(color)
		TweenService:Create(button, PRESS, { BackgroundColor3 = color }):Play()
	end
	button.MouseEnter:Connect(function()
		to(hover)
	end)
	button.MouseLeave:Connect(function()
		to(fill)
	end)
	button.MouseButton1Down:Connect(function()
		to(press)
	end)
	button.MouseButton1Up:Connect(function()
		to(hover)
	end)
	-- A finger has no "leave". Roblox sends a touch tap through the mouse events, so a tapped button
	-- lands on `hover` and stays there — MouseLeave never comes, and the phone ends up with a row of
	-- buttons that all look half-pressed. Touch input gets put back explicitly; a mouse is unaffected
	-- because this only fires for Touch.
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			to(fill)
		end
	end)
	-- Gamepad and keyboard focus: the same ring a mouse user never needs but a pad user lives by.
	button.SelectionGained:Connect(function()
		TweenService:Create(focusStroke, FADE, { Transparency = 0 }):Play()
	end)
	button.SelectionLost:Connect(function()
		TweenService:Create(focusStroke, FADE, { Transparency = 1 }):Play()
	end)
	return button
end

-- options: kind, width, height, text, icon, onClick, enabled, layoutOrder, parent, grow
function UiParts.button(options)
	local kind = KINDS[options.kind or "primary"] or KINDS.primary
	local height = math.max(options.height or UiKit.Touch, UiKit.Touch)
	local button = create("TextButton", {
		Size = options.grow and UDim2.new(1, 0, 0, height) or UDim2.fromOffset(options.width or 120, height),
		BackgroundColor3 = kind.fill,
		BorderSizePixel = 0,
		Font = Type.Label.Font,
		Text = options.icon and (options.icon .. "  " .. (options.text or "")) or (options.text or ""),
		TextColor3 = kind.ink,
		TextSize = Type.Label.Size,
		LayoutOrder = options.layoutOrder or 1,
		Parent = options.parent,
	}, { rounded(Radius.Control) })

	UiParts.interactive(button, kind.fill, kind.ink, options.enabled)
	if options.enabled ~= false and options.onClick then
		button.Activated:Connect(options.onClick)
	end
	return button
end

-- A filter or toggle pill. Selected reads as filled; unselected as an outline, never as grey text
-- alone.
function UiParts.chip(options)
	local selected = options.selected == true
	local fill = selected and Role.Accent or Role.Surface
	local chip = create("TextButton", {
		Size = UDim2.fromOffset(options.width or 96, math.max(options.height or 36, 36)),
		BackgroundColor3 = fill,
		BorderSizePixel = 0,
		Font = Type.Label.Font,
		Text = options.text or "",
		TextColor3 = selected and Role.AccentInk or Role.TextMuted,
		TextSize = Type.Caption.Size + 1,
		LayoutOrder = options.layoutOrder or 1,
		Parent = options.parent,
	}, { rounded(Radius.Pill) })
	if not selected then
		create("UIStroke", { Color = Role.Line, Thickness = Stroke.Hairline, Parent = chip })
	end
	UiParts.interactive(chip, fill, selected and Role.AccentInk or Role.TextMuted, options.enabled)
	if options.onClick then
		chip.Activated:Connect(options.onClick)
	end
	return chip
end

-- A row of media, text and actions that changes shape rather than shrinking: media left, text in
-- the middle and actions on the right while there is room; below `threshold` the media shrinks to
-- the top-left, the text takes the full width and the actions become a full-width row underneath.
--
-- Written to claude-f5's spec after their crate card broke on a narrow screen, and it bakes in the
-- two rules that failure taught, so no caller has to remember them:
--
--   * A text column is sized by SCALE inside its own frame, never `UDim2.new(1, -340, ...)` off the
--     card. A fixed negative offset looks identical to a correct one until the parent is narrow,
--     and then it is a NEGATIVE width: the label doesn't truncate, it disappears. That is how the
--     crate card's odds line vanished at 296 px of content while reading fine at 780.
--   * A line marked `disclosure` (odds, prices, refund percentages) wraps and never truncates, at
--     every width. Cutting "Comm 62.0% Unco 26.0% Rare 9.0%..." in half misstates the odds of a
--     thing bought with real money, which is a different kind of wrong from an ugly layout.
--
-- options: width, threshold (560), media (102), mediaNarrow (72), pad (Space.LG), actions (a list
-- of UiParts.button options), lines (how many text lines under the title, for the height).
-- Returns { Frame, Media, Text, Actions, Narrow, Height, Line }.
function UiParts.splitRow(parent, options)
	local width = options.width or 720
	local pad = options.pad or Space.LG
	local narrow = width &lt; (options.threshold or 560)
	local mediaSize = narrow and (options.mediaNarrow or 72) or (options.media or 102)
	local actions = options.actions or {}
	local textLines = options.lines or 2
	-- `textHeight` overrides the line count, for a column holding something taller than text — a
	-- meterLine, say, which is a label, a bar and a caption rather than one line.
	local textHeight = options.textHeight or (Type.Heading.Size + 6 + textLines * (Type.Body.Size + 6))

	local actionsWidth = 0
	for _, action in ipairs(actions) do
		actionsWidth += (action.width or 120) + Space.SM
	end
	actionsWidth = math.max(actionsWidth - Space.SM, 0)

	-- An extra block under the text at the wide size only — a strip of pictures, say. It is skipped
	-- narrow on purpose: the things that go here restate what the text already said, and on a screen
	-- with 236 px of content a second telling costs a third of a card. Ask for it with a height.
	local belowHeight = 0
	if not narrow and options.belowText then
		belowHeight = tonumber(options.belowText) or 42
	end

	local height
	if narrow then
		height = pad + math.max(mediaSize, textHeight) + Space.MD + (#actions &gt; 0 and UiKit.Touch or 0) + pad
	else
		local stacked = textHeight + (belowHeight &gt; 0 and (Space.SM + belowHeight) or 0)
		height = math.max(mediaSize, stacked, UiKit.Touch) + pad * 2
	end

	local frame = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		LayoutOrder = options.layoutOrder or 1,
		Parent = parent,
	})

	local media = create("Frame", {
		Position = UDim2.fromOffset(pad, pad),
		Size = UDim2.fromOffset(mediaSize, mediaSize),
		BackgroundColor3 = Role.SurfaceAlt,
		BorderSizePixel = 0,
		-- So a child takes the rounded corner: this slot is a picture, and a picture with square
		-- corners inside a rounded well is the sort of thing nobody files but everybody sees.
		ClipsDescendants = true,
		Parent = frame,
	}, { rounded(Radius.Control) })
	-- `mediaInstance` takes something the caller already built — a ViewportFrame with a 3D icon in
	-- it, typically — and fits it to the slot, so the caller doesn't repeat the sizing at each
	-- breakpoint. It keeps its own contents; only where it sits and how big it is are set here.
	if options.mediaInstance and options.mediaInstance:IsA("GuiObject") then
		options.mediaInstance.AnchorPoint = Vector2.zero
		options.mediaInstance.Position = UDim2.new()
		options.mediaInstance.Size = UDim2.fromScale(1, 1)
		options.mediaInstance.Parent = media
	end

	-- `rightReserve` keeps the right-hand end of the row clear of stacked text, for a caller that
	-- draws its own thing there — claude-df's 3D parachute preview sits at the row's right edge and
	-- would otherwise have restacked text run underneath it between 420 and 560 px, where the
	-- preview is still shown but the layout has already restacked.
	--
	-- The reserve is measured from the row's right edge to the FAR side of that element, not to its
	-- near edge. I first suggested 118 for a preview positioned `UDim2.new(1, -118, ...)` and 96
	-- wide, which stops the text exactly at the preview's right edge and leaves it lying across all
	-- 96 px of it; df caught it. The number is 118 + 96 + 8 of air = 222. An anchor offset tells you
	-- where an element STARTS, and a reserve has to clear where it ENDS.
	local reserve = options.rightReserve or 0
	local textLeft = pad + mediaSize + Space.MD
	local textWidth = narrow and (width - textLeft - pad - reserve)
		or (width - textLeft - actionsWidth - Space.MD - pad)
	local text = create("Frame", {
		Position = UDim2.fromOffset(textLeft, pad),
		Size = UDim2.fromOffset(math.max(textWidth, 80), narrow and math.max(textHeight, mediaSize) or textHeight),
		BackgroundTransparency = 1,
		Parent = frame,
	}, {
		create("UIListLayout", {
			Padding = UDim.new(0, Space.XS),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local below = nil
	if belowHeight &gt; 0 then
		below = create("Frame", {
			Position = UDim2.fromOffset(textLeft, pad + textHeight + Space.SM),
			Size = UDim2.fromOffset(math.max(textWidth, 80), belowHeight),
			BackgroundTransparency = 1,
			Parent = frame,
		})
	end

	local actionFrame = create("Frame", {
		AnchorPoint = narrow and Vector2.new(0, 1) or Vector2.new(1, 0.5),
		Position = narrow and UDim2.new(0, pad, 1, -pad) or UDim2.new(1, -pad, 0.5, 0),
		Size = narrow and UDim2.new(1, -pad * 2, 0, UiKit.Touch) or UDim2.fromOffset(actionsWidth, UiKit.Touch),
		BackgroundTransparency = 1,
		Parent = frame,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = narrow and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, Space.SM),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	-- Narrow actions share the row equally, so three buttons fill the width instead of huddling.
	local shareWidth = #actions &gt; 0
		and math.floor((width - pad * 2 - Space.SM * (#actions - 1)) / #actions)
		or 0
	for index, action in ipairs(actions) do
		local spec = table.clone(action)
		spec.parent = actionFrame
		spec.layoutOrder = index
		spec.width = narrow and shareWidth or (action.width or 120)
		UiParts.button(spec)
	end

	local lineOrder = 0
	-- spec: text, style (a UiKit.Type entry), color, disclosure
	local function line(spec)
		lineOrder += 1
		local style = spec.style or Type.Body
		-- Said plainly, because the alternative is "attempt to perform arithmetic on nil" from a line
		-- twenty below this one. A caller with its own token table (the gallery has one, in lower
		-- case) hits this, and the message should name the fix rather than the symptom.
		if type(style) ~= "table" or type(style.Size) ~= "number" then
			error("UiParts: `style` must be a UiKit.Type entry with Size and Font, e.g. UiKit.Type.Heading", 2)
		end
		local disclosure = spec.disclosure == true
		local label = UiParts.text(text, style, spec.text or "", spec.color or Role.Text, {
			Size = UDim2.new(1, 0, 0, disclosure and (style.Size + 6) * 2 or style.Size + 6),
			LayoutOrder = lineOrder,
			TextWrapped = disclosure,
			TextTruncate = disclosure and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
			TextYAlignment = disclosure and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		})
		return label
	end

	-- A meter in the text column, stacked with the Lines and told which shape it is in, so a caller
	-- never repeats the breakpoint. Pass `textHeight` to splitRow to make room for it.
	local function meter(spec)
		lineOrder += 1
		local copy = table.clone(spec)
		copy.narrow = narrow
		copy.layoutOrder = lineOrder
		return UiParts.meterLine(text, copy)
	end

	-- `Below` is nil at the narrow size, so `if row.Below then` is the caller's whole breakpoint test.
	return { Frame = frame, Media = media, Text = text, Actions = actionFrame, Below = below,
		Narrow = narrow, Height = height, Line = line, Meter = meter }
end

--------------------------------------------------------------------------------
-- Containers
--------------------------------------------------------------------------------

-- A surface with a hairline, and optionally a coloured edge down its left side for a rarity or a
-- state. The edge is always paired with a label by the caller, never used on its own.
function UiParts.card(options)
	local card = create("Frame", {
		Size = options.size or UDim2.new(1, 0, 0, 116),
		Position = options.position,
		AnchorPoint = options.anchorPoint,
		BackgroundColor3 = options.color or Role.Surface,
		BorderSizePixel = 0,
		LayoutOrder = options.layoutOrder or 1,
		Parent = options.parent,
	}, { rounded(Radius.Card) })
	create("UIStroke", { Color = Role.Line, Thickness = Stroke.Hairline, Parent = card })
	if options.edge then
		create("Frame", {
			Position = UDim2.fromOffset(0, Space.MD),
			Size = UDim2.new(0, 4, 1, -Space.MD * 2),
			BackgroundColor3 = options.edge,
			BorderSizePixel = 0,
			Parent = card,
		}, { rounded(Radius.Pill) })
	end
	return card
end

-- The panel header: title on the left, a slot for the wallet, then icon actions on the right.
-- Returns the header and the frame callers can drop the wallet into.
function UiParts.header(options)
	local height = options.height or 64
	local header = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		Parent = options.parent,
	}, { padding(Space.LG) })

	-- The title's width is what is LEFT after the wallet and the buttons, worked out from their real
	-- widths — not a fixed 320, which is what it used to be and which is the same mistake I have
	-- spent today finding in other people's files. At a 320-wide panel, `1, -320` left the title
	-- nothing and the game's name rendered as "BRAI". Caught in a portrait render, not by reading.
	--
	-- Below `SLOT_DROPS` of remaining room the wallet slot is given up rather than the title: the
	-- panel's name is how a player knows what they are looking at, and the coin count is repeated
	-- inside the tabs that spend coins.
	local SLOT_DROPS = 150
	local width = options.width or 0
	local actionsWidth = #(options.actions or {}) * (UiKit.Touch + Space.SM)
	local slotWidth = options.slotWidth or 168
	local room = width - Space.LG * 2 - actionsWidth - Space.SM
	local showSlot = options.slot ~= false and (width == 0 or room - slotWidth &gt;= SLOT_DROPS)
	local reserve = actionsWidth + Space.SM + (showSlot and slotWidth + Space.SM or 0)

	UiParts.text(header, options.compact and Type.Heading or Type.Title, options.title or "", Role.Text, {
		Size = UDim2.new(1, -reserve, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local actions = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(#(options.actions or {}) * (UiKit.Touch + Space.SM), UiKit.Touch),
		BackgroundTransparency = 1,
		Parent = header,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, Space.SM),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for index, action in ipairs(options.actions or {}) do
		local button = UiParts.button({
			kind = "ghost",
			width = UiKit.Touch,
			text = action.glyph,
			onClick = action.onClick,
			layoutOrder = index,
			parent = actions,
		})
		button.TextSize = Type.Heading.Size
	end

	local slot = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -(actionsWidth + Space.SM), 0.5, 0),
		Size = UDim2.fromOffset(slotWidth, UiKit.Touch),
		BackgroundTransparency = 1,
		Visible = showSlot,
		Parent = header,
	})
	return header, slot
end

-- Nothing here yet, said properly: what's missing, why, and the one button that fixes it.
function UiParts.emptyState(options)
	local frame = UiParts.card({
		size = UDim2.new(1, 0, 0, options.action and 132 or 96),
		layoutOrder = options.layoutOrder,
		parent = options.parent,
	})
	UiParts.text(frame, Type.Heading, options.title or "Nothing here yet", Role.Text, {
		Position = UDim2.fromOffset(Space.LG, Space.MD),
		Size = UDim2.new(1, -Space.LG * 2, 0, 24),
	})
	UiParts.text(frame, Type.Body, options.body or "", Role.TextMuted, {
		Position = UDim2.fromOffset(Space.LG, Space.MD + 26),
		Size = UDim2.new(1, -Space.LG * 2, 0, 22),
		TextWrapped = true,
	})
	if options.action then
		UiParts.button({
			kind = "primary",
			width = options.action.width or 180,
			text = options.action.text,
			onClick = options.action.onClick,
			parent = frame,
		}).Position = UDim2.fromOffset(Space.LG, 132 - Space.MD - UiKit.Touch)
	end
	return frame
end

-- A bar with a label, for pass tiers, quest progress and anything else counted. The number is
-- always written as well as drawn.
function UiParts.meter(options)
	local frame = create("Frame", {
		Size = options.size or UDim2.new(1, 0, 0, 28),
		Position = options.position,
		BackgroundTransparency = 1,
		LayoutOrder = options.layoutOrder or 1,
		Parent = options.parent,
	})
	local track = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, options.showValue == false and 0 or -72, 0, 12),
		BackgroundColor3 = Role.SurfaceAlt,
		BorderSizePixel = 0,
		Parent = frame,
	}, { rounded(Radius.Pill) })
	local fill = create("Frame", {
		Size = UDim2.fromScale(math.clamp(options.alpha or 0, 0, 1), 1),
		BackgroundColor3 = options.color or Role.Accent,
		BorderSizePixel = 0,
		Parent = track,
	}, { rounded(Radius.Pill) })
	if options.showValue ~= false then
		UiParts.text(frame, Type.Label, options.value or "", Role.Text, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(64, 20),
			TextXAlignment = Enum.TextXAlignment.Right,
		})
	end
	return frame, fill
end

-- A label, a bar under it, and a value — the shape progression uses for mastery rows, the rank
-- hero bar and the overflow bar. Built for claude-a4 [34c594] to their spec.
--
-- Everything here is sized by SCALE inside whatever column it is dropped into, so it inherits that
-- column's width and there is no offset to go negative. Wide, the value sits at the right-hand end
-- of the label's line; narrow, it moves to its own line under the bar rather than fighting the
-- label for room. `caption` is the trailing detail (what the next tier pays, say) and it wraps
-- rather than truncates, because those figures are a promise to the player, like the crate odds.
--
-- options: label, value, fraction (0..1), color, caption, narrow, height, layoutOrder
function UiParts.meterLine(parent, options)
	local narrow = options.narrow == true
	local labelHeight = Type.Label.Size + 6
	local barHeight = options.height or 12
	local captionHeight = options.caption and (Type.Caption.Size + 6) * 2 or 0
	local valueRow = (narrow and options.value) and labelHeight or 0
	local total = labelHeight + Space.XS + barHeight + valueRow + (captionHeight &gt; 0 and Space.XS + captionHeight or 0)

	local frame = create("Frame", {
		Size = UDim2.new(1, 0, 0, total),
		BackgroundTransparency = 1,
		LayoutOrder = options.layoutOrder or 1,
		Parent = parent,
	})

	-- Wide, the value is right-aligned on the label's line, so the label is given the room the value
	-- doesn't need rather than a guess at it.
	UiParts.text(frame, Type.Label, options.label or "", Role.Text, {
		Size = narrow and UDim2.new(1, 0, 0, labelHeight) or UDim2.new(0.68, 0, 0, labelHeight),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	if options.value and not narrow then
		UiParts.text(frame, Type.Label, options.value, Role.TextMuted, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.new(0.3, 0, 0, labelHeight),
			TextXAlignment = Enum.TextXAlignment.Right,
		})
	end

	local track = create("Frame", {
		Position = UDim2.fromOffset(0, labelHeight + Space.XS),
		Size = UDim2.new(1, 0, 0, barHeight),
		BackgroundColor3 = Role.SurfaceAlt,
		BorderSizePixel = 0,
		Parent = frame,
	}, { rounded(Radius.Pill) })
	local fill = create("Frame", {
		Size = UDim2.fromScale(math.clamp(options.fraction or 0, 0, 1), 1),
		BackgroundColor3 = options.color or Role.Accent,
		BorderSizePixel = 0,
		Parent = track,
	}, { rounded(Radius.Pill) })

	local below = labelHeight + Space.XS + barHeight
	if options.value and narrow then
		UiParts.text(frame, Type.Label, options.value, Role.TextMuted, {
			Position = UDim2.fromOffset(0, below),
			Size = UDim2.new(1, 0, 0, labelHeight),
		})
		below += labelHeight
	end
	if options.caption then
		UiParts.text(frame, Type.Caption, options.caption, Role.TextMuted, {
			Position = UDim2.fromOffset(0, below + Space.XS),
			Size = UDim2.new(1, 0, 0, captionHeight),
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
	end
	return frame, fill, total
end

--------------------------------------------------------------------------------
-- Navigation and layers
--------------------------------------------------------------------------------

-- One destination. `rail` draws it wide with a subtitle; otherwise it's a bottom-bar cell.
-- `compact` is the small (landscape phone) rail: a glyph only, in a 44 px square, because that
-- shape has width to spare and no height at all. The label would cost nothing horizontally and
-- everything vertically.
function UiParts.navItem(options)
	local selected = options.selected == true
	local fill = selected and Role.Accent or Role.Surface
	local compact = options.rail and options.compact
	local cell = create("TextButton", {
		Size = compact and UDim2.new(1, 0, 0, UiKit.Touch)
			or (options.rail and UDim2.new(1, 0, 0, 56) or UDim2.fromOffset(options.width or 96, UiKit.Touch)),
		BackgroundColor3 = fill,
		BorderSizePixel = 0,
		Text = "",
		LayoutOrder = options.layoutOrder or 1,
		Parent = options.parent,
	}, { rounded(options.rail and Radius.Card or Radius.Control) })
	UiParts.interactive(cell, fill, selected and Role.AccentInk or Role.Text, options.enabled)

	if compact then
		UiParts.text(cell, Type.Heading, options.glyph or "", selected and Role.AccentInk or Role.Text, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
		})
	elseif options.rail then
		UiParts.text(cell, Type.Heading, options.glyph or "", selected and Role.AccentInk or Role.TextMuted, {
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.fromOffset(24, 56),
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		UiParts.text(cell, Type.Label, options.label or "", selected and Role.AccentInk or Role.Text, {
			Position = UDim2.fromOffset(44, 8),
			Size = UDim2.new(1, -52, 0, 20),
		})
		if options.sub then
			UiParts.text(cell, Type.Caption, options.sub, selected and Role.AccentInk or Role.TextMuted, {
				Position = UDim2.fromOffset(44, 28),
				Size = UDim2.new(1, -52, 0, 18),
				TextTransparency = selected and 0.25 or 0,
			})
		end
	else
		local label = options.glyphOnly and (options.glyph or "")
			or ((options.glyph and (options.glyph .. "  ") or "") .. (options.label or ""))
		UiParts.text(cell, Type.Label, label, selected and Role.AccentInk or Role.TextMuted, {
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextSize = options.glyphOnly and Type.Heading.Size or Type.Caption.Size,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
	end
	if options.onClick then
		cell.Activated:Connect(options.onClick)
	end
	return cell
end

-- A dimming layer under a panel or dialog. Clicking it dismisses, the way a player expects.
function UiParts.scrim(parent, onDismiss)
	local scrim = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Role.Scrim,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = parent,
	})
	TweenService:Create(scrim, FADE, { BackgroundTransparency = 0.45 }):Play()
	if onDismiss then
		scrim.Activated:Connect(onDismiss)
	end
	return scrim
end

-- Opens a panel: fades the scrim in and lifts the panel the last few pixels, in Motion.Panel.
--
-- `target` is the scale the panel rests at, 1 unless something is holding it smaller. A panel on a
-- screen too small for it is shrunk to fit by a UIScale, and this animation drives that same object
-- (Roblox honours one UIScale per element), so animating to a flat 1 would quietly undo the fit and
-- push the panel's bottom back off the screen. It animates to a fraction of the target instead.
function UiParts.openPanel(panel, scale, target)
	panel.Visible = true
	target = target or 1
	scale = scale or panel:FindFirstChildOfClass("UIScale") or create("UIScale", { Parent = panel })
	scale.Scale = target * 0.96
	TweenService:Create(scale, PANEL_IN, { Scale = target }):Play()
	return scale
end

function UiParts.closePanel(panel, scale, onClosed, target)
	scale = scale or panel:FindFirstChildOfClass("UIScale")
	target = target or 1
	if not scale then
		panel.Visible = false
		if onClosed then
			onClosed()
		end
		return
	end
	local tween = TweenService:Create(scale, PRESS, { Scale = target * 0.97 })
	tween.Completed:Connect(function()
		panel.Visible = false
		scale.Scale = target
		if onClosed then
			onClosed()
		end
	end)
	tween:Play()
end

-- A modal question. Returns the dialog; `onDismiss` is called by the scrim, the X and Escape, so
-- there is always a way out.
function UiParts.dialog(options)
	local viewport = options.viewport or Vector2.new(1280, 720)
	local touch = UserInputService.TouchEnabled
	local width = math.min(options.width or 420, viewport.X - UiKit.safeArea(viewport, touch).Left * 2)
	local layer = create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = options.parent,
	})
	UiParts.scrim(layer, options.onDismiss)

	local dialog = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, options.height or 220),
		BackgroundColor3 = Role.Base,
		BorderSizePixel = 0,
		Parent = layer,
	}, { rounded(Radius.Panel) })
	create("UIStroke", { Color = Role.Line, Thickness = Stroke.Hairline, Parent = dialog })

	UiParts.text(dialog, Type.Heading, options.title or "", Role.Text, {
		Position = UDim2.fromOffset(Space.LG, Space.LG),
		Size = UDim2.new(1, -Space.LG * 2 - UiKit.Touch, 0, 26),
	})
	UiParts.text(dialog, Type.Body, options.body or "", Role.TextMuted, {
		Position = UDim2.fromOffset(Space.LG, Space.LG + 30),
		Size = UDim2.new(1, -Space.LG * 2, 0, 48),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
	})

	local actions = create("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -Space.LG, 1, -Space.LG),
		Size = UDim2.new(1, -Space.LG * 2, 0, UiKit.Touch),
		BackgroundTransparency = 1,
		Parent = dialog,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, Space.SM),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for index, action in ipairs(options.actions or {}) do
		UiParts.button({
			kind = action.kind or (index == #(options.actions or {}) and "primary" or "secondary"),
			width = action.width or 132,
			text = action.text,
			onClick = action.onClick,
			layoutOrder = index,
			parent = actions,
		})
	end
	UiParts.openPanel(dialog)
	return layer, dialog
end

--------------------------------------------------------------------------------
-- Layout
--------------------------------------------------------------------------------

-- How many card columns fit a width, so a grid reflows instead of being fixed per screen.
function UiParts.columns(width, minimum)
	minimum = minimum or 300
	return math.max(1, math.floor((width + Space.MD) / (minimum + Space.MD)))
end

-- A grid that fills its parent, sized from the columns that fit.
function UiParts.grid(parent, width, cardHeight, minimum)
	local columns = UiParts.columns(width, minimum)
	local cardWidth = math.floor((width - Space.MD * (columns - 1)) / columns)
	local layout = create("UIGridLayout", {
		CellSize = UDim2.fromOffset(cardWidth, cardHeight),
		CellPadding = UDim2.fromOffset(Space.MD, Space.MD),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
	return layout, columns, cardWidth
end

return UiParts
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX191"><Properties><string name="Name">VehicleClient</string><ProtectedString name="Source">-- The driver's side of vehicles, and the moving parts of every vehicle you can see.
--
-- While you drive, the server hands you the chassis's physics and this script steps the shared
-- VehicleDynamics on your machine every frame, so the car answers the moment you press a key. If
-- the server takes it back for a moment (after a blast, or because something looked wrong) the
-- model carries ServerControl and this holds off.
--
-- For every vehicle near you, yours or anyone else's, it animates what moves: wheels bob, steer
-- and spin, a bike's fork turns and slides, its swingarm swings, a car's steering wheel turns. All
-- of it is Motor6D.Transform set locally from local rays, so nothing extra crosses the network.
-- Riders are posed the same way: hands on the bars or the wheel, feet on the pegs.
--
-- Controls while driving: W/S or the triggers to drive and brake, A/D or the stick to steer, Shift
-- (L1, or the on-screen button) for the handbrake, Space to get out.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VehicleDynamics = require(Shared:WaitForChild("VehicleDynamics"))
local VehicleModels = require(Shared:WaitForChild("VehicleModels"))
local VehicleWreckFx = require(Shared:WaitForChild("VehicleWreckFx"))
local Remotes = require(Shared:WaitForChild("Remotes"))
-- Through someone at speed with the car's momentum: this client simulates the car it drives, so the
-- bodies ahead are let through here, before the physics meets them (the server is told of each hit).
local RoadkillPass = require(Shared:WaitForChild("RoadkillPass"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- #60 ("let me zoom out more when sitting in the vehicles"): the stock camera's default zoom room
-- (0.5..20 studs) is tight for a 14.6-stud truck seen from outside. Widened on entry, restored on
-- exit. CombatClient's own zoom pin (its Heartbeat loop, `pinCameraZoom(inCombat())`) used to fight
-- this every frame during a live match regardless of InVehicle -- claude-43 is routing a one-line fix
-- there (`pinCameraZoom(not player:GetAttribute("InVehicle") and inCombat())`) so this can hold.
local VEHICLE_MAX_ZOOM = 55
local VEHICLE_MIN_ZOOM = 6
local savedMinZoom, savedMaxZoom = nil, nil

local ANIMATE_DISTANCE = 320
local FULL_RATE_DISTANCE = 120
local POSE_DISTANCE = 200
local ENGINE_DISTANCE = 150
local FLIP_AFTER = 2.0
-- Engine pitch from a standstill to top speed, and how much of the loop you hear when it idles.
local ENGINE_PITCH_AT_TOP = 2.5
local ENGINE_IDLE_VOLUME = 0.45
-- The dial says KM/H, so it shows km/h: a stud is 0.28 m, so studs/s * 0.28 * 3.6 is almost exactly
-- the speed itself. A car at 100 studs/s reads 101, and a sprinting player would read 26.
local DISPLAY_SCALE = 1.008
-- #84 jolt reporting: see the Stepped connection below for the reasoning behind the number.
local JOLT_THRESHOLD = 20
local JOLT_REPORT_EVERY = 1

local rigs = {}          -- model -&gt; rig (false while its parts are still streaming in)
local driving = nil      -- { model, rig, seat }
local handbrake = false
local frameCount = 0

--------------------------------------------------------------------------------
-- Finding vehicles
--------------------------------------------------------------------------------

local function track(model)
	if rigs[model] ~= nil or not model:GetAttribute("VehicleModel") then
		return
	end
	rigs[model] = false
	local pending = false
	local function rebuild()
		pending = false
		if model.Parent then
			rigs[model] = VehicleDynamics.Rig(model, true) or false
		end
	end
	rebuild()
	-- Streaming can deliver a vehicle a piece at a time: build again when a joint or force arrives.
	model.DescendantAdded:Connect(function(descendant)
		if not pending and (descendant:IsA("Motor6D") or descendant:IsA("VectorForce") or descendant:IsA("AlignOrientation")) then
			pending = true
			task.defer(rebuild)
		end
	end)
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			local rig = rigs[model]
			if rig and rig.engineLoop then
				rig.engineLoop:Stop()
				rig.engineLoop = nil
			end
			rigs[model] = nil
		end
	end)
end

local function watchFolder(folder)
	for _, child in ipairs(folder:GetChildren()) do
		track(child)
	end
	folder.ChildAdded:Connect(track)
end

-- The map's parked vehicles ("Vehicles") and a team match's base vehicles ("TeamBaseVehicles",
-- ModeTeams.SpawnBaseVehicles), which otherwise never had their wheels turned or their riders posed.
local VEHICLE_FOLDERS = { Vehicles = true, TeamBaseVehicles = true }
local function watchMap(map)
	for _, child in ipairs(map:GetChildren()) do
		if VEHICLE_FOLDERS[child.Name] then
			watchFolder(child)
		end
	end
	map.ChildAdded:Connect(function(child)
		if VEHICLE_FOLDERS[child.Name] then
			watchFolder(child)
		end
	end)
end

if workspace:FindFirstChild("Map") then
	watchMap(workspace.Map)
end
workspace.ChildAdded:Connect(function(child)
	if child.Name == "Map" then
		watchMap(child)
	end
end)

--------------------------------------------------------------------------------
-- HUD
--------------------------------------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "VehicleHud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Enabled = false
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(0.5, 1)
-- Above the hotbar (HudClient: 16 up from the bottom, 150 tall), not on it (Oliver 17:10: the car HUD
-- overlapped). The hint and the health warning stack above the panel instead of through it.
panel.Position = UDim2.new(0.5, 0, 1, -178)
panel.Size = UDim2.fromOffset(250, 78)
panel.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
panel.BackgroundTransparency = 0.25
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)

local nameLabel = Instance.new("TextLabel")
nameLabel.BackgroundTransparency = 1
nameLabel.Position = UDim2.fromOffset(14, 6)
nameLabel.Size = UDim2.new(1, -28, 0, 14)
nameLabel.Font = Enum.Font.GothamBold
nameLabel.TextSize = 12
nameLabel.TextXAlignment = Enum.TextXAlignment.Left
nameLabel.TextColor3 = Color3.fromRGB(170, 176, 190)
nameLabel.Text = ""
nameLabel.Parent = panel

local speedLabel = Instance.new("TextLabel")
speedLabel.BackgroundTransparency = 1
speedLabel.Position = UDim2.fromOffset(14, 18)
speedLabel.Size = UDim2.new(0.5, 0, 0, 38)
speedLabel.Font = Enum.Font.FredokaOne
speedLabel.TextScaled = true
speedLabel.TextXAlignment = Enum.TextXAlignment.Left
speedLabel.TextColor3 = Color3.fromRGB(245, 245, 250)
speedLabel.Text = "0"
speedLabel.Parent = panel

local unitLabel = Instance.new("TextLabel")
unitLabel.BackgroundTransparency = 1
unitLabel.Position = UDim2.new(0.5, -10, 0, 30)
unitLabel.Size = UDim2.new(0.5, 0, 0, 20)
unitLabel.Font = Enum.Font.GothamBold
unitLabel.TextScaled = true
unitLabel.TextXAlignment = Enum.TextXAlignment.Left
unitLabel.TextColor3 = Color3.fromRGB(170, 176, 190)
unitLabel.Text = "KM/H"
unitLabel.Parent = panel

local bar = Instance.new("Frame")
bar.Position = UDim2.fromOffset(14, 62)
bar.Size = UDim2.new(1, -28, 0, 6)
bar.BackgroundColor3 = Color3.fromRGB(56, 60, 72)
bar.BorderSizePixel = 0
bar.Parent = panel
local fill = Instance.new("Frame")
fill.Size = UDim2.fromScale(0, 1)
fill.BackgroundColor3 = Color3.fromRGB(255, 196, 64)
fill.BorderSizePixel = 0
fill.Parent = bar

local hint = Instance.new("TextLabel")
hint.BackgroundTransparency = 1
hint.AnchorPoint = Vector2.new(0.5, 1)
hint.Position = UDim2.new(0.5, 0, 1, -262)
hint.Size = UDim2.fromOffset(420, 18)
hint.Font = Enum.Font.GothamBold
hint.TextSize = 14
hint.TextColor3 = Color3.fromRGB(220, 224, 234)
hint.TextStrokeTransparency = 0.5
-- Naming a key a gamepad hasn't got is worse than saying nothing, so the hint follows the device
-- the player last used, as the world's key hints do.
local function refreshHint()
	local last = UserInputService:GetLastInputType()
	local pad = string.find(last.Name, "Gamepad", 1, true) ~= nil
	if last == Enum.UserInputType.Touch then
		hint.Text = "JUMP  get out     BRAKE  handbrake"
	elseif pad then
		hint.Text = "A  get out     L1  handbrake     R2/L2  drive"
	else
		hint.Text = "SPACE  get out     SHIFT  handbrake"
	end
end
refreshHint()
UserInputService.LastInputTypeChanged:Connect(refreshHint)
hint.Parent = gui

-- #53: low-health / wrecked warning. Reads VehicleHealth/VehicleMaxHealth/Wrecked straight off the
-- driven model -- the server's own numbers (VehicleService.lua), never a client-side copy of them.
local healthWarning = Instance.new("TextLabel")
healthWarning.BackgroundTransparency = 1
healthWarning.AnchorPoint = Vector2.new(0.5, 1)
healthWarning.Position = UDim2.new(0.5, 0, 1, -284)
healthWarning.Size = UDim2.fromOffset(260, 20)
healthWarning.Font = Enum.Font.GothamBold
healthWarning.TextSize = 15
healthWarning.TextStrokeTransparency = 0.3
healthWarning.Text = ""
healthWarning.Visible = false
healthWarning.Parent = gui

-- On a touch screen PhoneLayout owns the HUD, and has a block for the driving HUD (`Rects().vehicle`,
-- `vehicleHint`, `vehicleWarning`; the gun panel beside it is VehicleWeaponClient's). The literals above
-- are the desktop spots, above the hotbar: on an 844x390 phone they put this panel over the crosshair
-- and the hint across the top of the screen, and upright they ran the hint across the hotbar row (#80,
-- measured by tools/hud_layout_check.py). Everything goes back to the literals on a desktop screen.
-- Under pcall: if PhoneLayout fails to load, the desktop spots stand.
do
	local ok, err = pcall(function()
		local PhoneLayout = require(script.Parent:WaitForChild("PhoneLayout"))
		local pieces = {
			{ gui = panel, key = "vehicle", natural = Vector2.new(250, 78) },
			{ gui = hint, key = "vehicleHint", natural = Vector2.new(300, 18) },
			{ gui = healthWarning, key = "vehicleWarning", natural = Vector2.new(260, 20) },
		}
		for _, piece in ipairs(pieces) do
			piece.anchor, piece.position, piece.size = piece.gui.AnchorPoint, piece.gui.Position, piece.gui.Size
			piece.scale = Instance.new("UIScale")
			piece.scale.Parent = piece.gui
		end
		local function place()
			local viewport = camera.ViewportSize
			local spots = PhoneLayout.Active(viewport) and PhoneLayout.Rects(viewport) or nil
			for _, piece in ipairs(pieces) do
				local spot = spots and spots[piece.key]
				if spot then
					-- Drawn at its natural size and scaled to the slot. The hint's natural box is the 300 its
					-- touch wording needs, not its 420-wide desktop box; the text lines up on the block's
					-- left edge like the panels under it.
					piece.gui.Size = UDim2.fromOffset(piece.natural.X, piece.natural.Y)
					if piece.gui:IsA("TextLabel") then
						piece.gui.TextXAlignment = Enum.TextXAlignment.Left
					end
					PhoneLayout.Place(piece.gui, spot, piece.natural, piece.scale, 0, true)
				else
					piece.gui.AnchorPoint, piece.gui.Position, piece.gui.Size = piece.anchor, piece.position, piece.size
					if piece.gui:IsA("TextLabel") then
						piece.gui.TextXAlignment = Enum.TextXAlignment.Center
					end
					piece.scale.Scale = 1
				end
			end
		end
		place()
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(place)
		UserInputService:GetPropertyChangedSignal("KeyboardEnabled"):Connect(place)
	end)
	if not ok then
		warn("[VehicleClient] the phone layout didn't load; the driving HUD keeps its desktop spots: " .. tostring(err))
	end
end

local function updateHealthWarning(model)
	if model:GetAttribute("Wrecked") then
		healthWarning.Visible = true
		healthWarning.Text = "VEHICLE WRECKED"
		healthWarning.TextColor3 = Color3.fromRGB(170, 172, 180)
		healthWarning.TextTransparency = 0
		return
	end
	local health, maxHealth = model:GetAttribute("VehicleHealth"), model:GetAttribute("VehicleMaxHealth")
	if type(health) ~= "number" or type(maxHealth) ~= "number" or maxHealth &lt;= 0 or health / maxHealth &gt; VehicleDynamics.LOW_HEALTH_SHARE then
		healthWarning.Visible = false
		return
	end
	healthWarning.Visible = true
	healthWarning.Text = "VEHICLE DAMAGED"
	healthWarning.TextColor3 = Color3.fromRGB(255, 90, 90)
	-- A slow pulse (about 1/3 Hz) reads as "warning" without being unreadable; tick() so it isn't
	-- tied to physics dt.
	healthWarning.TextTransparency = 0.15 + 0.35 * (0.5 + 0.5 * math.sin(tick() * 2))
end

--------------------------------------------------------------------------------
-- Driving
--------------------------------------------------------------------------------

local function setHandbrake(on)
	handbrake = on
	if driving and driving.seat then
		-- For this machine's own step only: an attribute set on a client doesn't replicate, so while
		-- the server holds the physics (ServerControl) it simply drives without the handbrake.
		driving.seat:SetAttribute("Handbrake", on or nil)
	end
end

local function onHandbrake(_, state)
	if not driving then
		return Enum.ContextActionResult.Pass
	end
	setHandbrake(state == Enum.UserInputState.Begin)
	return Enum.ContextActionResult.Sink
end

local function stopDriving()
	if not driving then
		return
	end
	if driving.skidLoop then
		driving.skidLoop:Stop()
		driving.skidLoop = nil
	end
	setHandbrake(false)
	if driving.roadkill then
		driving.roadkill:Destroy()
	end
	if driving.rig and driving.rig.chassis.Parent and not driving.model:GetAttribute("ServerControl") then
		VehicleDynamics.Idle(driving.rig)
	end
	if savedMinZoom then
		player.CameraMinZoomDistance, player.CameraMaxZoomDistance = savedMinZoom, savedMaxZoom
		savedMinZoom, savedMaxZoom = nil, nil
	end
	driving = nil
	gui.Enabled = false
	ContextActionService:UnbindAction("VehicleHandbrake")
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

local function startDriving(model, seat)
	local rig = rigs[model] or VehicleDynamics.Rig(model, true)
	if not rig then
		-- The wheels may not have replicated yet. The server hands this client the chassis the moment
		-- it is sat in, so if nothing here steps it, nothing anywhere does: keep trying while the
		-- player stays in this seat rather than leaving them in a vehicle that won't move.
		task.spawn(function()
			local deadline = tick() + 5 -- wall clock, not os.clock() (CPU time): this waits on replication, a real-time thing
			while tick() &lt; deadline do
				task.wait(0.1)
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if not humanoid or humanoid.SeatPart ~= seat or not model.Parent then
					return
				end
				if VehicleDynamics.Rig(model, true) then
					startDriving(model, seat)
					return
				end
			end
			warn(string.format("VehicleClient: %s never gave up a rig; it will sit there", model.Name))
		end)
		return
	end
	rigs[model] = rig
	driving = { model = model, rig = rig, seat = seat }
	driving.roadkill = RoadkillPass.new(model, rig.chassis, function(character, speed)
		Remotes.Event("VehicleRoadkill"):FireServer(model, character, speed)
	end)
	local def = VehicleModels.Models[model:GetAttribute("VehicleModel")]
	nameLabel.Text = string.upper(def and def.displayName or "")
	gui.Enabled = true
	ContextActionService:BindActionAtPriority("VehicleHandbrake", onHandbrake, true, Enum.ContextActionPriority.High.Value,
		Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL1)
	ContextActionService:SetTitle("VehicleHandbrake", "BRAKE")
	pcall(ContextActionService.SetPosition, ContextActionService, "VehicleHandbrake", UDim2.new(1, -180, 1, -150))
	Sfx.Play("VehicleStart", 0.05)
	-- CombatClient stands its camera and mouse lock down while this is set. The server sets it too,
	-- and is the one that clears it, but waiting for that to come back down the wire leaves the
	-- player locked in first person for a moment after they sit down.
	player:SetAttribute("InVehicle", true)
	-- A VehicleSeat subject gives the default camera its vehicle mode: it swings in behind the car.
	camera.CameraSubject = seat
	savedMinZoom, savedMaxZoom = player.CameraMinZoomDistance, player.CameraMaxZoomDistance
	player.CameraMinZoomDistance = VEHICLE_MIN_ZOOM
	player.CameraMaxZoomDistance = VEHICLE_MAX_ZOOM
end

local function watchCharacter(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	local function update()
		local seat = humanoid.SeatPart
		if seat and seat:IsA("VehicleSeat") and seat.Parent and seat.Parent:GetAttribute("VehicleModel") then
			if not driving or driving.seat ~= seat then
				stopDriving()
				startDriving(seat.Parent, seat)
			end
			return
		end
		stopDriving()
	end
	humanoid:GetPropertyChangedSignal("SeatPart"):Connect(update)
	humanoid.Died:Connect(stopDriving)
	update()
end

if player.Character then
	task.spawn(watchCharacter, player.Character)
end
player.CharacterAdded:Connect(watchCharacter)

-- The step for a kind another tab registered, if it has one: `StepModule` names a ModuleScript in
-- ReplicatedStorage.Shared returning { Step = function(model, rig, input, dt) -&gt; telemetry }. Looked
-- up once per module and remembered, including the "there isn't one" answer.
local stepModules = {}

local function sharedStep(model, rig, input, dt)
	local name = model:GetAttribute("StepModule")
	if type(name) ~= "string" then
		return nil
	end
	local module = stepModules[name]
	if module == nil then
		local found = Shared:FindFirstChild(name)
		local ok, loaded = pcall(function()
			return found and require(found) or false
		end)
		module = (ok and type(loaded) == "table" and type(loaded.Step) == "function") and loaded or false
		stepModules[name] = module
		if not module then
			warn(string.format("VehicleClient: %s names a step module %q that isn't there; driving it with the standard dynamics",
				model.Name, name))
		end
	end
	if not module then
		return nil
	end
	local ok, telemetry = pcall(module.Step, model, rig, input, dt)
	if not ok or type(telemetry) ~= "table" then
		if not stepModules[name .. "!warned"] then
			stepModules[name .. "!warned"] = true
			warn(string.format("VehicleClient: the step in %s failed (%s); falling back to the standard dynamics",
				name, tostring(telemetry)))
		end
		return nil
	end
	return telemetry
end

RunService.Stepped:Connect(function(_, dt)
	if not driving then
		return
	end
	local rig = driving.rig
	local model = driving.model
	if not rig.chassis.Parent or not model.Parent then
		stopDriving()
		return
	end
	local seat = driving.seat
	if model:GetAttribute("ServerControl") then
		-- The server has taken the wheel (a honesty check fired). Nothing here is stepping the
		-- tyres any more, so the skid it was making must not hang on.
		if driving.skidLoop then
			driving.skidLoop:Stop()
			driving.skidLoop = nil
		end
		return
	end
	VehicleDynamics.SetIgnore(rig, { player.Character })
	driving.roadkill:Sweep(dt, tick())
	local input = {
		throttle = seat.ThrottleFloat,
		steer = seat.SteerFloat,
		handbrake = handbrake,
	}
	-- A kind registered by another tab brings its own step, in a module both this machine and the
	-- server run, so behaviour that must always apply (a hull held at the water surface, say) does
	-- not stop the moment a player sits down. It is called through a pcall and falls back to the
	-- dynamics if it is missing OR if it raises: a step that throws once a frame would otherwise
	-- leave the driver in a vehicle that does nothing at all.
	local telemetry = sharedStep(model, rig, input, dt)
	if not telemetry then
		telemetry = VehicleDynamics.Step(rig, input, dt)
	end
	if telemetry.flippedFor &gt; FLIP_AFTER then
		VehicleDynamics.Right(rig)
	end

	-- Tyres at the limit hiss; landing after air time thumps.
	if telemetry.slip and telemetry.grounded &gt; 0 then
		if not driving.skidLoop then
			local attachment = rig.chassis:FindFirstChild("EngineSound")
			driving.skidLoop = attachment and Sfx.Loop("VehicleSkid", attachment) or nil
		end
	elseif driving.skidLoop then
		driving.skidLoop:Stop()
		driving.skidLoop = nil
	end
	if telemetry.grounded == 0 then
		driving.airborneFor = (driving.airborneFor or 0) + dt
	else
		if (driving.airborneFor or 0) &gt; 0.35 then
			Sfx.PlayAt("VehicleLand", rig.chassis.Position, 0.08)
		end
		driving.airborneFor = 0
	end

	local speed = math.abs(telemetry.forwardSpeed)
	speedLabel.Text = tostring(math.floor(speed * DISPLAY_SCALE + 0.5))
	fill.Size = UDim2.fromScale(math.clamp(speed / rig.handling.topSpeed, 0, 1), 1)
	updateHealthWarning(model)

	-- #84: measured on the runtest harness (no client, no network ownership) flat road is 0.00
	-- vertical velocity and even the worst seam-at-speed case peaked at 3.14 studs/s -- so a jump
	-- past JOLT_THRESHOLD in one step, on a REAL driving client, is either something the harness
	-- could already see (a bug worth fixing anyway) or the one thing it structurally cannot: a
	-- network ownership handoff. Reported so Oliver's next session produces a number, not an
	-- impression, per claude-43's ask -- the same shape as this project's other after-the-fact
	-- counters. ServerControl is sent along because a handoff is exactly what that attribute marks.
	local vy = rig.chassis.AssemblyLinearVelocity.Y
	if driving.lastVerticalVel then
		local jump = math.abs(vy - driving.lastVerticalVel)
		if jump &gt; JOLT_THRESHOLD and (not driving.lastJoltReport or tick() - driving.lastJoltReport &gt; JOLT_REPORT_EVERY) then
			driving.lastJoltReport = tick()
			Remotes.Event("VehicleJolt"):FireServer(jump, speed, model:GetAttribute("ServerControl") == true)
		end
	end
	driving.lastVerticalVel = vy
end)

--------------------------------------------------------------------------------
-- Sound
--------------------------------------------------------------------------------

-- One engine loop per vehicle you can hear, on an attachment at its chassis, pitched by road
-- speed. Sfx.Loop keeps only the nearest few audible, and stops any loop whose vehicle goes away.
local function updateEngine(model, rig, distance)
	local seat = model:FindFirstChild("DriverSeat")
	local speed = math.abs(rig.chassis.AssemblyLinearVelocity.Magnitude)
	local wanted = distance &lt; ENGINE_DISTANCE and ((seat and seat.Occupant) or speed &gt; 2)
	if not wanted then
		if rig.engineLoop then
			rig.engineLoop:Stop()
			rig.engineLoop = nil
		end
		return
	end
	if not rig.engineLoop then
		local attachment = rig.chassis:FindFirstChild("EngineSound")
		if not attachment then
			attachment = Instance.new("Attachment")
			attachment.Name = "EngineSound"
			attachment.Parent = rig.chassis
		end
		rig.engineLoop = Sfx.Loop("VehicleEngine", attachment)
		if not rig.engineLoop then
			return
		end
	end
	local share = math.clamp(speed / rig.handling.topSpeed, 0, 1)
	rig.engineLoop:SetPitch(1 + share * (ENGINE_PITCH_AT_TOP - 1))
	rig.engineLoop:SetVolume(ENGINE_IDLE_VOLUME + (1 - ENGINE_IDLE_VOLUME) * share)
end

-- Lamps. The parts are Neon and lit by their colour whatever happens; what changes is how bright.
-- A parked vehicle's lamps are dim, a driven one's head lamps come up, and the brake lamps come on
-- when the driver brakes — which every machine can see, because a VehicleSeat's throttle and a
-- model's attributes replicate to everyone. The brightness share itself (and what a wrecked vehicle
-- does to smoke) lives in VehicleWreckFx.lua, a ModuleScript, so it can be required and proven from
-- a gallery the way GunFx/ExplosiveFx already are -- this LocalScript can't be.
-- STRONG keys (bug-hunt B3-2, 2026-09-21): a weak `lamps` table let a collected-and-rebuilt entry
-- re-read `base` from `part.Color` in lampsOf below -- but updateLamps is the only writer of that
-- same property, so a rebuild re-primed `base` from an ALREADY-DIMMED colour. Every drop multiplied
-- the darkening again with no floor (0.34 -&gt; 0.1156 -&gt; 0.039 -&gt; ...), permanently, on any car,
-- wreck or no wreck -- the "harmless cache" verdict this table used to carry was wrong. Dropped
-- explicitly in lampsOf, the same AncestryChanged shape `track()` above already uses for `rigs`.
local lamps = {}

local function lampsOf(model)
	local found = lamps[model]
	if found then
		return found
	end
	found = {}
	-- GetDescendants, not GetChildren (bug-hunt B3-3b): a lamp part nested under a sub-model would
	-- have read as zero found under GetChildren, silently never lighting or dimming.
	for _, part in ipairs(model:GetDescendants()) do
		local role = part:IsA("BasePart") and part:GetAttribute("Lamp")
		if role then
			table.insert(found, { part = part, role = role, base = VehicleWreckFx.LampBaseColor(part) })
		end
	end
	lamps[model] = found
	-- One connection per build, gone with the entry: a vehicle streaming out and back in rebuilds it.
	local watch
	watch = model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			lamps[model] = nil
			watch:Disconnect()
		end
	end)
	return found
end

local function updateLamps(model, distance)
	local found = lampsOf(model)
	local seat = model:FindFirstChild("DriverSeat")
	local driven = seat ~= nil and seat.Occupant ~= nil
	local braking = false
	if driven and seat:IsA("VehicleSeat") then
		local forward = seat.CFrame.LookVector:Dot(seat.AssemblyLinearVelocity)
		braking = seat:GetAttribute("Handbrake") == true or (seat.ThrottleFloat &lt; -0.05 and forward &gt; 1)
			or (seat.ThrottleFloat &gt; 0.05 and forward &lt; -1)
	end
	local wrecked = model:GetAttribute("Wrecked") == true
	-- One number describes the whole state, so nothing is written while nothing changes. This is
	-- the ONLY place anything writes lamp Color -- "wrecked" is folded in as a third bit rather
	-- than a second writer, the failure mode the prompt-reenable bug (#53/#57) already caught once.
	if #found &gt; 0 then
		local state = (driven and 1 or 0) + (braking and 2 or 0) + (wrecked and 4 or 0)
		if lamps[model].state ~= state and distance &lt;= ANIMATE_DISTANCE then
			lamps[model].state = state
			for _, entry in ipairs(found) do
				local share = VehicleWreckFx.LampShare(entry.role, wrecked, driven, braking)
				entry.part.Color = Color3.new(entry.base.R * share, entry.base.G * share, entry.base.B * share)
			end
		end
	end
	-- Bug-hunt B3-3b: this used to sit inside the `#found == 0` early return above, so a vehicle
	-- with no lamp parts at all never smoked when wrecked -- two unrelated features shared one
	-- early return that only ever belonged to lamps.
	VehicleWreckFx.SetSmoke(model, wrecked)
end

--------------------------------------------------------------------------------
-- Moving parts and riders
--------------------------------------------------------------------------------

-- Each character's Motor6Ds by name, found once.
local jointsOf = setmetatable({}, { __mode = "k" })

local function jointsFor(character)
	local joints = jointsOf[character]
	if not joints then
		joints = {}
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("Motor6D") then
				joints[descendant.Name] = descendant
			end
		end
		jointsOf[character] = joints
	end
	return joints
end

-- Riders' joints, set after the character's own animation has run this frame (Stepped comes after
-- animation), so the pose holds until the next frame's animation step.
local function poseRiders(model, focusDistance)
	if focusDistance &gt; POSE_DISTANCE then
		return
	end
	local def = VehicleModels.Models[model:GetAttribute("VehicleModel")]
	if not def then
		return
	end
	for _, seat in ipairs(model:GetChildren()) do
		local occupant = (seat:IsA("Seat") or seat:IsA("VehicleSeat")) and seat.Occupant or nil
		local character = occupant and occupant.Parent
		if character then
			local poseName
			local turret = nil
			if seat:IsA("VehicleSeat") then
				poseName = model:GetAttribute("RiderPose") or (def.kind == "bike" and "BikeRider" or "CarDriver")
			elseif def.kind == "bike" then
				poseName = "BikePillion"
			elseif seat.Name == "GunnerSeat" then
				-- At the gun: standing (or kneeling at the mortar), and turned with it (below).
				turret = model:FindFirstChild("TurretYaw")
				poseName = turret and turret:GetAttribute("Stance") == "kneel" and "GunnerKneel" or "GunnerStand"
			end
			local pose = poseName and VehicleModels.Poses[poseName]
			if pose then
				local joints = jointsFor(character)
				for jointName, transform in pairs(pose) do
					local joint = joints[jointName]
					if joint and joint.Parent then
						joint.Transform = transform
					end
				end
				-- The gunner walks round with the gun: the whole body turned about the turret's own yaw axis
				-- by what its yaw joint is turned now (VehicleWeaponClient sets it). The seat is fixed to the
				-- chassis, so this goes on the root joint: T = J^-1 * R * J, where J is the root joint's frame
				-- and R the turret's turn about its axis, Y0 * yaw * Y0^-1 (Y0 its yaw pivot at rest).
				local yawJoint = turret and turret:FindFirstChild("Joint")
				local root = joints.Root or joints.RootJoint
				if yawJoint and yawJoint.Part0 and root and root.Part0 and root.Parent then
					local restYaw = yawJoint.Part0.CFrame * yawJoint.C0
					local turn = restYaw * yawJoint.Transform * restYaw:Inverse()
					local frame = root.Part0.CFrame * root.C0
					root.Transform = frame:Inverse() * turn * frame
				end
			end
		end
	end
end

RunService.Stepped:Connect(function(_, dt)
	frameCount += 1
	local focus = camera.CFrame.Position
	for model, rig in pairs(rigs) do
		if rig and rig.chassis.Parent then
			local distance = (rig.chassis.Position - focus).Magnitude
			if distance &lt; ANIMATE_DISTANCE then
				-- Far vehicles animate every third frame; nobody can tell at that range.
				if distance &lt; FULL_RATE_DISTANCE or frameCount % 3 == 0 then
					local stepDt = distance &lt; FULL_RATE_DISTANCE and dt or dt * 3
					if driving and driving.model == model then
						VehicleDynamics.AnimateWheels(rig, stepDt)
					else
						local seat = model:FindFirstChild("DriverSeat")
						local steer = seat and seat:IsA("VehicleSeat") and seat.SteerFloat * rig.handling.steerLow * 0.6 or 0
						VehicleDynamics.AnimateWheels(rig, stepDt, steer)
					end
				end
				poseRiders(model, distance)
				updateEngine(model, rig, distance)
				updateLamps(model, distance)
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- Taking a bot's seat over (VehicleService's TAKING OVER)
--------------------------------------------------------------------------------
-- The server keeps a bot's driving and gun seats' prompts up ("Take over") for anyone who may have
-- the seat; this hides them from anyone who may not, by the same rules the server holds the request
-- to (BotService.TakeoverAllowed): with teams, a teammate of the bot always may and nobody else; with
-- no teams, anyone the bot is not fighting (its character's BotFoes, ",userId,userId,"). The server
-- decides either way; this only keeps a prompt that would be refused off the screen.
--
-- Hidden by shrinking its reach to nothing, locally: the server never changes a vehicle prompt's
-- MaxActivationDistance after making it, so nothing it replicates undoes this, and Enabled (which the
-- server does set) is left alone. A prompt hidden here is looked at again every TAKEOVER_RECHECK
-- seconds and given its reach back once the rules allow it (the bot got out, the fight is over).

local ProximityPromptService = game:GetService("ProximityPromptService")

local TAKEOVER_RECHECK = 0.3

-- Whether this player may take `seat` (a DriverSeat or GunnerSeat) from whoever holds it. A free seat
-- is the ordinary prompt, and a player's seat never shows one.
local function mayTakeOver(seat, character, userId)
	local occupant = seat.Occupant
	local holder = occupant and occupant.Parent
	if not holder then
		return true
	end
	if Players:GetPlayerFromCharacter(holder) then
		return false
	end
	local mine = character and character:GetAttribute("Team")
	local theirs = holder:GetAttribute("Team")
	if mine ~= nil or theirs ~= nil then
		return mine ~= nil and mine == theirs
	end
	local foes = holder:GetAttribute("BotFoes")
	return not (type(foes) == "string" and string.find(foes, "," .. tostring(userId) .. ",", 1, true) ~= nil)
end

-- The seat a vehicle prompt is for, or nil for any other prompt.
local function takeoverSeat(prompt)
	local seatName = (prompt.Name == "DrivePrompt" and "DriverSeat") or (prompt.Name == "GunnerPrompt" and "GunnerSeat") or nil
	local attachment = seatName and prompt.Parent
	local chassis = attachment and attachment.Parent
	local model = chassis and chassis.Parent
	return model and model:FindFirstChild(seatName) or nil
end

local hiddenReach = {} -- prompt -&gt; the reach it had; STRONG keys, dropped when checked and gone

local function judgePrompt(prompt)
	local seat = takeoverSeat(prompt)
	if not seat then
		return
	end
	local allowed = mayTakeOver(seat, player.Character, player.UserId)
	if allowed and hiddenReach[prompt] then
		prompt.MaxActivationDistance = hiddenReach[prompt]
		hiddenReach[prompt] = nil
	elseif not allowed and not hiddenReach[prompt] then
		hiddenReach[prompt] = prompt.MaxActivationDistance
		prompt.MaxActivationDistance = 0
	end
end

-- Prompts on screen now: a seat can change hands while its prompt is up (a bot gets in beside you).
local shownNow = {} -- prompt -&gt; true; STRONG keys, dropped on PromptHidden

ProximityPromptService.PromptShown:Connect(function(prompt)
	shownNow[prompt] = true
	judgePrompt(prompt)
end)
ProximityPromptService.PromptHidden:Connect(function(prompt)
	shownNow[prompt] = nil
end)
task.spawn(function()
	while true do
		task.wait(TAKEOVER_RECHECK)
		for _, list in ipairs({ hiddenReach, shownNow }) do
			for prompt in pairs(list) do
				if prompt.Parent then
					judgePrompt(prompt)
				else
					hiddenReach[prompt] = nil
					shownNow[prompt] = nil
				end
			end
		end
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX192"><Properties><string name="Name">VehicleWeaponClient</string><ProtectedString name="Source">-- Mounted vehicle weapons on the client: the trigger and aim of whichever mount this player works,
-- the ammo and heat readout, the gunner's first-person view, and every armed vehicle's mounts
-- swinging to where their users are aiming.
--
-- The server decides everything that matters (VehicleWeapons): this only says where the mount is
-- aiming and when the trigger is pulled. The shot itself comes back through ShotFired (tracer,
-- report) and ProjectileService's round events like any gun's.
--
-- WHO WORKS WHAT (VehicleWeapons, the same rule): the gunner's seat works the TURRET, the driving seat
-- works the DRIVER'S GUN (a short-arc gun at the front). A driver alone cannot work the turret.
--
-- The DRIVER aims with the mouse while driving (the gun follows the cursor, inside its 20-degree arc,
-- Oliver: "the aim to follow your mouse") or the camera's middle on a pad or a touch screen, and fires
-- with the left mouse, R1 (the triggers are the throttle and brake) or the FIRE button.
-- The GUNNER sees down the gun (GunnerView: the camera at their eye riding the turret, their own arms
-- on its handles, a sight that shows where the shot lands): the mouse, the right stick or a drag turns
-- the turret; the left mouse, R2 or R1, or FIRE fires; the right mouse, L2 or the AIM button aims down
-- the sight. On a model with no first-person markers the gunner gets the driver's kind of aim instead.
-- CombatClient refuses the hand gun from the driving seat, and this sinks a gunner's fire and aim
-- buttons before CombatClient sees them, so a hand gun never fires or aims alongside a mount.
--
-- The mounts swing on their two Motor6Ds' Transform (VehicleModels, Mounted weapons): from the
-- server's aim attributes for everyone else's, from this player's own aim for theirs, so it answers
-- the mouse the moment it moves.

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local VehicleWeaponData = require(Shared:WaitForChild("VehicleWeaponData"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local fireRemote = Remotes.Event("VehicleWeaponFire")
local aimRemote = Remotes.Event("VehicleWeaponAim")

local AIM_SEND_EVERY = 0.1
local AIM_RANGE = 1000
-- Degrees a second a mount swings at most when following someone else's aim, so a 10 Hz
-- attribute reads as a turret turning rather than one jumping.
local SWING_RATE = 240
local TAG = "ArmedVehicle"

-- The first-person view (a ModuleScript beside this one). Under pcall: without it, a gunner keeps the
-- plain aim below.
local GunnerView = nil
do
	local ok, module = pcall(function()
		return require(script.Parent:WaitForChild("GunnerView", 5))
	end)
	GunnerView = ok and type(module) == "table" and module or nil
end

--------------------------------------------------------------------------------
-- Aiming at the mouse (Oliver: "the aim to follow your mouse")
--------------------------------------------------------------------------------

-- With a mouse, the gun aims along the ray through the cursor, not the middle of the screen: the
-- mount follows the mouse, the aim mark is drawn at the cursor (the OS arrow is hidden while it is)
-- and the shot goes through that point. Outside the mount's arc the mark stops at the arc's edge and
-- greys, and the shot goes along that edge (the server clamps to the same arc). A pad and a touch
-- screen keep the middle, and so does a mouse locked to the middle (first person, shift-lock), where
-- the cursor IS the middle. tools/vehicle_aim_check.py runs the block marked PURE on its own.

-- PURE BEGIN (plain Lua, no Roblox types)
local MOUSE_INPUTS = {
	MouseMovement = true, MouseButton1 = true, MouseButton2 = true, MouseButton3 = true, MouseWheel = true,
	Keyboard = true,
}

-- "mouse" when the player is on a mouse and it is free to move, else "centre".
local function aimMode(lastInputName, mouseLocked)
	if MOUSE_INPUTS[lastInputName] and not mouseLocked then
		return "mouse"
	end
	return "centre"
end

-- The screen point (viewport pixels, the frame GetMouseLocation and ViewportPointToRay share) the gun
-- aims through: the cursor, held on the screen, or the middle.
local function aimScreenPoint(mode, mouseX, mouseY, width, height)
	if mode == "mouse" then
		return math.clamp(mouseX, 0, width), math.clamp(mouseY, 0, height)
	end
	return width / 2, height / 2
end

-- The mount-space direction (front -Z, up +Y) for a yaw and pitch: the inverse of
-- VehicleWeaponData.ClampAim's two angles.
local function directionFromAngles(yaw, pitch)
	return -math.sin(yaw) * math.cos(pitch), math.sin(pitch), -math.cos(yaw) * math.cos(pitch)
end

-- Whether the aim was held back by the arc: the clamped angles differ from the wanted ones.
local function pinnedToArc(wantYaw, wantPitch, yaw, pitch)
	return math.abs(wantYaw - yaw) &gt; 1e-4 or math.abs(wantPitch - pitch) &gt; 1e-4
end
-- PURE END

local function aimScreen()
	local viewport = camera.ViewportSize
	local locked = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
	local mode = aimMode(UserInputService:GetLastInputType().Name, locked)
	local mouse = UserInputService:GetMouseLocation()
	local x, y = aimScreenPoint(mode, mouse.X, mouse.Y, viewport.X, viewport.Y)
	return x, y, mode
end

--------------------------------------------------------------------------------
-- HUD
--------------------------------------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "VehicleWeaponHud"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Enabled = false
gui.Parent = player:WaitForChild("PlayerGui")

-- Right of the vehicle panel (VehicleClient: 250 wide, centred, 178 up), same height and style.
local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(0, 1)
panel.Position = UDim2.new(0.5, 133, 1, -178)
panel.Size = UDim2.fromOffset(150, 78)
panel.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
panel.BackgroundTransparency = 0.25
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
local panelScale = Instance.new("UIScale")
panelScale.Parent = panel

local nameLabel = Instance.new("TextLabel")
nameLabel.BackgroundTransparency = 1
nameLabel.Position = UDim2.fromOffset(12, 6)
nameLabel.Size = UDim2.new(1, -24, 0, 14)
nameLabel.Font = Enum.Font.GothamBold
nameLabel.TextSize = 12
nameLabel.TextXAlignment = Enum.TextXAlignment.Left
nameLabel.TextColor3 = Color3.fromRGB(170, 176, 190)
nameLabel.Parent = panel

local ammoLabel = Instance.new("TextLabel")
ammoLabel.BackgroundTransparency = 1
ammoLabel.Position = UDim2.fromOffset(12, 20)
ammoLabel.Size = UDim2.new(1, -24, 0, 32)
ammoLabel.Font = Enum.Font.FredokaOne
ammoLabel.TextSize = 28
ammoLabel.TextXAlignment = Enum.TextXAlignment.Left
ammoLabel.TextColor3 = Color3.fromRGB(245, 245, 250)
ammoLabel.Parent = panel

local barBack = Instance.new("Frame")
barBack.Position = UDim2.new(0, 12, 1, -16)
barBack.Size = UDim2.new(1, -24, 0, 6)
barBack.BackgroundColor3 = Color3.fromRGB(50, 54, 64)
barBack.BorderSizePixel = 0
barBack.Parent = panel
Instance.new("UICorner", barBack).CornerRadius = UDim.new(1, 0)

local barFill = Instance.new("Frame")
barFill.Size = UDim2.fromScale(1, 1)
barFill.BackgroundColor3 = Color3.fromRGB(255, 196, 64)
barFill.BorderSizePixel = 0
barFill.Parent = barBack
Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

-- The gun's one aim mark (HudClient's crosshair stands down while VehicleGunActive): at the cursor with
-- a mouse, in the middle otherwise, grey and held at the arc's edge when the aim is outside it. (In the
-- gunner's first-person view GunnerView draws its own sight and this one is hidden.)
local reticle = Instance.new("Frame")
reticle.AnchorPoint = Vector2.new(0.5, 0.5)
reticle.Position = UDim2.fromScale(0.5, 0.5)
reticle.Size = UDim2.fromOffset(8, 8)
reticle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
reticle.BackgroundTransparency = 0.15
reticle.BorderSizePixel = 0
reticle.Parent = gui
Instance.new("UICorner", reticle).CornerRadius = UDim.new(1, 0)
local reticleRing = Instance.new("UIStroke")
reticleRing.Color = Color3.fromRGB(20, 20, 24)
reticleRing.Thickness = 1.5
reticleRing.Parent = reticle

--------------------------------------------------------------------------------
-- Which mount is mine
--------------------------------------------------------------------------------

-- The gunner's seat of an armed vehicle, if it has one: a Seat named "GunnerSeat", or any seat with a
-- true "Gunner" attribute.
local function gunnerSeatOf(vehicle)
	for _, child in ipairs(vehicle:GetChildren()) do
		if child:IsA("Seat") and (child.Name == "GunnerSeat" or child:GetAttribute("Gunner") == true) then
			return child
		end
	end
	return nil
end

-- The armed vehicle whose mount this player works, its spec and which mount, or nil: the gunner's seat
-- works the turret and the driving seat the driver's gun -- the server's VehicleWeapons.DrivenBy, the
-- same rule. The name is kept from when only the driver could fire.
local function drivenVehicle()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if not seat then
		return nil
	end
	local vehicle = seat.Parent
	local mount
	if seat == gunnerSeatOf(vehicle) then
		mount = "turret"
	elseif seat:IsA("VehicleSeat") then
		mount = "driver"
	else
		return nil
	end
	local spec = vehicle and VehicleWeaponData.ForModel(vehicle:GetAttribute("VehicleModel"), mount)
	if not spec or not vehicle:FindFirstChild(VehicleWeaponData.Parts[mount].yaw) then
		return nil
	end
	return vehicle, spec, mount
end

-- What's under the aim point on the screen, past the vehicle and everyone in it.
local function aimPoint(vehicle, screenX, screenY)
	local ray = camera:ViewportPointToRay(screenX, screenY)
	local filter = { vehicle }
	if player.Character then
		table.insert(filter, player.Character)
	end
	for _, name in ipairs({ "Loot", "Effects" }) do
		local instance = workspace:FindFirstChild(name)
		if instance then
			table.insert(filter, instance)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = filter
	-- As the server's bullet: water doesn't stop it (CombatService.buildRaycastParams).
	params.IgnoreWater = true
	local result = workspace:Raycast(ray.Origin, ray.Direction * AIM_RANGE, params)
	return result and result.Position or ray.Origin + ray.Direction * AIM_RANGE
end

local firing = false
local lastShotAt = 0
local lastAimAt = 0
local view = nil -- the gunner's GunnerView while it runs

local function onFire(_, inputState, inputObject)
	if not drivenVehicle() then
		firing = false
		return Enum.ContextActionResult.Pass
	end
	if inputState == Enum.UserInputState.Begin then
		firing = true
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		firing = false
	end
	-- The mouse button also belongs to the camera and CombatClient (which passes it on while you
	-- drive); R1 would otherwise cycle the hotbar under you. A gunner is a passenger to CombatClient,
	-- which would fire the gun in their hands as well, so a gunner's click (and R2) stops here.
	if inputObject and inputObject.KeyCode == Enum.KeyCode.ButtonR1 then
		return Enum.ContextActionResult.Sink
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.SeatPart and not humanoid.SeatPart:IsA("VehicleSeat") then
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

-- A gunner's aim-down-the-sight button: held (the right mouse, L2) or toggled (the touch AIM button).
local function onAimSight(_, inputState, inputObject)
	if not view then
		return Enum.ContextActionResult.Pass
	end
	local touch = inputObject and inputObject.UserInputType == Enum.UserInputType.Touch
	if touch then
		if inputState == Enum.UserInputState.Begin then
			view:SetAiming(not view.aiming)
		end
	elseif inputState == Enum.UserInputState.Begin then
		view:SetAiming(true)
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		view:SetAiming(false)
	end
	return Enum.ContextActionResult.Sink
end

local bound = nil -- the mount the fire action is bound for
local function setBound(want)
	if want == bound then
		return
	end
	bound = want
	-- Said on the player, locally, for the rest of the HUD: HudClient stands its own crosshair down
	-- (one crosshair while a vehicle gun is yours, this one) and hides the stamina bar, and BoonHud
	-- steps out of the phone's driving block, for a gunner as for a driver.
	player:SetAttribute("VehicleGunActive", want ~= nil or nil)
	ContextActionService:UnbindAction("BRR_VehicleFire")
	ContextActionService:UnbindAction("BRR_GunnerAim")
	firing = false
	if want == "driver" then
		ContextActionService:BindAction("BRR_VehicleFire", onFire, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR1)
	elseif want == "turret" then
		-- The gunner isn't driving, so the triggers are free: R2 fires as a hand gun does, and L2 aims.
		ContextActionService:BindAction("BRR_VehicleFire", onFire, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonR1)
		ContextActionService:BindAction("BRR_GunnerAim", onAimSight, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
		ContextActionService:SetTitle("BRR_GunnerAim", "AIM")
		ContextActionService:SetPosition("BRR_GunnerAim", UDim2.new(1, -250, 1, -180))
	end
	if want then
		ContextActionService:SetTitle("BRR_VehicleFire", "FIRE")
		ContextActionService:SetPosition("BRR_VehicleFire", UDim2.new(1, -140, 1, -180))
	end
end

--------------------------------------------------------------------------------
-- Mounts
--------------------------------------------------------------------------------

-- Current swing per vehicle and mount, in degrees. STRONG keys, dropped when the vehicle leaves.
local swings = {}

local function jointOf(vehicle, name)
	local pivot = vehicle:FindFirstChild(name)
	local joint = pivot and pivot:FindFirstChild("Joint")
	return joint and joint:IsA("Motor6D") and joint or nil
end

local function approach(from, to, step)
	if math.abs(to - from) &lt;= step then
		return to
	end
	return from + math.sign(to - from) * step
end

local function swingMount(vehicle, mount, spec, yawTarget, pitchTarget, dt)
	local names = VehicleWeaponData.Parts[mount]
	local yawJoint, pitchJoint = jointOf(vehicle, names.yaw), jointOf(vehicle, names.pitch)
	if not yawJoint or not pitchJoint then
		return
	end
	local perVehicle = swings[vehicle]
	if not perVehicle then
		perVehicle = {}
		swings[vehicle] = perVehicle
	end
	local swing = perVehicle[mount]
	if not swing then
		swing = { yaw = 0, pitch = spec.restPitch or 0 }
		perVehicle[mount] = swing
	end
	local step = SWING_RATE * dt
	swing.yaw = approach(swing.yaw, yawTarget, step)
	swing.pitch = approach(swing.pitch, pitchTarget, step)
	yawJoint.Transform = CFrame.Angles(0, math.rad(swing.yaw), 0)
	pitchJoint.Transform = CFrame.Angles(math.rad(swing.pitch), 0, 0)
end

CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(vehicle)
	swings[vehicle] = nil
end)

--------------------------------------------------------------------------------
-- Loop
--------------------------------------------------------------------------------

-- On a touch screen, PhoneLayout's slot for it (`Rects().vehicleGun`, in the driving block beside or
-- under VehicleClient's speed panel). Worked out when the screen changes, not every frame; nil on a
-- desktop screen or if PhoneLayout is missing.
local phoneGunSpot = nil
do
	local ok, PhoneLayout = pcall(require, script.Parent:WaitForChild("PhoneLayout", 5))
	local function refit()
		local viewport = camera.ViewportSize
		phoneGunSpot = ok and type(PhoneLayout) == "table" and PhoneLayout.Active(viewport) and PhoneLayout.Rects(viewport).vehicleGun or nil
	end
	refit()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(refit)
	game:GetService("UserInputService"):GetPropertyChangedSignal("KeyboardEnabled"):Connect(refit)
end

-- Otherwise the desktop spot, right of VehicleClient's speed panel (250 wide, centred, 178 up) with its
-- bottom level: the driving block's own numbers, not a measurement of the panel. Measuring it read the
-- panel's box on the frame driving began, before VehicleClient had enabled or placed its HUD, and a
-- gunner has no speed panel at all (#80, Oliver: "the guns on the cars HUD is overlapping").
local function followVehiclePanel()
	local k, anchor, position
	if phoneGunSpot then
		k, anchor, position = phoneGunSpot.w / 150, Vector2.new(0, 0), UDim2.fromOffset(phoneGunSpot.x, phoneGunSpot.y)
	else
		k, anchor, position = 1, Vector2.new(0, 1), UDim2.new(0.5, 133, 1, -178)
	end
	if panelScale.Scale ~= k then
		panelScale.Scale = k
	end
	if panel.AnchorPoint ~= anchor or panel.Position ~= position then
		panel.AnchorPoint = anchor
		panel.Position = position
	end
end

local reticleAt = nil
local function placeReticle(x, y, pinned)
	local key = string.format("%.1f %.1f %s", x, y, tostring(pinned))
	if key == reticleAt then
		return
	end
	reticleAt = key
	reticle.Position = UDim2.fromOffset(x, y)
	reticle.BackgroundColor3 = pinned and Color3.fromRGB(150, 154, 164) or Color3.fromRGB(255, 255, 255)
	reticle.BackgroundTransparency = pinned and 0.4 or 0.15
end

-- The OS arrow is hidden while the aim mark is the cursor, and given back when it is not (a menu, a
-- pad, leaving the seat). MenuCursor is the one script that writes MouseIconEnabled (#112), so this
-- only says so, through the player's `AimCursor` attribute (local: a client's attribute on its own
-- Player never leaves this machine), and MenuCursor hides the arrow while it is set. Writing the
-- property here fought MenuCursor: its reconcile on every MouseBehavior change (a right-drag of the
-- camera) put the arrow back beside the mark, and this script's "give it back" on leaving the seat
-- set it visible in first-person combat -- #112's "can still see my cursor in FPS" again.
local hidCursor = false
local function setCursorHidden(hide)
	if hide == hidCursor then
		return
	end
	hidCursor = hide
	player:SetAttribute("AimCursor", hide or nil)
end

-- The gunner's view: started on the turret this player sits at, stopped on anything else.
local viewVehicle = nil
local function setView(vehicle, spec)
	if view and viewVehicle == vehicle then
		return
	end
	if view then
		view:Stop()
		view = nil
		viewVehicle = nil
	end
	if vehicle and GunnerView then
		local ok, started = pcall(GunnerView.Start, vehicle, spec)
		if ok and started then
			view, viewVehicle = started, vehicle
		elseif not ok then
			warn("[VehicleWeaponClient] the gunner's view didn't start: " .. tostring(started))
		end
	end
end

-- The mount's readout: rounds left and the bar, or for a gun that overheats, its heat.
local function showAmmo(spec, ammo, hot)
	local whole = math.floor(ammo)
	nameLabel.Text = spec.hud
	if spec.overheat then
		local heat = math.clamp(1 - ammo / spec.magazine, 0, 1)
		ammoLabel.Text = hot and "OVERHEAT" or string.format("%d / %d", whole, spec.magazine)
		ammoLabel.TextColor3 = hot and Color3.fromRGB(255, 110, 70) or Color3.fromRGB(245, 245, 250)
		barFill.Size = UDim2.fromScale(heat, 1)
		barFill.BackgroundColor3 = Color3.fromRGB(255, math.floor(196 - 130 * heat), math.floor(64 - 40 * heat))
	else
		ammoLabel.Text = string.format("%d / %d", whole, spec.magazine)
		ammoLabel.TextColor3 = whole &lt; 1 and Color3.fromRGB(255, 96, 96) or Color3.fromRGB(245, 245, 250)
		barFill.Size = UDim2.fromScale(math.clamp(ammo / spec.magazine, 0, 1), 1)
		barFill.BackgroundColor3 = Color3.fromRGB(255, 196, 64)
	end
end

RunService.RenderStepped:Connect(function(dt)
	local mine, spec, mount = drivenVehicle()
	setBound(mine and mount or nil)
	gui.Enabled = mine ~= nil
	setView(mine and mount == "turret" and mine or nil, spec)
	if mine then
		followVehiclePanel()
	else
		setCursorHidden(false)
	end

	local now = workspace:GetServerTimeNow()
	if mine then
		local attributes = VehicleWeaponData.Attributes[mount]
		local ammo = VehicleWeaponData.AmmoAt(spec, mine:GetAttribute(attributes.ammo) or spec.magazine,
			mine:GetAttribute(attributes.firedAt), now)
		local hot = mine:GetAttribute(attributes.hot) == true and spec.overheat ~= nil and ammo &lt; spec.magazine * spec.overheat
		local ready = ammo &gt;= 1 and not hot
		local target
		if view then
			-- The gunner's first person: the view turns the turret itself and shows the sight.
			reticle.Visible = false
			setCursorHidden(false)
			view:Update(dt, { ready = ready })
			target = view:AimPoint()
		else
			reticle.Visible = true
			local screenX, screenY, mode = aimScreen()
			setCursorHidden(mode == "mouse" and player:GetAttribute("MenuOpen") ~= true)
			target = aimPoint(mine, screenX, screenY)
			placeReticle(screenX, screenY, false)
			-- The mount follows the aim straight away, by the server's own limits (VehicleWeaponData.Solve).
			local names = VehicleWeaponData.Parts[mount]
			local yawPart, pitchPart, muzzle = mine:FindFirstChild(names.yaw), mine:FindFirstChild(names.pitch), mine:FindFirstChild(names.muzzle)
			if yawPart and pitchPart then
				local joint = yawPart:FindFirstChild("Joint")
				-- The unswung mount frame: the yaw pivot's rest frame from its joint's parent.
				local rest = joint and joint.Part0 and joint.Part0.CFrame * joint.C0 or yawPart.CFrame
				-- The pitch pivot's rest place in the yaw frame (its joint's C0: it may stand out in front on a
				-- pintle) and the muzzle's in the pitch pivot's own frame -- read off the joints, not the parts,
				-- which are already swung.
				local pitchJoint = pitchPart:FindFirstChild("Joint")
				local pivot = pitchJoint and pitchJoint.C0.Position or rest:PointToObjectSpace(pitchPart.Position)
				local mouth = muzzle and pitchPart.CFrame:VectorToObjectSpace(muzzle.Position - pitchPart.Position) or Vector3.new(0, 0, -1)
				local toTarget = rest:PointToObjectSpace(target)
				local yaw, pitch, _origin, _direction = VehicleWeaponData.Solve(spec, rest, pivot, mouth, target)
				if yaw then
					swingMount(mine, mount, spec, math.deg(yaw), math.deg(pitch), dt * 3)
					-- Pinned when the wanted bearing and elevation (from the yaw axis and the pitch pivot) fall
					-- outside the arc: the arc's own clamp of them differs from them.
					local wantYaw = math.atan2(-toTarget.X, -toTarget.Z)
					local fromPivot = toTarget - pivot
					local wantPitch = math.atan2(fromPivot.Y, math.sqrt(fromPivot.X * fromPivot.X + fromPivot.Z * fromPivot.Z))
					local heldYaw = math.clamp(wantYaw, -math.rad(spec.yawLimit), math.rad(spec.yawLimit))
					local heldPitch = math.clamp(wantPitch, VehicleWeaponData.PitchFloor(spec, heldYaw), math.rad(spec.pitchMax))
					if pinnedToArc(wantYaw, wantPitch, heldYaw, heldPitch) then
						-- The mark goes where the gun can point: along the arc's edge, as far out as the aim.
						local dx, dy, dz = directionFromAngles(yaw, pitch)
						local edge = rest:PointToWorldSpace(pivot) + rest:VectorToWorldSpace(Vector3.new(dx, dy, dz)) * fromPivot.Magnitude
						local screen, onScreen = camera:WorldToViewportPoint(edge)
						if onScreen then
							placeReticle(screen.X, screen.Y, true)
						else
							placeReticle(screenX, screenY, true)
						end
					end
				end
			end
		end

		if firing and now - lastShotAt &gt;= 1 / spec.fireRate and ready then
			lastShotAt = now
			lastAimAt = now -- the server takes the aim from the shot too
			fireRemote:FireServer(target)
			if view then
				view:Fired()
			end
		elseif now - lastAimAt &gt;= AIM_SEND_EVERY then
			lastAimAt = now
			aimRemote:FireServer(target)
		end
		showAmmo(spec, ammo, hot)
	end

	-- Everyone else's mounts (and this player's other one), from what their users last sent; an
	-- unmanned one settles to rest.
	local eye = camera.CFrame.Position
	for _, vehicle in ipairs(CollectionService:GetTagged(TAG)) do
		if vehicle.PrimaryPart and (vehicle.PrimaryPart.Position - eye).Magnitude &lt; 400 then
			local modelId = vehicle:GetAttribute("VehicleModel")
			for _, other in ipairs(VehicleWeaponData.Mounts) do
				local otherSpec = VehicleWeaponData.ForModel(modelId, other)
				if otherSpec and not (vehicle == mine and other == mount) then
					local seat = other == "turret" and gunnerSeatOf(vehicle) or vehicle:FindFirstChild("DriverSeat")
					local manned = seat ~= nil and seat.Occupant ~= nil
					local attributes = VehicleWeaponData.Attributes[other]
					local yaw = manned and vehicle:GetAttribute(attributes.yaw) or 0
					local pitch = manned and vehicle:GetAttribute(attributes.pitch) or otherSpec.restPitch or 0
					swingMount(vehicle, other, otherSpec, yaw, pitch, dt)
				end
			end
		end
	end
end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX193"><Properties><string name="Name">Viewmodel</string><ProtectedString name="Source">-- The first-person viewmodel: your gun, held in your own Roblox arms, animated by the gun's own
-- mechanism. ModuleScript; CombatClient drives it.
--
--   local vm = Viewmodel.new(def, { color, material, skinned, character, parent, onEvent })
--   vm:Equip(rack)            draw it (and rack it, the first time this gun comes out)
--   vm:Fire(roundsLeft)       recoil, the mechanism cycling, the muzzle flash and the casing
--   vm:StartReload(seconds, roundsLeft, magSize) / vm:StopReload()
--   vm:Inspect()
--   vm:Update(dt, input)      once a frame; returns what the frame needs to know (scope, muzzle, laser)
--   vm:Destroy()
--
-- Nothing here guesses at a gun from part names. GunModels writes an animation contract onto every
-- model -- which parts move together (the Anim attribute), where the hands go (KP_ keypoints), where
-- hinges turn and how far slides travel (Pivot_/Swing_/Travel_) -- and this reads it. A reload is a
-- clip: keyframes for the gun's own motion, each hand's target, and every moving part, laid on the
-- reload's real duration, with sounds and dropped magazines fired as events along the way. Each
-- mechanism has its own clip: an AR's magazine swap and charging handle, a pistol's dropped magazine
-- and slide release, a revolver's crane and speedloader, a pump gun fed a shell at a time, a double
-- barrel broken open, a lever gun, a belt-fed cover and box, a rocket slid in from the muzzle.
--
-- Everything is built to work in edit mode too (no LocalPlayer, no services it doesn't need), so the
-- gallery can pose a viewmodel at any moment of any clip and photograph it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GunModels = require(Shared:WaitForChild("GunModels"))

local Viewmodel = {}
Viewmodel.__index = Viewmodel

local V = Vector3.new
local CF = CFrame.new
local rad = math.rad

local function A(x, y, z)
	return CFrame.Angles(rad(x or 0), rad(y or 0), rad(z or 0))
end

local function smooth(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function localOnly(part)
	part.Anchored = true
	part.CanCollide = false
	-- The viewmodel lives under the camera; the crosshair raycast would otherwise hit your own gun.
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
end
Viewmodel.LocalOnly = localOnly

-- Hides or shows a gun part. A SurfaceGui draws whatever its host's transparency is, so the lettering
-- stamped on a slide or magazine (ArsenalFinish) went on showing with the part hidden: hanging in
-- mid-air where the magazine was during a reload, and over the scope picture when the whole gun is
-- hidden behind it (#72). Its guis go with it.
local function veil(part, hidden)
	part.LocalTransparencyModifier = hidden and 1 or 0
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("SurfaceGui") then
			child.Enabled = not hidden
		end
	end
end
Viewmodel.Veil = veil

--------------------------------------------------------------------------------
-- Arms
--
-- The player's own Roblox arms, in their skin colour and their shirt, cloned into the viewmodel and
-- posed to hold the gun. Each arm is two bones solved to reach its hand: the upper arm from the
-- shoulder to the elbow, the lower arm on to the wrist, and the hand on the gun. The elbow is pulled
-- toward a pole below and outside the shoulder, the way elbows hang when you hold a rifle.
--
-- An R15 avatar gives its UpperArm, LowerArm and Hand, lined up by their own rig attachments so any
-- body package fits. An R6 avatar's single arm is cut into an upper and a lower half. With no
-- character to copy (the gallery in edit mode, or an avatar still loading), plain blocks stand in, in
-- a default skin and shirt colour. Everything is slimmed to ARM_THICKNESS across and stretched to the
-- bone lengths: a Roblox arm at full size fills a third of the screen from the shoulder.
--
-- A Humanoid of their own, with a copy of the avatar's Shirt, is what dresses the arms in the shirt.
--------------------------------------------------------------------------------

-- Studs, view space: where the shoulders are and where the elbows hang toward.
local SHOULDER = { [1] = V(0.72, -0.78, 0.3), [-1] = V(-0.7, -0.8, 0.25) }
local POLE = { [1] = V(1.6, -2.2, 0.4), [-1] = V(-1.0, -2.4, -0.2) }
local UPPER, FOREARM = 1.12, 1.0
-- A long gun's support hand is further from the shoulder than the arm is long: at the hip 53 of 62 guns
-- put the left hand past reach, the railguns by 56%, and the arm was stretched to fit -- a rod half as long
-- again as its partner, dead straight, which is what reads as "the joints look disconnected on long
-- rifles" (#11). A body turns into a long gun, and so the shoulder comes forward instead: toward the hand,
-- as far as REACH_COMFORT of the arm's length, by no more than SHOULDER_TRAVEL, and never into view. The
-- widest view is Settings' largest field of view (95 degrees, Settings.lua), and the shoulder stays
-- SHOULDER_HIDE below its bottom edge so the arm's own thickness there is off screen too. Measured by
-- tools/fps_arms_check.py: worst stretch 1.56 -&gt; 1.07.
local REACH_COMFORT = 0.97
local SHOULDER_TRAVEL = 1.3
local WIDEST_VIEW_TAN = math.tan(math.rad(95 / 2))
local SHOULDER_HIDE = 0.2
-- Where the elbow goes. The pole alone put it the same way whatever the hand was doing, and at full aim the
-- trigger hand met its forearm at 99 to 130 degrees on 56 of 62 guns: a wrist no one has, and the other
-- half of "disconnected". The elbow is free to swing round the line from shoulder to wrist without moving
-- either, so it swings WRIST_FOLLOW of the way toward where the forearm would carry straight on from the
-- hand, and no higher than ELBOW_CEILING above the shoulder, so it never rises into the picture.
local WRIST_FOLLOW = 0.75
local ELBOW_CEILING = 0.2
-- Slimmer than an avatar's own (1 stud): at 0.4 the trigger arm of a straight-stocked gun filled half the
-- screen beside the sights.
local ARM_THICKNESS = 0.34
-- A hand, in the palm frame the rig builds: across the palm, wrist to fingertips, and palm to back. Scaled
-- on each axis rather than by the arm's width alone, which left an avatar's hand 89 mm thick and 36 mm
-- long -- a stub that stopped short of the grip instead of closing on it.
-- The palm alone: the fingers below are parts of their own. The palm is as long as it is wide, as a hand's
-- is (#92): at 0.2 (53 mm) it was half a real palm, its knuckles stopped short of a pistol grip's front
-- strap, and the fingers hinged there had the grip's own front in their way at any close -- 26 of 62
-- trigger hands closed no finger at all and 24 closed one, a flat slab laid on the grip.
local HAND_WIDTH, HAND_LENGTH, HAND_THICKNESS = 0.3, 0.3, 0.11
-- How far past the keypoint the palm's inner face goes, so the hand presses into what it holds rather
-- than resting outside it. The face lands at (keypoint - HAND_SINK) whatever the hand's thickness, and the
-- guns' keypoints were authored against this depth, so it stays where it was when the hand was thicker.
local HAND_SINK = 0.055

-- An avatar hand's size in its own axes: X palm to back, Y wrist to fingertips, Z across the palm.
local function handScale(size)
	return V(HAND_THICKNESS / math.max(size.X, 1e-3), HAND_LENGTH / math.max(size.Y, 1e-3), HAND_WIDTH / math.max(size.Z, 1e-3))
end
-- Fingers. One box per hand can meet a grip but it cannot close round one, which up close reads as a slab
-- pressed against the gun rather than a hand holding it. These are two segments hinged at the knuckles,
-- swinging down over the front of whatever the palm is on and turning under it. Open, they carry straight
-- on from the palm; closed, they wrap.
local FINGER_SPAN = 0.22 -- across the hand: the four fingers, narrower than the whole palm
local FINGER_THICKNESS = 0.055
local FINGER_UPPER, FINGER_LOWER = 0.105, 0.09
-- Four fingers with daylight between them, not one slab the width of four: a slab can close round a grip
-- and still read as a mitten, and the silhouette is what a player judges. The lean makes the bundle
-- uneven, as a hand's is, so the four don't move as one plank.
local FINGER_COUNT = 4
local FINGER_GAP = 0.012
local FINGER_WIDTH = (FINGER_SPAN - FINGER_GAP * (FINGER_COUNT - 1)) / FINGER_COUNT
local FINGER_LEAN = { 0.92, 1, 0.98, 0.9 }
local FINGER_X = {}
for i = 1, FINGER_COUNT do
	FINGER_X[i] = -FINGER_SPAN / 2 + FINGER_WIDTH / 2 + (i - 1) * (FINGER_WIDTH + FINGER_GAP)
end
-- The knuckle line, ahead of the keypoint: far enough forward to clear the front face of a grip, but never
-- past the palm's own reach. A handguard runs the length of the gun, and fingers close round it where the
-- hand actually is, not out by the muzzle.
local KNUCKLE, KNUCKLE_MAX = HAND_LENGTH / 2, HAND_LENGTH / 2 + 0.035
local FINGER_CLEAR = 0.008
local KNUCKLE_STEP = 0.012
-- How far a finger may press into what it holds before the close is called too far (1.6 mm: pressed, not
-- through), and how finely the close is swept looking for that point.
local FINGER_PRESS = 0.006
local CURL_STEPS = 24
-- Below this a finger has nothing worth closing on, and is kept inside the palm rather than stood out.
local FINGER_MIN_CLOSE = 0.3
-- A finger never closes into the sight picture: a cone of 3 degrees round the aimed eye's line, three
-- times the crosshair's own ring at the widest aimed field of view. A support hand's fingers wrapping up
-- over a low fore-end otherwise came into the ring when the palm was made its real length.
local SIGHT_CLEAR = math.tan(math.rad(3))
-- What blocks a finger there, named like a part so a report says why.
local SIGHT_LINE = { name = "sight line" }
-- How deep under the palm a grip can be and still be something to close on, and the step the search walks.
local GRIP_REACH = 0.34
local GRIP_STEP = 0.0038
-- The depths below the palm at which the fingers' own band is measured: 12, 24 and 36 mm down, which is
-- where the fingers are, rather than at the middle of whatever the palm sits on.
local FINGER_LEVELS = { 0.0456, 0.0912, 0.1368 }
-- With nothing measured under the palm the fingers close on themselves, which is what a hand reaching for
-- a magazine or a pocket does.
local FIST = {}
for i = 1, FINGER_COUNT do
	FIST[i] = { knuckle = KNUCKLE, turn = 1, cap = 1 }
end

local DEFAULT_SKIN = Color3.fromRGB(234, 184, 146)
local DEFAULT_SHIRT = Color3.fromRGB(52, 56, 70)
local SIDE_NAME = { [1] = "Right", [-1] = "Left" }

-- A Roblox hand hangs with its fingers down (-Y) and the back of the hand outward (+X on the right,
-- -X on the left). The palm frame the gun gives has the fingers along -Z and the back of the hand up
-- (+Y). This turns one into the other.
local HAND_AXES = {
	[1] = CFrame.fromMatrix(Vector3.zero, V(0, 1, 0), V(0, 0, 1), V(1, 0, 0)),
	[-1] = CFrame.fromMatrix(Vector3.zero, V(0, -1, 0), V(0, 0, 1), V(-1, 0, 0)),
}

-- What a hand keypoint has under it, in the keypoint's own frame: how far material runs below the palm's
-- inner face (a grip's depth, palm side to far side), and how far the face the fingers come over stands
-- ahead of the keypoint. Measured from the parts' own shapes so the fingers close on what is actually
-- there; nil when the palm is not on anything, and the fingers then close on themselves.
local function shapeNode(part, offset)
	local kind = "box"
	if part:IsA("Part") then
		if part.Shape == Enum.PartType.Cylinder then
			kind = "cyl"
		elseif part.Shape == Enum.PartType.Ball then
			kind = "ball"
		end
	end
	return { inverse = offset:Inverse(), half = part.Size / 2, kind = kind, name = part.Name }
end

local function insideNode(node, point)
	local p = node.inverse * point
	local h = node.half
	if node.kind == "cyl" then
		local r = math.min(h.Y, h.Z)
		return math.abs(p.X) &lt;= h.X and p.Y * p.Y + p.Z * p.Z &lt;= r * r
	elseif node.kind == "ball" then
		return p.Magnitude &lt;= math.min(h.X, h.Y, h.Z)
	end
	-- A wedge counts as its whole box: the fingers then stop a little further out than they need to,
	-- which is the safe way to be wrong.
	return math.abs(p.X) &lt;= h.X and math.abs(p.Y) &lt;= h.Y and math.abs(p.Z) &lt;= h.Z
end

-- The two finger segments, as boxes, for a given knuckle plane: `curl` swings the upper one down over
-- what the palm is on, `turn` decides how much further the lower one comes in under it. Both the build's
-- measuring and the pose itself go through here, so they cannot drift apart.
local function fingerAt(knuckleFrame, curl, turn)
	local upper = knuckleFrame * A(-90 * curl, 0, 0)
	local lower = upper * CF(0, 0, -FINGER_UPPER) * A(-90 * curl * turn, 0, 0)
	return upper * CF(0, 0, -FINGER_UPPER / 2), lower * CF(0, 0, -FINGER_LOWER / 2)
end

-- `sight` (the gun's KP_Sight and eye relief) is the aimed eye's line: no finger may close into a cone of
-- SIGHT_CLEAR round it, which is where the crosshair and the sight picture are (#26).
local function gripShape(offsets, keyFrame, sight)
	local origin = keyFrame.Position
	local near = {}
	for part, offset in pairs(offsets) do
		if part.Transparency &lt; 1 and (offset.Position - origin).Magnitude &lt;= GRIP_REACH + part.Size.Magnitude / 2 then
			table.insert(near, shapeNode(part, offset))
		end
	end
	-- With nothing under the palm the fingers close on themselves, as a hand reaching for a magazine or a
	-- pocket does -- but through the same search as a grip, so a fist too stays out of the sight picture.
	-- It once came from a fixed table, and with the palm its real length a support hand's fist on a gun
	-- with nothing under it put a fingertip in the crosshair's ring.
	local onNothing = #near == 0
	local function solid(cframe)
		local point = cframe.Position
		for _, node in ipairs(near) do
			if insideNode(node, point) then
				return node
			end
		end
		return nil
	end
	-- Straight down from the palm's inner face: where material starts, and the deepest still under the
	-- hand. Walking the whole way rather than stopping at the first gap keeps a grip with a hollow between
	-- its panels in one piece.
	local palm = keyFrame * CF(0, -HAND_SINK, 0)
	local first, depth
	local d = 0
	while d &lt;= GRIP_REACH do
		if solid(palm * CF(0, -d, 0)) then
			first = first or d
			depth = d
		end
		d += GRIP_STEP
	end
	-- Nothing under the palm, or nothing until well past it: nothing to close on.
	if not depth or first &gt; 0.02 then
		onNothing = true
		table.clear(near)
	end
	-- How far forward the face the fingers come over stands, looked for only as far as the knuckles can
	-- reach: on a grip this finds its front, and on a handguard that runs on to the muzzle it stops at
	-- the end of the hand, which is where the fingers close.
	--
	-- Measured at several depths and taking the NEAREST face, not one depth and the furthest. A trigger
	-- guard sits above the fingers and reaches much further forward than the grip they close on, so
	-- measuring at the middle of the grip put every knuckle line out at the guard: all 62 guns came back
	-- with the line at its 35.5 mm limit and 93 of 100 anchors then could not close at all.
	-- Each finger stands at its own place along what the hand holds, and what is in front of it there is
	-- its own business: a grip is raked, so its face moves back as you go down it, and a trigger guard
	-- stands far forward of the top finger and nowhere near the bottom one. Measuring once for the whole
	-- hand gave every finger the topmost obstruction's knuckle line, and three of four then had no room
	-- to close -- 50 of 100 anchors closed exactly one finger. So the line, what it wraps, and how far it
	-- may close are all measured per finger.
	-- Across the finger's whole width, not down its middle line: a grip's finger grooves and nubs stand
	-- between and beside the fingers' middles, the line never saw them, and the close then stopped on
	-- them a few degrees in -- the commonest reason (with the trigger guard) a trigger hand closed one
	-- finger or none (#92).
	local edge = FINGER_WIDTH / 2 - FINGER_PRESS
	local function frontAt(across)
		local nearest
		for _, level in ipairs(FINGER_LEVELS) do
			local reach = 0
			for _, offset in ipairs({ -edge, 0, edge }) do
				local at = palm * CF(across + offset, -level, 0)
				local z = 0
				while z &lt;= KNUCKLE_MAX do
					if solid(at * CF(0, 0, -z)) then
						reach = math.max(reach, z)
					end
					z += GRIP_STEP
				end
			end
			-- A level below the bottom of what the hand holds finds nothing and says nothing.
			if reach &gt; 0 and (not nearest or reach &lt; nearest) then
				nearest = reach
			end
		end
		return nearest or 0
	end
	-- How far the fingers can actually close before they are inside the gun. Closing a hand round a short
	-- grip would otherwise bring the fingertips back through the grip itself: the arithmetic says the
	-- fingers have room, because below the knuckles there is nothing, but the grip is behind them. So the
	-- close is swept and stopped where the gun is, which needs no rule about what kind of grip it is.
	-- Returns the part in the way, or nil when the finger has room. Naming what blocks a finger is the
	-- difference between "it will not close" and knowing why, which is three measured rounds of guessing
	-- saved the next time this moves.
	local function inSight(point)
		if not sight then
			return false
		end
		local p = sight.frame:PointToObjectSpace(point)
		local depth = sight.relief - p.Z
		return depth &gt; 0 and p.X * p.X + p.Y * p.Y &lt; (depth * SIGHT_CLEAR) ^ 2
	end
	local function blockedBy(frame, length)
		local hx = FINGER_WIDTH / 2 - FINGER_PRESS
		local hy = FINGER_THICKNESS / 2 - FINGER_PRESS
		local hz = length / 2 - FINGER_PRESS
		for _, sx in ipairs({ -1, 0, 1 }) do
			for _, sz in ipairs({ -1, 0, 1 }) do
				for _, sy in ipairs({ -1, 1 }) do
					local point = frame * CF(sx * hx, sy * hy, sz * hz)
					local hit = solid(point)
					if hit then
						return hit
					end
					if inSight(point.Position) then
						return SIGHT_LINE
					end
				end
			end
		end
		return nil
	end
	-- One finger at a time: where its knuckle sits, how deep the material is in that finger's own plane
	-- (which decides how far its tip turns in), and how far it can close before it is inside the gun.
	-- A finger with no room stays out -- on a pistol grip that is the top one, lying along the trigger
	-- guard, which is where a trigger finger belongs.
	-- A finger past the end of what the hand holds -- above the top of a grip, or below its butt -- finds
	-- nothing in front of it. Given the minimum line it would be planted INSIDE the grip and blocked at
	-- every angle, which is what put 62 of 100 hands flat; it takes its nearest neighbour's line instead,
	-- and then closes on air, which is what a finger hanging off the end of a grip does.
	local fronts = {}
	for index = 1, FINGER_COUNT do
		fronts[index] = frontAt(FINGER_X[index])
	end
	for index = 1, FINGER_COUNT do
		if fronts[index] &lt;= 0 then
			for step = 1, FINGER_COUNT do
				local before, after = fronts[index - step], fronts[index + step]
				if before and before &gt; 0 then
					fronts[index] = before
					break
				elseif after and after &gt; 0 then
					fronts[index] = after
					break
				end
			end
		end
	end

	local fingers = {}
	local reach = FINGER_UPPER + FINGER_LOWER
	local function closeAt(index, knuckle)
		local at = keyFrame * CF(FINGER_X[index], -HAND_SINK, -knuckle)
		local wrap, k = 0, 0
		while k &lt;= GRIP_REACH do
			if solid(at * CF(0, -k, 0)) then
				wrap = k
			end
			k += GRIP_STEP
		end
		local turn = math.clamp((reach - wrap) / FINGER_LOWER, 0, 1)
		local cap, blocker = 0, nil
		for step = CURL_STEPS, 0, -1 do
			local candidate = step / CURL_STEPS
			local upper, lower = fingerAt(at, candidate * FINGER_LEAN[index], turn)
			local hit = blockedBy(upper, FINGER_UPPER) or blockedBy(lower, FINGER_LOWER)
			if not hit then
				cap = candidate
				blocker = nil
				break
			end
			blocker = blocker or hit.name
		end
		return { knuckle = knuckle, turn = turn, cap = cap, blocker = blocker }
	end
	-- The measured front is where the fingers' own band meets the grip at a few depths, and a raked
	-- grip's front strap runs further forward below them: a finger hinged just clear of the measured
	-- front then met the strap a few degrees into its close. So a finger that cannot close from there
	-- tries its knuckle line further forward, KNUCKLE_STEP at a time up to the palm's reach, and keeps
	-- whichever closes it furthest.
	for index = 1, FINGER_COUNT do
		local knuckle = math.clamp(fronts[index] + FINGER_THICKNESS / 2 + FINGER_CLEAR, KNUCKLE, KNUCKLE_MAX)
		local best = closeAt(index, knuckle)
		while best.cap &lt; FINGER_MIN_CLOSE and knuckle &lt; KNUCKLE_MAX - 1e-4 do
			knuckle = math.min(knuckle + KNUCKLE_STEP, KNUCKLE_MAX)
			local tried = closeAt(index, knuckle)
			-- Closing further wins; failing that, a line where the finger at least lies free of the gun.
			if tried.cap &gt; best.cap or (tried.cap == best.cap and not tried.blocker and best.blocker) then
				best = tried
			end
		end
		fingers[index] = best
	end
	return { fingers = fingers, onNothing = onNothing }
end

local Arms = {}
Arms.__index = Arms

-- Where a joint sits on an avatar part, read from its rig attachment, or the middle of the part's top
-- or bottom face if it has none.
local function joint(source, name, fallbackY)
	local attachment = source and source:FindFirstChild(name)
	if attachment and attachment:IsA("Attachment") then
		return attachment.Position
	end
	return V(0, fallbackY, 0)
end

-- A copy of an avatar part keeping only its shape and look (its mesh and surface): joints, welds and
-- attachments stay behind. Copies the avatar part's colour and material as they are.
local function copyPart(source)
	local part = source:Clone()
	for _, child in ipairs(part:GetChildren()) do
		if not (child:IsA("SpecialMesh") or child:IsA("SurfaceAppearance") or child:IsA("Decal") or child:IsA("Texture")) then
			child:Destroy()
		end
	end
	localOnly(part)
	-- The first-person camera sets this on the avatar's own parts, and a clone would carry it over.
	part.LocalTransparencyModifier = 0
	return part
end

local function block(name, size, color)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	localOnly(part)
	return part
end

-- A bone: a part, its unscaled size, and its two joints in its own unscaled space. `fit` scales it to
-- ARM_THICKNESS across and `length` between the joints (times `stretch` when a hand is out of reach).
-- `elbow` says which end meets the other bone at the elbow ("top" or "bottom").
local function bone(part, top, bottom, length, elbow)
	return { part = part, base = part.Size, rawTop = top, rawBottom = bottom, length = length, stretch = -1, elbow = elbow }
end

-- How far each bone runs on past the elbow joint. Two boxes that END at a joint leave an open wedge on the
-- outside of any bend -- 0.146 studs across at a bent elbow on the stand-in arms and on an R6 arm, whose
-- joints are the middles of its end faces. Running each on by half the arm's thickness closes it for any
-- bend up to a right angle. An R15 arm's rig attachments already sit that far inside the part, so it is
-- unchanged. The wrist is not lengthened: the forearm is three times the hand's thickness, and run on it
-- would come out through the back of the hand.
local ELBOW_OVERRUN = ARM_THICKNESS / 2

local function fit(b, stretch)
	if math.abs(b.stretch - stretch) &lt; 0.005 then
		return
	end
	b.stretch = stretch
	-- Solve the Y scale so the two JOINTS end up `length * stretch` apart, instead of scaling the part
	-- by the straight-line distance between them and hoping. An R15 body package puts the shoulder and
	-- elbow attachments OFF the part's centre line -- measured at 0.1700 studs on the stock rig -- so
	-- the joint-to-joint vector has X and Z in it, and those are scaled by the arm's THICKNESS, not by
	-- its length. Scaling Y by `wanted / span` therefore left the joints 0.1643 studs apart (0.9557
	-- instead of 1.1200) on every gun and every pose: Oliver's #11, "the arms joints look disconnected".
	-- On a rig whose attachments ARE on the centre line this is arithmetically identical to what it
	-- replaced, so nothing that looks right today can be made wrong by it.
	local raw = b.rawTop - b.rawBottom
	local across, through = ARM_THICKNESS / b.base.X, ARM_THICKNESS / b.base.Z
	local wanted = b.length * stretch
	local sideways = math.sqrt((raw.X * across) ^ 2 + (raw.Z * through) ^ 2)
	local along = wanted * wanted - sideways * sideways
	-- A bone shorter than its own sideways offset has no solution; keep the old scale rather than take
	-- the root of a negative number.
	along = along &gt; 0 and math.sqrt(along) or (wanted * math.abs(raw.Y) / math.max(raw.Magnitude, 1e-3))
	local scale = V(across, along / math.max(math.abs(raw.Y), 1e-3), through)
	local size = b.base * scale
	local top = b.rawTop * scale
	-- Run on past the elbow (ELBOW_OVERRUN), lengthening the part at that end only: the part grows by
	-- `extra` and its joints move `extra / 2` away from the elbow end in its own space, so the far end
	-- stays where it was.
	if b.elbow then
		local half = size.Y / 2
		local at = (b.elbow == "top" and top.Y) or (top.Y - raw.Y * scale.Y)
		local have = b.elbow == "top" and (half - at) or (half + at)
		local extra = math.max(ELBOW_OVERRUN - have, 0)
		if extra &gt; 0 then
			size = V(size.X, size.Y + extra, size.Z)
			top = top + V(0, b.elbow == "top" and -extra / 2 or extra / 2, 0)
		end
	end
	b.part.Size = size
	b.top = top
	-- The joint line in the scaled part's own space. `place` lays THIS along the bone.
	b.joint = raw * scale
end

function Arms.new(parent, character)
	local self = setmetatable({ sides = {}, parts = {} }, Arms)
	local model = Instance.new("Model")
	model.Name = "Arms"
	local r15 = character ~= nil and character:FindFirstChild("RightUpperArm") ~= nil and character:FindFirstChild("LeftUpperArm") ~= nil
	local r6 = not r15 and character ~= nil and character:FindFirstChild("Right Arm") ~= nil and character:FindFirstChild("Left Arm") ~= nil

	for _, side in ipairs({ 1, -1 }) do
		local name = SIDE_NAME[side]
		local arm = {}
		if r15 then
			local upper = character:FindFirstChild(name .. "UpperArm")
			local lower = character:FindFirstChild(name .. "LowerArm")
			local hand = character:FindFirstChild(name .. "Hand")
			arm.upper = bone(copyPart(upper), joint(upper, name .. "ShoulderRigAttachment", upper.Size.Y / 2),
				joint(upper, name .. "ElbowRigAttachment", -upper.Size.Y / 2), UPPER, "bottom")
			arm.lower = lower and bone(copyPart(lower), joint(lower, name .. "ElbowRigAttachment", lower.Size.Y / 2),
				joint(lower, name .. "WristRigAttachment", -lower.Size.Y / 2), FOREARM, "top")
			if hand then
				local handPart = copyPart(hand)
				local scale = handScale(hand.Size)
				arm.handTop = joint(hand, name .. "WristRigAttachment", hand.Size.Y / 2) * scale
				handPart.Size = hand.Size * scale
				arm.hand = handPart
			end
		elseif r6 then
			local source = character:FindFirstChild(name .. " Arm")
			local half = source.Size.Y / 2
			arm.upper = bone(copyPart(source), V(0, half, 0), V(0, -half, 0), UPPER, "bottom")
			arm.lower = bone(copyPart(source), V(0, half, 0), V(0, -half, 0), FOREARM, "top")
		else
			arm.upper = bone(block(name .. "UpperArm", V(1, 1, 1), DEFAULT_SHIRT), V(0, 0.5, 0), V(0, -0.5, 0), UPPER, "bottom")
			arm.lower = bone(block(name .. "LowerArm", V(1, 1, 1), DEFAULT_SKIN), V(0, 0.5, 0), V(0, -0.5, 0), FOREARM, "top")
			arm.hand = block(name .. "Hand", V(HAND_THICKNESS, HAND_LENGTH, HAND_WIDTH), DEFAULT_SKIN)
			arm.handTop = V(0, HAND_LENGTH / 2, 0)
		end
		if not arm.lower then
			arm.lower = bone(block(name .. "LowerArm", V(1, 1, 1), arm.upper.part.Color), V(0, 0.5, 0), V(0, -0.5, 0), FOREARM, "top")
		end
		fit(arm.upper, 1)
		fit(arm.lower, 1)
		-- Fingers, in the hand's own colour. Only where there is a hand to hinge them on: an R6 arm ends
		-- at the palm and has none.
		if arm.hand then
			arm.fingers = {}
			for i = 1, FINGER_COUNT do
				local finger = {
					block(name .. "Finger" .. i .. "Upper", V(FINGER_WIDTH, FINGER_THICKNESS, FINGER_UPPER), arm.hand.Color),
					block(name .. "Finger" .. i .. "Lower", V(FINGER_WIDTH, FINGER_THICKNESS, FINGER_LOWER), arm.hand.Color),
					across = FINGER_X[i],
					lean = FINGER_LEAN[i],
				}
				finger[1].Material = arm.hand.Material
				finger[2].Material = arm.hand.Material
				arm.fingers[i] = finger
			end
		end
		for _, part in ipairs({ arm.upper.part, arm.lower.part, arm.hand }) do
			part.Parent = model
			table.insert(self.parts, part)
		end
		for _, finger in ipairs(arm.fingers or {}) do
			for _, part in ipairs({ finger[1], finger[2] }) do
				part.Parent = model
				table.insert(self.parts, part)
			end
		end
		self.sides[side] = arm
	end

	-- Dressing: a Humanoid of their own, told not to scale, show a name or run a state machine, and
	-- the avatar's Shirt.
	local shirt = character and character:FindFirstChildOfClass("Shirt")
	if (r15 or r6) and shirt then
		local humanoid = Instance.new("Humanoid")
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.RigType = r15 and Enum.HumanoidRigType.R15 or Enum.HumanoidRigType.R6
		pcall(function()
			humanoid.AutomaticScalingEnabled = false
		end)
		pcall(function()
			humanoid.EvaluateStateMachine = false
		end)
		humanoid.Parent = model
		shirt:Clone().Parent = model
	end
	model.Parent = parent
	self.model = model
	return self
end

-- What the avatar's arms look like, as one string: each arm part's colour, material and size, and the
-- shirt. Two equal strings mean a copy made from either looks the same.
--
-- ONLY PROPERTIES A LOCALSCRIPT MAY READ. This used to read MeshPart.MeshId too, and it runs inside
-- Viewmodel.new: a read the client is refused throws, and a throw there is not a grey arm, it is no
-- viewmodel at all -- the gun and both arms, on every draw, for anyone with an R15 avatar (whose arms
-- are MeshParts), while the edit-mode gallery (stand-in arms) and the offline check (whose mock allowed
-- the read) never saw it. Oliver's playtest, 09-24: "fps models aren't showing up". A body package
-- changes the parts' sizes, which is read here, so the mesh is not needed to see it. And the callers
-- pcall this: working out whether to re-copy the arms must never be able to take the gun with it.
local LOOK_PARTS = {
	"RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperArm", "LeftLowerArm", "LeftHand", "Right Arm", "Left Arm",
}
local LOOK_CHECK = 1
function Arms.LookOf(character)
	if not character then
		return ""
	end
	local out = {}
	for _, name in ipairs(LOOK_PARTS) do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			out[#out + 1] = string.format("%s|%s|%s|%s", name, tostring(part.Color), tostring(part.Material),
				tostring(part.Size))
		end
	end
	local shirt = character:FindFirstChildOfClass("Shirt")
	out[#out + 1] = shirt and shirt.ShirtTemplate or "-"
	return table.concat(out, ";")
end

function Arms:SetHidden(hidden)
	for _, part in ipairs(self.parts) do
		part.LocalTransparencyModifier = hidden and 1 or 0
	end
end

-- Poses one arm. `hand` is the palm's world CFrame (-Z along the fingers, +Y out of the back of the
-- hand). `curl` (how far a hand closes) is kept in the signature for callers; a Roblox hand has no
-- fingers to close. Appends parts and CFrames for BulkMoveTo.
function Arms:pose(side, view, hand, curl, parts, cframes, held)
	local arm = self.sides[side]
	local shoulder = (view * CF(SHOULDER[side])).Position
	-- A gun's hand keypoint is the middle of the palm against what it holds, so the hand moves out along
	-- the back of the hand by half its own thickness, less HAND_SINK, which presses the palm into the grip
	-- instead of resting it against the surface.
	hand = hand * CF(0, HAND_THICKNESS / 2 - HAND_SINK, 0)
	local handFrame = hand * HAND_AXES[side]
	-- The wrist is where the hand's own wrist joint is; an R6 arm has no hand, and ends at the palm.
	local wrist = arm.hand and (handFrame * arm.handTop) or hand.Position
	local reach = UPPER + FOREARM

	-- A hand past comfortable reach brings the shoulder forward (REACH_COMFORT, SHOULDER_TRAVEL): first
	-- straight toward the wrist, and where that would bring it into the widest view, on along the view's
	-- bottom edge (kept SHOULDER_HIDE below it) toward the wrist. Worked in view space, where that edge is
	-- the plane depth = (-y - SHOULDER_HIDE) / WIDEST_VIEW_TAN.
	local comfort = reach * REACH_COMFORT
	if (wrist - shoulder).Magnitude &gt; comfort then
		local from = SHOULDER[side]
		local target = view:PointToObjectSpace(wrist)
		-- How far inside the hidden side of that plane a view-space point is (negative is hidden).
		local function shown(p)
			return -p.Z - (-p.Y - SHOULDER_HIDE) / WIDEST_VIEW_TAN
		end
		local toward = (target - from).Unit
		local slide = (target - from).Magnitude - comfort
		local rate = shown(from + toward) - shown(from)
		if rate &gt; 0 then
			slide = math.min(slide, math.max(-shown(from) / rate, 0))
		end
		slide = math.min(slide, SHOULDER_TRAVEL)
		local moved = from + toward * slide
		local left = SHOULDER_TRAVEL - slide
		local still = (target - moved).Magnitude - comfort
		if still &gt; 0 and left &gt; 0 then
			-- Along the edge: the direction to the wrist with the plane's normal taken out, which keeps
			-- `shown` where it is. The distance shrinks by less than the step, so a few steps close in.
			local normal = V(0, 1 / WIDEST_VIEW_TAN, -1).Unit
			for _ = 1, 4 do
				local want = target - moved
				local glide = want - normal * want:Dot(normal)
				still = want.Magnitude - comfort
				if still &lt;= 1e-3 or left &lt;= 1e-3 or glide.Magnitude &lt; 1e-4 then
					break
				end
				local step = math.min(still / math.max(glide.Unit:Dot(want.Unit), 0.2), left)
				moved += glide.Unit * step
				left -= step
			end
		end
		shoulder = view * moved
	end

	local toWrist = wrist - shoulder
	local distance = toWrist.Magnitude
	local direction = distance &gt; 1e-3 and toWrist.Unit or view.LookVector
	local elbow
	if distance &gt;= reach * 0.999 then
		-- Out of reach: stretch both bones rather than leave a gap at the wrist.
		local stretch = distance / reach
		fit(arm.upper, stretch)
		fit(arm.lower, stretch)
		elbow = shoulder + direction * distance * UPPER / reach
	else
		fit(arm.upper, 1)
		fit(arm.lower, 1)
		local along = (UPPER * UPPER - FOREARM * FOREARM + distance * distance) / (2 * distance)
		local out = math.sqrt(math.max(0, UPPER * UPPER - along * along))
		local pole = (view * CF(POLE[side])).Position - shoulder
		local perpendicular = pole - direction * pole:Dot(direction)
		if perpendicular.Magnitude &lt; 1e-3 then
			perpendicular = -view.UpVector
		end
		local swing = perpendicular.Unit
		-- Toward a straight wrist (WRIST_FOLLOW): where the elbow would be if the forearm carried straight
		-- on back from the hand. Weighted by how far off the shoulder-wrist line that is, so it fades out
		-- smoothly rather than flipping where the line passes through it.
		local straight = (wrist - hand.LookVector * FOREARM) - shoulder
		straight -= direction * straight:Dot(direction)
		local lean = math.min(straight.Magnitude / 0.2, 1) * WRIST_FOLLOW
		if straight.Magnitude &gt; 1e-4 then
			local blend = swing * (1 - lean) + straight.Unit * lean
			if blend.Magnitude &gt; 1e-3 then
				swing = blend.Unit
			end
		end
		-- No higher than ELBOW_CEILING above the shoulder: the swing is an angle round the line from the
		-- straight-down direction, and the height limits that angle either way.
		local up = view.UpVector
		local down = -up - direction * (-up):Dot(direction)
		if down.Magnitude &gt; 1e-3 and out &gt; 1e-3 then
			down = down.Unit
			local across = direction:Cross(down)
			local k = -down:Dot(up)
			local angle = math.atan2(swing:Dot(across), swing:Dot(down))
			local limit = math.acos(math.clamp((direction:Dot(up) * along - ELBOW_CEILING) / (k * out), -1, 1))
			angle = math.clamp(angle, -limit, limit)
			swing = down * math.cos(angle) + across * math.sin(angle)
		end
		elbow = shoulder + direction * along + swing * out
	end

	local function add(part, cframe)
		parts[#parts + 1] = part
		cframes[#cframes + 1] = cframe
	end
	-- A bone runs from its top joint at `from` down to its bottom joint at `to`, its front facing on
	-- along the view the way the avatar's arm faces forward.
	local function place(b, from, to)
		local up = from - to
		up = up.Magnitude &gt; 1e-4 and up.Unit or view.UpVector
		local right = view.LookVector:Cross(up)
		right = right.Magnitude &gt; 1e-3 and right.Unit or view.RightVector
		local rotation = CFrame.fromMatrix(Vector3.zero, right, up)
		-- Lay the bone's JOINT LINE along the bone, not the part's +Y. With an off-centre rig
		-- attachment those are different lines -- 8.7 to 10.3 degrees apart on the stock R15 upper arm --
		-- and aligning the wrong one is the other half of why the far joint hung away from the joint it
		-- was supposed to meet (#11). A centred rig has them parallel and this correction is the
		-- identity. Measured after: worst elbow gap across 62 guns and four poses, 0.327 -&gt; 0.004 studs.
		local joint = b.joint
		if joint and joint.Magnitude &gt; 1e-4 then
			local have = rotation:VectorToWorldSpace(joint).Unit
			local axis = have:Cross(up)
			if axis.Magnitude &gt; 1e-4 then
				rotation = CFrame.fromAxisAngle(axis.Unit, math.acos(math.clamp(have:Dot(up), -1, 1))) * rotation
			end
		end
		add(b.part, rotation + (from - rotation:VectorToWorldSpace(b.top)))
	end
	place(arm.upper, shoulder, elbow)
	place(arm.lower, elbow, wrist)
	if arm.hand then
		add(arm.hand, handFrame)
	end
	if arm.fingers then
		-- The knuckles sit ahead of the palm, clear of the front face of whatever it holds; `curl` is how
		-- far this anchor closes the hand, and `cap` is how far the gun lets it -- both measured for this
		-- gun when it was built. On a thin rod the fingers close right round; on a fat handguard they lie
		-- down its front and stop.
		local palmFace = hand * CF(0, -HAND_THICKNESS / 2, 0)
		held = held or FIST
		for index, finger in ipairs(arm.fingers) do
			local shape = held[index] or FIST[index]
			if shape.cap &lt; FINGER_MIN_CLOSE and shape.blocker then
				-- This finger has no room here even lying open: it would be inside the gun. It is parked
				-- inside the palm.
				local inside = palmFace * CF(finger.across, HAND_THICKNESS / 2, 0)
				add(finger[1], inside)
				add(finger[2], inside)
			else
				-- It closes as far as the gun lets it -- and a finger with no room to close but room to lie
				-- open lies along the gun, as a trigger finger lies along the guard or a hand lies flat on
				-- a body too broad to wrap. It used to be parked inside the palm too, because an open finger
				-- could reach across the sight picture; the close is now tested against the sight line
				-- (SIGHT_CLEAR) as it is against the gun, and that let 26 of 62 trigger hands show no
				-- finger at all -- a slab laid on the grip (#92).
				local close = math.min(curl, shape.cap) * finger.lean
				local upper, lower = fingerAt(palmFace * CF(finger.across, 0, -shape.knuckle), close, shape.turn)
				add(finger[1], upper)
				add(finger[2], lower)
			end
		end
	end
end

Viewmodel.Arms = Arms

--------------------------------------------------------------------------------
-- Templates
--------------------------------------------------------------------------------

-- Building a gun runs its z-fight pass, which is the slow part; a viewmodel clones a cached template.
-- The cache holds the last TEMPLATE_CACHE guns used, by id and skin: a long session with many skins would
-- otherwise keep a full model of every one of them. Evicting only costs the next draw of that gun its
-- build; the hotbar's own guns are drawn often enough to stay in.
local TEMPLATE_CACHE = 6
local templates = {}
local templateOrder = {}
local templateEvictions = 0

local function templateFor(def, color, material, skinned)
	local key = def.id .. (skinned and ("|" .. tostring(color) .. "|" .. tostring(material)) or "")
	local template = templates[key]
	if template then
		local at = table.find(templateOrder, key)
		if at then
			table.remove(templateOrder, at)
		end
	else
		template = GunModels.Build(def, color, material, { skinned = skinned })
		templates[key] = template
	end
	table.insert(templateOrder, key)
	while #templateOrder &gt; TEMPLATE_CACHE do
		local oldest = table.remove(templateOrder, 1)
		local evicted = templates[oldest]
		templates[oldest] = nil
		if evicted then
			evicted:Destroy()
		end
		templateEvictions += 1
		if templateEvictions == 1 then
			print(string.format("[Viewmodel] gun template cache full at %d; dropping the least recently drawn (%s)",
				TEMPLATE_CACHE, oldest))
		end
	end
	return template
end

-- Builds a gun's template ahead of time (when it's picked up) so drawing it never hitches.
function Viewmodel.Preload(def, color, material, skinned)
	templateFor(def, color, material, skinned)
end

-- The optic a gun's model carries ("iron", "reddot", "holo" or "scope"), read from a template already
-- built for it (any skin), or nil before one has been. Never builds one.
function Viewmodel.OpticOf(def)
	local template = templates[def.id]
	if not template then
		local prefix = def.id .. "|"
		for key, candidate in pairs(templates) do
			if string.sub(key, 1, #prefix) == prefix then
				template = candidate
				break
			end
		end
	end
	return template and template:GetAttribute("Optic") or nil
end

--------------------------------------------------------------------------------
-- Hold classes
--------------------------------------------------------------------------------

-- Where the right hand sits at the hip, in view space, and how the gun is angled there.
local HOLD = {
	handgun = { hip = V(0.46, -0.66, -1.55), yaw = -4, pitch = 2, sprint = { V(-0.1, -0.5, 0.25), V(-45, 20, 12) } },
	rifle = { hip = V(0.5, -0.74, -0.98), yaw = -3, pitch = 1, sprint = { V(-0.18, -0.22, 0.12), V(-24, 38, 22) } },
	heavy = { hip = V(0.46, -0.86, -0.92), yaw = -4, pitch = 2, sprint = { V(-0.15, -0.18, 0.12), V(-18, 30, 16) } },
	shoulder = { hip = V(0.52, -0.58, -0.42), yaw = -2, pitch = 0, sprint = { V(-0.1, -0.25, 0.1), V(-18, 25, 12) } },
}
local HIP_SIGHT_CLEARANCE = 0.6

local CLASS = {
	pistol = "handgun", revolver = "handgun",
	lmg = "heavy", minigun = "heavy",
	launcher = "shoulder",
}

-- How hard each hold class kicks: back (studs), up (degrees), roll jitter (degrees).
local KICK = {
	handgun = { 0.1, 7, 3 },
	rifle = { 0.07, 3.2, 1.6 },
	heavy = { 0.05, 2.2, 1.2 },
	shoulder = { 0.16, 6, 2 },
}

-- Fingers per anchor: how far each hand closes on what it holds.
local CURL = {
	GripHand = 0.92, SupportHand = 0.78, MagHand = 0.7, ChargeHand = 0.55, BoltHand = 0.62,
	CoverHand = 0.25, Load = 0.5, Pocket = 0.62, Slap = 0.05,
}

-- What each gun has under each hand, for the fingers to close on: the same for every skin of a gun, and
-- walking the parts to find it costs more than it is worth to repeat, so it is measured once per gun.
local gripCache = {}

-- Which moving group a keypoint rides with, when the model doesn't say.
local KEY_GROUPS = {
	ChargeHand = { "charge", "slide", "bolt", "pump" },
	BoltHand = { "bolt" },
	CoverHand = { "cover" },
}

--------------------------------------------------------------------------------
-- Construction
--------------------------------------------------------------------------------

function Viewmodel.new(def, options)
	options = options or {}
	local self = setmetatable({}, Viewmodel)
	self.def = def
	self.onEvent = options.onEvent

	local template = templateFor(def, options.color, options.material, options.skinned)
	local model = template:Clone()
	model.Name = "BRR_Viewmodel"
	self.model = model

	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("WeldConstraint") or descendant:IsA("Weld") then
			descendant:Destroy()
		end
	end
	local pivot = model:GetPivot()
	self.parts, self.offsets, self.groupOf, self.groupParts = {}, {}, {}, {}
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			localOnly(part)
			if part.Name == "AimPoint" then
				part.Transparency = 1
			end
			local group = part:GetAttribute("Anim")
			-- Parts hidden in the world model (the crossbow's resting string) are shown and hidden here by
			-- LocalTransparencyModifier instead.
			if group == "stringRest" then
				part.Transparency = 0
			end
			table.insert(self.parts, part)
			self.offsets[part] = pivot:ToObjectSpace(part.CFrame)
			if group then
				self.groupOf[part] = group
				self.groupParts[group] = self.groupParts[group] or {}
				table.insert(self.groupParts[group], part)
			end
		end
	end

	-- The contract.
	self.keys, self.pivots, self.travel, self.swing = {}, {}, {}, {}
	for name, value in pairs(model:GetAttributes()) do
		local key = string.match(name, "^KP_(.+)$")
		if key then
			self.keys[key] = value
		end
		local pivotGroup = string.match(name, "^Pivot_(.+)$")
		if pivotGroup then
			self.pivots[pivotGroup] = value
		end
		local travelGroup = string.match(name, "^Travel_(.+)$")
		if travelGroup then
			self.travel[travelGroup] = value
		end
		local swingGroup = string.match(name, "^Swing_(.+)$")
		if swingGroup then
			self.swing[swingGroup] = value
		end
	end
	self.parents = {}
	for group in pairs(self.groupParts) do
		self.parents[group] = model:GetAttribute("Parent_" .. group)
	end
	for group in pairs(self.pivots) do
		self.parents[group] = self.parents[group] or model:GetAttribute("Parent_" .. group)
	end

	self.action = model:GetAttribute("Action") or "ar"
	self.optic = model:GetAttribute("Optic") or "iron"
	self.eyeRelief = model:GetAttribute("EyeRelief") or 0.6
	self.flash = model:GetAttribute("Flash") or "rifle"
	self.casing = model:GetAttribute("Casing") or "rifle"
	-- The gun's signature handling (see Flair below); nil for a gun without one.
	self.flair = model:GetAttribute("Flair")
	self.keyGroups = {
		SupportHand = model:GetAttribute("SupportGroup"),
		Load = model:GetAttribute("LoadGroup"),
		GripHand = model:GetAttribute("GripGroup"),
	}
	for key, candidates in pairs(KEY_GROUPS) do
		for _, group in ipairs(candidates) do
			if not self.keyGroups[key] and (self.groupParts[group] or self.pivots[group]) then
				self.keyGroups[key] = group
			end
		end
	end
	self.scoped = self.optic == "scope"
	-- The RPG rides on the shoulder; the six-shot grenade launcher is shouldered like a rifle.
	local class = CLASS[def.style] or "rifle"
	if class == "shoulder" and self.action ~= "rocket" then
		class = "rifle"
	end
	self.hold = HOLD[class]
	self.kick = KICK[class]
	self.gripPoint = self.keys.GripHand and self.keys.GripHand.Position or V(0, -0.2, 0.2)
	-- At the hip the sight stays at least HIP_SIGHT_CLEARANCE ahead of the eye: a bullpup's action and
	-- its scope sit well behind the grip, and at the class's usual hip spot the scope filled a quarter
	-- of the screen from a hand's breadth away.
	local sightBehindGrip = (self.keys.Sight and self.keys.Sight.Position.Z or self.gripPoint.Z) - self.gripPoint.Z
	local hip = self.hold.hip
	self.hipPosition = V(hip.X, hip.Y, math.min(hip.Z, -HIP_SIGHT_CLEARANCE - sightBehindGrip))
	-- What the eye lines up on while aiming: the red dot, or else the foremost front sight or bead top.
	-- At full aim, the draw, sprint, bob and sway turn about this point instead of the grip, so it holds on
	-- the target while the rest of the gun moves around it.
	-- Only a dot or a top that is actually on the sight line, ahead of the eye, counts: a pistol's tritium
	-- dots are named SightDot too (the rear pair 7 mm out to the sides, the front one under the post's
	-- top), the cannon's bead stands on a blade named FrontSight, and a scoped rifle keeps iron sights
	-- well under its scope's line. Anything else would put the aimed pivot off the line.
	local sightKey = self.keys.Sight or CFrame.identity
	local mm = GunModels.StudsPerMillimetre
	local function onLine(point, tolerance)
		local p = sightKey:PointToObjectSpace(point)
		return p.Z &lt; 0 and math.sqrt(p.X * p.X + p.Y * p.Y) &lt;= tolerance * mm
	end
	local front, dot
	for part, offset in pairs(self.offsets) do
		if part.Name == "SightDot" then
			if onLine(offset.Position, 0.6) then
				dot = offset.Position
			end
		elseif part.Name == "FrontSight" or part.Name == "FrontBead" then
			local top = (offset * CF(0, part.Size.Y / 2, 0)).Position
			if onLine(top, 1.5) and (not front or top.Z &lt; front.Z) then
				front = top
			end
		end
	end
	self.aimPivot = dot or front or (sightKey * CF(0, 0, -1)).Position
	-- The eye, in the gun's space, when fully aimed. The kick and the working of the action turn about it
	-- at full aim, so the front and rear sights stay in line with each other and with the eye.
	self.eyePoint = ((self.keys.Sight or CF(0, 0.2, 0.2)) * CF(0, 0, self.eyeRelief)).Position
	self.laserEmitter = model:FindFirstChild("LaserEmitter")

	-- What the fingers close on at each anchor this gun has. Where the hand is on nothing (a pocket, a hand
	-- slapped flat on a magazine) the shape says so (`onNothing`) and the fingers close on themselves, kept
	-- out of the sight picture like any other.
	local shapes = gripCache[def.id]
	if not shapes then
		shapes = {}
		for name in pairs(CURL) do
			if self.keys[name] then
				local sight = self.keys.Sight and { frame = self.keys.Sight, relief = self.eyeRelief }
				shapes[name] = gripShape(self.offsets, self.keys[name], sight)
			end
		end
		gripCache[def.id] = shapes
	end
	self.gripShapes = shapes

	-- The player's own arms (their avatar, when there is one), in a model of their own under the gun.
	self.character = options.character
	self.arms = Arms.new(model, options.character)
	local lookOk, look = pcall(Arms.LookOf, options.character)
	self.armsLook = lookOk and look or ""
	self.lookCheckAt = 0

	-- Animation state.
	self.now = 0
	self.values = {}
	self.aim, self.sprint = 0, 0
	self.bob, self.swayX, self.swayY, self.roll, self.airPitch = 0, 0, 0, 0, 0
	self.kickPos, self.kickVel = V(), V()
	self.kickRot, self.kickRotVel = V(), V()
	self.drumAngle, self.drumTarget = 0, 0
	self.spin, self.spinSpeed = 0, 0
	self.slideLocked = false
	self.equipAt = -math.huge
	self.clips = {}
	self.hands = {}
	self.props = {}
	self.cocked = true
	self.roundShown = true
	self.hidden = false

	-- Night sights (Oliver, 2026-09-22: "its hard to see your gun sights in night ops event"). The
	-- iron sights are dark anodised metal, invisible against a dark sky, so in the dark they turn into
	-- glowing tritium (green posts, the dot and reticle left red but lit), and a faint light on the
	-- gun keeps its shape readable. Driven from Update by how dark the Lighting is, so it covers Night
	-- Ops and anything else that turns the lights down, and switches back when it's light.
	self.nightParts = {}
	for part in pairs(self.offsets) do
		local name = part.Name
		if name == "FrontSight" or name == "FrontBead" or name == "RearSight" or name == "RearSightRing"
			or name == "SightDot" or name == "SightReticle" then
			table.insert(self.nightParts, { part = part, color = part.Color, material = part.Material })
		end
	end
	local anchorPart = (self.keys.Sight and model:FindFirstChild("Sight", true)) or model.PrimaryPart
		or model:FindFirstChildWhichIsA("BasePart", true)
	if anchorPart then
		local glow = Instance.new("PointLight")
		glow.Name = "NightSightGlow"
		glow.Color = Color3.fromRGB(170, 200, 255)
		glow.Brightness = 0.7
		glow.Range = 3
		glow.Shadows = false
		glow.Enabled = false
		glow.Parent = anchorPart
		self.nightGlow = glow
	end
	self.night = false
	self.nightCheckAt = 0

	self.model.Parent = nil
	return self
end

local NIGHT_TRITIUM = Color3.fromRGB(90, 255, 130)
local Lighting = game:GetService("Lighting")

function Viewmodel:updateNightSights()
	local clock = Lighting.ClockTime
	local dark = clock &lt; 5.5 or clock &gt; 18.5 or Lighting.Brightness &lt; 0.6
	if dark == self.night then
		return
	end
	self.night = dark
	for _, entry in ipairs(self.nightParts) do
		local part = entry.part
		if dark then
			part.Material = Enum.Material.Neon
			if part.Name ~= "SightDot" and part.Name ~= "SightReticle" then
				part.Color = NIGHT_TRITIUM
			end
		else
			part.Material = entry.material
			part.Color = entry.color
		end
	end
	if self.nightGlow then
		self.nightGlow.Enabled = dark
	end
end

function Viewmodel:Destroy()
	for _, prop in pairs(self.props) do
		prop.model:Destroy()
	end
	self.model:Destroy()
end

local function emit(self, ...)
	if self.onEvent then
		self.onEvent(...)
	end
end

--------------------------------------------------------------------------------
-- Clips
--
-- A clip is a table of keyframe tracks laid over normalised time 0..1 and played over `duration`
-- seconds. Tracks:
--   gun     { t, position (studs), rotation (degrees) } around the grip
--   left    { t, anchor, offset (studs, gun space) }   and   right, for the right hand
--   values  { name = { { t, value }, ... } }          groups (slide, bolt, pump, hinge...) and holds
--   events  { t, kind, ... }                           sounds, drops, ejected cases, visibility
-- Values ease between keyframes; a pair of keys close together is a snap.
--------------------------------------------------------------------------------

local function key(t, a, b, c)
	return { t, a, b, c }
end

-- The magazine change every box-magazine gun shares, tuned by action. `tactical` keeps the old magazine
-- in hand to stow it; an empty gun drops it and works the charging handle after.
local function magazineClip(self, empty, style)
	local roll = style == "pistol" and -18 or 22
	local gun = {
		key(0, V(), V()),
		key(0.1, V(-0.04, 0.05, 0.03), V(10, style == "pistol" and 16 or -10, roll)),
		key(0.6, V(-0.04, 0.04, 0.03), V(12, style == "pistol" and 18 or -8, roll)),
		key(0.68, V(-0.03, 0.02, 0.02), V(4, style == "pistol" and 12 or -6, roll * 0.8)),
		key(0.74, V(-0.03, 0.05, 0.02), V(8, style == "pistol" and 12 or -6, roll * 0.8)),
	}
	local left = {
		key(0, "SupportHand"),
		key(0.12, "MagHand"),
		key(0.2, "MagHand", V(0, -0.34, 0.03)),
		key(0.32, "Pocket"),
		key(0.46, "Pocket"),
		key(0.56, "MagHand", V(0, -0.32, 0.03)),
		key(0.64, "MagHand"),
		key(0.68, "MagHand", V(0, 0.03, 0)),
		key(0.72, "MagHand", V(0, -0.02, 0)),
	}
	local values = {
		magHold = { key(0, 0), key(0.14, 0), key(0.16, 1), key(0.64, 1), key(0.66, 0) },
		magVisible = { key(0, 1) },
	}
	local events = {
		key(0.16, "sound", "MagOut"),
		key(0.67, "sound", "MagIn"),
	}
	if style == "pistol" then
		-- The thumb drops the magazine free; the left hand fetches the new one.
		left[2] = key(0.12, "SupportHand", V(-0.12, -0.2, 0.1))
		left[3] = key(0.2, "Pocket")
		values.magHold = { key(0, 0), key(0.4, 0), key(0.42, 1), key(0.64, 1), key(0.66, 0) }
		values.magSlide = { key(0, 0), key(0.1, 0), key(0.18, 0.4), key(0.2, 0.4), key(0.21, 0) }
		values.magVisible = { key(0, 1), key(0.2, 1), key(0.21, 0), key(0.4, 0), key(0.41, 1) }
		table.insert(events, key(0.2, "drop", "mag"))
		events[1] = key(0.1, "sound", "MagOut")
	elseif empty then
		values.magHold = { key(0, 0), key(0.14, 0), key(0.16, 1), key(0.24, 1), key(0.25, 0), key(0.42, 0), key(0.44, 1), key(0.64, 1), key(0.66, 0) }
		values.magVisible = { key(0, 1), key(0.25, 1), key(0.26, 0), key(0.42, 0), key(0.43, 1) }
		table.insert(events, key(0.25, "drop", "mag"))
	end

	local finish = 0.82
	if empty then
		if style == "pistol" then
			-- Overhand: the left hand grips the slide and snaps it forward off the stop.
			table.insert(left, key(0.8, "ChargeHand"))
			table.insert(left, key(0.86, "ChargeHand"))
			values.slide = { key(0, 1), key(0.84, 1), key(0.86, 1.06), key(0.89, 0) }
			table.insert(events, key(0.88, "sound", "SlideRelease"))
		else
			local group = self.groupParts.charge and "charge" or (self.groupParts.bolt and "bolt" or nil)
			table.insert(left, key(0.8, "ChargeHand"))
			table.insert(left, key(0.88, "ChargeHand"))
			if group then
				values[group] = { key(0, 0), key(0.8, 0), key(0.87, 1), key(0.89, 0) }
				if group == "charge" and self.groupParts.bolt then
					values.bolt = { key(0, 0), key(0.8, 0), key(0.87, 1), key(0.89, 0) }
				end
			end
			table.insert(events, key(0.85, "sound", "ChargeBack"))
			table.insert(events, key(0.89, "sound", "ChargeRelease"))
			table.insert(gun, key(0.84, V(-0.05, 0.02, 0.02), V(4, -16, 12)))
		end
		finish = 0.95
	end
	table.insert(left, key(finish, "SupportHand"))
	table.insert(gun, key(finish, V(), V()))
	table.insert(gun, key(1, V(), V()))
	table.insert(left, key(1, "SupportHand"))
	return { gun = gun, left = left, values = values, events = events }
end

-- Feeding rounds one at a time through a loading port: a pump gun, a lever gun, a grenade cylinder.
-- `rounds` is how many the clip shows going in (capped, so a long reload still reads).
local function feedClip(self, rounds, roll, prop, finishWith)
	local gun = { key(0, V(), V()), key(0.08, V(-0.05, 0.04, 0.02), V(6, -12, roll)) }
	local left = { key(0, "SupportHand"), key(0.08, "Pocket") }
	local values = { propHold = { key(0, 0) } }
	local events = {}
	local span = 0.68 / math.max(1, rounds)
	for index = 0, rounds - 1 do
		local s = 0.1 + index * span
		table.insert(left, key(s, "Pocket"))
		table.insert(left, key(s + span * 0.45, "Load", V(0, -0.12, 0.1)))
		table.insert(left, key(s + span * 0.72, "Load"))
		table.insert(values.propHold, key(s, 0))
		table.insert(values.propHold, key(s + 0.01, 1))
		table.insert(values.propHold, key(s + span * 0.74, 1))
		table.insert(values.propHold, key(s + span * 0.76, 0))
		table.insert(events, key(s + span * 0.74, "sound", "ShellIn"))
	end
	table.insert(gun, key(0.8, V(-0.05, 0.04, 0.02), V(6, -12, roll)))
	table.insert(left, key(0.84, "SupportHand"))
	table.insert(gun, key(0.86, V(), V()))
	local clip = { gun = gun, left = left, values = values, events = events, prop = prop }
	if finishWith then
		finishWith(clip)
	end
	table.insert(gun, key(1, V(), V()))
	table.insert(left, key(1, "SupportHand"))
	return clip
end

local function rackPump(clip, from)
	clip.values.pump = { key(0, 0), key(from, 0), key(from + 0.05, 1), key(from + 0.1, 0) }
	table.insert(clip.events, key(from + 0.05, "sound", "PumpBack"))
	table.insert(clip.events, key(from + 0.05, "eject"))
	table.insert(clip.events, key(from + 0.1, "sound", "PumpForward"))
end

local function reloadClip(self, empty, missing)
	local action = self.action
	if action == "pistol" then
		return magazineClip(self, empty, "pistol")
	elseif action == "revolver" then
		return {
			gun = {
				key(0, V(), V()), key(0.08, V(-0.1, 0.05, 0), V(-5, 20, -58)),
				key(0.26, V(-0.08, 0.1, 0.05), V(52, 10, -30)), key(0.4, V(-0.1, 0.02, 0.02), V(-38, 10, -30)),
				key(0.74, V(-0.1, 0.02, 0.02), V(-20, 10, -45)), key(0.84, V(), V(4, 0, -6)), key(1, V(), V()),
			},
			left = {
				key(0, "SupportHand"), key(0.1, "MagHand"), key(0.3, "MagHand", V(0.02, 0.05, 0)), key(0.4, "Pocket"),
				key(0.5, "Pocket"), key(0.62, "Load", V(0, 0, 0.12)), key(0.67, "Load"), key(0.72, "MagHand"), key(0.9, "SupportHand"),
				key(1, "SupportHand"),
			},
			values = {
				crane = { key(0, 0), key(0.12, 0), key(0.2, 1), key(0.74, 1), key(0.8, 0) },
				propHold = { key(0, 0), key(0.46, 0), key(0.47, 1), key(0.67, 1), key(0.68, 0) },
			},
			events = {
				key(0.16, "sound", "CylinderOpen"), key(0.3, "casings", 6), key(0.66, "sound", "ShellIn"), key(0.8, "sound", "CylinderClose"),
			},
			prop = "speedloader",
		}
	elseif action == "pump" then
		return feedClip(self, math.clamp(missing, 1, 4), 30, "shell", function(clip)
			if empty then
				rackPump(clip, 0.86)
			end
		end)
	elseif action == "lever" then
		return feedClip(self, math.clamp(missing, 1, 4), -34, "shellBig", function(clip)
			if empty then
				clip.values.lever = { key(0, 0), key(0.86, 0), key(0.91, 1), key(0.97, 0) }
				table.insert(clip.events, key(0.9, "sound", "LeverOpen"))
				table.insert(clip.events, key(0.96, "sound", "LeverClose"))
			end
		end)
	elseif action == "break" then
		return {
			gun = { key(0, V(), V()), key(0.1, V(0, 0.02, 0.04), V(-24, 0, 12)), key(0.7, V(0, 0.02, 0.04), V(-20, 0, 10)), key(0.78, V(), V(6, 0, 0)), key(1, V(), V()) },
			left = {
				key(0, "SupportHand"), key(0.2, "SupportHand", V(0, -0.05, 0)), key(0.26, "Pocket"), key(0.4, "Pocket"),
				key(0.52, "Load", V(0, 0.06, 0.12)), key(0.58, "Load"), key(0.66, "SupportHand"), key(1, "SupportHand"),
			},
			values = {
				hinge = { key(0, 0), key(0.1, 0), key(0.2, 1), key(0.72, 1), key(0.78, 0) },
				propHold = { key(0, 0), key(0.36, 0), key(0.37, 1), key(0.58, 1), key(0.59, 0) },
			},
			events = { key(0.15, "sound", "BreakOpen"), key(0.22, "casings", 2), key(0.58, "sound", "ShellIn"), key(0.78, "sound", "BreakClose") },
			prop = "shells",
		}
	elseif action == "bolt" then
		local clip = magazineClip(self, false, "rifle")
		clip.right = {
			key(0, "GripHand"), key(0.06, "BoltHand"), key(0.2, "BoltHand"), key(0.28, "GripHand"),
			key(0.74, "GripHand"), key(0.78, "BoltHand"), key(0.9, "BoltHand"), key(0.96, "GripHand"), key(1, "GripHand"),
		}
		clip.values.bolt = { key(0, 0), key(0.08, 1), key(0.14, 2), key(0.8, 2), key(0.85, 1), key(0.9, 0) }
		table.insert(clip.events, key(0.12, "sound", "BoltBack"))
		table.insert(clip.events, key(0.86, "sound", "BoltForward"))
		return clip
	elseif action == "belt" then
		local clip = {
			gun = { key(0, V(), V()), key(0.1, V(-0.03, 0.04, 0.02), V(6, -10, 18)), key(0.88, V(-0.03, 0.04, 0.02), V(6, -10, 18)), key(0.96, V(), V()), key(1, V(), V()) },
			left = {
				key(0, "SupportHand"), key(0.1, "CoverHand"), key(0.2, "CoverHand"), key(0.26, "MagHand"), key(0.34, "MagHand", V(-0.08, -0.36, 0.04)),
				key(0.42, "Pocket"), key(0.52, "Pocket"), key(0.62, "MagHand", V(-0.08, -0.32, 0.02)), key(0.7, "MagHand"),
				key(0.76, "CoverHand", V(0, 0.02, -0.12)), key(0.84, "CoverHand"), key(0.94, "SupportHand"), key(1, "SupportHand"),
			},
			values = {
				cover = { key(0, 0), key(0.12, 0), key(0.2, 1), key(0.8, 1), key(0.86, 0) },
				magHold = { key(0, 0), key(0.27, 0), key(0.28, 1), key(0.35, 1), key(0.36, 0), key(0.5, 0), key(0.51, 1), key(0.7, 1), key(0.71, 0) },
				magVisible = { key(0, 1), key(0.36, 1), key(0.37, 0), key(0.5, 0), key(0.51, 1) },
			},
			events = {
				key(0.16, "sound", "CoverOpen"), key(0.3, "sound", "MagOut"), key(0.36, "drop", "mag"), key(0.7, "sound", "MagIn"), key(0.86, "sound", "CoverClose"),
			},
		}
		if empty then
			clip.values.charge = { key(0, 0), key(0.88, 0), key(0.93, 1), key(0.95, 0) }
			table.insert(clip.events, key(0.93, "sound", "ChargeBack"))
		end
		return clip
	elseif action == "rotary" then
		return {
			gun = { key(0, V(), V()), key(0.12, V(-0.02, 0.03, 0.02), V(4, -6, 12)), key(0.85, V(-0.02, 0.03, 0.02), V(4, -6, 12)), key(1, V(), V()) },
			left = {
				key(0, "SupportHand"), key(0.15, "MagHand"), key(0.28, "MagHand", V(0, -0.34, 0.08)), key(0.4, "Pocket"), key(0.5, "Pocket"),
				key(0.68, "MagHand", V(0, -0.3, 0.08)), key(0.78, "MagHand"), key(0.95, "SupportHand"), key(1, "SupportHand"),
			},
			values = {
				magHold = { key(0, 0), key(0.17, 0), key(0.18, 1), key(0.29, 1), key(0.3, 0), key(0.46, 0), key(0.47, 1), key(0.78, 1), key(0.8, 0) },
				magVisible = { key(0, 1), key(0.3, 1), key(0.31, 0), key(0.46, 0), key(0.47, 1) },
			},
			events = { key(0.2, "sound", "MagOut"), key(0.3, "drop", "mag"), key(0.8, "sound", "MagIn") },
		}
	elseif action == "rocket" then
		return {
			gun = { key(0, V(), V()), key(0.12, V(0.02, 0.02, 0.06), V(-8, 22, 10)), key(0.78, V(0.02, 0.02, 0.06), V(-8, 22, 10)), key(1, V(), V()) },
			left = {
				key(0, "SupportHand"), key(0.14, "Pocket"), key(0.3, "Pocket"), key(0.5, "Load", V(0, 0, -0.45)), key(0.72, "Load"), key(0.9, "SupportHand"), key(1, "SupportHand"),
			},
			values = {
				roundHold = { key(0, 0), key(0.22, 0), key(0.23, 1), key(0.72, 1), key(0.74, 0) },
				roundVisible = { key(0, 0), key(0.22, 0), key(0.23, 1) },
			},
			events = { key(0.72, "sound", "RocketSeat") },
		}
	elseif action == "grenade" then
		local clip = feedClip(self, 3, -28, "grenade", nil)
		clip.values.crane = { key(0, 0), key(0.06, 0), key(0.1, 1), key(0.78, 1), key(0.84, 0) }
		clip.values.roundsVisible = { key(0, 1), key(0.1, 1), key(0.11, 0), key(0.76, 0), key(0.77, 1) }
		clip.values.drum = { key(0, 0), key(0.84, 0), key(0.94, 1) }
		table.insert(clip.events, key(0.08, "sound", "CylinderOpen"))
		table.insert(clip.events, key(0.12, "casings", 6))
		table.insert(clip.events, key(0.84, "sound", "CylinderClose"))
		return clip
	elseif action == "crossbow" then
		return {
			gun = { key(0, V(), V()), key(0.12, V(0, 0.02, 0.1), V(-30, 0, 8)), key(0.4, V(0, 0.02, 0.06), V(-24, 0, 8)), key(0.5, V(), V(-6, 6, 10)), key(0.9, V(), V(-6, 6, 10)), key(1, V(), V()) },
			left = {
				key(0, "SupportHand"), key(0.14, "ChargeHand", V(0, 0.02, -1.2)), key(0.34, "ChargeHand"), key(0.46, "Pocket"), key(0.56, "Pocket"),
				key(0.72, "Load", V(0, 0.02, -0.3)), key(0.84, "Load"), key(0.95, "SupportHand"), key(1, "SupportHand"),
			},
			values = {
				cocked = { key(0, 0), key(0.35, 0), key(0.36, 1) },
				roundHold = { key(0, 0), key(0.52, 0), key(0.53, 1), key(0.84, 1), key(0.85, 0) },
				roundVisible = { key(0, 0), key(0.52, 0), key(0.53, 1) },
			},
			events = { key(0.36, "sound", "StringCock"), key(0.84, "sound", "BoltSeat") },
		}
	elseif action == "blaster" then
		local clip = magazineClip(self, false, "rifle")
		for index, entry in ipairs(clip.left) do
			if entry[1] &gt;= 0.72 then
				clip.left[index] = key(entry[1], "SupportHand")
			end
		end
		clip.values.pump = { key(0, 0), key(0.74, 0), key(0.8, 1), key(0.86, 0), key(0.92, 1), key(0.98, 0) }
		table.insert(clip.events, key(0.8, "sound", "PumpBack"))
		table.insert(clip.events, key(0.92, "sound", "PumpBack"))
		return clip
	elseif action == "energy" then
		local clip = magazineClip(self, false, "rifle")
		table.insert(clip.left, key(0.8, "ChargeHand"))
		clip.values.charge = { key(0, 0), key(0.8, 0), key(0.86, 1), key(0.9, 0) }
		clip.values.glow = { key(0, 1), key(0.12, 0.1), key(0.86, 0.1), key(0.98, 1.6), key(1, 1) }
		table.insert(clip.events, key(0.87, "sound", "EnergyCharge"))
		table.sort(clip.left, function(a, b)
			return a[1] &lt; b[1]
		end)
		return clip
	end
	-- ar, ak, smg, semi: the box magazine swap.
	return magazineClip(self, empty, action)
end

-- Racking on the draw, by mechanism.
local function rackClip(self)
	local action = self.action
	if action == "pistol" then
		return {
			left = { key(0, "SupportHand"), key(0.25, "ChargeHand"), key(0.7, "ChargeHand"), key(1, "SupportHand") },
			values = { slide = { key(0, 0), key(0.35, 0), key(0.5, 1), key(0.58, 0) } },
			events = { key(0.5, "sound", "ChargeBack"), key(0.58, "sound", "SlideRelease") },
			gun = { key(0, V(), V()), key(0.3, V(0, 0, 0.02), V(6, 10, -10)), key(0.7, V(), V(2, 4, -4)), key(1, V(), V()) },
		}
	elseif action == "pump" or action == "blaster" then
		return { values = { pump = { key(0, 0), key(0.2, 0), key(0.45, 1), key(0.7, 0) } }, events = { key(0.45, "sound", "PumpBack"), key(0.7, "sound", "PumpForward") } }
	elseif action == "bolt" then
		return {
			right = { key(0, "GripHand"), key(0.15, "BoltHand"), key(0.85, "BoltHand"), key(1, "GripHand") },
			values = { bolt = { key(0, 0), key(0.2, 0), key(0.35, 1), key(0.5, 2), key(0.65, 1), key(0.8, 0) } },
			events = { key(0.45, "sound", "BoltBack"), key(0.7, "sound", "BoltForward") },
		}
	elseif action == "lever" then
		return { values = { lever = { key(0, 0), key(0.2, 0), key(0.5, 1), key(0.85, 0) } }, events = { key(0.45, "sound", "LeverOpen"), key(0.85, "sound", "LeverClose") } }
	elseif action == "revolver" then
		return { values = { hammer = { key(0, 0), key(0.4, 0), key(0.7, 1), key(0.8, 0) } }, events = { key(0.7, "sound", "HammerCock") } }
	elseif action == "break" then
		return { values = { hinge = { key(0, 0), key(0.2, 0), key(0.45, 0.6), key(0.7, 0) } }, events = { key(0.25, "sound", "BreakOpen"), key(0.7, "sound", "BreakClose") } }
	elseif action == "rocket" or action == "grenade" or action == "crossbow" or action == "rotary" then
		return nil
	end
	local group = self.groupParts.charge and "charge" or (self.groupParts.bolt and "bolt" or nil)
	if not group then
		return nil
	end
	local values = { [group] = { key(0, 0), key(0.35, 0), key(0.55, 1), key(0.62, 0) } }
	if group == "charge" and self.groupParts.bolt then
		values.bolt = { key(0, 0), key(0.35, 0), key(0.55, 1), key(0.62, 0) }
	end
	return {
		left = { key(0, "SupportHand"), key(0.25, "ChargeHand"), key(0.75, "ChargeHand"), key(1, "SupportHand") },
		values = values,
		events = { key(0.52, "sound", "ChargeBack"), key(0.62, "sound", "ChargeRelease") },
		gun = { key(0, V(), V()), key(0.3, V(-0.03, 0.02, 0.02), V(4, -14, 12)), key(0.75, V(-0.03, 0.02, 0.02), V(4, -14, 12)), key(1, V(), V()) },
	}
end

-- What the mechanism does between shots.
local function fireClip(self, roundsLeft)
	local action = self.action
	local interval = 1 / math.max(self.def.fireRate or 1, 0.1)
	if action == "pump" then
		return {
			duration = math.min(0.55, interval * 0.9),
			values = { pump = { key(0, 0), key(0.2, 0), key(0.5, 1), key(0.85, 0) } },
			events = { key(0.5, "sound", "PumpBack"), key(0.52, "eject"), key(0.85, "sound", "PumpForward") },
			gun = { key(0, V(), V()), key(0.45, V(0, -0.02, 0.03), V(-3, 2, 4)), key(1, V(), V()) },
		}
	elseif action == "bolt" then
		return {
			duration = math.min(0.75, interval * 0.9),
			right = { key(0, "GripHand"), key(0.14, "BoltHand"), key(0.82, "BoltHand"), key(1, "GripHand") },
			values = { bolt = { key(0, 0), key(0.18, 0), key(0.3, 1), key(0.46, 2), key(0.62, 1), key(0.76, 0) } },
			events = { key(0.44, "sound", "BoltBack"), key(0.46, "eject"), key(0.66, "sound", "BoltForward") },
			gun = { key(0, V(), V()), key(0.4, V(0.02, 0, 0.02), V(-2, 4, 8)), key(1, V(), V()) },
		}
	elseif action == "lever" then
		return {
			duration = math.min(0.5, interval * 0.9),
			values = { lever = { key(0, 0), key(0.12, 0), key(0.45, 1), key(0.8, 0) }, hammer = { key(0, 1), key(0.45, 1), key(0.5, 0) } },
			events = { key(0.4, "sound", "LeverOpen"), key(0.46, "eject"), key(0.8, "sound", "LeverClose") },
			gun = { key(0, V(), V()), key(0.45, V(0, 0.02, 0), V(-6, 0, 0)), key(1, V(), V()) },
		}
	elseif action == "pistol" then
		local locked = roundsLeft &lt;= 0
		return {
			duration = 0.09,
			values = { slide = locked and { key(0, 0), key(0.35, 1), key(1, 1) } or { key(0, 0), key(0.35, 1), key(1, 0) } },
			events = { key(0.3, "eject") },
		}
	elseif action == "revolver" then
		self.drumTarget += math.pi / 3
		return { duration = 0.12, values = { hammer = { key(0, 1), key(0.25, 0), key(1, 0) } } }
	elseif action == "grenade" then
		self.drumTarget += math.pi / 3
		return { duration = 0.25, values = {} }
	elseif action == "ar" or action == "ak" or action == "smg" or action == "semi" or action == "belt" then
		return { duration = math.min(0.07, interval * 0.8), values = { bolt = { key(0, 0), key(0.4, 1), key(1, 0) } }, events = { key(0.35, "eject") } }
	end
	return nil
end

--------------------------------------------------------------------------------
-- Flair: a gun's signature handling (the gun rework, 2026-09-24)
--
-- The model's `Flair` attribute (GunModelsSignature) names how this gun is shown off and handled beyond
-- what its mechanism does: its inspect, a flourish as it is drawn, and a flourish as a reload finishes.
-- A gun without the attribute animates exactly as before -- every hook below hands back the stock clip
-- untouched when there is no flair.
--
-- Every flair moves the gun about the grip with the hands still on their keypoints, as the stock inspect
-- does, so the arms follow; tools/gunfun_flair_check.py poses every flair gun through its inspect, its draw
-- and the end of its reload on three rigs and holds the wrist (85 degrees), the joints and the bone lengths
-- to the same limits fps_arms_check does. A reload flourish only uses the clip's last stretch (after
-- FLAIR_RELOAD_FROM) and is skipped when the clip is still moving the gun there, so the working of the
-- mechanism itself never changes.
--------------------------------------------------------------------------------

local FLAIR_RELOAD_FROM = 0.86

-- A left hand that taps `anchor` `times` times between t0 and t1, starting and ending on the support hand.
local function taps(anchor, times, t0, t1, lift, sound)
	local left = { key(0, "SupportHand"), key(t0 - 0.08, anchor) }
	local events = {}
	local span = (t1 - t0) / times
	for index = 0, times - 1 do
		local s = t0 + index * span
		table.insert(left, key(s + span * 0.35, anchor, lift))
		table.insert(left, key(s + span * 0.7, anchor))
		table.insert(events, key(s + span * 0.7, "sound", sound))
	end
	table.insert(left, key(t1 + 0.12, "SupportHand"))
	table.insert(left, key(1, "SupportHand"))
	return left, events
end

-- A rattle: the gun rolled back and forth `times` times from t0, `step` apart, about a held pose.
local function rattle(pose, roll, times, t0, step, sound)
	local gun, events = {}, {}
	for index = 0, times - 1 do
		local s = t0 + index * step
		table.insert(gun, key(s, pose[1], pose[2] + V(0, 0, (index % 2 == 0) and roll or -roll)))
		if index % 2 == 0 and sound then
			table.insert(events, key(s, "sound", sound))
		end
	end
	return gun, events
end

local FLAIR = {}

-- Sahur Pistol: turn the slide up and drum on it, tok-tok-tok.
FLAIR.drum = {
	inspect = function()
		local left, events = taps("ChargeHand", 3, 0.24, 0.66, V(0, 0.07, 0), "FlairTap")
		return {
			duration = 2.3,
			gun = { key(0, V(), V()), key(0.16, V(-0.12, 0.1, 0.04), V(8, 30, -24)), key(0.72, V(-0.12, 0.1, 0.04), V(8, 34, -26)), key(1, V(), V()) },
			left = left,
			events = events,
		}
	end,
	draw = { duration = 0.5, gun = { key(0, V(), V()), key(0.45, V(0, 0.03, 0), V(-6, 0, -10)), key(1, V(), V()) }, events = { key(0.45, "sound", "FlairTap") } },
	reload = { gun = { key(0.92, V(0, 0.02, 0), V(-8, 0, 6)) }, events = { key(0.92, "sound", "FlairTap") } },
}

-- Pocket Popper: a flick up and a catch, like tossing a kernel.
FLAIR.toss = {
	inspect = function()
		return {
			duration = 2.0,
			gun = {
				key(0, V(), V()), key(0.14, V(0, -0.04, 0), V(6, 0, 0)), key(0.26, V(0, 0.14, 0.02), V(-28, 10, -16)),
				key(0.38, V(0, 0.05, 0), V(-4, 30, -24)), key(0.7, V(-0.08, 0.08, 0.02), V(6, 42, -28)), key(1, V(), V()),
			},
			events = { key(0.26, "sound", "FlairPop") },
		}
	end,
	draw = { duration = 0.45, gun = { key(0, V(), V()), key(0.4, V(0, 0.06, 0), V(-14, 0, 0)), key(1, V(), V()) }, events = { key(0.4, "sound", "FlairPop") } },
	reload = { gun = { key(0.92, V(0, 0.05, 0), V(-14, 0, 0)) }, events = { key(0.92, "sound", "FlairPop") } },
}

-- Pistacchio Pum: slap the magazine home and turn it over to read the price tag.
FLAIR.tap = {
	inspect = function()
		local left, events = taps("MagHand", 2, 0.22, 0.48, V(0, -0.08, 0.02), "FlairTap")
		return {
			duration = 2.2,
			gun = { key(0, V(), V()), key(0.16, V(-0.08, 0.08, 0.04), V(14, 20, -34)), key(0.55, V(-0.08, 0.08, 0.04), V(14, 24, -36)),
				key(0.7, V(-0.14, 0.12, 0.04), V(0, 48, -14)), key(0.88, V(-0.14, 0.12, 0.04), V(0, 52, -14)), key(1, V(), V()) },
			left = left,
			events = events,
		}
	end,
	draw = { duration = 0.45, gun = { key(0, V(), V()), key(0.5, V(0, 0.02, 0), V(0, 0, 12)), key(1, V(), V()) } },
	reload = { gun = { key(0.92, V(0, 0.02, 0), V(4, 0, -12)) }, events = { key(0.9, "sound", "FlairTap") } },
}

-- Rot SMG: shake the bugs out of it.
FLAIR.shake = {
	inspect = function()
		local pose = { V(-0.06, 0.06, 0.02), V(4, 26, -14) }
		local shakes, events = rattle(pose, 16, 6, 0.2, 0.08, "FlairRattle")
		local gun = { key(0, V(), V()), key(0.12, pose[1], pose[2]) }
		for _, entry in ipairs(shakes) do
			table.insert(gun, entry)
		end
		table.insert(gun, key(0.8, pose[1], pose[2] + V(0, 4, 0)))
		table.insert(gun, key(1, V(), V()))
		return { duration = 2.2, gun = gun, events = events }
	end,
	draw = { duration = 0.5, gun = { key(0, V(), V()), key(0.3, V(), V(0, 0, -12)), key(0.6, V(), V(0, 0, 8)), key(1, V(), V()) }, events = { key(0.3, "sound", "FlairRattle") } },
	reload = { gun = { key(0.9, V(), V(0, 0, -10)), key(0.95, V(), V(0, 0, 6)) }, events = { key(0.9, "sound", "FlairRattle") } },
}

-- Crumbly Carbine: tip it muzzle-down and knock the crumbs off.
FLAIR.crumbs = {
	inspect = function()
