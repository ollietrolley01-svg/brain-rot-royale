	},

	-- The Style Crate tiers (Oliver, 2026-09-18). Priced off the coin packs: 125 coins per Robux at the
	-- 50k pack, then about 15% better than converting, because a direct purchase should beat laundering
	-- through currency. 8,000 / 25,000 / 60,000 coins -&gt; 69 / 199 / 449 R$.
	--
	-- These are PAID RANDOM ITEMS on both routes, so the card shows the odds that are rolled, exactly,
	-- whichever way the crate was bought. Beginner's Luck never applies: CrateData.BeginnerBoosted only
	-- returns true for a brainrot crate, and widening it to a crate anyone paid for would be deceptive.
	CrateStyle = {
		id = 3714558949,
		name = "Style Crate",
		description = "One Style Crate: any cosmetic — accessory, gun skin, aura or parachute.",
		grant = { kind = "Crate", crate = "Style" },
		suggestedPrice = 69,
		order = 15,
	},
	CrateDeluxeStyle = {
		id = 3714558950,
		name = "Deluxe Style Crate",
		description = "One Deluxe Style Crate: any cosmetic, weighted to the good end.",
		grant = { kind = "Crate", crate = "DeluxeStyle" },
		suggestedPrice = 199,
		order = 16,
	},
	CratePrestigeStyle = {
		id = 3714558952,
		name = "Prestige Style Crate",
		description = "One Prestige Style Crate: no Commons at all, and the best cosmetics in the game.",
		grant = { kind = "Crate", crate = "PrestigeStyle" },
		suggestedPrice = 449,
		order = 17,
	},
	Coins10k = {
		id = 3714558954,
		name = "10,000 SahurCoins",
		description = "Instant coin top-up.",
		grant = { kind = "Coins", amount = 10000 },
		suggestedPrice = 99,
		order = 20,
	},
	Coins50k = {
		id = 3714558956,
		name = "50,000 SahurCoins",
		description = "Instant coin top-up.",
		grant = { kind = "Coins", amount = 50000 },
		suggestedPrice = 399,
		order = 21,
	},
}

-- Buying a brainrot outright. Rather than a product per brainrot (126 of them to create by hand),
-- there's one developer product per rarity, priced here. The player picks the exact brainrot in the
-- menu; the server stores that choice in their profile (PendingBrainrot) and only then opens the
-- purchase prompt, and the receipt grants exactly the stored choice (BrainrotShopService). These
-- products never show up as ordinary shop rows: they're only bought through the brainrot picker.
GamepassConfig.BrainrotPrices = {
	Secret = 2000, Mythic = 1100, Legendary = 600, Epic = 300, Rare = 150, Uncommon = 75, Common = 35,
}
-- Paste each rarity's developer product ID here (step 3 of the setup at the top of this file).
GamepassConfig.BrainrotProductIds = {
	Secret = 3714558957, Mythic = 3714558959, Legendary = 3714558960, Epic = 3714558963,
	Rare = 3714558966, Uncommon = 3714558969, Common = 3714558974,
}
for rarity, price in pairs(GamepassConfig.BrainrotPrices) do
	GamepassConfig.Products["Brainrot" .. rarity] = {
		id = GamepassConfig.BrainrotProductIds[rarity] or 0,
		name = "Brainrot: " .. rarity,
		description = "One " .. rarity .. " brainrot of your choice, straight into your collection.",
		grant = { kind = "Brainrot", rarity = rarity },
		suggestedPrice = price,
		brainrotShop = true,
		order = 30,
	}
end

-- The product that sells brainrots of `rarity`, or nil.
function GamepassConfig.BrainrotProduct(rarity)
	return GamepassConfig.Products["Brainrot" .. tostring(rarity)]
end

for key, product in pairs(GamepassConfig.Products) do
	product.key = key
end
for key, pass in pairs(GamepassConfig.Passes) do
	pass.key = key
end

-- Products with a big card at the top of the shop, in their `featured` order.
function GamepassConfig.Featured()
	local list = {}
	for _, product in pairs(GamepassConfig.Products) do
		if product.featured then
			table.insert(list, product)
		end
	end
	table.sort(list, function(a, b)
		return a.featured &lt; b.featured
	end)
	return list
end

-- One line per thing in a bundle, for the shop card: "25,000 SahurCoins", "2x Rare Crate".
function GamepassConfig.DescribeContents(grant, cosmeticName)
	local lines = {}
	for _, entry in ipairs(grant.contents or {}) do
		if entry.kind == "Coins" then
			local text = tostring(entry.amount):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
			table.insert(lines, text .. " SahurCoins")
		elseif entry.kind == "Crate" then
			table.insert(lines, string.format("%dx %s Crate", entry.amount or 1, entry.crate))
		elseif entry.kind == "Consumable" then
			-- The multiplier lives in brackets after the name, so a count never sits beside it: "5x 2x
			-- Health Boost (Pro)" read as a typo, and nothing said the boost lasts one match (#86).
			local labels = { Health = "Health Boost (1.5x max HP)", Speed = "Speed Boost", HealthPro = "Pro Health Boost (2x max HP)", SpeedPro = "Pro Speed Boost (1.5x speed)" }
			table.insert(lines, string.format("%d × one-match %s", entry.amount or 1, labels[entry.consumable] or (entry.consumable .. " Boost")))
		elseif entry.kind == "Cosmetic" then
			table.insert(lines, "EXCLUSIVE " .. (cosmeticName and cosmeticName(entry.id) or entry.id))
		end
	end
	return lines
end

-- What one match start grants: the passes' bonuses, and at most one one-match boost per stat, spent
-- only when it BEATS what the player already has. A boost never stacks on a pass (the bigger one
-- applies), so a pass owner still gets the Pro boosts from the Pro Bundle -- 2x health is more than
-- the pass's +50, 1.5x speed more than its +4 -- and keeps a regular boost that would add nothing.
-- Pure, so MatchService.applyBoosts and a check run the same rule.
--   owns       { ExtraHealth = bool, ExtraSpeed = bool }
--   stock      the profile's Consumables counts (nothing is taken off here)
-- Returns { health = bonus max HP, speed = bonus walkspeed, scale = walkspeed factor, spend = { names } }.
GamepassConfig.PassHealth = 50
GamepassConfig.PassSpeed = 4

function GamepassConfig.PlanBoosts(owns, stock, startHealth, baseSpeed)
	stock = stock or {}
	local plan = { health = 0, speed = 0, scale = 1, spend = {} }
	if owns.ExtraHealth then
		plan.health = GamepassConfig.PassHealth
	end
	if owns.ExtraSpeed then
		plan.speed = GamepassConfig.PassSpeed
	end
	-- Health: Pro (2x max health, i.e. +startHealth) first, then the regular +50.
	if (stock.HealthPro or 0) &gt; 0 and startHealth &gt; plan.health then
		plan.health = startHealth
		table.insert(plan.spend, "HealthPro")
	elseif (stock.Health or 0) &gt; 0 and GamepassConfig.PassHealth &gt; plan.health then
		plan.health = GamepassConfig.PassHealth
		table.insert(plan.spend, "Health")
	end
	-- Speed, compared as the walkspeed each would give: Pro is 1.5x base on its own, the regular +4.
	local current = baseSpeed + plan.speed
	if (stock.SpeedPro or 0) &gt; 0 and baseSpeed * 1.5 &gt; current then
		plan.speed, plan.scale = 0, 1.5
		table.insert(plan.spend, "SpeedPro")
	elseif (stock.Speed or 0) &gt; 0 and baseSpeed + GamepassConfig.PassSpeed &gt; current then
		plan.speed = GamepassConfig.PassSpeed
		table.insert(plan.spend, "Speed")
	end
	return plan
end

-- A one-match product that can never beat a pass this player owns for good (`owned` and `temp` are
-- the profile snapshot's ownedPasses and tempPasses). The shop hides it rather than sell something
-- PlanBoosts would never spend. A pass won for a day on the Daily Spin doesn't count: it runs out.
function GamepassConfig.Outclassed(product, owned, temp)
	local pass = product and product.outclassedBy
	return pass ~= nil and owned ~= nil and owned[pass] == true and not (temp and temp[pass])
end

function GamepassConfig.GetProductById(productId)
	for _, product in pairs(GamepassConfig.Products) do
		if product.id == productId then
			return product
		end
	end
	return nil
end

return GamepassConfig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">GunModels</string><ProtectedString name="Source">-- Gun models.
--
-- One builder for every gun in the game, shared by the server (the gun a character holds, what lies
-- on the floor, the podium displays) and the client (the first-person viewmodel, which is built
-- locally at full detail rather than cloned from the character's copy).
--
--   GunModels.Build(def, color, material, options) -&gt; model, receiver
--
-- options.detail   "full" (default) or "world". Every copy has the same shapes -- the gun on the
--                  floor, on a podium and in your hands is one model -- and "world" only leaves out
--                  the smallest fittings (pins, screw heads, knurling), for guns bots carry.
-- options.skinned  true when `color`/`material` come from a gun skin. Skins repaint the gun's
--                  panels; without one, rarity is carried by finish instead (see Builder:finish).
--
-- Guns are authored in MILLIMETRES at close to real proportions and scaled by MM. Real dimensions
-- are what make a part-built gun read as a gun: the old models were two and a half times real size
-- with every panel painted in the rarity colour, and at that size a rail is a slab and a grip is a
-- brick. The origin sits on the bore axis above the trigger; the gun faces -Z, +X is the right
-- (ejection) side.
--
-- The model carries its own animation contract, so nothing downstream guesses from part names:
--   attribute Anim on a part         the moving group it belongs to (slide, bolt, charge, pump, mag,
--                                    drum, spin, hinge, cover, lever, hammer, trigger, round, crane,
--                                    string, rounds)
--   model attribute KP_&lt;name&gt;        keypoints as CFrames in model space: GripHand, SupportHand,
--                                    MagHand, ChargeHand, BoltHand, Sight, Muzzle, Eject, MagWell,
--                                    Load
--   model attribute Pivot_&lt;group&gt;    where an angular group turns (about the pivot's X for hinges
--                                    and levers, its Z for drums and spinning barrels)
--   model attribute Travel_&lt;group&gt;   how far a sliding group moves back, in studs
--   model attribute Swing_&lt;group&gt;    how far an angular group turns, in degrees
--   model attributes Action, Optic, EyeRelief, Flash, Casing, WeaponId, Style, Detail
-- The old names the rest of the game relies on stay: Receiver (the PrimaryPart), Grip, AimPoint,
-- Scope on scoped guns, FrontSight/RearSight on iron-sighted ones, EjectionPort, LaserEmitter, and
-- the Muzzle attachment on the receiver.

local Shared = script.Parent
local Rarity = require(Shared:WaitForChild("Rarity"))
local ZFight = require(Shared:WaitForChild("ZFight"))
local ArsenalExpansion = require(Shared:WaitForChild("ArsenalExpansion"))
local ArsenalFinish = require(Shared:WaitForChild("ArsenalFinish"))
-- claude-3b's creative guns: Variants and Builders keyed by weapon id, built through the same Builder
-- and contract (see GunModels.Kit and Build). Optional: without the module every gun builds as before.
local creativeModule = Shared:FindFirstChild("GunModelsCreative")
local GunModelsCreative = creativeModule and require(creativeModule) or { Variants = {}, Builders = {} }
-- The workshop guns (WorkshopArsenal) build the same way, from their own module.
local workshopModule = Shared:FindFirstChild("GunModelsWorkshop")
local GunModelsWorkshop = workshopModule and require(workshopModule) or { Variants = {}, Builders = {} }
-- The older arsenal's guns rebuilt with their own designs (the gun rework, 2026-09-24): same ids, stats and
-- mechanisms, their own looks and a Flair for the viewmodel.
local signatureModule = Shared:FindFirstChild("GunModelsSignature")
local GunModelsSignature = signatureModule and require(signatureModule) or { Variants = {}, Builders = {} }

local GunModels = {}

local V = Vector3.new
local CF = CFrame.new
local rad = math.rad

local MM = 0.0038
GunModels.StudsPerMillimetre = MM

-- Everything a gun is built from sits at least this far off any face it would otherwise lie flush
-- with. The z-fight pass runs on guns with a tolerance scaled to their size (GunModels.ZFightOptions);
-- this keeps the builder clear of it by design rather than relying on the pass to push things apart.
local RELIEF = 3.5
-- Fine surface work (engraving, checkering, grip texture) stands this far proud. A gun is small and
-- seen up close, where depth precision is plentiful, so guns run the z-fight pass with a tolerance of
-- about a millimetre rather than the map's 17: at the map's tolerance every inlay line had to stand
-- out like a wire.
local FINE = 1.4

GunModels.ZFightOptions = { all = true, tolerance = 0.0035, gap = 0.0045 }
-- The harness scans finished guns with this.
GunModels.ZFightTolerance = 0.003

local SIGNS = { 1, -1 }

local function A(x, y, z)
	return CFrame.Angles(rad(x or 0), rad(y or 0), rad(z or 0))
end

local function place(at)
	if typeof(at) == "Vector3" then
		return CFrame.new(at)
	end
	return at or CFrame.identity
end

--------------------------------------------------------------------------------
-- Finishes
--------------------------------------------------------------------------------

local Mat = Enum.Material

local function finish(r, g, b, material, reflectance, transparency)
	return {
		color = Color3.fromRGB(r, g, b),
		material = material,
		reflectance = reflectance or 0,
		transparency = transparency or 0,
	}
end

local function finishOf(color, material, reflectance, transparency)
	return { color = color, material = material, reflectance = reflectance or 0, transparency = transparency or 0 }
end

-- Real gun finishes. Nothing here glows except what would: tritium, the red dot, a laser, a lens.
local F = {
	polymer = finish(38, 38, 41, Mat.SmoothPlastic),
	polymerDark = finish(27, 27, 30, Mat.SmoothPlastic),
	texture = finish(33, 33, 36, Mat.Plastic),
	anodized = finish(48, 49, 53, Mat.Metal),
	anodizedDark = finish(34, 35, 38, Mat.Metal),
	parkerized = finish(62, 63, 66, Mat.Metal),
	blued = finish(40, 43, 52, Mat.Metal, 0.04),
	nitride = finish(24, 24, 27, Mat.Metal),
	steel = finish(104, 107, 112, Mat.Metal, 0.03),
	steelMag = finish(74, 77, 84, Mat.Metal, 0.02),
	bright = finish(170, 173, 178, Mat.Metal, 0.08),
	stainless = finish(166, 168, 172, Mat.Metal, 0.1),
	shadow = finish(9, 9, 11, Mat.SmoothPlastic),
	bore = finish(4, 4, 5, Mat.SmoothPlastic),
	brass = finish(206, 162, 82, Mat.Metal, 0.08),
	copper = finish(186, 114, 72, Mat.Metal, 0.06),
	gold = finish(228, 184, 78, Mat.Metal, 0.18),
	goldDeep = finish(196, 146, 52, Mat.Metal, 0.1),
	wood = finish(118, 70, 40, Mat.Wood),
	woodDark = finish(80, 47, 28, Mat.Wood),
	woodLight = finish(150, 102, 62, Mat.Wood),
	rubber = finish(30, 30, 32, Mat.Rubber),
	fabric = finish(58, 60, 54, Mat.Fabric),
	tape = finish(64, 64, 68, Mat.Fabric),
	leather = finish(84, 54, 34, Mat.Leather),
	fde = finish(146, 124, 92, Mat.SmoothPlastic),
	od = finish(92, 96, 72, Mat.SmoothPlastic),
	camoLight = finish(128, 112, 82, Mat.SmoothPlastic),
	camoDark = finish(88, 84, 62, Mat.SmoothPlastic),
	camoBrown = finish(108, 86, 60, Mat.SmoothPlastic),
	ghillie = finish(84, 96, 60, Mat.Fabric),
	ghillieDark = finish(58, 66, 42, Mat.Fabric),
	glass = finish(96, 132, 150, Mat.Glass, 0.25, 0.55),
	lens = finish(120, 170, 190, Mat.Glass, 0.2, 0.82),
	coated = finish(70, 60, 120, Mat.Glass, 0.35, 0.35),
	-- A red dot or holo's windows are looked through: barely tinted, and not Glass, which darkens
	-- and warps whatever is behind it.
	sightCoated = finish(120, 96, 170, Mat.SmoothPlastic, 0, 0.9),
	sightLens = finish(170, 210, 225, Mat.SmoothPlastic, 0, 0.94),
	tank = finish(200, 235, 250, Mat.Glass, 0.3, 0.72),
	soap = finish(120, 214, 245, Mat.Glass, 0.2, 0.38),
	bubble = finish(236, 250, 255, Mat.Glass, 0.45, 0.4),
	film = finish(200, 236, 255, Mat.Glass, 0.5, 0.8),
	dial = finish(236, 232, 220, Mat.SmoothPlastic),
	energy = finish(140, 230, 255, Mat.Neon),
	ceramic = finish(196, 198, 202, Mat.SmoothPlastic),
	tritium = finish(140, 255, 160, Mat.Neon),
	tritiumOrange = finish(255, 150, 60, Mat.Neon),
	redDot = finish(255, 36, 36, Mat.Neon),
	laser = finish(255, 30, 30, Mat.Neon),
	shell = finish(176, 34, 36, Mat.SmoothPlastic),
	shellGreen = finish(46, 110, 70, Mat.SmoothPlastic),
	warhead = finish(84, 96, 70, Mat.SmoothPlastic),
	warning = finish(230, 190, 40, Mat.SmoothPlastic),
	cork = finish(170, 130, 90, Mat.Wood),
}
GunModels.Finishes = F

--------------------------------------------------------------------------------
-- What sets each gun apart from the others of its silhouette
--------------------------------------------------------------------------------

--   pattern        "ak" builds the rifle as a stamped-receiver AK rather than an AR
--   compact        shorter barrel and furniture           drum           a drum magazine
--   suppressor     a can on the muzzle                    laser          a laser module (a real beam when you aim)
--   light          a weapon light                         holo           a holographic sight
--   camo           tiger-stripe furniture                 woodFurniture  wooden furniture
--   bayonet        a blade under the muzzle               foregrip       a vertical foregrip
--   skeletonStock  a folding skeleton stock               engraved       gold inlay on the metal
--   heatShield     a ventilated shield over the barrel    longBarrel     an extra length of barrel
--   sawnOff        barrels cut short, pistol grip         ghillie        rag wraps along the gun
--   sixShot        a six-round revolving launcher         bigTank        a larger reservoir
--   flutes         fluted barrel                          irons          flip-up iron sights, no optic
--   boltAction     worked by hand after every shot        semiAuto       magazine-fed semi-automatic
local VARIANTS = {
	SahurPistol = { light = true },
	PocketPopper = { compact = true, laser = true },
	RotSMG = { skeletonStock = true, suppressor = true },
	LagSwitchSMG = { drum = true, laser = true },
	GlitchSMG = { drum = true, holo = true, camo = true },
	CrocodiloRifle = { pattern = "ak", woodFurniture = true, bayonet = true },
	CrumblyCarbine = { compact = true, camo = true, irons = true },
	BananiniBurst = { foregrip = true, holo = true, camo = true },
	SigmaRevolver = { longBarrel = true, engraved = true },
	TralalaShotgun = { heatShield = true },
	AuraScattergun = { semiAuto = true, drum = true, heatShield = true, foregrip = true },
	BonkerDoubleBarrel = { sawnOff = true },
	NonnaDoubleBarrel = { engraved = true },
	LarilaSniper = { boltAction = true, longBarrel = true, ghillie = true, flutes = true },
	SixSevenMarksman = { camo = true, flutes = true },
	GrassToucherDMR = { woodFurniture = true, laser = true },
	SigmaScout = { compact = true, foregrip = true, light = true },
	TralalaThumper = { sixShot = true },
	BubbleBurster = { bigTank = true },
	RizzRotary = { holo = true, engraved = true, foregrip = true },
}
GunModels.Variants = VARIANTS
for id, variant in pairs(ArsenalExpansion.Variants) do
	VARIANTS[id] = variant
end
for id, variant in pairs(GunModelsCreative.Variants or {}) do
	VARIANTS[id] = variant
end
for id, variant in pairs(GunModelsWorkshop.Variants or {}) do
	VARIANTS[id] = variant
end

--------------------------------------------------------------------------------
-- Builder
--------------------------------------------------------------------------------

local CYLINDER = Enum.PartType.Cylinder
local BALL = Enum.PartType.Ball
-- A cylinder's axis is its local X. These turn it to run front to back, or upright.
local ALONG_Z = CFrame.Angles(0, math.pi / 2, 0)
local ALONG_Y = CFrame.Angles(0, 0, math.pi / 2)

local Builder = {}
Builder.__index = Builder

-- `scale` enlarges a whole gun about its origin: the AR-10s and the 12-gauge AR are the AR's own parts
-- at their real, larger proportions.
local function toStuds(cframe, scale)
	return CFrame.new(cframe.Position * (MM * (scale or 1))) * cframe.Rotation
end

function Builder.new(def, color, material, options)
	local self = setmetatable({}, Builder)
	self.def = def
	self.style = def.style or "rifle"
	self.variant = VARIANTS[def.id] or {}
	-- Every copy of a gun is built with the same shapes, so the one on the floor or on a podium is the
	-- one in your hands. "world" only leaves out the smallest fittings (pins, screw heads, knurling,
	-- rivets), for copies nobody gets within arm's length of, like the guns bots carry.
	self.high = true
	self.micro = options.detail ~= "world"
	self.model = Instance.new("Model")
	self.model.Name = "HeldGun"
	self.frame = CFrame.identity
	self.anim = nil
	self.rarityIndex = Rarity.Index[def.rarity] or 1
	self.accent = Rarity.Color(def.rarity)
	self.skinned = options.skinned == true
	self.skin = finishOf(color or self.accent, material or Mat.Metal)
	self.parts = 0
	self.scale = 1
	return self
end

-- Every part goes through here. Sizes and placements are in millimetres, relative to the current
-- frame (Builder:at).
function Builder:make(className, shape, name, size, cframe, look)
	local part = Instance.new(className)
	part.Name = name
	if shape then
		part.Shape = shape
	end
	part.Size = size * (MM * self.scale)
	part.CFrame = toStuds(self.frame * cframe, self.scale)
	part.Color = look.color
	part.Material = look.material
	part.Reflectance = look.reflectance
	part.Transparency = look.transparency
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if self.anim then
		part:SetAttribute("Anim", self.anim)
	end
	part.Parent = self.model
	self.parts += 1
	return part
end

function Builder:box(name, size, at, look)
	return self:make("Part", nil, name, size, place(at), look)
end

-- Cylinders run front to back (Z) unless they say otherwise.
function Builder:cyl(name, length, diameter, at, look)
	return self:make("Part", CYLINDER, name, V(length, diameter, diameter), place(at) * ALONG_Z, look)
end

function Builder:cylX(name, length, diameter, at, look)
	return self:make("Part", CYLINDER, name, V(length, diameter, diameter), place(at), look)
end

function Builder:cylY(name, length, diameter, at, look)
	return self:make("Part", CYLINDER, name, V(length, diameter, diameter), place(at) * ALONG_Y, look)
end

function Builder:ball(name, diameter, at, look)
	return self:make("Part", BALL, name, V(diameter, diameter, diameter), place(at), look)
end

-- A raw wedge: vertical face at the back (+Z), sloping down to the front.
function Builder:wedge(name, size, at, look)
	return self:make("WedgePart", nil, name, size, place(at), look)
end

-- Only built at high detail.
function Builder:detail(fn)
	if self.micro then
		fn()
	end
end

-- Builds `fn` in a frame placed at `at` inside the current one.
function Builder:at(at, fn)
	local saved = self.frame
	self.frame = saved * place(at)
	fn()
	self.frame = saved
end

-- Parts built inside `fn` belong to the named animation group.
function Builder:group(name, fn)
	local saved = self.anim
	self.anim = name
	fn()
	self.anim = saved
end

local function modelSpace(self, at)
	return toStuds(self.frame * place(at), self.scale)
end

function Builder:key(name, at)
	self.model:SetAttribute("KP_" .. name, modelSpace(self, at))
end

-- A hand keypoint: the palm centre, the way the fingers point, and the way the back of the hand
-- faces. The viewmodel's hand is built to that frame: -Z along the fingers, +Y out of the back of
-- the hand.
function Builder:hand(name, position, fingers, back)
	local z = -fingers.Unit
	local x = back.Unit:Cross(z).Unit
	local y = z:Cross(x).Unit
	self:key(name, CFrame.fromMatrix(position, x, y, z))
end

function Builder:travel(group, millimetres)
	self.model:SetAttribute("Travel_" .. group, millimetres * MM * self.scale)
end

function Builder:swing(group, at, degrees)
	self.model:SetAttribute("Pivot_" .. group, modelSpace(self, at))
	if degrees then
		self.model:SetAttribute("Swing_" .. group, degrees)
	end
end

--------------------------------------------------------------------------------
-- Shapes
--------------------------------------------------------------------------------

-- The wedge that fills one long edge of a chamfered prism running along Z. `sx`/`sy` pick the
-- corner. A wedge's triangle lives in its local YZ plane, so it is laid down with its X along the
-- prism: local Y out along the corner's side, local Z back toward the prism's middle.
local function bevelFrame(sx, sy, x, y)
	return CFrame.fromMatrix(V(x, y, 0), V(0, 0, sx * sy), V(0, sy, 0), V(-sx, 0, 0))
end

-- A block running along Z with its long edges chamfered: a machined receiver, a handguard, a slide.
-- Built from a core, a cap slab per chamfered side and a wedge per edge, arranged so no two faces
-- ever lie flush (every seam is two faces meeting edge to edge or back to back). `edges` is "all",
-- "top" or "bottom". Low detail is the plain block.
function Builder:prism(name, size, at, chamfer, look, edges)
	local frame = place(at)
	local c = math.min(chamfer, size.X * 0.45, size.Y * 0.45)
	if not self.high or c &lt; 1 then
		return self:box(name, size, frame, look)
	end
	edges = edges or "all"
	local top = edges ~= "bottom"
	local bottom = edges ~= "top"
	local coreHeight = size.Y - (top and c or 0) - (bottom and c or 0)
	local coreY = ((bottom and c or 0) - (top and c or 0)) / 2
	local main = self:box(name, V(size.X, coreHeight, size.Z), frame * CF(0, coreY, 0), look)
	for _, sy in ipairs(SIGNS) do
		if (sy &gt; 0 and top) or (sy &lt; 0 and bottom) then
			self:box(name .. "Cap", V(size.X - 2 * c, c, size.Z), frame * CF(0, sy * (size.Y - c) / 2, 0), look)
			for _, sx in ipairs(SIGNS) do
				self:wedge(name .. "Bevel", V(size.Z, c, c), frame * bevelFrame(sx, sy, sx * (size.X - c) / 2, sy * (size.Y - c) / 2), look)
			end
		end
	end
	return main
end

-- The same with rounded long edges: grips, stocks, polymer frames. The corner rods stop RELIEF short
-- of each end so their end discs never lie in the end faces of the slabs beside them.
function Builder:rounded(name, size, at, radius, look)
	local frame = place(at)
	local r = math.min(radius, size.X * 0.45, size.Y * 0.45)
	if not self.high or r &lt; 1.5 then
		return self:box(name, size, frame, look)
	end
	local main = self:box(name, V(size.X, size.Y - 2 * r, size.Z), frame, look)
	for _, sy in ipairs(SIGNS) do
		self:box(name .. "Cap", V(size.X - 2 * r, r, size.Z), frame * CF(0, sy * (size.Y - r) / 2, 0), look)
		for _, sx in ipairs(SIGNS) do
			-- Where the slab is thin its corner rods overlap in plan, and any two whose end discs share a
			-- plane fight there. Each rod is cut a different amount at each end — fronts 0/1/2/3 × FINE,
			-- backs 3/2/1/0 — so no two rods end in the same plane at either end, and every rod loses the
			-- same 3 × FINE overall (the earlier two-length scheme left the two untrimmed rods, and the two
			-- trimmed ones, coplanar whenever the slab was thin in both axes).
			local front = (sx &gt; 0 and 1 or 0) + (sy &gt; 0 and 2 or 0)
			local back = 3 - front
			self:cyl(name .. "Round", size.Z - 2 * RELIEF - (front + back) * FINE, 2 * r,
				frame * CF(sx * (size.X / 2 - r), sy * (size.Y / 2 - r), (back - front) * FINE / 2), look)
		end
	end
	return main
end

-- A hollow tube along Z made of staves, for anything you look *through*: a red dot's body, a
-- muzzle's bore. Low detail is a solid cylinder, which from any distance looks the same.
function Builder:shell(name, length, outer, wall, at, look, sides)
	local frame = place(at)
	if not self.high then
		return self:cyl(name, length, outer, frame, look)
	end
	sides = sides or 12
	local radius = outer / 2 - wall / 2
	local width = 2 * (outer / 2) * math.tan(math.pi / sides) + 0.4
	local first
	for index = 0, sides - 1 do
		local angle = index / sides * math.pi * 2
		-- Neighbouring staves overlap a sliver along their shared edge, so their end faces would lie in
		-- one plane over it; every other stave stops FINE short at each end to keep them apart.
		local staveLength = index % 2 == 0 and length or length - FINE * 2
		local stave = self:box(name, V(width, wall, staveLength), frame * CFrame.Angles(0, 0, angle) * CF(0, radius, 0), look)
		first = first or stave
	end
	return first
end

--------------------------------------------------------------------------------
-- Finish by role
--------------------------------------------------------------------------------

-- Rarity used to be the colour of the whole gun, which is what made every gun a toy. It lives in
-- finish now, the way a real rifle is dressed up: Common is plain black, Uncommon picks out its
-- small anodised parts, Rare has its handguard and slide cerakoted, Epic cerakotes the receiver as
-- well, and a Legendary is black with gold parts and gold inlay. Furniture (grips, stocks, pumps)
-- stays black polymer at every rarity: a purple stock and grip is what a toy gun looks like. A gun
-- skin paints the panels and furniture in its own colour whatever the rarity.
--
-- Roles: receiver, handguard, slide, furniture (grip, stock, pump), barrel, small (levers, pins,
-- charging handle, mag base), trim (bolts, screws, springs).
function Builder:finish(role)
	local rarity = self.rarityIndex
	local cerakote = finishOf(self.accent:Lerp(Color3.fromRGB(34, 34, 38), 0.78), Mat.Metal, 0.04)
	if role == "barrel" then
		return F.nitride
	elseif role == "trim" then
		return rarity &gt;= 5 and F.gold or F.steel
	elseif role == "small" then
		if rarity &gt;= 5 then
			return F.gold
		elseif rarity &gt;= 2 then
			return finishOf(self.accent:Lerp(Color3.fromRGB(30, 30, 34), 0.3), Mat.Metal, 0.05)
		end
		return F.anodizedDark
	end
	if self.skinned then
		if role == "receiver" or role == "handguard" or role == "slide" or role == "furniture" then
			return self.skin
		end
	end
	if role == "receiver" then
		return rarity == 4 and cerakote or F.anodized
	elseif role == "handguard" or role == "slide" then
		return (rarity == 3 or rarity == 4) and cerakote or F.anodized
	elseif role == "furniture" then
		return F.polymer
	end
	return F.anodized
end

--------------------------------------------------------------------------------
-- Components
--------------------------------------------------------------------------------

-- A Picatinny rail along Z. `at` is the centre of its base; it stands 9.5mm tall. Real cross slots
-- between the teeth at high detail.
function Builder:rail(name, length, at, look)
	local frame = place(at)
	look = look or F.anodizedDark
	if not self.high then
		return self:box(name, V(21, 9.5, length), frame * CF(0, 4.75, 0), look)
	end
	local base = self:box(name, V(15.6, 5, length), frame * CF(0, 2.5, 0), look)
	self:box(name .. "Spine", V(21.2, 2, length), frame * CF(0, 6, 0), look)
	local teeth = math.max(1, math.floor((length - 4) / 10))
	local first = -(teeth - 1) * 5
	for index = 0, teeth - 1 do
		self:box(name .. "Tooth", V(21.2, 2.5, 4.8), frame * CF(0, 8.25, first + index * 10), look)
	end
	return base
end

-- Screw heads, pins and rivets: a short cylinder standing proud of a side face.
function Builder:pin(name, diameter, at, look, length)
	if not self.micro then
		return nil
	end
	return self:cylX(name, length or RELIEF * 2, diameter, at, look or F.anodizedDark)
end

-- A muzzle's bore: a polygon ring so the hole is a hole.
function Builder:crown(name, length, outer, bore, at, look)
	local frame = place(at)
	if not self.high then
		self:cyl(name, length, outer, frame, look)
		return
	end
	self:shell(name, length, outer, (outer - bore) / 2, frame, look, 10)
	-- The dark disc's edge bites 1.5 mm into the ring's wall, so it is seated, not touching by a hair.
	self:cyl(name .. "Bore", 2, bore + 3, frame * CF(0, 0, length / 2 - 6), F.bore)
end

-- An A2 birdcage flash hider: a collar, five prongs with open slots between, a front ring, and the
-- bottom left closed (on a real one that stops dust kicking up when fired prone).
function Builder:birdcage(at, diameter)
	local d = diameter or 22
	self:at(at, function()
		self:cyl("MuzzleBrake", 16, d, CF(0, 0, -8), F.nitride)
		if self.high then
			for index = 0, 5 do
				local angle = index / 6 * math.pi * 2
				local width = index == 3 and 12 or 4
				self:box("MuzzleProng", V(width, 3.5, 30), CFrame.Angles(0, 0, angle) * CF(0, d / 2 - 1.75, -31), F.nitride)
			end
			self:crown("MuzzleBrake", 8, d, 9, CF(0, 0, -50), F.nitride)
			-- The bore's dark core runs back 1 mm into the collar (ending 1 mm short of it, it floated).
			self:cyl("Bore", 32, 8, CF(0, 0, -31), F.bore)
		else
			self:cyl("MuzzleBrake", 38, d, CF(0, 0, -35), F.nitride)
		end
	end)
	return -54
end

-- Ridges round an axis: knurling, castle-nut notches, the forward assist's grip. Each ridge is a short
-- radial bar that starts `inner` out from the axis rather than crossing it, so no two share a patch of
-- their end planes (bars through the centre all overlap there, which the z-fight pass flags).
--   `at`'s Z is the axis; `thickness` is along it.
function Builder:ridges(name, count, inner, outer, width, thickness, at, look)
	local frame = place(at)
	for index = 0, count - 1 do
		local angle = index / count * math.pi * 2
		self:box(name, V(width, outer - inner, thickness), frame * CFrame.Angles(0, 0, angle) * CF(0, (inner + outer) / 2, 0), look)
	end
end

-- A muzzle brake: a collar, then chambers whose side ports are real gaps between a top and a bottom
-- bar, solid rings between the chambers, the bore showing through the ports, and a crown.
function Builder:brake(at, diameter, length)
	local d = diameter or 24
	local l = length or 60
	self:at(at, function()
		local ports, ring, collar, crown = 3, 6, 10, 6
		local port = (l - collar - crown - (ports - 1) * ring) / ports
		self:cyl("MuzzleBrake", collar, d, CF(0, 0, -collar / 2), F.nitride)
		local z = -collar
		for index = 1, ports do
			for _, sy in ipairs(SIGNS) do
				self:box("MuzzleBrake", V(d * 0.86, d * 0.3, port), CF(0, sy * d * 0.3, z - port / 2), F.nitride)
			end
			z -= port
			if index &lt; ports then
				self:cyl("MuzzleBrake", ring, d, CF(0, 0, z - ring / 2), F.nitride)
				z -= ring
			end
		end
		self:cyl("Bore", l - collar - crown - 2, d * 0.34, CF(0, 0, -collar - (l - collar - crown) / 2), F.bore)
		self:crown("MuzzleBrake", crown, d, 9, CF(0, 0, z - crown / 2), F.nitride)
	end)
	return -l
end

-- A suppressor can: a tube with a knurled collar, an end cap with a bore.
function Builder:suppressor(at, diameter, length)
	local d = diameter or 38
	local l = length or 170
	self:at(at, function()
		self:cyl("Suppressor", 24, d - 4, CF(0, 0, -12), F.nitride)
		self:ridges("SuppressorKnurl", 12, d / 2 - 5, d / 2 - 0.5, 3, 18, CF(0, 0, -12), F.nitride)
		self:cyl("Suppressor", l - 34, d, CF(0, 0, -24 - (l - 34) / 2), F.anodizedDark)
		self:cyl("Suppressor", 10, d - 3, CF(0, 0, -l + 5), F.nitride)
		self:detail(function()
			self:cyl("SuppressorBore", 2, 9, CF(0, 0, -l - 1 + RELIEF), F.bore)
		end)
	end)
	return -l
end

-- A flip-up rear aperture sight standing on a rail, aperture centre `height` above the rail top.
function Builder:rearAperture(at, height)
	self:at(at, function()
		self:box("RearSightBase", V(24, 9, 34), CF(0, 4.5, 0), F.anodizedDark)
		-- The tower rises to the ring, and the ring is four bars round a real hole, so the front post
		-- shows through it. The hole is the large (0.2 in) aperture, sized for the eye close behind it:
		-- the small one read as a black slab with a pinhole from where the eye sits.
		local outer, hole = 17, 7.5
		local bar = (outer - hole) / 2
		local ringBottom = height - outer / 2
		self:box("RearSightTower", V(12, ringBottom - 7, 5), CF(0, 7 + (ringBottom - 7) / 2, 4), F.anodizedDark)
		self:box("RearSight", V(outer, bar, 5), CF(0, height + hole / 2 + bar / 2, 4), F.anodizedDark)
		self:box("RearSightRing", V(outer, bar, 5), CF(0, height - hole / 2 - bar / 2, 4), F.anodizedDark)
		for _, sx in ipairs(SIGNS) do
			self:box("RearSightRing", V(bar, hole, 5), CF(sx * (hole / 2 + bar / 2), height, 4), F.anodizedDark)
		end
		self:detail(function()
			self:cylX("RearSightKnob", 6, 11, CF(15, 5, -6), F.anodizedDark)
		end)
	end)
end

-- The plate an aperture ring (a 10 mm shell) is set in between a rear sight's ears: a web from the
-- sight base up to the ring and a bar either side of it, so the ring is carried rather than hanging in
-- the air. `base` is the top of what it stands on and `ring` the ring's centre; the hole stays clear.
function Builder:aperturePlate(at, base, ring, finish)
	self:at(at, function()
		self:box("RearSightPlate", V(14, ring - 5 - base + 0.5, 3), CF(0, (base + ring - 5.5) / 2 + 0.25, 0), finish)
		for _, sx in ipairs(SIGNS) do
			self:box("RearSightPlate", V(2.5, 11, 3), CF(sx * 5.25, ring + 0.5, 0), finish)
		end
	end)
end

-- A flip-up front post in protective ears, its tip `height` above the rail top.
function Builder:frontPost(at, height)
	self:at(at, function()
		self:box("FrontSightBase", V(24, 9, 30), CF(0, 4.5, 0), F.anodizedDark)
		for _, sx in ipairs(SIGNS) do
			self:box("FrontSightEar", V(4, height - 5, 16), CF(sx * 9, 9 + (height - 5) / 2, 0), F.anodizedDark)
		end
		self:box("FrontSightPost", V(4, height - 17, 4), CF(0, 9 + (height - 17) / 2, 0), F.anodizedDark)
		-- The part named FrontSight is the tip the aim lines up over; its top is the sight line.
		self:box("FrontSight", V(2.4, 8, 3), CF(0, height - 4, 0), F.anodizedDark)
	end)
end

-- A tube red dot on a riser, standing on a rail. Its body is a hollow shell so aiming actually looks
-- through it; the dot floats in the front glass. Returns the sight-line height above the rail.
function Builder:redDot(at)
	local h = 40
	self:at(at, function()
		self:box("SightMount", V(26, 10, 40), CF(0, 5, 0), F.anodizedDark)
		self:detail(function()
			self:box("SightMountLever", V(5, 8, 22), CF(-15.5, 5, 4), F.anodizedDark)
			self:cylX("SightMountNut", 5, 9, CF(15.5, 5, -6), F.steel)
		end)
		self:box("SightRiser", V(18, 14, 30), CF(0, 17, 0), F.anodizedDark)
		self:shell("Sight", 96, 34, 4, CF(0, h, 0), F.anodized)
		self:shell("SightBell", 10, 38, 5, CF(0, h, -53), F.anodized)
		self:shell("SightBell", 10, 37, 4.5, CF(0, h, 53), F.anodized)
		self:detail(function()
			self:cylY("SightTurret", 8, 15, CF(0, h + 19, -8), F.anodized)
			self:cylY("SightTurretCap", 5, 12, CF(0, h + 25.5, -8), F.anodizedDark)
			self:cylX("SightTurret", 8, 15, CF(19, h, -8), F.anodized)
			self:cylX("SightTurretCap", 5, 12, CF(25.5, h, -8), F.anodizedDark)
			self:cylX("SightDial", 7, 14, CF(-19.5, h, 10), F.anodizedDark)
		end)
		self:cyl("SightLens", 1.5, 30, CF(0, h, -40), F.sightCoated)
		self:cyl("SightLens", 1.5, 29, CF(0, h, 44), F.sightLens)
		self:ball("SightDot", 1.4, CF(0, h, -37), F.redDot)
	end)
	return h
end

-- A holographic sight: a battery housing on a base, a squared hood over a window, a glass plate
-- front and back, and the reticle -- a ring of light with a dot in it -- in the front plate.
function Builder:holo(at)
	local h = 38
	self:at(at, function()
		self:prism("SightBase", V(34, 12, 94), CF(0, 6, 0), 3, F.anodizedDark, "top")
		self:detail(function()
			for index = 0, 1 do
				self:box("SightButton", V(9, 4, 7), CF(-7 + index * 14, 12 + 2, 38), F.rubber)
			end
			self:cylX("SightBattery", 36, 14, CF(0, 7, -33), F.anodized)
			self:box("SightMountBolt", V(5, 9, 12), CF(-19.5, 5, 12), F.steel)
		end)
		local window = 28
		local wall = 4
		for _, sx in ipairs(SIGNS) do
			self:box("SightHood", V(wall, window + 7, 62), CF(sx * (window / 2 + wall / 2), h - 3.5, 8), F.anodized)
		end
		self:prism("SightHood", V(window + wall * 2 + 2, 7, 66), CF(0, h + window / 2 + 3.5, 8), 2.5, F.anodized, "top")
		self:box("Sight", V(window, 5, 58), CF(0, h - window / 2 - 2.5, 8), F.anodizedDark)
		-- The body the window stands on, down to the base, so the hood isn't held up by nothing.
		self:box("SightBody", V(window + wall * 2 - 2, 8.5, 54), CF(0, 15.75, 8), F.anodizedDark)
		-- The glass plates are set 1 mm into the hood's walls, roof and floor all round (a hair smaller than
		-- the window, they hung in it), and the reticle lies on the front plate's back face.
		self:box("SightLens", V(window + 2, window + 2, 1.5), CF(0, h, -18), F.sightCoated)
		self:box("SightLens", V(window + 2, window + 2, 1.5), CF(0, h, 34), F.sightLens)
		self:detail(function()
			local segments = 16
			local radius = 6.5
			-- The ring runs right through the glass, standing more than the z-fight gap proud of both its
			-- faces: lying on the front face, all sixteen segments fought it.
			for index = 0, segments - 1 do
				local angle = index / segments * math.pi * 2
				self:box("SightReticle", V(2.6, 0.7, 4), CF(0, h, -18) * CFrame.Angles(0, 0, angle) * CF(0, radius, 0), F.redDot)
			end
		end)
		self:ball("SightDot", 1.2, CF(0, h, -18), F.redDot)
	end)
	return h
end

-- A scope on a cantilever mount. `kind` is "lpvo" (short, low power) or "long" (a precision scope
-- with a big objective and tall turrets). Aiming hands over to the full-screen scope view once the
-- gun is up, so the tube is solid; the part named Scope marks the gun as scoped and carries the
-- sight line. Returns the axis height above the rail.
function Builder:scope(at, kind)
	local long = kind == "long"
	local h = long and 52 or 46
	local tube = long and 34 or 30
	local body = long and 150 or 120
	-- Staves round the scope's hollow parts (rings, tube, saddle, bells, eyepiece), all alike.
	local sides = 10
	self:at(at, function()
		-- Mount: a base clamped to the rail, two rings.
		self:box("ScopeMount", V(28, 10, body + 20), CF(0, 5, 6), F.anodizedDark)
		self:detail(function()
			for _, z in ipairs({ -body * 0.28, body * 0.34 }) do
				self:cylX("ScopeMountNut", 5, 10, CF(16.5, 5, z), F.steel)
			end
		end)
		for _, z in ipairs({ -body * 0.3, body * 0.32 }) do
			-- The post is FINE shorter than the ring at each end. Measured, not derived: the audit reports
			-- both spanning 16.1..36.3 mm along the bore at a scope station -- the same two planes, both
			-- facing the same way -- and dropping the post to 18 - 2 * FINE takes TouchGrassScout from 11
			-- written flush pairs to 7. (Local part sizes cannot be compared here: a shell segment is
			-- rotated, so its local Z is not the ring's axis. Face positions are the only readable unit.)
			self:box("ScopeStanchion", V(20, h - tube / 2 - 10 + 2, 18 - 2 * FINE), CF(0, 10 + (h - tube / 2 - 10) / 2, z), F.anodizedDark)
			self:shell("ScopeRing", 18, tube + 8, 4, CF(0, h, z), F.anodizedDark, sides)
			self:detail(function()
				for _, sx in ipairs(SIGNS) do
					self:box("ScopeRingScrew", V(6, 5, 5), CF(sx * (tube / 2 + 6), h + 2, z), F.steel)
				end
			end)
		end
		-- Tube, turret saddle. The whole scope is hollow along its axis: staves round the bore, rings and
		-- bells as open shells, glass that's barely tinted, and a fine reticle in the objective, so
		-- aiming in you see the target through it rather than a black disc (fully aimed, the
		-- full-screen scope takes over). The part named Scope, which marks the gun as scoped and carries
		-- the sight line, is an invisible rod down the axis.
		self:shell("ScopeTube", body, tube, 2.5, CF(0, h, 0), F.anodized, sides)
		local marker = self:box("Scope", V(1, 1, body), CF(0, h, 0), F.anodized)
		marker.Transparency = 1
		marker.CastShadow = false
		self:shell("ScopeSaddle", 40, tube + 5, 2.5, CF(0, h, -4), F.anodized, sides)
		local turret = long and 24 or 18
		local turretHeight = long and 20 or 13
		self:cylY("ScopeTurret", turretHeight, turret, CF(0, h + tube / 2 + 2 + turretHeight / 2, -4), F.anodized)
		self:cylX("ScopeTurret", turretHeight, turret, CF(tube / 2 + 2 + turretHeight / 2, h, -4), F.anodized)
		self:detail(function()
			-- Knurled caps: fine ribs around each turret.
			self:ridges("ScopeKnurl", 16, turret / 2 - 2, turret / 2 + 0.75, 1.8, turretHeight * 0.55,
				CF(0, h + tube / 2 + 2 + turretHeight * 0.62, -4) * A(-90, 0, 0), F.anodizedDark)
			self:ridges("ScopeKnurl", 16, turret / 2 - 2, turret / 2 + 0.75, 1.8, turretHeight * 0.55,
				CF(tube / 2 + 2 + turretHeight * 0.62, h, -4) * A(0, 90, 0), F.anodizedDark)
			self:box("ScopeTurretMark", V(1.4, 1.2, 4), CF(0, h + tube / 2 + 2 + turretHeight + 0.2, -4 - turret / 2 + 3), F.bright)
			if long then
				self:cylX("ScopeParallax", 14, 26, CF(-(tube / 2 + 9), h, -4), F.anodized)
			end
		end)
		-- Objective: a shoulder stepping out to the bell, a sunshade, and the glass.
		local objective = long and 56 or 42
		local front = -body / 2
		local shoulder = tube + (objective - tube) * 0.45
		-- The shoulder runs 2 mm into the bell, and the bell's wall reaches in past the shoulder's outside,
		-- so the objective end is joined to the tube rather than two open rings touching at a plane.
		self:shell("ScopeShoulder", 20, shoulder, (shoulder - tube) / 2 + 2.5, CF(0, h, front - 10), F.anodized, sides)
		self:shell("ScopeBell", long and 58 or 30, objective, (objective - shoulder) / 2 + 1.5, CF(0, h, front - 18 - (long and 29 or 15)), F.anodized, sides)
		local bellFront = front - 18 - (long and 58 or 30)
		self:detail(function()
			self:shell("ScopeRim", 5, objective + 3, 3, CF(0, h, bellFront + 6), F.anodizedDark, sides)
		end)
		self:cyl("ScopeLens", FINE, objective - 6, CF(0, h, bellFront - FINE / 2), F.sightCoated)
		-- A duplex reticle just behind the objective glass: fine lines toward the middle, heavier posts
		-- out to the edge, a clear gap where they'd meet so the aim point itself is never covered.
		local reach = objective / 2 - 2.5 -- the posts run into the bell's wall, so they're held by it
		local reticleZ = bellFront + 3
		for index = 0, 3 do
			local turn = CFrame.Angles(0, 0, index * math.pi / 2)
			self:box("ScopeReticle", V(0.5, reach * 0.55 - 1.2, 0.5), CF(0, h, reticleZ) * turn * CF(0, 1.2 + (reach * 0.55 - 1.2) / 2, 0), F.shadow)
			self:box("ScopeReticle", V(1.4, reach * 0.45, 0.5), CF(0, h, reticleZ) * turn * CF(0, reach * 0.55 + reach * 0.225, 0), F.shadow)
		end
		-- Ocular: the power ring with its throw lever, the eyepiece, a rubber eye cup. The power ring's wall
		-- reaches in to the tube's bore, so its front face bears on the tube's end all round (with a wall
		-- only as deep as the tube is wide, the two touched along a circle and the ocular hung off the lens).
		local back = body / 2
		self:shell("ScopePowerRing", 24, tube + 10, 7.5, CF(0, h, back + 12), F.anodizedDark, sides)
		self:detail(function()
			self:ridges("ScopeKnurl", 20, (tube + 10) / 2 - 2, (tube + 12) / 2, 2, 14, CF(0, h, back + 12), F.anodizedDark)
			self:box("ScopeThrowLever", V(6, 16, 8), CF(0, h + tube / 2 + 10, back + 12), F.anodized)
		end)
		local eyepiece = long and 44 or 40
		self:shell("ScopeEyepiece", long and 46 or 38, eyepiece, (eyepiece - tube) / 2 + 3, CF(0, h, back + 24 + (long and 23 or 19)), F.anodized, sides)
		local eyeBack = back + 24 + (long and 46 or 38)
		self:shell("ScopeEyecup", 10, eyepiece + 2, 4, CF(0, h, eyeBack + 5), F.rubber, sides)
		-- The ocular glass sits inside the eye cup, its edge in the cup's wall.
		self:cyl("ScopeLens", FINE, eyepiece - 2, CF(0, h, eyeBack + 5), F.sightLens)
	end)
	return h
end

-- A vertical foregrip on a rail clamp. `at` is on the rail's surface, the grip hanging below.
function Builder:foregrip(at)
	self:at(at, function()
		self:box("ForeGripClamp", V(30, 12, 34), CF(0, -6, 0), F.polymerDark)
		self:detail(function()
			self:cylX("ForeGripScrew", 6, 8, CF(18, -6, 0), F.steel)
		end)
		self:at(CF(0, -12, 0) * A(-8, 0, 0), function()
			self:rounded("ForeGrip", V(28, 30, 76), CF(0, -38, 0) * A(90, 0, 0), 11, F.polymer)
			self:detail(function()
				for index = 0, 3 do
					self:box("ForeGripRib", V(31, 3, 3), CF(0, -24 - index * 12, -12.5), F.polymerDark)
				end
				self:cylY("ForeGripCap", 6, 26, CF(0, -79, 0), F.polymerDark)
			end)
		end)
	end)
end

-- A weapon light on a side rail clamp, pointing forward.
function Builder:weaponLight(at)
	self:at(at, function()
		self:box("TorchMount", V(12, 22, 30), CF(0, 0, 0), F.anodizedDark)
		self:cyl("Torch", 90, 24, CF(12, 0, -8), F.anodized)
		self:cyl("TorchBezel", 22, 30, CF(12, 0, -64), F.anodized)
		self:detail(function()
			for index = 0, 5 do
				self:box("TorchFin", V(26, 2.4, 40), CF(12, 0, -20 - index * FINE) * CFrame.Angles(0, 0, index / 6 * math.pi), F.anodizedDark)
			end
			self:cyl("TorchTail", 12, 20, CF(12, 0, 42), F.rubber)
		end)
		self:cyl("TorchLens", 2, 25, CF(12, 0, -74 + RELIEF), finish(255, 248, 225, Mat.Glass, 0.3, 0.2))
	end)
end

-- A laser module: a box with an emitter and an aiming lens. The viewmodel throws a beam from the
-- part named LaserEmitter while you aim.
function Builder:laserModule(at)
	self:at(at, function()
		self:prism("LaserBody", V(28, 24, 72), CF(0, 0, 0), 3, F.polymerDark)
		self:box("LaserMount", V(22, 8, 30), CF(0, 16, 4), F.anodizedDark)
		self:detail(function()
			self:box("LaserSwitch", V(8, 6, 14), CF(-9, 3, 36 + 7), F.rubber)
			self:cyl("LaserLens", 3, 10, CF(7, -4, -36 - 1.5 + RELIEF - 3), F.glass)
		end)
		self:cyl("LaserEmitter", 3, 6, CF(-7, -4, -36 - 1.5 + RELIEF - 3), F.laser)
	end)
end

-- A two-leg bipod folded forward under the barrel, hanging from a clamp at `at`.
function Builder:bipod(at, deployed)
	self:at(at, function()
		self:box("BipodMount", V(34, 16, 30), CF(0, -8, 0), F.anodizedDark)
		for _, sx in ipairs(SIGNS) do
			if deployed then
				self:at(CF(sx * 12, -16, 0) * A(0, 0, sx * 14), function()
					self:cylY("Bipod", 150, 10, CF(0, -75, 0), F.anodizedDark)
					self:cylY("Bipod", 70, 8, CF(0, -170, 0), F.steel)
					self:ball("BipodFoot", 14, CF(0, -206, 0), F.rubber)
				end)
			else
				self:at(CF(sx * 11, -20, 6), function()
					self:cyl("Bipod", 160, 10, CF(0, 0, -80), F.anodizedDark)
					self:cyl("Bipod", 40, 8, CF(0, 0, -180), F.steel)
					self:ball("BipodFoot", 13, CF(0, 0, -202), F.rubber)
				end)
			end
		end
	end)
end

-- A sling swivel: a loop standing off a side.
function Builder:slingLoop(at)
	self:detail(function()
		self:at(at, function()
			self:box("SlingLoop", V(4, 4, 18), CF(0, -7, 0), F.steel)
			for _, sz in ipairs(SIGNS) do
				self:box("SlingLoop", V(4, 10, 4), CF(0, -2, sz * 7), F.steel)
			end
		end)
	end)
end

-- Inlay along a side: a border above and below and a scrolling vine between them, each stroke laid end
-- to end with the next so no two overlap in the surface. `at` sits ON the surface (its x is the face),
-- so the inlay stands FINE proud of it. Gold by default; `look` changes it (dark inlay on a gold gun).
function Builder:engraving(at, length, height, look)
	if not self.micro then
		return
	end
	local inlay = look or F.goldDeep
	self:at(at, function()
		for _, sy in ipairs(SIGNS) do
			self:box("Engraving", V(FINE * 2, 1.1, length), CF(0, sy * height / 2, 0), inlay)
		end
		local waves = math.max(1, math.floor(length / 38 + 0.5))
		local steps = waves * 10
		local amplitude = height * 0.26
		local previous = nil
		for index = 0, steps do
			local t = index / steps
			local point = V(0, math.sin(t * waves * math.pi * 2) * amplitude, -length / 2 + 3 + t * (length - 6))
			if previous then
				local middle = (previous + point) / 2
				local stroke = point - previous
				self:box("Engraving", V(FINE * 2, 0.9, stroke.Magnitude), CFrame.lookAt(middle, middle + stroke), inlay)
			end
			-- A leaf off each crest.
			if index % 10 == 5 then
				local side = (math.floor(index / 10) % 2 == 0) and -1 or 1
				self:box("Engraving", V(FINE * 2, 0.9, height * 0.2), CF(point + V(0, side * height * 0.09, 2.5)) * A(side * 35, 0, 0), inlay)
			end
			previous = point
		end
	end)
end

-- A box magazine hanging from `at` (the middle of its top), built down its length in segments.
--   spec.width, spec.depth   across and front to back, mm
--   spec.segments            { {length, degrees}, ... } from the top down; positive degrees curve
--                            the bottom forward. Each segment turns about its FRONT edge and the
--                            wedge of a gap that opens at the back is filled exactly, so the curve
--                            has no steps and no two faces lie over each other in a plane. The old
--                            magazines overlapped rotated boxes, which kinked visibly at every joint
--                            and left the z-fight pass nudging their sides apart.
--   spec.ribs                "stanag" (two long pressed ribs a side, a stepped front spine and the
--                            catch window), "across" (the AK's pressed cross ribs) or nil
--   spec.caliber             diameter of the round showing in the feed lips, mm (nil for none)
--   spec.plate               the base plate's finish (default: the rarity's small-part finish)
function Builder:magazine(name, spec, at, look)
	local w, d = spec.width, spec.depth
	self:at(at, function()
		local frame = CFrame.identity
		for index, segment in ipairs(spec.segments) do
			local length, degrees = segment[1], segment[2]
			if degrees &gt; 0 then
				if index &gt; 1 then
					local gap = d * math.tan(math.rad(degrees))
					self:wedge(name .. "Joint", V(w, gap, d), frame * CF(0, -gap / 2, 0) * CFrame.Angles(0, 0, math.pi), look)
				end
				frame = frame * CF(0, 0, -d / 2) * A(degrees, 0, 0) * CF(0, 0, d / 2)
			end
			self:box(name, V(w, length, d), frame * CF(0, -length / 2, 0), look)
			if self.micro and spec.ribs == "stanag" then
				local top = index == 1 and 34 or 0
				local ribLength = length - top
				for _, sx in ipairs(SIGNS) do
					for _, rz in ipairs({ -0.2, 0.2 }) do
						self:box(name .. "Rib", V(FINE * 2, ribLength, 5), frame * CF(sx * w / 2, -top - ribLength / 2, rz * d), look)
					end
				end
				self:box(name .. "Spine", V(w * 0.46, length, FINE * 2), frame * CF(0, -length / 2, -d / 2), look)
				if index == 1 then
					self:box(name .. "Catch", V(FINE * 2, 9, 11), frame * CF(-w / 2, -22, d / 2 - 15), F.shadow)
				end
			elseif self.micro and spec.ribs == "across" then
				local bands = math.max(1, math.floor(length / 26))
				for band = 1, bands do
					self:box(name .. "Rib", V(w + FINE * 2, 5, d - 16), frame * CF(0, -length * band / (bands + 1), 3), look)
				end
			end
			frame = frame * CF(0, -length, 0)
		end
		self:prism(name .. "Plate", V(w + 4, 7, d + 5), frame * CF(0, -3.5, -1), 2, spec.plate or self:finish("small"), "bottom")
		if spec.caliber then
			-- Feed lips and the top round: a brass case with its copper bullet pointing forward.
			local c = spec.caliber
			for _, sx in ipairs(SIGNS) do
				self:box(name .. "Lip", V(2.5, 4, d * 0.62), CF(sx * (w / 2 - 1.25), 2, d * 0.1), look)
			end
			self:cyl(name .. "Round", d * 0.58, c, CF(-w * 0.12, c / 2 - 1, d * 0.12), F.brass)
			self:cyl(name .. "Bullet", d * 0.2, c * 0.8, CF(-w * 0.12, c / 2 - 1, d * 0.12 - d * 0.39), F.copper)
		end
	end)
end

-- A drum magazine: a feed tower into the magwell and the drum below it, a raised cover with a ring of
-- rivets and the winding key in the middle of each side.
function Builder:drumMag(name, diameter, thickness, at, look)
	self:at(at, function()
		self:box(name, V(20, 42, 34), CF(0, -21, 0), look)
		local centre = CF(0, -42 - diameter / 2 + 8, -2)
		self:cylX(name, thickness, diameter, centre, look)
		for _, sx in ipairs(SIGNS) do
			self:cylX(name .. "Cover", RELIEF, diameter * 0.8, centre * CF(sx * (thickness / 2 + RELIEF / 2), 0, 0), F.polymerDark)
			self:cylX(name .. "Key", RELIEF * 2, 16, centre * CF(sx * (thickness / 2 + RELIEF * 2), 0, 0), self:finish("small"))
			self:box(name .. "KeyBar", V(RELIEF, 5, 24), centre * CF(sx * (thickness / 2 + RELIEF * 3 + RELIEF / 2), 0, 0), self:finish("small"))
			if self.micro then
				for index = 0, 7 do
					local angle = index / 8 * math.pi * 2
					self:cylX(name .. "Rivet", FINE * 2, 4, centre * CF(sx * (thickness / 2 + RELIEF + FINE), math.cos(angle) * diameter * 0.32, math.sin(angle) * diameter * 0.32), F.steel)
				end
			end
		end
	end)
end

-- A pistol grip hanging from `at` (the middle of its top, where it meets the frame), raked back `rake`
-- degrees. Its cross-section is a teardrop, the way a real grip's is: a narrow rounded front strap, a
-- wide rounded backstrap and flanks tapering between them. The old grip was a rounded brick.
--   spec.length, spec.depth   mm
--   spec.front, spec.back     front strap and backstrap widths
--   spec.nub                  an A2 grip's finger nub on the front strap
--   spec.grooves              finger grooves down the front strap
-- Polymer grips come out in textured plastic. The core carries the name Grip. Returns the grip's
-- frame, for anything hung off it.
function Builder:grip(at, rake, look, spec)
	local frame = place(at) * A(-(rake or 18), 0, 0)
	local length = spec.length or 100
	local depth = spec.depth or 46
	local wf = spec.front or 22
	local wb = spec.back or 30
	local zf = -depth / 2 + wf / 2
	local zb = depth / 2 - wb / 2
	-- spec.top carries the grip's front (its core and front rounding) that far on up past its top, into the
	-- frame above: a raked grip's top edge dips below a level frame at the front, and this fills that
	-- wedge instead of leaving air. spec.name renames the pieces (a magazine's grip-shaped extension).
	local top = spec.top or 0
	local name = spec.name or "Grip"
	if look.material == Mat.SmoothPlastic then
		look = finishOf(look.color:Lerp(Color3.new(0, 0, 0), 0.08), Mat.Plastic)
	end
	self:at(frame, function()
		self:box(name, V(wf, length + top, zb - zf), CF(0, (top - length) / 2, (zf + zb) / 2), look)
		self:cylY(name .. "Front", length + top - FINE * 2, wf, CF(0, (top - length) / 2, zf), look)
		self:cylY(name .. "Back", length - FINE * 2, wb, CF(0, -length / 2, zb), look)
		if wb - wf &gt;= 1 then
			for _, sx in ipairs(SIGNS) do
				self:wedge(name .. "Flank", V(length, (wb - wf) / 2, zb - zf),
					CFrame.fromMatrix(V(sx * (wf / 2 + (wb - wf) / 4), -length / 2, (zf + zb) / 2), V(0, -sx, 0), V(sx, 0, 0), V(0, 0, 1)), look)
			end
		end
		if spec.nub then
			self:cylX(name .. "Nub", wf - 4, 13, CF(0, -length * 0.36, -depth / 2 + 3.5), look)
		end
		for index = 1, spec.grooves or 0 do
			self:cylX(name .. "Groove", wf - 4, 9, CF(0, -length * (0.14 + index * 0.21), -depth / 2 + 2), look)
		end
	end)
	return frame
end

--------------------------------------------------------------------------------
-- Silhouettes
--------------------------------------------------------------------------------

local STYLES = {}

-- A ventilated heat shield over the top of a barrel: a half shell of staves standing off the barrel,
-- with rows of vent slots down its upper flanks. Cutting the staves into segments made the top line
-- read as battlements from the side; a real shield's outline is smooth and its vents are in its face.
function Builder:heatShield(at, length, radius, barrel)
	barrel = barrel or radius - 8
	self:at(at, function()
		for _, degrees in ipairs({ -72, -36, 0, 36, 72 }) do
			local around = CFrame.Angles(0, 0, math.rad(degrees))
			local width = 2 * radius * math.tan(math.pi / 10) + 0.5
			self:box("Shroud", V(width, 2.5, length), around * CF(0, radius, 0), F.nitride)
			if math.abs(degrees) == 36 then
				local vents = math.floor((length - 20) / 24)
				for index = 0, vents - 1 do
					self:box("ShroudVent", V(width * 0.5, FINE * 2, 14), around * CF(0, radius + 1.25, -(vents - 1) * 12 + index * 24), F.shadow)
				end
			end
		end
		-- The clamp: a plate each side down past the barrel, and a strap under the barrel between them,
		-- so the shield is held on the barrel rather than hovering round it.
		local top, bottom = radius * 0.25, -(barrel + 3.5)
		for _, sx in ipairs(SIGNS) do
			self:box("ShroudClamp", V(4, top - bottom, 18), CF(sx * radius * 0.95, (top + bottom) / 2, -length / 2 + 14), F.nitride)
		end
		self:box("ShroudClamp", V(radius * 1.9 + 3, 4, 16), CF(0, -(barrel + 1.5), -length / 2 + 14), F.nitride)
	end)
end

-- The AR family, measured off an M4 carbine: a flat-top upper with the ejection port, forward assist and
-- brass deflector, a lower whose rear rises into the buffer tower, a flared magwell, a free-float
-- M-LOK handguard with real slots, a curved 30-round magazine, a stock covering nearly all of its
-- buffer tube, and a birdcage. Trigger at z=0, bore at y=0: the upper runs from -18 to +21 with its
-- rail to +30.5, the lower down to -48 and the magwell to -68, which is why the magazine and grip hang
-- as low as they do on the real thing.
--
-- The same machinery builds every AR-pattern gun at its own proportions: `spec.scale`
-- enlarges the whole receiver group for the .308 AR-10s and the 12-gauge MKA-style shotgun (their
-- receivers really are that much bigger), and the rest of `spec` swaps the parts that differ.
--   spec.scale        receiver scale (1 for 5.56)
--   spec.hgLength     handguard length, spec.barrelEnd where the barrel stops (both before scaling)
--   spec.barrelDia    barrel diameter
--   spec.muzzle       "birdcage", "brake" or "choke"
--   spec.optic        nil (red dot, or the variant's holo/irons), "lpvo" or "long"
--   spec.mag          a function(g) building the magazine, or nil for a STANAG
--   spec.stock        "m4" or "precision"
--   spec.heatShield, spec.bipod, spec.flutes
local function buildAR(g, spec)
	spec = spec or {}
	local v = g.variant
	g.scale = spec.scale or 1
	local receiver = g:finish("receiver")
	local handguardFinish = g:finish("handguard")
	local furniture = v.camo and F.fde or g:finish("furniture")
	local small = g:finish("small")
	local compact = v.compact
	local hgLength = spec.hgLength or (compact and 226 or 306)
	local barrelEnd = spec.barrelEnd or (compact and -380 or -480)
	local barrelDia = spec.barrelDia or 17

	-- Upper receiver: the right wall is built round a real ejection port with the bolt carrier recessed
	-- inside it, rather than a dark plate on the outside.
	local upper = g:prism("Receiver", V(30, 16, 170), CF(0, 13, -15), 4, receiver, "top")
	g:box("UpperWall", V(15, 23, 170), CF(-7.5, -6.5, -15), receiver)
	g:box("UpperWall", V(15, 8, 170), CF(7.5, -14, -15), receiver)
	g:box("UpperWall", V(15, 15, 72), CF(7.5, -2.5, 34), receiver)
	g:box("UpperWall", V(15, 15, 38), CF(7.5, -2.5, -81), receiver)
	g:box("EjectionPort", V(3.5, 15, 60), CF(5.25, -2.5, -32), F.shadow)
	g:group("bolt", function()
		g:box("BoltCarrier", V(11.5, 13, 44), CF(5.75, -2.5, -28), F.nitride)
		g:box("BoltLug", V(11.5, 5, 8), CF(5.75, -2.5, -54), F.steel)
	end)
	g:box("DustCover", V(2, 22, 58), CF(19.5, -20, -32) * A(0, 0, 60), receiver)
	g:detail(function()
		g:box("DustCoverLatch", V(4, 5, 8), CF(24, -26, -8) * A(0, 0, 60), F.steel)
	end)
	g:travel("bolt", 70)
	g:key("Eject", CF(20, -2, -32) * A(0, -70, 0))
	g:rail("UpperRail", 145, CF(0, 21, -22.5))
	g:detail(function()
		-- The forward assist boss and the brass deflector behind the port.
		g:cyl("ForwardAssist", 34, 17, CF(14, 9, 38), receiver)
		g:cyl("ForwardAssistButton", 7, 13, CF(14, 9, 58.5), F.anodizedDark)
		-- The knurled rim stands a little proud of the receiver's side, as the real knob does (level with
		-- it, the rib's end fought the receiver face).
		-- Turned an eighth of a rib, so no rib's side lies in the plane of the receiver's side.
		g:ridges("ForwardAssistRib", 8, 2.5, 8.8, 1.6, 1.6, CF(14, 9, 62.5) * CFrame.Angles(0, 0, math.pi / 8), F.anodizedDark)
		g:wedge("Deflector", V(8, 13, 16), CF(18.5, 10, 10) * A(0, 180, 0), receiver)
	end)

	-- Charging handle: the T-handle over the back of the upper, latch on the left.
	g:group("charge", function()
		g:box("ChargingHandle", V(16, 7, 40), CF(0, 24.5, 75), F.anodizedDark)
		g:prism("ChargingHandleWings", V(50, 9, 13), CF(0, 24.5, 101.5), 2.5, F.anodizedDark)
		g:detail(function()
			g:box("ChargingHandleLatch", V(9, 6, 11), CF(-21, 24.5, 90), small)
		end)
	end)
	g:travel("charge", 64)
	g:hand("ChargeHand", V(-30, 34, 104), V(0.75, -0.25, 0.6), V(-0.3, 1, 0.2))

	-- Lower receiver, the buffer tower rising at its back, the magwell hanging under its front.
	g:prism("Lower", V(26, 30, 190), CF(0, -33, 0), 3, receiver, "bottom")
	g:rounded("BufferTower", V(24, 36, 25), CF(0, -2, 82.5), 11, receiver)
	g:prism("MagWell", V(33, 22, 76), CF(0, -57, -57), 4, receiver, "bottom")
	g:wedge("MagWellFlare", V(33, 12, 14), CF(0, -62, -102), receiver)
	g:cyl("CastleNut", 8, 34, CF(0, -3, 99), F.parkerized)
	g:detail(function()
		g:ridges("CastleNutNotch", 8, 13, 18.25, 6, 5, CF(0, -3, 99), F.parkerized)
		g:cylX("MagRelease", 7, 11, CF(16.5, -38, -12), small)
		g:box("BoltCatch", V(3.5, 18, 10), CF(-14.75, -30, -10), small)
		g:at(CF(-15, -33, 40), function()
			g:cylX("Selector", 3.5, 12, CF(0, 0, 0), F.anodizedDark)
			g:box("SelectorLever", V(3.5, 5, 17), CF(-1, 0, -7) * A(-25, 0, 0), small)
		end)
		g:pin("PivotPin", 7, CF(0, -24, -88), F.anodizedDark, 33)
		g:pin("TakedownPin", 7, CF(0, -24, 64), F.anodizedDark, 33)
		g:pin("TriggerPin", 5, CF(0, -40, 4), F.steel, 33)
		g:pin("HammerPin", 5, CF(0, -40, 26), F.steel, 33)
	end)

	-- Trigger guard and trigger.
	g:box("TriggerGuard", V(12, 6, 58), CF(0, -73, 10), receiver)
	g:box("TriggerGuard", V(12, 24, 7), CF(0, -58, 38), receiver)
	g:group("trigger", function()
		g:box("Trigger", V(6, 20, 6), CF(0, -57, -2) * A(-12, 0, 0), small)
	end)
	g:swing("trigger", CF(0, -47, 0), 12)

	-- A2 pistol grip.
	g:grip(V(0, -48, 64), 22, furniture, { length = 106, depth = 48, front = 22, back = 31, nub = true })
	g:hand("GripHand", V(31, -88, 86), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	-- Magazine.
	g:group("mag", function()
		if spec.mag then
			spec.mag(g)
		else
			g:magazine("Magazine", { width = 22.5, depth = 62, segments = { { 62, 0 }, { 24, 4 }, { 24, 4 }, { 24, 4 }, { 24, 4 } }, ribs = "stanag", caliber = 9.5 },
				CF(0, -52, -57), F.anodizedDark)
		end
	end)
	g:key("MagWell", CF(0, -52, -57))
	g:hand("MagHand", V(-28, -120, -62), V(0.4, 0.25, -0.15), V(-1, -0.15, 0))

	-- Buffer tube and stock.
	if spec.stock == "precision" then
		-- A fixed precision stock: a long body over the tube with a raised cheek riser on posts, a lower
		-- hook running back to an adjustable butt plate, and a monopod under it.
		g:cyl("BufferTube", 60, 30, CF(0, -3, 133), F.anodizedDark)
		g:rounded("Stock", V(42, 44, 240), CF(0, -2, 222), 12, furniture)
		g:prism("StockCheek", V(36, 16, 150), CF(0, 36, 230), 5, furniture, "top")
		for _, z in ipairs({ 180, 280 }) do
			g:cylY("StockCheekPost", 12, 9, CF(0, 23, z), F.anodizedDark)
		end
		g:box("StockHook", V(32, 22, 176), CF(0, -82, 256), furniture)
		g:box("StockHook", V(34, 60, 30), CF(0, -41, 326), furniture)
		g:prism("Buttpad", V(46, 150, 18), CF(0, -38, 350), 4, F.rubber)
		g:detail(function()
			g:cylY("Monopod", 40, 16, CF(0, -113, 290), F.anodizedDark)
			g:cylY("MonopodFoot", 8, 24, CF(0, -137, 290), F.rubber)
			g:cylX("StockKnob", 10, 18, CF(25.5, 2, 230), F.anodizedDark)
		end)
	else
		-- M4 stock, riding most of the way up the tube as it does in its second position.
		g:cyl("BufferTube", 177, 30, CF(0, -3, 191.5), F.anodizedDark)
		g:at(CF(0, 0, 205), function()
			g:rounded("Stock", V(40, 42, 150), CF(0, -3, 0), 13, furniture)
			g:prism("StockCheek", V(34, 8, 120), CF(0, 22, 10), 3, furniture, "top")
			g:wedge("StockWeb", V(34, 76, 130), CF(0, -60, 10) * A(0, 0, 180), furniture)
			g:rounded("Buttpad", V(44, 20, 128), CF(0, -38, 83) * A(90, 0, 0), 8, F.rubber)
			g:box("StockLever", V(10, 12, 40), CF(0, -30, -32), F.polymerDark)
			g:detail(function()
				g:cylX("StockQD", 7, 14, CF(-23.5, -8, 50), F.anodizedDark)
				g:slingLoop(CF(0, -98, 70))
			end)
		end)
	end

	-- Handguard: a free-float M-LOK tube whose walls are frames, so the slots are holes with the
	-- barrel showing through.
	local hgFront = -103 - hgLength
	local hgZ = -103 - hgLength / 2
	local hw, hh = 44, 50
	g:at(CF(0, -4, hgZ), function()
		-- M-LOK slots are 7mm x 32mm on 40mm centres; these are a touch taller so they read at arm's length.
		local slab = (hh - 10) / 2
		g:prism("Handguard", V(hw, slab, hgLength), CF(0, hh / 2 - slab / 2, 0), 8, handguardFinish, "top")
		g:prism("Handguard", V(hw, slab, hgLength), CF(0, -hh / 2 + slab / 2, 0), 8, handguardFinish, "bottom")
		local slotLength, post = 32, 10
		local slots = math.floor((hgLength - 40) / (slotLength + post))
		local run = slots * slotLength + (slots + 1) * post
		local ends = (hgLength - run) / 2
		for _, sx in ipairs(SIGNS) do
			local x = sx * (hw / 2 - 2.5)
			for index = 0, slots do
				g:box("HandguardPost", V(5, 10, post), CF(x, 0, -run / 2 + post / 2 + index * (slotLength + post)), handguardFinish)
			end
			for _, sz in ipairs(SIGNS) do
				g:box("HandguardPost", V(5, 10, ends), CF(x, 0, sz * (run / 2 + ends / 2)), handguardFinish)
			end
		end
		g:box("HandguardCap", V(hw - 14, 10, 5), CF(0, 0, -hgLength / 2 + 6), F.anodizedDark)
		g:rail("HandguardRail", hgLength - 8, CF(0, hh / 2, 0))
		g:cylX("SlingCup", 7, 14, CF(-(hw / 2 + 3.5), -hh / 2 + 13, hgLength / 2 - 30), F.anodizedDark)
	end)
	g:hand("SupportHand", V(-10, -48, hgZ - hgLength * 0.1), V(0.8, 0.45, -0.3), V(-0.35, -1, 0))

	-- Barrel and muzzle device.
	g:cyl("Barrel", -100 - barrelEnd, barrelDia, CF(0, 0, (barrelEnd - 100) / 2), F.nitride)
	if spec.flutes then
		g:detail(function()
			local run = -hgFront + barrelEnd - 20
			for index = 0, 5 do
				local angle = (index + 0.5) / 6 * math.pi * 2
				g:box("Flute", V(4, FINE * 2, run), CF(0, 0, hgFront - 10 - run / 2) * CFrame.Angles(0, 0, angle) * CF(0, barrelDia / 2 - 0.5, 0), F.shadow)
			end
		end)
	end
	if spec.heatShield then
		g:heatShield(CF(0, 0, (hgFront + barrelEnd) / 2 - 10), -barrelEnd + hgFront - 40, barrelDia / 2 + 8)
	end
	local muzzleZ
	if spec.muzzle == "brake" then
		muzzleZ = barrelEnd + g:brake(CF(0, 0, barrelEnd), barrelDia + 9, 64)
	elseif spec.muzzle == "choke" then
		g:cyl("MuzzleBrake", 36, barrelDia + 5, CF(0, 0, barrelEnd - 18), F.nitride)
		g:detail(function()
			for index = 0, 3 do
				g:cyl("MuzzleBrakeRing", 4, barrelDia + 7.8, CF(0, 0, barrelEnd - 6 - index * 8), F.anodizedDark)
			end
		end)
		g:cyl("Bore", FINE, barrelDia - 3, CF(0, 0, barrelEnd - 36 - FINE / 2), F.bore)
		muzzleZ = barrelEnd - 38
	else
		muzzleZ = barrelEnd + g:birdcage(CF(0, 0, barrelEnd), 22)
	end
	g:key("Muzzle", CF(0, 0, muzzleZ))

	-- Sights, on the rail 30.5mm over the bore: a red dot or holo's window and the irons' aperture
	-- share the 66mm line an M4's own sights use; scopes sit higher on their mounts.
	local railTop = 30.5
	if spec.optic == "lpvo" or spec.optic == "long" then
		local h = g:scope(CF(0, railTop, -15), spec.optic)
		g:key("Sight", CF(0, railTop + h, 150))
		g.model:SetAttribute("Optic", "scope")
		g.model:SetAttribute("EyeRelief", 0.6)
	elseif v.holo then
		local h = g:holo(CF(0, railTop, -30))
		g:key("Sight", CF(0, railTop + h, 50))
		g.model:SetAttribute("Optic", "holo")
		g.model:SetAttribute("EyeRelief", 0.62)
	elseif v.irons then
		g:rearAperture(CF(0, railTop, 30), 36)
		g:frontPost(CF(0, -4 + hh / 2 + 9.5, hgFront + 26), 36 + (railTop - (-4 + hh / 2 + 9.5)))
		g:key("Sight", CF(0, railTop + 36, 40))
		g.model:SetAttribute("Optic", "iron")
		-- Cheek on the stock, the eye a few centimetres behind the aperture.
		g.model:SetAttribute("EyeRelief", 0.3)
	else
		local h = g:redDot(CF(0, railTop, -20))
		g:key("Sight", CF(0, railTop + h, 45))
		g.model:SetAttribute("Optic", "reddot")
		g.model:SetAttribute("EyeRelief", 0.66)
	end

	if v.foregrip then
		local z = hgZ - hgLength * 0.14
		g:foregrip(CF(0, -4 - hh / 2, z))
		g:hand("SupportHand", V(-27, -80, z + 6), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))
	end
	if spec.bipod then
		g:bipod(CF(0, -4 - hh / 2, hgFront + 40))
	end
	if v.light then
		g:weaponLight(CF(-(hw / 2 + 6), 4, hgFront + 58) * A(0, 0, 180))
	end
	if v.laser then
		g:laserModule(CF(0, -4 - hh / 2 - 16, hgFront + 50))
	end
	if v.engraved or g.rarityIndex &gt;= 5 then
		for _, sx in ipairs(SIGNS) do
			g:engraving(CF(sx * 13, -33, 30), 96, 16)
		end
	end

	g.model:SetAttribute("Action", spec.action or "ar")
	g.model:SetAttribute("Flash", v.suppressor and "suppressed" or spec.flash or "rifle")
	g.model:SetAttribute("Casing", spec.casing or "rifle")
	return upper
end

-- The .308 magazine for the AR-10s: straighter and deeper than a 5.56 one.
local function magazine308(g)
	g:magazine("Magazine", { width = 24, depth = 70, segments = { { 64, 0 }, { 30, 3 }, { 30, 3 } }, ribs = "stanag", caliber = 10.5 },
		CF(0, -52, -57), F.anodizedDark)
end

-- The AK, measured off an AKM: a long stamped receiver with a ribbed top cover and the rear sight
-- block at its front, the charging handle riding the bolt carrier on the right, the big safety
-- lever, a strongly curved ribbed magazine rocked into the receiver, wooden handguards over and
-- under the gas tube, the front sight tower and a slant brake, and a wooden stock whose top line
-- runs level with the bore.
local function buildAK(g)
	local v = g.variant
	local metal = g.skinned and g.skin or F.nitride
	local wood = v.woodFurniture and F.wood or g:finish("furniture")
	local small = g:finish("small")

	-- Receiver body, with a real ejection port in the right wall at high detail.
	local body
	if g.high then
		body = g:box("Receiver", V(15, 38, 297), CF(-7.5, -7, -36.5), metal)
		g:box("ReceiverWall", V(15, 18, 297), CF(7.5, -17, -36.5), metal)
		g:box("ReceiverWall", V(15, 20, 190), CF(7.5, 2, 17), metal)
		g:box("ReceiverWall", V(15, 20, 37), CF(7.5, 2, -166.5), metal)
		-- Stops short of the handguard, whose cap's side it otherwise lay level with.
		g:box("EjectionPort", V(3.5, 20, 64), CF(5.25, 2, -110), F.shadow)
	else
		body = g:box("Receiver", V(30, 38, 297), CF(0, -7, -36.5), metal)
		g:box("EjectionPort", V(3.5, 20, 70), CF(16.25, 2, -113), F.shadow)
	end
	-- The carrier and its charging handle, which reciprocate together.
	g:group("bolt", function()
		g:box("BoltCarrier", V(11.5, 16, 64), CF(5.75, 2, -114), F.steel)
		g:box("ChargingHandle", V(24, 7, 9), CF(22, 6, -86), F.steel)
		g:ball("ChargingKnob", 12, CF(36, 6, -86), F.steel)
	end)
	g:travel("bolt", 110)
	-- Turned 30 degrees on the palm and tilted 30 so the wrist is not bent past 60 degrees working it (it was 98): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(40, 26, -80), V(0.41, -0.74, -0.53), V(0.57, -0.25, 0.78))
	g:key("Eject", CF(20, 4, -113) * A(0, -75, 0))

	-- Top cover: rounded, ribbed, with the latch button out the back.
	g:prism("TopCover", V(29, 18, 262), CF(0, 21, -19), 7, metal, "top")
	g:detail(function()
		for index = 0, 2 do
			g:box("TopCoverRib", V(22, 5, 7), CF(0, 31.5, 20 + index * 30), metal)
		end
		g:cyl("CoverLatch", 12, 12, CF(0, 8, 118), F.steel)
		-- Rivets: trunnion and trigger group.
		for _, rivet in ipairs({ { -150, -18 }, { -165, -18 }, { -30, -24 }, { 15, -24 }, { 50, -24 }, { -150, 4 } }) do
			g:pin("Rivet", 6, CF(0, rivet[2], rivet[1]), F.steel, 30 + 7)
		end
	end)
	-- The safety lever: a long plate down the right side, pivoting at the back.
	g:group("safety", function()
		g:box("SafetyLever", V(3.5, 11, 118), CF(16.75, -2, 40) * A(-6, 0, 0), F.parkerized)
		g:box("SafetyTab", V(9, 12, 12), CF(20.5, -9, -16), F.parkerized)
	end)

	-- Rear sight block and leaf, on the trunnion at the front of the receiver.
	g:box("RearSightBlock", V(26, 14, 40), CF(0, 19, -166), metal)
	g:box("RearSight", V(18, 4, 62), CF(0, 30, -154) * A(-6, 0, 0), metal)
	g:detail(function()
		g:box("RearSightSlider", V(22, 7, 10), CF(0, 31, -170), metal)
		-- The notch is a real U: two blades with the front post showing between them, and a shallower
		-- web at the bottom, so the sight picture is the post's tip level with the blade tops.
		for _, sx in ipairs(SIGNS) do
			g:box("RearSightNotch", V(7.5, 13, 4), CF(sx * 5.25, 39.5, -124), metal)
		end
		g:box("RearSightNotch", V(3.5, 8, 3), CF(0, 38, -124), metal)
	end)

	-- Gas tube with the upper handguard over it, gas block, lower handguard round the barrel.
	g:cyl("GasTube", 30, 19, CF(0, 25, -334), metal)
	g:rounded("HandguardUpper", V(30, 20, 118), CF(0, 27, -245), 9, wood)
	g:box("GasBlock", V(24, 34, 26), CF(0, 12, -360), metal)
	g:rounded("Handguard", V(42, 44, 158), CF(0, -3, -224), 14, wood)
	g:detail(function()
		for _, sx in ipairs(SIGNS) do
			g:box("HandguardSwell", V(3.5, 16, 96), CF(sx * 22.75, -12, -230), wood)
		end
		g:cyl("HandguardFerrule", 8, 40, CF(0, -3, -307), metal)
		g:box("HandguardRetainer", V(34, 10, 24), CF(0, -4, -150), metal)
	end)
	g:hand("SupportHand", V(-6, -38, -220), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))

	-- Barrel, front sight tower, cleaning rod, slant brake.
	g:cyl("Barrel", 300, 18, CF(0, 0, -335), F.nitride)
	g:box("FrontSightBase", V(22, 24, 44), CF(0, 2, -478), metal)
	for _, sx in ipairs(SIGNS) do
		g:box("FrontSightEar", V(4, 36, 14), CF(sx * 10, 30, -482), metal)
	end
	g:box("FrontSightPost", V(4, 17.5, 4), CF(0, 22.75, -482), metal)
	g:box("FrontSight", V(2.4, 15, 3), CF(0, 38.5, -482), metal)
	g:detail(function()
		g:cyl("CleaningRod", 215, 6, CF(0, -15, -410), F.steel)
		g:box("BayonetLug", V(10, 8, 20), CF(0, -13, -468), metal)
	end)
	g:at(CF(0, 0, -500), function()
		g:cyl("MuzzleBrake", 36, 22, CF(0, 0, -18), F.nitride)
		g:detail(function()
			g:wedge("MuzzleBrakeSlant", V(22.5, 10, 18), CF(0, 6, -31) * A(0, 180, 0), F.nitride)
			g:cyl("Bore", FINE, 9, CF(0, 0, -36 - FINE / 2), F.bore)
		end)
	end)
	g:key("Muzzle", CF(0, 0, -536))

	-- Trigger guard, trigger, magazine release paddle.
	g:box("TriggerGuard", V(12, 5, 70), CF(0, -47, 2), metal)
	g:box("TriggerGuard", V(12, 22, 6), CF(0, -34, 36), metal)
	g:group("trigger", function()
		g:box("Trigger", V(6, 20, 6), CF(0, -34, -4) * A(-12, 0, 0), F.steel)
	end)
	g:swing("trigger", CF(0, -26, -2), 12)
	g:box("MagRelease", V(20, 12, 8), CF(0, -32, -32) * A(-20, 0, 0), F.steel)

	-- Pistol grip.
	g:grip(V(0, -26, 78), 20, v.woodFurniture and F.woodDark or g:finish("furniture"), { length = 100, depth = 44, front = 22, back = 29, grooves = 0 })
	g:hand("GripHand", V(31, -64, 98), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	-- Magazine: the AK's strong curve, ribbed across the sides.
	g:group("mag", function()
		g:magazine("Magazine", { width = 26, depth = 72, segments = { { 38, 0 }, { 28, 8 }, { 28, 8 }, { 28, 8 }, { 28, 8 }, { 28, 8 } }, ribs = "across", caliber = 11 }, CF(0, -24, -80), F.steelMag)
	end)
	g:key("MagWell", CF(0, -24, -80))
	g:hand("MagHand", V(-30, -112, -120), V(0.4, 0.25, -0.2), V(-1, -0.15, 0))

	-- Stock: level top line, the lower edge sweeping down to the heel, a steel buttplate.
	g:at(CF(0, 0, 112), function()
		g:rounded("Stock", V(32, 36, 228), CF(0, -13, 114), 10, wood)
		g:wedge("StockWeb", V(30, 64, 214), CF(0, -63, 121) * A(0, 0, 180), wood)
		g:box("Buttplate", V(38, 104, 6), CF(0, -46, 231), metal)
		g:detail(function()
			g:box("StockTang", V(14, 4, 60), CF(0, 5, 26), metal)
			-- Its posts sunk into the stock's web, which slopes up toward the grip.
			g:slingLoop(CF(0, -85, 200))
		end)
	end)

	if v.bayonet then
		-- AKM-pattern bayonet: a ring over the barrel behind the brake, the grip under the gas block,
		-- a clipped blade running past the muzzle.
		g:at(CF(0, -30, 0), function()
			g:cyl("BayonetRing", 12, 30, CF(0, 30, -493), F.nitride)
			g:rounded("BayonetGrip", V(18, 26, 116), CF(0, -2, -410), 8, F.woodDark)
			g:box("BayonetGuard", V(22, 38, 8), CF(0, 5, -472), F.nitride)
			g:box("Bayonet", V(3.6, 24, 128), CF(0, -2, -540), F.bright)
			g:wedge("BayonetTip", V(3.6, 24, 34), CF(0, -2, -621), F.bright)
			g:detail(function()
				g:box("BayonetFuller", V(3.6 + FINE * 2, 5, 90), CF(0, 2, -534), F.steel)
			end)
		end)
	end

	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 0.52)
	g:key("Sight", CF(0, 46, -118))
	g.model:SetAttribute("Action", "ak")
	g.model:SetAttribute("Flash", "rifle")
	g.model:SetAttribute("Casing", "rifle")
	return body
end

STYLES.rifle = function(g)
	if g.variant.pattern == "ak" then
		return buildAK(g)
	end
	return buildAR(g)
end

-- The pistol, measured off a Glock 17: a 188mm slide 25.5mm wide and 22mm tall with rear
-- serrations cut into its sides, the barrel hood showing in the ejection port, a polymer frame with
-- its rail groove and the trigger hanging from it, the squared trigger guard, a grip raked back 15
-- degrees with a stippled panel and a modest beavertail, and the magazine's base plate under it. The
-- compact variant is the subcompact: a 160mm slide and a grip two fingers tall with a pinky
-- extension on the magazine.
STYLES.pistol = function(g)
	local v = g.variant
	local compact = v.compact
	local slideFinish = g.skinned and g.skin or (g.rarityIndex &gt;= 3 and g:finish("slide") or F.nitride)
	-- A polymer frame is as black as the slide on the real pistol; plain polymer read grey beside it.
	local frame = g:finish("furniture")
	if frame == F.polymer then
		frame = F.polymerDark
	end
	local small = g:finish("small")
	local front = compact and -94 or -111
	local back = compact and 66 or 77
	local gripLength = compact and 74 or 100

	-- Slide, in sections so the ejection port and the serrations are real openings and cuts.
	local slide
	g:group("slide", function()
		slide = g:prism("Slide", V(25.5, 22, -35 - front), CF(0, 1, (front - 35) / 2), 3, slideFinish, "top")
		-- Port: the slide's floor and left wall, and the barrel hood filling the opening the way the chamber
		-- block does on the real pistol, its top and right face 1.5 mm inside the slide's (a hood sunk deep
		-- in the port read as a hole through the slide).
		g:box("SlidePort", V(25.5, 12, 50), CF(0, -4, -10), slideFinish)
		g:prism("SlidePort", V(9.5, 10, 50), CF(-8, 7, -10), 3, slideFinish, "top")
		g:box("BarrelHood", V(16, 10, 44), CF(3.25, 5.5, -10), F.nitride)
		-- Rear: a plain band, the serrations, the back plate.
		g:prism("Slide", V(25.5, 22, 25), CF(0, 1, 27.5), 3, slideFinish, "top")
		local serrationEnd = back - 5
		g:box("SlideCore", V(19.5, 18, serrationEnd - 40), CF(0, -1, (serrationEnd + 40) / 2), slideFinish)
		g:prism("Slide", V(25.5, 4, serrationEnd - 40), CF(0, 10, (serrationEnd + 40) / 2), 3, slideFinish, "top")
		local ridges = math.floor((serrationEnd - 40) / 4)
		for index = 0, ridges - 1 do
			g:box("SlideSerration", V(25.5, 15, 2), CF(0, -1, 42 + index * 4), slideFinish)
		end
		g:prism("Slide", V(25.5, 22, 5), CF(0, 1, back - 2.5), 3, slideFinish, "top")
		-- Sights: a dovetailed front post and a notched rear, both with dots.
		g:box("FrontSight", V(3.5, 6, 6), CF(0, 15, front + 10), F.nitride)
		g:box("RearSight", V(8, 6, 7), CF(-7, 15, back - 12), F.nitride)
		g:box("RearSight", V(8, 6, 7), CF(7, 15, back - 12), F.nitride)
		g:box("RearSightBase", V(6, 2.5, 7), CF(0, 13.25, back - 12), F.nitride)
		g:detail(function()
			g:ball("SightDot", 2, CF(0, 16.5, front + 13.2), F.tritium)
			for _, sx in ipairs(SIGNS) do
				g:ball("SightDot", 2, CF(sx * 7, 16.5, back - 8.2), F.tritium)
			end
		end)
		-- The bore in the slide's nose.
		g:cyl("Bore", FINE, 9.5, CF(0, 0, front - FINE / 2), F.bore)
	end)
	g:travel("slide", 58)
	g:key("Eject", CF(14, 8, -10) * A(0, -60, 0))
	g:key("Sight", CF(0, 18, back - 6))
	g:hand("ChargeHand", V(-4, 34, back - 22), V(1, -0.45, 0.1), V(0, 1, 0.1))

	-- Frame: the dust cover with its rail groove, the frame over the trigger, slide stop and takedown.
	local dustFront = front + 5
	local dustLength = -28 - dustFront
	g:at(CF(0, 0, dustFront + dustLength / 2), function()
		g:box("Frame", V(24, 5, dustLength), CF(0, -12.5, 0), frame)
		g:box("Frame", V(17, 4, dustLength), CF(0, -17, 0), frame)
		g:prism("Frame", V(24, 5, dustLength), CF(0, -21.5, 0), 2, frame, "bottom")
	end)
	g:box("Frame", V(24, 16, 104), CF(0, -18, 24), frame)
	g:detail(function()
		g:box("SlideStop", V(3.5, 5, 14), CF(-13.75, -13, -14), F.nitride)
		g:box("SlideStopTab", V(4.5, 6, 6), CF(-14.25, -16, -7), F.nitride)
		for _, sx in ipairs(SIGNS) do
			g:box("TakedownLever", V(3.5, 5, 9), CF(sx * 13.75, -13, 4), F.nitride)
		end
		g:pin("FramePin", 4, CF(0, -21, 16), F.polymerDark, 31)
	end)

	-- Trigger guard: the squared front with its hook, and the bar under it back to the grip.
	g:box("TriggerGuard", V(12, 24, 9), CF(0, -38, -34), frame)
	g:box("TriggerGuard", V(12, 8, 60), CF(0, -54, -8), frame)
	g:wedge("TriggerGuardHook", V(12, 8, 8), CF(0, -46, -42.5), frame)
	g:group("trigger", function()
		g:box("Trigger", V(6, 17, 5), CF(0, -34.5, -2) * A(-10, 0, 0), F.polymerDark)
		g:detail(function()
			g:box("TriggerSafety", V(2, 10, 2.5), CF(0, -35, -5.2) * A(-10, 0, 0), F.polymerDark)
		end)
	end)
	g:swing("trigger", CF(0, -26, 0), 10)

	-- Grip, magazine, beavertail. A Glock's grip is a flattened teardrop with the stippling all over
	-- it; its magazine is a polymer-jacketed steel box whose base plate has a lip at the front.
	-- The grip's front runs 10 mm on up into the frame, so where the raked grip meets the level frame there
	-- is polymer, not a wedge of air with the magazine's top round showing through it.
	local gripFrame = g:grip(V(0, -26, 40), 15, frame, { length = gripLength, depth = 54, front = 24, back = 30, grooves = compact and 0 or 3, top = 10 })
	g:at(gripFrame, function()
		g:detail(function()
			-- On the grip's flat flank just behind its front rounding, sunk in, standing 2.3 mm proud (out over
			-- the rounding it stood clear of the grip altogether).
			g:box("MagRelease", V(3.5, 8, 9), CF(-12.6, -8, -14), F.polymerDark)
		end)
		g:group("mag", function()
			g:box("Magazine", V(19, gripLength - 4, 32), CF(0, -gripLength / 2 - 4, 2), F.polymerDark)
			-- Its top clear of the grip's own top faces (level with the back strap's end, it fought it).
			g:box("MagazineLiner", V(17, 6, 30), CF(0, -5.6, 2), F.nitride)
			if compact then
				-- The subcompact's +2 extension carries the grip's own shape on down (a hairline under the
				-- frame's grip), finished like the grip, with a base plate flared a millimetre past it.
				g:grip(V(0, -gripLength - 0.3, 0), 0, frame, { length = 18, depth = 54, front = 24, back = 30, name = "MagazineExtension" })
				g:grip(V(0, -gripLength - 18.6, 0), 0, small, { length = 5, depth = 56, front = 26, back = 32, name = "MagazinePlate" })
			else
				g:prism("MagazinePlate", V(25, 7, 42), CF(0, -gripLength - 3.5, 2), 2, small, "bottom")
				g:wedge("MagazinePlateLip", V(25, 7, 6), CF(0, -gripLength - 3.5, -22), small)
			end
			g:detail(function()
				for index = 0, 2 do
					g:cylX("MagazineWitness", FINE * 2, 3.5, CF(-9.5, -24 - index * 20, 14), F.shadow)
				end
				g:cyl("MagazineRound", 18, 9, CF(-2, 1.5, 4), F.brass)
				g:cyl("MagazineBullet", 9, 7, CF(-2, 1.5, -9.5), F.copper)
			end)
		end)
		g:key("MagWell", CF(0, -gripLength, 2))
	end)
	g:prism("Beavertail", V(24, 9, 9), CF(0, -14.5, 80.5), 3, frame, "bottom")
	g:hand("GripHand", V(30, -62, 52), V(-0.3, 0.1, -1), V(1, 0.15, 0.3))
	g:hand("SupportHand", V(-33, -74, 38), V(0.55, -0.05, -1), V(-1, -0.1, -0.3))
	g:hand("MagHand", V(-26, compact and -112 or -136, 62), V(0.35, 0.3, -0.2), V(-1, -0.1, 0))

	if v.light then
		-- A weapon light clamped on the rail just ahead of the trigger guard, its bezel standing a
		-- little past the muzzle the way a full-size light does on a full-size pistol.
		g:box("TorchMount", V(20, 6, 26), CF(0, -27, -58), F.anodizedDark)
		g:prism("Torch", V(30, 24, 72), CF(0, -41, -84), 6, F.anodizedDark)
		g:cyl("TorchBezel", 10, 31, CF(0, -41, -125), F.anodizedDark)
		g:cyl("TorchLens", FINE, 25, CF(0, -41, -130 - FINE / 2), finish(255, 248, 225, Mat.Glass, 0.3, 0.2))
		g:detail(function()
			for _, sx in ipairs(SIGNS) do
				g:box("TorchSwitch", V(5, 10, 14), CF(sx * 17.5, -39, -56), F.polymerDark)
			end
		end)
	end
	if v.laser and v.light then
		-- A light with the laser built in (one unit on the rail): the laser's housing runs along the
		-- torch's left side, its window beside the bezel.
		g:prism("LaserBody", V(12, 14, 40), CF(-19, -38, -96), 2, F.polymerDark)
		g:cyl("LaserEmitter", FINE * 2, 5, CF(-19, -38, -116 - FINE), F.laser)
	elseif v.laser then
		g:box("LaserMount", V(20, 6, 20), CF(0, -27, -58), F.anodizedDark)
		g:prism("LaserBody", V(26, 20, 46), CF(0, -37, -70), 4, F.polymerDark)
		g:cyl("LaserEmitter", FINE * 2, 5, CF(-6, -37, -93 - FINE), F.laser)
		g:detail(function()
			g:cyl("LaserLens", FINE * 2, 9, CF(6, -37, -93 - FINE), F.glass)
		end)
	end

	g.model:SetAttribute("Optic", "iron")
	-- A handgun is aimed out at arm's length, not from a hand's breadth away.
	g.model:SetAttribute("EyeRelief", 1.1)
	g.model:SetAttribute("Action", "pistol")
	g.model:SetAttribute("Flash", "pistol")
	g.model:SetAttribute("Casing", "pistol")
	g:key("Muzzle", CF(0, 0, front - 4))
	return slide
end

-- The revolver, measured off a six-inch S&amp;W 686: a stainless L-frame whose top strap carries the
-- adjustable rear sight and runs back into the hump over the hammer, a fluted six-shot cylinder on a
-- crane that swings out to the left, a full-lug barrel with the ejector rod shroud under it and a
-- ramp front sight with a red insert, a spur hammer, and wooden grips.
STYLES.revolver = function(g)
	local v = g.variant
	local steel = g.skinned and g.skin or F.stainless
	local flute = finishOf(steel.color:Lerp(Color3.new(0, 0, 0), 0.32), Mat.Metal, 0.12)
	local barrelLength = v.longBarrel and 152 or 102
	local frameFront = -52
	local muzzle = frameFront - 10 - barrelLength
	local cylinderY = -13.5
	local small = g:finish("small")

	-- Frame: top strap, recoil shield, the lower frame the crane sits in, the hump over the hammer
	-- sloping down into the grip frame.
	local frameRear = g:box("Frame", V(24, 58, 22), CF(0, -11, 13), steel)
	g:prism("TopStrap", V(20, 10, 54), CF(0, 13, -25), 3, steel, "top")
	g:box("Frame", V(24, 44, 10), CF(0, -12, frameFront - 5), steel)
	g:box("Frame", V(22, 10, 54), CF(0, -35, -25), steel)
	-- The hump and the frame under it stop at z 40, where the backstrap (with the grip, below) takes the
	-- line on down: the hump's slope runs straight into it.
	g:wedge("FrameHump", V(24, 22, 16), CF(0, 7, 32) * A(0, 180, 0), steel)
	g:box("Frame", V(24, 36, 16), CF(0, -22, 32), steel)
	g:detail(function()
		for _, screw in ipairs({ { 14, -28 }, { 30, -8 }, { 34, -34 } }) do
			g:pin("SideplateScrew", 5, CF(0, screw[2], screw[1]), steel, 24 + FINE * 4)
		end
		g:box("ThumbPiece", V(3.5, 8, 18), CF(-13.75, 0, 12), steel)
	end)

	-- Adjustable rear sight on the top strap; ramp front sight with a red insert on the barrel rib.
	g:box("RearSightBase", V(14, 4, 26), CF(0, 20, -4), F.nitride)
	for _, sx in ipairs(SIGNS) do
		g:box("RearSight", V(4.5, 6, 6), CF(sx * 4.75, 25, -10), F.nitride)
	end
	g:detail(function()
		g:cylX("RearSightScrew", 6, 5, CF(10, 21, 2), F.nitride)
	end)
	g:key("Sight", CF(0, 28, -2))

	-- Barrel: the tube, the full underlug with the ejector rod shroud, the rib and front sight.
	g:at(CF(0, 0, frameFront - 10 - barrelLength / 2), function()
		g:cyl("Barrel", barrelLength, 20, CF(0, 0, 0), steel)
		g:box("BarrelLug", V(15, 22, barrelLength), CF(0, -18, 0), steel)
		g:cyl("BarrelLug", barrelLength - 2 * RELIEF, 15, CF(0, -29, 0), steel)
		g:box("Rib", V(9, 6, barrelLength), CF(0, 11, 0), steel)
		local tip = -barrelLength / 2
		g:box("FrontSightRamp", V(4, 9, 22), CF(0, 18, tip + 14), steel)
		g:box("FrontSight", V(3, 6, 8), CF(0, 25, tip + 8), steel)
		g:box("FrontSightInsert", V(2, 3, FINE * 2), CF(0, 25.5, tip + 12 + FINE), F.tritiumOrange)
		g:cyl("Bore", FINE, 12, CF(0, 0, tip - FINE / 2), F.bore)
		g:detail(function()
			g:cyl("EjectorRod", FINE * 2, 8, CF(0, -29, tip - FINE), F.steel)
		end)
	end)
	g:key("Muzzle", CF(0, 0, muzzle - 6))

	-- Cylinder and crane. The cylinder fills the frame window: 1.5 mm off the recoil shield behind it, and
	-- its chamber mouths 1.6 mm off the forcing cone, the barrel's shank standing out of the frame in
	-- front of it. The flutes are six darker strips set into its surface, which is how a polished fluted
	-- cylinder actually reads. Both turn about axes laid along the bore (a swing's pivot turns about its
	-- own X): the cylinder about its own axis, a sixth of a turn a shot, and the crane out to the left and
	-- down about its hinge low on the frame's left.
	local drumFront, drumBack = -46, 0.5
	local drumZ = (drumFront + drumBack) / 2
	-- Its back end sits well inside the frame, and its face stands clear of the cylinder's chamber mouths
	-- rather than in their plane.
	g:cyl("ForcingCone", 7, 14, CF(0, 0, frameFront - 1), steel)
	g:group("crane", function()
		g:box("Crane", V(14, 8, 44), CF(-8, -30, drumZ), steel)
		g:group("drum", function()
			g:cyl("Drum", drumBack - drumFront, 42, CF(0, cylinderY, drumZ), steel)
			for index = 0, 5 do
				local angle = (index + 0.5) / 6 * math.pi * 2
				g:box("DrumFlute", V(9, FINE * 2, 33), CF(0, cylinderY, drumZ) * CFrame.Angles(0, 0, angle) * CF(0, 21 - 0.6, 0), flute)
			end
			for index = 0, 5 do
				local angle = index / 6 * math.pi * 2
				g:cyl("DrumChamber", FINE, 10, CF(0, cylinderY, drumFront - FINE / 2) * CFrame.Angles(0, 0, angle) * CF(0, 13.5, 0), F.bore)
			end
		end)
	end)
	g:swing("drum", CF(0, cylinderY, drumZ) * A(0, -90, 0), 60)
	g:swing("crane", CF(-14, -34, drumZ) * A(0, -90, 0), 90)
	g.model:SetAttribute("Parent_drum", "crane")
	-- The speedloader meets the swung-out cylinder's back face, on its axis.
	g:key("Load", CF(-34.5, -20, 9))

	-- Hammer, trigger, guard.
	-- The hammer: a chamfered body and a spur whose checkering stands up off its top.
	g:group("hammer", function()
		g:prism("Hammer", V(8, 18, 12), CF(0, 6, 36) * A(30, 0, 0), 2, steel)
		g:box("HammerSpur", V(8, 6, 18), CF(0, 14, 45) * A(38, 0, 0), steel)
		g:detail(function()
			-- Deep enough through the spur's top face that neither of the ridge's own faces lies near it.
			for index = 0, 2 do
				g:box("HammerChecker", V(5.2, 3.2, 1.6), CF(0, 14, 45) * A(38, 0, 0) * CF(0, 3, -4 + index * 4), steel)
			end
		end)
	end)
	g:swing("hammer", CF(0, -2, 34), -34)
	g:group("trigger", function()
		g:box("Trigger", V(7, 22, 6), CF(0, -46, -4) * A(-8, 0, 0), steel)
	end)
	g:swing("trigger", CF(0, -38, -2), 14)
	-- The guard is a closed loop: its front rises into the frame and its bottom bar runs back into the
	-- grip's front strap.
	g:box("TriggerGuard", V(9, 23.4, 5), CF(0, -50.3, -24), steel)
	g:box("TriggerGuard", V(9, 5, 46), CF(0, -64.5, -1), steel)
	g:box("TriggerGuard", V(9, 24, 5), CF(0, -54, 17) * A(28, 0, 0), steel)

	-- Grip: walnut panels round the grip frame, raked back further than a pistol's. The frame's own steel
	-- carries on down into the wood: a filler under the frame's underside in front (so no wedge of air
	-- shows where the raked wood meets the level frame), and the backstrap continuing the wood's back
	-- plane up into the hump. A polished medallion each side and the grip screw's polished ends.
	g:at(CF(0, -38, 28) * A(-22, 0, 0), function()
		g:rounded("Grip", V(30, 44, 84), CF(0, -42, 2) * A(90, 0, 0), 12, F.wood)
		g:cylX("GripButt", 30 - 2 * RELIEF, 44, CF(0, -84, 2), F.wood)
		-- The front filler is narrower than the backstrap it runs into, so their sides don't share a plane.
		g:box("GripFrame", V(19, 8.2, 26), CF(0, 5.9, -7), steel)
		g:box("Backstrap", V(21.6, 34, 18), CF(0, 17.3, 15), steel)
		g:detail(function()
			for _, sx in ipairs(SIGNS) do
				g:cylX("GripMedallion", FINE * 2, 10, CF(sx * 15, -24, 2), F.bright)
			end
			g:pin("GripScrew", 6, CF(0, -58, 2), F.bright, 30 + FINE * 2)
		end)
	end)
	-- Both hands 2 mm in from where they were, with the walnut now 30 mm across instead of 34.
	g:hand("GripHand", V(31, -68, 50), V(-0.3, 0.05, -1), V(1, 0.2, 0.35))
	g:hand("SupportHand", V(-34, -80, 36), V(0.55, -0.05, -1), V(-1, -0.1, -0.3))
	g:hand("MagHand", V(-40, -30, -10), V(0.3, 0.9, -0.2), V(-1, 0, 0.2))

	if v.engraved or g.rarityIndex &gt;= 5 then
		for _, sx in ipairs(SIGNS) do
			g:engraving(CF(sx * 12, -18, 12), 18, 34)
			g:engraving(CF(sx * 12, -22, 32), 14, 22)
			g:engraving(CF(sx * 7.5, -18, frameFront - 10 - barrelLength / 2), barrelLength - 24, 12)
		end
	end

	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 1.1)
	g.model:SetAttribute("Action", "revolver")
	g.model:SetAttribute("Flash", "revolver")
	g.model:SetAttribute("Casing", "none")
	return frameRear
end

-- The SMG, measured off an MP5: a stamped receiver with pressed ribs and the cocking tube running
-- forward over the barrel to the hooded front sight, the diopter drum at the back, the non-
-- reciprocating cocking handle out the left side, a slim handguard, the polymer trigger group with
-- its grip, and a curved 30-round magazine. Variants: the SD's integral suppressor and retractable
-- stock, a 100-round drum, a claw-mount rail with an optic.
STYLES.smg = function(g)
	local v = g.variant
	local metal = g.skinned and g.skin or (g.rarityIndex &gt;= 4 and g:finish("receiver") or F.nitride)
	local furniture = v.camo and F.fde or g:finish("furniture")
	local small = g:finish("small")
	local suppressed = v.suppressor

	-- Receiver with its ribs and the ejection port (a real opening, bolt inside).
	local receiver = g:box("Receiver", V(15, 42, 300), CF(-7.5, -1, 10), metal)
	g:box("ReceiverWall", V(15, 42, 150), CF(7.5, -1, 85), metal)
	g:box("ReceiverWall", V(15, 42, 80), CF(7.5, -1, -100), metal)
	g:box("ReceiverWall", V(15, 12, 70), CF(7.5, -16, -25), metal)
	g:box("ReceiverWall", V(15, 12, 70), CF(7.5, 14, -25), metal)
	g:box("EjectionPort", V(3.5, 18, 70), CF(5.25, -1, -25), F.shadow)
	g:group("bolt", function()
		g:box("BoltCarrier", V(11.5, 14, 50), CF(5.75, -1, -18), F.steel)
	end)
	g:travel("bolt", 60)
	g:key("Eject", CF(18, 0, -25) * A(0, -70, 0))
	g:detail(function()
		for _, sx in ipairs(SIGNS) do
			g:box("ReceiverRib", V(3.5, 6, 180), CF(sx * 16.75, 12, 60), metal)
			g:box("ReceiverRib", V(3.5, 6, 120), CF(sx * 16.75, -14, 90), metal)
		end
		-- The claw mounts stop short of the diopter's base, whose underside they used to lie level with.
		for _, z in ipairs({ -80, 40, 100 }) do
			g:box("ClawMount", V(22, 4, 14), CF(0, 21.5, z), metal)
		end
		g:box("EndCap", V(34, 44, 8), CF(0, -1, 164), F.polymerDark)
	end)

	-- Cocking tube over the barrel, the handle out the left, the hooded front sight.
	-- The tube carries the front sight at its own height, so it cannot come down to the handguard; it is
	-- banded to it instead. Without the front band it stood 5 mm clear of the handguard along its whole
	-- run, held at one point near the receiver, and that slot of daylight is what made it read as a second
	-- barrel floating over the first.
	g:cyl("CockingTube", 150, 22, CF(0, 28, -215), metal)
	g:box("TubeSupport", V(20, 10, 20), CF(0, 16, -150), metal)
	g:box("BarrelBand", V(28, 13, 14), CF(0, 14, -258), metal)
	g:group("charge", function()
		g:box("ChargingHandle", V(24, 8, 9), CF(-18, 34, -236) * A(0, 0, -40), F.steel)
		g:ball("ChargingKnob", 13, CF(-30, 44, -236), F.polymerDark)
	end)
	g:travel("charge", 90)
	-- Turned -90 degrees on the palm and tilted 30 so the wrist is not bent past 62 degrees working it (it was 116): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(-42, 58, -240), V(-0.6, -0.36, -0.71), V(-0.77, 0, 0.64))
	g:at(CF(0, 28, -282), function()
		-- The base's top stops 1.5 mm under the hood's inner face rather than level with it.
		g:box("FrontSightBase", V(26, 14.5, 26), CF(0, -2.75, 0), metal)
		g:shell("FrontSightHood", 18, 28, 4, CF(0, 16, 0), metal, 10)
		g:box("FrontSightPost", V(3, 12, 3), CF(0, 10, 0), metal)
		g:box("FrontSight", V(2.2, 6, 3), CF(0, 19, 0), metal)
	end)

	-- The diopter drum at the back.
	g:box("RearSightBase", V(26, 8, 34), CF(0, 24, 136), metal)
	-- Its top sits 1.5 mm under the aperture ring, never across the hole or level with the ring's inside.
	g:cylX("RearSightDrum", 26, 26, CF(0, 32.5, 136), metal)
	g:shell("RearSight", 6, 12, 3, CF(0, 50, 136), metal, 8)
	g:detail(function()
		for index = 0, 3 do
			g:box("RearSightFlat", V(28, 5, 5), CF(0, 32.5, 136) * CFrame.Angles(index / 4 * math.pi, 0, 0) * CF(0, 10.5, 0), metal)
		end
	end)

	-- Trigger group, grip, selector.
	g:prism("TriggerGroup", V(28, 20, 128), CF(0, -32, 34), 3, furniture, "bottom")
	g:box("TriggerGuard", V(12, 6, 60), CF(0, -58, 6), furniture)
	g:box("TriggerGuard", V(12, 13, 6), CF(0, -48.5, -24), furniture)
	g:group("trigger", function()
		g:box("Trigger", V(6, 18, 6), CF(0, -47, 0) * A(-12, 0, 0), F.polymerDark)
	end)
	g:swing("trigger", CF(0, -38, 0), 12)
	g:grip(V(0, -42, 66), 16, furniture, { length = 98, depth = 46, front = 22, back = 30, grooves = 3 })
	g:detail(function()
		g:at(CF(-15, -34, 64), function()
			g:cylX("Selector", 3.5, 14, CF(0, 0, 0), F.polymerDark)
			g:box("SelectorLever", V(3.5, 6, 20), CF(-1, -4, -8) * A(-35, 0, 0), small)
		end)
		g:pin("TriggerGroupPin", 7, CF(0, -28, 94), F.nitride, 35)
	end)
	g:hand("GripHand", V(31, -80, 82), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	-- Magazine well and magazine (or drum).
	g:box("MagWell", V(30, 23, 48), CF(0, -33.5, -76), metal)
	g:box("MagRelease", V(14, 12, 6), CF(0, -40, -50), F.steel)
	g:group("mag", function()
		if v.drum then
			g:drumMag("Magazine", 100, 56, CF(0, -44, -76), F.polymerDark)
		else
			g:magazine("Magazine", { width = 22, depth = 34, segments = { { 60, 0 }, { 42, 4 }, { 42, 4 }, { 42, 4 } }, ribs = "stanag", caliber = 9 }, CF(0, -40, -76), F.nitride)
		end
	end)
	g:key("MagWell", CF(0, -40, -76))
	g:hand("MagHand", V(-30, v.drum and -150 or -120, -80), V(0.4, 0.25, -0.2), V(-1, -0.15, 0))

	-- Front end: the handguard round the barrel, or the SD's suppressor with its own handguard.
	local muzzleZ
	if suppressed then
		g:cyl("Suppressor", 330, 52, CF(0, -2, -305), F.nitride)
		g:rounded("Handguard", V(56, 56, 120), CF(0, -2, -200), 26, furniture)
		g:detail(function()
			for index = 0, 5 do
				g:cyl("SuppressorBand", 4, 55, CF(0, -2, -300 - index * 26), F.anodizedDark)
			end
			g:cyl("Bore", 2, 10, CF(0, -2, -470.4), F.bore)
		end)
		muzzleZ = -472
	else
		g:cyl("Barrel", 150, 15, CF(0, 0, -215), F.nitride)
		g:rounded("Handguard", V(42, 40, 124), CF(0, -8, -205), 15, furniture)
		g:detail(function()
			for _, sx in ipairs(SIGNS) do
				for index = 0, 4 do
					g:box("HandguardGroove", V(FINE * 2, 6, 12), CF(sx * 21, -14, -250 + index * 22), furniture)
				end
			end
		end)
		-- Three lugs round the barrel's end.
		g:cyl("MuzzleBrake", 16, 18, CF(0, 0, -298), F.nitride)
		g:detail(function()
			for index = 0, 2 do
				g:box("MuzzleProng", V(6, 7, 12), CF(0, 0, -298) * CFrame.Angles(0, 0, index / 3 * math.pi * 2) * CF(0, 10, 0), F.nitride)
			end
			g:cyl("Bore", 2, 8, CF(0, 0, -307), F.bore)
		end)
		muzzleZ = -308
	end
	g:key("Muzzle", CF(0, 0, muzzleZ))
	g:hand("SupportHand", V(-12, -44, suppressed and -205 or -212), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))

	-- Stock: the retractable skeleton on the SD, a fixed polymer stock otherwise.
	if v.skeletonStock then
		for _, sx in ipairs(SIGNS) do
			g:box("StockStrut", V(6, 9, 210), CF(sx * 14, -6, 262), F.nitride)
		end
		g:rounded("Buttpad", V(40, 30, 104), CF(0, -26, 372) * A(90, 0, 0), 12, F.rubber)
		g:box("StockYoke", V(34, 12, 18), CF(0, -6, 360), F.nitride)
	else
		g:at(CF(0, 0, 168), function()
			g:rounded("Stock", V(36, 34, 200), CF(0, -2, 100), 11, furniture)
			g:wedge("StockWeb", V(32, 66, 180), CF(0, -52, 110) * A(0, 0, 180), furniture)
			g:rounded("Buttpad", V(40, 20, 104), CF(0, -34, 210) * A(90, 0, 0), 8, F.rubber)
		end)
	end

	-- Sights: the diopter, or a rail on the claw mounts with an optic.
	if v.holo then
		g:box("ClawRail", V(28, 12, 140), CF(0, 27, 40), F.anodizedDark)
		g:rail("OpticRail", 132, CF(0, 33, 40))
		local h = g:holo(CF(0, 42.5, 30))
		g:key("Sight", CF(0, 42.5 + h, 110))
		g.model:SetAttribute("Optic", "holo")
		g.model:SetAttribute("EyeRelief", 0.6)
	else
		g:key("Sight", CF(0, 50, 142))
		g.model:SetAttribute("Optic", "iron")
		g.model:SetAttribute("EyeRelief", 0.36)
	end
	if v.laser then
		g:laserModule(CF(0, -44, suppressed and -170 or -214))
	end

	g.model:SetAttribute("Action", "smg")
	g.model:SetAttribute("Flash", suppressed and "suppressed" or "smg")
	g.model:SetAttribute("Casing", "pistol")
	return receiver
end

-- The M14 pattern, measured off an M1A: a one-piece walnut stock with a semi-pistol grip and a steel
-- butt plate, a parkerized receiver with the protected aperture rear sight and the op-rod handle
-- running along the right side, a fibreglass upper handguard, the front band and gas cylinder under
-- the barrel, a prong flash suppressor carrying the front sight, a straight 20-round magazine, and a
-- scope on a mount over the action.
local function buildM14(g)
	local v = g.variant
	local metal = g.skinned and g.skin or F.parkerized
	local wood = v.woodFurniture and F.wood or g:finish("furniture")
	local small = g:finish("small")

	-- Stock.
	g:rounded("Stock", V(46, 34, 250), CF(0, -24, -205), 12, wood)
	local body = g:box("Stock", V(46, 40, 150), CF(0, -30, -5), wood)
	g:at(CF(0, -34, 115) * A(-8, 0, 0), function()
		g:rounded("Stock", V(38, 44, 90), CF(0, 0, 0), 13, wood)
	end)
	g:rounded("Stock", V(42, 40, 290), CF(0, -26, 305), 12, wood)
	g:wedge("StockWeb", V(40, 100, 250), CF(0, -96, 325) * A(0, 0, 180), wood)
	g:box("Buttplate", V(44, 142, 8), CF(0, -76, 454), metal)
	-- The semi-pistol grip: a short swell under the wrist behind the trigger guard, sweeping back up
	-- into the butt's lower line.
	g:grip(V(0, -52, 74), 12, wood, { length = 48, depth = 44, front = 30, back = 36 })
	g:wedge("StockSwell", V(36, 45, 106), CF(0, -77.5, 149) * A(180, 0, 0), wood)
	g:hand("GripHand", V(33, -76, 92), V(-0.35, 0.2, -1), V(1, 0.15, 0.3))
	g:hand("SupportHand", V(-10, -54, -220), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))

	-- Receiver, bolt, op rod, rear sight.
	g:rounded("Receiver", V(30, 30, 200), CF(0, 6, -10), 10, metal)
	g:group("bolt", function()
		g:cyl("BoltCarrier", 70, 14, CF(0, 16, 30), F.steel)
	end)
	g:travel("bolt", 80)
	g:group("charge", function()
		g:box("ChargingHandle", V(12, 14, 30), CF(21, 6, -40), metal)
		g:cyl("OpRod", 290, 9, CF(17, -8, -185), metal)
	end)
	g:travel("charge", 80)
	-- Turned 60 degrees on the palm so the wrist is not bent past 67 degrees working it (it was 122): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(40, 14, -44), V(-0.03, -0.66, -0.75), V(1, -0.09, 0.04))
	g:key("Eject", CF(18, 22, 10) * A(0, -60, 30))
	g:box("RearSightBase", V(26, 12, 26), CF(0, 27, 74), metal)
	for _, sx in ipairs(SIGNS) do
		g:box("RearSightEar", V(4, 26, 20), CF(sx * 11, 40, 74), metal)
	end
	g:shell("RearSight", 4, 10, 3, CF(0, 44, 74), metal, 8)
	g:aperturePlate(CF(0, 0, 74), 33, 44, metal)
	g:box("ClipGuide", V(12, 8, 18), CF(0, 19, -60), metal)

	-- Scope mount and scope.
	g:box("ScopeBase", V(34, 14, 160), CF(0, 28, -30), F.anodizedDark)
	g:rail("ScopeRail", 150, CF(0, 35, -30))
	local h = g:scope(CF(0, 44.5, -20), "lpvo")
	g:key("Sight", CF(0, 44.5 + h, 150))
	g.model:SetAttribute("Optic", "scope")
	g.model:SetAttribute("EyeRelief", 0.6)

	-- Handguard, barrel, front band, gas cylinder, flash suppressor with the front sight.
	g:rounded("HandguardUpper", V(28, 16, 200), CF(0, 12, -210), 7, F.polymerDark)
	g:detail(function()
		for index = 0, 3 do
			g:box("HandguardVent", V(20, FINE * 2, 14), CF(0, 20, -150 - index * 40), F.shadow)
		end
	end)
	g:cyl("Barrel", 450, 20, CF(0, 0, -335), F.nitride)
	g:box("FrontBand", V(40, 26, 22), CF(0, -14, -330), metal)
	g:cyl("GasCylinder", 70, 22, CF(0, -22, -445), metal)
	-- The gas cylinder hangs off the barrel on its block.
	g:box("GasBlock", V(16, 14, 30), CF(0, -12, -458), metal)
	g:box("GasCylinderLock", V(18, 14, 18), CF(0, -34, -482), metal)
	g:at(CF(0, 0, -560), function()
		g:cyl("MuzzleBrake", 16, 24, CF(0, 0, -8), metal)
		for index = 0, 4 do
			g:box("MuzzleProng", V(4, 3.5, 40), CFrame.Angles(0, 0, index / 5 * math.pi * 2) * CF(0, 10.25, -36), metal)
		end
		g:crown("MuzzleBrake", 8, 24, 9, CF(0, 0, -60), metal)
		g:box("BayonetLug", V(10, 10, 26), CF(0, -16, -24), metal)
		-- The ears and post stand on a base seated on the suppressor's collar (on the round collar alone,
		-- the ears' feet hung 3 mm clear of it).
		g:box("FrontSightBase", V(24, 8, 18), CF(0, 10, -14), metal)
		for _, sx in ipairs(SIGNS) do
			g:box("FrontSightEar", V(4, 30, 14), CF(sx * 9, 26, -14), metal)
		end
		g:box("FrontSightPost", V(3.5, 22, 4), CF(0, 22, -14), metal)
		g:box("FrontSight", V(2.4, 11, 3), CF(0, 38.5, -14), metal)
	end)
	g:key("Muzzle", CF(0, 0, -626))

	-- Magazine, trigger guard, trigger, safety.
	g:group("mag", function()
		g:magazine("Magazine", { width = 26, depth = 84, segments = { { 108, 0 } }, ribs = "stanag", caliber = 11.5 }, CF(0, -44, -75), F.parkerized)
	end)
	g:key("MagWell", CF(0, -44, -75))
	g:hand("MagHand", V(-32, -150, -80), V(0.4, 0.25, -0.15), V(-1, -0.15, 0))
	g:box("TriggerGuard", V(12, 6, 70), CF(0, -72, 8), metal)
	g:box("TriggerGuard", V(12, 17, 6), CF(0, -60.5, -24), metal)
	g:box("TriggerGuard", V(12, 17, 8), CF(0, -60.5, 40), metal)
	g:group("trigger", function()
		g:box("Trigger", V(6, 18, 6), CF(0, -59, -2) * A(-10, 0, 0), metal)
	end)
	g:swing("trigger", CF(0, -50, 0), 12)
	g:box("Safety", V(10, 8, 10), CF(0, -54, -32), small)

	if v.laser then
		g:rail("LaserRail", 60, CF(0, -41, -290) * A(180, 0, 0))
		g:laserModule(CF(0, -70.5, -290))
	end
	g:slingLoop(CF(0, -41, -200))

	g.model:SetAttribute("Action", "semi")
	g.model:SetAttribute("Flash", "rifle")
	g.model:SetAttribute("Casing", "rifle")
	return body
end

-- The bolt-action precision rifle, patterned on the Accuracy International AWM: a chassis with a flat
-- forend, a thumbhole stock with an adjustable cheek piece, a vertical grip, butt pad and monopod, a
-- round action with its bolt and tactical knob, a heavy fluted barrel and a muzzle brake, a detachable
-- box magazine, a long scope and a folded bipod. Larila's wears ghillie rags.
local function buildBoltAction(g)
	local v = g.variant
	local chassis = g.skinned and g.skin or (g.rarityIndex == 4 and g:finish("receiver") or F.od)
	local metal = F.nitride
	local small = g:finish("small")
	local barrelEnd = v.longBarrel and -780 or -680

	-- Action and rail.
	local action = g:cyl("Receiver", 220, 34, CF(0, 6, -10), metal)
	g:box("RailBase", V(20, 6, 230), CF(0, 23, -10), metal)
	g:rail("ScopeRail", 220, CF(0, 26, -10))
	g:box("EjectionPort", V(FINE * 2, 14, 70), CF(16.5, 12, -30), F.shadow)
	-- The bolt: lifts, then draws back. Its knob is where the right hand works it.
	g:group("bolt", function()
		g:cyl("BoltShroud", 30, 26, CF(0, 6, 115), metal)
		g:cyl("BoltBody", 60, 20, CF(0, 6, 72), F.steel)
		g:box("BoltHandle", V(40, 8, 10), CF(22, 0, 82) * A(0, 0, -25), metal)
		g:ball("BoltKnob", 22, CF(44, -12, 82), F.polymerDark)
	end)
	g:swing("bolt", CF(0, 6, 82) * A(0, 90, 0), 60)
	g:travel("bolt", 95)
	g:hand("BoltHand", V(52, -8, 88), V(-0.5, 0.1, -0.8), V(0.4, 1, 0.2))
	g:key("Eject", CF(24, 12, -30) * A(0, -70, 20))

	-- Chassis: centre section, forend, the thumbhole stock.
	g:box("Chassis", V(54, 44, 250), CF(0, -30, -5), chassis)
	g:prism("Forend", V(50, 46, 330), CF(0, -22, -295), 6, chassis)
	g:detail(function()
		for _, sx in ipairs(SIGNS) do
			for index = 0, 3 do
				g:box("ForendVent", V(FINE * 2, 12, 48), CF(sx * 25, -22, -190 - index * 68), F.shadow)
			end
		end
	end)
	g:grip(V(0, -52, 84), 12, chassis, { length = 104, depth = 46, front = 24, back = 32, grooves = 3 })
	g:hand("GripHand", V(32, -90, 100), V(-0.3, 0.05, -1), V(1, 0.2, 0.25))
	g:hand("SupportHand", V(-6, -58, -300), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g:box("Stock", V(46, 44, 330), CF(0, -18, 285), chassis)
	g:prism("StockCheek", V(40, 16, 150), CF(0, 12, 320), 5, chassis, "top")
	g:box("StockToe", V(40, 30, 280), CF(0, -128, 330), chassis)
	g:box("StockToe", V(40, 30, 110), CF(0, -140, 150) * A(-8, 0, 0), chassis)
	g:box("Butt", V(46, 170, 34), CF(0, -65, 457), chassis)
	g:prism("Buttpad", V(50, 176, 16), CF(0, -65, 482), 4, F.rubber)
	g:detail(function()
		for _, sx in ipairs(SIGNS) do
			g:cylX("CheekKnob", 8, 16, CF(sx * 26.5, -4, 280), F.anodizedDark)
		end
		g:cylY("Monopod", 50, 18, CF(0, -168, 430), F.anodizedDark)
		g:cylY("MonopodFoot", 8, 26, CF(0, -197, 430), F.rubber)
	end)

	-- Magazine, guard, trigger.
	g:group("mag", function()
		g:magazine("Magazine", { width = 28, depth = 80, segments = { { 70, 0 } }, caliber = 12 }, CF(0, -46, -60), F.anodizedDark)
	end)
	g:key("MagWell", CF(0, -46, -60))
	g:hand("MagHand", V(-34, -130, -62), V(0.4, 0.25, -0.15), V(-1, -0.15, 0))
	g:box("MagRelease", V(24, 6, 12), CF(0, -55, -10), small)
	g:box("TriggerGuard", V(14, 6, 70), CF(0, -72, 12), chassis)
	g:box("TriggerGuard", V(14, 17, 8), CF(0, -60.5, -19), chassis)
	g:group("trigger", function()
		g:box("Trigger", V(6, 16, 6), CF(0, -60, 4) * A(-8, 0, 0), F.steel)
	end)
	g:swing("trigger", CF(0, -52, 4), 10)

	-- Barrel: heavy near the action, fluted, a brake at the muzzle.
	g:cyl("Barrel", 130, 28, CF(0, 0, -185), metal)
	g:cyl("Barrel", -250 - barrelEnd, 22, CF(0, 0, (barrelEnd - 250) / 2), metal)
	if v.flutes then
		g:detail(function()
			local run = -barrelEnd - 290
			for index = 0, 5 do
				local angle = (index + 0.5) / 6 * math.pi * 2
				g:box("Flute", V(4, FINE * 2, run), CF(0, 0, -270 - run / 2) * CFrame.Angles(0, 0, angle) * CF(0, 10.5, 0), F.shadow)
			end
		end)
	end
	local muzzleZ = barrelEnd + g:brake(CF(0, 0, barrelEnd), 32, 84)
	g:key("Muzzle", CF(0, 0, muzzleZ))

	-- Long scope and a folded bipod.
	local h = g:scope(CF(0, 35.5, -20), "long")
	g:key("Sight", CF(0, 35.5 + h, 190))
	g.model:SetAttribute("Optic", "scope")
	g.model:SetAttribute("EyeRelief", 0.6)
	g:bipod(CF(0, -45, -420))

	if v.ghillie then
		-- Ghillie wrap: strips of burlap wound round the barrel, the forend and the stock, a strip draped
		-- over the scope, and short frayed tufts hanging off each wrap. The tufts' angles come from their
		-- index, so every copy of the gun wears exactly the same rags.
		local function tufts(centre, radius, seed)
			for index = 0, 2 do
				local around = math.rad(-60 + index * 60)
				local root = centre + V(math.sin(around) * radius, -math.cos(around) * radius, 0)
				local length = 22 + ((seed + index) % 3) * 8
				local swing = math.sin((seed + index) * 12.9898) * 22
				g:box("Ghillie", V(3, length, 10), CF(root) * A(swing, 0, math.deg(around) * 0.4) * CF(0, -length / 2, 0),
					(seed + index) % 2 == 0 and F.ghillie or F.ghillieDark)
			end
		end
		for index, z in ipairs({ -330, -470, -610 }) do
			g:cyl("GhillieWrap", 36, 30, CF(0, 0, z), index % 2 == 0 and F.ghillieDark or F.ghillie)
			tufts(V(0, 0, z), 15, index)
		end
		-- The tufts' roots sit inside each wrap, not on its corner: hung at the wrap's own half-height they
		-- reached past the bottom face and the lowest one hung on nothing.
		g:box("GhillieWrap", V(50 + RELIEF * 2, 46 + RELIEF * 2, 54), CF(0, -22, -420), F.ghillieDark)
		tufts(V(0, -22, -420), 24, 4)
		g:box("GhillieWrap", V(46 + RELIEF * 2, 44 + RELIEF * 2, 60), CF(0, -18, 330), F.ghillie)
		tufts(V(0, -18, 330), 23, 7)
		g:box("GhillieDrape", V(30, 3, 110), CF(0, 35.5 + 52 + 18.5, -20) * A(4, 0, 0), F.ghillie)
	end

	g.model:SetAttribute("Action", "bolt")
	g.model:SetAttribute("Flash", "brake")
	g.model:SetAttribute("Casing", "rifle")
	return action
end

-- The pump shotgun, measured off a Remington 870 with a tactical barrel: a steel receiver with a real
-- ejection port and the loading port underneath, the magazine tube under the barrel with its cap and
-- clamp, a ribbed polymer pump riding on twin action bars, a pistol-grip stock, a side saddle of
-- shells, and a ventilated heat shield over the barrel.
local function buildPump(g)
	local v = g.variant
	local metal = g.skinned and g.skin or (g.rarityIndex &gt;= 3 and g:finish("receiver") or F.nitride)
	local furniture = g:finish("furniture")
	local small = g:finish("small")

	-- Receiver round the ejection port.
	g:prism("ReceiverTop", V(30, 8, 210), CF(0, 14, -30), 4, metal, "top")
	local receiver = g:box("Receiver", V(15, 52, 210), CF(-7.5, -16, -30), metal)
	g:box("ReceiverWall", V(15, 26, 210), CF(7.5, -29, -30), metal)
	g:box("ReceiverWall", V(15, 26, 80), CF(7.5, -3, 35), metal)
	g:box("ReceiverWall", V(15, 26, 50), CF(7.5, -3, -110), metal)
	g:box("EjectionPort", V(3.5, 26, 80), CF(5.25, -3, -45), F.shadow)
	g:group("pump", function()
		g:box("BoltCarrier", V(11.5, 20, 60), CF(5.75, -3, -40), F.steel)
	end)
	g:key("Eject", CF(20, -2, -45) * A(0, -70, 0))
	g:box("LoadingPort", V(20, FINE * 2, 70), CF(0, -42 - FINE, -90), F.shadow)
	g:key("Load", CF(0, -60, -80))
	g:box("TriggerPlate", V(24, 10, 120), CF(0, -47, 10), metal)
	g:box("TriggerGuard", V(12, 6, 62), CF(0, -70, 8), metal)
	g:box("TriggerGuard", V(12, 15, 6), CF(0, -59.5, -22), metal)
	g:box("TriggerGuard", V(12, 15, 6), CF(0, -59.5, 38), metal)
	g:group("trigger", function()
		g:box("Trigger", V(6, 17, 6), CF(0, -60, -2) * A(-10, 0, 0), F.steel)
	end)
	g:swing("trigger", CF(0, -52, 0), 10)
	g:detail(function()
		g:cylX("Safety", 30, 8, CF(0, -47, 48), small)
		g:box("SlideRelease", V(4, 10, 14), CF(-17, -45, -40), F.steel)
		for _, z in ipairs({ -110, 40 }) do
			g:pin("ReceiverPin", 6, CF(0, -34, z), F.steel, 30 + FINE * 2)
		end
	end)

	-- Barrel, heat shield, bead; magazine tube, cap and clamp.
	g:cyl("Barrel", 485, 23, CF(0, 0, -377.5), F.nitride)
	g:cyl("Bore", FINE, 19, CF(0, 0, -620 - FINE / 2), F.bore)
	if v.heatShield then
		g:heatShield(CF(0, 0, -340), 280, 17, 11.5)
	end
	-- The bead stands on a ramp, so the line over it clears the receiver top and the heat shield.
	g:box("BeadRamp", V(5, 8, 12), CF(0, 15, -606), F.nitride)
	g:ball("FrontBead", 5, CF(0, 20.5, -606), F.brass)
	g:cyl("MagTube", 425, 26, CF(0, -30, -347.5), F.nitride)
	g:cyl("MagCap", 22, 29, CF(0, -30, -571), F.nitride)
	g:box("BarrelClamp", V(34, 50, 14), CF(0, -14, -536), F.nitride)
	g:slingLoop(CF(0, -44, -566))
	g:key("Muzzle", CF(0, 0, -624))

	-- The pump on its action bars.
	g:group("pump", function()
		g:rounded("Pump", V(46, 44, 180), CF(0, -28, -300), 16, furniture)
		g:detail(function()
			for index = 0, 7 do
				g:box("PumpRib", V(46 + FINE * 2, 30, 5), CF(0, -33, -226 - index * 21), furniture)
			end
		end)
		for _, sx in ipairs(SIGNS) do
			g:box("ActionBar", V(3, 6, 90), CF(sx * 12, -18, -165), F.steel)
		end
	end)
	g:travel("pump", 85)
	g:hand("SupportHand", V(-8, -58, -300), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g.model:SetAttribute("SupportGroup", "pump")

	-- Pistol-grip stock.
	g:at(CF(0, 0, 75), function()
		g:rounded("Stock", V(40, 42, 330), CF(0, -24, 165), 12, furniture)
		g:wedge("StockWeb", V(38, 100, 220), CF(0, -95, 245) * A(0, 0, 180), furniture)
		g:prism("Buttpad", V(44, 146, 20), CF(0, -72, 340), 4, F.rubber)
	end)
	g:grip(V(0, -44, 72), 22, furniture, { length = 96, depth = 46, front = 22, back = 30 })
	g:hand("GripHand", V(31, -86, 104), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	-- Side saddle of shells on the left.
	g:box("SideSaddle", V(4, 44, 110), CF(-17, -8, -40), F.polymerDark)
	for index = 0, 4 do
		g:cylY("SpareShell", 44, 20, CF(-29, -8, -80 + index * 20), F.shell)
		g:cylY("SpareShellBase", 12, 21.4, CF(-29, -36, -80 + index * 20), F.brass)
	end

	g.model:SetAttribute("Optic", "iron")
	-- Cheek down on the comb, the eye well back over the stock: from closer, the back of the receiver
	-- filled the bottom of the sight picture.
	g.model:SetAttribute("EyeRelief", 0.8)
	g:key("Sight", CF(0, 23, 40))
	g.model:SetAttribute("Action", "pump")
	g.model:SetAttribute("Flash", "shotgun")
	g.model:SetAttribute("Casing", "shell")
	return receiver
end

STYLES.dmr = function(g)
	if g.variant.woodFurniture then
		return buildM14(g)
	end
	return buildAR(g, { scale = 1.12, hgLength = 250, barrelEnd = -470, barrelDia = 19, muzzle = "brake", optic = "lpvo", mag = magazine308,
		action = "semi" })
end

STYLES.sniper = function(g)
	if g.variant.boltAction then
		return buildBoltAction(g)
	end
	return buildAR(g, { scale = 1.12, hgLength = 330, barrelEnd = -600, barrelDia = 21, muzzle = "brake", optic = "long", mag = magazine308,
		stock = "precision", bipod = true, flutes = g.variant.flutes, action = "semi", flash = "brake" })
end

STYLES.shotgun = function(g)
	if g.variant.semiAuto then
		return buildAR(g, { scale = 1.18, hgLength = 230, barrelEnd = -420, barrelDia = 22, muzzle = "choke", heatShield = g.variant.heatShield,
			mag = function(builder)
				builder:drumMag("Magazine", 170, 64, CF(0, -52, -57), F.polymerDark)
			end,
			action = "semi", flash = "shotgun", casing = "shell" })
	end
	return buildPump(g)
end

-- The side-by-side, patterned on a coach gun: a case-hardened action with sidelock plates and two
-- exposed hammers, a top lever, the barrels on their hinge with the rib and a brass bead, a splinter
-- forend, double triggers, and a straight English stock. The sawn-off is cut down to short barrels and
-- a taped pistol grip.
STYLES.doublebarrel = function(g)
	local v = g.variant
	local sawn = v.sawnOff
	local steel = g.skinned and g.skin or F.blued
	local plates = g.rarityIndex &gt;= 5 and F.bright or F.steel
	local small = g:finish("small")
	local barrelEnd = sawn and -300 or -570
	local length = -62 - barrelEnd

	-- The action: a deep body with long sidelock plates running back into the wrist, the tang lying
	-- along the top of the wrist with the top lever on it, and a hammer low on each side.
	local action = g:rounded("Receiver", V(46, 58, 110), CF(0, -16, -5), 10, steel)
	g:box("SidePlate", V(46 + FINE * 2, 40, 96), CF(0, -18, 8), plates)
	g:box("TopTang", V(16, 4, 50), CF(0, 13.6, 75) * A(8, 0, 0), steel)
	g:box("TopLever", V(8, 5, 34), CF(6, 17.5, 62) * A(8, 25, 0), small)
	g:group("hammer", function()
		for _, sx in ipairs(SIGNS) do
			g:box("Hammer", V(7, 16, 10), CF(sx * 17, 16, 42) * A(35, 0, 0), plates)
			g:box("HammerSpur", V(8, 5, 12), CF(sx * 17, 24, 49) * A(55, 0, 0), plates)
		end
	end)
	g:swing("hammer", CF(0, 8, 38), -30)
	-- The hinge pin is low at the front of the frame, and the barrels break DOWNWARD about it the way a
	-- real break gun opens: the muzzles drop and the breech end rises off the standing breech (swung the
	-- other way, the gun opened by pointing its muzzles at the sky).
	g:cylX("Hinge", 50, 16, CF(0, -30, -62), F.steel)
	g:swing("hinge", CF(0, -30, -62), -40)

	g:group("hinge", function()
		for _, sx in ipairs(SIGNS) do
			g:cyl("Barrel", length, 22, CF(sx * 11, 0, -62 - length / 2), steel)
			g:cyl("Bore", FINE, 18, CF(sx * 11, 0, barrelEnd - FINE / 2), F.bore)
			g:cyl("ShellRim", FINE * 2, 21, CF(sx * 11, 0, -62 + FINE), F.brass)
		end
		-- A raised sighting rib, so the line along it clears the top lever and the tang, with the bead's
		-- top on that line.
		-- It stands down in the valley between the barrels (from 8 mm up it only met them along its edges).
		g:box("Rib", V(10, 18, length), CF(0, 11, -62 - length / 2), steel)
		g:box("Rib", V(8, 10, length - 20), CF(0, -9, -72 - length / 2), steel)
		g:ball("FrontBead", 5, CF(0, 21.5, barrelEnd + 12), F.brass)
		local foreLength = sawn and 120 or 210
		g:rounded("ForeGrip", V(40, 22, foreLength), CF(0, -21, -80 - foreLength / 2), 9, F.wood)
		g:box("ForendIron", V(20, 6, 40), CF(0, -34, -110), F.steel)
	end)
	g:hand("SupportHand", V(-8, -46, -80 - (sawn and 60 or 105)), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g.model:SetAttribute("SupportGroup", "hinge")
	g:key("Load", CF(0, 0, -40))
	-- The ejector throws the empties up and back over your hand as the barrels drop.
	g:key("Eject", CF(0, 6, -46) * A(118, 0, 0))
	g.model:SetAttribute("LoadGroup", "hinge")

	-- Guard and double triggers.
	g:box("TriggerGuard", V(12, 6, 60), CF(0, -60, 6), steel)
	g:box("TriggerGuard", V(12, 17, 6), CF(0, -48.5, -21), steel)
	g:box("TriggerGuard", V(12, 17, 6), CF(0, -48.5, 33), steel)
	g:group("trigger", function()
		for _, z in ipairs({ -8, 10 }) do
			g:box("Trigger", V(5, 18, 5), CF(0, -46, z) * A(-12, 0, 0), g.rarityIndex &gt;= 5 and F.gold or F.steel)
		end
	end)
	g:swing("trigger", CF(0, -38, 0), 12)

	if sawn then
		-- Cut back to a stub of wrist and a pistol grip, wrapped in tape where the checkering was.
		-- The stub of wrist runs up under the tang and into the back of the action, carrying both.
		g:rounded("Stock", V(34, 48, 36), CF(0, -10, 65), 12, F.wood)
		local gf = g:grip(V(0, -34, 62), 30, F.wood, { length = 96, depth = 44, front = 26, back = 32 })
		g:at(gf, function()
			g:detail(function()
				for index = 0, 1 do
					g:box("Tape", V(32 + FINE * 2, 14, 44 + FINE * 2), CF(0, -30 - index * 32, 0), F.tape)
				end
			end)
		end)
		g:hand("GripHand", V(32, -66, 84), V(-0.3, 0.1, -1), V(1, 0.1, 0.3))
	else
		-- A straight English stock: a slim wrist dropping from the tang, the butt below it, checkering
		-- on the wrist.
		-- The wrist is where the hand holds a straight stock, so it carries the name Grip.
		g:rounded("Grip", V(34, 40, 130), CF(0, -14, 115) * A(8, 0, 0), 12, F.wood)
		g:rounded("Stock", V(40, 48, 250), CF(0, -42, 295) * A(4, 0, 0), 14, F.wood)
		g:wedge("StockWeb", V(38, 90, 230), CF(0, -110, 305) * A(0, 0, 180), F.wood)
		g:box("Buttplate", V(42, 140, 8), CF(0, -88, 424), F.woodDark)
		g:detail(function()
			for _, sx in ipairs(SIGNS) do
				g:box("Checkering", V(FINE * 2, 24, 60), CF(sx * 17, -14, 115) * A(8, 0, 0), F.woodDark)
			end
		end)
		-- The trigger hand wraps the wrist from the right: fingers down and round under it, the back of
		-- the hand to the right, the heel of the hand behind and above, below the line of sight.
		-- Forward on the wrist, just behind the guard, where the index finger reaches the triggers: further
		-- back it sat a hand's breadth under the eye and its forearm filled the right of the sight picture.
		-- The fingers point 30 degrees down the wrist rather than 50, and the hand sits 4 mm lower and 4 mm
		-- further forward: steeper, no elbow that stays out of the sight picture could line the forearm up
		-- with the hand, and the wrist met it at 105 degrees at full aim (#11); with the palm at its real
		-- length, the forearm behind it then came into the crosshair's ring unless the hand came forward.
		-- Measured by tools/fps_arms_check.py.
		g:hand("GripHand", V(32, -24, 70), V(-0.25, -0.5, -0.83), V(1, 0.35, 0.05))
	end

	if v.engraved or g.rarityIndex &gt;= 5 then
		for _, sx in ipairs(SIGNS) do
			g:engraving(CF(sx * (23 + FINE), -18, 8), 80, 30)
		end
	end

	g.model:SetAttribute("Optic", "iron")
	-- The full gun has its cheek on the comb, the eye over the stock; the sawn-off has no stock and is
	-- aimed held out in front, like a handgun.
	g.model:SetAttribute("EyeRelief", sawn and 1.0 or 0.78)
	g:key("Sight", CF(0, 24, 50))
	g:key("Muzzle", CF(0, 0, barrelEnd - 4))
	g.model:SetAttribute("Action", "break")
	g.model:SetAttribute("Flash", "shotgun")
	g.model:SetAttribute("Casing", "shell")
	return action
end

-- The light machine gun, measured off an M249: a long stamped receiver with the feed cover hinged at
-- its front and a rail on it, the charging handle on the right, a railed handguard under the barrel
-- and a heat shield over it, the carry handle folded up over the barrel, the gas block with its
-- bipod, a fixed stock with its shoulder rest, and a 200-round box under the feed tray with the belt
-- climbing out of it into the gun.
STYLES.lmg = function(g)
	local metal = g.skinned and g.skin or (g.rarityIndex &gt;= 4 and g:finish("receiver") or F.nitride)
	local furniture = g:finish("furniture")
	local small = g:finish("small")

	-- Receiver, feed tray, port, charging handle.
	local receiver = g:box("Receiver", V(50, 60, 330), CF(0, -12, -60), metal)
	g:detail(function()
		for _, sx in ipairs(SIGNS) do
			for _, y in ipairs({ 6, -30 }) do
				g:box("ReceiverRib", V(FINE * 2, 5, 110), CF(sx * 25, y, 35), metal)
			end
		end
		for _, z in ipairs({ -200, 60 }) do
			g:pin("ReceiverPin", 8, CF(0, -34, z), F.steel, 50 + FINE * 2)
		end
	end)
	g:box("FeedTray", V(FINE * 2, 22, 56), CF(-25, 6, -110), F.shadow)
	g:box("EjectionPort", V(FINE * 2, 20, 70), CF(25, -22, -110), F.shadow)
	g:key("Eject", CF(30, -26, -110) * A(0, -60, -40))
	g:group("charge", function()
		g:box("ChargingHandle", V(22, 12, 18), CF(36, 0, -170), F.steel)
		g:ball("ChargingKnob", 14, CF(48, 0, -170), F.polymerDark)
	end)
	g:travel("charge", 110)
	-- Turned 60 degrees on the palm and tilted -30 so the wrist is not bent past 47 degrees working it (it was 112): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(56, 20, -164), V(0.42, -0.6, -0.68), V(0.89, 0.12, 0.44))

	-- Feed cover, hinged at its front, with a rail and the rear sight.
	g:group("cover", function()
		g:prism("FeedCover", V(52, 20, 190), CF(0, 28, -80), 5, metal, "top")
		g:rail("CoverRail", 150, CF(0, 38, -90))
		g:box("CoverLatch", V(30, 10, 18), CF(0, 30, 24), small)
		g:box("RearSightBase", V(30, 8, 26), CF(0, 42, 0), metal)
		for _, sx in ipairs(SIGNS) do
			g:box("RearSightEar", V(4, 18, 18), CF(sx * 12, 55, 0), metal)
		end
		g:shell("RearSight", 4, 10, 3, CF(0, 58, 0), metal, 8)
		g:aperturePlate(CF(0, 0, 0), 46, 58, metal)
	end)
	g:swing("cover", CF(0, 30, -175), -72)
	-- Turned -90 degrees on the palm so the wrist is not bent past 72 degrees working it (it was 131): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("CoverHand", V(-14, 58, 20), V(0.97, 0.19, 0.17), V(-0.07, 0.85, -0.53))

	-- Trigger housing, guard, grip.
	g:box("TriggerHousing", V(34, 18, 110), CF(0, -51, 20), metal)
	g:box("TriggerGuard", V(14, 6, 70), CF(0, -78, 20), metal)
	g:box("TriggerGuard", V(14, 15, 7), CF(0, -67.5, -12), metal)
	g:group("trigger", function()
		g:box("Trigger", V(6, 18, 6), CF(0, -68, 12) * A(-10, 0, 0), F.steel)
	end)
	g:swing("trigger", CF(0, -60, 12), 10)
	g:grip(V(0, -60, 52), 14, furniture, { length = 104, depth = 48, front = 24, back = 32, grooves = 3 })
	g:hand("GripHand", V(33, -98, 70), V(-0.3, 0.05, -1), V(1, 0.2, 0.3))

	-- Stock.
	g:cyl("StockTube", 20, 32, CF(0, -8, 115), metal)
	g:rounded("Stock", V(44, 44, 260), CF(0, -10, 255), 13, furniture)
	g:wedge("StockWeb", V(40, 90, 230), CF(0, -77, 270) * A(0, 0, 180), furniture)
	g:prism("Buttpad", V(48, 140, 24), CF(0, -55, 397), 5, F.rubber)
	-- The folded shoulder rest lies on top of the butt.
	g:box("ShoulderRest", V(40, 10, 60), CF(0, 16.5, 350), metal)

	-- Barrel, heat shield, handguard, gas block, bipod, front sight, carry handle, flash hider.
	g:cyl("Barrel", 465, 24, CF(0, 0, -457.5), F.nitride)
	g:heatShield(CF(0, 0, -355), 230, 20)
	g:prism("Handguard", V(52, 34, 200), CF(0, -30, -335), 6, furniture)
	g:rail("HandguardRail", 180, CF(0, -47, -335) * A(180, 0, 0))
	for _, sx in ipairs(SIGNS) do
		g:rail("HandguardRail", 150, CF(sx * 26, -30, -335) * A(0, 0, -sx * 90))
	end
	-- On the rail under the handguard: its teeth are the lowest surface at y -56.5, and a palm lands 14.5 mm
	-- past its keypoint, so the hand's middle sits at -71. At -86 it held nothing but air.
	g:hand("SupportHand", V(-8, -71, -330), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g:cyl("GasTube", 245, 16, CF(0, -22, -347.5), metal)
	g:box("GasBlock", V(32, 36, 50), CF(0, -18, -495), metal)
	g:bipod(CF(0, -36, -500))
	g:box("FrontSightBase", V(30, 16, 22), CF(0, 16, -655), metal)
	g:box("FrontSightPost", V(4, 34, 5), CF(0, 41, -655), metal)
	g:box("FrontSight", V(2.4, 9, 3), CF(0, 53.5, -655), metal)
	-- The carry handle is folded down to the left, the way it's carried when firing, so it's out of
	-- the line between the rear aperture and the front post.
	g:at(CF(0, 12, -300), function()
		g:box("CarryHandleBase", V(26, 12, 32), CF(0, 6, 0), metal)
		g:at(CF(0, 12, 0) * A(0, 0, 75), function()
			g:box("CarryHandle", V(14, 80, 14), CF(0, 40, 0), metal)
			g:cylX("CarryHandleGrip", 64, 20, CF(0, 84, 0), F.rubber)
		end)
	end)
	local muzzleZ = -690 + g:birdcage(CF(0, 0, -690), 26)
	g:key("Muzzle", CF(0, 0, muzzleZ))

	-- The 200-round box and the belt climbing into the feed tray: rounds point forward, links between.
	g:group("mag", function()
		g:prism("Magazine", V(80, 110, 120), CF(-14, -100, -110), 6, F.polymerDark)
		g:box("MagazineLid", V(82, 8, 122), CF(-14, -43, -110), F.polymerDark)
		g:detail(function()
			for _, sx in ipairs(SIGNS) do
				g:box("MagazineLatch", V(FINE * 2, 20, 16), CF(-14 + sx * 40, -60, -110), small)
			end
		end)
		local path = { V(-40, -40, -110), V(-44, -26, -110), V(-44, -12, -110), V(-38, 0, -110), V(-30, 8, -110) }
		for index, point in ipairs(path) do
			g:cyl("MagazineBelt", 50, 10, CF(point + V(0, 0, 6)), F.brass)
			g:cyl("MagazineBullet", 12, 8, CF(point + V(0, 0, -25)), F.copper)
			if index &lt; #path then
				local nextPoint = path[index + 1]
				local middle = (point + nextPoint) / 2
				g:box("MagazineLink", V(12, 3, 8), CFrame.lookAt(middle, middle + (nextPoint - point)) * A(0, 90, 0), F.steel)
			end
		end
	end)
	g:key("MagWell", CF(-14, -45, -110))
	g:hand("MagHand", V(-62, -100, -110), V(0.6, 0.5, -0.1), V(-1, 0, 0))

	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 0.5)
	g:key("Sight", CF(0, 58, 10))
	g.model:SetAttribute("Action", "belt")
	g.model:SetAttribute("Flash", "rifle")
	g.model:SetAttribute("Casing", "rifle")
	return receiver
end

-- The rotary gun, patterned on an M134 carried by hand: six barrels in two clamps round a hub, the
-- rotor housing and gearbox behind them, the drive motor slung underneath, the feeder-delinker on the
-- left fed by a chute from the ammunition box, a battery on the back, a raised carry handle for the
-- left hand and a spade grip under the gearbox for the right, and a red dot sighting between the
-- handle's posts.
STYLES.minigun = function(g)
	local metal = g.skinned and g.skin or F.nitride
	local trim = g.rarityIndex &gt;= 5 and F.gold or F.anodizedDark
	local furniture = g:finish("furniture")
	local small = g:finish("small")

	-- The spinning group: barrels, clamps, hub, muzzle faces.
	g:group("spin", function()
		for index = 0, 5 do
			local offset = CFrame.Angles(0, 0, index / 6 * math.pi * 2) * CF(0, 24, 0)
			g:cyl("Barrel", 600, 16, CF(0, 0, -420) * offset, metal)
			g:cyl("Bore", FINE, 11, CF(0, 0, -720 - FINE / 2) * offset, F.bore)
		end
		g:cyl("BarrelClamp", 16, 76, CF(0, 0, -680), trim)
		g:cyl("BarrelClamp", 14, 72, CF(0, 0, -440), metal)
		g:cyl("BarrelClampHub", 20, 20, CF(0, 0, -697), F.steel)
		g:detail(function()
			for index = 0, 5 do
				local angle = (index + 0.5) / 6 * math.pi * 2
				g:box("BarrelClampBolt", V(6, 6, 16 + FINE * 2), CF(0, 0, -680) * CFrame.Angles(0, 0, angle) * CF(0, 33, 0), F.steel)
			end
		end)
	end)
	g:swing("spin", CF(0, 0, -400) * A(0, 90, 0))
	g:key("Muzzle", CF(0, 0, -724))

	-- Rotor housing, gearbox, rear cap, motor, battery.
	local housing = g:cyl("Receiver", 180, 110, CF(0, 0, -30), metal)
	g:detail(function()
		for index = 0, 3 do
			g:cyl("HousingRib", 6, 110 + FINE * 2, CF(0, 0, -100 + index * 44), trim)
		end
	end)
	g:cyl("Gearbox", 90, 104, CF(0, 0, 105), metal)
	g:cyl("RearCap", 20, 90, CF(0, 0, 160), metal)
	g:cyl("Motor", 130, 56, CF(0, -64, 50), F.anodizedDark)
	g:cyl("MotorCap", 14, 50, CF(0, -64, 122), trim)
	g:box("Battery", V(70, 50, 90), CF(0, -40, 215), F.polymerDark)
	g:detail(function()
		g:box("BatteryLight", V(10, 5, FINE * 2), CF(20, -30, 260 + FINE), F.tritium)
	end)

	-- Feeder-delinker on the left, the chute, the ammunition box under it.
	g:box("Feeder", V(56, 70, 90), CF(-78, 0, -20), metal)
	g:box("FeederChute", V(40, FINE * 2, 60), CF(-78, -35 - FINE, -20), F.shadow)
	g:group("mag", function()
		g:prism("Magazine", V(90, 130, 170), CF(-88, -140, 10), 8, F.od)
		g:box("MagazineLid", V(92, 8, 172), CF(-88, -71, 10), F.od)
		for index = 0, 3 do
			local t = index / 3
			g:box("MagazineChute", V(46, 12, 60), CF(-80 - t * 6, -64 + t * 26, -20) * A(0, 0, (t - 0.5) * 20), F.fabric)
		end
		g:detail(function()
			g:box("MagazineMark", V(FINE * 2, 30, 80), CF(-88 - 45, -140, 10), F.warning)
		end)
	end)
	g:key("MagWell", CF(-78, -40, -20))
	g:hand("MagHand", V(-88, -150, 90), V(0, 0.4, -1), V(-1, 0, 0))

	-- A raised carry handle for the left hand, a spade grip for the right. Each end stands on a pair of
	-- posts either side of the red dot, joined by a crossbar high over it, so nothing crosses the
	-- sight picture.
	for _, z in ipairs({ -90, 70 }) do
		for _, sx in ipairs(SIGNS) do
			g:box("CarryHandlePost", V(10, 112, 18), CF(sx * 30, 96, z), metal)
		end
		g:box("CarryHandleBar", V(74, 14, 22), CF(0, 154, z), metal)
	end
	g:cyl("CarryHandle", 180, 26, CF(0, 160, -10), F.rubber)
	-- The left hand holds the gun up from under the front of the housing; reaching up to the carry
	-- handle put the whole arm across the sight picture.
	g:hand("SupportHand", V(-10, -70, -90), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g:grip(V(0, -52, 128), 8, furniture, { length = 112, depth = 50, front = 26, back = 34, grooves = 3 })
	g:hand("GripHand", V(34, -92, 142), V(-0.3, 0.05, -1), V(1, 0.2, 0.3))
	g:group("trigger", function()
		g:box("Trigger", V(12, 14, 8), CF(0, -66, 102), small)
	end)
	g:swing("trigger", CF(0, -60, 104), 8)

	-- A red dot on a short rail over the housing, sighting under the handle.
	g:box("SightRailBase", V(26, 10, 90), CF(0, 58, -10), metal)
	g:rail("SightRail", 80, CF(0, 63, -10))
	local h = g:redDot(CF(0, 72.5, -10))
	g:key("Sight", CF(0, 72.5 + h, 55))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.66)

	g.model:SetAttribute("Action", "rotary")
	g.model:SetAttribute("Flash", "rotary")
	g.model:SetAttribute("Casing", "rifle")
	return housing
end

-- The rocket launcher, patterned on an RPG-7 with a PG-7V round loaded: a launch tube with its rear
-- venturi flaring out behind, two wooden heat shields in steel bands, a trigger grip and a rear grip,
-- folding iron sights on top and the optic on its bracket on the left, and the warhead standing out
-- of the muzzle -- booster, the fat body and the stepped nose cone with its fuse.
local function buildRocketLauncher(g)
	local metal = g.skinned and g.skin or F.parkerized
	local furniture = g:finish("furniture")

	local tube = g:cyl("Receiver", 810, 42, CF(0, 0, -75), metal)
	-- Venturi: stepping out behind the tube, hollow so it reads as the exhaust it is. Each step's wall
	-- reaches in past the one before and overlaps it, so the flare is one piece.
	g:shell("Venturi", 44, 52, 5, CF(0, 0, 350), metal)
	g:shell("Venturi", 44, 66, 8, CF(0, 0, 390), metal)
	g:shell("Venturi", 44, 80, 8, CF(0, 0, 430), metal)
	g:shell("VenturiRim", 8, 86, 7, CF(0, 0, 454), metal)
	g:cyl("VenturiThroat", 8, 44, CF(0, 0, 334), F.bore)
	g:key("Backblast", CF(0, 0, 470))

	-- Wooden heat shields in bands.
	for _, shield in ipairs({ { -205, 190 }, { 120, 160 } }) do
		g:cyl("HeatShield", shield[2], 60, CF(0, 0, shield[1]), F.wood)
		for _, sz in ipairs(SIGNS) do
			g:cyl("HeatShieldBand", 10, 63, CF(0, 0, shield[1] + sz * (shield[2] / 2 - 8)), metal)
		end
	end

	-- Grips, trigger housing, guard.
	g:box("TriggerHousing", V(28, 24, 90), CF(0, -30, -10), metal)
	g:grip(V(0, -42, 14), 6, furniture, { length = 100, depth = 44, front = 24, back = 30, grooves = 2 })
	g:grip(V(0, -26, 170), 4, furniture, { length = 88, depth = 40, front = 24, back = 28 })
	g:box("TriggerGuard", V(12, 6, 66), CF(0, -76, -12), metal)
	g:box("TriggerGuard", V(12, 28, 6), CF(0, -59, -42), metal)
	g:group("trigger", function()
		g:box("Trigger", V(6, 18, 6), CF(0, -50, -14) * A(-10, 0, 0), F.steel)
	end)
	g:swing("trigger", CF(0, -46, -14), 10)
	g:hand("GripHand", V(33, -76, 30), V(-0.3, 0.05, -1), V(1, 0.2, 0.3))
	g:hand("SupportHand", V(-8, -44, -210), V(0.8, 0.55, -0.2), V(-0.4, -1, 0))

	-- Folding iron sights and the optic.
	g:box("FrontSightBase", V(20, 8, 26), CF(0, 24, -330), metal)
	for _, sx in ipairs(SIGNS) do
		g:box("FrontSightEar", V(4, 26, 12), CF(sx * 8, 40, -330), metal)
	end
	g:box("FrontSightPost", V(3.5, 14, 4), CF(0, 34, -330), metal)
	g:box("FrontSight", V(2.4, 8, 3), CF(0, 45, -330), metal)
	g:box("RearSightBase", V(26, 8, 34), CF(0, 24, -40), metal)
	for _, sx in ipairs(SIGNS) do
		g:box("RearSight", V(9, 22, 5), CF(sx * 7, 38, -40), metal)
	end
	g:key("Sight", CF(0, 49, -20))
	-- The optic rides a PGO-7-style side mount: a rail along the tube's left flank (its inner face sunk
	-- into the tube), a riser standing up out of it, and a saddle with two clamp rings that the optic body
	-- sits down into, closed by a lever on the riser.
	g:box("OpticRail", V(11, 22, 76), CF(-20.5, 0, -62), metal)
	g:box("OpticBracket", V(12, 38, 46), CF(-30, 11, -73), metal)
	g:box("OpticSaddle", V(24, 12, 86), CF(-44, 31, -75), metal)
	for _, z in ipairs({ -110, -40 }) do
		g:shell("OpticClamp", 10, 40, 4, CF(-44, 48, z), metal)
	end
	g:detail(function()
		g:box("OpticLever", V(5, 8, 30), CF(-37, 8, -73), F.steel)
		g:ball("OpticLeverKnob", 8, CF(-40, 8, -88), F.steel)
	end)
	g:at(CF(-44, 48, -80), function()
		g:cyl("Optic", 140, 34, CF(0, 0, 0), F.anodizedDark)
		g:cyl("OpticEyecup", 26, 38, CF(0, 0, 83), F.rubber)
		g:cyl("OpticObjective", 20, 38, CF(0, 0, -80), F.anodizedDark)
		g:cyl("OpticLens", FINE, 30, CF(0, 0, -90 - FINE / 2), F.coated)
		g:cylY("OpticKnob", 12, 16, CF(0, 23, 20), F.anodizedDark)
	end)
	g:slingLoop(CF(0, -21, -300))
	g:slingLoop(CF(0, -21, 250))

	-- The PG-7V round, standing out of the muzzle: booster, body, nose cone, fuse. A reload slides a
	-- new one into the tube from the front.
	g:group("round", function()
		g:cyl("RocketBooster", 60, 38, CF(0, 0, -510), F.warhead)
		g:cyl("RocketBody", 120, 85, CF(0, 0, -600), F.warhead)
		g:cyl("RocketBand", 8, 86, CF(0, 0, -548), F.warning)
		g:cyl("RocketCone", 36, 70, CF(0, 0, -678), F.warhead)
		g:cyl("RocketCone", 36, 50, CF(0, 0, -714), F.warhead)
		g:cyl("RocketCone", 30, 30, CF(0, 0, -747), F.warhead)
		g:cyl("RocketFuse", 20, 16, CF(0, 0, -772), F.steel)
		g:ball("RocketTip", 16, CF(0, 0, -782), F.steel)
	end)
	g:key("Load", CF(0, 0, -520))
	g:key("Muzzle", CF(0, 0, -482))

	g.model:SetAttribute("Optic", "iron")
	-- The eye rides over the rear grip, well behind the optic on its bracket, so the optic sits off to
	-- the left of the sight picture instead of filling that side of it.
	g.model:SetAttribute("EyeRelief", 0.9)
	g.model:SetAttribute("Action", "rocket")
	g.model:SetAttribute("Flash", "rocket")
	g.model:SetAttribute("Casing", "none")
	return tube
end

-- The six-shot grenade launcher, patterned on an MGL: a cylinder of six chamber tubes between end
-- plates on a crane that swings out to the left, a top strap carrying a rail and a reflex sight, the
-- short 40mm barrel, a pistol grip and a vertical foregrip, and a collapsible stock on a tube.
local function buildGrenadeLauncher(g)
	local metal = g.skinned and g.skin or F.nitride
	local furniture = g:finish("furniture")
	local axisY = -52

	-- Rear frame, top strap, front frame, barrel.
	local frame = g:box("Receiver", V(64, 160, 36), CF(0, -52, 8), metal)
	-- The top strap sits down into both frames, joining the front of the gun to the back.
	g:prism("TopStrap", V(32, 15.5, 330), CF(0, 35.25, -145), 4, metal, "top")
	g:rail("TopRail", 250, CF(0, 43, -130))
	g:box("Frame", V(70, 150, 30), CF(0, -47, -305), metal)
	g:cyl("Barrel", 280, 54, CF(0, 0, -460), metal)
	g:cyl("Bore", FINE, 42, CF(0, 0, -600 - FINE / 2), F.bore)
	g:detail(function()
		for index = 0, 3 do
			g:cyl("BarrelRib", 10, 54 + FINE * 2, CF(0, 0, -360 - index * 60), F.anodizedDark)
		end
	end)
	g:key("Muzzle", CF(0, 0, -604))

	-- The cylinder: six tubes round an axle, plates front and back, grenade noses showing.
	g:group("crane", function()
		-- The crane arm runs the cylinder's full length into both end plates (short of them, it floated).
		g:box("Crane", V(20, 20, 264), CF(-30, -118, -145), metal)
		g:group("drum", function()
			g:cyl("DrumAxle", 270, 22, CF(0, axisY, -145), F.steel)
			for _, z in ipairs({ -14, -276 }) do
				g:cyl("DrumPlate", 12, 150, CF(0, axisY, z), metal)
			end
			for index = 0, 5 do
				local offset = CF(0, axisY, 0) * CFrame.Angles(0, 0, index / 6 * math.pi * 2) * CF(0, 52, 0)
				g:cyl("DrumTube", 250, 50, offset * CF(0, 0, -145), metal)
				g:group("rounds", function()
					g:ball("RoundNose", 36, offset * CF(0, 0, -283), F.warhead)
				end)
			end
		end)
	end)
	g:swing("drum", CF(0, axisY, -145) * A(0, 90, 0), 60)
	-- Out to the left, clear of the frame and of the hand on the grip (about its own hinge's X, laid along
	-- the bore; the other way round it swung right, across the firing hand).
	g:swing("crane", CF(-34, -128, -145) * A(0, -90, 0), 70)
	g.model:SetAttribute("Parent_drum", "crane")
	g.model:SetAttribute("Parent_rounds", "drum")
	g:key("Load", CF(-120, -40, -300))

	-- Grip, guard, trigger, foregrip, stock.
	g:grip(V(0, -132, 20), 14, furniture, { length = 100, depth = 46, front = 24, back = 32, grooves = 3 })
	g:box("TriggerGuard", V(14, 6, 70), CF(0, -160, -16), metal)
	g:box("TriggerGuard", V(14, 22, 6), CF(0, -146, -48), metal)
	-- The trigger hangs from a housing run forward under the receiver's front (it was in front of the
	-- receiver with nothing above it).
	g:box("TriggerHousing", V(20, 10, 30), CF(0, -129, -20), metal)
	g:group("trigger", function()
		g:box("Trigger", V(6, 24, 6), CF(0, -137, -12) * A(-10, 0, 0), F.steel)
	end)
	g:swing("trigger", CF(0, -132, -12), 10)
	g:hand("GripHand", V(34, -170, 40), V(-0.3, 0.05, -1), V(1, 0.2, 0.3))
	g:foregrip(CF(0, -122, -305))
	g:hand("SupportHand", V(-30, -182, -300), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))
	g:cyl("StockTube", 200, 30, CF(0, -40, 126), F.anodizedDark)
	g:at(CF(0, -40, 230), function()
		g:rounded("Stock", V(40, 42, 150), CF(0, -3, 0), 13, furniture)
		g:wedge("StockWeb", V(34, 76, 130), CF(0, -60, 10) * A(0, 0, 180), furniture)
		g:rounded("Buttpad", V(44, 20, 128), CF(0, -38, 83) * A(90, 0, 0), 8, F.rubber)
	end)

	-- Reflex sight.
	local h = g:redDot(CF(0, 52.5, -90))
	g:key("Sight", CF(0, 52.5 + h, -20))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.66)

	g.model:SetAttribute("Action", "grenade")
	g.model:SetAttribute("Flash", "launcher")
	g.model:SetAttribute("Casing", "none")
	return frame
end

STYLES.launcher = function(g)
	if g.variant.sixShot then
		return buildGrenadeLauncher(g)
	end
	return buildRocketLauncher(g)
end

-- The crossbow, patterned on a modern compound hunting crossbow: an AR-style stock on a buffer tube, a
-- trigger housing with its grip and safety, an aluminium rail with the flight groove, a riser carrying
-- split limbs out to the cams, the string cocked back to the latch with the cables crossing, a
-- foregrip with finger guards, a stirrup, a red dot, and the bolt on the rail with its vanes and
-- broadhead. With the bolt loosed the string lies straight between the cams (the StringRest parts,
-- hidden until then).
STYLES.crossbow = function(g)
	local metal = g.skinned and g.skin or F.anodizedDark
	local furniture = g:finish("furniture")
	local small = g:finish("small")

	-- Stock and trigger housing.
	g:cyl("BufferTube", 170, 30, CF(0, -6, 215), F.anodizedDark)
	g:at(CF(0, -3, 250), function()
		g:rounded("Stock", V(40, 42, 150), CF(0, -3, 0), 13, furniture)
		g:prism("StockCheek", V(34, 8, 120), CF(0, 22, 10), 3, furniture, "top")
		g:wedge("StockWeb", V(34, 76, 130), CF(0, -60, 10) * A(0, 0, 180), furniture)
		g:rounded("Buttpad", V(44, 20, 128), CF(0, -38, 83) * A(90, 0, 0), 8, F.rubber)
	end)
	local housing = g:prism("Receiver", V(40, 42, 220), CF(0, -12, 20), 6, furniture)
	g:rail("TopRail", 150, CF(0, 9, 30))
	g:grip(V(0, -33, 60), 18, furniture, { length = 104, depth = 48, front = 22, back = 31, grooves = 3 })
	g:box("TriggerGuard", V(14, 6, 64), CF(0, -60, 20), furniture)
	g:box("TriggerGuard", V(14, 24, 6), CF(0, -45, -10), furniture)
	g:group("trigger", function()
		g:box("Trigger", V(6, 18, 6), CF(0, -41, 18) * A(-12, 0, 0), F.steel)
	end)
	g:swing("trigger", CF(0, -34, 18), 12)
	g:detail(function()
		g:box("Safety", V(FINE * 2, 10, 22), CF(20, -4, 60), small)
	end)
	g:hand("GripHand", V(33, -70, 80), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	-- Rail with its flight groove, the latch, the riser.
	g:prism("Rail", V(34, 26, 520), CF(0, -6, -350), 5, metal, "bottom")
	g:box("FlightGroove", V(8, FINE * 2, 500), CF(0, 7 + FINE, -350), F.shadow)
	g:box("Latch", V(22, 8, 20), CF(0, 13, -72), F.steel)
	g:prism("Riser", V(150, 44, 50), CF(0, -4, -633), 8, metal)
	g:box("RiserBlock", V(60, 66, 40), CF(0, -30, -640), metal)
	g:key("Muzzle", CF(0, 12, -660))
	-- Turned 90 degrees on the palm so the wrist is not bent past 59 degrees working it (it was 140): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(-4, 26, -50), V(1, 0, -0.1), V(0.03, 0.96, 0.28))

	-- Split limbs sweeping out and back to the cams, the strings and the cables.
	local limbFinish = finishOf(metal.color:Lerp(Color3.new(0, 0, 0), 0.25), Mat.SmoothPlastic)
	local latch = V(0, 12, -70)
	local rest = -600
	for _, sx in ipairs(SIGNS) do
		local root = V(sx * 70, -4, -650)
		local tip = V(sx * 262, -4, -578)
		local along = tip - root
		for _, y in ipairs({ 14, -22 }) do
			local middle = (root + tip) / 2 + V(0, y, 0)
			g:box("Limb", V(along.Magnitude, 9, 40), CFrame.lookAt(middle, middle + along) * A(0, 90, 0), limbFinish)
		end
		g:cylY("Cam", 14, 66, CF(tip), F.anodized)
		g:cylY("CamGroove", 18, 58, CF(tip), F.anodizedDark)
		g:cylY("CamAxle", 50, 10, CF(tip), F.steel)
		local camEdge = tip + V(-sx * 30, 16, 0)
		-- Cocked: from the cam back to the latch.
		g:group("string", function()
			g:box("String", V(3, 3, (latch - camEdge).Magnitude), CFrame.lookAt((camEdge + latch) / 2, latch), F.polymerDark)
		end)
		-- At rest: straight across between the cams, hidden until the bolt is loosed.
		local restEnd = V(0, camEdge.Y, rest)
		local restString = g:box("StringRest", V(3, 3, (restEnd - camEdge).Magnitude), CFrame.lookAt((camEdge + restEnd) / 2, restEnd), F.polymerDark)
		restString.Transparency = 1
		restString:SetAttribute("Anim", "stringRest")
		local cableStart = tip + V(-sx * 22, -14, 0)
		local cableEnd = V(-sx * 24, -40, -610)
		g:box("Cable", V(3, 3, (cableEnd - cableStart).Magnitude), CFrame.lookAt((cableStart + cableEnd) / 2, cableEnd), F.polymerDark)
	end

	-- Foregrip with finger guards, stirrup.
	-- The foregrip hangs from the rail and the finger guards stand on its sides; the stirrup sweeps
	-- forward and down from the riser's front face.
	g:rounded("ForeGrip", V(40, 40, 130), CF(0, -38.5, -330), 14, furniture)
	for _, sx in ipairs(SIGNS) do
		g:box("FingerGuard", V(4, 34, 110), CF(sx * 21.5, -22, -330), furniture)
	end
	g:hand("SupportHand", V(-6, -74.5, -330), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g:box("Stirrup", V(104, 12, 12), CF(0, -72, -702), metal)
	for _, sx in ipairs(SIGNS) do
		g:box("Stirrup", V(12, 62, 12), CF(sx * 44, -46, -678) * A(30, 0, 0), metal)
	end

	-- Red dot.
	local h = g:redDot(CF(0, 18.5, 30))
	g:key("Sight", CF(0, 18.5 + h, 95))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.66)

	-- The bolt on the rail: carbon shaft, nock, three vanes, ferrule and broadhead.
	g:group("round", function()
		g:cyl("RocketShaft", 470, 8, CF(0, 12, -305), F.polymerDark)
		g:cyl("RocketNock", 12, 9, CF(0, 12, -64), finishOf(g.accent, Mat.SmoothPlastic))
		for index = 0, 2 do
			g:box("RocketFletch", V(1.5, 14, 60), CF(0, 12, -110) * CFrame.Angles(0, 0, index / 3 * math.pi * 2) * CF(0, 9, 0), F.shell)
		end
		g:cyl("RocketHead", 30, 10, CF(0, 12, -555), F.steel)
		for index = 0, 2 do
			g:wedge("RocketBlade", V(1.5, 12, 34), CF(0, 12, -580) * CFrame.Angles(0, 0, index / 3 * math.pi * 2) * CF(0, 6, 0), F.bright)
		end
	end)
	g:key("Load", CF(0, 30, -300))

	g.model:SetAttribute("Action", "crossbow")
	g.model:SetAttribute("Flash", "crossbow")
	g.model:SetAttribute("Casing", "none")
	return housing
end

-- The bubble gun: a pneumatic rifle built like a real one, in brass, copper, glass and black polymer.
-- A glass reservoir of soap solution rides on the left with a pressure gauge on its front cap and a
-- copper line to the barrel; a pump under the brass barrel charges it; the muzzle is a stepped bell
-- carrying a wand ring with a film of soap across it; the canister of solution plugs in under the
-- receiver ahead of the grip; the stock is a skeleton of brass tubes with a leather cheek pad. The
-- Burster carries the bigger reservoir.
STYLES.blaster = function(g)
	local v = g.variant
	local body = g.skinned and g.skin or g:finish("receiver")
	local furniture = g:finish("furniture")
	local small = g:finish("small")
	local tankDia = v.bigTank and 76 or 60
	local tankLength = v.bigTank and 180 or 150

	-- Receiver, rail and red dot.
	local receiver = g:rounded("Receiver", V(46, 56, 220), CF(0, -8, -10), 14, body)
	g:rail("TopRail", 150, CF(0, 20, -10))
	local h = g:redDot(CF(0, 29.5, 0))
	g:key("Sight", CF(0, 29.5 + h, 65))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.66)

	-- Brass barrel, the stepped bell, the wand ring with its film of soap.
	g:cyl("Barrel", 260, 24, CF(0, 0, -250), F.brass)
	g:cyl("MuzzleBrake", 20, 32, CF(0, 0, -390), F.brass)
	g:cyl("MuzzleBrake", 16, 42, CF(0, 0, -408), F.brass)
	g:cyl("MuzzleBrake", 10, 54, CF(0, 0, -421), F.brass)
	g:cyl("Bore", FINE, 20, CF(0, 0, -426 - FINE / 2), F.bore)
	for index = 0, 15 do
		g:box("WandRing", V(12.2, 3, 3), CF(0, 0, -440) * CFrame.Angles(0, 0, index / 16 * math.pi * 2) * CF(0, 30, 0), F.brass)
	end
	-- Three spokes carry the ring off the bell's face, each running from inside the bell out to the ring.
	for index = 0, 2 do
		g:box("WandSpoke", V(2, 20, 2), CF(0, 0, -432) * CFrame.Angles(0, 0, index / 3 * math.pi * 2) * CF(0, 25, 0) * A(-58, 0, 0), F.brass)
	end
	-- The film's edge sits a millimetre into the ring all round.
	g:cyl("WandFilm", 0.6, 59, CF(0, 0, -440), F.film)
	g:key("Muzzle", CF(0, 0, -444))

	-- Pump tube and pump.
	g:cyl("PumpTube", 260, 22, CF(0, -34, -250), F.copper)
	-- A band ties the tube's front to the barrel, ahead of the pump's forward stop (-285). Held only at
	-- the receiver it ran 11 mm clear of the barrel out to a free end: the lag-switch SMG's second barrel.
	g:box("BarrelBand", V(28, 40, 14), CF(0, -20, -355), F.copper)
	g:group("pump", function()
		g:rounded("Pump", V(40, 34, 110), CF(0, -36, -230), 12, furniture)
		g:detail(function()
			for index = 0, 4 do
				g:box("PumpRib", V(40 + FINE * 2, 22, 5), CF(0, -40, -270 + index * 20), furniture)
			end
		end)
	end)
	g:travel("pump", 60)
	g:hand("SupportHand", V(-6, -62, -230), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g.model:SetAttribute("SupportGroup", "pump")
	g:hand("ChargeHand", V(-6, -62, -230), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))

	-- The reservoir on the left: glass, the solution in it, bubbles, brass caps, tie rods, brackets.
	g:at(CF(-26 - tankDia / 2, 6, -40), function()
		g:cyl("Tank", tankLength, tankDia, CF(0, 0, 0), F.tank)
		g:cyl("TankLiquid", tankLength - 10, tankDia - 8, CF(0, -3, 0), F.soap)
		for index = 1, 6 do
			local angle = index * 2.4
			g:ball("TankBubble", 5 + (index % 3) * 2.5, CF(math.cos(angle) * tankDia * 0.2, tankDia * 0.14 - index * 3, -tankLength * 0.4 + index * tankLength * 0.12), F.bubble)
		end
		for _, sz in ipairs(SIGNS) do
			g:cyl("TankCap", 12, tankDia + 6, CF(0, 0, sz * (tankLength / 2 + 6)), F.brass)
		end
		for index = 0, 2 do
			local angle = math.rad(90 + index * 120)
			g:cyl("TankRod", tankLength + 24, 4, CF(math.cos(angle) * (tankDia / 2 + 4), math.sin(angle) * (tankDia / 2 + 4), 0), F.brass)
		end
		for _, sz in ipairs(SIGNS) do
			g:box("TankBracket", V(26, 16, 14), CF(tankDia / 2 + 6, 0, sz * tankLength * 0.3), F.brass)
		end
		-- Pressure gauge on the front cap, facing back at the shooter.
		g:box("GaugeStem", V(6, 12, 6), CF(0, tankDia / 2 + 6, -tankLength / 2 - 6), F.brass)
		g:at(CF(0, tankDia / 2 + 26, -tankLength / 2 - 6), function()
			g:cyl("Gauge", 10, 32, CF(0, 0, 0), F.brass)
			g:cyl("GaugeFace", FINE, 26, CF(0, 0, 5 + FINE / 2), F.dial)
			g:box("GaugeNeedle", V(1.2, 10, FINE * 2), CF(0, 0, 5 + FINE * 2) * A(0, 0, -40) * CF(0, 4, 0), F.redDot)
			g:cyl("GaugeGlass", FINE, 24, CF(0, 0, 5 + FINE * 3.5), F.lens)
		end)
	end)
	-- The copper line from the reservoir's front cap to the barrel.
	local line = { V(-26 - tankDia / 2, 6, -40 - tankLength / 2 - 12), V(-26 - tankDia / 2, 6, -150), V(-18, 4, -170), V(-10, 0, -190) }
	for index = 1, #line - 1 do
		local from, to = line[index], line[index + 1]
		g:box("CopperLine", V(6, 6, (to - from).Magnitude), CFrame.lookAt((from + to) / 2, to), F.copper)
		g:ball("CopperElbow", 8, CF(to), F.copper)
	end

	-- Grip, guard, trigger.
	g:grip(V(0, -36, 50), 16, furniture, { length = 100, depth = 46, front = 22, back = 30, grooves = 3 })
	g:box("TriggerGuard", V(12, 6, 60), CF(0, -66, 10), body)
	g:box("TriggerGuard", V(12, 27, 6), CF(0, -49.5, -20), body)
	g:group("trigger", function()
		-- Its top runs up into the body (it hung a millimetre under it).
		g:box("Trigger", V(6, 24, 6), CF(0, -43, -2) * A(-10, 0, 0), F.brass)
	end)
	g:swing("trigger", CF(0, -38, 0), 12)
	g:hand("GripHand", V(31, -72, 70), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	-- The canister of solution.
	g:group("mag", function()
		g:cylY("Magazine", 90, 40, CF(0, -80, -70), F.tank)
		g:cylY("MagazineLiquid", 80, 34, CF(0, -83, -70), F.soap)
		g:cylY("MagazineLabel", 30, 40 + FINE * 2, CF(0, -85, -70), finishOf(g.accent:Lerp(Color3.fromRGB(40, 40, 44), 0.35), Mat.SmoothPlastic))
		g:cylY("MagazineCap", 8, 36, CF(0, -129, -70), F.brass)
	end)
	g:key("MagWell", CF(0, -36, -70))
	g:hand("MagHand", V(-26, -120, -70), V(0.4, 0.5, -0.1), V(-1, 0, 0))

	-- Skeleton stock of brass tubes, a leather cheek pad, a rubber butt.
	g:cyl("StockTube", 200, 12, CF(0, 4, 200), F.brass)
	local from, to = V(0, -30, 100), V(0, -80, 300)
	g:box("StockTube", V(12, 12, (to - from).Magnitude), CFrame.lookAt((from + to) / 2, to), F.brass)
	g:rounded("Buttpad", V(44, 20, 130), CF(0, -34, 306) * A(90, 0, 0), 8, F.rubber)
	g:rounded("CheekPad", V(30, 16, 90), CF(0, 16, 210), 6, F.leather)

	g.model:SetAttribute("Action", "blaster")
	g.model:SetAttribute("Flash", "bubble")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

-- The Golden Sahur Cannon: a big-bore lever gun in the pattern of a Winchester 1887, gold-plated and
-- engraved. A deep receiver with a loading gate on the right and dark inlay down both sides, the finger
-- lever that swings down to cycle it, an exposed hammer, an octagonal barrel banded in gold ending in
-- a bell mouth, the magazine tube under it with a walnut forend, a buckhorn rear sight and a gold bead,
-- and a walnut stock with a gold butt plate.
STYLES.cannon = function(g)
	local gold = g.skinned and g.skin or F.gold
	local deep = g.skinned and g.skin or F.goldDeep

	local receiver = g:rounded("Receiver", V(44, 64, 170), CF(0, -12, -30), 12, gold)
	-- The gate stands proud of the side and reaches in past the engraving's inlay, so neither of its
	-- faces lies in the inlay's planes.
	g:box("LoadingGate", V(5.5, 22, 44), CF(22.15, -20, -40), F.blued)
	g:key("Load", CF(40, -20, -40))
	for _, sx in ipairs(SIGNS) do
		g:engraving(CF(sx * 22, -8, -40), 120, 34, F.blued)
	end

	g:group("hammer", function()
		g:box("Hammer", V(8, 22, 12), CF(0, 24, 48) * A(28, 0, 0), F.blued)
		g:box("HammerSpur", V(10, 6, 16), CF(0, 35, 56) * A(45, 0, 0), F.blued)
	end)
	g:swing("hammer", CF(0, 14, 44), -30)

	-- The finger lever, hinged under the front of the receiver.
	g:group("lever", function()
		g:box("Lever", V(10, 6, 60), CF(0, -47, 20), gold)
		g:box("Lever", V(10, 40, 8), CF(0, -66, 56) * A(-12, 0, 0), gold)
		g:box("Lever", V(10, 8, 64), CF(0, -88, 82), gold)
		g:box("Lever", V(10, 42, 8), CF(0, -68, 112) * A(20, 0, 0), gold)
	end)
	g:swing("lever", CF(0, -44, -10), 50)
	g:group("trigger", function()
		g:box("Trigger", V(6, 16, 5), CF(0, -54, 40) * A(-10, 0, 0), F.steel)
	end)
	g:swing("trigger", CF(0, -46, 40), 10)

	-- Octagonal barrel in gold bands, the bell, the bead and buckhorn.
	g:prism("Barrel", V(34, 34, 420), CF(0, 0, -325), 10, deep)
	for _, z in ipairs({ -150, -330, -500 }) do
		g:prism("BarrelBand", V(38.8, 38.8, 12), CF(0, 0, z), 11.4, gold)
	end
	g:cyl("MuzzleBrake", 25, 40, CF(0, 0, -547.5), gold)
	g:cyl("MuzzleBrake", 20, 54, CF(0, 0, -570), gold)
	g:cyl("MuzzleBrake", 14, 68, CF(0, 0, -587), gold)
	g:cyl("Bore", FINE, 36, CF(0, 0, -594 - FINE / 2), F.bore)
	g:key("Muzzle", CF(0, 0, -600))
	-- Sights stand tall enough that the line over them clears the bell mouth, and the eye rides high
	-- enough over the receiver that the camera's near plane never cuts into it. The bead's top is on
	-- the line; the buckhorn's notch bottom sits 2 mm under it, between the horns.
	g:box("FrontSight", V(3, 18, 6), CF(0, 25, -520), gold)
	g:ball("FrontBead", 5, CF(0, 34.5, -520), F.gold)
	g:box("RearSightBase", V(20, 12, 14), CF(0, 23, -150), gold)
	for _, sx in ipairs(SIGNS) do
		g:box("RearSightHorn", V(6, 15, 4), CF(sx * 7, 36, -150), gold)
	end
	g:box("RearSight", V(8, 7, 4), CF(0, 31.5, -150), gold)
	g:key("Sight", CF(0, 37, -100))
	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 0.5)

	-- Magazine tube and forend.
	g:cyl("MagTube", 350, 26, CF(0, -32, -290), gold)
	g:cyl("MagCap", 14, 29, CF(0, -32, -472), gold)
	g:rounded("ForeGrip", V(46, 38, 185), CF(0, -30, -208), 13, F.woodDark)
	g:box("ForendCap", V(48.8, 40.8, 10), CF(0, -30, -305), gold)
	g:hand("SupportHand", V(-8, -62, -210), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))

	-- Walnut stock with a gold butt plate.
	g:rounded("Grip", V(34, 40, 110), CF(0, -22, 110) * A(8, 0, 0), 12, F.woodDark)
	g:rounded("Stock", V(42, 50, 250), CF(0, -44, 290) * A(4, 0, 0), 14, F.woodDark)
	g:wedge("StockWeb", V(40, 90, 230), CF(0, -110, 300) * A(0, 0, 180), F.woodDark)
	g:box("Buttplate", V(44, 145, 8), CF(0, -85, 418), gold)
	g:hand("GripHand", V(30, -32, 90), V(-0.3, 0.2, -1), V(1, 0.2, 0.3))
	g.model:SetAttribute("GripGroup", "lever")

	g.model:SetAttribute("Action", "lever")
	g.model:SetAttribute("Flash", "cannon")
	g.model:SetAttribute("Casing", "shell")
	return receiver
end

-- The Delulu Railgun: a bullpup electromagnetic rifle, engineered rather than toy-like. A chamfered
-- body with the power cell behind the grip, two copper conductor rails in polymer insulators running
-- out ahead of it through six coil braces that glow along their inner faces, capacitors down the left
-- side and cooling fins down the right, a charging lever, a long scope, a foregrip under the rails,
-- and a crown of light at the muzzle.
STYLES.railgun = function(g)
	local body = g.skinned and g.skin or F.anodizedDark
	local furniture = g:finish("furniture")
	local small = g:finish("small")
	local energy = F.energy

	local receiver = g:prism("Receiver", V(62, 84, 500), CF(0, -22, 120), 8, body)
	g:prism("TopCover", V(54, 14, 360), CF(0, 27, 90), 5, furniture, "top")
	g:rail("TopRail", 300, CF(0, 34, 60))
	local h = g:scope(CF(0, 43.5, 80), "long")
	g:key("Sight", CF(0, 43.5 + h, 260))
	g.model:SetAttribute("Optic", "scope")
	g.model:SetAttribute("EyeRelief", 0.6)

	-- Rails and coil braces.
	for _, sx in ipairs(SIGNS) do
		g:box("RailInsulator", V(14, 40, 640), CF(sx * 22, 0, -450), F.polymerDark)
		g:box("RailConductor", V(FINE * 2, 26, 620), CF(sx * 15, 0, -450), F.copper)
	end
	for index = 0, 5 do
		local z = -200 - index * 105
		for _, sy in ipairs(SIGNS) do
			g:box("Coil", V(76, 10, 20), CF(0, sy * 25, z), body)
			g:box("CoilGlow", V(40, FINE * 2, 16), CF(0, sy * 20, z), energy)
		end
		for _, sx in ipairs(SIGNS) do
			g:box("Coil", V(10, 40, 20), CF(sx * 33, 0, z), body)
		end
	end
	-- The crown clamps the ends of the rail insulators: its sides bear on them and it overlaps their
	-- front ends.
	for _, sy in ipairs(SIGNS) do
		g:box("MuzzleCrown", V(84, 12, 16), CF(0, sy * 28, -775), body)
		g:box("MuzzleGlow", V(46, FINE * 2, 12), CF(0, sy * 22, -775), energy)
	end
	for _, sx in ipairs(SIGNS) do
		g:box("MuzzleCrown", V(12, 44, 16), CF(sx * 34.5, 0, -775), body)
	end
	g:key("Muzzle", CF(0, 0, -790))

	-- Capacitors down the left, cooling fins down the right, the charging lever.
	for _, y in ipairs({ 6, -30 }) do
		g:cyl("Capacitor", 160, 26, CF(-44, y, 60), F.anodized)
		for _, sz in ipairs(SIGNS) do
			g:cyl("CapacitorBand", 8, 26 + FINE * 2, CF(-44, y, 60 + sz * 60), energy)
		end
	end
	for index = 0, 6 do
		g:box("CoolingFin", V(12, 50, 3), CF(37, -10, -100 + index * 12), body)
	end
	g:group("charge", function()
		g:box("ChargingHandle", V(8, 12, 50), CF(35, 8, 200), small)
		g:ball("ChargingKnob", 12, CF(41, 8, 228), F.polymerDark)
	end)
	g:travel("charge", 40)
	-- Turned 45 degrees on the palm so the wrist is not bent past 75 degrees working it (it was 116): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(52, 22, 226), V(-0.12, -0.76, -0.63), V(0.98, -0.19, 0.04))

	-- Grip, guard, trigger, foregrip.
	g:grip(V(0, -64, 14), 16, furniture, { length = 104, depth = 48, front = 22, back = 31, grooves = 3 })
	g:box("TriggerGuard", V(14, 6, 70), CF(0, -94, -10), body)
	g:box("TriggerGuard", V(14, 27, 6), CF(0, -77.5, -42), body)
	g:group("trigger", function()
		-- Its top runs up into the body (it hung a millimetre under it).
		g:box("Trigger", V(6, 24, 6), CF(0, -71, -12) * A(-10, 0, 0), F.steel)
	end)
	g:swing("trigger", CF(0, -66, -12), 10)
	g:hand("GripHand", V(33, -102, 34), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))
	-- The foregrip's clamp hangs from a bridge across both rail insulators (under the gap between them it
	-- met only their inside edges).
	g:box("ForeGripBridge", V(55, 6, 40), CF(0, -21.6, -357), body)
	g:foregrip(CF(0, -20, -357))
	g:hand("SupportHand", V(-27, -76, -351), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))

	-- The power cell behind the grip, its charge showing through a window on each side.
	g:group("mag", function()
		g:prism("Magazine", V(44, 100, 70), CF(0, -104, 150), 6, F.polymerDark)
		for _, sx in ipairs(SIGNS) do
			g:box("MagazineGlow", V(FINE * 2, 60, 14), CF(sx * 22, -104, 150), energy)
		end
	end)
	g:key("MagWell", CF(0, -64, 150))
	g:hand("MagHand", V(-30, -160, 150), V(0.4, 0.5, -0.1), V(-1, 0, 0))

	-- Butt.
	g:rounded("Buttpad", V(66, 20, 110), CF(0, -24, 380) * A(90, 0, 0), 8, F.rubber)
	g:prism("CheekRest", V(46, 12, 150), CF(0, 40, 300), 4, furniture, "top")

	g.model:SetAttribute("Action", "energy")
	g.model:SetAttribute("Flash", "rail")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

--------------------------------------------------------------------------------
-- Finishing
--------------------------------------------------------------------------------

function GunModels.Supports(style)
	return STYLES[style or "rifle"] ~= nil
end

-- The sight line, as the old code named it: an invisible part on the line the eye looks along. Its
-- keypoint (KP_Sight) is the authority; this part is kept for anything still looking for it.
local function markSight(g)
	local sight = g.model:GetAttribute("KP_Sight")
	if not sight then
		return
	end
	local part = Instance.new("Part")
	part.Name = "AimPoint"
	part.Size = V(0.02, 0.02, 0.02)
	part.CFrame = sight
	part.Transparency = 1
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Parent = g.model
end

-- What a creative gun's builder gets besides the Builder `g`: the finishes and helpers, and STYLES so it
-- can borrow a stock mechanism. Read-only by convention.
GunModels.Kit = {
	F = F, finishOf = finishOf, V = V, CF = CF, A = A, SIGNS = SIGNS, RELIEF = RELIEF, FINE = FINE, MM = MM,
	Mat = Mat, STYLES = STYLES,
}

function GunModels.Build(def, color, material, options)
	options = options or {}
	local g = Builder.new(def, color, material, options)
	-- A creative or workshop gun (their Builders, by id) builds itself; everything after this (finish,
	-- sight marker, z-fight, receiver, muzzle, welds) is shared with the stock guns.
	local signature = GunModelsSignature.Builders and GunModelsSignature.Builders[def.id]
	local own = signature
		or (GunModelsCreative.Builders and GunModelsCreative.Builders[def.id])
		or (GunModelsWorkshop.Builders and GunModelsWorkshop.Builders[def.id])
	local build = own and function(builder)
		return own(builder, GunModels.Kit)
	end or STYLES[g.style] or STYLES.rifle
	local receiver = build(g)
	-- A signature gun carries its own colours: marked, so ArsenalFinish leaves it alone.
	if signature then
		g.model:SetAttribute("Signature", true)
	end
	ArsenalFinish.Apply(g.model, def.id, options.skinned == true)
	markSight(g)

	local model = g.model
	model:SetAttribute("WeaponId", def.id)
	model:SetAttribute("Style", g.style)
	model:SetAttribute("Detail", g.high and "high" or "low")

	ZFight.Fix({ model }, GunModels.ZFightOptions)

	model.PrimaryPart = receiver
	receiver.Name = "Receiver"
	-- Pivot on the design origin (the bore above the trigger), facing -Z, whatever the receiver's own
	-- orientation.
	receiver.PivotOffset = receiver.CFrame:Inverse()

	local muzzle = model:GetAttribute("KP_Muzzle") or CFrame.new(0, 0, -1)
	local attachment = Instance.new("Attachment")
	attachment.Name = "Muzzle"
	attachment.CFrame = receiver.CFrame:ToObjectSpace(muzzle)
	attachment.Parent = receiver

	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") and part ~= receiver then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = receiver
			weld.Part1 = part
			weld.Parent = part
		end
	end
	return model, receiver
end

return GunModels
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">GunModelsCreative</string><ProtectedString name="Source">-- Creative gun models: the everyday-object guns from CreativeArsenal.
--
-- GunModels.Build calls Builders[weaponId](g, Kit) for these ids instead of the style's stock builder,
-- and does everything after the build itself (the AimPoint, the z-fight pass, the Receiver, the Muzzle
-- attachment and welds). `g` is GunModels' Builder: every size and position below is in millimetres,
-- the origin on the bore axis above the trigger, the gun facing -Z with +X to the right. Each builder
-- returns its receiver part.
--
-- Each gun keeps the stock animation contract of the mechanism it borrows (Action), with the stock
-- keypoint layout for that mechanism, so the viewmodel's reload, rack and fire clips work unchanged:
--   pistol    slide group + Travel_slide, ChargeHand on the slide, Eject, a magazine in the grip
--   smg       bolt and charge groups + travel, ChargeHand, Eject, a box magazine forward of the grip
--   pump      pump group + Travel_pump, SupportHand riding it (SupportGroup), Load, Eject
--   blaster   the pump group as above plus a detachable magazine
--   rotary    the spin group turning about Pivot_spin (its X axis laid along the bore), a box magazine
--   rocket    one round group loaded at Load, fired from Muzzle
--   crossbow  string / stringRest groups (drawn and loosed), a round group at Load, ChargeHand
--   energy    charge group + travel and ChargeHand, a magazine
--   semi      bolt and charge groups, Eject, a box magazine
-- Sights follow the ADS contract: KP_Sight on the line the eye looks along, Optic, EyeRelief. Every
-- decoration is kept off that line and clear of the hands; tools/ads_align_probe.lua,
-- gun_gaps_probe.lua and ads_hands_probe.lua check each gun, gun_flush_probe.lua what z-fighting the
-- model's nudge pass couldn't fix, and gun_anim_probe.lua that a gun carries everything its Action needs.

local GunModelsCreative = {}

-- No variants yet: each creative gun is one design.
GunModelsCreative.Variants = {}

local Builders = {}
GunModelsCreative.Builders = Builders

local SIGNS = { 1, -1 }

-- A box spanning two points (a strut, a strap, a noodle).
local function strut(g, K, name, from, to, width, look)
	local length = (to - from).Magnitude
	return g:box(name, K.V(width, width, length), CFrame.lookAt((from + to) / 2, to), look)
end

-- A cylinder spanning two points.
local function rod(g, K, name, from, to, diameter, look)
	return g:cyl(name, (to - from).Magnitude, diameter, CFrame.lookAt((from + to) / 2, to), look)
end

local function plastic(K, r, g, b)
	return K.finishOf(Color3.fromRGB(r, g, b), K.Mat.SmoothPlastic)
end

local function glossy(K, r, g, b, reflectance)
	return K.finishOf(Color3.fromRGB(r, g, b), K.Mat.SmoothPlastic, reflectance or 0.15)
end

local function neon(K, r, g, b)
	return K.finishOf(Color3.fromRGB(r, g, b), K.Mat.Neon)
end

-- A trigger in its guard, the swing the viewmodel pulls it through.
local function trigger(g, K, z, bottom, look, guardLook)
	local V, CF, A = K.V, K.CF, K.A
	g:box("TriggerGuard", V(12, 6, 58), CF(0, bottom - 3, z + 8), guardLook)
	g:box("TriggerGuard", V(12, 26, 6), CF(0, bottom + 10, z - 22), guardLook)
	g:group("trigger", function()
		g:box("Trigger", V(6, 18, 6), CF(0, bottom + 18, z) * A(-10, 0, 0), look)
	end)
	g:swing("trigger", CF(0, bottom + 26, z + 2), 12)
end

--------------------------------------------------------------------------------
-- Common
--------------------------------------------------------------------------------

-- A bath-toy pistol: sky-blue frame, a yellow slide with an orange safety tip, and a rubber duck
-- perched beside the rear sight. Pistol mechanism, pistol keypoints.
Builders.SqueakyDuckPopper = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local frameLook = g.skinned and g.skin or plastic(K, 86, 176, 232)
	local slideLook = plastic(K, 255, 214, 64)
	local orange = plastic(K, 255, 128, 32)
	local front, back = -111, 77

	local frame = g:rounded("Frame", V(24, 22, 150), CF(0, -14, -22), 4, frameLook)
	g:box("FrameRail", V(20, 6, 60), CF(0, -26, -60), frameLook)

	g:group("slide", function()
		g:rounded("Slide", V(26, 26, back - front), CF(0, 4, (front + back) / 2), 7, slideLook)
		for index = 0, 5 do
			g:box("SlideSerration", V(27.5, 16, 3), CF(0, 4, back - 14 - index * 7), plastic(K, 232, 186, 40))
		end
		g:cyl("MuzzleCap", 14, 22, CF(0, 2, front - 5), orange)
		g:cyl("Bore", K.FINE, 10, CF(0, 0, front - 12 - K.FINE / 2), F.bore)
		-- Sights: a post at the front, a notch at the back, both tops on the line.
		g:box("FrontSightBase", V(8, 3, 10), CF(0, 17.5, front + 12), slideLook)
		g:box("FrontSight", V(3.5, 5, 6), CF(0, 19.5, front + 12), orange)
		g:box("RearSightBase", V(20, 4, 8), CF(0, 17.6, back - 12), slideLook)
		for _, sx in ipairs(SIGNS) do
			g:box("RearSight", V(7, 5, 7), CF(sx * 6.5, 19.5, back - 12), orange)
		end
	end)
	g:travel("slide", 58)
	g:key("Eject", CF(14, 8, -10) * A(0, -60, 0))
	g:key("Sight", CF(0, 22, back - 6))
	g:hand("ChargeHand", V(-4, 34, back - 22), V(1, -0.45, 0.1), V(0, 1, 0.1))

	-- The duck, on a perch off the frame's left side, clear of the slide's travel and of the sights.
	g:box("DuckPerch", V(22, 6, 24), CF(-21, -7, 52), frameLook)
	g:at(CF(-30, 4, 52), function()
		local yellow = plastic(K, 255, 220, 40)
		g:ball("DuckBody", 28, CF(0, 0, 0), yellow)
		g:ball("DuckTail", 12, CF(0, 8, 14), yellow)
		g:ball("DuckHead", 20, CF(0, 18, -10), yellow)
		g:wedge("DuckBeak", V(10, 5, 12), CF(0, 16, -22) * A(0, 180, 0), orange)
		for _, sx in ipairs(SIGNS) do
			g:ball("DuckEye", 4, CF(sx * 7, 21, -16), F.shadow)
		end
	end)

	trigger(g, K, 2, -40, orange, frameLook)
	local gripFrame = g:grip(V(0, -26, 40), 15, frameLook, { length = 100, depth = 54, front = 24, back = 30, grooves = 3 })
	g:at(gripFrame, function()
		g:group("mag", function()
			g:box("Magazine", V(19, 96, 32), CF(0, -54, 2), plastic(K, 60, 140, 200))
			g:prism("MagazinePlate", V(25, 7, 42), CF(0, -103.5, 2), 2, orange, "bottom")
		end)
		g:key("MagWell", CF(0, -100, 2))
	end)
	g:hand("GripHand", V(30, -62, 52), V(-0.3, 0.1, -1), V(1, 0.15, 0.3))
	g:hand("SupportHand", V(-33, -74, 38), V(0.55, -0.05, -1), V(-1, -0.1, -0.3))
	g:hand("MagHand", V(-26, -136, 62), V(0.35, 0.3, -0.2), V(-1, -0.1, 0))

	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 1.1)
	g.model:SetAttribute("Action", "pistol")
	g.model:SetAttribute("Flash", "squeak")
	g.model:SetAttribute("Casing", "none")
	g:key("Muzzle", CF(0, 0, front - 14))
	return frame
end

-- A squirt SMG: a teal pressure body, an orange nozzle, a pump-grip, and a clear juice box for a
-- magazine with its bendy straw feeding the gun. SMG mechanism, SMG keypoints.
Builders.JuiceBoxSquirter = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local body = g.skinned and g.skin or plastic(K, 40, 190, 180)
	local orange = plastic(K, 255, 140, 40)
	local white = plastic(K, 240, 240, 236)

	local receiver = g:rounded("Receiver", V(40, 50, 300), CF(0, -2, -20), 12, body)
	g:rounded("Tank", V(34, 30, 180), CF(0, -34, -70), 10, K.finishOf(Color3.fromRGB(150, 230, 255), K.Mat.Glass, 0.2, 0.55))
	g:rounded("TankWater", V(26, 16, 160), CF(0, -40, -70), 6, K.finishOf(Color3.fromRGB(80, 170, 255), K.Mat.SmoothPlastic, 0, 0.35))
	-- The nozzle, stepped down to a point.
	g:cyl("Barrel", 150, 18, CF(0, 0, -240), orange)
	g:cyl("MuzzleBrake", 30, 12, CF(0, 0, -330), orange)
	g:cyl("Bore", K.FINE, 6, CF(0, 0, -345 - K.FINE / 2), F.bore)
	g:key("Muzzle", CF(0, 0, -348))

	-- The bolt and the charging knob on the left, as on the stock SMG.
	g:group("bolt", function()
		g:box("BoltCarrier", V(10, 12, 40), CF(16, 8, -30), white)
	end)
	g:travel("bolt", 40)
	g:key("Eject", CF(20, 8, -30) * A(0, -70, 0))
	g:group("charge", function()
		g:box("ChargingHandle", V(14, 10, 12), CF(-24, 8, -120), orange)
		g:ball("ChargingKnob", 14, CF(-34, 8, -120), orange)
	end)
	g:travel("charge", 60)
	-- Turned -75 degrees on the palm and tilted 30 so the wrist is not bent past 61 degrees working it (it was 106): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(-44, 20, -122), V(-0.52, -0.56, -0.64), V(-0.72, -0.11, 0.68))

	-- Toy sights: a notch on a fin at the back, a post on a fin at the front, tops on the line (y=37).
	g:box("RearSightBase", V(26, 14, 20), CF(0, 28, 90), body)
	for _, sx in ipairs(SIGNS) do
		g:box("RearSight", V(8, 12, 8), CF(sx * 7, 31, 92), white)
	end
	g:box("FrontSightBase", V(10, 14, 16), CF(0, 28, -150), body)
	g:box("FrontSight", V(3, 8, 5), CF(0, 33, -150), white)
	g:key("Sight", CF(0, 37, 100))

	trigger(g, K, 24, -46, orange, body)
	g:grip(V(0, -26, 66), 16, body, { length = 98, depth = 46, front = 22, back = 30, grooves = 3 })
	g:hand("GripHand", V(31, -64, 82), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	-- The juice box: clear carton, juice, a label band, and the straw bending up into the gun.
	g:group("mag", function()
		g:box("Magazine", V(40, 76, 30), CF(0, -66, -76), K.finishOf(Color3.fromRGB(255, 250, 240), K.Mat.Glass, 0.15, 0.5))
		g:box("MagazineJuice", V(34, 52, 24), CF(0, -76, -76), K.finishOf(Color3.fromRGB(255, 150, 40), K.Mat.SmoothPlastic, 0, 0.2))
		g:box("MagazineLabel", V(41.5, 18, 31.5), CF(0, -86, -76), K.finishOf(g.accent, K.Mat.SmoothPlastic))
		rod(g, K, "MagazineStraw", V(0, -30, -76), V(0, -36, -76), 7, plastic(K, 255, 90, 150))
		rod(g, K, "MagazineStraw", V(0, -36, -76), V(0, -28, -88), 7, plastic(K, 255, 90, 150))
	end)
	-- The carton clips into a collar under the body rather than hanging off the straw.
	g:box("MagazineCollar", V(48, 12, 38), CF(0, -28, -76), body)
	g:key("MagWell", CF(0, -28, -76))
	g:hand("MagHand", V(-30, -120, -80), V(0.4, 0.25, -0.2), V(-1, -0.15, 0))

	-- The pump-grip the left hand holds.
	g:rounded("ForeGrip", V(34, 30, 70), CF(0, -24, -212), 10, orange)
	g:hand("SupportHand", V(-12, -44, -212), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	-- A stubby stock.
	g:rounded("Stock", V(30, 40, 90), CF(0, -8, 170), 10, body)
	g:rounded("Buttpad", V(34, 46, 16), CF(0, -8, 220), 8, orange)

	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 0.45)
	g.model:SetAttribute("Action", "smg")
	g.model:SetAttribute("Flash", "droplets")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

--------------------------------------------------------------------------------
-- Uncommon
--------------------------------------------------------------------------------

-- A pump shotgun with a stockpot for a receiver, a wooden-spoon pump and stock, and a colander rim for
-- a muzzle with noodles hanging off it. Pump mechanism, pump keypoints; the bead's crown is on the line.
Builders.SpaghettiSlinger = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local pot = g.skinned and g.skin or K.finishOf(Color3.fromRGB(200, 204, 210), K.Mat.Metal, 0.12)
	local wood = F.woodLight
	local noodle = plastic(K, 246, 212, 120)
	local sauce = plastic(K, 196, 44, 30)

	-- The pot's top stays 7 mm under the sight line (y = 23) so the pump's kick never lifts it into view.
	local receiver = g:cyl("Receiver", 220, 44, CF(0, -6, -30), pot)
	g:cyl("ReceiverRim", 8, 50, CF(0, -6, -142), pot)
	for _, sx in ipairs(SIGNS) do
		g:cylY("PotHandle", 8, 30, CF(sx * 34, -6, -30), F.shadow)
	end
	g:box("SauceDrip", V(20, 3, 30), CF(0, -24, -80), sauce)
	g:cyl("Barrel", 470, 24, CF(0, 0, -370), F.steel)
	g:cyl("MagTube", 400, 20, CF(0, -26, -330), pot)

	-- The colander rim at the muzzle: a ring of staves round the bore with a perforated flare, open in
	-- the middle so the bead and the target show through it.
	g:at(CF(0, 0, -618), function()
		-- Three spokes off the barrel's end carry the rim, none of them at the top.
		for _, degrees in ipairs({ 210, 270, 330 }) do
			local angle = math.rad(degrees)
			strut(g, K, "ColanderSpoke", V(math.cos(angle) * 8, math.sin(angle) * 8, 18), V(math.cos(angle) * 37, math.sin(angle) * 37, 0), 5, pot)
		end
		for index = 0, 15 do
			g:box("ColanderRim", V(15, 5, 6), CFrame.Angles(0, 0, index / 16 * math.pi * 2) * CF(0, 38, 0), pot)
		end
		for index = 0, 11 do
			local angle = index / 12 * math.pi * 2
			-- Each plank starts on the rim (radius 38) and flares out and back, so the inner edge stays
			-- well above the sight line (y = 23) at the top of the ring.
			g:box("ColanderWall", V(16, 3, 26), CFrame.Angles(0, 0, angle) * CF(0, 46, 10) * A(-40, 0, 0), pot)
			g:box("ColanderHole", V(4, 3 + K.FINE * 2, 4), CFrame.Angles(0, 0, angle) * CF(0, 46, 10) * A(-40, 0, 0), F.shadow)
		end
		-- Noodles hanging from the lower half of the rim only, never across the top.
		for index = 1, 5 do
			local angle = math.rad(200 + index * 28)
			local start = V(math.cos(angle) * 38, math.sin(angle) * 38, 0)
			local sway = V(math.cos(angle) * 6, -24 - index * 3, 6)
			strut(g, K, "Noodle", start, start + sway, 3, noodle)
			strut(g, K, "Noodle", start + sway, start + sway + V(-3, -14, 4), 3, noodle)
		end
	end)
	-- The bead on a post off the barrel, its crown on the line at y = 23.
	g:box("FrontSightPost", V(4, 9, 4), CF(0, 14, -606), F.steel)
	g:ball("FrontBead", 5, CF(0, 20.5, -606), F.brass)
	g:key("Muzzle", CF(0, 0, -624))

	-- The wooden-spoon pump.
	g:group("pump", function()
		g:rounded("Pump", V(46, 40, 180), CF(0, -28, -300), 16, wood)
		g:ball("PumpBowl", 44, CF(0, -34, -400), wood)
	end)
	g:travel("pump", 85)
	g:hand("SupportHand", V(-8, -56, -300), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g.model:SetAttribute("SupportGroup", "pump")
	g:key("Eject", CF(20, -2, -45) * A(0, -70, 0))
	-- Shells go in through the port in the pot's underside.
	g:key("Load", CF(0, -26, -60))

	trigger(g, K, 28, -48, F.steel, pot)
	g:grip(V(0, -26, 72), 22, wood, { length = 96, depth = 46, front = 22, back = 30 })
	g:hand("GripHand", V(31, -68, 104), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))
	-- The spoon-handle stock.
	rod(g, K, "Stock", V(0, -18, 90), V(0, -40, 330), 36, wood)
	g:ball("StockBowl", 60, CF(0, -44, 350), wood)
	g:box("MeatballBadge", V(3, 12, 12), CF(19, -24, 180), sauce)

	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 0.8)
	g:key("Sight", CF(0, 23, 40))
	g.model:SetAttribute("Action", "pump")
	g.model:SetAttribute("Flash", "noodle")
	g.model:SetAttribute("Casing", "shell")
	return receiver
end

-- A cassette boombox blaster: a chunky body with a speaker cone for a muzzle, an LED-meter holo on top,
-- a tape-deck slider as the pump and a cassette as the magazine. Blaster mechanism.
Builders.BoomboxBassline = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local body = g.skinned and g.skin or plastic(K, 52, 54, 62)
	local chrome = K.finishOf(Color3.fromRGB(196, 198, 204), K.Mat.Metal, 0.25)
	local purple = neon(K, 170, 90, 255)

	local receiver = g:rounded("Receiver", V(76, 84, 250), CF(0, -8, -70), 14, body)
	-- Speaker grille panels on each side, with the tape window on the left.
	for _, sx in ipairs(SIGNS) do
		g:box("SideGrille", V(3, 56, 110), CF(sx * 38.5, -8, -120), F.shadow)
		for index = 0, 5 do
			g:box("SideGrilleBar", V(4, 3, 104), CF(sx * 40, -28 + index * 8, -120), chrome)
		end
	end
	g:box("TapeWindow", V(3, 30, 60), CF(-38.5, -6, 10), K.finishOf(Color3.fromRGB(120, 140, 160), K.Mat.Glass, 0.2, 0.5))
	for _, dz in ipairs({ -16, 16 }) do
		g:cylX("TapeReel", 4, 18, CF(-37, -6, 10 + dz), F.shadow)
	end
	-- The front speaker: a surround, the cone and a dust cap, round the bore.
	g:at(CF(0, 0, -200), function()
		g:cyl("SpeakerSurround", 10, 70, CF(0, 0, -2), F.rubber)
		g:shell("SpeakerCone", 26, 56, 4, CF(0, 0, -18), plastic(K, 30, 30, 34), 12)
		g:cyl("SpeakerPole", 22, 12, CF(0, 0, -14), chrome)
		g:cyl("SpeakerCap", 6, 20, CF(0, 0, -24), chrome)
		g:cyl("SpeakerRing", 6, 74, CF(0, 0, 4), chrome)
	end)
	g:key("Muzzle", CF(0, 0, -232))
	-- The top: a rail and an LED-meter holo.
	g:rail("TopRail", 150, CF(0, 34, -40))
	local h = g:holo(CF(0, 43.5, -50))
	g:key("Sight", CF(0, 43.5 + h, 30))
	g.model:SetAttribute("Optic", "holo")
	g.model:SetAttribute("EyeRelief", 0.62)
	for index = 0, 4 do
		g:box("EqualizerLed", V(3, 4 + index * 3, 5), CF(38.5, 20 + index * 1.5, -40 + index * 9), purple)
	end

	-- The tape-deck slider under the body is the pump.
	g:group("pump", function()
		g:rounded("Pump", V(40, 26, 100), CF(0, -62, -150), 8, chrome)
	end)
	g:travel("pump", 50)
	-- The hand cups the slider from below with the fingers across its right side, level: pointing 30
	-- degrees up they ran into the body's rounded corner above the slider, even lying open, and every
	-- finger was parked -- a bare palm under the gun (#92, tools/fps_arms_check.py).
	g:hand("SupportHand", V(-6, -82, -150), V(0.9, 0.2, -0.3), V(-0.2, -1, 0))
	g.model:SetAttribute("SupportGroup", "pump")
	g:hand("ChargeHand", V(-6, -82, -150), V(0.9, 0.2, -0.3), V(-0.2, -1, 0))

	trigger(g, K, 8, -80, chrome, body)
	g:grip(V(0, -50, 60), 12, body, { length = 96, depth = 46, front = 22, back = 30, grooves = 3 })
	g:hand("GripHand", V(31, -88, 80), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	-- The cassette magazine, on its edge.
	g:group("mag", function()
		g:box("Magazine", V(16, 64, 90), CF(0, -80, -40), plastic(K, 240, 236, 226))
		g:box("MagazineLabel", V(17.5, 30, 70), CF(0, -74, -40), K.finishOf(g.accent, K.Mat.SmoothPlastic))
		for _, dz in ipairs({ -22, 22 }) do
			g:cylX("MagazineReel", 18, 16, CF(0, -94, -40 + dz), F.shadow)
		end
	end)
	g:box("TapeDeck", V(26, 20, 100), CF(0, -50, -40), body)
	g:key("MagWell", CF(0, -50, -40))
	g:hand("MagHand", V(-26, -120, -40), V(0.4, 0.5, -0.1), V(-1, 0, 0))
	g:rounded("Stock", V(40, 50, 110), CF(0, -20, 110), 12, body)
	g:rounded("Buttpad", V(44, 58, 16), CF(0, -22, 170), 8, F.rubber)

	g.model:SetAttribute("Action", "blaster")
	g.model:SetAttribute("Flash", "bassring")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

--------------------------------------------------------------------------------
-- Rare
--------------------------------------------------------------------------------

-- A gumball machine gatling: a red housing, six candy-striped barrels spinning round the axis, a
-- glass globe of gumballs on the left as the magazine, a coin-slot crank on the right, a red dot on
-- top. Rotary mechanism, minigun keypoints.
Builders.GumballGatling = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local red = g.skinned and g.skin or glossy(K, 214, 40, 48)
	local white = plastic(K, 246, 244, 240)
	local chrome = K.finishOf(Color3.fromRGB(200, 202, 208), K.Mat.Metal, 0.25)
	local candy = { plastic(K, 255, 90, 160), plastic(K, 90, 200, 255), plastic(K, 255, 220, 60), plastic(K, 120, 230, 120), plastic(K, 190, 120, 255) }

	g:group("spin", function()
		for index = 0, 5 do
			local offset = CFrame.Angles(0, 0, index / 6 * math.pi * 2) * CF(0, 22, 0)
			g:cyl("Barrel", 380, 16, CF(0, 0, -330) * offset, index % 2 == 0 and white or candy[1])
			for stripe = 0, 3 do
				g:cyl("BarrelStripe", 14, 17.5, CF(0, 0, -200 - stripe * 90) * offset, index % 2 == 0 and candy[1] or white)
			end
			g:cyl("Bore", K.FINE, 11, CF(0, 0, -520 - K.FINE / 2) * offset, F.bore)
		end
		g:cyl("BarrelClampHub", 20, 26, CF(0, 0, -300), chrome)
		g:cyl("BarrelClamp", 12, 72, CF(0, 0, -300), chrome)
		g:cyl("BarrelClamp", 12, 72, CF(0, 0, -470), chrome)
	end)
	g:swing("spin", CF(0, 0, -300) * A(0, 90, 0))
	g:key("Muzzle", CF(0, 0, -524))

	local housing = g:rounded("Receiver", V(90, 110, 260), CF(0, 0, 20), 20, red)
	g:cyl("FrontBell", 40, 84, CF(0, 0, -125), chrome)
	g:box("CoinSlot", V(6, 30, 14), CF(45.6, 10, 40), chrome)
	g:box("CoinSlotHole", V(2.8, 20, 4), CF(48.6, 10, 40), F.shadow)
	-- The crank on the right side.
	g:cylX("CrankHub", 16, 30, CF(53, -20, 60), chrome)
	strut(g, K, "CrankArm", V(60, -20, 60), V(66, -60, 60), 10, chrome)
	g:cylX("CrankKnob", 22, 16, CF(74, -60, 60), red)

	-- The globe of gumballs, on its red base on the left.
	g:group("mag", function()
		g:cylY("MagazineBase", 40, 90, CF(-96, -70, 20), red)
		g:ball("Magazine", 120, CF(-96, -8, 20), K.finishOf(Color3.fromRGB(220, 240, 255), K.Mat.Glass, 0.3, 0.72))
		for index = 1, 14 do
			local angle = index * 2.2
			local ring = (index % 4) * 11 + 8
			g:ball("MagazineGumball", 18, CF(-96 + math.cos(angle) * ring, -40 + (index % 5) * 9, 20 + math.sin(angle) * ring), candy[(index % #candy) + 1])
		end
		g:cylY("MagazineCap", 12, 30, CF(-96, 56, 20), red)
	end)
	strut(g, K, "Chute", V(-44, -40, -10), V(-62, -60, 10), 18, chrome)
	g:box("GlobeBracket", V(20, 12, 50), CF(-50, -58.6, 20), chrome)
	g:key("MagWell", CF(-60, -40, 0))
	g:hand("MagHand", V(-96, -110, 60), V(0, 0.4, -1), V(-1, 0, 0))

	g:rounded("SupportGrip", V(40, 40, 80), CF(0, -72, -90), 12, white)
	g:hand("SupportHand", V(-10, -106.5, -90), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g:grip(V(0, -52, 128), 8, white, { length = 112, depth = 50, front = 26, back = 34, grooves = 3 })
	g:hand("GripHand", V(34, -92, 142), V(-0.3, 0.05, -1), V(1, 0.2, 0.3))
	trigger(g, K, 104, -70, chrome, red)

	g:rail("TopRail", 120, CF(0, 55, -10))
	local h = g:redDot(CF(0, 64.5, -10))
	g:key("Sight", CF(0, 64.5 + h, 55))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.66)
	g:rounded("Stock", V(50, 60, 120), CF(0, -20, 200), 16, white)

	g.model:SetAttribute("Action", "rotary")
	g.model:SetAttribute("Flash", "gumball")
	g.model:SetAttribute("Casing", "none")
	return housing
end

-- A disc launcher: a wide channel with glowing edges, a loaded fidget spinner in its mouth (the round),
-- a stack of spare spinners along the side, a red dot on a riser. Rocket mechanism.
-- Action "rocket" for the single round loaded at Load, but no KP_Backblast: a spring-loaded disc
-- thrower has no venturi, and CombatClient only draws a backblast for guns that carry the keypoint.
Builders.FidgetDiscLauncher = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local body = g.skinned and g.skin or plastic(K, 40, 44, 58)
	local glow = neon(K, 90, 255, 200)
	local chrome = K.finishOf(Color3.fromRGB(200, 202, 208), K.Mat.Metal, 0.25)

	local function spinner(name, at, look)
		g:at(at, function()
			g:cylY(name, 10, 22, CF(0, 0, 0), chrome)
			for index = 0, 2 do
				local angle = index / 3 * math.pi * 2
				local arm = V(math.cos(angle) * 24, 0, math.sin(angle) * 24)
				g:box(name, V(6, 6, 24), CFrame.lookAt(arm / 2, arm), look)
				g:cylY(name, 9, 20, CF(arm), look)
			end
		end)
	end

	local channel = g:box("Receiver", V(96, 16, 560), CF(0, -16, -220), body)
	for _, sx in ipairs(SIGNS) do
		g:box("ChannelWall", V(8, 30, 560), CF(sx * 44, 4, -220), body)
		g:box("ChannelGlow", V(3, 4, 540), CF(sx * 49.5, 14, -220), glow)
	end
	g:key("Muzzle", CF(0, 0, -500))
	g:group("round", function()
		spinner("Rocket", CF(0, -3, -440), plastic(K, 255, 80, 180))
	end)
	g:key("Load", CF(0, 0, -520))
	-- Spare spinners along the left wall.
	for index = 0, 2 do
		spinner("SpareSpinner", CF(-64 - index * 3, -10 + index * 10, -120 - index * 4) * A(0, 0, 90), plastic(K, 80, 200, 255))
	end
	g:box("SpareRack", V(12, 44, 40), CF(-54, -6, -122), body)

	g:grip(V(0, -24, 14), 6, body, { length = 100, depth = 44, front = 24, back = 30, grooves = 2 })
	g:hand("GripHand", V(33, -58, 30), V(-0.3, 0.05, -1), V(1, 0.2, 0.3))
	trigger(g, K, -14, -44, chrome, body)
	g:rounded("ForeGrip", V(36, 70, 40), CF(0, -58, -210), 12, body)
	g:hand("SupportHand", V(-32, -58, -204), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))
	g:rounded("Stock", V(60, 50, 180), CF(0, -24, 140), 14, body)

	g:box("SightRiser", V(30, 54, 60), CF(0, 18, -30), body)
	g:rail("TopRail", 70, CF(0, 45, -30))
	local h = g:redDot(CF(0, 54.5, -30))
	g:key("Sight", CF(0, 54.5 + h, 35))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.9)

	g.model:SetAttribute("Action", "rocket")
	g.model:SetAttribute("Flash", "launcher")
	g.model:SetAttribute("Casing", "none")
	return channel
end

--------------------------------------------------------------------------------
-- Epic
--------------------------------------------------------------------------------

-- A countertop microwave on a stock: the enamel box is the receiver, its door window glows with the
-- turntable inside, the keypad and door handle on the right (the handle is the charging handle), a
-- magnetron horn with glowing coils for a barrel, a holo on top. Energy mechanism.
Builders.MicrowaveZapper = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local enamel = g.skinned and g.skin or glossy(K, 236, 236, 232, 0.08)
	local dark = plastic(K, 40, 42, 48)
	local glow = neon(K, 255, 190, 80)
	local copper = F.copper

	local receiver = g:box("Receiver", V(100, 80, 170), CF(0, -6, -20), enamel)
	g:box("DoorWindow", V(3, 50, 100), CF(-51.5, -4, -30), K.finishOf(Color3.fromRGB(30, 30, 34), K.Mat.Glass, 0.25, 0.35))
	g:cylX("Turntable", 3, 44, CF(-47, -20, -30), glow)
	g:box("DoorFrame", V(4, 62, 112), CF(-50, -4, -30), dark)
	g:box("Keypad", V(3, 60, 36), CF(51.5, -4, 40), dark)
	for row = 0, 3 do
		for col = 0, 1 do
			g:box("KeypadButton", V(3, 7, 9), CF(53, 14 - row * 12, 32 + col * 14), plastic(K, 200, 200, 196))
		end
	end
	g:box("ClockGlow", V(3, 8, 24), CF(53, 24, 40), neon(K, 90, 255, 120))
	g:group("charge", function()
		g:box("ChargingHandle", V(12, 50, 10), CF(56, -4, -80), dark)
	end)
	g:travel("charge", 40)
	-- Turned 30 degrees on the palm so the wrist is not bent past 84 degrees working it (it was 111): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(70, -4, -80), V(-0.16, -0.9, -0.41), V(0.98, -0.19, 0.04))

	-- The magnetron horn: a copper throat, coils with glow between them, a flared emitter.
	g:cyl("Barrel", 260, 26, CF(0, 0, -230), copper)
	for index = 0, 4 do
		g:cyl("Coil", 14, 50, CF(0, 0, -140 - index * 44), copper)
		g:cyl("CoilGlow", 6, 44, CF(0, 0, -162 - index * 44), glow)
	end
	g:cyl("MuzzleMount", 20, 54, CF(0, 0, -360), copper)
	g:shell("MuzzleBrake", 36, 60, 5, CF(0, 0, -372), copper, 12)
	g:key("Muzzle", CF(0, 0, -392))

	g:rail("TopRail", 140, CF(0, 34, -20))
	local h = g:holo(CF(0, 43.5, -30))
	g:key("Sight", CF(0, 43.5 + h, 50))
	g.model:SetAttribute("Optic", "holo")
	g.model:SetAttribute("EyeRelief", 0.62)

	g:grip(V(0, -46, 50), 16, dark, { length = 104, depth = 48, front = 22, back = 31, grooves = 3 })
	g:hand("GripHand", V(33, -84, 70), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))
	trigger(g, K, 20, -68, copper, enamel)
	g:rounded("ForeGrip", V(40, 40, 90), CF(0, -34, -260), 12, dark)
	g:hand("SupportHand", V(-8, -68.5, -260), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))

	g:group("mag", function()
		g:prism("Magazine", V(44, 90, 60), CF(0, -90, -60), 6, dark)
		for _, sx in ipairs(SIGNS) do
			g:box("MagazineGlow", V(K.FINE * 2, 56, 12), CF(sx * 22, -90, -60), glow)
		end
	end)
	g:key("MagWell", CF(0, -46, -60))
	g:hand("MagHand", V(-30, -146, -60), V(0.4, 0.5, -0.1), V(-1, 0, 0))
	g:rounded("Stock", V(40, 60, 150), CF(0, -16, 140), 14, enamel)
	g:rounded("Buttpad", V(44, 70, 16), CF(0, -18, 220), 8, F.rubber)

	g.model:SetAttribute("Action", "energy")
	g.model:SetAttribute("Flash", "zap")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

-- A crossbow on a pizza board: rolling pins for limbs, a floury wooden rail, and a pizza cutter
-- loaded as the bolt. Crossbow mechanism and layout.
Builders.PizzaCutterCrossbow = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local wood = g.skinned and g.skin or F.woodLight
	local darkWood = F.wood
	local steel = K.finishOf(Color3.fromRGB(210, 212, 216), K.Mat.Metal, 0.3)
	local red = plastic(K, 200, 40, 36)
	local flour = plastic(K, 244, 240, 228)

	local housing = g:prism("Receiver", V(42, 42, 220), CF(0, -12, 20), 6, darkWood)
	g:cyl("BufferTube", 170, 30, CF(0, -6, 215), F.anodizedDark)
	g:rounded("Stock", V(40, 42, 150), CF(0, -6, 247), 13, wood)
	g:rounded("Buttpad", V(44, 20, 128), CF(0, -41, 330) * A(90, 0, 0), 8, F.rubber)
	g:rail("TopRail", 150, CF(0, 9, 30))
	g:grip(V(0, -33, 60), 18, darkWood, { length = 104, depth = 48, front = 22, back = 31, grooves = 3 })
	trigger(g, K, 18, -58, steel, darkWood)
	g:hand("GripHand", V(33, -70, 80), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	-- The board: the rail, with flour dusted along it and a checked cloth tied round the front.
	g:prism("Rail", V(40, 26, 520), CF(0, -6, -350), 5, wood, "bottom")
	g:box("FlightGroove", V(8, K.FINE * 2, 500), CF(0, 7 + K.FINE, -350), F.shadow)
	g:box("Flour", V(44, 2, 90), CF(0, -20, -200), flour)
	g:box("Cloth", V(46, 30, 40), CF(0, -10, -520), red)
	g:box("Latch", V(22, 8, 20), CF(0, 13, -72), steel)
	g:prism("Riser", V(150, 44, 50), CF(0, -4, -633), 8, darkWood)
	g:box("RiserBlock", V(60, 66, 40), CF(0, -30, -640), darkWood)
	g:key("Muzzle", CF(0, 12, -660))
	-- Turned 90 degrees on the palm so the wrist is not bent past 59 degrees working it (it was 140): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(-4, 26, -50), V(1, 0, -0.1), V(0.03, 0.96, 0.28))

	-- Rolling-pin limbs with their handles, and the string drawn back to the latch or loosed.
	local latch = V(0, 12, -70)
	for _, sx in ipairs(SIGNS) do
		local root = V(sx * 70, -4, -650)
		local tip = V(sx * 240, -4, -588)
		rod(g, K, "Limb", root, tip, 34, wood)
		rod(g, K, "LimbHandle", tip, tip + (tip - root).Unit * 40, 16, darkWood)
		local handleEnd = tip + (tip - root).Unit * 40
		g:ball("LimbKnob", 22, CF(handleEnd), darkWood)
		local camEdge = tip + V(-sx * 10, 18, 0)
		g:group("string", function()
			strut(g, K, "String", camEdge, latch, 3, F.polymerDark)
		end)
		local restEnd = V(0, camEdge.Y, -600)
		local rest = strut(g, K, "StringRest", camEdge, restEnd, 3, F.polymerDark)
		rest.Transparency = 1
		rest:SetAttribute("Anim", "stringRest")
	end

	g:rounded("ForeGrip", V(40, 40, 130), CF(0, -38.5, -330), 14, darkWood)
	g:hand("SupportHand", V(-6, -74.5, -330), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))

	local h = g:redDot(CF(0, 18.5, 30))
	g:key("Sight", CF(0, 18.5 + h, 95))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.66)

	-- The pizza cutter: a red handle for a shaft, a steel wheel at the front on its fork.
	g:group("round", function()
		g:cyl("RocketShaft", 360, 12, CF(0, 12, -260), red)
		g:cyl("RocketNock", 14, 16, CF(0, 12, -86), steel)
		strut(g, K, "RocketFork", V(0, 12, -440), V(0, 12, -470), 8, steel)
		g:cylX("RocketHead", 3, 56, CF(0, 12, -490), steel)
		g:cylX("RocketHub", 10, 12, CF(0, 12, -490), steel)
	end)
	g:key("Load", CF(0, 30, -300))

	g.model:SetAttribute("Action", "crossbow")
	g.model:SetAttribute("Flash", "crossbow")
	g.model:SetAttribute("Casing", "none")
	return housing
end

--------------------------------------------------------------------------------
-- Legendary
--------------------------------------------------------------------------------

-- A disco blaster: a caged mirror ball out front that spins up as you fire, a glossy gold-and-purple
-- body with a vinyl record for a magazine, a holo high on top so the sight line clears the ball.
-- Rotary mechanism (for the spin), rotary keypoints.
Builders.DiscoBallDeleter = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local body = g.skinned and g.skin or glossy(K, 120, 60, 170, 0.2)
	local gold = F.gold
	local mirror = K.finishOf(Color3.fromRGB(210, 214, 222), K.Mat.SmoothPlastic, 0.6)
	local vinyl = plastic(K, 20, 20, 22)

	g:group("spin", function()
		g:ball("DiscoBall", 110, CF(0, 0, -320), mirror)
		g:detail(function()
			for ring = -2, 2 do
				local count = 10 - math.abs(ring) * 2
				for index = 0, count - 1 do
					local angle = index / count * math.pi * 2
					g:box("DiscoTile", V(2, 12, 12), CF(0, 0, -320) * CFrame.Angles(0, 0, angle) * A(ring * 26, 0, 0) * CF(0, 55, 0) * A(0, 0, 90),
						index % 3 == 0 and glossy(K, 255, 120, 220, 0.5) or mirror)
				end
			end
		end)
		g:cyl("BarrelClampHub", 30, 24, CF(0, 0, -250), gold)
	end)
	g:swing("spin", CF(0, 0, -320) * A(0, 90, 0))
	-- The cage: four hoops round the ball, meeting at a disc at each pole (so no two hoops stack a
	-- segment in the same place), the rear disc fixed to the collar.
	for index = 0, 3 do
		local angle = index / 4 * math.pi
		for step = 0, 11 do
			if step ~= 3 and step ~= 9 then
				g:box("Cage", V(6, 4, 38), CF(0, 0, -320) * CFrame.Angles(0, 0, angle) * A(step / 12 * 360, 0, 0) * CF(0, 66, 0), gold)
			end
		end
	end
	for _, z in ipairs({ -254, -386 }) do
		g:cyl("CagePole", 4, 44, CF(0, 0, z), gold)
	end
	g:cyl("Collar", 50, 50, CF(0, 0, -233), gold)
	g:key("Muzzle", CF(0, 0, -390))

	local receiver = g:rounded("Receiver", V(60, 70, 260), CF(0, -2, -80), 18, body)
	for _, sx in ipairs(SIGNS) do
		g:box("TrimStrip", V(3, 8, 240), CF(sx * 30.5, 12, -80), gold)
	end
	g:group("charge", function()
		g:ball("ChargingKnob", 18, CF(-40, 10, -30), gold)
	end)
	g:travel("charge", 40)
	g:hand("ChargeHand", V(-52, 16, -30), V(0.25, -1, 0.3), V(-0.4, 0.2, 1))

	g:box("SightRiser", V(30, 32, 80), CF(0, 46, -60), body)
	g:rail("TopRail", 90, CF(0, 62, -60))
	local h = g:holo(CF(0, 71.5, -70))
	g:key("Sight", CF(0, 71.5 + h, 10))
	g.model:SetAttribute("Optic", "holo")
	g.model:SetAttribute("EyeRelief", 0.62)

	g:group("mag", function()
		g:cylX("Magazine", 6, 110, CF(0, -80, -80), vinyl)
		g:cylX("MagazineLabel", 9, 36, CF(0, -80, -80), K.finishOf(g.accent, K.Mat.SmoothPlastic))
	end)
	g:box("RecordSlot", V(16, 24, 118), CF(0, -40, -80), body)
	g:key("MagWell", CF(0, -36, -80))
	g:hand("MagHand", V(-26, -130, -80), V(0.4, 0.5, -0.1), V(-1, 0, 0))

	g:grip(V(0, -38, 40), 14, body, { length = 100, depth = 46, front = 22, back = 30, grooves = 3 })
	g:hand("GripHand", V(31, -76, 58), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))
	trigger(g, K, 10, -62, gold, body)
	g:rounded("ForeGrip", V(36, 40, 70), CF(0, -52, -180), 12, gold)
	g:hand("SupportHand", V(-8, -86.5, -180), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g:rounded("Stock", V(40, 56, 130), CF(0, -12, 110), 14, body)

	g.model:SetAttribute("Action", "rotary")
	g.model:SetAttribute("Flash", "disco")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

-- A chrome two-slot toaster on a launch tube: the lever and dial on its side, a crumb tray, the tube
-- running forward with a slice of toast loaded in its mouth (the round), a red dot on the toaster.
-- Rocket mechanism.
-- Action "rocket" for the one slice loaded at a time; no KP_Backblast, for the same reason as the
-- Fidget above -- a toaster popping toast upward vents nothing out of its back.
Builders.ToasterMortar = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local chrome = g.skinned and g.skin or K.finishOf(Color3.fromRGB(214, 216, 222), K.Mat.Metal, 0.35)
	local dark = plastic(K, 34, 34, 38)
	local toast = plastic(K, 206, 150, 80)
	local crust = plastic(K, 150, 96, 48)

	local toaster = g:rounded("Receiver", V(90, 90, 170), CF(0, 6, 40), 22, chrome)
	for _, dx in ipairs({ -18, 18 }) do
		g:box("ToastSlot", V(10, 4, 110), CF(dx, 50, 40), dark)
		g:box("ToastPeek", V(8, 12, 90), CF(dx, 54, 40), toast)
	end
	g:box("LeverSlot", V(4, 50, 8), CF(45.6, 10, 90), dark)
	g:box("Lever", V(12, 8, 16), CF(52.6, 24, 90), dark)
	g:cylX("Dial", 8, 24, CF(47.6, -14, 50), dark)
	g:box("CrumbTray", V(80, 6, 150), CF(0, -41, 40), chrome)

	-- The launch tube, square like the slot.
	local tubeLook = K.finishOf(Color3.fromRGB(180, 182, 188), K.Mat.Metal, 0.2)
	for _, side in ipairs({ { V(66, 6, 440), CF(0, 30, -260) }, { V(66, 6, 440), CF(0, -30, -260) }, { V(6, 54, 440), CF(30, 0, -260) }, { V(6, 54, 440), CF(-30, 0, -260) } }) do
		g:box("Tube", side[1], side[2], tubeLook)
	end
	g:box("TubeLip", V(80, 8, 12), CF(0, 36, -484), chrome)
	g:box("TubeLip", V(80, 8, 12), CF(0, -36, -484), chrome)
	g:key("Muzzle", CF(0, 0, -492))
	g:group("round", function()
		g:box("Rocket", V(10, 54, 48), CF(0, 0, -440), toast)
		g:box("RocketCrust", V(11.5, 54, 4), CF(0, 0, -416), crust)
	end)
	g:key("Load", CF(0, 0, -520))

	g:grip(V(0, -42, 60), 6, dark, { length = 100, depth = 44, front = 24, back = 30, grooves = 2 })
	g:hand("GripHand", V(33, -76, 76), V(-0.3, 0.05, -1), V(1, 0.2, 0.3))
	trigger(g, K, 32, -58, chrome, dark)
	g:rounded("ForeGrip", V(36, 70, 40), CF(0, -64, -210), 12, dark)
	g:hand("SupportHand", V(-32, -64, -204), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))
	g:box("Cord", V(8, 8, 140), CF(-20, -30, 190), dark)
	g:box("CordPlug", V(24, 16, 20), CF(-20, -30, 266), dark)

	g:rail("TopRail", 70, CF(0, 51, -40))
	local h = g:redDot(CF(0, 60.5, -40))
	g:key("Sight", CF(0, 60.5 + h, 25))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.9)

	g.model:SetAttribute("Action", "rocket")
	g.model:SetAttribute("Flash", "launcher")
	g.model:SetAttribute("Casing", "none")
	return toaster
end

--------------------------------------------------------------------------------
-- Mythic
--------------------------------------------------------------------------------

-- A twin-rail coilgun with a rubber chicken stretched along the rails between the coils, head at the
-- muzzle, a long scope high above it all. Energy mechanism, railgun keypoints.
Builders.RubberChickenRailgun = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local body = g.skinned and g.skin or F.anodizedDark
	local copper = F.copper
	local glow = neon(K, 140, 230, 255)
	local chicken = plastic(K, 250, 214, 50)
	local orange = plastic(K, 255, 120, 30)
	local comb = plastic(K, 220, 30, 40)

	local receiver = g:prism("Receiver", V(62, 84, 440), CF(0, -22, 150), 8, body)
	g:prism("TopCover", V(54, 14, 360), CF(0, 27, 90), 5, body, "top")
	g:rail("TopRail", 300, CF(0, 34, 90))
	-- The rails: two long bars either side of the bore, coils round them, glow between.
	for _, sx in ipairs(SIGNS) do
		g:box("Rail", V(10, 22, 700), CF(sx * 24.6, 0, -300), body)
	end
	for index = 0, 5 do
		local z = -100 - index * 100
		g:box("Coil", V(70, 10, 20), CF(0, -16, z), copper)
		for _, sx in ipairs(SIGNS) do
			g:box("Coil", V(10, 36, 20), CF(sx * 33, 0, z), copper)
		end
		g:box("CoilGlow", V(40, K.FINE * 2, 16), CF(0, -20, z - 16), glow)
	end
	g:key("Muzzle", CF(0, 0, -660))

	-- The chicken, lying along the rails: body, stretched neck, head with comb and beak, legs back.
	g:rounded("Chicken", V(36, 30, 200), CF(0, 14, -160), 12, chicken)
	strut(g, K, "ChickenNeck", V(0, 16, -260), V(0, 20, -560), 16, chicken)
	g:ball("ChickenHead", 34, CF(0, 22, -574), chicken)
	g:wedge("ChickenBeak", V(12, 8, 22), CF(0, 18, -598) * A(0, 180, 0), orange)
	for index = 0, 2 do
		g:box("ChickenComb", V(4, 12, 8), CF(0, 40, -566 - index * 8), comb)
	end
	for _, sx in ipairs(SIGNS) do
		g:ball("ChickenEye", 6, CF(sx * 12, 27, -586), F.shadow)
		strut(g, K, "ChickenLeg", V(sx * 8, 6, -70), V(sx * 12, 0, 20), 6, orange)
	end

	local h = g:scope(CF(0, 43.5, 90), "long")
	g:key("Sight", CF(0, 43.5 + h, 270))
	g.model:SetAttribute("Optic", "scope")
	g.model:SetAttribute("EyeRelief", 0.6)

	g:group("charge", function()
		g:box("ChargingHandle", V(16, 20, 30), CF(36, -10, 226), body)
	end)
	g:travel("charge", 40)
	-- Turned 30 degrees on the palm and tilted 30 so the wrist is not bent past 76 degrees working it (it was 116): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(52, 22, 226), V(-0.63, -0.68, -0.38), V(0.77, -0.61, -0.17))
	g:grip(V(0, -64, 14), 16, body, { length = 104, depth = 48, front = 22, back = 31, grooves = 3 })
	trigger(g, K, -12, -86, copper, body)
	g:hand("GripHand", V(33, -102, 34), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))
	g:rounded("ForeGrip", V(40, 44, 120), CF(0, -38, -351), 14, body)
	g:hand("SupportHand", V(-27, -76, -351), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))
	g:group("mag", function()
		g:prism("Magazine", V(44, 100, 70), CF(0, -104, 150), 6, F.polymerDark)
		for _, sx in ipairs(SIGNS) do
			g:box("MagazineGlow", V(K.FINE * 2, 60, 14), CF(sx * 22, -104, 150), glow)
		end
	end)
	g:key("MagWell", CF(0, -64, 150))
	g:hand("MagHand", V(-30, -160, 150), V(0.4, 0.5, -0.1), V(-1, 0, 0))
	g:rounded("Buttpad", V(66, 20, 110), CF(0, -24, 380) * A(90, 0, 0), 8, F.rubber)

	g.model:SetAttribute("Action", "energy")
	g.model:SetAttribute("Flash", "rail")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

-- A marksman rifle whose receiver is a lava lamp: a glass capsule with glowing wax blobs, a metal
-- base at the back and a cap at the front, a brass barrel, a holo on a rail above. Semi mechanism.
Builders.LavaLampLancer = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local metal = g.skinned and g.skin or K.finishOf(Color3.fromRGB(70, 40, 90), K.Mat.Metal, 0.15)
	local glass = K.finishOf(Color3.fromRGB(255, 120, 150), K.Mat.Glass, 0.2, 0.5)
	local wax = neon(K, 255, 140, 40)
	local brass = F.brass

	g:cyl("LampGlass", 220, 64, CF(0, -4, -40), glass)
	for index = 0, 5 do
		g:ball("LampWax", 14 + (index % 3) * 8, CF(math.sin(index * 1.7) * 12, -14 + (index % 3) * 8, -120 + index * 32), wax)
	end
	local receiver = g:cyl("Receiver", 80, 72, CF(0, -4, 108), metal)
	g:cyl("LampCap", 30, 56, CF(0, -4, -164), metal)
	g:cyl("Barrel", 300, 20, CF(0, 0, -320), brass)
	g:cyl("MuzzleBrake", 34, 28, CF(0, 0, -484), brass)
	g:key("Muzzle", CF(0, 0, -504))
	-- A rail on two posts off the lamp's base and cap, clear above the glass.
	for _, z in ipairs({ 90, -150 }) do
		g:box("RailPost", V(16, 32, 16), CF(0, 36, z), metal)
	end
	g:rail("TopRail", 280, CF(0, 52, -30))
	local h = g:holo(CF(0, 61.5, -20))
	g:key("Sight", CF(0, 61.5 + h, 60))
	g.model:SetAttribute("Optic", "holo")
	g.model:SetAttribute("EyeRelief", 0.62)

	g:group("bolt", function()
		g:box("BoltCarrier", V(10, 14, 40), CF(38, 0, 110), brass)
	end)
	g:travel("bolt", 50)
	g:key("Eject", CF(40, 4, 110) * A(0, -70, 0))
	g:group("charge", function()
		g:box("ChargingHandle", V(14, 10, 14), CF(-40, 0, 130), metal)
		g:ball("ChargingKnob", 14, CF(-52, 0, 130), wax)
	end)
	g:travel("charge", 60)
	-- Turned 30 degrees on the palm and tilted 30 so the wrist is not bent past 59 degrees working it (it was 95): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(-62, 12, 130), V(0.75, -0.65, -0.12), V(0.01, -0.17, 0.99))

	g:grip(V(0, -40, 150), 18, metal, { length = 100, depth = 46, front = 22, back = 30, grooves = 3 })
	g:hand("GripHand", V(31, -80, 170), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))
	trigger(g, K, 120, -64, brass, metal)
	g:group("mag", function()
		g:box("Magazine", V(24, 80, 50), CF(0, -60, 70), metal)
		g:box("MagazineGlow", V(25.5, 10, 30), CF(0, -60, 70), wax)
	end)
	g:key("MagWell", CF(0, -40, 70))
	g:hand("MagHand", V(-30, -120, 70), V(0.4, 0.25, -0.2), V(-1, -0.15, 0))
	g:rounded("Handguard", V(40, 30, 160), CF(0, -24, -280), 10, metal)
	g:hand("SupportHand", V(-8, -50, -280), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g:rounded("Stock", V(40, 60, 170), CF(0, -16, 230), 14, metal)
	g:rounded("Buttpad", V(44, 70, 16), CF(0, -18, 320), 8, F.rubber)

	g.model:SetAttribute("Action", "semi")
	g.model:SetAttribute("Flash", "lava")
	g.model:SetAttribute("Casing", "rifle")
	return receiver
end

--------------------------------------------------------------------------------
-- Secret
--------------------------------------------------------------------------------

-- A snow globe on a brass frame: a tiny snowy town with a pine tree inside the glass, flakes drifting,
-- a wooden plinth, a red dot high on top to see over the globe. Energy mechanism.
Builders.SnowGlobeSingularity = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local brass = g.skinned and g.skin or F.brass
	local wood = F.woodDark
	local snow = plastic(K, 248, 250, 255)
	local glass = K.finishOf(Color3.fromRGB(220, 240, 255), K.Mat.Glass, 0.3, 0.75)

	g:at(CF(0, 0, -300), function()
		g:ball("Globe", 124, CF(0, 0, 0), glass)
		g:cylY("SnowGround", 10, 90, CF(0, -34, 0), snow)
		for index = 0, 2 do
			local x, z = -26 + index * 26, (index - 1) * 14
			g:box("House", V(18, 16, 18), CF(x, -22.4, z), plastic(K, 200 - index * 30, 90 + index * 40, 80))
			g:wedge("HouseRoof", V(20, 10, 10), CF(x, -9.4, z + 5) * A(0, 0, 0), snow)
			g:wedge("HouseRoof", V(20, 10, 10), CF(x, -9.4, z - 5) * A(0, 180, 0), snow)
		end
		g:cylY("TreeTrunk", 12, 6, CF(34, -25, -24), wood)
		for tier = 0, 2 do
			g:cylY("Tree", 12, 24 - tier * 7, CF(34, -14 + tier * 9, -24), plastic(K, 40, 120, 70))
		end
		for index = 0, 11 do
			local angle = index * 2.4
			g:ball("Snowflake", 3, CF(math.cos(angle) * (10 + index * 3), -10 + (index % 5) * 9, math.sin(angle) * (10 + index * 3)), snow)
		end
	end)
	g:cyl("Plinth", 44, 110, CF(0, -4, -220), wood)
	g:cyl("PlinthBand", 8, 116, CF(0, -4, -210), brass)
	g:key("Muzzle", CF(0, 0, -368))

	local receiver = g:rounded("Receiver", V(56, 64, 240), CF(0, -8, -80), 16, brass)
	for _, sx in ipairs(SIGNS) do
		g:box("Filigree", V(3, 20, 200), CF(sx * 28.5, 0, -80), F.goldDeep)
	end
	g:group("charge", function()
		g:cylX("ChargingHandle", 20, 16, CF(-38, 10, -40), brass)
		g:ball("ChargingKnob", 16, CF(-52, 10, -40), wood)
	end)
	g:travel("charge", 40)
	-- Turned 0 degrees on the palm and tilted 30 so the wrist is not bent past 83 degrees working it (it was 103): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(-62, 20, -40), V(0.38, -0.9, -0.21), V(-0.2, -0.31, 0.93))

	g:box("SightRiser", V(28, 40, 80), CF(0, 44, -80), brass)
	g:rail("TopRail", 90, CF(0, 64, -80))
	local h = g:redDot(CF(0, 73.5, -80))
	g:key("Sight", CF(0, 73.5 + h, -15))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.66)

	g:group("mag", function()
		g:cylY("Magazine", 70, 40, CF(0, -75, -60), glass)
		g:cylY("MagazineSnow", 50, 32, CF(0, -81, -60), snow)
		g:cylY("MagazineCap", 8, 44, CF(0, -113, -60), brass)
	end)
	g:cylY("MagazineCollar", 12, 50, CF(0, -44, -60), brass)
	g:key("MagWell", CF(0, -40, -60))
	g:hand("MagHand", V(-26, -120, -60), V(0.4, 0.5, -0.1), V(-1, 0, 0))
	-- The grip's top sinks 6 mm into the body: raked, a grip set flush on the body's underside meets it
	-- only along one edge.
	g:grip(V(0, -34, 40), 14, wood, { length = 100, depth = 46, front = 22, back = 30, grooves = 3 })
	g:hand("GripHand", V(31, -72, 58), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))
	trigger(g, K, 10, -58, brass, brass)
	g:rounded("ForeGrip", V(36, 40, 60), CF(0, -54, -170), 12, wood)
	g:hand("SupportHand", V(-8, -88.5, -170), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g:rounded("Stock", V(40, 56, 130), CF(0, -12, 110), 14, wood)

	g.model:SetAttribute("Action", "energy")
	g.model:SetAttribute("Flash", "snow")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

-- A spring-loaded launcher built from a wooden bed, knitting needles for limbs with a pink elastic,
-- and a fuzzy slipper with a pom-pom loaded as the bolt. Crossbow mechanism and layout.
Builders.GrandmasSlipperLauncher = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local wood = g.skinned and g.skin or F.wood
	local pink = K.finishOf(Color3.fromRGB(255, 150, 190), K.Mat.Fabric)
	local sole = plastic(K, 120, 80, 60)
	local yarn = K.finishOf(Color3.fromRGB(150, 110, 200), K.Mat.Fabric)
	local steel = K.finishOf(Color3.fromRGB(200, 202, 208), K.Mat.Metal, 0.25)

	local housing = g:prism("Receiver", V(42, 42, 220), CF(0, -12, 20), 6, wood)
	g:cyl("BufferTube", 170, 30, CF(0, -6, 215), F.anodizedDark)
	g:rounded("Stock", V(40, 42, 150), CF(0, -6, 247), 13, wood)
	g:ball("YarnBall", 60, CF(-20, -54, 250), yarn)
	g:rounded("Buttpad", V(44, 20, 128), CF(0, -41, 330) * A(90, 0, 0), 8, pink)
	g:rail("TopRail", 150, CF(0, 9, 30))
	g:grip(V(0, -33, 60), 18, wood, { length = 104, depth = 48, front = 22, back = 31, grooves = 3 })
	trigger(g, K, 18, -58, steel, wood)
	g:hand("GripHand", V(33, -70, 80), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	g:prism("Rail", V(40, 26, 520), CF(0, -6, -350), 5, wood, "bottom")
	g:box("FlightGroove", V(8, K.FINE * 2, 500), CF(0, 7 + K.FINE, -350), F.shadow)
	g:box("Latch", V(22, 12, 20), CF(0, 13, -72), steel)
	g:prism("Riser", V(150, 44, 50), CF(0, -4, -633), 8, wood)
	g:box("RiserBlock", V(60, 66, 40), CF(0, -30, -640), wood)
	g:key("Muzzle", CF(0, 12, -660))
	-- Turned 90 degrees on the palm so the wrist is not bent past 59 degrees working it (it was 140): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(-4, 26, -50), V(1, 0, -0.1), V(0.03, 0.96, 0.28))

	-- Knitting needles for limbs, their bead ends, and the elastic.
	local latch = V(0, 12, -70)
	for _, sx in ipairs(SIGNS) do
		local root = V(sx * 60, -4, -650)
		local tip = V(sx * 250, -4, -600)
		rod(g, K, "Limb", root, tip, 12, steel)
		g:ball("LimbBead", 22, CF(tip), pink)
		local camEdge = tip + V(-sx * 8, 14, 0)
		g:group("string", function()
			strut(g, K, "String", camEdge, latch, 3, pink)
		end)
		local restEnd = V(0, camEdge.Y, -600)
		local rest = strut(g, K, "StringRest", camEdge, restEnd, 3, pink)
		rest.Transparency = 1
		rest:SetAttribute("Anim", "stringRest")
	end

	g:rounded("ForeGrip", V(40, 40, 130), CF(0, -38.5, -330), 14, wood)
	g:hand("SupportHand", V(-6, -74.5, -330), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	local h = g:redDot(CF(0, 18.5, 30))
	g:key("Sight", CF(0, 18.5 + h, 95))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.66)

	-- The slipper: a sole, the fuzzy upper, a pom-pom on the toe.
	g:group("round", function()
		g:rounded("RocketSole", V(44, 8, 150), CF(0, 9.6, -420), 3, sole)
		g:rounded("Rocket", V(46, 26, 120), CF(0, 26.6, -410), 10, pink)
		g:ball("RocketPomPom", 22, CF(0, 35.6, -478), K.finishOf(Color3.fromRGB(255, 240, 250), K.Mat.Fabric))
	end)
	g:key("Load", CF(0, 30, -300))

	g.model:SetAttribute("Action", "crossbow")
	g.model:SetAttribute("Flash", "crossbow")
	g.model:SetAttribute("Casing", "none")
	return housing
end

return GunModelsCreative
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">GunModelsRounds</string><ProtectedString name="Source">-- The rounds the gun rework's three new guns fire, as they look in flight: a mosquito dart, a drumlet and
-- a banana boomerang. Registered into ThrowableModels.RoundBuilders (its contract: `b` is its part builder,
-- sizes in studs, the nose along -Z, the design origin at the round's centre; return the body part), so
-- ProjectileClient, the gallery and the probe draw them like any other kind. The kinds themselves (how they
-- fly) are in Ballistics; each also carries a plain `look` there, which is what is drawn if this module
-- has not been loaded.
--
-- Loaded by GunModelsSignature, which every client loads with GunModels long before a round is in the air.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local ThrowableModels = require(Shared:WaitForChild("ThrowableModels"))

local GunModelsRounds = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local SMOOTH = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local GLASS = Enum.Material.Glass

-- Points along a quadratic curve from p0 to p2, pulled toward p1.
local function curve(p0, p1, p2, count)
	local points = {}
	for index = 0, count do
		local t = index / count
		table.insert(points, p0 * ((1 - t) * (1 - t)) + p1 * (2 * (1 - t) * t) + p2 * (t * t))
	end
	return points
end

-- A dart with a mosquito's markings: a dark body banded white, the needle out front, two glassy wings
-- swept back and a red drop at the tail (it has already bitten someone today).
function GunModelsRounds.Dart(b)
	local DARK, WHITE, RED = rgb(38, 38, 44), rgb(240, 240, 236), rgb(200, 30, 40)
	local body = b.rod("Body", 0.3, 0.08, CF(0, 0, 0.04), DARK, SMOOTH)
	b.ball("Head", 0.1, V(0, 0, -0.11), DARK, SMOOTH)
	b.rod("Needle", 0.22, 0.022, CF(0, 0, -0.26), rgb(90, 90, 96), METAL)
	for _, z in ipairs({ 0.02, 0.1 }) do
		b.rod("Stripe", 0.03, 0.086, CF(0, 0, z), WHITE, SMOOTH)
	end
	b.ball("Blood", 0.1, V(0, 0, 0.2), RED, NEON)
	for _, side in ipairs({ -1, 1 }) do
		b.piece("Wing", V(0.2, 0.012, 0.09), CF(side * 0.1, 0.03, 0.03) * ANG(0, side * 0.5, side * 0.2), rgb(200, 220, 240), GLASS, nil, 0.45)
	end
	return body
end

-- A little marching drum with a lit fuse: a red shell, white heads, brass hoops, the white cord zig-zagging
-- between them, and the fuse spitting sparks from the top.
function GunModelsRounds.Drumlet(b)
	local RED, WHITE, BRASS = rgb(200, 40, 50), rgb(246, 242, 232), rgb(214, 172, 80)
	local height, diameter = 0.26, 0.36
	local body = b.column("Shell", height, diameter, V(0, 0, 0), RED, SMOOTH)
	for _, sy in ipairs({ -1, 1 }) do
		b.column("Head", 0.03, diameter - 0.06, V(0, sy * (height / 2 + 0.01), 0), WHITE, SMOOTH)
		b.ring("Hoop", CF(0, sy * (height / 2 - 0.01), 0) * ANG(math.pi / 2, 0, 0), diameter / 2 + 0.01, 0.035, 12, BRASS, METAL)
	end
	-- The cord: up and down between the hoops, six times round.
	local r = diameter / 2 + 0.02
	for index = 0, 5 do
		local a0, a1 = index / 6 * math.pi * 2, (index + 0.5) / 6 * math.pi * 2
		local low = V(math.cos(a0) * r, -height / 2 + 0.02, math.sin(a0) * r)
		local high = V(math.cos(a1) * r, height / 2 - 0.02, math.sin(a1) * r)
		local nextLow = V(math.cos(a1 + math.pi / 6) * r, -height / 2 + 0.02, math.sin(a1 + math.pi / 6) * r)
		b.link("Cord", low, high, 0.02, WHITE, SMOOTH)
		b.link("Cord", high, nextLow, 0.02, WHITE, SMOOTH)
	end
	b.rod("Fuse", 0.1, 0.025, CFrame.lookAt(V(0.05, height / 2 + 0.06, 0), V(0.08, height / 2 + 0.12, 0)), rgb(110, 80, 50), SMOOTH)
	b.ball("Glow", 0.05, V(0.08, height / 2 + 0.11, 0), rgb(255, 170, 60), NEON)
	return body
end

-- A banana boomerang: two curved banana arms meeting at the elbow, brown tips, a stalk at the elbow, and a
-- yellow ribbon behind it in the air. Flat in the XZ plane (it spins level, "flat").
function GunModelsRounds.Bananerang(b)
	local YELLOW, RIPE, BROWN = rgb(250, 214, 60), rgb(236, 190, 40), rgb(96, 66, 36)
	local thick = 0.08
	local elbow = V(0, 0, -0.26)
	local body = b.column("Elbow", thick, 0.2, elbow, YELLOW, SMOOTH)
	for _, side in ipairs({ -1, 1 }) do
		local points = curve(elbow, V(side * 0.22, 0, -0.2), V(side * 0.46, 0, 0.18), 5)
		for index = 1, #points - 1 do
			local a, c = points[index], points[index + 1]
			local t = index / (#points - 1)
			local width = 0.19 - 0.08 * t
			b.piece("Arm", V(width, thick, (c - a).Magnitude), CFrame.lookAt((a + c) / 2, c), index % 2 == 0 and RIPE or YELLOW, SMOOTH)
			b.column("Joint", thick, width, c, index % 2 == 0 and RIPE or YELLOW, SMOOTH)
		end
		b.ball("Tip", 0.1, points[#points] + V(side * 0.02, 0, 0.03), BROWN, SMOOTH)
		-- Two ripe freckles on the top of each arm.
		for _, index in ipairs({ 2, 4 }) do
			b.ball("Freckle", 0.04, points[index] + V(0, thick / 2, 0), BROWN, SMOOTH)
		end
	end
	b.rod("Stalk", 0.1, 0.06, CF(0, 0, -0.39), rgb(120, 140, 60), SMOOTH)
	b.ball("StalkEnd", 0.07, V(0, 0, -0.44), BROWN, SMOOTH)
	-- A ribbon behind it in the air. Built only where trails exist (not in the offline mocks).
	pcall(function()
		local top, bottom = Instance.new("Attachment"), Instance.new("Attachment")
		top.Position, bottom.Position = V(0, 0.06, 0), V(0, -0.06, 0)
		top.Parent, bottom.Parent = body, body
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1 = top, bottom
		trail.Lifetime = 0.3
		trail.Color = ColorSequence.new(YELLOW)
		trail.Transparency = NumberSequence.new(0.35, 1)
		trail.LightEmission = 0.4
		trail.FaceCamera = true
		trail.Parent = body
	end)
	return body
end

ThrowableModels.RoundBuilders.mosquitoDart = GunModelsRounds.Dart
ThrowableModels.RoundBuilders.drumlet = GunModelsRounds.Drumlet
ThrowableModels.RoundBuilders.bananerang = GunModelsRounds.Bananerang

return GunModelsRounds
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">GunModelsSignature</string><ProtectedString name="Source">-- Signature gun models: the older arsenal's guns rebuilt with an identity of their own (Oliver, 2026-09-24:
-- "make more fun and quality guns and gun models ... change some of the older boring ones to be more fun").
--
-- Every gun here keeps its weapon id, its stats (WeaponData / ArsenalExpansion) and the MECHANISM it always
-- had: the same Action, the same moving groups, and the hand, sight, magazine and muzzle keypoints where the
-- stock builder put them, so the viewmodel's clips, the third-person pose and the hand checks that already
-- pass keep passing. What changes is everything you look at. Each gun is built on a chassis below -- the
-- stock mechanism's working parts at the stock positions -- and a THEME that dresses it: its own slide,
-- handguard, stock, muzzle, magazine and a signature piece or two, in its own colours.
--
-- GunModels.Build calls Builders[weaponId](g, Kit) for these ids, exactly as it does for the creative and
-- workshop guns, and does everything after the build itself (AimPoint, z-fight pass, Receiver, Muzzle
-- attachment, welds). `g` is GunModels' Builder: sizes and positions in millimetres, the origin on the bore
-- axis above the trigger, the gun facing -Z with +X to the right.
--
-- Model attributes set here beyond the stock contract:
--   Flair      the gun's signature handling in the viewmodel (inspect, draw and reload flourishes):
--              see Viewmodel's FLAIR table. A gun without it animates exactly as before.
--   Signature  true: ArsenalFinish leaves the gun's own colours alone.
--
-- Rules every builder keeps (tools/gunfun_lab.py sight, gun_tube_check, fps_arms_check):
--   * nothing solid on the sight line from the eye (KP_Sight + EyeRelief back) forward;
--   * nothing new within a finger's reach of a hand keypoint that the hand would sink into -- decoration
--     on a grip is FINE-thin and lies on its surface;
--   * no rod that touches nothing, no tube floating off the bore, no second barrel through the first.

local GunModelsSignature = {}

GunModelsSignature.Variants = {}

local Builders = {}
GunModelsSignature.Builders = Builders

local SIGNS = { 1, -1 }

--------------------------------------------------------------------------------
-- Looks
--------------------------------------------------------------------------------

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function look(K, r, g, b, material, reflectance, transparency)
	return K.finishOf(rgb(r, g, b), material or K.Mat.SmoothPlastic, reflectance, transparency)
end

local function metal(K, r, g, b, reflectance)
	return K.finishOf(rgb(r, g, b), K.Mat.Metal, reflectance or 0.04)
end

local function wood(K, r, g, b)
	return K.finishOf(rgb(r, g, b), K.Mat.Wood)
end

local function fabric(K, r, g, b)
	return K.finishOf(rgb(r, g, b), K.Mat.Fabric)
end

local function neon(K, r, g, b)
	return K.finishOf(rgb(r, g, b), K.Mat.Neon)
end

local function glass(K, r, g, b, transparency)
	return K.finishOf(rgb(r, g, b), K.Mat.Glass, 0.2, transparency or 0.5)
end

-- A skin repaints a gun's body and furniture; without one the theme's own colours stand.
local function skin(g, own)
	return g.skinned and g.skin or own
end

-- A frame at `at` whose -Z runs along `direction`, with its X kept level where it can be. Built from the
-- axes rather than CFrame.lookAt, which has no answer for a direction straight up or down.
local function along(at, direction)
	local back = -direction.Unit
	local reference = math.abs(back.Y) &gt; 0.95 and Vector3.xAxis or Vector3.yAxis
	local right = reference:Cross(back).Unit
	return CFrame.fromMatrix(at, right, back:Cross(right).Unit, back)
end

-- A box spanning two points.
local function strut(g, K, name, from, to, width, lk, height)
	local length = (to - from).Magnitude
	return g:box(name, K.V(width, height or width, length), along((from + to) / 2, to - from), lk)
end

-- A cylinder spanning two points.
local function rod(g, K, name, from, to, diameter, lk)
	return g:cyl(name, (to - from).Magnitude, diameter, along((from + to) / 2, to - from), lk)
end

-- An arc of short boxes laid end to end: a crescent, a hoop, a smile. In the YZ plane at `at` (x is the
-- face it lies on), from angle a0 to a1 degrees round `radius`.
local function arc(g, K, name, at, radius, a0, a1, segments, width, depth, lk)
	local V, CF = K.V, K.CF
	local step = (a1 - a0) / segments
	local chord = 2 * radius * math.sin(math.rad(math.abs(step)) / 2) + 0.6
	g:at(at, function()
		for index = 0, segments - 1 do
			local angle = math.rad(a0 + step * (index + 0.5))
			local point = V(0, math.cos(angle) * radius, -math.sin(angle) * radius)
			local tangent = V(0, -math.sin(angle), -math.cos(angle))
			g:box(name, V(depth, width, chord), CFrame.fromMatrix(point, Vector3.xAxis, Vector3.xAxis:Cross(-tangent), -tangent), lk)
		end
	end)
end

-- A mushroom, a puff, a blob: a stem and a cap, standing up from `at`.
local function mushroom(g, K, at, height, capDiameter, capLook, stemLook, spotLook)
	local CF = K.CF
	g:at(at, function()
		g:cylY("MushroomStem", height, capDiameter * 0.34, CF(0, height / 2, 0), stemLook)
		g:ball("MushroomCap", capDiameter, CF(0, height, 0), capLook)
		-- The cap's underside, so it reads as a cap and not a ball on a stick.
		g:cylY("MushroomGill", capDiameter * 0.12, capDiameter * 0.86, CF(0, height - capDiameter * 0.06, 0), stemLook)
		if spotLook then
			for index = 0, 2 do
				local angle = index / 3 * math.pi * 2 + 0.4
				g:ball("MushroomSpot", capDiameter * 0.2,
					CF(math.cos(angle) * capDiameter * 0.3, height + capDiameter * 0.36, math.sin(angle) * capDiameter * 0.3), spotLook)
			end
		end
	end)
end

-- Restyling a stock build. Some guns keep the whole stock mechanism (an AK, an M14) and are rebuilt from
-- the outside: `strip` takes off the parts the new design replaces (by Lua name pattern), `paint` refinishes
-- what stays, and the builder then adds its own pieces. Hand, sight and group keypoints are untouched.
local function strip(g, patterns)
	for _, part in ipairs(g.model:GetChildren()) do
		if part:IsA("BasePart") then
			for _, pattern in ipairs(patterns) do
				if string.match(part.Name, pattern) then
					part:Destroy()
					break
				end
			end
		end
	end
end

local function paint(g, rules)
	for _, part in ipairs(g.model:GetChildren()) do
		if part:IsA("BasePart") then
			for _, rule in ipairs(rules) do
				if string.match(part.Name, rule[1]) then
					part.Color = rule[2].color
					part.Material = rule[2].material
					part.Reflectance = rule[2].reflectance or 0
					break
				end
			end
		end
	end
end

-- The stock build of this gun's style, with a variant of the builder's choosing in place of the table's.
local function stock(g, K, variant)
	g.variant = variant or {}
	return K.STYLES[g.style](g)
end

--------------------------------------------------------------------------------
-- Chassis: the pistol (the stock pistol's mechanism and keypoints)
--------------------------------------------------------------------------------

-- T.frame, T.slide, T.small: looks. T.compact: the subcompact's lengths.
-- T.slideBody(g, front, back): builds the slide's shape (inside the slide group); default a prism.
-- T.grip: extra grip spec fields. T.gripDress(g, gripFrame, length): dressing on the grip, in its frame.
-- T.mag(g, length): the magazine in the grip frame (inside the mag group); default a polymer box.
-- T.under(g, front): whatever hangs under the dust cover. T.sights(g, front, back): the sights.
local function pistolChassis(g, K, T)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local compact = T.compact
	local front = compact and -94 or -111
	local back = compact and 66 or 77
	local gripLength = compact and 74 or 100
	local frame = T.frame
	local slideLook = T.slide

	local slide
	g:group("slide", function()
		if T.slideBody then
			slide = T.slideBody(g, front, back)
		else
			slide = g:prism("Slide", V(25.5, 22, back - front), CF(0, 1, (front + back) / 2), 3, slideLook, "top")
		end
		-- The port, dark, with the barrel hood in it, on the right.
		g:box("SlidePort", V(FINE * 2, 10, 44), CF(12.8 + FINE, 4, -10), F.shadow)
		g:box("BarrelHood", V(10, 9, 40), CF(8.5, 4.5, -10), T.hood or F.nitride)
		if T.sights then
			T.sights(g, front, back)
		else
			g:box("FrontSight", V(3.5, 6, 6), CF(0, 15, front + 10), F.nitride)
			for _, sx in ipairs(SIGNS) do
				g:box("RearSight", V(8, 6, 7), CF(sx * 7, 15, back - 12), F.nitride)
			end
			g:box("RearSightBase", V(6, 2.5, 7), CF(0, 13.25, back - 12), F.nitride)
		end
		g:cyl("Bore", FINE, 9.5, CF(0, 0, (T.boreZ or front) - FINE / 2), F.bore)
	end)
	g:travel("slide", 58)
	g:key("Eject", CF(14, 8, -10) * A(0, -60, 0))
	g:key("Sight", CF(0, 18, back - 6))
	g:hand("ChargeHand", V(-4, 34, back - 22), V(1, -0.45, 0.1), V(0, 1, 0.1))

	-- Frame: dust cover, the frame over the trigger, guard and trigger.
	local dustFront = front + 5
	local dustLength = -28 - dustFront
	g:at(CF(0, 0, dustFront + dustLength / 2), function()
		g:box("Frame", V(24, 5, dustLength), CF(0, -12.5, 0), frame)
		g:box("Frame", V(17, 4, dustLength), CF(0, -17, 0), frame)
		g:prism("Frame", V(24, 5, dustLength), CF(0, -21.5, 0), 2, frame, "bottom")
	end)
	g:box("Frame", V(24, 16, 104), CF(0, -18, 24), frame)
	g:box("TriggerGuard", V(12, 24, 9), CF(0, -38, -34), T.guard or frame)
	g:box("TriggerGuard", V(12, 8, 60), CF(0, -54, -8), T.guard or frame)
	g:wedge("TriggerGuardHook", V(12, 8, 8), CF(0, -46, -42.5), T.guard or frame)
	g:group("trigger", function()
		g:box("Trigger", V(6, 17, 5), CF(0, -34.5, -2) * A(-10, 0, 0), T.trigger or F.polymerDark)
	end)
	g:swing("trigger", CF(0, -26, 0), 10)
	g:detail(function()
		g:box("SlideStop", V(3.5, 5, 14), CF(-13.75, -13, -14), T.small or F.nitride)
	end)

	local spec = { length = gripLength, depth = 54, front = 24, back = 30, grooves = compact and 0 or 3, top = 10 }
	for key, value in pairs(T.grip or {}) do
		spec[key] = value
	end
	local gripFrame = g:grip(V(0, -26, 40), 15, T.gripLook or frame, spec)
	g:at(gripFrame, function()
		if T.gripDress then
			T.gripDress(g, gripLength)
		end
		g:group("mag", function()
			if T.mag then
				T.mag(g, gripLength)
			else
				g:box("Magazine", V(19, gripLength - 4, 32), CF(0, -gripLength / 2 - 4, 2), F.polymerDark)
				g:prism("MagazinePlate", V(25, 7, 42), CF(0, -gripLength - 3.5, 2), 2, T.small or F.nitride, "bottom")
			end
		end)
		g:key("MagWell", CF(0, -gripLength, 2))
	end)
	g:prism("Beavertail", V(24, 9, 9), CF(0, -14.5, 80.5), 3, frame, "bottom")
	g:hand("GripHand", V(30, -62, 52), V(-0.3, 0.1, -1), V(1, 0.15, 0.3))
	g:hand("SupportHand", V(-33, -74, 38), V(0.55, -0.05, -1), V(-1, -0.1, -0.3))
	g:hand("MagHand", V(-26, compact and -112 or -136, 62), V(0.35, 0.3, -0.2), V(-1, -0.1, 0))

	if T.under then
		T.under(g, front)
	end

	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 1.1)
	g.model:SetAttribute("Action", "pistol")
	g.model:SetAttribute("Flash", T.flash or "pistol")
	g.model:SetAttribute("Casing", T.casing or "pistol")
	g:key("Muzzle", CF(0, 0, (T.muzzleZ or front) - 4))
	return slide
end

--------------------------------------------------------------------------------
-- Chassis: the SMG (the stock SMG's mechanism and keypoints)
--------------------------------------------------------------------------------

-- T.metal, T.furniture, T.small: looks. T.suppressed: the SD's lengths (support hand at -205, muzzle -472).
-- T.receiverDress(g), T.front(g) -&gt; muzzleZ (barrel, handguard, muzzle; the support hand's handguard must
-- stay where the stock one was), T.stock(g), T.mag(g), T.sights(g) (default: the stock diopter and hooded
-- post; must set KP_Sight, Optic and EyeRelief), T.drum.
local function smgChassis(g, K, T)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local metal, furniture, small = T.metal, T.furniture, T.small or F.steel

	local receiver = g:box("Receiver", V(15, 42, 300), CF(-7.5, -1, 10), metal)
	g:box("ReceiverWall", V(15, 42, 150), CF(7.5, -1, 85), metal)
	g:box("ReceiverWall", V(15, 42, 80), CF(7.5, -1, -100), metal)
	g:box("ReceiverWall", V(15, 12, 70), CF(7.5, -16, -25), metal)
	g:box("ReceiverWall", V(15, 12, 70), CF(7.5, 14, -25), metal)
	g:box("EjectionPort", V(3.5, 18, 70), CF(5.25, -1, -25), F.shadow)
	g:group("bolt", function()
		g:box("BoltCarrier", V(11.5, 14, 50), CF(5.75, -1, -18), T.bolt or F.steel)
	end)
	g:travel("bolt", 60)
	g:key("Eject", CF(18, 0, -25) * A(0, -70, 0))
	g:box("EndCap", V(34, 44, 8), CF(0, -1, 164), T.endCap or furniture)
	if T.receiverDress then
		T.receiverDress(g)
	end

	-- The cocking tube, banded to the front end, with the handle out the left.
	g:cyl("CockingTube", 150, 22, CF(0, 28, -215), T.tube or metal)
	g:box("TubeSupport", V(20, 10, 20), CF(0, 16, -150), metal)
	g:box("BarrelBand", V(28, 13, 14), CF(0, 14, -258), T.tube or metal)
	g:group("charge", function()
		g:box("ChargingHandle", V(24, 8, 9), CF(-18, 34, -236) * A(0, 0, -40), small)
		g:ball("ChargingKnob", 13, CF(-30, 44, -236), T.knob or F.polymerDark)
	end)
	g:travel("charge", 90)
	g:hand("ChargeHand", V(-42, 58, -240), V(-0.6, -0.36, -0.71), V(-0.77, 0, 0.64))

	if T.sights then
		T.sights(g)
	else
		g:at(CF(0, 28, -282), function()
			g:box("FrontSightBase", V(26, 14.5, 26), CF(0, -2.75, 0), T.tube or metal)
			g:shell("FrontSightHood", 18, 28, 4, CF(0, 16, 0), T.tube or metal, 10)
			g:box("FrontSightPost", V(3, 12, 3), CF(0, 10, 0), F.nitride)
			g:box("FrontSight", V(2.2, 6, 3), CF(0, 19, 0), T.post or F.nitride)
		end)
		g:box("RearSightBase", V(26, 8, 34), CF(0, 24, 136), metal)
		g:cylX("RearSightDrum", 26, 26, CF(0, 32.5, 136), T.drumLook or metal)
		g:shell("RearSight", 6, 12, 3, CF(0, 50, 136), metal, 8)
		g:key("Sight", CF(0, 50, 142))
		g.model:SetAttribute("Optic", "iron")
		g.model:SetAttribute("EyeRelief", 0.36)
	end

	g:prism("TriggerGroup", V(28, 20, 128), CF(0, -32, 34), 3, furniture, "bottom")
	g:box("TriggerGuard", V(12, 6, 60), CF(0, -58, 6), furniture)
	g:box("TriggerGuard", V(12, 13, 6), CF(0, -48.5, -24), furniture)
	g:group("trigger", function()
		g:box("Trigger", V(6, 18, 6), CF(0, -47, 0) * A(-12, 0, 0), small)
	end)
	g:swing("trigger", CF(0, -38, 0), 12)
	local gripFrame = g:grip(V(0, -42, 66), 16, T.gripLook or furniture, { length = 98, depth = 46, front = 22, back = 30, grooves = 3 })
	if T.gripDress then
		g:at(gripFrame, function()
			T.gripDress(g)
		end)
	end
	g:hand("GripHand", V(31, -80, 82), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	g:box("MagWell", V(30, 23, 48), CF(0, -33.5, -76), metal)
	g:group("mag", function()
		if T.mag then
			T.mag(g)
		elseif T.drum then
			g:drumMag("Magazine", 100, 56, CF(0, -44, -76), T.magLook or F.polymerDark)
		else
			g:magazine("Magazine", { width = 22, depth = 34, segments = { { 60, 0 }, { 42, 4 }, { 42, 4 }, { 42, 4 } }, ribs = "stanag", caliber = 9, plate = T.plate },
				CF(0, -40, -76), T.magLook or F.nitride)
		end
	end)
	g:key("MagWell", CF(0, -40, -76))
	g:hand("MagHand", V(-30, T.drum and -150 or -120, -80), V(0.4, 0.25, -0.2), V(-1, -0.15, 0))

	local muzzleZ = T.front(g)
	g:key("Muzzle", CF(0, 0, muzzleZ))
	g:hand("SupportHand", V(-12, -44, T.suppressed and -205 or -212), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))

	T.stock(g)

	g.model:SetAttribute("Action", "smg")
	g.model:SetAttribute("Flash", T.flash or "smg")
	g.model:SetAttribute("Casing", "pistol")
	return receiver
end

--------------------------------------------------------------------------------
-- Chassis: the AR family (the stock AR's mechanism and keypoints, at any of its scales)
--------------------------------------------------------------------------------

-- spec: scale, hgLength, barrelEnd, barrelDia, action, flash, casing (as buildAR).
-- T.receiver, T.furniture, T.small, T.lower: looks.
-- T.handguard(g, info): the handguard round the barrel from z = -103 back to info.front (in the scaled
--   frame); info = { front, z, length }. Must leave something under the support hand at
--   (-10, -48, z - length * 0.1), or set T.supportHand.
-- T.muzzle(g, barrelEnd) -&gt; muzzleZ. T.stock(g). T.mag(g). T.sights(g, railTop): must set KP_Sight,
-- Optic and EyeRelief. T.dress(g, info): anything else.
local function arChassis(g, K, spec, T)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	g.scale = spec.scale or 1
	local receiverLook, lower, furniture, small = T.receiver, T.lower or T.receiver, T.furniture, T.small or F.anodizedDark
	local hgLength = spec.hgLength or 306
	local barrelEnd = spec.barrelEnd or -480
	local barrelDia = spec.barrelDia or 17

	local upper = g:prism("Receiver", V(30, 16, 170), CF(0, 13, -15), 4, receiverLook, "top")
	g:box("UpperWall", V(15, 23, 170), CF(-7.5, -6.5, -15), receiverLook)
	g:box("UpperWall", V(15, 8, 170), CF(7.5, -14, -15), receiverLook)
	g:box("UpperWall", V(15, 15, 72), CF(7.5, -2.5, 34), receiverLook)
	g:box("UpperWall", V(15, 15, 38), CF(7.5, -2.5, -81), receiverLook)
	g:box("EjectionPort", V(3.5, 15, 60), CF(5.25, -2.5, -32), F.shadow)
	g:group("bolt", function()
		g:box("BoltCarrier", V(11.5, 13, 44), CF(5.75, -2.5, -28), T.bolt or F.nitride)
		g:box("BoltLug", V(11.5, 5, 8), CF(5.75, -2.5, -54), F.steel)
	end)
	g:travel("bolt", 70)
	g:key("Eject", CF(20, -2, -32) * A(0, -70, 0))
	if not T.noRail then
		g:rail("UpperRail", 145, CF(0, 21, -22.5), T.rail)
	end

	g:group("charge", function()
		g:box("ChargingHandle", V(16, 7, 40), CF(0, 24.5, 75), small)
		g:prism("ChargingHandleWings", V(50, 9, 13), CF(0, 24.5, 101.5), 2.5, small)
	end)
	g:travel("charge", 64)
	g:hand("ChargeHand", V(-30, 34, 104), V(0.75, -0.25, 0.6), V(-0.3, 1, 0.2))

	g:prism("Lower", V(26, 30, 190), CF(0, -33, 0), 3, lower, "bottom")
	g:rounded("BufferTower", V(24, 36, 25), CF(0, -2, 82.5), 11, lower)
	g:prism("MagWell", V(33, 22, 76), CF(0, -57, -57), 4, lower, "bottom")
	g:wedge("MagWellFlare", V(33, 12, 14), CF(0, -62, -102), lower)
	g:detail(function()
		g:cylX("MagRelease", 7, 11, CF(16.5, -38, -12), small)
		g:at(CF(-15, -33, 40), function()
			g:cylX("Selector", 3.5, 12, CF(0, 0, 0), F.anodizedDark)
			g:box("SelectorLever", V(3.5, 5, 17), CF(-1, 0, -7) * A(-25, 0, 0), small)
		end)
	end)

	g:box("TriggerGuard", V(12, 6, 58), CF(0, -73, 10), T.guard or lower)
	g:box("TriggerGuard", V(12, 24, 7), CF(0, -58, 38), T.guard or lower)
	g:group("trigger", function()
		g:box("Trigger", V(6, 20, 6), CF(0, -57, -2) * A(-12, 0, 0), small)
	end)
	g:swing("trigger", CF(0, -47, 0), 12)

	local gripFrame = g:grip(V(0, -48, 64), 22, T.gripLook or furniture, { length = 106, depth = 48, front = 22, back = 31, nub = true })
	if T.gripDress then
		g:at(gripFrame, function()
			T.gripDress(g)
		end)
	end
	g:hand("GripHand", V(31, -88, 86), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))

	g:group("mag", function()
		if T.mag then
			T.mag(g)
		else
			g:magazine("Magazine", { width = 22.5, depth = 62, segments = { { 62, 0 }, { 24, 4 }, { 24, 4 }, { 24, 4 }, { 24, 4 } }, ribs = "stanag", caliber = 9.5, plate = T.plate },
				CF(0, -52, -57), T.magLook or F.anodizedDark)
		end
	end)
	g:key("MagWell", CF(0, -52, -57))
	g:hand("MagHand", V(-28, -120, -62), V(0.4, 0.25, -0.15), V(-1, -0.15, 0))

	T.stock(g)

	local hgFront = -103 - hgLength
	local hgZ = -103 - hgLength / 2
	local info = { front = hgFront, z = hgZ, length = hgLength, barrelEnd = barrelEnd, barrelDia = barrelDia }
	T.handguard(g, info)
	if T.supportHand then
		T.supportHand(g, info)
	else
		g:hand("SupportHand", V(-10, -48, hgZ - hgLength * 0.1), V(0.8, 0.45, -0.3), V(-0.35, -1, 0))
	end

	g:cyl("Barrel", -100 - barrelEnd, barrelDia, CF(0, 0, (barrelEnd - 100) / 2), T.barrel or F.nitride)
	local muzzleZ = T.muzzle(g, barrelEnd, barrelDia)
	g:key("Muzzle", CF(0, 0, muzzleZ))

	T.sights(g, 30.5, info)
	if T.dress then
		T.dress(g, info)
	end

	g.model:SetAttribute("Action", spec.action or "ar")
	g.model:SetAttribute("Flash", spec.flash or "rifle")
	g.model:SetAttribute("Casing", spec.casing or "rifle")
	return upper
end

--------------------------------------------------------------------------------
-- Chassis: the pump gun (the stock pump's mechanism and keypoints)
--------------------------------------------------------------------------------

-- T.metal, T.furniture: looks. T.pumpBody(g): the pump (inside the pump group, round the stock pump's
-- place: centre (0, -28, -300), 46 x 44 x 180). T.stock(g). T.saddle(g): the left side. T.front(g): the
-- barrel's end (after the barrel, tube and bead are built).
local function pumpChassis(g, K, T)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local metal, furniture = T.metal, T.furniture

	g:prism("ReceiverTop", V(30, 8, 210), CF(0, 14, -30), 4, metal, "top")
	local receiver = g:box("Receiver", V(15, 52, 210), CF(-7.5, -16, -30), metal)
	g:box("ReceiverWall", V(15, 26, 210), CF(7.5, -29, -30), metal)
	g:box("ReceiverWall", V(15, 26, 80), CF(7.5, -3, 35), metal)
	g:box("ReceiverWall", V(15, 26, 50), CF(7.5, -3, -110), metal)
	g:box("EjectionPort", V(3.5, 26, 80), CF(5.25, -3, -45), F.shadow)
	g:group("pump", function()
		g:box("BoltCarrier", V(11.5, 20, 60), CF(5.75, -3, -40), F.steel)
	end)
	g:key("Eject", CF(20, -2, -45) * A(0, -70, 0))
	g:box("LoadingPort", V(20, FINE * 2, 70), CF(0, -42 - FINE, -90), F.shadow)
	g:key("Load", CF(0, -60, -80))
	g:box("TriggerPlate", V(24, 10, 120), CF(0, -47, 10), metal)
	g:box("TriggerGuard", V(12, 6, 62), CF(0, -70, 8), T.guard or metal)
	g:box("TriggerGuard", V(12, 15, 6), CF(0, -59.5, -22), T.guard or metal)
	g:box("TriggerGuard", V(12, 15, 6), CF(0, -59.5, 38), T.guard or metal)
	g:group("trigger", function()
		g:box("Trigger", V(6, 17, 6), CF(0, -60, -2) * A(-10, 0, 0), T.trigger or F.steel)
	end)
	g:swing("trigger", CF(0, -52, 0), 10)
	if T.receiverDress then
		T.receiverDress(g)
	end

	g:cyl("Barrel", 485, 23, CF(0, 0, -377.5), T.barrel or F.nitride)
	g:cyl("Bore", FINE, 19, CF(0, 0, -620 - FINE / 2), F.bore)
	g:box("BeadRamp", V(5, 8, 12), CF(0, 15, -606), T.barrel or F.nitride)
	g:ball("FrontBead", 5, CF(0, 20.5, -606), T.bead or F.brass)
	g:cyl("MagTube", 425, 26, CF(0, -30, -347.5), T.tube or F.nitride)
	g:cyl("MagCap", 22, 29, CF(0, -30, -571), T.cap or F.nitride)
	g:box("BarrelClamp", V(34, 50, 14), CF(0, -14, -536), T.tube or F.nitride)
	g:key("Muzzle", CF(0, 0, -624))
	if T.front then
		T.front(g)
	end

	g:group("pump", function()
		T.pumpBody(g)
		for _, sx in ipairs(SIGNS) do
			g:box("ActionBar", V(3, 6, 90), CF(sx * 12, -18, -165), F.steel)
		end
	end)
	g:travel("pump", 85)
	g:hand("SupportHand", V(-8, -58, -300), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g.model:SetAttribute("SupportGroup", "pump")

	T.stock(g)
	g:grip(V(0, -44, 72), 22, T.gripLook or furniture, { length = 96, depth = 46, front = 22, back = 30 })
	g:hand("GripHand", V(31, -86, 104), V(-0.3, 0.12, -1), V(1, 0.1, 0.3))
	if T.saddle then
		T.saddle(g)
	end

	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 0.8)
	g:key("Sight", CF(0, 23, 40))
	g.model:SetAttribute("Action", "pump")
	g.model:SetAttribute("Flash", T.flash or "shotgun")
	g.model:SetAttribute("Casing", "shell")
	return receiver
end

--------------------------------------------------------------------------------
-- Common: Sahur Pistol -- a carved night-drummer's pistol
--------------------------------------------------------------------------------

-- The drummer who walks the street before dawn knocking everyone awake for the meal. The slide is a turned
-- drumstick of pale ash bound with dark cord, its nose rounded into the stick's head; the frame is walnut,
-- the grip cord-wrapped; a little hand drum hangs where a light would, its skin laced over the shell; a brass
-- crescent and star are inlaid in the slide's left side. Tap it and it goes tok.
Builders.SahurPistol = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local ash = skin(g, wood(K, 214, 178, 128))
	local walnut = skin(g, wood(K, 92, 56, 34))
	local cord = fabric(K, 58, 36, 24)
	local brass = F.brass
	local drumSkin = look(K, 238, 226, 196, K.Mat.Fabric)

	local receiver = pistolChassis(g, K, {
		frame = walnut,
		slide = ash,
		small = brass,
		guard = walnut,
		trigger = brass,
		hood = brass,
		slideBody = function(g, front, back)
			local length = back - front
			-- A turned stick: the round-edged body, and the head where the muzzle comes out.
			local body = g:rounded("Slide", V(26, 23, length - 14), CF(0, 1.5, (front + back) / 2 + 7), 9, ash)
			g:ball("SlideHead", 26, CF(0, 1, front + 13), ash)
			g:cyl("SlideNeck", 16, 24, CF(0, 1, front + 21), ash)
			-- Cord bindings round the stick, dark against the pale wood.
			for _, z in ipairs({ front + 36, front + 44, back - 40, back - 32 }) do
				g:rounded("SlideBinding", V(27.8, 24.8, 4), CF(0, 1.5, z), 9.5, cord)
			end
			-- Grip grooves cut into the back of the stick, where a slide's serrations would be.
			g:detail(function()
				for index = 0, 5 do
					for _, sx in ipairs(SIGNS) do
						g:box("SlideSerration", V(FINE * 2, 13, 2.2), CF(sx * 13, 0, back - 10 - index * 4.5), K.finishOf(rgb(150, 112, 70), K.Mat.Wood))
					end
				end
			end)
			-- The inlay: a brass crescent and a star, on the left face.
			g:detail(function()
				arc(g, K, "SlideInlay", CF(-13 - FINE, 2, -40), 7, 200, 340, 7, 2.2, FINE * 2, brass)
				g:ball("SlideInlayStar", 3.4, CF(-13.2, 6, -30), brass)
			end)
			return body
		end,
		sights = function(g, front, back)
			-- A brass bead on a wooden ramp at the front; a notched walnut block at the back.
			g:box("FrontSightBase", V(6, 5, 10), CF(0, 12.5, front + 26), ash)
			g:box("FrontSight", V(3.5, 4, 5), CF(0, 16, front + 26), brass)
			g:ball("SightDot", 2.4, CF(0, 17, front + 23.8), K.F.tritiumOrange)
			for _, sx in ipairs(SIGNS) do
				g:box("RearSight", V(8, 6, 7), CF(sx * 7, 15, back - 12), walnut)
			end
			g:box("RearSightBase", V(6, 2.5, 7), CF(0, 13.25, back - 12), walnut)
		end,
		gripDress = function(g, length)
			-- Cord wrapped round the grip in four turns, a brass ferrule at its heel.
			for index = 0, 3 do
				g:box("GripWrap", V(31.5, 5, 55.5), CF(0, -18 - index * 18, -1.5), cord)
			end
			g:box("GripFerrule", V(31.5, 6, 55.5), CF(0, -length + 6, -1.5), brass)
		end,
		mag = function(g, length)
			g:box("Magazine", V(19, length - 4, 32), CF(0, -length / 2 - 4, 2), walnut)
			g:prism("MagazinePlate", V(25, 7, 42), CF(0, -length - 3.5, 2), 2, brass, "bottom")
		end,
		under = function(g, front)
			-- A hand drum on the rail: a walnut shell, two skins, and the lacing zigzagging between them.
			g:box("DrumMount", V(18, 7, 26), CF(0, -27.5, -58), walnut)
			local z = -80
			g:cyl("Drum", 34, 30, CF(0, -44, z), walnut)
			for _, sz in ipairs(SIGNS) do
				g:cyl("DrumSkin", 3, 31.5, CF(0, -44, z + sz * 17.5), drumSkin)
				g:cyl("DrumHoop", 3, 33, CF(0, -44, z + sz * 15.5), brass)
			end
			g:detail(function()
				for index = 0, 7 do
					local angle = index / 8 * math.pi * 2
					local lean = (index % 2 == 0) and 24 or -24
					g:box("DrumLace", V(1.6, 1.6, 30), CF(0, -44, z) * CFrame.Angles(0, 0, angle) * CF(0, 15.6, 0) * A(lean, 0, 0), cord)
				end
			end)
		end,
	})

	g.model:SetAttribute("Flair", "drum")
	g.model:SetAttribute("ShotCue", "GunshotTung")
	return receiver
end

--------------------------------------------------------------------------------
-- Common: Pocket Popper -- the cinema's pocket popcorn pistol
--------------------------------------------------------------------------------

-- A buttery yellow slide over a red-and-white striped carton of a frame, popcorn spilling out of the
-- ejection port, a butter pump slung under the nose, and the magazine's base a little striped bucket
-- heaped with popcorn.
Builders.PocketPopper = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local butter = skin(g, look(K, 255, 208, 72, K.Mat.SmoothPlastic, 0.12))
	local red = skin(g, look(K, 214, 38, 44))
	local white = look(K, 246, 242, 232)
	local pop = look(K, 255, 248, 222)
	local kernel = look(K, 238, 180, 70)

	local function puff(at, size)
		g:ball("Popcorn", size, at, pop)
		g:ball("Popcorn", size * 0.7, at * CF(size * 0.32, size * 0.18, -size * 0.1), pop)
		g:ball("PopcornKernel", size * 0.36, at * CF(-size * 0.28, -size * 0.12, size * 0.22), kernel)
	end

	local receiver = pistolChassis(g, K, {
		compact = true,
		frame = red,
		slide = butter,
		small = white,
		guard = white,
		trigger = white,
		slideBody = function(g, front, back)
			local body = g:rounded("Slide", V(26, 22, back - front), CF(0, 1, (front + back) / 2), 7, butter)
			-- A white band round the nose: the carton's rim.
			g:rounded("SlideBand", V(27.6, 23.6, 10), CF(0, 1, front + 9), 7.5, white)
			g:detail(function()
				for index = 0, 5 do
					for _, sx in ipairs(SIGNS) do
						g:box("SlideSerration", V(FINE * 2, 13, 2), CF(sx * 13, 0, back - 8 - index * 4.5), kernel)
					end
				end
			end)
			-- Popcorn bursting out of the port on the right.
			puff(CF(16, 9, -14), 11)
			puff(CF(15, 12, -2), 9)
			return body
		end,
		gripDress = function(g, length)
			-- White stripes down both flanks: the carton.
			for _, sx in ipairs(SIGNS) do
				for _, z in ipairs({ -9, 3 }) do
					g:box("GripStripe", V(FINE * 2, length - 8, 5), CF(sx * 12.2, -length / 2, z), white)
				end
			end
		end,
		mag = function(g, length)
			g:box("Magazine", V(19, length - 4, 32), CF(0, -length / 2 - 4, 2), red)
			-- The bucket: flared, striped, heaped with popcorn below the grip.
			g:grip(V(0, -length - 0.3, 0), 0, red, { length = 16, depth = 58, front = 26, back = 32, name = "MagazineBucket" })
			for _, z in ipairs({ -16, -4, 8, 20 }) do
				g:box("MagazineStripe", V(34, 16.5, 3), CF(0, -length - 8.5, z), white)
			end
			g:prism("MagazinePlate", V(30, 5, 58), CF(0, -length - 19, 0), 2, white, "bottom")
		end,
		under = function(g, front)
			-- The butter pump: a yellow bottle on the rail with a red nozzle pointing forward.
			g:box("PumpMount", V(18, 6, 22), CF(0, -27, -60), white)
			g:cyl("ButterBottle", 44, 22, CF(0, -40, -66), butter)
			g:cyl("ButterCap", 10, 16, CF(0, -40, -93), red)
			g:cyl("ButterNozzle", 12, 7, CF(0, -40, -104), red)
			g:detail(function()
				g:box("ButterLabel", V(22.6, 10, 18), CF(0, -40, -66), white)
			end)
		end,
	})
	g.model:SetAttribute("Flair", "toss")
	g.model:SetAttribute("ShotCue", "GunshotPopcorn")
	return receiver
end

--------------------------------------------------------------------------------
-- Common: Pistacchio Pum -- the pawnshop's pistachio pistol
--------------------------------------------------------------------------------

-- A pistachio-green slide with a cream nose, grip panels that are two halves of a cracked pistachio shell
-- with the green nut showing in the crack, and the pawnshop's price tag still tied to the trigger guard.
Builders.PawnshopNine = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local green = skin(g, look(K, 148, 190, 92))
	local greenDark = look(K, 96, 138, 58)
	local shell = look(K, 222, 196, 150, K.Mat.SmoothPlastic)
	local shellDark = look(K, 176, 142, 96)
	local cream = look(K, 240, 226, 190)
	local frame = skin(g, look(K, 122, 98, 70))
	local tag = look(K, 250, 234, 120)
	local twine = fabric(K, 230, 226, 214)

	local receiver = pistolChassis(g, K, {
		frame = frame,
		slide = green,
		small = shellDark,
		guard = frame,
		slideBody = function(g, front, back)
			local body = g:prism("Slide", V(25.5, 22, back - front - 26), CF(0, 1, (front + back) / 2 + 13), 3, green, "top")
			-- The nose in cream, rounded like the tip of a nut.
			g:rounded("SlideNose", V(25.5, 22, 26), CF(0, 1, front + 13), 8, cream)
			g:detail(function()
				-- A darker seam down each side where a shell would split.
				for _, sx in ipairs(SIGNS) do
					g:box("SlideSeam", V(FINE * 2, 2, back - front - 40), CF(sx * 12.8, 1, (front + back) / 2 + 8), greenDark)
				end
				for index = 0, 6 do
					g:box("SlideSerration", V(25.5 + FINE * 2, 13, 2), CF(0, -1, back - 8 - index * 4.5), greenDark)
				end
			end)
			return body
		end,
		gripDress = function(g, length)
			-- A shell half on each flank: a rounded slab, its crack running down the middle, the nut in it.
			for _, sx in ipairs(SIGNS) do
				-- Three stepped layers make the dome of the shell.
				g:rounded("GripShell", V(4.5, length - 16, 44), CF(sx * 14.2, -length / 2 - 2, -1), 2.2, shell)
				g:rounded("GripShell", V(3, length - 28, 34), CF(sx * 17.4, -length / 2 - 2, -1), 1.4, shell)
				g:rounded("GripShell", V(2, length - 42, 22), CF(sx * 19.6, -length / 2 - 2, -1), 0.9, shell)
				g:detail(function()
					g:box("GripShellCrack", V(1.2, length - 44, 4), CF(sx * 20.8, -length / 2 - 2, -1), greenDark)
					g:box("GripNut", V(1.2, length - 50, 2), CF(sx * 21.4, -length / 2 - 2, -1), green)
				end)
			end
		end,
		mag = function(g, length)
			g:box("Magazine", V(19, length - 4, 32), CF(0, -length / 2 - 4, 2), shellDark)
			g:prism("MagazinePlate", V(25, 7, 42), CF(0, -length - 3.5, 2), 2, cream, "bottom")
		end,
		under = function(g, front)
			-- The price tag, on a loop of string round the front of the trigger guard.
			g:box("TagLoop", V(14, 2, 2), CF(0, -52, -39), twine)
			strut(g, K, "TagString", V(0, -52, -40), V(0, -70, -44), 1.6, twine)
			g:box("PriceTag", V(1.6, 16, 26), CF(0, -77, -44) * A(-12, 0, 0), tag)
			g:detail(function()
				g:cylX("PriceTagHole", 2.2, 3.6, CF(0, -70.5, -44), shellDark)
				g:box("PriceTagStripe", V(2.2, 2, 18), CF(0, -80, -45) * A(-12, 0, 0), shellDark)
			end)
		end,
	})
	g.model:SetAttribute("Flair", "tap")
	g.model:SetAttribute("ShotCue", "GunshotPistachio")
	return receiver
end

--------------------------------------------------------------------------------
-- Common: Rot SMG -- the one that has been in the swamp too long
--------------------------------------------------------------------------------

-- A swamp-green SMG gone to rot: fuzzy mould blooming on the receiver, a seam stitched shut down its left
-- side, the handguard wrapped in grubby bandage, a rusted tin can for a suppressor dripping green ooze, a
-- stock made of two old bones, and mushrooms growing out of the whole thing.
Builders.RotSMG = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local rot = skin(g, look(K, 98, 112, 78))
	local rotDark = look(K, 62, 72, 50)
	local mould = fabric(K, 168, 186, 132)
	local bandage = fabric(K, 214, 204, 170)
	local rust = metal(K, 140, 82, 48, 0.02)
	local rustDark = metal(K, 96, 56, 34, 0.02)
	local ooze = neon(K, 120, 255, 80)
	local bone = look(K, 232, 224, 198)
	local capRed = look(K, 196, 48, 40)
	local capBrown = look(K, 150, 96, 60)
	local stem = look(K, 240, 232, 214)

	local receiver = smgChassis(g, K, {
		metal = rot,
		furniture = skin(g, rotDark),
		small = rust,
		tube = rot,
		endCap = rotDark,
		suppressed = true,
		flash = "suppressed",
		receiverDress = function(g)
			-- Mould blooms: soft pale patches standing proud of the walls.
			for _, patch in ipairs({ { -15.2, 8, 60, 22, 40 }, { -15.2, -8, 118, 16, 26 }, { 15.2, 6, 110, 18, 30 }, { 15.2, -10, -110, 14, 22 } }) do
				g:box("Mould", V(FINE * 2, patch[4], patch[5]), CF(patch[1], patch[2], patch[3]), mould)
				g:box("Mould", V(FINE * 2 + 1, patch[4] * 0.55, patch[5] * 0.5), CF(patch[1] + (patch[1] &gt; 0 and 0.5 or -0.5), patch[2] + 2, patch[3] - 3), mould)
			end
			-- A seam stitched shut down the left side.
			g:box("Seam", V(FINE * 2, 2, 150), CF(-15.2, -2, 20), rotDark)
			g:detail(function()
				for index = 0, 8 do
					g:box("Stitch", V(FINE * 2 + 0.6, 9, 1.8), CF(-15.3, -2, -50 + index * 17) * A(0, 0, 0) * A(20, 0, 0), bandage)
				end
			end)
			-- Mushrooms growing out of the right side of the receiver.
			mushroom(g, K, CF(15, 12, 40) * A(0, 0, -70), 14, 22, capRed, stem, stem)
			mushroom(g, K, CF(15, 2, 66) * A(0, 0, -80), 10, 15, capBrown, stem, nil)
		end,
		front = function(g)
			-- The handguard under its bandage, and the rusted can past it.
			g:rounded("Handguard", V(56, 56, 120), CF(0, -2, -200), 26, rotDark)
			for index = 0, 5 do
				g:shell("Bandage", 12, 61, 5, CF(0, -2, -250 + index * 19) * A((index % 2 == 0) and 9 or -9, 0, 0), bandage, 14)
			end
			g:cyl("Suppressor", 330, 52, CF(0, -2, -305), rust)
			g:detail(function()
				-- The can's pressed ribs, and its paper label peeling off.
				for index = 0, 6 do
					g:cyl("SuppressorBand", 3, 54, CF(0, -2, -300 - index * 22), rustDark)
				end
				g:cyl("SuppressorLabel", 28, 53, CF(0, -2, -404), K.finishOf(rgb(120, 150, 90), K.Mat.Fabric))
				g:cyl("SuppressorLabel", 22, 53, CF(0, -2, -432), K.finishOf(rgb(200, 190, 120), K.Mat.Fabric))
				g:cyl("Bore", 2, 10, CF(0, -2, -470.4), F.bore)
			end)
			g:cyl("SuppressorRim", 4, 53.5, CF(0, -2, -468), rustDark)
			-- Ooze running over the rim and dripping off it.
			for index, drip in ipairs({ { -14, -24, 8 }, { 6, -27, 6 }, { 18, -20, 5 } }) do
				g:box("Ooze", V(8, 14, 5), CF(drip[1], drip[2] + 6, -467), ooze)
				g:ball("OozeDrip", drip[3] * 1.5, CF(drip[1], drip[2] - drip[3] * 0.3, -467), ooze)
			end
			return -472
		end,
		stock = function(g)
			-- Two bones for a stock, knuckled at both ends, and a pad lashed across their ends.
			for _, sx in ipairs(SIGNS) do
				g:prism("StockBone", V(14, 14, 180), CF(sx * 14, -6, 262), 4, bone)
				for _, z in ipairs({ 172, 352 }) do
					for _, sy in ipairs(SIGNS) do
						g:ball("StockBoneKnuckle", 17, CF(sx * 14, -6 + sy * 7, z), bone)
					end
				end
			end
			g:box("StockYoke", V(34, 12, 18), CF(0, -6, 360), rotDark)
			g:rounded("Buttpad", V(40, 30, 104), CF(0, -26, 372) * A(90, 0, 0), 12, F.rubber)
			g:box("StockLashing", V(42, 14, 8), CF(0, -6, 348), bandage)
			mushroom(g, K, CF(-14, 1, 300), 13, 20, capRed, stem, stem)
			mushroom(g, K, CF(14, 1, 230), 9, 14, capBrown, stem, nil)
		end,
		mag = function(g)
			g:magazine("Magazine", { width = 22, depth = 34, segments = { { 60, 0 }, { 42, 4 }, { 42, 4 }, { 42, 4 } }, ribs = "stanag", caliber = 9, plate = rustDark },
				CF(0, -40, -76), rot)
			g:detail(function()
				for index = 0, 2 do
					g:box("Mould", V(24 + FINE * 2, 14, 10), CF(0, -76 - index * 38, -76 + (index - 1) * 6) * A(12, 0, 0), mould)
				end
			end)
		end,
	})
	g.model:SetAttribute("Flair", "shake")
	g.model:SetAttribute("ShotCue", "GunshotRot")
	return receiver
end

--------------------------------------------------------------------------------
-- Common: Crumbly Carbine -- the biscuit tin carbine
--------------------------------------------------------------------------------

-- A short carbine baked rather than machined: shortbread-gold furniture studded with chocolate chips, a
-- cream-sandwich biscuit for a handguard (two docked biscuits and the filling between), a stock with a
-- bite out of it, a muzzle ring of biscuit, and a magazine packed like a sleeve of cookies.
Builders.CrumblyCarbine = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local biscuit = skin(g, look(K, 214, 162, 96))
	local biscuitDark = look(K, 170, 118, 64)
	local cream = look(K, 246, 238, 218)
	local choc = look(K, 74, 44, 28)
	local tin = metal(K, 70, 96, 140, 0.06)

	local function chips(list)
		for _, at in ipairs(list) do
			g:ball("ChocolateChip", at[4] or 6, CF(at[1], at[2], at[3]), choc)
		end
	end

	local receiver = arChassis(g, K, { hgLength = 226, barrelEnd = -380 }, {
		receiver = skin(g, tin),
		lower = skin(g, tin),
		furniture = biscuit,
		small = choc,
		rail = choc,
		magLook = biscuitDark,
		plate = choc,
		gripDress = function(g)
			for _, sx in ipairs(SIGNS) do
				g:ball("ChocolateChip", 5, CF(sx * 12, -30, 4), choc)
				g:ball("ChocolateChip", 4, CF(sx * 12, -62, -2), choc)
			end
		end,
		stock = function(g)
			g:cyl("BufferTube", 177, 30, CF(0, -3, 191.5), tin)
			g:at(CF(0, 0, 205), function()
				-- The stock, with a bite taken out of its top rear corner: two blocks leave the notch, and the
				-- crumbs round it are the edge of the bite.
				g:rounded("Stock", V(40, 42, 110), CF(0, -3, -20), 13, biscuit)
				g:rounded("Stock", V(40, 20, 40), CF(0, -14, 55), 8, biscuit)
				g:wedge("StockWeb", V(34, 76, 130), CF(0, -60, 10) * A(0, 0, 180), biscuit)
				g:rounded("Buttpad", V(44, 20, 128), CF(0, -38, 83) * A(90, 0, 0), 8, biscuitDark)
				for index, crumb in ipairs({ { 8, 2, 38, 7 }, { -6, 0, 44, 6 }, { 2, -2, 52, 8 }, { -10, 4, 30, 5 } }) do
					g:ball("StockCrumb", crumb[4], CF(crumb[1], crumb[2], crumb[3]), biscuitDark)
				end
				chips({ { 20, -8, -40 }, { 20, 6, -8 }, { -20, -2, -30 }, { -20, -10, 10 }, { 17, -40, 30, 5 }, { -17, -48, 20, 5 } })
			end)
		end,
		handguard = function(g, info)
			g:at(CF(0, -4, info.z), function()
				-- A stack of chocolate-chip cookies threaded on a cream-filled core: every third one a chocolate
				-- cookie, each studded with chips on both faces and round its rim.
				g:cyl("HandguardCore", info.length, 40, CF(0, 0, 0), cream)
				local count = 7
				local pitch = info.length / count
				for index = 0, count - 1 do
					local z = -info.length / 2 + pitch * (index + 0.5)
					local dark = index % 3 == 1
					g:cyl("Handguard", pitch - 7, 58, CF(0, 0, z), dark and choc or biscuit)
					g:detail(function()
						for chip = 0, 4 do
							local angle = chip / 5 * math.pi * 2 + index * 0.9
							g:ball("ChocolateChip", 5, CF(math.cos(angle) * 28.2, math.sin(angle) * 28.2, z), dark and cream or choc)
						end
					end)
				end
				-- A block of chocolate on the front cookie for the front sight to stand on.
				g:box("HandguardRail", V(18, 9, 26), CF(0, 29 + 4.5 - 4, -info.length / 2 + 26), choc)
			end)
		end,
		muzzle = function(g, barrelEnd, barrelDia)
			-- A ring biscuit on the muzzle, holed through the middle.
			g:crown("MuzzleBrake", 16, 36, 12, CF(0, 0, barrelEnd - 8), biscuit)
			g:cyl("MuzzleCollar", 14, barrelDia + 4, CF(0, 0, barrelEnd + 2), choc)
			g:detail(function()
				for index = 0, 5 do
					local angle = index / 6 * math.pi * 2 + 0.3
					g:ball("ChocolateChip", 4.5, CF(math.cos(angle) * 12.5, math.sin(angle) * 12.5, barrelEnd - 16.5), choc)
				end
			end)
			return barrelEnd - 17
		end,
		mag = function(g)
			g:magazine("Magazine", { width = 22.5, depth = 62, segments = { { 62, 0 }, { 24, 4 }, { 24, 4 }, { 24, 4 }, { 24, 4 } }, caliber = 9.5, plate = choc },
				CF(0, -52, -57), biscuitDark)
			-- A paper sleeve round the middle of the pack.
			g:box("MagazineSleeve", V(24.5, 40, 63), CF(0, -52 - 44, -57 + 1.5) * A(4, 0, 0), cream)
		end,
		sights = function(g, railTop, info)
			g:rearAperture(CF(0, railTop, 30), 36)
			g:frontPost(CF(0, 30.5 - 0.5, info.front + 26), 36.5)
			g:key("Sight", CF(0, railTop + 36, 40))
			g.model:SetAttribute("Optic", "iron")
			g.model:SetAttribute("EyeRelief", 0.3)
		end,
		dress = function(g)
			chips({ { 15.5, -34, -30, 5 }, { -15.5, -30, 20, 5 }, { 15.5, -26, 50, 4 } })
		end,
	})
	g.model:SetAttribute("Flair", "crumbs")
	g.model:SetAttribute("ShotCue", "GunshotCrumb")
	return receiver
end

--------------------------------------------------------------------------------
-- Common: Ciabatta Clonk -- the night-shift bakery's shotgun
--------------------------------------------------------------------------------

-- The bakery's night security gun: a charcoal receiver with an amber ID plate, a pump that is a floury
-- ciabatta loaf scored across the top, the stock the heel of a baguette, and breadsticks where the side
-- saddle's spare shells would be.
Builders.NightShiftPump = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local charcoal = skin(g, metal(K, 50, 55, 62))
	local crust = skin(g, look(K, 198, 142, 78))
	local crustDark = look(K, 150, 96, 48)
	local flour = look(K, 246, 240, 226, K.Mat.Sand)
	local amber = look(K, 232, 168, 48)
	local grissini = look(K, 222, 176, 108)

	local receiver = pumpChassis(g, K, {
		metal = charcoal,
		furniture = crust,
		receiverDress = function(g)
			g:box("IdPlate", V(FINE * 2, 16, 60), CF(-15.2, -16, -40), amber)
			g:detail(function()
				g:box("IdPlateStripe", V(FINE * 2 + 0.4, 3, 50), CF(-15.4, -12, -40), charcoal)
			end)
		end,
		pumpBody = function(g)
			-- The loaf: a low, wide rounded bread, darker along its bottom edge, flour on top and three scores.
			g:rounded("Pump", V(50, 44, 180), CF(0, -28, -300), 18, crust)
			g:rounded("PumpBase", V(52, 10, 170), CF(0, -46, -300), 5, crustDark)
			for index = 0, 2 do
				g:box("PumpScore", V(40, 4, 9), CF(0, -5, -250 - index * 50) * A(0, 35, 0), crustDark)
				g:box("PumpFlour", V(24, 2, 30), CF(0, -5.5, -275 - index * 50) * A(0, -20, 0), flour)
			end
		end,
		stock = function(g)
			g:at(CF(0, 0, 75), function()
				-- The heel of a baguette: long and round, scored, its end cut flat for a butt.
				g:rounded("Stock", V(44, 46, 330), CF(0, -24, 165), 18, crust)
				g:wedge("StockWeb", V(38, 100, 220), CF(0, -95, 245) * A(0, 0, 180), crust)
				g:prism("Buttpad", V(44, 146, 20), CF(0, -72, 340), 4, crustDark)
				g:box("ButtpadCrumb", V(36, 120, 3), CF(0, -72, 351.5), look(K, 244, 226, 186))
				for index = 0, 3 do
					g:box("StockScore", V(30, 4, 10), CF(0, 0, 90 + index * 62) * A(0, 40, 0), crustDark)
				end
			end)
		end,
		saddle = function(g)
			-- Breadsticks in the saddle.
			g:box("SideSaddle", V(4, 44, 110), CF(-17, -8, -40), charcoal)
			for index = 0, 4 do
				g:cylY("Grissini", 52, 10, CF(-25, -10, -80 + index * 20) * A(0, 0, (index % 2 == 0) and 4 or -4), grissini)
			end
			g:box("SaddleStrap", V(24, 8, 108), CF(-27, -20, -40), charcoal)
		end,
	})
	g.model:SetAttribute("Flair", "pump")
	g.model:SetAttribute("ShotCue", "GunshotClonk")
	return receiver
end

--------------------------------------------------------------------------------
-- Uncommon: Crocodilo Rifle -- the crocodile bomber
--------------------------------------------------------------------------------

-- An AK gone to the swamp and taken to the sky: croc-green furniture with rows of scutes down the upper
-- handguard and the stock, a belly-pale magazine, the muzzle a crocodile's head -- eyes on top, nostrils at
-- the end, and a lower jaw that snaps -- and a bomber's tailplane on the butt.
Builders.CrocodiloRifle = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local croc = skin(g, look(K, 74, 118, 60))
	local crocDark = look(K, 46, 78, 38)
	local belly = look(K, 226, 214, 160)
	local tooth = look(K, 250, 248, 236)
	local iris = look(K, 250, 214, 60)
	local gunmetal = metal(K, 44, 52, 44)

	local receiver = stock(g, K, { pattern = "ak", woodFurniture = true })
	strip(g, { "^MuzzleBrake", "^Bore$", "^CleaningRod$", "^BayonetLug$" })
	paint(g, {
		{ "^MagazineRound", F.brass }, { "^MagazineBullet", F.copper }, { "^MagazineRib", crocDark }, { "^Magazine", belly },
		{ "^Handguard", croc }, { "^StockTang", gunmetal }, { "^Stock", croc }, { "^Grip", crocDark },
		{ "^Receiver", gunmetal }, { "^TopCover", gunmetal }, { "^Buttplate", crocDark }, { "^EjectionPort", F.shadow },
	})

	-- Scutes: two rows of ridged plates down the upper handguard and along the top of the stock.
	for index = 0, 5 do
		for _, sx in ipairs(SIGNS) do
			g:prism("Scute", V(7, 5, 12), CF(sx * 8, 39, -196 - index * 18), 2, crocDark, "top")
		end
	end
	for index = 0, 8 do
		for _, sx in ipairs(SIGNS) do
			g:prism("Scute", V(8, 5, 14), CF(sx * 8, 7.4, 150 + index * 21), 2, crocDark, "top")
		end
	end

	-- The head: a hinge block round the barrel's end, a snout for the upper jaw and a lower jaw on a hinge,
	-- teeth down both, nostrils at the tip and a pair of eyes on top.
	g:cyl("MuzzleExtension", 40, 18, CF(0, 0, -505), F.nitride)
	g:rounded("JawHinge", V(36, 32, 26), CF(0, 0, -513), 11, croc)
	g:prism("JawUpper", V(30, 10, 62), CF(0, 11, -556), 3, croc, "top")
	g:cyl("Bore", FINE, 12, CF(0, 0, -526 - FINE / 2), F.bore)
	for index = 0, 6 do
		for _, sx in ipairs(SIGNS) do
			g:wedge("JawTooth", V(3, 5, 5), CF(sx * 12, 3.5, -534 - index * 7.5) * A(0, 0, 180), tooth)
		end
	end
	for _, sx in ipairs(SIGNS) do
		g:ball("Nostril", 5, CF(sx * 6, 16, -582), crocDark)
		g:ball("EyeSocket", 13, CF(sx * 10, 17, -512), croc)
		g:ball("Eye", 8, CF(sx * 11.5, 20, -514), iris)
		g:box("EyePupil", V(1.6, 5.5, 2), CF(sx * 14.6, 20.5, -514.5), F.shadow)
	end
	g:group("jaw", function()
		g:prism("JawLower", V(28, 9, 58), CF(0, -11, -554), 3, croc, "bottom")
		g:box("JawChin", V(24, 4, 50), CF(0, -17, -552), belly)
		for index = 0, 6 do
			for _, sx in ipairs(SIGNS) do
				g:wedge("JawTooth", V(3, 5, 5), CF(sx * 11, -4, -532 - index * 7.5), tooth)
			end
		end
	end)
	g:swing("jaw", CF(0, -8, -524), -24)
	g:key("Muzzle", CF(0, 0, -528))

	-- The bomber's tail: a fin standing up off the back of the stock and a tailplane across the butt.
	g:wedge("TailFin", V(4, 42, 64), CF(0, 25.5, 312), croc)
	g:box("TailPlane", V(108, 4, 34), CF(0, 0, 328), croc)
	g:box("TailPlaneTip", V(6, 5, 30), CF(54, 0, 328), crocDark)
	g:box("TailPlaneTip", V(6, 5, 30), CF(-54, 0, 328), crocDark)

	g.model:SetAttribute("Flair", "chomp")
	g.model:SetAttribute("ShotCue", "GunshotCroc")
	return receiver
end

--------------------------------------------------------------------------------
-- Uncommon: Tralala Shotgun -- the shark in sneakers
--------------------------------------------------------------------------------

-- A pump gun that is a shark from the grip forward: grey-blue on top and white below, gills cut into the
-- receiver, an eye either side, teeth round the muzzle, a dorsal fin and a crescent tail for a stock -- and
-- its pump is a blue high-top sneaker, laces and all.
Builders.TralalaShotgun = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local shark = skin(g, look(K, 104, 128, 156, K.Mat.SmoothPlastic, 0.05))
	local sharkDark = look(K, 72, 92, 116)
	local white = look(K, 240, 242, 244)
	local sneaker = look(K, 46, 104, 214)
	local sole = look(K, 246, 246, 240)
	local lace = look(K, 250, 250, 250)

	local receiver = pumpChassis(g, K, {
		metal = shark,
		furniture = shark,
		guard = white,
		barrel = sharkDark,
		tube = sharkDark,
		cap = white,
		receiverDress = function(g)
			-- The belly, three gills on each side, and the eyes.
			g:box("Belly", V(31.5, 16, 200), CF(0, -34, -30), white)
			for _, sx in ipairs(SIGNS) do
				for index = 0, 2 do
					g:box("Gill", V(FINE * 2, 26, 3), CF(sx * 15.2, -12, -100 + index * 12) * A(0, 0, sx * 8), sharkDark)
				end
				-- A pectoral fin swept out and down off each side of the belly.
				g:wedge("PectoralFin", V(4, 44, 58), CF(sx * 26, -44, -70) * A(0, 0, sx * 55), shark)
				g:ball("Eye", 13, CF(sx * 12.5, 2, -122), F.shadow)
				g:ball("EyeGlint", 4, CF(sx * 17.6, 5, -125), white)
			end
		end,
		front = function(g)
			-- A ring of teeth round the muzzle.
			for index = 0, 9 do
				g:wedge("MuzzleTooth", V(4, 5, 7), CF(0, 0, -618) * CFrame.Angles(0, 0, index / 10 * math.pi * 2) * CF(0, 13.5, 0) * A(0, 180, 0), white)
			end
		end,
		pumpBody = function(g)
			-- The sneaker: a white sole, the blue upper, a rounded toe, the heel tab and laces across the top.
			g:rounded("PumpSole", V(52, 12, 188), CF(0, -47, -300), 5, sole)
			g:rounded("Pump", V(46, 36, 166), CF(0, -24, -296), 13, sneaker)
			g:rounded("PumpToe", V(52, 24, 38), CF(0, -34, -378), 11, sole)
			g:rounded("PumpCollar", V(54, 14, 20), CF(0, -8, -216), 6, sole)
			g:box("PumpHeelTab", V(20, 14, 8), CF(0, -4, -206), sole)
			for index = 0, 4 do
				local z = -246 - index * 22
				g:box("PumpLace", V(36, 3, 4), CF(0, -5, z) * A(0, 28, 0), lace)
				g:box("PumpLace", V(36, 3, 4), CF(0, -5, z) * A(0, -28, 0), lace)
			end
			-- A lightning stripe down the outside of the shoe (the right: the left hand wraps the other side).
			g:box("PumpStripe", V(FINE * 2, 8, 60), CF(23.2, -24, -318) * A(-16, 0, 0), sole)
			g:box("PumpStripe", V(FINE * 2, 8, 50), CF(23.2, -30, -262) * A(16, 0, 0), sole)
		end,
		stock = function(g)
			g:at(CF(0, 0, 75), function()
				g:rounded("Stock", V(42, 44, 330), CF(0, -24, 165), 16, shark)
				g:rounded("StockBelly", V(40, 10, 300), CF(0, -44, 160), 4, white)
				g:wedge("StockWeb", V(38, 100, 220), CF(0, -95, 245) * A(0, 0, 180), white)
				-- The dorsal fin, behind the eye, and the crescent tail as the butt.
				g:wedge("DorsalFin", V(6, 62, 90), CF(0, 28, 225), shark)
				-- Two wedges make each lobe of the crescent, swept back from the butt.
				g:prism("Buttpad", V(40, 120, 16), CF(0, -60, 334), 4, sharkDark)
				g:wedge("TailFluke", V(10, 70, 46), CF(0, 30, 362) * A(-35, 0, 0), shark)
				g:wedge("TailFluke", V(10, 60, 46), CF(0, -140, 360) * A(215, 0, 0), shark)
			end)
		end,
	})
	g.model:SetAttribute("Flair", "sneaker")
	g.model:SetAttribute("ShotCue", "GunshotShark")
	return receiver
end

--------------------------------------------------------------------------------
-- Uncommon: Lag Switch SMG -- the router
--------------------------------------------------------------------------------

-- A matte-black home router with a trigger: two antennas raked back off its shoulders, a row of status
-- lights down its side (one of them always amber), a vented modem for a handguard, a spool of yellow
-- network cable for a drum, and the wifi fan printed on its stock.
Builders.LagSwitchSMG = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local black = skin(g, look(K, 32, 34, 38))
	local grey = look(K, 70, 74, 80)
	local cable = look(K, 240, 200, 50)
	local cableDark = look(K, 200, 160, 30)
	local green = neon(K, 90, 255, 120)
	local amber = neon(K, 255, 180, 40)
	local cyan = neon(K, 90, 220, 255)

	local receiver = smgChassis(g, K, {
		metal = black,
		furniture = black,
		tube = grey,
		drum = true,
		receiverDress = function(g)
			-- Status lights down the left side.
			for index, light in ipairs({ green, green, amber, green, green }) do
				g:box("StatusLight", V(FINE * 2, 4, 7), CF(-15.3, 10, -40 + index * 16), light)
			end
			-- A scroll-wheel knob on the right, for turning the lag up.
			g:cylX("LagDial", 8, 30, CF(19, 4, 110), grey)
			g:detail(function()
				g:ridges("LagDialRib", 12, 12, 15.6, 2, 8, CF(19, 4, 110) * A(0, 90, 0), black)
			end)
			-- Vents across the top at the back.
			g:detail(function()
				for index = 0, 5 do
					g:box("Vent", V(24, FINE * 2, 3), CF(0, 20.2, 60 + index * 9), F.shadow)
				end
			end)
		end,
		front = function(g)
			g:cyl("Barrel", 150, 15, CF(0, 0, -215), F.nitride)
			g:rounded("Handguard", V(42, 40, 124), CF(0, -8, -205), 8, black)
			g:detail(function()
				for _, sx in ipairs(SIGNS) do
					for index = 0, 5 do
						g:box("HandguardVent", V(FINE * 2, 16, 4), CF(sx * 21, -8, -250 + index * 16), F.shadow)
					end
				end
			end)
			g:cyl("MuzzleBrake", 16, 18, CF(0, 0, -298), grey)
			g:cyl("MuzzleSignal", 4, 20, CF(0, 0, -293), cyan)
			-- Rabbit-ear antennas off the barrel band, splayed wide of the sight picture.
			for _, sx in ipairs(SIGNS) do
				g:box("AntennaHinge", V(10, 10, 12), CF(sx * 15, 18, -258), grey)
				g:at(CF(sx * 16, 22, -258) * A(-12, 0, -sx * 38), function()
					g:prism("Antenna", V(7, 64, 4), CF(0, 32, 0), 2, black)
					g:box("AntennaTip", V(7.4, 8, 4.4), CF(0, 62, 0), grey)
				end)
			end
			g:cyl("Bore", 2, 8, CF(0, 0, -307), F.bore)
			g:laserModule(CF(0, -44, -214))
			return -308
		end,
		mag = function(g)
			-- The cable spool: a feed tower into the well, the spool with its winding ridges and flanges.
			g:at(CF(0, -44, -76), function()
				g:box("Magazine", V(20, 42, 34), CF(0, -21, 0), black)
				local centre = CF(0, -42 - 50 + 8, -2)
				g:cylX("Magazine", 56, 96, centre, cable)
				for index = 0, 3 do
					g:cylX("MagazineCoil", 3, 98, centre * CF(-21 + index * 14, 0, 0), cableDark)
				end
				for _, sx in ipairs(SIGNS) do
					g:cylX("MagazineFlange", 4, 106, centre * CF(sx * 30, 0, 0), grey)
					g:cylX("MagazineHub", 6, 26, centre * CF(sx * 35, 0, 0), black)
				end
			end)
		end,
		stock = function(g)
			g:at(CF(0, 0, 168), function()
				g:rounded("Stock", V(36, 34, 200), CF(0, -2, 100), 11, black)
				g:wedge("StockWeb", V(32, 66, 180), CF(0, -52, 110) * A(0, 0, 180), black)
				g:rounded("Buttpad", V(40, 20, 104), CF(0, -34, 210) * A(90, 0, 0), 8, F.rubber)
				-- The wifi fan on each side of the stock.
				g:detail(function()
					for _, sx in ipairs(SIGNS) do
						for ring = 1, 3 do
							arc(g, K, "WifiFan", CF(sx * (18 + FINE), -14, 110), ring * 7, -45, 45, 5, 2, FINE * 2, cyan)
						end
						g:ball("WifiDot", 4, CF(sx * 18, -14, 110), cyan)
					end
				end)
			end)
		end,
	})
	g.model:SetAttribute("Flair", "lag")
	g.model:SetAttribute("ShotCue", "GunshotLag")
	return receiver
end

--------------------------------------------------------------------------------
-- Uncommon: Scrolla Scrolla Brrrap -- the phone on a selfie stick
--------------------------------------------------------------------------------

-- Midnight blue, with a phone clamped to its left side, its screen lit and mid-scroll; a power bank for a
-- magazine; a selfie stick for a stock with a second phone in the clamp at its end; the camera bump for a
-- holographic sight.
Builders.DoomscrollSMG = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local navy = skin(g, look(K, 40, 49, 68))
	local phone = look(K, 24, 24, 28)
	local screen = neon(K, 70, 130, 230)
	local white = look(K, 236, 238, 240)
	local chrome = metal(K, 180, 184, 190, 0.2)
	local icons = { neon(K, 255, 90, 120), neon(K, 255, 200, 60), neon(K, 90, 230, 140), neon(K, 170, 110, 255) }

	local receiver = smgChassis(g, K, {
		metal = navy,
		furniture = look(K, 30, 36, 50),
		tube = navy,
		receiverDress = function(g)
			-- The phone on the left: a black slab, its lit screen, a scroll bar and a column of app tiles.
			g:rounded("Phone", V(8, 64, 150), CF(-19, 0, -5), 3, phone)
			g:box("PhoneScreen", V(1.2, 56, 138), CF(-23.4, 0, -5), screen)
			g:box("PhoneScrollBar", V(1.6, 16, 3), CF(-23.8, 14, 58), white)
			g:detail(function()
				for row = 0, 3 do
					for col = 0, 1 do
						g:box("PhoneApp", V(1.6, 10, 10), CF(-23.8, 18 - row * 13, -50 + col * 14), icons[(row + col) % 4 + 1])
					end
				end
				for index = 0, 3 do
					g:box("PhoneFeed", V(1.6, 3, 60), CF(-23.8, 18 - index * 9, 10), white)
				end
			end)
			g:box("PhoneClamp", V(10, 8, 30), CF(-13, 30, -5), chrome)
			g:box("PhoneClamp", V(10, 8, 30), CF(-13, -30, -5), chrome)
			-- A notification light and a lit "new posts" pill on the right.
			g:rounded("NotificationPill", V(3, 12, 34), CF(16.2, 12, 70), 1.4, icons[1])
			g:ball("NotificationDot", 6, CF(16.5, -10, 70), icons[3])
		end,
		sights = function(g)
			g:box("ClawRail", V(28, 12, 140), CF(0, 27, 40), navy)
			g:rail("OpticRail", 132, CF(0, 33, 40))
			local h = g:holo(CF(0, 42.5, 30))
			g:key("Sight", CF(0, 42.5 + h, 110))
			g.model:SetAttribute("Optic", "holo")
			g.model:SetAttribute("EyeRelief", 0.6)
			-- The front post stays on its tube, as the holo's backup.
			g:at(CF(0, 28, -282), function()
				g:box("FrontSightBase", V(26, 14.5, 26), CF(0, -2.75, 0), navy)
				g:box("FrontSight", V(2.2, 6, 3), CF(0, 6, 0), navy)
			end)
		end,
		front = function(g)
			g:cyl("Barrel", 150, 15, CF(0, 0, -215), F.nitride)
			g:rounded("Handguard", V(42, 40, 124), CF(0, -8, -205), 15, navy)
			g:cyl("MuzzleBrake", 16, 18, CF(0, 0, -298), F.nitride)
			g:cyl("Bore", 2, 8, CF(0, 0, -307), F.bore)
			g:laserModule(CF(0, -44, -214))
			return -308
		end,
		mag = function(g)
			-- The power bank, its four charge lights and the cable stub into the well.
			g:rounded("Magazine", V(24, 118, 38), CF(0, -40 - 59, -76), 6, white)
			g:detail(function()
				for index = 0, 3 do
					g:box("MagazineLight", V(FINE * 2, 3, 5), CF(-12.2, -130 + index * 8, -60), index &lt; 3 and neon(K, 90, 230, 255) or F.shadow)
				end
			end)
			g:box("MagazinePort", V(16, 6, 12), CF(0, -160, -76), phone)
		end,
		stock = function(g)
			-- The selfie stick: three telescoping sections, a clamp on the end with a phone in it.
			g:box("StockYoke", V(34, 12, 18), CF(0, -6, 176), navy)
			local sections = { { 14, 60, 202 }, { 11, 60, 258 }, { 8, 60, 314 } }
			for _, section in ipairs(sections) do
				g:prism("SelfieStick", V(section[1], section[1], section[2]), CF(0, -6, section[3]), section[1] * 0.3, chrome)
			end
			g:box("SelfieClamp", V(18, 20, 14), CF(0, -6, 348), phone)
			g:rounded("Buttpad", V(40, 30, 104), CF(0, -26, 362) * A(90, 0, 0), 5, phone)
			g:box("ButtpadScreen", V(34, 1.2, 88), CF(0, -26, 377.6) * A(90, 0, 0), screen)
		end,
	})
	g.model:SetAttribute("Flair", "scroll")
	g.model:SetAttribute("ShotCue", "GunshotScroll")
	return receiver
end

--------------------------------------------------------------------------------
-- Uncommon: Scarponcino Trotto Trotto -- the trail carbine
--------------------------------------------------------------------------------

-- A short carbine packed for a hike: an aluminium trekking-pole handguard with a foam grip where the hand
-- goes and a headlamp strapped round its nose, paracord wrapped round the stock and the magazine, a
-- compass set in the stock's side and a carabiner hanging off it.
Builders.TrailheadCarbine = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local olive = skin(g, look(K, 100, 112, 79))
	local tan = look(K, 214, 196, 150)
	local alu = metal(K, 176, 180, 186, 0.12)
	local foam = look(K, 40, 62, 110, K.Mat.Fabric)
	local cord = fabric(K, 230, 96, 40)
	local lamp = look(K, 40, 42, 46)
	local orange = look(K, 240, 120, 30)

	local receiver = arChassis(g, K, { hgLength = 226, barrelEnd = -380 }, {
		receiver = olive,
		lower = olive,
		furniture = tan,
		small = orange,
		stock = function(g)
			g:cyl("BufferTube", 177, 30, CF(0, -3, 191.5), alu)
			g:at(CF(0, 0, 205), function()
				g:rounded("Stock", V(40, 42, 150), CF(0, -3, 0), 13, tan)
				g:wedge("StockWeb", V(34, 76, 130), CF(0, -60, 10) * A(0, 0, 180), tan)
				g:rounded("Buttpad", V(44, 20, 128), CF(0, -38, 83) * A(90, 0, 0), 8, F.rubber)
				-- Paracord wraps, the compass set in the left face, the carabiner under the heel.
				for index = 0, 3 do
					g:rounded("StockCord", V(42.5, 44.5, 5), CF(0, -3, -50 + index * 8), 14, cord)
				end
				g:cylX("Compass", 5, 30, CF(-21.5, -8, 30), alu)
				g:cylX("CompassFace", 1.4, 26, CF(-24.7, -8, 30), look(K, 240, 238, 226))
				g:box("CompassNeedle", V(1.6, 2, 20), CF(-25, -8, 30) * A(40, 0, 0), look(K, 210, 40, 40))
				g:box("CarabinerMount", V(10, 10, 12), CF(0, -94, 70), alu)
				arc(g, K, "Carabiner", CF(0, -112, 70), 12, 0, 360, 12, 3, 3, orange)
			end)
		end,
		handguard = function(g, info)
			g:at(CF(0, -4, info.z), function()
				g:cyl("Handguard", info.length, 44, CF(0, 0, 0), alu)
				g:cyl("HandguardFoam", 80, 48, CF(0, 0, -info.length * 0.1), foam)
				for _, z in ipairs({ -info.length / 2 + 10, info.length / 2 - 10 }) do
					g:cyl("HandguardCollar", 12, 47, CF(0, 0, z), lamp)
				end
				g:box("HandguardRail", V(18, 9, 40), CF(0, 25 + 4.5 - 4, -info.length / 2 + 30), lamp)
				-- The headlamp on its band round the nose, its lamp on the left.
				g:cyl("HeadlampBand", 10, 46.4, CF(0, 0, -info.length / 2 + 46), orange)
				g:rounded("Headlamp", V(14, 26, 24), CF(-28, 0, -info.length / 2 + 46), 5, lamp)
				g:cylX("HeadlampLens", 2, 18, CF(-35.5, 0, -info.length / 2 + 46), look(K, 255, 250, 220, K.Mat.Glass, 0.3, 0.2))
			end)
		end,
		muzzle = function(g, barrelEnd)
			return barrelEnd + g:birdcage(CF(0, 0, barrelEnd), 22)
		end,
		mag = function(g)
			g:magazine("Magazine", { width = 22.5, depth = 62, segments = { { 62, 0 }, { 24, 4 }, { 24, 4 }, { 24, 4 }, { 24, 4 } }, ribs = "stanag", caliber = 9.5, plate = orange },
				CF(0, -52, -57), lamp)
			for index = 0, 2 do
				g:box("MagazineCord", V(25, 4, 65), CF(0, -52 - 70 - index * 6, -55) * A(6, 0, 0), cord)
			end
		end,
		sights = function(g, railTop, info)
			g:rearAperture(CF(0, railTop, 30), 36)
			g:frontPost(CF(0, 30.5 - 0.5, info.front + 30), 36.5)
			g:key("Sight", CF(0, railTop + 36, 40))
			g.model:SetAttribute("Optic", "iron")
			g.model:SetAttribute("EyeRelief", 0.3)
		end,
	})
	g.model:SetAttribute("Flair", "compass")
	g.model:SetAttribute("ShotCue", "GunshotTrail")
	return receiver
end

--------------------------------------------------------------------------------
-- Rare: Bananini Burst -- the banana rifle
--------------------------------------------------------------------------------

-- Half peeled: the handguard is the fruit with four strips of peel curling back off it, the vertical grip
-- a small banana, the magazine one long curved banana with a brown tip, a stem jutting out of the back of
-- the stock, and brown speckles over the yellow.
Builders.BananiniBurst = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local peel = skin(g, look(K, 250, 214, 60))
	local peelDark = look(K, 214, 170, 40)
	local flesh = look(K, 250, 242, 196)
	local brown = look(K, 112, 76, 40)
	local receiverLook = skin(g, look(K, 58, 50, 40))

	local function speckles(list)
		for _, at in ipairs(list) do
			g:ball("Speckle", 3.4, CF(at[1], at[2], at[3]), brown)
		end
	end

	local receiver = arChassis(g, K, {}, {
		receiver = receiverLook,
		lower = receiverLook,
		furniture = peel,
		small = brown,
		stock = function(g)
			g:cyl("BufferTube", 177, 30, CF(0, -3, 191.5), receiverLook)
			g:at(CF(0, 0, 205), function()
				g:rounded("Stock", V(40, 42, 150), CF(0, -3, 0), 16, peel)
				g:wedge("StockWeb", V(34, 76, 130), CF(0, -60, 10) * A(0, 0, 180), peel)
				g:rounded("Buttpad", V(44, 20, 128), CF(0, -38, 83) * A(90, 0, 0), 8, brown)
				-- The stem, out of the back of the stock's top.
				g:cyl("BananaStem", 34, 12, CF(0, 8, 90) * A(-20, 0, 0), brown)
				g:cyl("BananaStemEnd", 6, 15, CF(0, 14, 106) * A(-20, 0, 0), look(K, 70, 50, 30))
				speckles({ { 20.5, 0, -40 }, { 20.5, -10, 10 }, { -20.5, 4, -20 }, { -20.5, -12, 30 }, { 17, -40, 20 } })
			end)
		end,
		handguard = function(g, info)
			g:at(CF(0, -4, info.z), function()
				-- The fruit round the barrel, then four peel strips, each in three pieces curling out further
				-- toward the front.
				g:cyl("HandguardFruit", info.length, 40, CF(0, 0, 0), flesh)
				g:cyl("HandguardPeel", info.length * 0.5, 45, CF(0, 0, info.length * 0.25), peel)
				for index = 0, 3 do
					local angle = (index + 0.5) / 4 * math.pi * 2
					for piece = 0, 2 do
						local z = -info.length * 0.08 - piece * info.length * 0.16
						local out = 23 + piece * 3.5
						g:box("HandguardPeel", V(26, 3.5, info.length * 0.17), CFrame.Angles(0, 0, angle) * CF(0, out, z) * A(-8 - piece * 7, 0, 0), piece == 2 and peelDark or peel)
					end
				end
				speckles({ { 22.8, 3, info.length * 0.3 }, { -22.8, -4, info.length * 0.15 }, { 0, -22.8, info.length * 0.35 } })
			end)
			g:rail("HandguardRail", 90, CF(0, 21 - 4, info.z + info.length * 0.25))
		end,
		supportHand = function(g, info)
			-- A small banana for a vertical grip, hung from the peel collar.
			local z = info.z - info.length * 0.14
			g:box("ForeGripClamp", V(30, 12, 34), CF(0, -4 - 22.5 - 6, z), brown)
			g:at(CF(0, -4 - 22.5 - 12, z) * A(-8, 0, 0), function()
				g:rounded("ForeGrip", V(28, 30, 60), CF(0, -30, -2) * A(90, 0, 0), 12, peel)
				g:rounded("ForeGrip", V(24, 26, 24), CF(0, -64, -8) * A(70, 0, 0), 10, peel)
				g:cylY("ForeGripTip", 8, 12, CF(0, -80, -12), brown)
			end)
			g:hand("SupportHand", V(-27, -80, z + 6), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))
		end,
		muzzle = function(g, barrelEnd)
			-- The flower end of the banana: a brown cap round the muzzle.
			g:cyl("MuzzleBrake", 26, 24, CF(0, 0, barrelEnd - 13), brown)
			g:cyl("MuzzleTip", 8, 16, CF(0, 0, barrelEnd - 30), look(K, 70, 50, 30))
			g:cyl("Bore", FINE, 9, CF(0, 0, barrelEnd - 34 - FINE / 2), F.bore)
			return barrelEnd - 35
		end,
		mag = function(g)
			g:magazine("Magazine", { width = 22.5, depth = 62, segments = { { 62, 0 }, { 24, 6 }, { 24, 6 }, { 24, 6 }, { 24, 6 } }, caliber = 9.5, plate = brown },
				CF(0, -52, -57), peel)
			speckles({ { 11.6, -70, -60 }, { -11.6, -95, -50 }, { 11.6, -120, -38 } })
		end,
		sights = function(g, railTop)
			local h = g:holo(CF(0, railTop, -30))
			g:key("Sight", CF(0, railTop + h, 50))
			g.model:SetAttribute("Optic", "holo")
			g.model:SetAttribute("EyeRelief", 0.62)
		end,
	})
	g.model:SetAttribute("Flair", "peel")
	g.model:SetAttribute("ShotCue", "GunshotBanana")
	return receiver
end

--------------------------------------------------------------------------------
-- Rare: Grass Toucher DMR -- the lawn rifle
--------------------------------------------------------------------------------

-- An M14 that has been outside: turf growing along its stock with daisies in it, a ladybird on the scope,
-- and the watering can's rose screwed on for a muzzle.
Builders.GrassToucherDMR = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local turf = K.finishOf(rgb(86, 150, 64), K.Mat.Grass)
	local blade = look(K, 110, 176, 70)
	local petal = look(K, 250, 250, 246)
	local centre = look(K, 250, 204, 50)
	local ladybird = look(K, 214, 40, 36)
	local tin = metal(K, 110, 150, 120, 0.1)

	local receiver = stock(g, K, { woodFurniture = true, laser = true })
	strip(g, { "^MuzzleBrake", "^MuzzleProng", "^BayonetLug", "^FrontSight" })
	paint(g, { { "^Receiver", skin(g, metal(K, 70, 84, 64)) } })

	-- Turf along the butt, grass blades standing out of it, three daisies.
	g:box("Turf", V(40, 7, 230), CF(0, -2.5, 305), turf)
	g:detail(function()
		for index = 0, 13 do
			local x = ((index * 7) % 5 - 2) * 7
			g:box("GrassBlade", V(2, 10, 2), CF(x, 5.5, 200 + index * 16) * A((index % 3 - 1) * 12, 0, (index % 2 == 0) and 10 or -10), blade)
		end
	end)
	for index, at in ipairs({ { -10, 3, 230 }, { 12, 3, 300 }, { -6, 3, 380 } }) do
		g:at(CF(at[1], at[2], at[3]), function()
			g:cylY("DaisyStem", 20, 2.6, CF(0, 7, 0), blade)
			for p = 0, 7 do
				local angle = p / 8 * math.pi * 2
				g:ball("DaisyPetal", 8, CF(math.cos(angle) * 7, 18, math.sin(angle) * 7), petal)
			end
			g:ball("DaisyCentre", 8, CF(0, 19, 0), centre)
		end)
	end
	-- A ladybird on top of the scope's tube.
	g:at(CF(0, 44.5 + 46 + 15, -40), function()
		g:ball("Ladybird", 12, CF(0, 2, 0), ladybird)
		g:ball("LadybirdHead", 6, CF(0, 1, -7), F.shadow)
		for _, spot in ipairs({ { 3, 7, 2 }, { -3, 7, -1 }, { 0, 7.6, 3 } }) do
			g:ball("LadybirdSpot", 2.4, CF(spot[1], spot[2], spot[3]), F.shadow)
		end
	end)
	-- The rose: a collar, a cone stepping out, and the face pricked with holes.
	g:cyl("RoseCollar", 16, 24, CF(0, 0, -568), tin)
	g:cyl("Rose", 12, 34, CF(0, 0, -582), tin)
	g:cyl("Rose", 12, 46, CF(0, 0, -594), tin)
	g:cyl("RoseFace", 3, 48, CF(0, 0, -601.5), tin)
	g:detail(function()
		for ring = 1, 2 do
			for index = 0, ring * 6 - 1 do
				local angle = index / (ring * 6) * math.pi * 2
				g:cyl("RoseHole", 2, 3, CF(math.cos(angle) * ring * 9, math.sin(angle) * ring * 9, -603.5), F.bore)
			end
		end
	end)
	g:cyl("Bore", 2, 7, CF(0, 0, -603.5), F.bore)
	g:key("Muzzle", CF(0, 0, -604))

	g.model:SetAttribute("Flair", "sniff")
	g.model:SetAttribute("ShotCue", "GunshotLawn")
	return receiver
end

--------------------------------------------------------------------------------
-- Rare: Sigma Scout -- the grindset rifle
--------------------------------------------------------------------------------

-- Gym steel: a chrome receiver, black knurled furniture, a barbell's plates slid on over the handguard, a
-- dumbbell handle for a vertical grip, a protein shaker clipped where a light would go, and a kettlebell
-- hanging off the sling loop.
Builders.SigmaScout = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local chrome = skin(g, metal(K, 188, 192, 198, 0.2))
	local knurl = look(K, 34, 34, 38, K.Mat.Plastic)
	local plate = look(K, 30, 30, 34, K.Mat.Rubber)
	local rim = look(K, 236, 236, 236)
	local shaker = look(K, 240, 110, 40)
	local iron = metal(K, 52, 54, 58)

	local receiver = arChassis(g, K, { scale = 1.12, hgLength = 250, barrelEnd = -470, barrelDia = 19, action = "semi" }, {
		receiver = chrome,
		lower = chrome,
		furniture = knurl,
		small = iron,
		stock = function(g)
			g:cyl("BufferTube", 177, 30, CF(0, -3, 191.5), iron)
			g:at(CF(0, 0, 205), function()
				g:rounded("Stock", V(40, 42, 150), CF(0, -3, 0), 13, knurl)
				g:wedge("StockWeb", V(34, 76, 130), CF(0, -60, 10) * A(0, 0, 180), knurl)
				g:rounded("Buttpad", V(44, 20, 128), CF(0, -38, 83) * A(90, 0, 0), 8, F.rubber)
				for index = 0, 5 do
					g:box("StockKnurl", V(41, 3, 3), CF(0, 6, -50 + index * 18), iron)
				end
				-- The kettlebell under the heel.
				g:box("KettlebellLoop", V(4, 12, 14), CF(0, -99, 60), chrome)
				arc(g, K, "KettlebellHandle", CF(0, -116, 60), 8, -80, 80, 8, 3.5, 3.5, iron)
				g:ball("Kettlebell", 26, CF(0, -134, 60), iron)
			end)
		end,
		handguard = function(g, info)
			g:at(CF(0, -4, info.z), function()
				-- The bar: a knurled steel sleeve, collars, and two plates with white rims.
				g:cyl("Handguard", info.length, 44, CF(0, 0, 0), chrome)
				g:detail(function()
					for index = 0, 9 do
						g:cyl("HandguardKnurl", 3, 45.5, CF(0, 0, -info.length / 2 + 60 + index * 9), iron)
					end
				end)
				for _, z in ipairs({ -info.length / 2 + 22, -info.length / 2 + 40 }) do
					g:cyl("WeightPlate", 12, 82, CF(0, 0, z), plate)
					g:cyl("WeightPlateRim", 13, 84, CF(0, 0, z), rim)
					g:cyl("WeightPlateHub", 14, 50, CF(0, 0, z), chrome)
				end
				g:cyl("HandguardCollar", 10, 52, CF(0, 0, -info.length / 2 + 52), iron)
			end)
			g:rail("HandguardRail", 80, CF(0, 18, info.z + 50))
		end,
		supportHand = function(g, info)
			-- The dumbbell grip: a clamp, a knurled handle and a hex head at the bottom.
			local z = info.z - info.length * 0.14
			g:box("ForeGripClamp", V(30, 12, 34), CF(0, -4 - 22 - 6, z), iron)
			g:at(CF(0, -4 - 22 - 12, z) * A(-8, 0, 0), function()
				g:cylY("ForeGrip", 70, 28, CF(0, -35, 0), chrome)
				g:detail(function()
					for index = 0, 4 do
						g:cylY("ForeGripKnurl", 2.5, 29.5, CF(0, -12 - index * 11, 0), iron)
					end
				end)
				g:cylY("ForeGripWeight", 16, 44, CF(0, -76, 0), plate)
			end)
			g:hand("SupportHand", V(-27, -80, z + 6), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))
			-- The protein shaker on the left, capped.
			g:box("ShakerStrap", V(8, 34, 12), CF(-30, 4, info.front + 70), iron)
			g:cyl("Shaker", 90, 30, CF(-37.5, 0, info.front + 50), shaker)
			g:cyl("ShakerCap", 16, 32, CF(-37.5, 0, info.front + 2), rim)
			g:cyl("ShakerSpout", 8, 12, CF(-37.5, 0, info.front - 10), rim)
		end,
		muzzle = function(g, barrelEnd, barrelDia)
			return barrelEnd + g:brake(CF(0, 0, barrelEnd), barrelDia + 9, 64)
		end,
		mag = function(g)
			g:magazine("Magazine", { width = 24, depth = 70, segments = { { 64, 0 }, { 30, 3 }, { 30, 3 } }, ribs = "stanag", caliber = 10.5, plate = chrome },
				CF(0, -52, -57), iron)
		end,
		sights = function(g, railTop)
			local h = g:scope(CF(0, railTop, -15), "lpvo")
			g:key("Sight", CF(0, railTop + h, 150))
			g.model:SetAttribute("Optic", "scope")
			g.model:SetAttribute("EyeRelief", 0.6)
		end,
	})
	g.model:SetAttribute("Flair", "curl")
	g.model:SetAttribute("ShotCue", "GunshotSigma")
	return receiver
end

--------------------------------------------------------------------------------
-- Rare: Prato Prato Pium -- the picnic scout
--------------------------------------------------------------------------------

-- A scout rifle for a day in the meadow: a wicker stock, a red-and-white gingham handguard, a flower
-- round the muzzle, and a butterfly resting on the scope.
Builders.TouchGrassScout = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local field = skin(g, look(K, 80, 106, 64))
	local wicker = look(K, 206, 164, 100, K.Mat.Fabric)
	local wickerDark = look(K, 150, 110, 60)
	local red = look(K, 206, 50, 50, K.Mat.Fabric)
	local white = look(K, 246, 244, 236, K.Mat.Fabric)
	local pink = look(K, 250, 140, 190)
	local yellow = look(K, 250, 214, 60)
	local wingA, wingB = look(K, 255, 150, 40), look(K, 80, 150, 250)

	local receiver = arChassis(g, K, { scale = 1.12, hgLength = 250, barrelEnd = -470, barrelDia = 19, action = "semi" }, {
		receiver = field,
		lower = field,
		furniture = wicker,
		small = wickerDark,
		stock = function(g)
			g:cyl("BufferTube", 177, 30, CF(0, -3, 191.5), field)
			g:at(CF(0, 0, 205), function()
				g:rounded("Stock", V(40, 42, 150), CF(0, -3, 0), 13, wicker)
				g:wedge("StockWeb", V(34, 76, 130), CF(0, -60, 10) * A(0, 0, 180), wicker)
				g:rounded("Buttpad", V(44, 20, 128), CF(0, -38, 83) * A(90, 0, 0), 8, wickerDark)
				-- The weave: strands crossing on both sides.
				g:detail(function()
					for _, sx in ipairs(SIGNS) do
						for index = 0, 5 do
							g:box("StockWeave", V(FINE * 2, 3, 46), CF(sx * 20.2, -3, -54 + index * 20) * A(35, 0, 0), wickerDark)
							g:box("StockWeave", V(FINE * 2, 3, 46), CF(sx * 20.2, -3, -44 + index * 20) * A(-35, 0, 0), wickerDark)
						end
					end
				end)
			end)
		end,
		handguard = function(g, info)
			g:at(CF(0, -4, info.z), function()
				g:rounded("Handguard", V(44, 46, info.length), CF(0, 0, 0), 12, red)
				-- The gingham: white squares on both sides and the bottom in a check.
				g:detail(function()
					for row = 0, 2 do
						for col = 0, 9 do
							if (row + col) % 2 == 0 then
								for _, sx in ipairs(SIGNS) do
									g:box("HandguardCheck", V(FINE * 2, 10, 20), CF(sx * 22.2, -12 + row * 12, -info.length / 2 + 20 + col * 23), white)
								end
							end
						end
					end
				end)
			end)
			g:rail("HandguardRail", 90, CF(0, 19, info.z + 60))
		end,
		muzzle = function(g, barrelEnd, barrelDia)
			local z = barrelEnd + g:brake(CF(0, 0, barrelEnd), barrelDia + 9, 64)
			-- The flower: petals round the brake's collar.
			for index = 0, 7 do
				local angle = index / 8 * math.pi * 2
				g:ball("Petal", 11, CF(math.cos(angle) * 17, math.sin(angle) * 17, barrelEnd - 6), pink)
			end
			g:cyl("PetalCentre", 6, 32, CF(0, 0, barrelEnd - 4), yellow)
			return z
		end,
		mag = function(g)
			g:magazine("Magazine", { width = 24, depth = 70, segments = { { 64, 0 }, { 30, 3 }, { 30, 3 } }, ribs = "stanag", caliber = 10.5, plate = wickerDark },
				CF(0, -52, -57), field)
		end,
		sights = function(g, railTop)
			local h = g:scope(CF(0, railTop, -15), "lpvo")
			g:key("Sight", CF(0, railTop + h, 150))
			g.model:SetAttribute("Optic", "scope")
			g.model:SetAttribute("EyeRelief", 0.6)
			-- The butterfly on the scope's saddle, wings up.
			g:at(CF(0, railTop + h + 16.5, -30), function()
				g:box("ButterflyBody", V(3, 3, 16), CF(0, 0, 0), F.shadow)
				for _, sx in ipairs(SIGNS) do
					g:box("ButterflyWing", V(1.2, 16, 14), CF(sx * 6, 7, -3) * A(0, 0, -sx * 30), wingA)
					g:box("ButterflyWing", V(1.2, 11, 10), CF(sx * 5, 5, 7) * A(0, 0, -sx * 40), wingB)
				end
			end)
		end,
	})
	g.model:SetAttribute("Flair", "breeze")
	g.model:SetAttribute("ShotCue", "GunshotMeadow")
	return receiver
end

--------------------------------------------------------------------------------
-- Rare: Aura Scattergun -- the halo shotgun
--------------------------------------------------------------------------------

-- Pearl-white and lilac, with halos of light round the handguard and the choke, feathered wings folded
-- along the stock, and a crystal drum with a glowing core.
Builders.AuraScattergun = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local pearl = skin(g, look(K, 238, 234, 246, K.Mat.SmoothPlastic, 0.2))
	local lilac = look(K, 186, 156, 232)
	local halo = neon(K, 255, 236, 150)
	local feather = look(K, 250, 250, 255)
	local crystal = glass(K, 200, 180, 255, 0.45)
	local core = neon(K, 200, 140, 255)

	local receiver = arChassis(g, K, { scale = 1.18, hgLength = 230, barrelEnd = -420, barrelDia = 22, action = "semi", flash = "shotgun", casing = "shell" }, {
		receiver = pearl,
		lower = pearl,
		furniture = lilac,
		small = look(K, 200, 170, 90, K.Mat.Metal),
		stock = function(g)
			g:cyl("BufferTube", 177, 30, CF(0, -3, 191.5), pearl)
			g:at(CF(0, 0, 205), function()
				g:rounded("Stock", V(40, 42, 150), CF(0, -3, 0), 13, lilac)
				g:wedge("StockWeb", V(34, 76, 130), CF(0, -60, 10) * A(0, 0, 180), lilac)
				g:rounded("Buttpad", V(44, 20, 128), CF(0, -38, 83) * A(90, 0, 0), 8, pearl)
				-- Wings folded back along the stock, three feathers a side.
				for _, sx in ipairs(SIGNS) do
					for index = 0, 2 do
						g:wedge("WingFeather", V(3, 38 - index * 7, 120 - index * 18), CF(sx * 21.5, 10 - index * 12, 18 + index * 10) * A(0, 0, sx * 12), feather)
					end
				end
			end)
		end,
		handguard = function(g, info)
			g:at(CF(0, -4, info.z), function()
				g:rounded("Handguard", V(44, 48, info.length), CF(0, 0, 0), 14, pearl)
				for index = 0, 2 do
					g:shell("Halo", 5, 58, 3, CF(0, 0, -info.length / 2 + 40 + index * 60), halo, 14)
				end
			end)
			g:rail("HandguardRail", 90, CF(0, 20, info.z + 50))
		end,
		supportHand = function(g, info)
			local z = info.z - info.length * 0.14
			g:foregrip(CF(0, -4 - 25, z))
			g:hand("SupportHand", V(-27, -80, z + 6), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))
		end,
		muzzle = function(g, barrelEnd, barrelDia)
			g:cyl("MuzzleBrake", 36, barrelDia + 5, CF(0, 0, barrelEnd - 18), pearl)
			g:shell("MuzzleHalo", 4, barrelDia + 22, 3, CF(0, 0, barrelEnd - 26), halo, 14)
			for _, sx in ipairs(SIGNS) do
				g:box("MuzzleHaloSpoke", V(8, 3, 3), CF(sx * (barrelDia / 2 + 6.5), 0, barrelEnd - 26), pearl)
			end
			g:cyl("Bore", FINE, barrelDia - 3, CF(0, 0, barrelEnd - 36 - FINE / 2), F.bore)
			return barrelEnd - 38
		end,
		mag = function(g)
			-- The crystal drum, and the core glowing inside it.
			g:at(CF(0, -52, -57), function()
				g:box("Magazine", V(20, 42, 34), CF(0, -21, 0), pearl)
				local centre = CF(0, -42 - 85 + 8, -2)
				g:cylX("Magazine", 64, 170, centre, crystal)
				g:cylX("MagazineCore", 50, 60, centre, core)
				for _, sx in ipairs(SIGNS) do
					g:cylX("MagazineRim", 4, 174, centre * CF(sx * 33, 0, 0), pearl)
				end
			end)
		end,
		sights = function(g, railTop)
			local h = g:holo(CF(0, railTop, -30))
			g:key("Sight", CF(0, railTop + h, 50))
			g.model:SetAttribute("Optic", "holo")
			g.model:SetAttribute("EyeRelief", 0.62)
		end,
	})
	g.model:SetAttribute("Flair", "halo")
	g.model:SetAttribute("ShotCue", "GunshotAura")
	return receiver
end

--------------------------------------------------------------------------------
-- Epic: Glitch SMG -- the one that did not load properly
--------------------------------------------------------------------------------

-- Built out of voxels and not quite in sync with itself: a black body with its colour channels split off
-- either side (a magenta ghost up and left, a cyan one down and right), a staircase of pixels down its back,
-- a stock still wearing the missing-texture checker, a drum that is a pixel circle, and a square muzzle with
-- a lit core. Every hit it lands arrives twice (WeaponData `echo`).
Builders.GlitchSMG = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local body = skin(g, look(K, 26, 24, 34))
	local magenta = neon(K, 255, 70, 220)
	local cyan = neon(K, 70, 240, 255)
	local violet = look(K, 90, 60, 160)
	local checkA, checkB = look(K, 255, 0, 220), look(K, 12, 12, 14)

	local receiver = smgChassis(g, K, {
		metal = body,
		furniture = violet,
		tube = body,
		endCap = body,
		receiverDress = function(g)
			-- The split: a sliver of each colour channel standing off the sides, out of register.
			-- Scanlines of each channel, broken where the signal drops.
			for index, line in ipairs({ { 12, 180, 30 }, { 4, 120, -60 }, { -6, 210, 20 }, { -14, 90, 90 } }) do
				g:box("ChannelSplit", V(FINE * 2, 3, line[2]), CF(-15.2 - FINE, line[1] + 2, line[3]), magenta)
				g:box("ChannelSplit", V(FINE * 2, 3, line[2] * 0.8), CF(15.2 + FINE, line[1] - 3, line[3] + 14), cyan)
			end
			-- A staircase of pixels down the back of the receiver.
			g:detail(function()
				for index = 0, 5 do
					for _, sx in ipairs(SIGNS) do
						g:box("Pixel", V(8, 8, 8), CF(sx * 11, 20 + index * 0 + 4, 70 + index * 14) * CF(0, -index * 2.5, 0), index % 2 == 0 and magenta or cyan)
					end
				end
			end)
		end,
		sights = function(g)
			g:box("ClawRail", V(28, 12, 140), CF(0, 27, 40), body)
			g:rail("OpticRail", 132, CF(0, 33, 40))
			local h = g:holo(CF(0, 42.5, 30))
			g:key("Sight", CF(0, 42.5 + h, 110))
			g.model:SetAttribute("Optic", "holo")
			g.model:SetAttribute("EyeRelief", 0.6)
		end,
		front = function(g)
			g:cyl("Barrel", 150, 15, CF(0, 0, -215), F.nitride)
			-- A blocky handguard, its sides split into channels too.
			g:rounded("Handguard", V(42, 40, 124), CF(0, -8, -205), 12, body)
			-- Only its upper half split, where the hand does not close.
			for _, sx in ipairs(SIGNS) do
				g:box("HandguardSplit", V(FINE * 2, 12, 110), CF(sx * (21 + FINE), sx &gt; 0 and 2 or 6, -205), sx &gt; 0 and cyan or magenta)
			end
			-- The square muzzle and its lit core, a few loose pixels stuck to its face.
			g:box("MuzzleBrake", V(26, 26, 20), CF(0, 0, -300), body)
			g:box("MuzzleCore", V(12, 12, 2), CF(0, 0, -311), cyan)
			g:box("Bore", V(8, 8, FINE), CF(0, 0, -312 - FINE / 2), F.bore)
			for index, at in ipairs({ { 9, 14, -304 }, { -14, -8, -298 }, { 15, -12, -292 } }) do
				g:box("Pixel", V(6, 6, 6), CF(at[1], at[2], at[3]), index % 2 == 0 and magenta or cyan)
			end
			return -313
		end,
		mag = function(g)
			-- The drum as a pixel circle: rows of blocks stepping out and back in, a feed tower above.
			g:at(CF(0, -44, -76), function()
				g:box("Magazine", V(20, 42, 34), CF(0, -21, 0), body)
				local centre = V(0, -42 - 50 + 8, -2)
				local rows = { 38, 64, 80, 90, 94, 94, 90, 80, 64, 38 }
				for index, width in ipairs(rows) do
					local y = centre.Y + 45 - (index - 0.5) * 9.5
					g:box("Magazine", V(56, 9.6, width), CF(0, y, centre.Z), index % 3 == 0 and violet or body)
				end
				for _, sx in ipairs(SIGNS) do
					g:box("MagazinePixel", V(FINE * 2, 18, 18), CF(sx * 28.2, centre.Y, centre.Z), sx &gt; 0 and cyan or magenta)
				end
			end)
		end,
		stock = function(g)
			-- A stepped pixel stock, its sides checked in the missing-texture magenta and black.
			g:at(CF(0, 0, 168), function()
				for index = 0, 3 do
					g:box("Stock", V(36, 34 + index * 12, 50), CF(0, -2 - index * 6, 25 + index * 50), violet)
				end
				g:box("Buttpad", V(40, 80, 12), CF(0, -22, 206), F.rubber)
				g:detail(function()
					for _, sx in ipairs(SIGNS) do
						for row = 0, 2 do
							for col = 0, 5 do
								g:box("StockChecker", V(FINE * 2, 10, 10), CF(sx * 18.2, 8 - row * 10, 40 + col * 20 + (row % 2) * 10), (row + col) % 2 == 0 and checkA or checkB)
							end
						end
					end
				end)
			end)
		end,
	})
	g.model:SetAttribute("Flash", "glitch")
	g.model:SetAttribute("Tracer", "glitch")
	g.model:SetAttribute("Flair", "glitch")
	g.model:SetAttribute("ShotCue", "GunshotGlitch")
	return receiver
end

--------------------------------------------------------------------------------
-- Epic: Camelo Vampire LMG -- the vampire camel
--------------------------------------------------------------------------------

-- The belt-fed gun of a camel that only comes out at night: black steel and crimson velvet, bat wings off
-- the barrel shroud, two humps on the stock, a coffin for an ammo box with a gold bat on its lid, and fangs
-- under the muzzle. Its lifesteal grows the longer the belt keeps landing (WeaponData `bloodthirst`).
Builders.CameloLMG = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local black = skin(g, metal(K, 30, 28, 32))
	local velvet = skin(g, look(K, 122, 18, 36, K.Mat.Fabric))
	local coffin = wood(K, 58, 34, 26)
	local gold = F.gold
	local fur = look(K, 196, 152, 100, K.Mat.Fabric)
	local wing = look(K, 40, 30, 44)
	local fang = look(K, 250, 248, 240)

	local receiver = stock(g, K, {})
	paint(g, {
		{ "^HandguardRail", black }, { "^Handguard", velvet }, { "^StockTube", black }, { "^Stock", velvet },
		{ "^Grip", velvet }, { "^Buttpad", black }, { "^MagazineBullet", F.copper }, { "^MagazineBelt", F.brass },
		{ "^MagazineLink", black }, { "^Magazine", coffin }, { "^Receiver", black }, { "^FeedCover", black },
		{ "^Shroud$", black }, { "^CarryHandleGrip", velvet },
	})

	-- The coffin: a raised lid rim, handles either end, the gold bat on its right side.
	g:group("mag", function()
		g:box("MagazineLidRim", V(84, 4, 124), CF(-14, -50.5, -110), gold)
		for _, sz in ipairs(SIGNS) do
			g:box("MagazineHandle", V(24, 6, 6), CF(-14, -96, -110 + sz * 63), gold)
		end
		g:at(CF(26.2, -95, -110), function()
			g:box("MagazineBat", V(FINE * 2, 10, 14), CF(0, 0, 0), gold)
			for _, sz in ipairs(SIGNS) do
				g:box("MagazineBatWing", V(FINE * 2, 8, 22), CF(0, 5, sz * 16) * A(sz * 25, 0, 0), gold)
			end
		end)
	end)
	-- The humps, fur-covered, on the stock behind the eye.
	for _, hump in ipairs({ { 190, 30 }, { 290, 24 } }) do
		g:rounded("Hump", V(34, hump[2], 70), CF(0, 12 + hump[2] / 2 - 2, hump[1]), hump[2] * 0.45, fur)
	end
	-- Bat wings fanned off both sides of the shroud.
	for _, sx in ipairs(SIGNS) do
		for index = 0, 2 do
			g:wedge("BatWing", V(3, 44 - index * 8, 86 - index * 14), CF(sx * (26 + index * 6), 12 - index * 6, -330 - index * 18) * A(0, 0, sx * (-70 + index * 12)), wing)
		end
		g:box("BatWingRoot", V(10, 14, 60), CF(sx * 22, 8, -330), black)
	end
	-- Fangs under the muzzle brake.
	for _, sx in ipairs(SIGNS) do
		g:wedge("Fang", V(5, 16, 8), CF(sx * 6, -19, -700) * A(0, 0, 180), fang)
	end

	g.model:SetAttribute("Flash", "blood")
	g.model:SetAttribute("Tracer", "blood")
	g.model:SetAttribute("Flair", "cape")
	g.model:SetAttribute("ShotCue", "GunshotVampire")
	return receiver
end

--------------------------------------------------------------------------------
-- Epic: Six-Seven Marksman -- the bank-shot rifle
--------------------------------------------------------------------------------

-- A long marksman rifle in basketball leather, black seams running round it, the stock carrying a lit
-- scoreboard that reads 6 7, and a hoop round the muzzle brake. Its shots bank off walls (WeaponData
-- `ricochet`).
local SEGMENTS = {
	-- Which of a seven-segment digit's bars are lit: top, upper right, lower right, bottom, lower left,
	-- upper left, middle.
	[6] = { true, false, true, true, true, true, true },
	[7] = { true, true, true, false, false, false, false },
}

local function digit(g, K, name, value, at, height, lk)
	local V, CF = K.V, K.CF
	local lit = SEGMENTS[value]
	local w, h, t = height * 0.55, height / 2, height * 0.12
	local bars = {
		{ V(0, h, 0), true }, { V(0, h / 2, -w / 2), false }, { V(0, -h / 2, -w / 2), false },
		{ V(0, -h, 0), true }, { V(0, -h / 2, w / 2), false }, { V(0, h / 2, w / 2), false }, { V(0, 0, 0), true },
	}
	g:at(at, function()
		for index, bar in ipairs(bars) do
			if lit[index] then
				local across = bar[2]
				g:box(name, across and V(K.FINE * 2, t, w) or V(K.FINE * 2, h, t), CF(bar[1]), lk)
			end
		end
	end)
end

Builders.SixSevenMarksman = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local ball = skin(g, look(K, 222, 110, 40, K.Mat.Rubber))
	local seam = look(K, 26, 22, 20)
	local board = look(K, 20, 20, 24)
	local lamp = neon(K, 255, 176, 60)
	local rim = metal(K, 230, 90, 30, 0.1)
	local net = fabric(K, 244, 244, 240)
	local steel = metal(K, 60, 62, 68)

	local receiver = arChassis(g, K, { scale = 1.12, hgLength = 330, barrelEnd = -600, barrelDia = 21, action = "semi", flash = "bank" }, {
		receiver = steel,
		lower = steel,
		furniture = ball,
		small = seam,
		stock = function(g)
			-- The precision stock, in leather, with the scoreboard set into each side.
			g:cyl("BufferTube", 60, 30, CF(0, -3, 133), steel)
			g:rounded("Stock", V(42, 44, 240), CF(0, -2, 222), 12, ball)
			g:prism("StockCheek", V(36, 16, 150), CF(0, 36, 230), 5, ball, "top")
			for _, z in ipairs({ 180, 280 }) do
				g:cylY("StockCheekPost", 12, 9, CF(0, 23, z), steel)
			end
			g:box("StockHook", V(32, 22, 176), CF(0, -82, 256), ball)
			g:box("StockHook", V(34, 60, 30), CF(0, -41, 326), ball)
			g:prism("Buttpad", V(46, 150, 18), CF(0, -38, 350), 4, F.rubber)
			for _, sx in ipairs(SIGNS) do
				g:box("Scoreboard", V(FINE * 2, 32, 70), CF(sx * 21.2, -2, 222), board)
				digit(g, K, "ScoreDigit", 6, CF(sx * (21.2 + FINE), -2, 222 + sx * 16), 22, lamp)
				digit(g, K, "ScoreDigit", 7, CF(sx * (21.2 + FINE), -2, 222 - sx * 16), 22, lamp)
			end
			-- The seams: a ring round the stock and one running its length.
			g:rounded("StockSeam", V(43.4, 45.4, 3), CF(0, -2, 160), 12.5, seam)
			g:box("StockSeam", V(3, 45.6, 200), CF(0, -2, 240), seam)
		end,
		handguard = function(g, info)
			g:at(CF(0, -4, info.z), function()
				g:cyl("Handguard", info.length, 46, CF(0, 0, 0), ball)
				for index = 0, 2 do
					g:cyl("HandguardSeam", 3, 47.4, CF(0, 0, -info.length / 2 + 50 + index * 110), seam)
				end
				g:box("HandguardSeam", V(3, 47.6, info.length - 20), CF(0, 0, 0), seam)
			end)
			g:rail("HandguardRail", 120, CF(0, 19, info.z + 60), steel)
		end,
		muzzle = function(g, barrelEnd, barrelDia)
			local z = barrelEnd + g:brake(CF(0, 0, barrelEnd), barrelDia + 9, 64)
			-- The hoop: an orange rim hung level under the brake on a bracket, a short white net below it.
			local hoop = barrelEnd - 36
			g:shell("Hoop", 5, 66, 4, CF(0, -26, hoop) * A(90, 0, 0), rim, 16)
			g:box("HoopBracket", V(8, 12, 40), CF(0, -21, barrelEnd - 16), rim)
			for index = 0, 5 do
				local angle = (index + 0.5) / 6 * math.pi * 2
				local top = V(math.cos(angle) * 29, -27, hoop + math.sin(angle) * 29)
				local bottom = V(math.cos(angle) * 18, -52, hoop + math.sin(angle) * 18)
				strut(g, K, "HoopNet", top, bottom, 2.4, net)
			end
			g:shell("HoopNetRing", 3, 40, 3, CF(0, -52, hoop) * A(90, 0, 0), net, 12)
			return z
		end,
		mag = function(g)
			g:magazine("Magazine", { width = 24, depth = 70, segments = { { 64, 0 }, { 30, 3 }, { 30, 3 } }, ribs = "stanag", caliber = 10.5, plate = seam },
				CF(0, -52, -57), ball)
		end,
		sights = function(g, railTop)
			local h = g:scope(CF(0, railTop, -15), "long")
			g:key("Sight", CF(0, railTop + h, 150))
			g.model:SetAttribute("Optic", "scope")
			g.model:SetAttribute("EyeRelief", 0.6)
		end,
		dress = function(g, info)
			g:bipod(CF(0, -4 - 23, info.front + 40))
		end,
	})
	g.model:SetAttribute("Tracer", "bank")
	g.model:SetAttribute("Flair", "dribble")
	g.model:SetAttribute("ShotCue", "GunshotBank")
	return receiver
end

--------------------------------------------------------------------------------
-- Epic: Piccolino Ratatatà -- L + RATIO
--------------------------------------------------------------------------------

-- Berry and pink: the stock is a big letter L, the suppressor ends in a plus sign, and the drum is a speech
-- bubble with its three dots typing. Five quick hits ratio the target (WeaponData `ratio`).
Builders.RatioPDW = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local berry = skin(g, look(K, 114, 54, 82))
	local pink = look(K, 235, 150, 182)
	local white = look(K, 246, 244, 248)
	local dot = look(K, 150, 150, 160)
	local dark = look(K, 49, 44, 56)

	local receiver = smgChassis(g, K, {
		metal = berry,
		furniture = dark,
		tube = berry,
		suppressed = true,
		drum = true,
		flash = "ratio",
		sights = function(g)
			g:box("ClawRail", V(28, 12, 140), CF(0, 27, 40), berry)
			g:rail("OpticRail", 132, CF(0, 33, 40))
			local h = g:holo(CF(0, 42.5, 30))
			g:key("Sight", CF(0, 42.5 + h, 110))
			g.model:SetAttribute("Optic", "holo")
			g.model:SetAttribute("EyeRelief", 0.6)
		end,
		front = function(g)
			g:cyl("Suppressor", 330, 52, CF(0, -2, -305), berry)
			g:rounded("Handguard", V(56, 56, 120), CF(0, -2, -200), 26, dark)
			g:detail(function()
				for index = 0, 4 do
					g:cyl("SuppressorBand", 4, 55, CF(0, -2, -330 - index * 26), pink)
				end
			end)
			-- The plus: two white bars crossed on the can's end, clear of the bore.
			g:box("PlusBar", V(46, 12, 6), CF(0, -2, -473), white)
			g:box("PlusBar", V(12, 46, 6.4), CF(0, -2, -473), white)
			g:cyl("Bore", 2, 10, CF(0, -2, -477), F.bore)
			return -478
		end,
		mag = function(g)
			-- The speech bubble: a rounded white slab, its tail pointing back, three dots on each face.
			g:at(CF(0, -44, -76), function()
				g:box("Magazine", V(20, 42, 34), CF(0, -21, 0), dark)
				g:rounded("Magazine", V(56, 84, 110), CF(0, -86, -2), 22, white)
				g:wedge("MagazineTail", V(40, 26, 30), CF(0, -134, 44) * A(0, 180, 0) * A(-20, 0, 0), white)
				for _, sx in ipairs(SIGNS) do
					for index = -1, 1 do
						g:ball("MagazineDot", 13, CF(sx * 27, -86, -2 + index * 26), dot)
					end
				end
			end)
		end,
		stock = function(g)
			-- The L: a long upright bar and its foot, in pink, bolted to the end cap.
			g:box("StockYoke", V(30, 14, 20), CF(0, -2, 174), dark)
			g:rounded("Stock", V(30, 34, 180), CF(0, -4, 270), 10, pink)
			g:rounded("Stock", V(30, 110, 34), CF(0, -52, 345), 10, pink)
			g:rounded("Buttpad", V(34, 116, 10), CF(0, -52, 367), 4, F.rubber)
		end,
	})
	g.model:SetAttribute("Tracer", "ratio")
	g.model:SetAttribute("Flair", "ratio")
	g.model:SetAttribute("ShotCue", "GunshotRatio")
	return receiver
end

--------------------------------------------------------------------------------
-- Epic: Porta Porta Bonk -- the backrooms breacher
--------------------------------------------------------------------------------

-- Mono-yellow wallpaper and damp brown carpet, a fluorescent tube humming down its side, an EXIT sign on
-- the drum, a door frame round the muzzle -- and the stock is a door, knob and all. Its pellets land in the
-- shape of a doorway and shove what they hit (WeaponData `pattern`, `knockback`).
Builders.BackroomsBreacher = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local wallpaper = skin(g, look(K, 206, 186, 96))
	local stripe = look(K, 180, 160, 80)
	local carpet = look(K, 118, 98, 60, K.Mat.Fabric)
	local doorWood = wood(K, 150, 110, 70)
	local tube = neon(K, 240, 246, 220)
	local housing = look(K, 170, 172, 168)
	local exitGreen = neon(K, 60, 220, 110)
	local white = look(K, 246, 246, 246)

	local receiver = arChassis(g, K, { scale = 1.18, hgLength = 230, barrelEnd = -420, barrelDia = 22, action = "semi", flash = "breach", casing = "shell" }, {
		receiver = wallpaper,
		lower = carpet,
		furniture = carpet,
		small = F.brass,
		stock = function(g)
			g:cyl("BufferTube", 177, 30, CF(0, -3, 191.5), housing)
			-- The door: a flat panel standing on end with its frame, a brass knob on each side.
			g:at(CF(0, 0, 205), function()
				g:box("Stock", V(30, 130, 150), CF(0, -34, 20), doorWood)
				for _, sx in ipairs(SIGNS) do
					g:box("StockPanel", V(FINE * 2, 50, 56), CF(sx * 15.2, -8, 50), wood(K, 126, 90, 56))
					g:box("StockPanel", V(FINE * 2, 50, 56), CF(sx * 15.2, -64, 50), wood(K, 126, 90, 56))
					g:cylX("DoorKnob", 10, 6, CF(sx * 20, -36, -34), F.brass)
					g:ball("DoorKnob", 12, CF(sx * 26, -36, -34), F.brass)
				end
				g:rounded("Buttpad", V(34, 128, 12), CF(0, -34, 100), 4, F.rubber)
			end)
		end,
		handguard = function(g, info)
			g:at(CF(0, -4, info.z), function()
				g:rounded("Handguard", V(44, 48, info.length), CF(0, 0, 0), 8, wallpaper)
				g:detail(function()
					for _, sx in ipairs(SIGNS) do
						for index = 0, 7 do
							g:box("HandguardStripe", V(FINE * 2, 40, 3), CF(sx * 22.2, 0, -info.length / 2 + 20 + index * 27), stripe)
						end
					end
				end)
				-- The fluorescent tube in its housing along the left side.
				g:box("LightHousing", V(10, 22, info.length - 30), CF(-27, 4, 0), housing)
				g:box("LightTube", V(4, 10, info.length - 44), CF(-33.5, 4, 0), tube)
			end)
			g:rail("HandguardRail", 90, CF(0, 20, info.z + 50))
		end,
		supportHand = function(g, info)
			local z = info.z - info.length * 0.14
			g:foregrip(CF(0, -4 - 24, z))
			g:hand("SupportHand", V(-27, -80, z + 6), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))
		end,
		muzzle = function(g, barrelEnd, barrelDia)
			g:cyl("MuzzleBrake", 36, barrelDia + 5, CF(0, 0, barrelEnd - 18), housing)
			g:cyl("Bore", FINE, barrelDia - 3, CF(0, 0, barrelEnd - 36 - FINE / 2), F.bore)
			-- A door frame round the choke: jambs, lintel and threshold on a collar.
			g:box("DoorFrameCollar", V(barrelDia + 12, barrelDia + 12, 8), CF(0, 0, barrelEnd - 14), doorWood)
			for _, sx in ipairs(SIGNS) do
				g:box("DoorFrame", V(5, 56, 8), CF(sx * 18, 4, barrelEnd - 14), doorWood)
			end
			g:box("DoorFrame", V(41, 5, 8), CF(0, 34.5, barrelEnd - 14), doorWood)
			g:box("DoorFrame", V(41, 5, 8), CF(0, -26.5, barrelEnd - 14), doorWood)
			return barrelEnd - 38
		end,
		mag = function(g)
			g:at(CF(0, -52, -57), function()
				g:box("Magazine", V(20, 42, 34), CF(0, -21, 0), carpet)
				local centre = CF(0, -42 - 85 + 8, -2)
				g:cylX("Magazine", 64, 170, centre, wallpaper)
				for _, sx in ipairs(SIGNS) do
					g:cylX("MagazineCover", 3.5, 136, centre * CF(sx * 33.5, 0, 0), stripe)
					-- The EXIT sign on each face, its arrow pointing forward.
					g:box("ExitSign", V(4, 30, 64), centre * CF(sx * 36.5, 20, 0), exitGreen)
					g:box("ExitArrow", V(4.6, 6, 26), centre * CF(sx * 36.8, 20, 4), white)
					g:wedge("ExitArrowHead", V(4.6, 14, 12), centre * CF(sx * 36.8, 20, -14) * A(90, 0, 0), white)
				end
			end)
		end,
		sights = function(g, railTop)
			local h = g:holo(CF(0, railTop, -30))
			g:key("Sight", CF(0, railTop + h, 50))
			g.model:SetAttribute("Optic", "holo")
			g.model:SetAttribute("EyeRelief", 0.62)
		end,
	})
	g.model:SetAttribute("Tracer", "breach")
	g.model:SetAttribute("Flair", "knock")
	g.model:SetAttribute("ShotCue", "GunshotBreach")
	return receiver
end

--------------------------------------------------------------------------------
-- Shared by the top tiers: a heart, a chain
--------------------------------------------------------------------------------

-- A heart lying on a side face (`at`'s X is out of the face): two lobes and a turned square for the point.
local function heart(g, K, name, at, size, lk)
	local V, CF, A = K.V, K.CF, K.A
	g:at(at, function()
		for _, sz in ipairs(SIGNS) do
			g:ball(name, size * 0.56, CF(0, size * 0.14, sz * size * 0.22), lk)
		end
		g:box(name, V(size * 0.3, size * 0.56, size * 0.56), CF(0, -size * 0.12, 0) * A(45, 0, 0), lk)
	end)
end

-- A chain hanging between two points, sagging `sag` below the straight line, in `links` links.
local function chain(g, K, name, from, to, sag, links, lk)
	local previous = from
	for index = 1, links do
		local t = index / links
		local point = from:Lerp(to, t) - K.V(0, sag * 4 * t * (1 - t), 0)
		strut(g, K, name, previous, point, 3.2, lk, 2)
		previous = point
	end
end

--------------------------------------------------------------------------------
-- Legendary: Rizz Rifle -- the charmer
--------------------------------------------------------------------------------

-- Pearl and rose gold: a pink handguard with gold scrollwork and a rose tucked along its side, hearts set
-- in the receiver, a gold chain looped under the stock with a heart hanging from it, a gold muzzle. Its hits
-- charm: each one slows the target a little, three at a time (WeaponData `chill`, no freeze).
Builders.RizzRotary = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local pearl = skin(g, metal(K, 244, 236, 240, 0.2))
	local rose = skin(g, look(K, 236, 120, 160))
	local roseGold = metal(K, 232, 170, 150, 0.2)
	local petal = look(K, 214, 30, 60)
	local leaf = look(K, 70, 140, 70)

	local receiver = arChassis(g, K, {}, {
		receiver = pearl,
		lower = pearl,
		furniture = rose,
		small = roseGold,
		stock = function(g)
			g:cyl("BufferTube", 177, 30, CF(0, -3, 191.5), roseGold)
			g:at(CF(0, 0, 205), function()
				g:rounded("Stock", V(40, 42, 150), CF(0, -3, 0), 16, rose)
				g:wedge("StockWeb", V(34, 76, 130), CF(0, -60, 10) * A(0, 0, 180), rose)
				g:rounded("Buttpad", V(44, 20, 128), CF(0, -38, 83) * A(90, 0, 0), 8, pearl)
				-- The chain looped from the heel to the toe of the stock, a heart hanging at its lowest link.
				chain(g, K, "StockChain", V(21, -20, -40), V(21, -60, 60), 22, 9, F.gold)
				heart(g, K, "StockCharm", CF(23, -64, 12), 16, F.gold)
				heart(g, K, "StockHeart", CF(-20.4, -8, 0), 18, roseGold)
			end)
		end,
		handguard = function(g, info)
			g:at(CF(0, -4, info.z), function()
				g:rounded("Handguard", V(44, 48, info.length), CF(0, 0, 0), 14, rose)
				for _, sx in ipairs(SIGNS) do
					g:engraving(CF(sx * 22, 10, 30), info.length - 90, 14)
				end
				-- A rose along the left side: its stem, two leaves, the flower at the front.
				g:cyl("RoseStem", info.length * 0.5, 4, CF(-23.5, -6, info.length * 0.05), leaf)
				for _, z in ipairs({ -20, 30 }) do
					g:box("RoseLeaf", V(3, 8, 16), CF(-24.5, -2, z) * A(30, 0, 0), leaf)
				end
				g:at(CF(-27, -6, -info.length * 0.22), function()
					g:ball("RoseBloom", 16, CF(0, 0, 0), petal)
					for index = 0, 4 do
						local angle = index / 5 * math.pi * 2
						g:ball("RosePetal", 10, CF(-2, math.cos(angle) * 7, math.sin(angle) * 7), petal)
					end
				end)
			end)
			g:rail("HandguardRail", 100, CF(0, 20, info.z + 60), roseGold)
		end,
		supportHand = function(g, info)
			local z = info.z - info.length * 0.14
			g:foregrip(CF(0, -4 - 24, z))
			g:hand("SupportHand", V(-27, -80, z + 6), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))
		end,
		muzzle = function(g, barrelEnd)
			local z = barrelEnd + g:birdcage(CF(0, 0, barrelEnd), 22)
			paint(g, { { "^MuzzleBrake", roseGold }, { "^MuzzleProng", roseGold } })
			return z
		end,
		sights = function(g, railTop)
			local h = g:holo(CF(0, railTop, -30))
			g:key("Sight", CF(0, railTop + h, 50))
			g.model:SetAttribute("Optic", "holo")
			g.model:SetAttribute("EyeRelief", 0.62)
		end,
		dress = function(g)
			for _, sx in ipairs(SIGNS) do
				heart(g, K, "ReceiverHeart", CF(sx * 13.2, -33, 30), 14, roseGold)
			end
		end,
	})
	g.model:SetAttribute("Tracer", "heart")
	g.model:SetAttribute("Flair", "wink")
	g.model:SetAttribute("ShotCue", "GunshotRizz")
	return receiver
end

--------------------------------------------------------------------------------
-- Legendary: Scontrino Infinito Brrrrr -- the receipt printer
--------------------------------------------------------------------------------

-- A till that fires: a cream printer body with its receipt curling out of the right side of the feed cover,
-- a green price display on the left, charcoal furniture, and a cash drawer for an ammo box with coins
-- stacked on it. Every tenth hit in a run prints the total (WeaponData `receipt`).
Builders.ReceiptPrinterLMG = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local cream = skin(g, look(K, 214, 206, 178))
	local charcoal = skin(g, look(K, 57, 61, 64))
	local paper = look(K, 250, 250, 244)
	local ink = look(K, 60, 60, 70)
	local lcd = neon(K, 120, 255, 150)
	local drawer = look(K, 88, 96, 92)

	local receiver = stock(g, K, {})
	paint(g, {
		{ "^HandguardRail", charcoal }, { "^Handguard", charcoal }, { "^StockTube", charcoal }, { "^Stock", charcoal },
		{ "^Grip", charcoal }, { "^MagazineBullet", F.copper }, { "^MagazineBelt", F.brass }, { "^MagazineLink", ink },
		{ "^Magazine", drawer }, { "^Receiver", cream }, { "^FeedCover", cream },
	})

	-- The receipt: a paper strip leaving a slot in the cover's right edge and curling out and down.
	-- It leaves the slot low on the cover's side, so it stays out of the sight picture.
	g:box("PaperSlot", V(6, 4, 58), CF(26, 14, -70), ink)
	local previous = V(28, 14, -70)
	for index = 1, 9 do
		local angle = math.rad(index * 22)
		local point = V(28 + math.sin(angle) * 22, 14 + (1 - math.cos(angle)) * -22 + index * -3, -70)
		strut(g, K, "Receipt", previous, point, 50, paper, 1.4)
		if index % 2 == 0 then
			g:box("ReceiptLine", V(1.6, 1.6, 34), CF((previous + point) / 2) * CF(0.9, 0, 0), ink)
		end
		previous = point
	end
	-- The price display on the left.
	g:box("DisplayFrame", V(2, 22, 66), CF(-25.8, 4, -30), ink)
	g:box("Display", V(1.2, 14, 56), CF(-27, 4, -30), lcd)
	-- Coins on the cash drawer's lid, and the drawer's handle.
	g:group("mag", function()
		for index = 0, 3 do
			g:cylY("Coin", 3, 16, CF(-40, -47 + index * 3.1, -140), F.gold)
		end
		g:cylY("Coin", 3, 16, CF(-22, -47, -128), F.gold)
		g:box("DrawerHandle", V(36, 6, 8), CF(-14, -118, -174), ink)
	end)

	g.model:SetAttribute("Tracer", "cash")
	g.model:SetAttribute("Flair", "print")
	g.model:SetAttribute("ShotCue", "GunshotReceipt")
	return receiver
end

--------------------------------------------------------------------------------
-- Legendary: Patapim Chaingun -- the forest gatling
--------------------------------------------------------------------------------

-- A gatling that grew in a wood: the motor housing is bark with its ribs gone to moss, leaves sprout off the
-- carry handle and the housing, mushrooms on the drum of the box, a crown of leaves round the barrel clamp.
-- Its arcs are green (it keeps its chain).
Builders.PatapimChaingun = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local bark = skin(g, wood(K, 96, 66, 40))
	local moss = K.finishOf(rgb(86, 140, 60), K.Mat.Grass)
	local leafA, leafB = look(K, 96, 170, 70), look(K, 140, 196, 80)
	local crate = wood(K, 150, 110, 64)
	local cap, stem = look(K, 210, 60, 40), look(K, 238, 230, 210)

	local receiver = stock(g, K, {})
	paint(g, {
		{ "^Receiver", bark }, { "^HousingRib", moss }, { "^Magazine", crate }, { "^Gearbox", bark }, { "^Motor", bark },
		{ "^RearCap", bark }, { "^CarryHandleBar", bark },
	})
	-- Leaves: fans of blades off the housing's shoulders and the barrel clamp.
	local function leaves(at, count, size)
		g:at(at, function()
			for index = 0, count - 1 do
				local turn = (index - (count - 1) / 2) * 28
				g:box("Leaf", V(2, size, size * 0.45), CF(0, 0, 0) * A(0, 0, turn) * CF(0, size / 2, 0), index % 2 == 0 and leafA or leafB)
			end
		end)
	end
	for _, sx in ipairs(SIGNS) do
		leaves(CF(sx * 44, 36, -60) * A(0, 0, -sx * 40), 3, 34)
		leaves(CF(sx * 22, 18, -560) * A(0, 0, -sx * 55), 3, 22)
	end
	mushroom(g, K, CF(-110, -84, 40) * A(0, 0, 70), 14, 20, cap, stem, stem)
	mushroom(g, K, CF(-110, -110, -30) * A(0, 0, 80), 10, 14, cap, stem, nil)

	g.model:SetAttribute("Flash", "leaves")
	g.model:SetAttribute("Tracer", "vine")
	g.model:SetAttribute("Flair", "spinup")
	g.model:SetAttribute("ShotCue", "GunshotForest")
	return receiver
end

--------------------------------------------------------------------------------
-- Legendary: Nonna Double Barrel -- grandma's
--------------------------------------------------------------------------------

-- Grandma's: the engraved heirloom with a knitted cosy on the stock in her colours, a cameo on the side
-- plate, a lace doily tied round the wrist of the stock. Its shot lands in a heart (WeaponData `pattern`).
Builders.NonnaDoubleBarrel = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local wools = { look(K, 240, 170, 190, K.Mat.Fabric), look(K, 250, 236, 200, K.Mat.Fabric), look(K, 160, 200, 230, K.Mat.Fabric) }
	local lace = look(K, 250, 248, 240, K.Mat.Fabric)
	local ivory = look(K, 246, 236, 220)

	local receiver = stock(g, K, { engraved = true })
	-- The cosy: striped knit bands round the middle of the stock, a pompom on its end.
	for index = 0, 5 do
		g:rounded("StockCosy", V(44, 25, 18), CF(0, -41, 240 + index * 18) * A(-6, 0, 0), 9, wools[index % 3 + 1])
	end
	g:ball("StockPompom", 16, CF(0, -24, 346), wools[1])
	-- The doily at the wrist, its scalloped edge.
	g:rounded("Doily", V(40, 20, 8), CF(0, -16, 170), 8, lace)
	for index = 0, 7 do
		local angle = index / 8 * math.pi * 2
		g:ball("DoilyScallop", 6, CF(math.cos(angle) * 21, -16 + math.sin(angle) * 11, 170), lace)
	end
	-- The cameo on each side plate.
	for _, sx in ipairs(SIGNS) do
		g:cylX("Cameo", 3, 22, CF(sx * 24, -16, 10), F.gold)
		g:cylX("CameoFace", 1.6, 16, CF(sx * 25.8, -16, 10), ivory)
		heart(g, K, "CameoHeart", CF(sx * 26.8, -16, 10), 8, look(K, 214, 120, 140))
	end

	g.model:SetAttribute("Tracer", "heart")
	g.model:SetAttribute("Flair", "nonna")
	g.model:SetAttribute("ShotCue", "GunshotNonna")
	return receiver
end

--------------------------------------------------------------------------------
-- Mythic: Occhietto Pium Pium -- the auditor
--------------------------------------------------------------------------------

-- White titanium and violet: a clipboard clamped to the handguard with its checklist ticked green, a pen in
-- its clip, an APPROVED stamp for a buttpad, and a violet aura ring round the muzzle. Every eighth hit in a
-- run is audited: it arcs to two more people (WeaponData `audit`).
Builders.AuraAuditRifle = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local titanium = skin(g, metal(K, 214, 216, 220, 0.18))
	local violet = look(K, 150, 110, 230)
	local board = wood(K, 176, 136, 90)
	local paperLook = look(K, 250, 250, 246)
	local tick = neon(K, 90, 230, 120)
	local ink = look(K, 50, 50, 60)
	local stampRed = look(K, 200, 40, 50)
	local aura = neon(K, 190, 150, 255)

	local receiver = arChassis(g, K, {}, {
		receiver = titanium,
		lower = titanium,
		furniture = violet,
		small = F.gold,
		stock = function(g)
			g:cyl("BufferTube", 177, 30, CF(0, -3, 191.5), titanium)
			g:at(CF(0, 0, 205), function()
				g:rounded("Stock", V(40, 42, 150), CF(0, -3, 0), 13, violet)
				g:wedge("StockWeb", V(34, 76, 130), CF(0, -60, 10) * A(0, 0, 180), violet)
				-- The stamp: a wooden handle block and its red rubber face for a buttpad.
				g:rounded("Buttpad", V(44, 20, 128), CF(0, -38, 83) * A(90, 0, 0), 8, stampRed)
				g:box("StampBlock", V(40, 110, 10), CF(0, -38, 71), board)
			end)
		end,
		handguard = function(g, info)
			g:at(CF(0, -4, info.z), function()
				g:rounded("Handguard", V(44, 48, info.length), CF(0, 0, 0), 12, titanium)
				-- The clipboard on the right: the board, its clip, the sheet and a ticked checklist.
				g:box("Clipboard", V(3, 44, 120), CF(23.5, 0, 20), board)
				g:box("ClipboardClip", V(5, 10, 26), CF(25.5, 18, 20), F.steel)
				g:box("ClipboardSheet", V(1.2, 36, 104), CF(25.6, -3, 20), paperLook)
				for row = 0, 2 do
					g:box("ChecklistBox", V(1.4, 7, 7), CF(26.5, 8 - row * 11, 60), ink)
					g:box("ChecklistTick", V(1.8, 3, 8), CF(26.8, 8 - row * 11, 60) * A(40, 0, 0), tick)
					g:box("ChecklistLine", V(1.4, 2, 60), CF(26.5, 8 - row * 11, 20), ink)
				end
				g:cyl("Pen", 70, 6, CF(26, 22, -10), ink)
			end)
			g:rail("HandguardRail", 100, CF(0, 20, info.z + 60))
		end,
		supportHand = function(g, info)
			local z = info.z - info.length * 0.14
			g:foregrip(CF(0, -4 - 24, z))
			g:hand("SupportHand", V(-27, -80, z + 6), V(0.45, -0.1, -1), V(-1, 0.1, 0.4))
		end,
		muzzle = function(g, barrelEnd)
			local z = barrelEnd + g:birdcage(CF(0, 0, barrelEnd), 22)
			g:shell("AuraRing", 4, 42, 3, CF(0, 0, barrelEnd - 20), aura, 14)
			for _, sx in ipairs(SIGNS) do
				g:box("AuraRingSpoke", V(10, 3, 3), CF(sx * 15.5, 0, barrelEnd - 20), titanium)
			end
			return z
		end,
		sights = function(g, railTop)
			local h = g:holo(CF(0, railTop, -30))
			g:key("Sight", CF(0, railTop + h, 50))
			g.model:SetAttribute("Optic", "holo")
			g.model:SetAttribute("EyeRelief", 0.62)
		end,
	})
	g.model:SetAttribute("Tracer", "audit")
	g.model:SetAttribute("Flair", "stamp")
	g.model:SetAttribute("ShotCue", "GunshotAudit")
	return receiver
end

--------------------------------------------------------------------------------
-- Secret: Capo Supremo Bonkolone -- the admin's sidearm
--------------------------------------------------------------------------------

-- Black glass and mint light: a terminal prompt glowing down both sides of the slide, a grip of keycaps, and
-- a console under the nose where a light would be, cursor blinking. Its rounds noclip through one wall
-- (WeaponData `noclip`).
Builders.AdminOverride = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local glassBlack = skin(g, look(K, 20, 24, 26, K.Mat.SmoothPlastic, 0.2))
	local teal = skin(g, look(K, 30, 54, 50))
	local mint = neon(K, 126, 250, 200)
	local key = look(K, 46, 52, 54)
	local keyTop = look(K, 70, 78, 80)

	local receiver = pistolChassis(g, K, {
		frame = teal,
		slide = glassBlack,
		small = mint,
		guard = teal,
		slideBody = function(g, front, back)
			local body = g:prism("Slide", V(25.5, 22, back - front), CF(0, 1, (front + back) / 2), 3, glassBlack, "top")
			-- The prompt down each side: a chevron, an underscore cursor, and lines of output.
			g:detail(function()
				for _, sx in ipairs(SIGNS) do
					local x = sx * (12.75 + FINE)
					g:box("Prompt", V(FINE * 2, 2, 8), CF(x, 6, back - 20) * A(35, 0, 0), mint)
					g:box("Prompt", V(FINE * 2, 2, 8), CF(x, 2, back - 20) * A(-35, 0, 0), mint)
					g:box("Prompt", V(FINE * 2, 2, 10), CF(x, 0, back - 34), mint)
					for index = 0, 2 do
						g:box("PromptLine", V(FINE * 2, 1.6, 60 - index * 14), CF(x, -4 + index * 4, back - 80 + index * 7), mint)
					end
				end
			end)
			return body
		end,
		gripDress = function(g, length)
			-- Keycaps set in both flanks.
			for _, sx in ipairs(SIGNS) do
				for row = 0, 3 do
					for col = 0, 1 do
						g:box("Keycap", V(3, 12, 12), CF(sx * 13, -16 - row * 16, -8 + col * 14), key)
						g:box("KeycapTop", V(1.2, 9, 9), CF(sx * 15, -16 - row * 16, -8 + col * 14), keyTop)
					end
				end
			end
		end,
		under = function(g, front)
			-- The console: a slab on the rail, its screen and the blinking cursor.
			g:box("ConsoleMount", V(20, 6, 26), CF(0, -27, -58), teal)
			g:prism("Console", V(28, 22, 68), CF(0, -40, -80), 4, glassBlack)
			for _, sx in ipairs(SIGNS) do
				g:box("ConsoleScreen", V(FINE * 2, 14, 56), CF(sx * (14 + FINE), -40, -80), look(K, 16, 40, 34))
				g:box("ConsoleCursor", V(FINE * 2 + 0.4, 2, 6), CF(sx * (14 + FINE), -44, -64), mint)
			end
			g:cyl("ConsoleLens", FINE * 2, 10, CF(0, -40, -114 - FINE), mint)
		end,
		flash = "pistol",
	})
	g.model:SetAttribute("Tracer", "noclip")
	g.model:SetAttribute("Flair", "noclip")
	g.model:SetAttribute("ShotCue", "GunshotAdmin")
	return receiver
end

--------------------------------------------------------------------------------
-- Secret: Ultimo Bum -- the debt collector
--------------------------------------------------------------------------------

-- The collector's AK: burgundy wood, invoices stapled down the stock with PAST DUE across them in red, a
-- padlock through the magazine, a red stamp plate on the receiver. Every fifth hit in a run collects: a small
-- blast on the target (WeaponData `collect`).
Builders.FinalNotice = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local burgundy = skin(g, wood(K, 107, 40, 44))
	local stampRed = look(K, 210, 36, 40)
	local paperLook = look(K, 248, 246, 238)
	local ink = look(K, 50, 50, 56)

	local receiver = stock(g, K, { pattern = "ak", woodFurniture = true })
	paint(g, { { "^HandguardFerrule", F.nitride }, { "^HandguardRetainer", F.nitride }, { "^Handguard", burgundy }, { "^StockTang", F.nitride },
		{ "^Stock", burgundy }, { "^Grip", burgundy } })

	-- Invoices down both sides of the stock, each with its PAST DUE band and staple.
	for _, sx in ipairs(SIGNS) do
		for index = 0, 1 do
			g:at(CF(sx * (16 + FINE + index * 0.6), -8, 180 + index * 70) * A(sx * 0, 0, 0) * A(index == 0 and 6 or -5, 0, 0), function()
				g:box("Invoice", V(1.2, 30, 50), CF(0, 0, 0), paperLook)
				g:box("InvoiceStamp", V(1.6, 7, 40), CF(sx * 0.3, 2, 0) * A(-14, 0, 0), stampRed)
				g:box("InvoiceLine", V(1.6, 1.4, 34), CF(sx * 0.3, -8, 0), ink)
				g:box("Staple", V(2, 2, 10), CF(sx * 0.4, 12, -18), F.steel)
			end)
		end
	end
	-- The stamp plate on the receiver's left, and the padlock through the magazine.
	g:box("StampPlate", V(FINE * 2, 14, 48), CF(-15.3, -18, -20), stampRed)
	g:group("mag", function()
		g:box("Padlock", V(28, 22, 18), CF(0, -86, -94) * A(16, 0, 0), F.gold)
		arc(g, K, "PadlockShackle", CF(0, -76, -97) * A(16, 0, 0), 9, -90, 90, 7, 3.5, 3.5, F.steel)
		g:box("PadlockKeyhole", V(29.4, 5, 3), CF(0, -88, -94) * A(16, 0, 0), ink)
	end)

	g.model:SetAttribute("Tracer", "overdue")
	g.model:SetAttribute("Flair", "overdue")
	g.model:SetAttribute("ShotCue", "GunshotCollect")
	return receiver
end

--------------------------------------------------------------------------------
-- New guns (the gun rework): Zanzarino Pikpik, Tamburo Tung Tung, Bananerang
--------------------------------------------------------------------------------

-- The rounds they fire, as they look in flight (ThrowableModels.RoundBuilders). Optional, like this module.
pcall(function()
	local roundsModule = game:GetService("ReplicatedStorage"):WaitForChild("Shared"):FindFirstChild("GunModelsRounds")
	if roundsModule then
		require(roundsModule)
	end
end)

-- Rare: Zanzarino Pikpik -- a mosquito of a pistol. A tiger mosquito's black and white: the slide is its
-- thorax with a white line down the back and two red compound eyes at the nose, glassy wings swept back off
-- its shoulders, the needle of its proboscis for a barrel, six thin legs folded under the dust cover, the
-- grip its striped abdomen, and a drop of blood under the magazine. It fires darts that nose toward whoever
-- is nearly in line (Ballistics "mosquitoDart"), and the bite itches (WeaponData `bleed`).
Builders.ZanzarinoPikpik = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local black = skin(g, look(K, 40, 40, 46))
	local blackSoft = look(K, 58, 58, 64)
	local white = look(K, 238, 238, 232)
	local eye = K.finishOf(rgb(150, 24, 34), K.Mat.SmoothPlastic, 0.2)
	local wing = glass(K, 200, 224, 244, 0.55)
	local vein = look(K, 80, 90, 104)
	local needle = metal(K, 96, 98, 106, 0.1)
	local blood = K.finishOf(rgb(200, 26, 40), K.Mat.Glass, 0.2, 0.15)

	local receiver = pistolChassis(g, K, {
		frame = black,
		slide = black,
		small = blackSoft,
		guard = black,
		trigger = look(K, 200, 40, 50),
		casing = "none",
		muzzleZ = -175,
		slideBody = function(g, front, back)
			local body = g:prism("Slide", V(25.5, 22, back - front - 28), CF(0, 1, (front + back) / 2 + 14), 3, black, "top")
			-- The head, rounded, with its eyes.
			g:rounded("SlideNose", V(25.5, 22, 28), CF(0, 1, front + 14), 9, black)
			for _, sx in ipairs(SIGNS) do
				g:ball("Eye", 13, CF(sx * 11.5, 5, front + 13), eye)
			end
			-- The proboscis, on the bore: the needle and the two palps beside its root.
			g:cyl("Proboscis", 64, 4.5, CF(0, 0, front - 32), needle)
			for _, sx in ipairs(SIGNS) do
				g:cyl("Palp", 24, 3, CF(sx * 3.4, -1, front - 12), blackSoft)
			end
			-- The white line down the back, and the thorax's white bands.
			g:box("SlideLine", V(3, FINE * 2, 100), CF(0, 12 + FINE, -30), white)
			g:detail(function()
				for _, z in ipairs({ -56, -26 }) do
					g:prism("SlideBand", V(25.5 + FINE * 2, 22 + FINE * 2, 4), CF(0, 1, z), 3, white, "top")
				end
				for index = 0, 5 do
					g:box("SlideSerration", V(25.5 + FINE * 2, 12, 2), CF(0, -1, back - 8 - index * 4.5), blackSoft)
				end
			end)
			-- The wings: glassy blades from the shoulders, swept back and out and tipped up (a dihedral, so
			-- they read from the side too), a dark vein down each; the smaller hind pair behind them.
			for _, sx in ipairs(SIGNS) do
				for _, spec in ipairs({ { V(sx * 11, 11, -40), V(sx * 50, 24, 6), 24 }, { V(sx * 10, 11, -14), V(sx * 36, 19, 18), 14 } }) do
					local root, tip, width = spec[1], spec[2], spec[3]
					local frame = along((root + tip) / 2, tip - root) * A(0, 0, sx * 28)
					local length = (tip - root).Magnitude
					g:box("Wing", V(width, 1.2, length), frame, wing)
					g:box("WingVein", V(1.6, 0.8, length - 4), frame * CF(-sx * width * 0.15, 1, 0), vein)
				end
			end
			return body
		end,
		gripDress = function(g, length)
			-- The abdomen: white bands across both flanks, FINE-thin on the surface.
			for _, sx in ipairs(SIGNS) do
				for index = 0, 3 do
					g:box("GripStripe", V(FINE * 2, 7, 38), CF(sx * 12.6, -16 - index * 21, -1), white)
				end
			end
		end,
		mag = function(g, length)
			g:box("Magazine", V(19, length - 4, 32), CF(0, -length / 2 - 4, 2), blackSoft)
			g:prism("MagazinePlate", V(25, 7, 42), CF(0, -length - 3.5, 2), 2, black, "bottom")
			-- Today's catch, hanging under the plate.
			g:ball("BloodDrop", 14, CF(0, -length - 11, 6), blood)
		end,
		under = function(g, front)
			-- Six legs folded under the dust cover: a thigh out and a shin down on each side, three pairs.
			for _, z in ipairs({ -96, -80, -64 }) do
				for _, sx in ipairs(SIGNS) do
					local root, knee, foot = V(sx * 8, -21, z), V(sx * 22, -27, z - 6), V(sx * 26, -44, z - 14)
					strut(g, K, "Leg", root, knee, 3, blackSoft)
					strut(g, K, "Leg", knee, foot, 2.4, blackSoft)
					g:ball("LegKnee", 3.4, CF(knee), black)
				end
			end
		end,
	})
	g.model:SetAttribute("Flair", "buzz")
	g.model:SetAttribute("ShotCue", "GunshotPikpik")
	return receiver
end

--------------------------------------------------------------------------------
-- Epic: Tamburo Tung Tung -- the marching drum
--------------------------------------------------------------------------------

-- The six-shot revolving launcher turned out for the parade: its drum IS a marching drum -- a red shell
-- round the six tubes with a white band, brass hoops at both heads and brass tension rods between them,
-- the heads showing white inside the hoops -- the barrel in band navy with brass rings, a brass bell for a
-- muzzle, and two drumsticks (little bats) strapped crossed on the stock. It lobs three drumlets a shot
-- (Ballistics "drumlet") that bounce and go off.
Builders.TamburoTungTung = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local red = skin(g, look(K, 190, 34, 46))
	local navy = look(K, 36, 48, 104)
	local white = look(K, 246, 240, 226)
	local brass = metal(K, 214, 170, 78, 0.12)
	local stick = wood(K, 214, 176, 120)
	local grip = wood(K, 98, 60, 36)

	local receiver = stock(g, K, { sixShot = true })
	paint(g, {
		{ "^DrumPlate", white }, { "^DrumTube", navy }, { "^DrumAxle", brass }, { "^RoundNose", red }, { "^Crane", brass },
		{ "^Receiver", red }, { "^Frame", red }, { "^TopStrap", brass }, { "^Barrel$", navy }, { "^BarrelRib", brass },
		{ "^Stock", navy }, { "^Grip", grip }, { "^ForeGrip", grip }, { "^TriggerGuard", brass },
	})

	-- The drum, turning with the stock drum (its group) about the same axle.
	local axis = CF(0, -52, -145)
	g:group("drum", function()
		g:cyl("DrumShell", 244, 155, axis, red)
		g:detail(function()
			g:cyl("DrumShellBand", 16, 156.4, axis, white)
		end)
		for _, z in ipairs({ -16, -276 }) do
			g:shell("DrumHoop", 10, 156, 6, CF(0, -52, z), brass)
		end
		for index = 0, 5 do
			local angle = math.rad(30 + index * 60)
			local sx, cy = math.sin(angle), math.cos(angle)
			g:cyl("DrumRod", 250, 4, CF(sx * 80, -52 + cy * 80, -146), brass)
			g:box("DrumLug", V(8, 8, 22), CF(sx * 77.5, -52 + cy * 77.5, -146) * A(0, 0, -math.deg(angle)), brass)
		end
	end)

	-- The bell: three brass steps opening out past the barrel, the dark mouth in the last.
	g:cyl("Bell", 14, 64, CF(0, 0, -607), brass)
	g:cyl("Bell", 12, 80, CF(0, 0, -620), brass)
	g:cyl("Bell", 10, 96, CF(0, 0, -631), brass)
	g:cyl("BellMouth", FINE, 88, CF(0, 0, -636 - FINE / 2), F.bore)
	g:key("Muzzle", CF(0, 0, -640))

	-- The drumsticks, crossed on the stock's right side under a leather strap.
	for _, pair in ipairs({ { V(24.5, -22, 168), V(24.5, -62, 296) }, { V(24.5, -62, 168), V(24.5, -22, 296) } }) do
		rod(g, K, "Drumstick", pair[1], pair[2], 9, stick)
		g:ball("DrumstickTip", 13, CF(pair[2]), stick)
	end
	g:box("DrumstickStrap", V(8, 52, 12), CF(26, -42, 232), F.leather)

	g.model:SetAttribute("Flair", "drumroll")
	g.model:SetAttribute("ShotCue", "GunshotTamburo")
	return receiver
end

--------------------------------------------------------------------------------
-- Legendary: Bananerang -- the banana crossbow
--------------------------------------------------------------------------------

-- A crossbow gone bananas: each limb is a curved banana with its brown tip at the cam and its stalk at the
-- riser (the riser is the brown crown of the bunch), the receiver ripe yellow, the rail stalk-green, the
-- stock the pale flesh with the peel hanging down in strips either side. What sits on the rail is not a
-- bolt but a banana boomerang (Ballistics "bananerang"): thrown out, it comes back.
Builders.Bananerang = function(g, K)
	local V, CF, A, F, FINE = K.V, K.CF, K.A, K.F, K.FINE
	local yellow = skin(g, look(K, 250, 214, 60))
	local ripe = look(K, 236, 190, 40)
	local flesh = look(K, 250, 240, 200)
	local stalk = look(K, 120, 146, 60)
	local brown = look(K, 96, 66, 36)
	local crown = wood(K, 110, 80, 44)

	local receiver = stock(g, K, {})
	strip(g, { "^Limb$", "^Rocket" })
	paint(g, {
		{ "^Receiver", yellow }, { "^Rail", stalk }, { "^FlightGroove", brown }, { "^Riser", crown },
		{ "^Stock", flesh }, { "^Buttpad", ripe }, { "^BufferTube", ripe }, { "^Latch", brown }, { "^Grip", brown },
		{ "^ForeGrip", ripe }, { "^FingerGuard", ripe }, { "^TriggerGuard", brown },
	})

	-- A banana along a curve: joints as balls, spans as cylinders, fattest in the middle, brown at the tip.
	local function banana(name, p0, p1, p2, count, thin, fat, lk)
		local points = {}
		for index = 0, count do
			local t = index / count
			table.insert(points, p0 * ((1 - t) * (1 - t)) + p1 * (2 * (1 - t) * t) + p2 * (t * t))
		end
		local function width(t)
			return thin + (fat - thin) * math.sin(math.pi * t)
		end
		for index = 1, count do
			local t = (index - 0.5) / count
			rod(g, K, name, points[index], points[index + 1], width(t), index % 2 == 0 and ripe or lk)
			if index &lt; count then
				g:ball(name .. "Joint", width(index / count), CF(points[index + 1]), lk)
			end
		end
		return points, width
	end

	-- The limbs.
	for _, sx in ipairs(SIGNS) do
		local points, width = banana("BananaLimb", V(sx * 70, -8, -636), V(sx * 168, -8, -694), V(sx * 256, -8, -600), 8, 16, 36, yellow)
		g:ball("BananaTip", 16, CF(points[#points]), brown)
		g:detail(function()
			-- Freckles on the top of the skin, half sunk in it.
			for _, index in ipairs({ 3, 5, 7 }) do
				g:ball("BananaFreckle", 5, CF(points[index] + V(0, width((index - 1) / 8) / 2 - 1, 0)), brown)
			end
		end)
	end

	-- The boomerang on the rail (the round group: shown when loaded, carried in by the hand on a reload).
	g:group("round", function()
		local y = 14.5
		local elbow = V(0, y, -486)
		g:cylY("Bananerang", 9, 32, CF(elbow), yellow)
		for _, sx in ipairs(SIGNS) do
			local points = {}
			for index = 0, 4 do
				local t = index / 4
				table.insert(points, elbow * ((1 - t) * (1 - t)) + V(sx * 42, y, -448) * (2 * (1 - t) * t) + V(sx * 98, y, -378) * (t * t))
			end
			for index = 1, 4 do
				local a, c = points[index], points[index + 1]
				local width = 30 - index * 4
				strut(g, K, "Bananerang", a, c, width, index % 2 == 0 and ripe or yellow, 9)
				g:cylY("BananerangJoint", 9, width, CF(c), yellow)
			end
			g:ball("BananerangTip", 14, CF(points[5] + V(sx * 3, 0, 4)), brown)
		end
		g:cyl("BananerangStalk", 16, 8, CF(0, y, -506), stalk)
	end)

	-- The peel, in strips lying down either side of the stock from its top rear, their tips gone brown.
	for _, sx in ipairs(SIGNS) do
		for _, z in ipairs({ 318, 280 }) do
			local top, bottom = V(sx * 21.5, 12, z), V(sx * 21.5, -48, z - 50)
			local down = (bottom - top).Unit
			strut(g, K, "Peel", top, bottom, 3, yellow, 22)
			strut(g, K, "PeelTip", bottom, bottom + down * 10, 3, brown, 20)
		end
	end

	g.model:SetAttribute("Flair", "boomerang")
	g.model:SetAttribute("ShotCue", "GunshotBoomerang")
	return receiver
end

return GunModelsSignature
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">GunModelsWorkshop</string><ProtectedString name="Source">-- Workshop gun models: the shed-and-kitchen guns from WorkshopArsenal, in the spirit of the Bubble
-- Blaster -- a thing off a shelf that has been made to shoot.
--
-- GunModels.Build calls Builders[weaponId](g, Kit) for these ids instead of the style's stock builder, and
-- does everything after the build itself (the AimPoint, the z-fight pass, the Receiver, the Muzzle
-- attachment and the welds). `g` is GunModels' Builder: every size and position below is in millimetres,
-- the origin on the bore axis above the trigger, the gun facing -Z with +X to the right. Each builder
-- returns its receiver part.
--
-- Each gun keeps the animation contract of the mechanism it borrows (Action), with that mechanism's
-- keypoints, so the viewmodel's reload, rack and fire clips work unchanged:
--   belt    cover group (swings open) + charge group with travel, ChargeHand, CoverHand, a box magazine
--   bolt    bolt group with travel and swing, BoltHand, Eject, a box magazine
--   break   hinge group (the barrels swing down), Load and SupportHand riding it, a rib with a bead
--   lever   lever group (swings), hammer group, Load, a tube magazine
--   rotary  spin group turning about Pivot_spin (its X laid along the bore), a box magazine
--   semi    bolt and charge groups, Eject, a box magazine
-- Sights follow the ADS contract: KP_Sight on the line the eye looks along, with Optic and EyeRelief, and
-- nothing solid on that line. tools/ads_align_probe.lua, gun_contact_probe.lua and ads_hands_probe.lua
-- check every one.

local GunModelsWorkshop = {}

-- No variants yet: each workshop gun is one design.
GunModelsWorkshop.Variants = {}

local Builders = {}
GunModelsWorkshop.Builders = Builders

local SIGNS = { 1, -1 }

local function plastic(K, r, g, b)
	return K.finishOf(Color3.fromRGB(r, g, b), K.Mat.SmoothPlastic)
end

local function rough(K, r, g, b)
	return K.finishOf(Color3.fromRGB(r, g, b), K.Mat.Plastic)
end

local function fabric(K, r, g, b)
	return K.finishOf(Color3.fromRGB(r, g, b), K.Mat.Fabric)
end

-- A corrugated tube: a core with ribs round it every `pitch` mm, the way a blower or a vacuum hose reads.
local function corrugated(g, K, name, from, to, diameter, look, ribLook)
	local V, CF = K.V, K.CF
	local length = from - to
	g:cyl(name, length, diameter - 6, CF(0, 0, (from + to) / 2), look)
	local ribs = math.floor(length / 26)
	for index = 0, ribs - 1 do
		g:cyl(name .. "Rib", 9, diameter, CF(0, 0, from - 16 - index * 26), ribLook or look)
	end
end

-- A trigger in its guard, the swing the viewmodel pulls it through.
local function trigger(g, K, z, bottom, look, guardLook)
	local V, CF, A = K.V, K.CF, K.A
	g:box("TriggerGuard", V(12, 6, 58), CF(0, bottom - 3, z + 8), guardLook)
	g:box("TriggerGuard", V(12, 26, 6), CF(0, bottom + 10, z - 22), guardLook)
	g:group("trigger", function()
		g:box("Trigger", V(6, 18, 6), CF(0, bottom + 18, z) * A(-10, 0, 0), look)
	end)
	g:swing("trigger", CF(0, bottom + 26, z + 2), 12)
end

--------------------------------------------------------------------------------
-- Yard Work: a leaf blower fed from a leaf bag (belt mechanism, LMG keypoints)
--------------------------------------------------------------------------------

Builders.YardWorkBlower = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local shell = g.skinned and g.skin or rough(K, 238, 106, 30)
	local dark = plastic(K, 46, 48, 54)
	local tube = plastic(K, 62, 64, 70)

	-- The motor housing, its intake grille on the right, and the hatch on top the feed comes through.
	local receiver = g:rounded("Receiver", V(78, 108, 250), CF(0, 8, 60), 16, shell)
	g:cylX("Intake", 16, 86, CF(40, 8, 70), dark)
	g:detail(function()
		-- Set into the intake's outer face rather than level with it.
		for index = 0, 3 do
			g:cylX("IntakeVane", 3, 82, CF(44, 8, 70) * A(0, 0, 45 * index), tube)
		end
		for index = 0, 2 do
			g:box("MotorVent", V(K.FINE * 2, 40, 10), CF(-39.5, 8, 20 + index * 22), K.F.shadow)
		end
	end)

	g:group("cover", function()
		-- Its top stays 4 mm under the sight line, which runs at y = 70 to the post on the tube.
		g:rounded("BlowerHatch", V(72, 20, 150), CF(0, 56, 40), 8, shell)
		-- The catch hangs below the hatch's underside, not flush with it.
		g:box("HatchCatch", V(26, 10, 14), CF(0, 49, -36), dark)
	end)
	g:swing("cover", CF(0, 52, 118), -68)
	g:hand("CoverHand", V(-12, 74, 40), V(0.3, -0.6, -1), V(-0.2, 1, 0))

	-- The blower tube, corrugated, stepping down to the nozzle. It starts inside the housing: ending at its
	-- front face left the whole front of the gun hanging in the air.
	corrugated(g, K, "Barrel", -50, -470, 56, tube, dark)
	g:cyl("Nozzle", 70, 44, CF(0, 0, -505), shell)
	g:cyl("NozzleTip", 24, 34, CF(0, 0, -552), dark)
	g:cyl("Bore", K.FINE, 26, CF(0, 0, -564 - K.FINE / 2), F.bore)
	g:key("Muzzle", CF(0, 0, -568))

	-- The pull-start cord on the left: the charging handle.
	g:group("charge", function()
		g:box("StartHandle", V(14, 28, 40), CF(-46, 24, 120), dark)
		g:cyl("StartCord", 60, 6, CF(-46, 24, 148) * A(0, 90, 0), plastic(K, 226, 226, 220))
	end)
	g:travel("charge", 90)
	-- Turned 0 degrees on the palm and tilted 30 so the wrist is not bent past 77 degrees working it (it was 92): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(-62, 26, 120), V(0.38, -0.9, -0.21), V(-0.2, -0.31, 0.93))

	-- Sights: a post on a band round the tube, an aperture on the housing, both on y = 70.
	g:cyl("SightBand", 16, 62, CF(0, 0, -300), dark)
	g:box("FrontSightBase", V(14, 12, 16), CF(0, 34, -300), dark)
	g:box("FrontSightPost", V(4, 22, 5), CF(0, 51, -300), dark)
	g:box("FrontSight", V(2.4, 9, 3), CF(0, 65.5, -300), dark)
	g:box("RearSightBase", V(30, 10, 26), CF(0, 55, 150), dark)
	for _, sx in ipairs(SIGNS) do
		g:box("RearSightEar", V(4, 18, 18), CF(sx * 12, 69, 150), dark)
	end
	g:shell("RearSight", 4, 10, 3, CF(0, 70, 150), dark)
	g:aperturePlate(CF(0, 0, 150), 58, 70, dark)
	g:key("Sight", CF(0, 70, 150))
	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 0.5)

	-- The leaf bag, hung under the housing: the magazine, with leaves showing in its mouth. 40 mm ahead of
	-- where it first hung: there its back stood against the grip's front strap and the trigger hand's
	-- fingers, even lying open, were inside it -- a bare palm on the grip (#92, tools/fps_arms_check.py).
	g:group("mag", function()
		g:rounded("Magazine", V(84, 128, 118), CF(0, -92, 40), 22, fabric(K, 74, 108, 56))
		g:box("MagazineStrap", V(88, 14, 26), CF(0, -44, 40), fabric(K, 52, 74, 40))
		g:detail(function()
			for index = 0, 3 do
				g:box("MagazineLeaf", V(24, 4, 16), CF(-18 + index * 12, -34, 20 + index * 9) * A(12 * index, 20 * index, 8),
					plastic(K, 126, 186, 74))
			end
		end)
	end)
	g:key("MagWell", CF(0, -40, 40))
	g:hand("MagHand", V(-58, -104, 40), V(0.6, 0.5, -0.1), V(-1, 0, 0))

	-- Trigger on the rear grip, and the bail handle under the tube for the other hand.
	trigger(g, K, 96, -54, dark, shell)
	g:grip(V(0, -48, 140), 14, dark, { length = 104, depth = 48, front = 26, back = 32, grooves = 3 })
	g:hand("GripHand", V(33, -88, 158), V(-0.3, 0.05, -1), V(1, 0.2, 0.3))
	g:box("BailHandle", V(12, 70, 14), CF(0, -52, -232), dark)
	g:box("BailHandle", V(12, 14, 96), CF(0, -80, -280), dark)
	g:hand("SupportHand", V(-8, -86, -280), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))

	-- A short shoulder brace off the back, so it shoulders like a machine gun.
	g:rounded("Stock", V(52, 60, 96), CF(0, -6, 232), 14, dark)
	g:prism("Buttpad", V(56, 108, 20), CF(0, -16, 286), 6, F.rubber)

	g.model:SetAttribute("Action", "belt")
	g.model:SetAttribute("Flash", "leaves")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

--------------------------------------------------------------------------------
-- Party Foul: a party popper the size of a cannon (lever mechanism, cannon keypoints)
--------------------------------------------------------------------------------

Builders.PartyFoulCannon = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local foil = g.skinned and g.skin or K.finishOf(Color3.fromRGB(226, 178, 66), K.Mat.Metal, 0.25)
	local card = plastic(K, 214, 66, 108)
	local cream = plastic(K, 246, 238, 220)
	local cork = K.finishOf(Color3.fromRGB(206, 170, 118), K.Mat.Wood)

	-- The body: a foil-wrapped drum with a card band round it, and the loading gate on its right.
	local receiver = g:rounded("Receiver", V(52, 72, 190), CF(0, -10, -10), 14, foil)
	g:cyl("BodyBand", 26, 58, CF(0, -10, 30) * A(0, 0, 0), card)
	g:box("LoadingGate", V(5.5, 24, 46), CF(25.15, -18, -40), card)
	g:key("Load", CF(44, -18, -40))
	g:detail(function()
		for _, sx in ipairs(SIGNS) do
			g:box("BodyStar", V(K.FINE * 2, 16, 16), CF(sx * 26.2, 0, -66) * A(0, 0, 45), cream)
		end
	end)

	-- The tube: a card barrel in foil bands, flaring at the mouth, with the cork still in it.
	g:cyl("Barrel", 380, 58, CF(0, 0, -300), card)
	for _, z in ipairs({ -160, -300, -440 }) do
		g:cyl("BarrelBand", 14, 62, CF(0, 0, z), foil)
	end
	g:cyl("BarrelMouth", 40, 72, CF(0, 0, -510), foil)
	g:group("round", function()
		g:cyl("Cork", 54, 44, CF(0, 0, -552), cork)
		g:cyl("CorkTop", 10, 50, CF(0, 0, -578), cork)
	end)
	g:cyl("Bore", K.FINE, 40, CF(0, 0, -531 - K.FINE / 2), F.bore)
	g:key("Muzzle", CF(0, 0, -584))

	-- Sights: a bead on a ramp over the tube, a buckhorn on the body, both on y = 46.
	g:box("FrontSightRamp", V(5, 14, 26), CF(0, 36, -470), foil)
	g:ball("FrontBead", 6, CF(0, 43, -470), cream)
	g:box("RearSightBase", V(22, 14, 16), CF(0, 32, -70), foil)
	for _, sx in ipairs(SIGNS) do
		g:box("RearSightHorn", V(6, 16, 5), CF(sx * 7, 45, -70), foil)
	end
	g:box("RearSight", V(8, 8, 5), CF(0, 40, -70), foil)
	g:key("Sight", CF(0, 46, -30))
	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 0.5)

	-- The streamer lever: a ribboned finger loop under the body, and a party-horn hammer at the back.
	g:group("lever", function()
		g:box("Lever", V(10, 6, 56), CF(0, -50, 10), foil)
		g:box("Lever", V(10, 38, 8), CF(0, -68, 44) * A(-12, 0, 0), foil)
		g:box("Lever", V(10, 8, 60), CF(0, -88, 70), foil)
		g:box("LeverRibbon", V(4, 26, 10), CF(0, -100, 96) * A(18, 0, 0), card)
	end)
	g:swing("lever", CF(0, -46, -20), 50)
	g.model:SetAttribute("GripGroup", "lever")
	g:group("hammer", function()
		g:cyl("Hammer", 22, 16, CF(0, 26, 62) * A(28, 0, 0), foil)
		g:cyl("HammerHorn", 26, 10, CF(0, 34, 76) * A(38, 0, 0), card)
	end)
	g:swing("hammer", CF(0, 16, 56), -30)

	-- The streamer tube under the barrel, the grip and the bottle-shaped butt.
	g:cyl("MagTube", 300, 28, CF(0, -34, -290), cream)
	g:cyl("MagCap", 14, 31, CF(0, -34, -446), foil)
	g:rounded("ForeGrip", V(44, 36, 150), CF(0, -32, -190), 12, card)
	g:hand("SupportHand", V(-8, -62, -190), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	trigger(g, K, 0, -44, foil, foil)
	g:rounded("Grip", V(34, 40, 104), CF(0, -24, 104) * A(8, 0, 0), 12, card)
	g:rounded("Stock", V(44, 52, 230), CF(0, -44, 276) * A(4, 0, 0), 15, cream)
	g:cyl("StockNeck", 60, 34, CF(0, -30, 150) * A(6, 0, 0), foil)
	g:prism("Buttplate", V(46, 130, 10), CF(0, -54, 394), 6, F.rubber)
	g:hand("GripHand", V(30, -34, 88), V(-0.3, 0.2, -1), V(1, 0.2, 0.3))
	g:hand("MagHand", V(-40, -40, -320), V(0.4, 0.3, -0.2), V(-1, -0.1, 0))

	g.model:SetAttribute("Action", "lever")
	g.model:SetAttribute("Flash", "confetti")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

--------------------------------------------------------------------------------
-- Rage Quit: a mechanical keyboard that fires its keycaps (semi mechanism, rifle keypoints)
--------------------------------------------------------------------------------

Builders.RageQuitCarbine = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local case = g.skinned and g.skin or plastic(K, 44, 46, 54)
	local cap = plastic(K, 226, 232, 244)
	local accent = plastic(K, 255, 140, 60)
	local braid = plastic(K, 62, 66, 76)

	-- The board: a low case with a deck of keycaps along its top and a lit strip down each side.
	local receiver = g:rounded("Receiver", V(104, 30, 290), CF(0, -2, 30), 8, case)
	-- The deck: rows of keycaps big enough to read as a keyboard from across a room, a few of them lit. They
	-- run either side of the sight rail's spine, which takes the middle of the case.
	local KEY_COLUMNS = { -46, -25, 25, 46 }
	for row = 0, 3 do
		for column, x in ipairs(KEY_COLUMNS) do
			local lit = (row * 4 + column) % 6 == 0
			g:box("Keycap", V(18, 9, 18), CF(x, 16, -70 + row * 22), lit and accent or cap)
		end
	end
	g:detail(function()
		for row = 0, 3 do
			for _, x in ipairs(KEY_COLUMNS) do
				g:box("KeycapLegend", V(9, K.FINE * 2, 9), CF(x, 20.5, -70 + row * 22), braid)
			end
		end
		for _, sx in ipairs(SIGNS) do
			g:box("CaseGlow", V(K.FINE * 2, 5, 240), CF(sx * 52.2, -6, 30), K.finishOf(Color3.fromRGB(120, 200, 255), K.Mat.Neon))
		end
	end)

	-- The cable: a braided lead for a barrel, ending in a plug, with a loose coil hanging off its middle.
	corrugated(g, K, "Barrel", -110, -400, 24, braid, case)
	g:detail(function()
		for index = 0, 5 do
			g:cylX("CableCoil", 10, 46, CF(0, -26, -250 - index * 16) * A(0, 0, 90) * A(0, 8 * index, 0), braid)
		end
	end)
	g:box("MuzzlePlug", V(26, 20, 46), CF(0, 0, -424), K.finishOf(Color3.fromRGB(186, 190, 198), K.Mat.Metal, 0.2))
	g:cyl("Bore", K.FINE, 14, CF(0, 0, -448 - K.FINE / 2), F.bore)
	g:key("Muzzle", CF(0, 0, -452))

	-- The bolt under the deck and the spacebar that charges it, out the right.
	g:group("bolt", function()
		g:box("BoltCarrier", V(16, 12, 54), CF(20, 6, 40), braid)
	end)
	g:travel("bolt", 46)
	g:key("Eject", CF(54, 6, 40) * A(0, -70, 0))
	g:group("charge", function()
		g:box("Spacebar", V(18, 10, 78), CF(56, 4, 70), cap)
		g:box("SpacebarStem", V(10, 8, 20), CF(48, 4, 70), braid)
	end)
	g:travel("charge", 60)
	-- Turned 15 degrees on the palm and tilted -30 so the wrist is not bent past 76 degrees working it (it was 108): #11,
	-- tools/fps_arms_check.py --clips.
	g:hand("ChargeHand", V(74, 8, 70), V(0.33, -0.94, -0.12), V(0.94, 0.32, 0.12))

	-- A red dot on a riser, its line well above the keycaps.
	g:box("SightRail", V(26, 8, 120), CF(0, 22, -20), case)
	local h = g:redDot(CF(0, 26, -20))
	g:key("Sight", CF(0, 26 + h, 30))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.66)

	-- The keycap tray that feeds it, and a mouse for a foregrip.
	g:group("mag", function()
		g:box("Magazine", V(56, 86, 52), CF(0, -56, -42), case)
		g:box("MagazineLip", V(60, 8, 56), CF(0, -16, -42), braid)
		g:detail(function()
			for index = 0, 2 do
				g:box("MagazineKeycap", V(12, 6, 12), CF(-14 + index * 14, -9, -42), cap)
			end
		end)
	end)
	g:key("MagWell", CF(0, -16, -42))
	g:hand("MagHand", V(-40, -80, -42), V(0.5, 0.4, -0.1), V(-1, 0, 0))

	g:rounded("Mouse", V(52, 30, 92), CF(0, -34, -190), 14, case)
	g:detail(function()
		for _, sx in ipairs(SIGNS) do
			g:box("MouseButton", V(22, K.FINE * 2, 40), CF(sx * 13, -20, -214), braid)
		end
		g:cylX("MouseWheel", 8, 16, CF(0, -18, -214), accent)
	end)
	g:hand("SupportHand", V(-12, -54, -196), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))

	trigger(g, K, -4, -40, braid, case)
	g:grip(V(0, -20, 74), 16, case, { length = 100, depth = 46, front = 24, back = 30, grooves = 3 })
	g:hand("GripHand", V(31, -58, 92), V(-0.3, 0.1, -1), V(1, 0.15, 0.3))
	g:rounded("Stock", V(40, 62, 150), CF(0, -12, 214), 12, case)
	g:prism("Buttpad", V(44, 96, 16), CF(0, -20, 292), 5, F.rubber)

	g.model:SetAttribute("Action", "semi")
	g.model:SetAttribute("Flash", "keycap")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

--------------------------------------------------------------------------------
-- Clean Sweep: two broom handles over a dustpan (break mechanism, double-barrel keypoints)
--------------------------------------------------------------------------------

Builders.CleanSweepDouble = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local pan = g.skinned and g.skin or plastic(K, 96, 148, 186)
	local handle = K.finishOf(Color3.fromRGB(176, 130, 78), K.Mat.Wood)
	local bristle = fabric(K, 226, 188, 96)
	local band = K.finishOf(Color3.fromRGB(176, 180, 188), K.Mat.Metal, 0.1)

	-- The action: a dustpan pressed into a body, with the top lever and two hammers on it.
	local receiver = g:rounded("Receiver", V(46, 58, 110), CF(0, -16, -5), 10, pan)
	-- The pan itself, wide under the barrels with a lip at its mouth, so the gun reads as a dustpan on sight.
	g:wedge("DustpanLip", V(98, 34, 96), CF(0, -40, -104) * A(0, 180, 0), pan)
	g:box("DustpanFloor", V(98, 6, 70), CF(0, -55, -118), pan)
	for _, sx in ipairs(SIGNS) do
		g:box("DustpanWall", V(6, 26, 96), CF(sx * 46, -30, -104), pan)
	end
	g:box("TopTang", V(16, 4, 50), CF(0, 13.6, 75) * A(8, 0, 0), band)
	g:box("TopLever", V(8, 5, 34), CF(6, 17.5, 62) * A(8, 25, 0), band)
	g:group("hammer", function()
		for _, sx in ipairs(SIGNS) do
			g:box("Hammer", V(7, 16, 10), CF(sx * 17, 16, 42) * A(35, 0, 0), band)
			g:box("HammerSpur", V(8, 5, 12), CF(sx * 17, 24, 49) * A(55, 0, 0), band)
		end
	end)
	g:swing("hammer", CF(0, 8, 38), -30)

	-- The barrels break downward about the pin at the front of the frame, the way a break gun opens.
	g:cylX("Hinge", 50, 16, CF(0, -30, -62), band)
	g:swing("hinge", CF(0, -30, -62), -40)
	g:group("hinge", function()
		for _, sx in ipairs(SIGNS) do
			g:cyl("Barrel", 330, 22, CF(sx * 11, 0, -227), handle)
			g:cyl("BarrelFerrule", 16, 25, CF(sx * 11, 0, -120), band)
			g:cyl("Bristles", 60, 30, CF(sx * 11, 0, -422), bristle)
			g:detail(function()
				for index = 0, 5 do
					g:box("Bristle", V(3, 26, 3), CF(sx * 11, 0, -452) * A(0, 0, 60 * index) * CF(0, 11, 0), bristle)
				end
			end)
			g:cyl("Bore", K.FINE, 18, CF(sx * 11, 0, -392 - K.FINE / 2), F.bore)
		end
		-- A raised rib between the handles with a brass bead, so the line clears the tang and lever.
		g:box("Rib", V(10, 18, 330), CF(0, 11, -227), band)
		g:ball("FrontBead", 5, CF(0, 21.5, -380), F.brass)
		g:rounded("ForeGrip", V(40, 22, 190), CF(0, -21, -185), 9, handle)
		g:box("ForendIron", V(20, 6, 40), CF(0, -34, -210), band)
	end)
	g:hand("SupportHand", V(-8, -46, -185), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g.model:SetAttribute("SupportGroup", "hinge")
	g:key("Load", CF(0, 0, -40))
	g.model:SetAttribute("LoadGroup", "hinge")
	g:key("Eject", CF(0, 6, -46) * A(118, 0, 0))
	g:key("Muzzle", CF(0, 0, -396))
	g:key("Sight", CF(0, 24, 50))
	g.model:SetAttribute("Optic", "iron")
	g.model:SetAttribute("EyeRelief", 0.78)

	-- Guard, two triggers, and a mop-head stock.
	g:box("TriggerGuard", V(12, 6, 60), CF(0, -60, 6), band)
	g:box("TriggerGuard", V(12, 17, 6), CF(0, -48.5, -21), band)
	g:box("TriggerGuard", V(12, 17, 6), CF(0, -48.5, 33), band)
	g:group("trigger", function()
		for _, z in ipairs({ -8, 10 }) do
			g:box("Trigger", V(5, 18, 5), CF(0, -46, z) * A(-12, 0, 0), band)
		end
	end)
	g:swing("trigger", CF(0, -38, 0), 12)
	g:rounded("Grip", V(34, 44, 96), CF(0, -34, 96) * A(10, 0, 0), 12, handle)
	g:rounded("Stock", V(42, 50, 150), CF(0, -52, 210) * A(6, 0, 0), 14, handle)
	g:cyl("MopCollar", 26, 52, CF(0, -58, 268) * A(6, 0, 0), band)
	g:detail(function()
		for index = 0, 7 do
			g:cyl("MopStrand", 90, 12, CF(0, -58, 300) * A(6, 0, 0) * A(0, 0, 45 * index) * CF(0, 16, 26), fabric(K, 236, 232, 220))
		end
	end)
	g:hand("GripHand", V(31, -74, 112), V(-0.3, 0.1, -1), V(1, 0.15, 0.3))
	g:hand("MagHand", V(-34, -40, -60), V(0.5, 0.3, -0.2), V(-1, -0.1, 0))

	g.model:SetAttribute("Action", "break")
	g.model:SetAttribute("Flash", "dust")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

--------------------------------------------------------------------------------
-- Hose Down: a hose reel with a brass nozzle and a jam-jar scope (bolt mechanism, sniper keypoints)
--------------------------------------------------------------------------------

Builders.HoseDownSniper = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local body = g.skinned and g.skin or plastic(K, 66, 132, 84)
	local hose = K.finishOf(Color3.fromRGB(46, 96, 62), K.Mat.Rubber)
	local brass = K.finishOf(Color3.fromRGB(206, 162, 82), K.Mat.Metal, 0.12)
	local steel = K.finishOf(Color3.fromRGB(176, 180, 188), K.Mat.Metal, 0.1)

	-- The reel: a drum of wound hose on a frame, with the crank on the right.
	local receiver = g:rounded("Receiver", V(54, 84, 210), CF(0, -12, 60), 14, body)
	g:cylX("Reel", 76, 130, CF(0, -6, 92), body)
	g:detail(function()
		for index = 0, 5 do
			g:cylX("ReelCoil", 74, 116 - index * 16, CF(0, -6, 92), index % 2 == 0 and hose or body)
		end
		g:cylX("ReelCrank", 14, 22, CF(44, -6, 92), steel)
		g:box("ReelHandle", V(10, 44, 10), CF(50, 16, 92), steel)
	end)

	-- The hose out of the reel to a brass nozzle, with a tap on the way.
	g:cyl("Barrel", 470, 26, CF(0, 0, -260), hose)
	for _, z in ipairs({ -120, -300, -440 }) do
		g:cyl("HoseBand", 12, 29, CF(0, 0, z), brass)
	end
	g:cyl("NozzleBody", 70, 34, CF(0, 0, -520), brass)
	g:cyl("NozzleTip", 40, 18, CF(0, 0, -572), brass)
	g:cyl("Bore", K.FINE, 12, CF(0, 0, -592 - K.FINE / 2), F.bore)
	g:key("Muzzle", CF(0, 0, -596))

	-- The tap handle is the bolt: turned up, drawn back, pushed home.
	g:group("bolt", function()
		g:box("BoltBody", V(20, 20, 90), CF(22, 10, 40), steel)
		g:box("TapHandle", V(12, 46, 12), CF(34, 30, 64), brass)
		g:ball("TapKnob", 18, CF(34, 54, 64), brass)
	end)
	g:swing("bolt", CF(0, 6, 60) * A(0, 90, 0), 60)
	g:travel("bolt", 90)
	g:hand("BoltHand", V(48, 30, 64), V(-0.5, 0.1, -0.8), V(0.4, 1, 0.2))
	g:key("Eject", CF(24, 12, -20) * A(0, -70, 20))

	-- A jam jar for a scope: the kit's scope inside a jar body with a screw lid.
	g:box("ScopeBase", V(30, 12, 150), CF(0, 30, 10), body)
	local h = g:scope(CF(0, 36, 10), "long")
	g:key("Sight", CF(0, 36 + h, 180))
	g:detail(function()
		-- Rings round the scope, not discs across it: you look through this.
		g:shell("JarLid", 22, 62, 9, CF(0, 36 + h, 96), brass)
		g:shell("JarRing", 10, 66, 10, CF(0, 36 + h, 84), brass)
		g:box("JarLabel", V(K.FINE * 2, 26, 40), CF(-29, 36 + h, 30), fabric(K, 244, 240, 226))
	end)
	g.model:SetAttribute("Optic", "scope")
	g.model:SetAttribute("EyeRelief", 0.6)

	-- A watering-can cartridge for a magazine, the grip, the trigger and a padded stock.
	g:group("mag", function()
		g:rounded("Magazine", V(56, 96, 60), CF(0, -76, -40), 12, K.finishOf(Color3.fromRGB(150, 226, 255), K.Mat.Glass, 0.15, 0.45))
		g:rounded("MagazineWater", V(46, 64, 50), CF(0, -88, -40), 8, K.finishOf(Color3.fromRGB(80, 170, 255), K.Mat.SmoothPlastic, 0, 0.3))
		g:box("MagazineCollar", V(60, 12, 64), CF(0, -30, -40), body)
	end)
	g:key("MagWell", CF(0, -30, -40))
	g:hand("MagHand", V(-40, -110, -40), V(0.4, 0.25, -0.15), V(-1, -0.15, 0))

	trigger(g, K, 0, -48, steel, body)
	g:grip(V(0, -42, 44), 14, body, { length = 104, depth = 48, front = 24, back = 32, grooves = 3 })
	g:hand("GripHand", V(32, -84, 62), V(-0.3, 0.05, -1), V(1, 0.2, 0.25))
	g:rounded("ForeGrip", V(44, 30, 170), CF(0, -26, -250), 10, body)
	g:hand("SupportHand", V(-6, -50, -250), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))
	g:rounded("Stock", V(46, 58, 190), CF(0, -30, 210) * A(3, 0, 0), 14, body)
	g:prism("Buttpad", V(50, 116, 18), CF(0, -40, 306), 6, F.rubber)

	g.model:SetAttribute("Action", "bolt")
	g.model:SetAttribute("Flash", "spray")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

--------------------------------------------------------------------------------
-- Dust Devil: a canister vacuum whose hoses spin (rotary mechanism, minigun keypoints)
--------------------------------------------------------------------------------

Builders.DustDevilRotary = function(g, K)
	local V, CF, A, F = K.V, K.CF, K.A, K.F
	local can = g.skinned and g.skin or plastic(K, 206, 74, 74)
	local hose = K.finishOf(Color3.fromRGB(58, 60, 68), K.Mat.Rubber)
	local steel = K.finishOf(Color3.fromRGB(176, 180, 188), K.Mat.Metal, 0.1)
	local bag = fabric(K, 214, 206, 186)

	-- The canister, its lid and the motor housing the hoses turn in front of.
	local receiver = g:rounded("Receiver", V(96, 120, 240), CF(0, -6, 90), 24, can)
	g:cyl("CanisterLid", 26, 104, CF(0, -6, -34), steel)
	g:cylX("CanisterWheel", 16, 56, CF(-54, -58, 150), hose)
	g:cylX("CanisterWheel", 16, 56, CF(54, -58, 150), hose)
	g:detail(function()
		g:box("PowerDial", V(40, K.FINE * 2, 40), CF(0, 56, 60), steel)
		for index = 0, 2 do
			g:box("CanisterVent", V(K.FINE * 2, 36, 12), CF(-48.2, -6, 20 + index * 24), F.shadow)
		end
	end)

	-- Four hoses on a hub, turning about the bore.
	g:group("spin", function()
		g:cyl("Hub", 60, 76, CF(0, 0, -120), steel)
		for index = 0, 3 do
			local around = CFrame.Angles(0, 0, index / 4 * math.pi * 2)
			g:at(CF(0, 0, -120) * around * CF(0, 30, 0), function()
				corrugated(g, K, "Hose", 0, -260, 34, hose, steel)
				g:cyl("HoseTip", 26, 40, CF(0, 0, -274), steel)
				g:cyl("Bore", K.FINE, 22, CF(0, 0, -288 - K.FINE / 2), F.bore)
			end)
		end
	end)
	g:swing("spin", CF(0, 0, -120) * A(0, 90, 0))
	-- On the bore, where the hoses converge, the way the chaingun's is.
	g:key("Muzzle", CF(0, 0, -412))

	-- The dust bag under it: the magazine, with a zip and a window of fluff. 20 mm ahead of where it first
	-- hung, clear of the grip's front strap so the trigger hand's fingers can close (#92).
	g:group("mag", function()
		g:rounded("Magazine", V(84, 110, 130), CF(0, -92, 60), 20, bag)
		g:box("MagazineZip", V(88, 10, 30), CF(0, -52, 60), steel)
		g:detail(function()
			for index = 0, 2 do
				g:ball("MagazineFluff", 26, CF(-22 + index * 22, -40, 40 + index * 10), bag)
			end
		end)
	end)
	g:key("MagWell", CF(0, -46, 60))
	g:hand("MagHand", V(-58, -104, 60), V(0.6, 0.5, -0.1), V(-1, 0, 0))

	-- A red dot on the canister's spine, clear of the hoses.
	g:box("SightRail", V(26, 10, 120), CF(0, 56, 10), steel)
	local h = g:redDot(CF(0, 60, 10))
	g:key("Sight", CF(0, 60 + h, 70))
	g.model:SetAttribute("Optic", "reddot")
	g.model:SetAttribute("EyeRelief", 0.66)

	-- The wand handle at the back, the carry grip under the hoses.
	trigger(g, K, 120, -66, steel, can)
	g:grip(V(0, -60, 164), 14, hose, { length = 106, depth = 50, front = 26, back = 34, grooves = 3 })
	g:hand("GripHand", V(34, -100, 182), V(-0.3, 0.05, -1), V(1, 0.2, 0.3))
	g:box("CarryBar", V(14, 80, 16), CF(0, -60, -60), steel)
	g:box("CarryBar", V(14, 16, 90), CF(0, -96, -104), hose)
	g:hand("SupportHand", V(-10, -100, -104), V(0.8, 0.5, -0.25), V(-0.4, -1, 0))

	g.model:SetAttribute("Action", "rotary")
	g.model:SetAttribute("Flash", "dust")
	g.model:SetAttribute("Casing", "none")
	return receiver
end

return GunModelsWorkshop
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">ItemData</string><ProtectedString name="Source">-- Everything you can carry that isn't a gun: heals, shield potions and movement items.
--
-- Your inventory is eight slots. A gun takes a slot to itself; an item takes a slot and stacks up
-- to `stack` of the same thing in it. Select a slot to hold what's in it, then click to use it.
--
--   kind      "heal" restores health up to `cap`; "shield" fills your shield up to `cap`;
--             "movement" does its effect through MovementService; "defense" builds a structure
--             in front of you through DefenseService; "throwable" is thrown along your aim and
--             bounces (ProjectileService, with its flight and blast in Ballistics.Throwables)
--   useTime   seconds spent using it (unrolling a bandage, drinking a potion); 0 is instant.
--             Switching slots cancels a use in progress.
--   pickup    how many come in one pickup on the map
--   weight    how often it turns up in its loot pool, relative to the others there

local ItemData = {}

ItemData.Items = {
	Bandage = {
		name = "Bandage",
		kind = "heal",
		rarity = "Common",
		amount = 30,
		cap = 75,
		useTime = 2.5,
		stack = 10,
		pickup = 3,
		weight = 45,
		color = Color3.fromRGB(236, 226, 200),
		description = "+30 health, up to 75% of your max health.",
	},
	MedKit = {
		name = "Med Kit",
		kind = "heal",
		rarity = "Uncommon",
		amount = 100,
		cap = 100,
		useTime = 5,
		stack = 3,
		pickup = 1,
		weight = 18,
		color = Color3.fromRGB(235, 70, 70),
		description = "Back to full health.",
	},
	MiniShield = {
		name = "Mini Shield Potion",
		kind = "shield",
		rarity = "Uncommon",
		amount = 25,
		cap = 50,
		useTime = 2,
		stack = 6,
		pickup = 2,
		weight = 25,
		color = Color3.fromRGB(90, 190, 255),
		description = "+25 shield, up to 50.",
	},
	ShieldPotion = {
		name = "Shield Potion",
		kind = "shield",
		rarity = "Rare",
		amount = 50,
		cap = 100,
		useTime = 4.5,
		stack = 3,
		pickup = 1,
		weight = 12,
		color = Color3.fromRGB(60, 120, 255),
		description = "+50 shield, up to a full 100.",
	},
	SpeedSoda = {
		name = "Speed Soda",
		kind = "movement",
		rarity = "Common",
		useTime = 0.5,
		stack = 3,
		pickup = 1,
		weight = 26,
		color = Color3.fromRGB(80, 220, 255),
		description = "+65% movement speed for 10 seconds, and a RUSH: sprint, slide, vault and climb without using stamina.",
	},
	RotRocket = {
		name = "Rot Rocket",
		kind = "movement",
		rarity = "Uncommon",
		useTime = 0,
		stack = 3,
		pickup = 1,
		weight = 20,
		color = Color3.fromRGB(255, 130, 60),
		description = "Blasts you high and far, keeping its speed all the way down. Aim up for height, level for distance.",
	},
	LaunchPad = {
		name = "Launch Pad",
		kind = "movement",
		rarity = "Uncommon",
		useTime = 0,
		stack = 2,
		pickup = 1,
		weight = 14,
		color = Color3.fromRGB(190, 110, 255),
		description = "Drops a pad that throws anyone high into the air, along the way they're running, for 30 seconds.",
	},
	BlinkBean = {
		name = "Blink Bean",
		kind = "movement",
		rarity = "Rare",
		useTime = 0,
		stack = 4,
		pickup = 2,
		weight = 18,
		color = Color3.fromRGB(255, 90, 220),
		description = "A lightning-fast 44-stud dash the way you're facing. You come out still moving, and it cancels a fall. It stops short of walls.",
	},
	BounceBoots = {
		name = "Bounce Boots",
		kind = "movement",
		rarity = "Rare",
		useTime = 0.6,
		stack = 2,
		pickup = 1,
		weight = 12,
		color = Color3.fromRGB(120, 230, 120),
		description = "Nearly triple-height jumps plus a mid-air double jump, for 18 seconds.",
	},
	RotGlider = {
		name = "Rot Glider",
		kind = "movement",
		rarity = "Epic",
		useTime = 0,
		stack = 2,
		pickup = 1,
		weight = 10,
		color = Color3.fromRGB(170, 120, 255),
		description = "A wing over your head. Near the ground an updraft throws you up first; then sail where you look for 16 seconds, falling slowly.",
	},

	-- Portable defenses: throw the kit and it pops up wherever it lands, facing the way you were
	-- looking. They take gunfire and explosions and collapse when shot out. Rare, and rarer up the
	-- tiers.
	RotBarricade = {
		name = "Rot Barricade",
		kind = "defense",
		rarity = "Rare",
		useTime = 0,
		stack = 3,
		pickup = 2,
		weight = 8,
		color = Color3.fromRGB(226, 196, 130),
		description = "Throw it: a sandbag wall pops up where it lands. 250 HP.",
	},
	PopupBunker = {
		name = "Pop-up Bunker",
		kind = "defense",
		rarity = "Epic",
		useTime = 0,
		stack = 2,
		pickup = 1,
		weight = 4,
		color = Color3.fromRGB(150, 160, 178),
		description = "Throw it: a roofed bunker with a firing slot and a back door. 1,250 HP.",
	},
	BrainrotFortress = {
		name = "Brainrot Fortress",
		kind = "defense",
		rarity = "Legendary",
		useTime = 0,
		stack = 1,
		pickup = 1,
		weight = 1,
		color = Color3.fromRGB(255, 196, 64),
		description = "Throw it: a two-floor fort with windows, a hatch ladder and battlements. 2,500 HP.",
	},
	-- The trap in the defense pool: thrown like a kit, but it arms where it lands instead of
	-- building anything, and goes off under the next enemy to step near it (HazardService).
	RotMine = {
		name = "Rot Mine",
		kind = "defense",
		rarity = "Rare",
		useTime = 0,
		stack = 3,
		pickup = 2,
		weight = 6,
		color = Color3.fromRGB(150, 210, 90),
		description = "Throw it: arms where it lands and blows up under the next enemy who steps near it. 95 damage.",
	},

	-- Throwables: hold one and a dotted arc shows where it will land; click to throw. They bounce off
	-- whatever they hit. How they fly and what they do is in Ballistics.Throwables.
	CookedCoconut = {
		name = "Cooked Coconut",
		kind = "throwable",
		rarity = "Uncommon",
		useTime = 0,
		stack = 4,
		pickup = 2,
		weight = 14,
		color = Color3.fromRGB(255, 140, 50),
		description = "Frag grenade. Hold the click to cook the fuse, let go to throw. Blows 3.2 s after the pin: up to 100 damage.",
	},
	LowkeyLatte = {
		name = "Lowkey Latte",
		kind = "throwable",
		rarity = "Uncommon",
		useTime = 0,
		stack = 3,
		pickup = 2,
		weight = 10,
		color = Color3.fromRGB(170, 182, 196),
		description = "Smoke bomb. Pours out a cloud 32 studs across for about 18 s. Nobody sees through it, bots included.",
	},
	ClingyCrumpet = {
		name = "Clingy Crumpet",
		kind = "throwable",
		rarity = "Rare",
		useTime = 0,
		stack = 3,
		pickup = 1,
		weight = 8,
		color = Color3.fromRGB(214, 44, 78),
		description = "Sticky bomb. Sticks to whatever it hits, vehicles and players included, and blows 2.5 s later: up to 110 damage. A ghost shows where it will stick.",
	},
}

ItemData.Order = {
	"Bandage", "MedKit", "MiniShield", "ShieldPotion",
	"SpeedSoda", "RotRocket", "LaunchPad", "BlinkBean", "BounceBoots", "RotGlider",
	"RotBarricade", "RotMine", "PopupBunker", "BrainrotFortress",
	"CookedCoconut", "LowkeyLatte", "ClingyCrumpet",
}

for id, item in pairs(ItemData.Items) do
	item.id = id
end

-- How many structures ONE player can have standing at once. DefenseService enforces it (a fourth
-- collapses their oldest), and it lives here because the client has to be able to say so: a cap the
-- player only discovers by losing a wall they built is not a rule, it is a surprise.
--
-- Mines are not structures and are not capped -- they arm where they land and belong to
-- HazardService -- so the sentence below goes on the three that build something, not on all four
-- "defense" items.
ItemData.MaxStructuresPerPlayer = 3

-- `capRule` is its own field rather than a sentence glued onto `description`, at the HUD tab's asking
-- and for their reason, which is better than the editorial one: joining two fields is a line of code,
-- while splitting one requires parsing English. A fused field imposes its choice on every consumer
-- that will ever exist; a split field imposes nothing on anyone.
--
-- Still composed from the constant, never typed: a split is exactly the moment someone writes
-- "three" by hand, and tools/lua_static_check.py fails that pattern for good reason.
for _, id in ipairs({ "RotBarricade", "PopupBunker", "BrainrotFortress" }) do
	ItemData.Items[id].capRule = string.format(
		"Up to %d of your own can stand at once - a new one replaces your oldest.",
		ItemData.MaxStructuresPerPlayer)
end

function ItemData.Get(id)
	return ItemData.Items[id]
end

-- Heals and shields share the "heal" loot spots; movement items have their own.
local function pool(kinds)
	local list = {}
	for _, id in ipairs(ItemData.Order) do
		if kinds[ItemData.Items[id].kind] then
			table.insert(list, ItemData.Items[id])
		end
	end
	return list
end

local healPool = pool({ heal = true, shield = true })
local movementPool = pool({ movement = true })
local defensePool = pool({ defense = true })
local throwablePool = pool({ throwable = true })

local function roll(list)
	local total = 0
	for _, item in ipairs(list) do
		total += item.weight
	end
	local value = math.random() * total
	for _, item in ipairs(list) do
		value -= item.weight
		if value &lt;= 0 then
			return item
		end
	end
	return list[#list]
end

function ItemData.RollRecovery()
	return roll(healPool)
end

function ItemData.RollMovement()
	return roll(movementPool)
end

-- Weighted toward the barricade: fortresses are one in nineteen of these, mines about a third.
function ItemData.RollDefense()
	return roll(defensePool)
end

-- Frags a little more often than smoke: 14 to 10.
function ItemData.RollThrowable()
	return roll(throwablePool)
end

return ItemData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">ItemModels</string><ProtectedString name="Source">-- Models for every carryable item — heals, shield potions and movement items — built from parts.
--
-- Shared by the pickups on the map, the item held in a player's hands and the first-person
-- viewmodel, so an item looks the same wherever you see it. Each is built facing -Z around the
-- design origin with a part named "Grip" where the hand goes, the same conventions the guns use,
-- and pivots on the origin. Glowing parts are named "Glow" so the viewmodel can pulse them while
-- the item is being used.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ItemData = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ItemData"))
local ZFight = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ZFight"))

local ItemModels = {}

local WHITE = Color3.fromRGB(245, 245, 242)
local DARK = Color3.fromRGB(40, 42, 48)
local STEEL = Color3.fromRGB(170, 176, 186)
local CORK = Color3.fromRGB(150, 110, 70)
local RED = Color3.fromRGB(220, 50, 50)
local GLASS_TINT = Color3.fromRGB(200, 230, 255)

local V = Vector3.new

-- options: scale (default 1), anchored (default true), name (default "HeldItem"), open (the Rot
-- Glider's wing deployed rather than packed)
function ItemModels.Build(id, options)
	options = options or {}
	local item = ItemData.Get(id)
	if not item then
		return nil
	end
	-- Grenades and smoke bombs are built by ThrowableModels, to this same contract.
	if item.kind == "throwable" then
		return require(ReplicatedStorage.Shared:WaitForChild("ThrowableModels")).Build(id, options)
	end
	local scale = options.scale or 1
	local anchored = options.anchored ~= false
	local color = item.color

	local model = Instance.new("Model")
	model.Name = options.name or "HeldItem"
	model:SetAttribute("ItemId", id)

	local function piece(name, size, cframe, pieceColor, material, shape, transparency)
		local part = Instance.new("Part")
		part.Name = name
		if shape then
			part.Shape = shape
		end
		local frame = typeof(cframe) == "Vector3" and CFrame.new(cframe) or cframe
		part.Size = size * scale
		part.CFrame = CFrame.new(frame.Position * scale) * frame.Rotation
		part.Color = pieceColor
		part.Material = material or Enum.Material.SmoothPlastic
		part.Transparency = transparency or 0
		part.Anchored = anchored
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CastShadow = part.Material ~= Enum.Material.Neon and (transparency or 0) &lt; 0.3
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Parent = model
		return part
	end

	-- Upright cylinder centred at `position`.
	local function column(name, height, diameter, position, pieceColor, material, transparency)
		return piece(name, V(height, diameter, diameter), CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2),
			pieceColor, material, Enum.PartType.Cylinder, transparency)
	end

	-- Cylinder running front to back.
	local function tube(name, length, diameter, position, pieceColor, material, transparency)
		return piece(name, V(length, diameter, diameter), CFrame.new(position) * CFrame.Angles(0, math.pi / 2, 0),
			pieceColor, material, Enum.PartType.Cylinder, transparency)
	end

	local function ball(name, diameter, position, pieceColor, material, transparency)
		return piece(name, V(diameter, diameter, diameter), position, pieceColor, material, Enum.PartType.Ball, transparency)
	end

	-- An invisible handle marker.
	local function grip(position)
		return piece("Grip", V(0.2, 0.2, 0.2), position, DARK, nil, nil, 1)
	end

	local body

	if id == "Bandage" then
		-- A roll of gauze lying on its side, a tail of it unrolled, clipped, with a red cross.
		body = piece("Body", V(0.7, 0.9, 0.9), V(0, 0.1, 0), color, Enum.Material.Fabric, Enum.PartType.Cylinder)
		-- The cardboard core pokes clear out of both ends of the roll. It used to stop 0.01 past
		-- them, close enough that the build's z-fight pass had to push it out itself.
		piece("Core", V(0.84, 0.3, 0.3), V(0, 0.1, 0), Color3.fromRGB(180, 160, 130), Enum.Material.Fabric, Enum.PartType.Cylinder)
		for _, x in ipairs({ -0.22, 0.22 }) do
			piece("Band", V(0.08, 0.92, 0.92), V(x, 0.1, 0), WHITE, Enum.Material.Fabric, Enum.PartType.Cylinder)
		end
		local tail = CFrame.new(0, -0.32, -0.42) * CFrame.Angles(-0.45, 0, 0)
		-- The tail unrolls from between the two bands, clear of both their edges and the roll's.
		piece("Tail", V(0.36, 0.05, 0.9), tail, color, Enum.Material.Fabric)
		-- The clip is a rod across the gauze, sunk into it. A cylinder has only its two ends, so
		-- nothing of it can lie flush with the tail the way the old flat clip's faces did. (Before
		-- that it hung in the air 0.3 above the tail.)
		piece("Clip", V(0.22, 0.09, 0.09), tail * CFrame.new(0, 0.03, -0.33), STEEL, Enum.Material.Metal, Enum.PartType.Cylinder)
