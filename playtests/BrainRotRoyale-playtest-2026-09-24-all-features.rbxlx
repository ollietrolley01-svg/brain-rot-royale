		chestWeight = 1,
	},
}

-- What a kill with the gun does to the body (ServerScriptService.Modules.DeathFxService):
-- float, ash, burn, freeze, shock, confetti, vaporize or gold. Anything not listed ragdolls.
WeaponData.KillEffects = {
	BubbleBlaster = "float",
	CrumblyCarbine = "ash",
	PocketPopper = "confetti",
	LagSwitchSMG = "shock",
	AuraCrossbow = "float",
	BananiniBurst = "confetti",
	LarilaSniper = "freeze",
	AuraScattergun = "shock",
	BubbleBurster = "float",
	CappuccinaLauncher = "burn",
	CameloLMG = "ash",
	SixSevenMarksman = "freeze",
	TralalaThumper = "burn",
	GlitchSMG = "shock",
	NonnaDoubleBarrel = "burn",
	PatapimChaingun = "ash",
	GoldenSahurCannon = "gold",
	RizzRotary = "float",
	DeluluRailgun = "vaporize",
}

-- Additive arsenal pack; existing IDs remain valid for saved skins and stats.
local ArsenalExpansion = require(script.Parent:WaitForChild("ArsenalExpansion"))
for id, def in pairs(ArsenalExpansion.Weapons) do
	assert(WeaponData.Weapons[id] == nil, "Duplicate arsenal weapon: " .. id)
	WeaponData.Weapons[id] = table.clone(def)
	WeaponData.KillEffects[id] = def.killEffect or "ragdoll"
end

-- Creative pack (everyday-object guns; models in GunModelsCreative). Their loot weights stay 0 in the
-- pack until each gun has passed its sight, gap and hand probes and renders.
local CreativeArsenal = require(script.Parent:WaitForChild("CreativeArsenal"))
for id, def in pairs(CreativeArsenal.Weapons) do
	assert(WeaponData.Weapons[id] == nil, "Duplicate creative weapon: " .. id)
	WeaponData.Weapons[id] = table.clone(def)
	WeaponData.KillEffects[id] = def.killEffect or "ragdoll"
end

-- Workshop pack (shed-and-kitchen guns; models in GunModelsWorkshop). Staged the same way: weights stay 0
-- until a gun has passed its sight, contact, grip and hand probes and its renders.
local WorkshopArsenal = require(script.Parent:WaitForChild("WorkshopArsenal"))
for id, def in pairs(WorkshopArsenal.Weapons) do
	assert(WeaponData.Weapons[id] == nil, "Duplicate workshop weapon: " .. id)
	WeaponData.Weapons[id] = table.clone(def)
	WeaponData.KillEffects[id] = def.killEffect or "ragdoll"
end

local groundPool, chestPool = {}, {}
for id, def in pairs(WeaponData.Weapons) do
	def.id = id
	def.killEffect = WeaponData.KillEffects[id] or "ragdoll"
	if (def.groundWeight or 0) &gt; 0 then
		table.insert(groundPool, def)
	end
	if (def.chestWeight or 0) &gt; 0 then
		table.insert(chestPool, def)
	end
end

local function weightedPick(pool, weightKey)
	local total = 0
	for _, def in ipairs(pool) do
		total += def[weightKey]
	end
	local roll = math.random() * total
	local cumulative = 0
	for _, def in ipairs(pool) do
		cumulative += def[weightKey]
		if roll &lt;= cumulative then
			return def
		end
	end
	return pool[1]
end

function WeaponData.Get(id)
	return WeaponData.Weapons[id]
end

function WeaponData.RollGroundWeapon()
	return weightedPick(groundPool, "groundWeight")
end

function WeaponData.RollChestWeapon()
	return weightedPick(chestPool, "chestWeight")
end

return WeaponData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX63"><Properties><string name="Name">WorkshopArsenal</string><ProtectedString name="Source">-- Six workshop guns: things off a shed shelf or a kitchen counter made to shoot, in the spirit of the
-- Bubble Blaster, with a different mechanism each so they play as differently as they look. Stats sit in
-- their tier's body-DPS band against the guns already in WeaponData, ArsenalExpansion and CreativeArsenal;
-- models are built by GunModelsWorkshop.
--
-- STAGED: `staged = true` keeps a gun out of players' hands until it has passed tools/ads_align_probe,
-- gun_contact_probe, grip_junction_probe, hand_grip_probe and its renders. Ground and chest loot go by
-- weight, so those are 0; bot loot and supply drops roll every gun of a rarity and ignore weights, so they
-- skip `staged` instead -- it is the one flag that gates all four. `plannedGroundWeight` and
-- `plannedChestWeight` are the numbers to switch on: when a gun passes, drop its `staged` and set its
-- weights in the same edit (tools/verify.py fails if the two ever disagree).
--
-- `style` picks the mechanism and the fallback model, and CombatClient picks scope zoom by style (sniper,
-- dmr, railgun), so only a gun that really carries a scope may take one of those.
--
-- Extra fields, read by ServerScriptService/Modules/StatusEffects.lua:
--   knockback  studs/s shove along the shot
--   chill      { slow, duration, stacks, freeze }

local Pack = {}

-- A gun joins the pack only once GunModelsWorkshop can build it: without a builder it would fall back to
-- its style's stock model, which is not what it is. All six build now.
Pack.Order = {
	"RageQuitCarbine",
	"CleanSweepDouble",
	"HoseDownSniper",
	"DustDevilRotary",
	"YardWorkBlower",
	"PartyFoulCannon",
}

Pack.Weapons = {
	-- Common ------------------------------------------------------------------
	RageQuitCarbine = {
		name = "Rage Quit", rarity = "Common", style = "rifle",
		damage = 24, headshotMultiplier = 1.7, fireRate = 6.0, magSize = 24,
		reserveAmmo = 168, reloadTime = 1.9, range = 240, spread = 1.8, pellets = 1,
		staged = true, groundWeight = 0, chestWeight = 0, plannedGroundWeight = 28, plannedChestWeight = 10,
		killEffect = "shock",
		description = "A mechanical keyboard with a trigger. Fires the keycaps, one clack at a time.",
	},

	-- Uncommon ----------------------------------------------------------------
	CleanSweepDouble = {
		name = "Clean Sweep", rarity = "Uncommon", style = "doublebarrel",
		damage = 12, headshotMultiplier = 1.4, fireRate = 2.4, magSize = 2,
		reserveAmmo = 24, reloadTime = 2.2, range = 100, spread = 8, pellets = 8,
		staged = true, groundWeight = 0, chestWeight = 0, plannedGroundWeight = 24, plannedChestWeight = 9,
		killEffect = "ash",
		description = "Two broom handles over a dustpan. Both barrels of bristles, then a long reload.",
	},

	-- Rare --------------------------------------------------------------------
	HoseDownSniper = {
		name = "Hose Down", rarity = "Rare", style = "sniper",
		damage = 85, headshotMultiplier = 2.0, fireRate = 0.9, magSize = 5,
		reserveAmmo = 30, reloadTime = 2.6, range = 420, spread = 0.4, pellets = 1,
		staged = true, groundWeight = 0, chestWeight = 0, plannedGroundWeight = 18, plannedChestWeight = 9,
		chill = { slow = 0.22, duration = 2.0, stacks = 2 },
		killEffect = "freeze",
		description = "A garden hose reel with a brass nozzle and a jam-jar scope. A lance of cold water.",
	},
	DustDevilRotary = {
		name = "Dust Devil", rarity = "Rare", style = "minigun",
		damage = 15, headshotMultiplier = 1.3, fireRate = 12.0, magSize = 120,
		reserveAmmo = 360, reloadTime = 4.0, range = 150, spread = 4.5, pellets = 1,
		staged = true, groundWeight = 0, chestWeight = 0, plannedGroundWeight = 16, plannedChestWeight = 9,
		killEffect = "ash",
		description = "A canister vacuum whose four hoses spin up and spit dust bunnies.",
	},

	-- Epic --------------------------------------------------------------------
	YardWorkBlower = {
		name = "Yard Work", rarity = "Epic", style = "lmg",
		damage = 22, headshotMultiplier = 1.4, fireRate = 10.0, magSize = 60,
		reserveAmmo = 300, reloadTime = 3.2, range = 200, spread = 3.2, pellets = 1,
		staged = true, groundWeight = 0, chestWeight = 0, plannedGroundWeight = 12, plannedChestWeight = 8,
		knockback = 12,
		killEffect = "float",
		description = "A leaf blower fed from a leaf bag. Holds down a lane in a storm of leaves.",
	},

	-- Legendary ---------------------------------------------------------------
	PartyFoulCannon = {
		name = "Party Foul", rarity = "Legendary", style = "cannon",
		damage = 84, headshotMultiplier = 1.8, fireRate = 1.3, magSize = 6,
		reserveAmmo = 36, reloadTime = 2.9, range = 260, spread = 1.0, pellets = 1,
		staged = true, groundWeight = 0, chestWeight = 0, plannedGroundWeight = 7, plannedChestWeight = 5,
		knockback = 40,
		killEffect = "confetti",
		description = "A party popper the size of a cannon. Corks, confetti and a shove that clears a doorway.",
	},
}

return Pack
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX64"><Properties><string name="Name">ZFight</string><ProtectedString name="Source">-- Z-fighting guard.
--
-- Two faces that lie in the same plane, point the same way and overlap flicker against each
-- other as the camera moves: a trim set flush with its wall, a floor ring whose top is exactly
-- the floor's own height, a badge sunk into a crate so its front is level with the body, a slab
-- whose top sits right at the ground's surface. Everything in the game is built from parts by
-- code, so rather than trusting every offset was typed right, each thing runs through this
-- once it's assembled: the map and the lobby after their build, and every gun, item, crate,
-- brainrot and accessory model before its welds go in.
--
-- Fix() finds the fighting pairs and nudges the smaller face out along the shared normal until
-- there's a clear gap. When a thin part pokes out of a body by the same hair on opposite sides
-- (a band round a crate) it grows the part instead, so both sides clear; when it's sunk just
-- under the surface on both sides it shrinks it further in, out of sight. Moves are a few
-- hundredths of a stud: invisible, and enough.
--
--   ZFight.Fix(roots, options)            -&gt; { moved, resized, passes, remaining = { pair... } }
--   ZFight.Scan(roots, tolerance)         -&gt; the pairs still fighting (the build check uses this)
--   ZFight.Report(roots, groupOf, limit)  -&gt; what Fix had to touch, grouped, for the build check
--   ZFight.Describe(pairs, groupOf, limit)-&gt; lines describing Scan's pairs
--
-- options: tolerance (faces closer than this along their normal count; default Tolerance), gap
-- (what Fix leaves; default Gap), passes (default Passes), yield (task.wait now and then, for
-- big builds), all (move unanchored parts too, for a model whose welds aren't in yet; by
-- default only anchored parts move), terrain (lift tops sitting at the ground's surface;
-- default on, and only for parts in the workspace).
--
-- Moved parts carry a ZFixed attribute (how far, summed) and ZFixedWith (what they fought),
-- so the build check can list the patterns worth tidying at source.

local ZFight = {}

-- Faces closer than Tolerance along their shared normal are reported as fighting; Fix goes
-- after anything closer than FixTolerance, a little wider, so a pair it leaves at Gap can't be
-- tipped back under Tolerance by float rounding out at the lobby's coordinates. MinOverlap
-- ignores faces that merely share an edge (tiles side by side) but not a sliver of overlap.
ZFight.Tolerance = 0.045
ZFight.FixTolerance = 0.055
ZFight.Gap = 0.06
ZFight.MinOverlap = 0.02
ZFight.FixMinOverlap = 0.01
ZFight.Passes = 8
-- Debugging aids for tools/runtest.ps1 probes: Enabled false makes Fix a no-op (to see raw
-- geometry), Trace prints every nudge.
ZFight.Enabled = true
ZFight.Trace = false

local PARALLEL = 0.9995
local HIDDEN = 0.98

--------------------------------------------------------------------------------
-- Parts and faces
--------------------------------------------------------------------------------

local function isPart(instance, includeHidden)
	return instance:IsA("BasePart") and not instance:IsA("Terrain") and (includeHidden or instance.Transparency &lt; HIDDEN)
end

-- The visible parts under `roots` (parts themselves count too), each once.
function ZFight.Parts(roots, includeHidden)
	local parts, seen = {}, {}
	local function add(instance)
		if not seen[instance] and isPart(instance, includeHidden) then
			seen[instance] = true
			parts[#parts + 1] = instance
		end
	end
	-- pairs, not ipairs: callers pass FindFirstChild results that may be nil.
	for _, root in pairs(roots) do
		if typeof(root) == "Instance" then
			add(root)
			for _, descendant in ipairs(root:GetDescendants()) do
				add(descendant)
			end
		end
	end
	return parts
end

-- A part's flat faces: normal, centre, the two in-plane axes and half extents. Balls have none;
-- cylinders have their two ends (squared off a little inside the circle); wedges their bottom,
-- back, the rectangle that fits inside each triangular side, and the slope; corner wedges just
-- the bottom; meshes nothing.
local function facesOf(part)
	local faces = {}
	local cf, size = part.CFrame, part.Size
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	local X, Y, Z = cf.XVector, cf.YVector, cf.ZVector
	local p = cf.Position
	local function add(n, c, u, v, hu, hv)
		faces[#faces + 1] = { n = n, c = c, u = u, v = v, hu = hu, hv = hv, area = 4 * hu * hv }
	end

	local class = part.ClassName
	if class == "Part" then
		local shape = part.Shape
		if shape == Enum.PartType.Ball then
			return faces
		elseif shape == Enum.PartType.Cylinder then
			local r = math.min(hy, hz) * 0.8
			add(X, p + X * hx, Y, Z, r, r)
			add(-X, p - X * hx, Y, Z, r, r)
			return faces
		end
		local mesh = part:FindFirstChildOfClass("SpecialMesh")
		if mesh and mesh.MeshType ~= Enum.MeshType.Brick then
			return faces
		end
	elseif class == "WedgePart" then
		add(-Y, p - Y * hy, X, Z, hx, hz)
		add(Z, p + Z * hz, X, Y, hx, hy)
		local sideCentre = Z * (hz / 2) - Y * (hy / 2)
		add(X, p + X * hx + sideCentre, Y, Z, hy / 2, hz / 2)
		add(-X, p - X * hx + sideCentre, Y, Z, hy / 2, hz / 2)
		local along = Y * hy + Z * hz
		local slope = Y * hz - Z * hy
		if slope.Magnitude &gt; 1e-4 then
			add(slope.Unit, p, X, along.Unit, hx, along.Magnitude)
		end
		return faces
	elseif class == "CornerWedgePart" then
		add(-Y, p - Y * hy, X, Z, hx, hz)
		return faces
	else
		return faces
	end

	add(X, p + X * hx, Y, Z, hy, hz)
	add(-X, p - X * hx, Y, Z, hy, hz)
	add(Y, p + Y * hy, X, Z, hx, hz)
	add(-Y, p - Y * hy, X, Z, hx, hz)
	add(Z, p + Z * hz, X, Y, hx, hy)
	add(-Z, p - Z * hz, X, Y, hx, hy)
	return faces
end

-- Whether a part can be grown along `axis` (its local X/Y/Z) without changing its shape: blocks
-- and cylinders on any axis, a wedge only across its width (its profile lives in Y and Z).
local function resizable(part, axis)
	local class = part.ClassName
	if class == "WedgePart" then
		return axis == "X"
	elseif class ~= "Part" then
		return false
	end
	local shape = part.Shape
	return shape == Enum.PartType.Block or shape == Enum.PartType.Cylinder
end

local function refresh(entry)
	local part = entry.part
	local cf, size = part.CFrame, part.Size
	local xv, yv, zv = cf.XVector, cf.YVector, cf.ZVector
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	local ex = math.abs(xv.X) * hx + math.abs(yv.X) * hy + math.abs(zv.X) * hz
	local ey = math.abs(xv.Y) * hx + math.abs(yv.Y) * hy + math.abs(zv.Y) * hz
	local ez = math.abs(xv.Z) * hx + math.abs(yv.Z) * hy + math.abs(zv.Z) * hz
	local p = cf.Position
	entry.x0, entry.x1 = p.X - ex, p.X + ex
	entry.y0, entry.y1 = p.Y - ey, p.Y + ey
	entry.z0, entry.z1 = p.Z - ez, p.Z + ez
	entry.faces = nil
end

local function entriesFor(parts)
	local entries = table.create(#parts)
	for index, part in ipairs(parts) do
		local entry = { part = part }
		refresh(entry)
		entries[index] = entry
	end
	return entries
end

--------------------------------------------------------------------------------
-- Finding fighting faces
--------------------------------------------------------------------------------

-- How much two coplanar rectangles overlap, in the plane, or nil if they don't (or only touch
-- along an edge). Separating-axis test on the four edge directions, in `fa`'s frame.
local function overlap2D(fa, fb, minOverlap)
	local d = fb.c - fa.c
	local bx, by = d:Dot(fa.u), d:Dot(fa.v)
	local bu = Vector2.new(fb.u:Dot(fa.u), fb.u:Dot(fa.v))
	local bv = Vector2.new(fb.v:Dot(fa.u), fb.v:Dot(fa.v))
	local smallest = math.huge
	for _, axis in ipairs({ Vector2.new(1, 0), Vector2.new(0, 1), bu, bv }) do
		if axis.Magnitude &gt; 1e-4 then
			axis = axis.Unit
			local ra = fa.hu * math.abs(axis.X) + fa.hv * math.abs(axis.Y)
			local rb = fb.hu * math.abs(bu:Dot(axis)) + fb.hv * math.abs(bv:Dot(axis))
			local centre = bx * axis.X + by * axis.Y
			local overlap = (ra + rb) - math.abs(centre)
			if overlap &lt; minOverlap then
				return nil
			end
			smallest = math.min(smallest, overlap)
		end
	end
	return smallest
end

-- Every pair of coplanar, same-facing, overlapping faces among `entries`. Sort-and-sweep along
-- X for the candidates, then the face test.
local function sweep(entries, opts)
	table.sort(entries, function(a, b)
		return a.x0 &lt; b.x0
	end)
	local pad = opts.tolerance + 0.02
	local found = {}
	local count = #entries
	for i = 1, count do
		local a = entries[i]
		local limit = a.x1 + pad
		for j = i + 1, count do
			local b = entries[j]
			if b.x0 &gt; limit then
				break
			end
			if b.y0 &lt;= a.y1 + pad and a.y0 &lt;= b.y1 + pad and b.z0 &lt;= a.z1 + pad and a.z0 &lt;= b.z1 + pad then
				if not a.faces then
					a.faces = facesOf(a.part)
				end
				if not b.faces then
					b.faces = facesOf(b.part)
				end
				for _, fa in ipairs(a.faces) do
					for _, fb in ipairs(b.faces) do
						if fa.n:Dot(fb.n) &gt; PARALLEL then
							local gap = (fb.c - fa.c):Dot(fa.n)
							if math.abs(gap) &lt; opts.tolerance then
								local overlap = overlap2D(fa, fb, opts.minOverlap)
								if overlap then
									found[#found + 1] = { a = a, b = b, fa = fa, fb = fb, gap = gap, overlap = overlap }
								end
							end
						end
					end
				end
			end
		end
		if opts.yield and i % 1500 == 0 then
			task.wait()
		end
	end
	return found
end

--------------------------------------------------------------------------------
-- Terrain
--------------------------------------------------------------------------------

local function terrainParams()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = false
	return params
end

-- Points across an upward face to test the ground under: the centre, and a spread on big faces.
local function samplePoints(face)
	local points = { face.c }
	if face.hu &gt; 6 or face.hv &gt; 6 then
		for _, s in ipairs({ { 0.6, 0.6 }, { -0.6, 0.6 }, { 0.6, -0.6 }, { -0.6, -0.6 } }) do
			points[#points + 1] = face.c + face.u * (face.hu * s[1]) + face.v * (face.hv * s[2])
		end
	end
	return points
end

-- How far a part's upward face sits from the ground surface when it's within tolerance of it,
-- as the lift that would clear it; nil when it's clear already.
local function terrainLift(entry, params, opts)
	local part = entry.part
	if not part:IsDescendantOf(workspace) then
		return nil
	end
	if not entry.faces then
		entry.faces = facesOf(part)
	end
	local lift = nil
	for _, face in ipairs(entry.faces) do
		if face.n.Y &gt; 0.999 then
			for _, point in ipairs(samplePoints(face)) do
				local hit = workspace:Raycast(point + Vector3.new(0, 0.5, 0), Vector3.new(0, -1, 0), params)
				if hit then
					local above = point.Y - hit.Position.Y
					if math.abs(above) &lt; opts.tolerance then
						lift = math.max(lift or 0, opts.gap - above)
					end
				end
			end
		end
	end
	return lift
end

--------------------------------------------------------------------------------
-- Fixing
--------------------------------------------------------------------------------

-- Which of a part's local axes a world direction runs along, and which way (+1 / -1).
local function faceKey(cf, n)
	local dx, dy, dz = n:Dot(cf.XVector), n:Dot(cf.YVector), n:Dot(cf.ZVector)
	local ax, ay, az = math.abs(dx), math.abs(dy), math.abs(dz)
	if ax &gt;= ay and ax &gt;= az then
		return "X", dx &gt;= 0 and 1 or -1
	elseif ay &gt;= az then
		return "Y", dy &gt;= 0 and 1 or -1
	end
	return "Z", dz &gt;= 0 and 1 or -1
end

local function axisVector(cf, axis)
	if axis == "X" then
		return cf.XVector
	elseif axis == "Y" then
		return cf.YVector
	end
	return cf.ZVector
end

local function withAxis(size, axis, length)
	if axis == "X" then
		return Vector3.new(length, size.Y, size.Z)
	elseif axis == "Y" then
		return Vector3.new(size.X, length, size.Z)
	end
	return Vector3.new(size.X, size.Y, length)
end

local ROUNDS = 12

-- Works out and applies one pass of nudges for `found`. Returns how many parts changed and the
-- pairs nothing could be done about.
--
-- Each pair is a record: the front (the smaller face, which stays in front), the back, and how
-- far the front's face already stands in front of the back's along the shared normal. The
-- front is the mover; a front that can't move has its back back off instead. Nothing is touched
-- until the end: the records are settled in rounds against a planned offset (and planned face
-- growth) per part, so a stack of five coplanar plates spreads out in one pass instead of one
-- layer per pass. Blocks and cylinders grow the fighting face outward rather than moving, so a
-- band round a body widens on both sides and a strap between a body and a lip clears both.
local function applyPass(found, opts, stats)
	local gap = opts.gap
	local function movable(entry)
		return opts.all or entry.part.Anchored
	end

	local state = {}
	local function stateFor(entry)
		local s = state[entry]
		if not s then
			s = { offset = Vector3.zero, shift = {}, cf = entry.part.CFrame, size = entry.part.Size, grown = false, with = nil }
			state[entry] = s
		end
		return s
	end

	local records, stuck = {}, {}
	for _, hit in ipairs(found) do
		local frontIsA = hit.fa.area &lt;= hit.fb.area
		local front = frontIsA and hit.a or hit.b
		local back = frontIsA and hit.b or hit.a
		local n = frontIsA and hit.fa.n or hit.fb.n
		local gap0 = frontIsA and -hit.gap or hit.gap
		local frontMoves = movable(front)
		if frontMoves or movable(back) then
			local sf, sb = stateFor(front), stateFor(back)
			local fAxis, fSign = faceKey(sf.cf, n)
			local bAxis, bSign = faceKey(sb.cf, n)
			records[#records + 1] = {
				front = front, back = back, n = n, gap0 = gap0, hit = hit, frontMoves = frontMoves,
				fKey = fAxis .. fSign, fAxis = fAxis, fSign = fSign, bKey = bAxis .. bSign,
			}
		else
			stuck[#stuck + 1] = hit
		end
	end

	local function faceOffset(s, key, n)
		return s.offset:Dot(n) + (s.shift[key] or 0)
	end

	for _ = 1, ROUNDS do
		-- What each mover's faces still need, given everything planned so far.
		local needs = {}
		local any = false
		for _, r in ipairs(records) do
			local sf, sb = state[r.front], state[r.back]
			local sep = r.gap0 + faceOffset(sf, r.fKey, r.n) - faceOffset(sb, r.bKey, r.n)
			if sep &lt; gap - 1e-4 and sep &gt; -gap + 1e-4 then
				any = true
				if r.frontMoves then
					local list = needs[r.front]
					if not list then
						list = {}
						needs[r.front] = list
					end
					local slot = list[r.fKey]
					if not slot then
						slot = { out = 0, front = true, axis = r.fAxis, sign = r.fSign, n = r.n }
						list[r.fKey] = slot
					end
					slot.out = math.max(slot.out, gap - sep)
					sf.with = sf.with or r.back.part.Name
				else
					local list = needs[r.back]
					if not list then
						list = {}
						needs[r.back] = list
					end
					local key = "back" .. r.bKey
					local slot = list[key]
					if not slot then
						slot = { out = 0, front = false, n = -r.n }
						list[key] = slot
					end
					slot.out = math.max(slot.out, gap - sep)
					sb.with = sb.with or r.front.part.Name
				end
			end
		end
		if not any then
			break
		end

		for entry, list in pairs(needs) do
			local s = state[entry]
			for key, slot in pairs(list) do
				if slot.front and resizable(entry.part, slot.axis) then
					-- A block or cylinder grows the one face that's fighting, outward, and nothing
					-- else about it changes. Faces only ever go outward, so a part squeezed between
					-- two others (a strap under a lip, a seam between a body and a lid) settles
					-- instead of being shoved back and forth between passes.
					s.shift[key] = (s.shift[key] or 0) + slot.out
					s.grown = true
				else
					s.offset += slot.n * slot.out
				end
			end
		end
	end

	local changed = 0
	for entry, s in pairs(state) do
		local part = entry.part
		local move = s.offset
		local size = s.size
		local distance = s.offset.Magnitude
		if s.grown then
			for _, axis in ipairs({ "X", "Y", "Z" }) do
				local plus, minus = s.shift[axis .. "1"] or 0, s.shift[axis .. "-1"] or 0
				if plus ~= 0 or minus ~= 0 then
					local length = size[axis] + plus + minus
					if length &gt;= 0.05 then
						size = withAxis(size, axis, length)
						move += axisVector(s.cf, axis) * ((plus - minus) / 2)
						distance += math.abs(plus) + math.abs(minus)
						stats.resized += 1
					end
				end
			end
		end
		if distance &gt; 1e-5 then
			if size ~= s.size then
				part.Size = size
			end
			part.CFrame = s.cf + move
			changed += 1
			stats.moved += 1
			part:SetAttribute("ZFixed", (part:GetAttribute("ZFixed") or 0) + distance)
			part:SetAttribute("ZFixedWith", s.with)
			if ZFight.Trace then
				print(string.format("[ZFight] %s: move %s size %s -&gt; %s (vs %s)", part:GetFullName(), tostring(move), tostring(s.size), tostring(size), tostring(s.with)))
			end
			refresh(entry)
		end
	end
	return changed, stuck
end

local function round(v)
	return string.format("%.1f, %.1f, %.1f", v.X, v.Y, v.Z)
end

local function pairsOf(found)
	local list = table.create(#found)
	for index, hit in ipairs(found) do
		list[index] = { a = hit.a.part, b = hit.b.part, normal = hit.fa.n, gap = hit.gap, overlap = hit.overlap }
	end
	return list
end

local function options(given, fixing)
	given = given or {}
	return {
		tolerance = given.tolerance or (fixing and ZFight.FixTolerance or ZFight.Tolerance),
		gap = given.gap or ZFight.Gap,
		minOverlap = fixing and ZFight.FixMinOverlap or ZFight.MinOverlap,
		passes = given.passes or ZFight.Passes,
		yield = given.yield or false,
		all = given.all or false,
		terrain = given.terrain ~= false,
	}
end

-- A top flush with the terrain's surface comes up off it. Returns how many were lifted.
local function liftOffGround(entries, opts, stats)
	if not (opts.terrain and entries[1].part:IsDescendantOf(workspace)) then
		return 0
	end
	local params = terrainParams()
	local lifted = 0
	for index, entry in ipairs(entries) do
		if opts.all or entry.part.Anchored then
			local lift = terrainLift(entry, params, opts)
			if lift then
				local part = entry.part
				part.CFrame += Vector3.new(0, lift, 0)
				part:SetAttribute("ZFixed", (part:GetAttribute("ZFixed") or 0) + lift)
				part:SetAttribute("ZFixedWith", "Terrain")
				lifted += 1
				stats.lifted += 1
				stats.moved += 1
				refresh(entry)
			end
		end
		if opts.yield and index % 1500 == 0 then
			task.wait()
		end
	end
	return lifted
end

-- Nudges the visible parts under `roots` apart wherever their faces fight.
function ZFight.Fix(roots, given)
	local opts = options(given, true)
	local started = os.clock()
	local stats = { moved = 0, resized = 0, lifted = 0, passes = 0, remaining = {}, parts = 0, seconds = 0 }
	if not ZFight.Enabled then
		return stats
	end
	local entries = entriesFor(ZFight.Parts(roots))
	stats.parts = #entries
	if #entries == 0 then
		return stats
	end

	local needScan = true
	for pass = 1, opts.passes do
		stats.passes = pass
		-- Ground first each pass: a nudge can put a top back at the surface.
		local lifted = liftOffGround(entries, opts, stats)
		local found = sweep(entries, opts)
		needScan = false
		if ZFight.Trace then
			print(string.format("[ZFight] pass %d: lifted %d, fighting pairs %d", pass, lifted, #found))
			if #found &lt;= 24 then
				for _, hit in ipairs(found) do
					print(string.format("[ZFight]   %s/%s gap %.3f n(%s) areas %.2f/%.2f", hit.a.part.Name, hit.b.part.Name, hit.gap,
						round(hit.fa.n), hit.fa.area, hit.fb.area))
				end
			end
		end
		if #found == 0 then
			break
		end
		local changed, remaining = applyPass(found, opts, stats)
		needScan = true
		if changed == 0 then
			stats.remaining = pairsOf(remaining)
			needScan = false
			break
		end
		if opts.yield then
			task.wait()
		end
	end
	if needScan then
		stats.remaining = pairsOf(sweep(entries, opts))
	end
	stats.seconds = os.clock() - started
	return stats
end

-- The pairs of faces fighting among the visible parts under `roots`, without touching anything.
-- Includes parts whose tops sit at the ground's surface, as pairs with the Terrain.
function ZFight.Scan(roots, tolerance)
	local opts = options({ tolerance = tolerance })
	local entries = entriesFor(ZFight.Parts(roots))
	if #entries == 0 then
		return {}
	end
	local list = pairsOf(sweep(entries, opts))
	if entries[1].part:IsDescendantOf(workspace) then
		local params = terrainParams()
		for _, entry in ipairs(entries) do
			local lift = terrainLift(entry, params, opts)
			if lift then
				list[#list + 1] = { a = entry.part, b = workspace.Terrain, normal = Vector3.yAxis, gap = opts.gap - lift, overlap = 0 }
			end
		end
	end
	return list
end

--------------------------------------------------------------------------------
-- Reporting (the build check)
--------------------------------------------------------------------------------

-- What Fix moved under `roots`, grouped by `groupOf(part)`, the part's name and what it fought.
-- Returns the number of parts touched, the busiest patterns as lines, and how many patterns.
function ZFight.Report(roots, groupOf, limit)
	local counts, examples = {}, {}
	local total = 0
	for _, part in ipairs(ZFight.Parts(roots, true)) do
		local fixed = part:GetAttribute("ZFixed")
		if fixed then
			total += 1
			local key = string.format("%s %s/%s", groupOf and groupOf(part) or "?", part.Name, tostring(part:GetAttribute("ZFixedWith") or "?"))
			counts[key] = (counts[key] or 0) + 1
			examples[key] = examples[key] or string.format("%.3f @ %s", fixed, round(part.Position))
		end
	end
	local rows = {}
	for key, n in pairs(counts) do
		rows[#rows + 1] = { key = key, n = n }
	end
	table.sort(rows, function(a, b)
		if a.n ~= b.n then
			return a.n &gt; b.n
		end
		return a.key &lt; b.key
	end)
	local lines = {}
	for index = 1, math.min(limit or 40, #rows) do
		lines[#lines + 1] = string.format("%s x%d (%s)", rows[index].key, rows[index].n, examples[rows[index].key])
	end
	return total, lines, #rows
end

-- Lines describing pairs from Scan (or Fix's `remaining`), grouped the same way.
function ZFight.Describe(pairList, groupOf, limit)
	local counts, examples = {}, {}
	for _, pair in ipairs(pairList) do
		local key = string.format("%s %s/%s", groupOf and groupOf(pair.a) or "?", pair.a.Name, pair.b.Name)
		counts[key] = (counts[key] or 0) + 1
		examples[key] = examples[key] or string.format("gap %.3f n(%s) @ %s", pair.gap, round(pair.normal), round(pair.a.Position))
	end
	local rows = {}
	for key, n in pairs(counts) do
		rows[#rows + 1] = { key = key, n = n }
	end
	table.sort(rows, function(a, b)
		if a.n ~= b.n then
			return a.n &gt; b.n
		end
		return a.key &lt; b.key
	end)
	local lines = {}
	for index = 1, math.min(limit or 40, #rows) do
		lines[#lines + 1] = string.format("%s x%d (%s)", rows[index].key, rows[index].n, examples[rows[index].key])
	end
	return lines, #rows
end

return ZFight
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX65"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX66"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source">-- Wires every service together and owns the remote surface. Services stay unaware of each
-- other's remotes; everything routes through here.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CosmeticData = require(Shared:WaitForChild("CosmeticData"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local SafeValue = require(Shared:WaitForChild("SafeValue"))

local Modules = ServerScriptService:WaitForChild("Modules")
-- Requiring it is what arms it: AdminService wires its own remotes and greets the admin on join.
local AdminService = require(Modules:WaitForChild("AdminService"))
local BattlePassService = require(Modules:WaitForChild("BattlePassService"))
local BrainrotShopService = require(Modules:WaitForChild("BrainrotShopService"))
local CombatService = require(Modules:WaitForChild("CombatService"))
local Combatants = require(Modules:WaitForChild("Combatants"))
local CrateService = require(Modules:WaitForChild("CrateService"))
local MatchService = require(Modules:WaitForChild("MatchService"))
local Monetization = require(Modules:WaitForChild("Monetization"))
local NameplateService = require(Modules:WaitForChild("NameplateService"))
local AuraService = require(Modules:WaitForChild("AuraService"))
local AccessoryService = require(Modules:WaitForChild("AccessoryService"))
local CompanionService = require(Modules:WaitForChild("CompanionService"))
local DeathFxService = require(Modules:WaitForChild("DeathFxService"))
local DefenseService = require(Modules:WaitForChild("DefenseService"))
-- The picture of the match's terrain the drop picker draws: sampled once a match and cached
-- on the server, because streaming means a client has almost none of the map.
local DropMapService = require(Modules:WaitForChild("DropMapService"))
-- Launcher rounds, grenades, smoke, and the splat where a bullet lands. Both hook themselves in.
local HitSplatService = require(Modules:WaitForChild("HitSplatService"))
local HazardService = require(Modules:WaitForChild("HazardService"))
local ProjectileService = require(Modules:WaitForChild("ProjectileService"))
-- The creative guns' knockback, bleed, ignite and chill; hooks itself in the same way.
local StatusEffects = require(Modules:WaitForChild("StatusEffects"))
local MovementService = require(Modules:WaitForChild("MovementService"))
local MovementSanity = require(Modules:WaitForChild("MovementSanity"))
local LobbyService = require(Modules:WaitForChild("LobbyService"))
local LootService = require(Modules:WaitForChild("LootService"))
local AchievementService = require(Modules:WaitForChild("AchievementService"))
local PlayerData = require(Modules:WaitForChild("PlayerData"))
local PlaytimeService = require(Modules:WaitForChild("PlaytimeService"))
local ProgressionService = require(Modules:WaitForChild("ProgressionService"))
local QuestService = require(Modules:WaitForChild("QuestService"))
local RateLimit = require(Modules:WaitForChild("RateLimit"))
local RewardService = require(Modules:WaitForChild("RewardService"))
local ShowcaseService = require(Modules:WaitForChild("ShowcaseService"))
local StateSync = require(Modules:WaitForChild("StateSync"))
local StormService = require(Modules:WaitForChild("StormService"))
local TradeService = require(Modules:WaitForChild("TradeService"))
local VehicleService = require(Modules:WaitForChild("VehicleService"))
local VoteService = require(Modules:WaitForChild("VoteService"))
local WeaponService = require(Modules:WaitForChild("WeaponService"))

-- Every autosave also refreshes the profile's session lock (PlayerData), so this has to stay well
-- inside its stale timeout: 60 s against 150 s. At a full 50-player server that's ~50 DataStore writes
-- a minute, against a budget of 60 + 10 per player.
local AUTOSAVE_INTERVAL = 60
-- The last profile snapshot built for each player, and how long one may be reused (see the
-- RequestProfile remote). Cleared when they leave.
local profileSnapshots = {}
local PROFILE_SNAPSHOT_CACHE = 1
-- "senderId&gt;targetId" -&gt; os.clock() of the last trade invite, for the per-target cooldown.
local tradeInviteAt = {}
local TRADE_INVITE_COOLDOWN = 10

-- Spawning is managed explicitly: eliminated players spectate until the match resets
-- instead of auto-respawning into an empty lobby mid-round.
Players.CharacterAutoLoads = false

-- Bodies ragdoll, float, burn or shatter by the gun that got them.
CombatService.OnDeathFx = DeathFxService.OnDeath
-- The storm's damage reaches the death recap (#86): StormService cannot require CombatService.
StormService.OnDamage = CombatService.RecordEnvironmentDamage

-- A crouched, still shooter gets a steadier gun. MatchService requires CombatService, so the
-- crouch state is handed over rather than required back.
CombatService.IsCrouching = MatchService.IsCrouching

--------------------------------------------------------------------------------
-- Monetization grants
--------------------------------------------------------------------------------

-- Each handler only changes the profile, checking first, and hands back an `announce` function for the
-- toasts and pushes. Monetization.HandleReceipt runs that after the purchase is recorded and saved, so
-- a failing toast can never make a paid receipt look ungranted and get it granted twice.
Monetization.RegisterGrantHandler("Coins", function(player, data, grant)
	data.SahurCoins += grant.amount
	return function()
		StateSync.Notify(player, string.format("+%d SahurCoins", grant.amount))
		StateSync.Push(player)
	end
end)

Monetization.RegisterGrantHandler("Crate", function(player, _data, grant)
	-- A Robux crate: counted as paid, so what it pulls is recorded in the Rot Index without Cells.
	if not CrateService.GivePaid(player, grant.crate, 1) then
		error("crate product for unknown crate " .. tostring(grant.crate))
	end
	return function()
		-- The crate's own name, not its key with "Crate" glued on: the cosmetic tiers are keyed
		-- DeluxeStyle and PrestigeStyle, which read as "+1 DeluxeStyle Crate" the old way.
		local crate = require(Shared:WaitForChild("CrateData")).Get(grant.crate)
		StateSync.Notify(player, "+1 " .. ((crate and crate.name) or (grant.crate .. " Crate")))
		StateSync.Push(player)
	end
end)

Monetization.RegisterGrantHandler("Consumable", function(player, data, grant)
	data.Consumables[grant.consumable] = (data.Consumables[grant.consumable] or 0) + grant.amount
	return function()
		-- Named the way the shop card names it (GamepassConfig.DescribeContents), not by its raw id:
		-- "+5 one-match HealthPro boost" was a code word on the one toast a buyer reads (#86).
		local names = { Health = "Health Boost", Speed = "Speed Boost", HealthPro = "Pro Health Boost", SpeedPro = "Pro Speed Boost" }
		StateSync.Notify(player, string.format("+%d one-match %s", grant.amount, names[grant.consumable] or (grant.consumable .. " Boost")))
		StateSync.Push(player)
	end
end)

-- Everything in a bundle lands at once. It's all checked before anything is handed over, so a bad
-- entry fails the whole receipt (and it's retried) rather than half-granting it. Exclusives the
-- player already owns turn into coins, so buying a bundle twice is never wasted.
local bundleGranted = Remotes.Event("BundleGranted")

Monetization.RegisterGrantHandler("Bundle", function(player, data, grant, product)
	for _, entry in ipairs(grant.contents) do
		local valid = (entry.kind == "Coins" and type(entry.amount) == "number")
			or (entry.kind == "Crate" and data.Crates[entry.crate] ~= nil)
			or (entry.kind == "Consumable" and data.Consumables[entry.consumable] ~= nil)
			or (entry.kind == "Cosmetic" and CosmeticData.Get(entry.id) ~= nil)
		if not valid then
			error(string.format("%s has a bad %s entry", product.key, tostring(entry.kind)))
		end
	end

	local refunded = 0
	for _, entry in ipairs(grant.contents) do
		if entry.kind == "Coins" then
			data.SahurCoins += entry.amount
		elseif entry.kind == "Crate" then
			-- Bundle crates are bought with Robux too (see the Crate handler above).
			data.Crates[entry.crate] += entry.amount or 1
			data.PaidCrates[entry.crate] = (data.PaidCrates[entry.crate] or 0) + (entry.amount or 1)
		elseif entry.kind == "Consumable" then
			data.Consumables[entry.consumable] += entry.amount or 1
		elseif entry.kind == "Cosmetic" then
			if data.Cosmetics.owned[entry.id] then
				refunded += grant.duplicateCoins or 0
			else
				data.Cosmetics.owned[entry.id] = true
			end
		end
	end
	data.SahurCoins += refunded
	data.Bundles[product.key] = (data.Bundles[product.key] or 0) + 1

	return function()
		bundleGranted:FireClient(player, product.key, refunded)
		StateSync.Push(player)
	end
end)

-- A brainrot bought with Robux: the one the player picked (BrainrotShopService explains how the pick
-- is tied to the purchase). It opens with the crate reveal, in the rarity's colours.
local brainrotPurchaseReveal = Remotes.Event("CrateOpened")
Monetization.RegisterGrantHandler("Brainrot", function(player, data, grant)
	local def, chosen = BrainrotShopService.Grant(player, data, grant)
	-- Straight after the grant, with nothing in between that could yield: a brainrot bought with
	-- Robux goes into the Rot Index as discovered but never pays Brain Cells (ProgressionService).
	-- In its own pcall: the brainrot is already in the profile, so an error here must not fail the
	-- receipt.
	if ProgressionService.RecordPurchased then
		local recorded, err = pcall(ProgressionService.RecordPurchased, player, def.name)
		if not recorded then
			warn("[Bootstrap] RecordPurchased failed for a bought " .. def.name .. ": " .. tostring(err))
		end
	end
	return function()
		local colour = require(Shared:WaitForChild("Rarity")).Color(def.rarity)
		brainrotPurchaseReveal:FireClient(player, {
			crate = def.rarity .. " Brainrot",
			crateId = def.rarity,
			crateColor = colour,
			rarity = def.rarity,
			kind = "Brainrot",
			name = def.name,
			coinValue = def.coinValue,
		})
		StateSync.Notify(player, chosen and string.format("Bought %s!", def.name)
			or string.format("Bought a %s brainrot: %s (your pick didn't reach the server, so it's one you didn't have yet).", def.rarity, def.name))
		RewardService.CheckCollections(player)
		StateSync.Push(player)
	end
end)

Monetization.Init(function(player)
	StateSync.Push(player)
end)

--------------------------------------------------------------------------------
-- Player lifecycle
--------------------------------------------------------------------------------

local function setupLeaderstats(player, data)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Value = data.Stats.wins
	wins.Parent = leaderstats

	local kills = Instance.new("IntValue")
	kills.Name = "Kills"
	kills.Value = data.Stats.kills
	kills.Parent = leaderstats

	leaderstats.Parent = player
end

local function refreshLeaderstats(player)
	local data = PlayerData.Get(player)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not data or not leaderstats then
		return
	end
	local wins = leaderstats:FindFirstChild("Wins")
	local kills = leaderstats:FindFirstChild("Kills")
	if wins then
		wins.Value = data.Stats.wins
	end
	if kills then
		kills.Value = data.Stats.kills
	end
end

local function onPlayerAdded(player)
	-- #102: not in any match until startMatch says so. The client's spectator cycle reads this off the
	-- Player and treats an ABSENT attribute as "in" (so the read is inert wherever the write is not),
	-- which is why a mid-match joiner is told `false` here rather than left unset.
	player:SetAttribute("InMatch", false)
	player.CharacterAdded:Connect(function(character)
		MatchService.OnCharacterAdded(player, character)
		WeaponService.RefreshHeldGun(player)
	end)

	player.CharacterRemoving:Connect(function(character)
		Combatants.Unregister(character)
	end)

	-- Spawn BEFORE loading the profile. PlayerData.Load can sit there for many seconds
	-- retrying an unavailable DataStore, and with CharacterAutoLoads off that would leave
	-- the player with no character — and no world to look at — for the whole wait.
	if player.Character then
		MatchService.OnCharacterAdded(player, player.Character)
	else
		pcall(function()
			player:LoadCharacter()
		end)
	end

	local data = PlayerData.Load(player)
	if not player.Parent then
		PlayerData.Release(player)
		return
	end

	Monetization.Refresh(player)
	setupLeaderstats(player, data)
	BattlePassService.SyncTier(player)
	-- Profiles from before an achievement existed catch up here.
	AchievementService.SyncTitle(player)
	AchievementService.Check(player)
	-- Rot Rank and the Rot Index: a profile from before progression is backfilled once, and rank
	-- and prestige go on the player for nameplates.
	ProgressionService.OnProfileLoaded(player)
	-- Beginner's Luck: the one-off grant of its charges, once per profile, before the first push (see
	-- CrateService). Nothing in the menu says it exists.
	CrateService.GrantBeginnerLuck(player)
	StateSync.Push(player)

	-- The character spawns before the profile loads, so its first spawn had no cosmetics to
	-- draw. Apply them now that the data is here.
	AuraService.Apply(player, player.Character)
	AccessoryService.Apply(player, player.Character)
	CompanionService.Refresh(player)
	-- Collections completed before sets existed still pay out, once.
	RewardService.CheckCollections(player)

	-- Re-broadcast so someone joining mid-countdown sees the vote already in progress.
	--
	-- GATED ON open, and the gate is the whole point (#107, "game choosing menu pulls up randomly
	-- mid match"). VoteService.Resolve caches its pick until the next Open(), so from the moment a
	-- match starts until the next lobby countdown the snapshot still reads `open = false` with a
	-- `winner` set -- and that pair is exactly the cue VoteDropClient treats as "reveal the
	-- result". Broadcast is FireAllClients, so an ungated call here popped the mode/map reveal onto
	-- EVERY player's screen for three seconds every time anybody joined the server mid-match.
	-- Random from the player's side, because he cannot see who is joining.
	--
	-- A snapshot is not an event: the winner field stays true for a whole match, so anything that
	-- resends it re-fires the reveal. VoteService.Forget already gates its own rebroadcast on
	-- `if open`; this was the one path of the two that did not.
	if VoteService.IsOpen() then
		VoteService.Broadcast()
	end
	ShowcaseService.Refresh()

	-- The new arrival changes everyone else's trade list.
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			StateSync.Push(other)
		end
	end
end

local function onPlayerRemoving(player)
	MatchService.OnPlayerRemoving(player)
	WeaponService.Clear(player)
	CombatService.ForgetToken(player)
	Monetization.Clear(player)
	RateLimit.Clear(player)
	-- Snapshots are coalesced to one a frame (StateSync.Push), so send anything still waiting for
	-- this player before their profile is released below.
	StateSync.Flush(player)
	profileSnapshots[player] = nil
	-- Pairs are "&lt;from&gt;&gt;&lt;to&gt;" UserIds. Matched exactly, one side at a time: a substring match on the id
	-- also cleared every pair whose OTHER id merely contained it (UserId 12 cleared 3120&gt;77's cooldown).
	local leaving = tostring(player.UserId)
	for pair in pairs(tradeInviteAt) do
		local from, to = string.match(pair, "^(%-?%d+)&gt;(%-?%d+)$")
		if from == leaving or to == leaving then
			tradeInviteAt[pair] = nil
		end
	end
	PlayerData.Release(player)

	task.defer(function()
		ShowcaseService.Refresh()
		for _, other in ipairs(Players:GetPlayers()) do
			StateSync.Push(other)
		end
	end)
end

-- The lobby MUST exist before anyone is spawned into it. PlaceInLobby teleports to
-- LobbyPosition, and if the platform isn't built yet the player drops through empty space,
-- dies, respawns and falls again — which reads as "the game doesn't load".
-- No ground fog. The place ships without an Atmosphere, but Studio or a plugin can add one
-- back, and even a light one lays a grey film along the ground on maps this big.
do
	local Lighting = game:GetService("Lighting")
	Lighting.FogStart = 0
	Lighting.FogEnd = 100000
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Atmosphere") then
			child.Density = 0
			child.Haze = 0
			child.Glare = 0
		end
	end
end

ShowcaseService.Start()
BrainrotShopService.Start()
NameplateService.Start()
AuraService.Start()
AccessoryService.Start()
CompanionService.IsFighting = function(player)
	return MatchService.IsAlive(player)
end
CompanionService.OnLevelUp = function(player, name, level, bonusPercent)
	StateSync.Notify(player, string.format("%s reached level %d!  +%d%% damage and health", name, level, bonusPercent))
	StateSync.Push(player)
end
MovementService.SetSpeedBoost = MatchService.ApplySpeedBoost
-- The stamina ledger lives in MatchService; MovementService charges climbs and vaults against it.
MovementService.SpendStamina = MatchService.SpendStamina
MovementService.GetStamina = MatchService.GetStamina
-- A climb or a vault stands the body up first, the way it does for a player.
MovementService.SetCrouching = MatchService.SetCrouching
-- Vaulting through a window breaks the panes the body passes, with the same shatter a shot through them
-- gives: one DamageDestructible per pane (DestructibleService's hook on CombatService, set when it loads).
MovementService.BreakPane = function(token, pane, from)
	if not CombatService.DamageDestructible then
		return false
	end
	return CombatService.DamageDestructible(token, pane, 1, from) &gt; 0
end
-- The movement sanity monitor watches players in a running match only, and only ever counts (see its
-- header). Vehicles fall back to its own seat allowance, which clears the fastest vehicle (92).
MovementSanity.IsActive = function(player)
	return MatchService.GetState() == "InProgress" and MatchService.IsParticipant(player)
end
-- Parachutes: which canopy MovementService opens over a character on the drop-in and with the Rot
-- Glider, as an id for Shared/ParachuteModels (nil is the default Rot Glider canopy). A player gets
-- the one they have equipped, if they still own it. A bot sometimes gets a shop parachute, mostly
-- the common ones, so the designs turn up in the sky; its own Random leaves math.random alone.
do
	local BOT_CHANCE = 0.45
	local BOT_WEIGHT = { Common = 6, Uncommon = 3, Rare = 1.5, Epic = 0.6 }
	local botPool, botTotal = {}, 0
	for _, id in ipairs(CosmeticData.OfKind("Parachute", true)) do
		local weight = BOT_WEIGHT[CosmeticData.Get(id).rarity]
		if weight then
			table.insert(botPool, { id = id, weight = weight })
			botTotal += weight
		end
	end
	local botRandom = Random.new()

	MovementService.ParachuteFor = function(character)
		local player = Players:GetPlayerFromCharacter(character)
		if player then
			local data = PlayerData.Get(player)
			local id = data and data.Cosmetics.parachute
			if id and data.Cosmetics.owned[id] then
				return id
			end
			return nil
		end
		if #botPool == 0 or botRandom:NextNumber() &gt; BOT_CHANCE then
			return nil
		end
		local roll = botRandom:NextNumber() * botTotal
		for _, entry in ipairs(botPool) do
			roll -= entry.weight
			if roll &lt;= 0 then
				return entry.id
			end
		end
		return botPool[#botPool].id
	end
end
LobbyService.OnReadyPad = function(player)
	MatchService.SetReady(player, true)
end
-- Cloud Climb obby: the time every clear, and 250 SahurCoins the first clear per profile.
LobbyService.OnObbyComplete = function(player, seconds, firstClear, isRecord)
	-- The clear is announced whatever happens, and the coins are their own line. It used to hand the
	-- whole sentence to AwardBonusCoins as the bracketed "reason", which read as
	-- "+250 SahurCoins (Cloud Climb cleared in 12.3s — server record!)" -- the record, the thing the
	-- player actually did, arriving as a footnote to the payment. It also meant the announcement only
	-- went out if coins landed, so a first clear on a profile that had not loaded said nothing at all.
	StateSync.Notify(player, string.format("Cloud Climb cleared in %.1fs%s", seconds,
		isRecord and " — server record!" or ""))
	if firstClear then
		RewardService.AwardBonusCoins(player, 250, "first clear")
	end
	QuestService.Progress(player, "obby", 1)
end
-- The lobby pitch: a goal pays a few coins (LobbyService rate-limits it) and counts for quests.
LobbyService.OnGoal = function(player)
	RewardService.AwardBonusCoins(player, 35, "GOAL!")
	QuestService.Progress(player, "goals", 1)
end
-- The daily wheel is the daily reward from the Pass tab, claimed by spinning it in person. The
-- third value is the segment it landed on, for the wheel.
LobbyService.OnDailySpin = function(player)
	local success, message, segment = BattlePassService.ClaimDaily(player)
	if success then
		refreshLeaderstats(player)
		-- The wheel can hand out a brainrot.
		ProgressionService.RecordIndex(player)
	end
	return success, message, segment
end
-- Progression: every point of pass XP also feeds Rot Rank, and credited gun kills feed mastery.
ProgressionService.Start()
-- Compounding coins for every ten active minutes in one visit (#76).
PlaytimeService.Start()
BattlePassService.OnXp = ProgressionService.OnPassXp
MatchService.OnKillCredited = ProgressionService.OnKillCredited
MatchService.OnKillCredited = require(Modules:WaitForChild("KillAnimService")).Chain(MatchService.OnKillCredited) -- #24 kill animations
MatchService.ProgressionSummary = ProgressionService.MatchSummary
TradeService.OnTradeMoved = ProgressionService.OnTradeMoved
LobbyService.Start()
CompanionService.Start()
-- The drive loop for map vehicles. Safe to start before any map exists: it only ever walks the
-- vehicles that have registered themselves, and prunes them when their map is destroyed.
VehicleService.Start()
-- Mounted vehicle weapons: the drivers' fire and aim remotes, and rounds that leave their own vehicle alone.
require(Modules:WaitForChild("VehicleWeapons")).Start()
MatchService.Start()

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

--------------------------------------------------------------------------------
-- Combat remotes
--------------------------------------------------------------------------------

-- Every remote below is rate-limited (RateLimit.Budgets says what each budget is sized against).
-- Dropped calls are silent: the budgets sit well above anything this game's own client sends.
Remotes.Event("Fire").OnServerEvent:Connect(function(player, direction)
	if not RateLimit.Take(player, "Fire") then
		return
	end
	CombatService.Fire(player, direction)
end)

-- Latest, not dropped: each switch rebuilds and replicates the held gun, but dropping the LAST
-- switch of a fast weapon-wheel spin would leave the server holding a different gun from the one the
-- client is already drawing.
Remotes.Event("EquipSlot").OnServerEvent:Connect(function(player, slotIndex)
	RateLimit.Latest(player, "EquipSlot", slotIndex, function(index)
		WeaponService.Equip(player, index)
	end)
end)

Remotes.Event("ReloadWeapon").OnServerEvent:Connect(function(player)
	if not RateLimit.Take(player, "Reload") then
		return
	end
	WeaponService.Reload(player)
end)

-- Right-clicking a hotbar cell drops what's in it at your feet, for making room.
-- Only while the match is being played: during Loading everyone is already alive to IsAlive, and a drop
-- then put their kit on the ground at the pier or in mid-air before they had landed.
Remotes.Event("DropSlot").OnServerEvent:Connect(function(player, slotIndex)
	if not RateLimit.Take(player, "DropSlot") or not MatchService.IsPlaying(player) then
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local slot = root and WeaponService.TakeSlot(player, slotIndex)
	if slot then
		LootService.DropSlot(slot, root.Position + root.CFrame.LookVector * 3, root.Position)
	end
end)

-- HUD &amp; UX: rearranging the hotbar from the Inventory panel (StarterPlayerScripts/InventoryPanel). Two
-- slot numbers; WeaponService.SwapSlots checks them again and keeps what's in hand in hand. Both must be
-- real whole numbers 1-8 (SafeValue first: NaN and infinity fail every other test). At most SWAP_BURST
-- swaps in a row, refilling SWAP_RATE a second, so a modified client can't spam loadout pushes.
do
	local SWAP_BURST, SWAP_RATE = 8, 6
	local swapBudget = {}
	Remotes.Event("SwapSlots").OnServerEvent:Connect(function(player, a, b)
		if not SafeValue.Number(a, WeaponService.SlotCount) or not SafeValue.Number(b, WeaponService.SlotCount)
			or a % 1 ~= 0 or b % 1 ~= 0 or a &lt; 1 or b &lt; 1 then
			return
		end
		local now = os.clock()
		local budget = swapBudget[player]
		if not budget then
			budget = { tokens = SWAP_BURST, at = now }
			swapBudget[player] = budget
		end
		budget.tokens = math.min(SWAP_BURST, budget.tokens + (now - budget.at) * SWAP_RATE)
		budget.at = now
		if budget.tokens &lt; 1 then
			return
		end
		budget.tokens -= 1
		WeaponService.SwapSlots(player, a, b)
	end)
	Players.PlayerRemoving:Connect(function(player)
		swapBudget[player] = nil
	end)
end

Remotes.Event("SetAiming").OnServerEvent:Connect(function(player, value)
	RateLimit.Latest(player, "SetAiming", value, function(latest)
		CombatService.SetAiming(player, latest)
	end)
end)

Remotes.Event("SetSprinting").OnServerEvent:Connect(function(player, value)
	RateLimit.Latest(player, "SetSprinting", value == true, function(latest)
		MatchService.SetSprinting(player, latest)
	end)
end)

-- Crouching, the same shape: a state setter, so the newest value is what lands. MatchService holds the
-- speed factor and the height; SetCrouching is idempotent and refuses while seated. (It shared the
-- sprint bucket until RateLimit grew one of its own.)
Remotes.Event("SetCrouching").OnServerEvent:Connect(function(player, value)
	RateLimit.Latest(player, "SetCrouching", value == true, function(latest)
		MatchService.SetCrouching(player, latest)
	end)
end)

-- The client's slide ended early (slowed, jumped, blocked, airborne): drop the speed ceiling now.
-- Only acts on a slide that's actually on, so spamming it does nothing.
Remotes.Event("SlideEnd").OnServerEvent:Connect(function(player)
	if not RateLimit.Take(player, "Slide") then
		return
	end
	MatchService.EndSlide(player)
end)

-- The client climbed a ledge or vaulted something (it simulates its own body, so it runs the move):
-- MovementService charges the stamina, rate-limits, and poses the body for everyone else.
Remotes.Event("Parkour").OnServerEvent:Connect(function(player, kind, rise, duration)
	if not RateLimit.Take(player, "Parkour") then
		return
	end
	MovementService.ClientParkour(player, kind, rise, duration)
end)

-- A slide. The server decides whether it counts: you must be sprinting, not exhausted, alive, on the
-- ground, off cooldown and not on NoMantle ground; it costs stamina.
Remotes.Event("Slide").OnServerEvent:Connect(function(player)
	if not RateLimit.Take(player, "Slide") then
		return
	end
	MatchService.StartSlide(player)
end)

-- Picking a landing spot during the drop window. The server validates the point and the timing.
Remotes.Event("ChooseDrop").OnServerEvent:Connect(function(player, x, z)
	RateLimit.Latest(player, "ChooseDrop", { x = x, z = z }, function(latest)
		MatchService.ChooseDrop(player, latest.x, latest.z)
	end)
end)

-- The drop map itself: the raster the picker draws, asked for once as the window opens. Sampled and
-- cached on the server (DropMapService), so fifty clients asking at once cost one sample. Limited
-- rather than exempt because it is the largest answer any remote here gives.
Remotes.Function("GetDropMap").OnServerInvoke = function(player)
	if not RateLimit.Take(player, "DropMap") then
		return nil
	end
	return DropMapService.Current()
end

-- A click with an item in hand: start using it. Only while alive in a match that is being played (not
-- the Loading drop-in, when IsAlive is already true). Refusals that are worth explaining ("already at
-- full health") come back as a toast.
Remotes.Event("UseSelected").OnServerEvent:Connect(function(player, aimPoint, slotIndex)
	if not RateLimit.Take(player, "UseSelected") or not MatchService.IsPlaying(player) then
		return
	end
	-- Any component NaN or infinite is refused, not just a wrong type (see SafeValue).
	if aimPoint ~= nil and not SafeValue.Vector3(aimPoint) then
		return
	end
	-- `slotIndex` is the Quick Movement key's slot; StartUse validates it (a real whole number naming a
	-- slot that holds a movement item).
	local ok, reason = WeaponService.StartUse(player, aimPoint, slotIndex)
	if not ok and reason then
		StateSync.Notify(player, reason, true)
	end
end)

-- The companion hotkey. The client sends where it's aiming; the server picks the target and
-- owns the cooldown.
local noCompanionToldAt = {}
Remotes.Event("CompanionAbility").OnServerEvent:Connect(function(player, aimPoint)
	if not RateLimit.Take(player, "CompanionAbility") then
		return
	end
	if aimPoint ~= nil and not SafeValue.Vector3(aimPoint) then
		return
	end
	if CompanionService.UseAbility(player, aimPoint) then
		return
	end
	-- A fresh profile has no companion, and the practice sign says "press [G]": doing exactly what it
	-- says did nothing, with no word why (#86). Said once per few seconds, not per press. Only for "no
	-- companion equipped" -- a cooldown or a fallen companion has its own widget on the HUD.
	local data = PlayerData.Get(player)
	if data and data.Companion == nil and os.time() - (noCompanionToldAt[player] or 0) &gt;= 5 then
		noCompanionToldAt[player] = os.time()
		StateSync.Notify(player, "No companion yet — open a crate, then equip a brainrot in the menu.", true)
	end
end)
Players.PlayerRemoving:Connect(function(player)
	noCompanionToldAt[player] = nil
end)

-- Ready up / stay in the lobby. Only readied players are pulled into the next match.
Remotes.Event("SetReady").OnServerEvent:Connect(function(player, value)
	if type(value) ~= "boolean" then
		return
	end
	RateLimit.Latest(player, "SetReady", value, function(latest)
		MatchService.SetReady(player, latest)
	end)
end)

-- With StreamingEnabled the server replicates around the player's own character, so a
-- spectator watching someone across the map would see nothing. Point replication at
-- whoever they're following instead.
-- The checks, run on whichever focus the rate limit settles on (see the remote below).
local function setReplicationFocus(player, part)
	if part == nil then
		player.ReplicationFocus = nil
		return
	end
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") or not part.Parent then
		return
	end

	-- Only while spectating, and only onto a combatant's body. Accepting any part at any time
	-- let a modified client point streaming at, say, a spot beside an enemy it can't see yet
	-- and have the server replicate that region to it. Spectating means a dead PARTICIPANT of the
	-- running match: without that, anyone sitting in the lobby could stream the match and pass on
	-- what they saw.
	--
	-- Through MatchService.IsSpectating, which is that same rule written once. It used to be spelled
	-- out here as `IsAlive or not IsParticipant`; now that there is an EXIT from spectating (#102)
	-- there are two places that must agree on who is spectating, and two spellings of one rule is
	-- how they drift -- a player who had left would keep streaming the arena from the lobby.
	-- Both halves of the rule -- who may spectate, and which body they may stream around -- live in
	-- MatchService.FocusTarget beside IsSpectating and LeaveSpectate, so the three cannot drift. The
	-- target test that used to sit here accepted any Player's character (Combatants.FromCharacter falls
	-- back to Players:GetPlayerFromCharacter), which let a modified client stream the arena from a
	-- lobby idler's body; the target must now be alive in the match's own table (#102).
	local focus = MatchService.FocusTarget(player, part)
	if not focus then
		return
	end

	player.ReplicationFocus = focus
end

-- #102: the way OUT of spectating. Until this existed the only exit was the end of the match, so an
-- early elimination meant watching until the reset with no control that did anything.
--
-- RateLimit.Take, not Latest: this is a door, not a state. Over budget the press is dropped and
-- costs one more press, whereas a QUEUED press would fire a respawn seconds later, after the player
-- had given up on the button and the match had moved on underneath them.
--
-- No arguments, so there is nothing to validate: the server decides entirely from its own state
-- whether this player is spectating, and MatchService.LeaveSpectate refuses anyone who is not.
Remotes.Event("LeaveSpectate").OnServerEvent:Connect(function(player)
	if not RateLimit.Take(player, "LeaveSpectate") then
		return
	end
	MatchService.LeaveSpectate(player)
end)

Remotes.Event("SetReplicationFocus").OnServerEvent:Connect(function(player, part)
	if part ~= nil and typeof(part) ~= "Instance" then
		return
	end
	RateLimit.Latest(player, "SetReplicationFocus", part, function(latest)
		setReplicationFocus(player, latest)
	end)
end)

--------------------------------------------------------------------------------
-- Menu remotes
--------------------------------------------------------------------------------

local function guard(handler)
	return function(player, ...)
		local data = PlayerData.Get(player)
		if not data then
			pcall(StateSync.Notify, player, "Profile still loading.", true)
			return false, "Profile still loading."
		end
		-- One shared budget for the menu: each of these ends in a profile push and a leaderstats
		-- refresh, which is the cost worth capping. Over budget the call is dropped silently: no
		-- toast, no kick, and the budget is far above human clicking (RateLimit.Budgets.Menu).
		if not RateLimit.Take(player, "Menu") then
			return false, nil
		end
		local ok, success, message = pcall(handler, player, ...)
		if not ok then
			warn("[Bootstrap] Remote handler error: " .. tostring(success))
			pcall(StateSync.Notify, player, "Something went wrong.", true)
			return false, "Something went wrong."
		end
		-- THE ONE PLACE A MENU REMOTE'S ANSWER REACHES THE PLAYER. The client fires and forgets on
		-- purpose (MenuClient's invoke discards the reply: the profile push re-renders the tab), so a
		-- message a handler returns is heard only if it is toasted here. Before this, every refusal
		-- and every receipt written on the server -- "you can't sell your last copy", "that request
		-- expired", "Sold 4 Uncommon brainrots" -- was generated and thrown away, and a button that
		-- silently refused looked exactly like one that silently worked. A nil message stays silent
		-- (a rate-limited call, a settings save); a failure is red. The rule that goes with it: no
		-- guarded handler, and no service it calls, toasts the CALLER the message it also returns --
		-- tools/menu_reply_probe.lua counts those sites to zero. pcall'd, because a toast at a player
		-- on their way out must not take the reply with it.
		if message ~= nil then
			pcall(StateSync.Notify, player, message, not success)
		end
		refreshLeaderstats(player)
		return success, message
	end
end

-- Never refused, so a menu that asks always gets an answer. But a full snapshot is expensive to
-- build, so one asked for again within CACHE seconds gets the last one (RateLimit.Exempt says so).
Remotes.Function("RequestProfile").OnServerInvoke = function(player)
	local cached = profileSnapshots[player]
	local now = os.clock()
	if cached and now - cached.at &lt; PROFILE_SNAPSHOT_CACHE then
		return cached.snapshot
	end
	local snapshot = StateSync.Build(player)
	profileSnapshots[player] = { snapshot = snapshot, at = now }
	return snapshot
end

-- Settings menu. The profile may still be loading when the client asks, so wait for it.
-- One waiting call per player: this one polls for up to 20 seconds, so a client calling it in a loop
-- would otherwise pile up threads. A second call while one waits answers with whatever has loaded.
local settingsWaiting = {}

Remotes.Function("GetSettings").OnServerInvoke = function(player)
	local data = PlayerData.Get(player)
	if not data and not settingsWaiting[player] then
		settingsWaiting[player] = true
		local waited = 0
		while not data and waited &lt; 20 and player.Parent do
			task.wait(0.5)
			waited += 0.5
			data = PlayerData.Get(player)
		end
		settingsWaiting[player] = nil
	end
	return data and data.Settings or nil
end

-- Latest, not dropped: the settings menu debounces already, and the last values sent are the ones
-- the player means to keep.
Remotes.Function("SaveSettings").OnServerInvoke = guard(function(player, settings)
	RateLimit.Latest(player, "SaveSettings", settings, function(latest)
		local data = PlayerData.Get(player)
		if data then
			data.Settings = PlayerData.SanitizeSettings(latest)
		end
	end)
	return true
end)

Remotes.Function("CastVote").OnServerInvoke = function(player, mapId)
	if type(mapId) ~= "string" then
		return false, "Invalid map."
	end
	-- Not through guard(): it answers before a profile exists. It takes from the same menu budget,
	-- since a vote broadcasts to everyone in the lobby.
	if not RateLimit.Take(player, "Menu") then
		return false, nil
	end
	return VoteService.CastVote(player, mapId)
end

Remotes.Function("BuyCrate").OnServerInvoke = guard(function(player, tier)
	return CrateService.Buy(player, tier)
end)

-- Opening a crate, from the menu or the Crate Altar in the lobby: the pull, its set bonus and
-- quest progress, and the show on the altar.
local function openCrateFor(player, tier, shownLuck)
	local success, message, result = CrateService.Open(player, tier, shownLuck)
	if success then
		-- The brainrot that just came out may complete a set, and may be new to the Rot Index. A pull
		-- from a crate bought with Robux (`result.purchased`) is logged as Purchased and pays no Brain
		-- Cells; any other pull counts as found in play. Purchased must be written before the scan.
		RewardService.CheckCollections(player)
		local pulled = result and result.kind == "Brainrot" and result.name or nil
		if pulled and result.purchased then
			ProgressionService.RecordPurchased(player, pulled)
		end
		ProgressionService.RecordIndex(player, false, not (result and result.purchased) and pulled or nil)
		QuestService.Progress(player, "crates", 1)
		-- Everyone in the lobby sees the pull on the altar.
		if result then
			LobbyService.PresentCrate(player, result)
		end
	end
	return success, message
end

-- `shownLuck`: the crate luck the menu's odds were drawn for (CrateService.Open refuses a mismatch).
-- From the client, so only a sane number counts; anything else is ignored like the altar's nil (the
-- check only protects the player from rolling at odds they weren't shown).
Remotes.Function("OpenCrate").OnServerInvoke = guard(function(player, tier, shownLuck)
	return openCrateFor(player, tier, SafeValue.Number(shownLuck, 100) and shownLuck or nil)
end)

LobbyService.OnAltarOpen = function(player, tier)
	if not PlayerData.Get(player) then
		return false, "Profile still loading."
	end
	local success, message = openCrateFor(player, tier)
	refreshLeaderstats(player)
	return success, message
end

-- Selling can take away the brainrot you have equipped as a companion.
Remotes.Function("SellBrainrot").OnServerInvoke = guard(function(player, name)
	local success, message, showcaseChanged = RewardService.SellBrainrot(player, name)
	if success then
		CompanionService.Refresh(player)
		-- Only when the sale actually took the showcased brainrot: Refresh rebuilds every
		-- podium on the server, so it is not run for a sale that changed nothing on them.
		if showcaseChanged then
			ShowcaseService.Refresh()
		end
	end
	return success, message
end)

Remotes.Function("SellAllOfRarity").OnServerInvoke = guard(function(player, rarity)
	local success, message, showcaseChanged = RewardService.SellAllOfRarity(player, rarity)
	if success then
		CompanionService.Refresh(player)
		-- Only when the sale actually took the showcased brainrot: Refresh rebuilds every
		-- podium on the server, so it is not run for a sale that changed nothing on them.
		if showcaseChanged then
			ShowcaseService.Refresh()
		end
	end
	return success, message
end)

Remotes.Function("SellDuplicates").OnServerInvoke = guard(function(player)
	return RewardService.SellDuplicates(player)
end)

-- Merging spare copies into a brainrot for a star. The companion already out picks up the new
-- numbers in place, and a podium showing it redraws its damage line.
-- Buying a specific brainrot with Robux: stores the pick, then opens the rarity's purchase prompt
-- from the server. The receipt is handled by the "Brainrot" grant handler above.
Remotes.Function("BuyBrainrot").OnServerInvoke = guard(function(player, name)
	if type(name) ~= "string" then
		return false, "Invalid brainrot."
	end
	-- Toasted by guard(), like every other reply.
	local success, message = BrainrotShopService.Choose(player, name)
	return success, message
end)

-- `fromStars` is the star count the confirm dialog showed; a stale one (double-click, second
-- menu) is refused instead of spending another batch of copies.
Remotes.Function("MergeBrainrot").OnServerInvoke = guard(function(player, name, fromStars)
	if type(name) ~= "string" or type(fromStars) ~= "number" then
		return false, "Invalid merge."
	end
	local success, message = RewardService.MergeBrainrot(player, name, fromStars)
	if success then
		local data = PlayerData.Get(player)
		if data and data.Companion == name then
			CompanionService.UpdateStats(player)
		end
		if data and data.Showcase == name then
			ShowcaseService.Refresh()
		end
	end
	-- guard() toasts the reply (the receipt once the dialog has closed itself; a refusal as well,
	-- beside the line the confirm dialog shows).
	return success, message
end)

Remotes.Function("SetCompanion").OnServerInvoke = guard(function(player, name)
	if name ~= nil and type(name) ~= "string" then
		return false, "Invalid brainrot."
	end
	local success, message = RewardService.SetCompanion(player, name)
	if success then
		CompanionService.Refresh(player)
	end
	-- The menu doesn't show this result itself, so a message goes back either way: guard() toasts
	-- the reply, and the fallback wording survives as the message itself.
	return success, message or (success and "Done." or "Couldn't do that.")
end)

Remotes.Function("BuyCosmetic").OnServerInvoke = guard(function(player, cosmeticId)
	return RewardService.BuyCosmetic(player, cosmeticId)
end)

Remotes.Function("EquipCosmetic").OnServerInvoke = guard(function(player, cosmeticId)
	local success, message = RewardService.EquipCosmetic(player, cosmeticId)
	if success then
		-- Show the change straight away. Auras are otherwise only drawn at spawn, and the
		-- held gun keeps its old skin colour until it's rebuilt.
		AuraService.Apply(player, player.Character)
		AccessoryService.Apply(player, player.Character)
		WeaponService.RefreshHeldGun(player)
	end
	return success, message
end)

Remotes.Function("ClaimPassTier").OnServerInvoke = guard(function(player, tier, track)
	return BattlePassService.ClaimTier(player, tier, track)
end)

Remotes.Function("ClaimPassAll").OnServerInvoke = guard(function(player)
	return BattlePassService.ClaimAll(player)
end)

-- The Pass tab's DAILY SPIN is the same spin as the wheel at the booth, so it goes through the same
-- function: a brainrot won from the menu is recorded in the Rot Index just as one won at the wheel
-- is (#86). Two values back, not three: the segment is for the wheel's animation, and guard toasts
-- the message.
Remotes.Function("ClaimDaily").OnServerInvoke = guard(function(player)
	local success, message, _segment = LobbyService.OnDailySpin(player)
	return success, message
end)

-- The title worn on the nameplate: an unlocked achievement's id, or nil for none.
Remotes.Function("SetTitle").OnServerInvoke = guard(function(player, id)
	if id ~= nil and type(id) ~= "string" then
		return false, "Invalid title."
	end
	return AchievementService.SetTitle(player, id)
end)

--------------------------------------------------------------------------------
-- Progression: Rot Rank, the Rot Index and the Cell Shop (ProgressionService)
--------------------------------------------------------------------------------

-- Each of these is rate-limited per player, and each spends or claims idempotently: the client
-- says what it saw (prestige, shop day), and a stale view is refused rather than acted on twice.

-- `expected` is the prestige the confirm button showed.
Remotes.Function("Prestige").OnServerInvoke = guard(function(player, expected)
	if ProgressionService.RateLimited(player, "Prestige") then
		return false, "Slow down a moment."
	end
	if not SafeValue.Number(expected, 1000) then
		return false, "Invalid prestige."
	end
	return ProgressionService.Prestige(player, expected)
end)

-- One discovery by name, or nil for CLAIM ALL.
Remotes.Function("ClaimIndex").OnServerInvoke = guard(function(player, name)
	if ProgressionService.RateLimited(player, "ClaimIndex") then
		return false, "Slow down a moment."
	end
	if name ~= nil and (type(name) ~= "string" or #name &gt; 64) then
		return false, "Invalid brainrot."
	end
	return ProgressionService.ClaimIndex(player, name)
end)

-- `day` is the shop day the client was shown, only to refuse a stale shop; the server picks the
-- rotation. `companion` names who a Companion Snack feeds (nil: the equipped one).
Remotes.Function("BuyCellOffer").OnServerInvoke = guard(function(player, offerId, day, companion)
	if ProgressionService.RateLimited(player, "BuyCellOffer") then
		return false, "Slow down a moment."
	end
	if type(offerId) ~= "string" or #offerId &gt; 16 or not SafeValue.Number(day)
		or (companion ~= nil and (type(companion) ~= "string" or #companion &gt; 64)) then
		return false, "Invalid offer."
	end
	local success, message, fedCompanion = ProgressionService.BuyOffer(player, offerId, day, companion)
	local data = success and fedCompanion and PlayerData.Get(player)
	-- A snack for the companion that's out changes its numbers in place.
	if data and data.Companion == (companion or data.Companion) then
		CompanionService.UpdateStats(player)
	end
	return success, message
end)

--------------------------------------------------------------------------------
-- Showcase + trading
--------------------------------------------------------------------------------

Remotes.Function("SetShowcase").OnServerInvoke = guard(function(player, name)
	if name ~= nil and type(name) ~= "string" then
		return false, "Invalid brainrot."
	end
	local success, message = RewardService.SetShowcase(player, name)
	if success then
		ShowcaseService.Refresh()
	end
	return success, message
end)

local function playerFromUserId(userId)
	if type(userId) ~= "number" then
		return nil
	end
	return Players:GetPlayerByUserId(userId)
end

Remotes.Function("RequestTrade").OnServerInvoke = guard(function(player, targetUserId)
	local target = playerFromUserId(targetUserId)
	if not target then
		return false, "That player has left."
	end
	-- Invites get a budget of their own on top of the menu one, and a cooldown per TARGET, so an
	-- invite popup can't be used to pester someone. Both refusals say so rather than going silent.
	if not RateLimit.Take(player, "TradeInvite") then
		return false, "Wait a moment before sending another invite."
	end
	local pair = player.UserId .. "&gt;" .. target.UserId
	local now = os.clock()
	if tradeInviteAt[pair] and now - tradeInviteAt[pair] &lt; TRADE_INVITE_COOLDOWN then
		return false, "Wait a moment before inviting them again."
	end
	tradeInviteAt[pair] = now
	return TradeService.Request(player, target)
end)

Remotes.Function("RespondTrade").OnServerInvoke = guard(function(player, accept)
	return TradeService.Respond(player, accept == true)
end)

Remotes.Function("TradeOffer").OnServerInvoke = guard(function(player, name, add)
	if type(name) ~= "string" then
		return false, "Invalid brainrot."
	end
	return TradeService.Offer(player, name, add == true)
end)

Remotes.Function("TradeConfirm").OnServerInvoke = guard(function(player, value)
	return TradeService.Confirm(player, value == true)
end)

Remotes.Function("TradeCancel").OnServerInvoke = guard(function(player)
	return TradeService.Cancel(player)
end)

TradeService.IsBusy = function(player)
	return MatchService.IsAlive(player)
end

RewardService.IsTrading = TradeService.InSession

TradeService.OnTradeComplete = function()
	ShowcaseService.Refresh()
	-- A traded-away companion has to go home with its new owner's collection. Only the player whose
	-- companion left is touched; everyone else's (and its health boon) is left alone.
	CompanionService.RefreshAll()
	-- A trade can complete a set for either side.
	for _, player in ipairs(Players:GetPlayers()) do
		RewardService.CheckCollections(player)
		ProgressionService.RecordIndex(player)
	end
end

-- A mine is a weapon: it only triggers while a match is actually being played, so one left armed
-- cannot kill anyone on the results screen.
HazardService.MatchIsLive = function()
	return MatchService.GetState() == "InProgress"
end

MatchService.OnMatchStart = function()
	TradeService.CancelAll("Match starting — trade cancelled.")
	MovementService.Clear()
	DefenseService.Clear()
	ProjectileService.Clear()
	-- Only the mines players armed; the map's own barrels belong to the map.
	HazardService.Clear("mine")
	QuestService.ResetTallies()
	-- Where everyone's Rot Rank stands, for the results card's progression line.
	ProgressionService.BeginMatch()
end

MatchService.OnMatchEnd = function()
	ShowcaseService.Refresh()
	MovementService.Clear()
	DefenseService.Clear()
	ProjectileService.Clear()
	HazardService.Clear("mine")
	-- Companions downed this match come back for the next one.
	CompanionService.ReviveAll()
end

--------------------------------------------------------------------------------
-- Persistence
--------------------------------------------------------------------------------

task.spawn(function()
	while true do
		task.wait(AUTOSAVE_INTERVAL)
		for _, player in ipairs(Players:GetPlayers()) do
			task.spawn(PlayerData.Save, player)
		end
	end
end)

game:BindToClose(function()
	if RunService:IsStudio() then
		return
	end
	-- Release rather than save: the final write also clears each session lock, so the server people are
	-- sent to can load them at once instead of waiting for the locks to go stale. All in parallel,
	-- bounded well inside the ~30 s Roblox allows.
	local released = PlayerData.ReleaseAll(Players:GetPlayers(), 20)
	print(string.format("[Bootstrap] shutdown: released %d of %d profiles", released, #Players:GetPlayers()))
end)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX67"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX68"><Properties><string name="Name">AccessoryService</string><ProtectedString name="Source">-- Wearable accessories: hats, glasses and backpacks.
--
-- Each one is a handful of primitive parts described in CosmeticData, welded to the head or
-- torso — no uploaded meshes, so they cost nothing to add and bots can wear them too. Every
-- piece is non-collidable, massless and non-queryable, so an accessory never changes anyone's
-- hitbox or stops a bullet.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CosmeticData = require(Shared:WaitForChild("CosmeticData"))
-- The pieces themselves are built in Shared/CosmeticBuild, so the menu's previews are the same
-- geometry as the thing a player wears rather than a second copy of the recipe.
local CosmeticBuild = require(Shared:WaitForChild("CosmeticBuild"))

local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local AccessoryService = {}

local ACCESSORY_NAME = "CosmeticAccessory"

-- Pieces are authored against an R15 head this tall; everything scales from it.
local REFERENCE_HEAD_HEIGHT = CosmeticBuild.ReferenceHeadHeight

-- Returns the part to weld to and the CFrame piece offsets are relative to.
local function anchorFor(character, anchor)
	local head = character:FindFirstChild("Head")
	if anchor == "Back" then
		local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
		if not torso then
			return nil
		end
		return torso, torso.CFrame * CFrame.new(0, 0, torso.Size.Z / 2)
	end

	if not head then
		return nil
	end
	if anchor == "Face" then
		return head, head.CFrame * CFrame.new(0, head.Size.Y * 0.08, -head.Size.Z / 2)
	end
	return head, head.CFrame * CFrame.new(0, head.Size.Y / 2, 0)
end

-- Puts `itemId` on `character`, replacing whatever accessory it had. nil just removes it.
-- Works on characters that aren't parented yet, which is how bots get theirs.
function AccessoryService.Attach(character, itemId)
	local existing = character:FindFirstChild(ACCESSORY_NAME)
	if existing then
		existing:Destroy()
	end

	local item = itemId and CosmeticData.Get(itemId)
	if not item or item.kind ~= "Accessory" then
		return
	end

	local attachTo, origin = anchorFor(character, item.anchor)
	if not attachTo then
		return
	end

	local head = character:FindFirstChild("Head")
	local scale = head and math.clamp(head.Size.Y / REFERENCE_HEAD_HEIGHT, 0.6, 1.8) or 1

	-- Built with no two faces left flush, then welded (after, so only the one part moved).
	local model, pieces = CosmeticBuild.Model(item, origin, scale, ACCESSORY_NAME)
	for _, part in ipairs(pieces) do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = attachTo
		weld.Part1 = part
		weld.Parent = part
	end

	-- Parented last, fully welded, so it replicates as one piece.
	model.Parent = character
end

function AccessoryService.Apply(player, character)
	character = character or player.Character
	if not character then
		return
	end
	local data = PlayerData.Get(player)
	AccessoryService.Attach(character, data and data.Cosmetics.accessory or nil)
end

function AccessoryService.Start()
	local function hook(player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Head", 10)
			AccessoryService.Apply(player, character)
		end)
		-- Avatar appearance can swap body parts in after spawn, and a weld to a replaced head
		-- would drop the accessory on the floor. Re-attach once the appearance has settled.
		player.CharacterAppearanceLoaded:Connect(function(character)
			AccessoryService.Apply(player, character)
		end)
		if player.Character then
			AccessoryService.Apply(player, player.Character)
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end
	Players.PlayerAdded:Connect(hook)
end

return AccessoryService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX69"><Properties><string name="Name">AchievementService</string><ProtectedString name="Source">-- Lifetime counters, achievement unlocks and the title worn on the nameplate.
--
-- Everything QuestService counts comes through Track, which bumps the profile's Lifetime
-- counters and checks the achievements for that stat. Wins, kills and matches live in Stats
-- (RewardService keeps those) and are checked the same way.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AchievementData = require(Shared:WaitForChild("AchievementData"))

-- Achievements worth at least this much are announced to the whole server.
local SHOUT_THRESHOLD = 10000

local Monetization = require(script.Parent:WaitForChild("Monetization"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local StateSync = require(script.Parent:WaitForChild("StateSync"))

local AchievementService = {}

-- The title text as a Player attribute, so nameplates show it without a remote.
function AchievementService.SyncTitle(player)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	local achievement = data.Title and AchievementData.Get(data.Title)
	player:SetAttribute("Title", achievement and achievement.title or nil)
end

-- Unlocks anything whose target is now met. `stat` limits the check; nil checks everything
-- (used on join, so profiles from before an achievement existed catch up).
function AchievementService.Check(player, stat)
	local data = PlayerData.Get(player)
	if not data then
		return
	end

	local unlockedAny = false
	for _, achievement in ipairs(AchievementData.List) do
		if (stat == nil or achievement.stat == stat) and not data.Achievements[achievement.id]
			and AchievementData.Value(data, achievement.stat) &gt;= achievement.target then
			data.Achievements[achievement.id] = true
			-- Earned coins, so the 2x SahurCoins pass doubles them like every other payout.
			local granted = Monetization.EarnCoins(player, achievement.coins)
			unlockedAny = true
			StateSync.Notify(player, string.format('ACHIEVEMENT: %s  •  title "%s" unlocked  •  +%d SahurCoins',
				achievement.name, achievement.title, granted))
			-- The big ones are everyone's business.
			if achievement.coins &gt;= SHOUT_THRESHOLD then
				for _, other in ipairs(Players:GetPlayers()) do
					if other ~= player then
						StateSync.Notify(other, string.format('%s just earned "%s" (%s)!', player.DisplayName, achievement.title, achievement.name))
					end
				end
			end
			-- The first title you earn goes straight on.
			if not data.Title then
				data.Title = achievement.id
				AchievementService.SyncTitle(player)
			end
		end
	end

	if unlockedAny then
		StateSync.Push(player)
	end
end

function AchievementService.Track(player, stat, amount)
	local data = PlayerData.Get(player)
	if not data then
		return
	end
	if data.Lifetime[stat] ~= nil then
		data.Lifetime[stat] += amount
	end
	AchievementService.Check(player, stat)
end

function AchievementService.SetTitle(player, id)
	local data = PlayerData.Get(player)
	if not data then
		return false, "Profile still loading."
	end
	if id == nil then
		data.Title = nil
		AchievementService.SyncTitle(player)
		StateSync.Push(player)
		return true, "Title removed."
	end
	local achievement = AchievementData.Get(id)
	if not achievement then
		return false, "No such title."
	end
	if not data.Achievements[id] then
		return false, "You haven't unlocked that yet."
	end
	data.Title = id
	AchievementService.SyncTitle(player)
	StateSync.Push(player)
	return true, "Title: " .. achievement.title
end

return AchievementService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX70"><Properties><string name="Name">AdminService</string><ProtectedString name="Source">-- The admin panel's server half (Oliver's list #52).
--
-- Oliver: "make an admin hud menu that only appears for me, fqrtnugget. which can give me any
-- weapon get infinite money, get every gamepass for free, fly spawn events, etc. make sure only i
-- can see it and no other potential players."
--
-- THE WHOLE SECURITY MODEL IS HERE, and it is short on purpose:
--
--   1. ONE constant, one comparison. `ADMIN_USER_ID` is a UserId, never a display name — a name can
--      be released and bought by somebody else, and the panel would follow the name to them.
--   2. Every grant runs HERE. The client asks; this decides. A client-side check is decoration: a
--      player running a modified client simply skips it, so the gate has to be on the side the
--      player cannot edit.
--   3. Nothing from the client is believed. A weapon id is looked up in WeaponData, a pass key in
--      GamepassConfig, an event id in MatchEvents, and a coin amount is clamped. A forged request
--      for weapon "DoesNotExist" or 10^12 coins is refused, not honoured.
--   4. A refusal is SILENT and has no side effect. No error back, nothing different to measure, so
--      the remotes cannot be used to work out who is admin or whether an id exists.
--   5. Every action is logged with who, what and when, so no grant is invisible.
--
-- The panel itself is built on the client only after `AdminHello` arrives, and this only ever fires
-- it at the admin. For every other player the menu is not hidden, it is never created.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local WeaponData = require(Shared:WaitForChild("WeaponData"))
local GamepassConfig = require(Shared:WaitForChild("GamepassConfig"))
local MatchEvents = require(Shared:WaitForChild("MatchEvents"))
local CrateData = require(Shared:WaitForChild("CrateData"))

local Modules = ServerScriptService:WaitForChild("Modules")
local RateLimit = require(Modules:WaitForChild("RateLimit"))

local AdminService = {}

-- Oliver (fqrtnugget). The one number. Changing it is the only way to change who is admin, and the
-- probe's second planted fault checks that a WRONG number leaves Oliver with nothing — so a typo
-- here fails CLOSED (nobody is admin) rather than open (a stranger is).
AdminService.AdminUserId = 53193685

-- Coins are "infinite" in the sense that he can ask again; each grant is bounded so a malformed or
-- hostile amount cannot overflow the currency or a save.
local MAX_COINS_PER_GRANT = 1000000

local hello = Remotes.Event("AdminHello")
local action = Remotes.Event("AdminAction")

-- Split in two on purpose, and the reason is a test that could not fail.
--
-- `isAdmin` must demand a real Player Instance, so a forged table carrying the right UserId is
-- refused — that is the check that matters against a hostile client. But a probe in edit mode has
-- no Players to hand, so it could only ever feed it a table, which is always refused: every
-- assertion passed, including the one asserting the ADMIN gets in, and "refuses everyone" read
-- exactly like "works". The probe caught it only because it asserts the positive case too.
--
-- So the UserId comparison lives in `matches`, which a probe can call with a number, and `isAdmin`
-- is that plus the Instance requirement. Both are exercised: matches for who, isAdmin for what kind
-- of thing is asking.
local function matches(userId)
	return typeof(userId) == "number" and userId == AdminService.AdminUserId
end
AdminService.Matches = matches

local function isAdmin(player)
	return typeof(player) == "Instance" and player:IsA("Player") and matches(player.UserId)
end
AdminService.IsAdmin = isAdmin

local function log(player, what, detail)
	print(string.format("[Admin] %s (%d) %s%s", player.Name, player.UserId, what,
		detail and (" " .. detail) or ""))
end

-- Required lazily so this module can be required by a probe without dragging in the world.
local function modules()
	return {
		Weapon = require(Modules:WaitForChild("WeaponService")),
		Monetization = require(Modules:WaitForChild("Monetization")),
		PlayerData = require(Modules:WaitForChild("PlayerData")),
		Match = require(Modules:WaitForChild("MatchService")),
		Loot = require(Modules:WaitForChild("LootService")),
		Crate = require(Modules:WaitForChild("CrateService")),
		StateSync = require(Modules:WaitForChild("StateSync")),
	}
end

local godWatched = {}

-- Each handler returns a short string for the log, or nil if it did nothing. None of them trusts
-- its argument: every one is a lookup in a real table before anything is granted.
local HANDLERS = {
	Weapon = function(player, payload)
		local id = typeof(payload) == "string" and payload or nil
		-- WeaponData.Get is the accessor; GiveWeapon validates again on its own side and refuses
		-- when the player isn't in a match, so a forged id is rejected twice and silently.
		local def = id and WeaponData.Get(id)
		if not def then
			return nil
		end
		-- A full inventory swaps the equipped slot rather than refusing (WeaponService.GiveWeapon's
		-- own contract, shared with the normal ground-pickup path). Loot pickup never deletes what it
		-- replaces (LootService.lua ~257-265: "puts whatever was held down... instead of deleting
		-- it") -- an admin grant shouldn't either, since Oliver will use this while holding something
		-- he cares about. Drop it at his own feet the same way a pickup would.
		local _, _, replaced = modules().Weapon.GiveWeapon(player, id)
		if replaced then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				modules().Loot.DropSlot(replaced, root.Position)
			end
		end
		return "weapon " .. id
	end,

	Coins = function(player, payload)
		local amount = tonumber(payload)
		if not amount or amount ~= amount or amount &lt;= 0 then
			return nil
		end
		amount = math.min(math.floor(amount), MAX_COINS_PER_GRANT)
		local m = modules()
		m.Monetization.EarnCoins(player, amount, "admin")
		-- Show it now, as the crate grant does: nothing else pushes a snapshot until something happens.
		pcall(m.StateSync.Push, player)
		return "coins " .. amount
	end,

	Pass = function(player, payload)
		local key = typeof(payload) == "string" and payload or nil
		if not key or not GamepassConfig.Passes[key] then
			return nil
		end
		local data = modules().PlayerData.Get(player)
		if not data then
			return nil
		end
		data.TempPasses = data.TempPasses or {}
		-- A long grant rather than a forever one: it goes through the same TempPasses path the
		-- battle pass already uses, so nothing new has to be trusted by the code that reads passes.
		data.TempPasses[key] = os.time() + 365 * 24 * 3600
		modules().Monetization.Refresh(player)
		return "pass " .. key
	end,

	Event = function(player, payload)
		local id = typeof(payload) == "string" and payload or nil
		local event = id and MatchEvents.Get(id)
		if not event then
			return nil
		end
		local Match = modules().Match
		if typeof(Match.SetEvent) ~= "function" then
			-- MatchService has no admin entry point; refused rather than reached into, so this never
			-- writes another module's state behind its back.
			return nil
		end
		-- SetEvent answers true, or false and a reason ("No match running.", "No such event.", "That
		-- event can't run in this mode."). The reason is logged rather than dropped: a button that
		-- silently does nothing is the thing this panel is least allowed to be.
		local ok, reason = Match.SetEvent(id)
		if not ok then
			return "event " .. id .. " REFUSED: " .. tostring(reason)
		end
		return "event " .. id
	end,

	-- Any crate in CrateData, one at a time (Oliver, 2026-09-22: "add all crates to the admin menu").
	-- The tier is looked up in CrateData like every other id here, and handed over through
	-- CrateService.Give, the same path placements and quests use.
	Crate = function(player, payload)
		local tier = typeof(payload) == "string" and payload or nil
		if not tier or not CrateData.Get(tier) then
			return nil
		end
		local m = modules()
		if not m.Crate.Give(player, tier, 1) then
			return nil
		end
		pcall(m.StateSync.Push, player)
		return "crate " .. tier
	end,

	-- God mode (Oliver, 2026-09-22). An invisible ForceField on the character: Humanoid:TakeDamage does
	-- nothing while one is present, and every damage path in the game goes through TakeDamage
	-- (CombatService.DealDamage for guns, blasts, companions and hazards; StormService for the storm).
	-- The `AdminGod` attribute carries it across respawns until it's switched off.
	God = function(player, payload)
		local on = payload == true
		player:SetAttribute("AdminGod", on or nil)
		local function apply(character)
			if not character then
				return
			end
			local existing = character:FindFirstChild("AdminGod")
			if player:GetAttribute("AdminGod") then
				if not existing then
					local field = Instance.new("ForceField")
					field.Name = "AdminGod"
					field.Visible = false
					field.Parent = character
				end
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health &gt; 0 then
					humanoid.Health = humanoid.MaxHealth
				end
			elseif existing then
				existing:Destroy()
			end
		end
		apply(player.Character)
		if not godWatched[player] then
			godWatched[player] = true
			player.CharacterAdded:Connect(function(character)
				character:WaitForChild("Humanoid", 5)
				apply(character)
			end)
		end
		return "god " .. tostring(on)
	end,

	Fly = function(player, payload)
		local on = payload == true
		-- The attribute is the contract with the movement tab: MovementSanity would otherwise read
		-- flight as a speed hack and act on it. Set server-side so the client cannot award itself
		-- the exemption; claude-af [0bccf5] honours it in the sanity check.
		player:SetAttribute("AdminFly", on or nil)
		return "fly " .. tostring(on)
	end,
}

action.OnServerEvent:Connect(function(player, kind, payload)
	-- The gate. Everything below it has already proved who is asking.
	if not isAdmin(player) then
		return
	end
	-- Rate-limited even for the admin: the gate says who may ask, this says how often, so a stuck
	-- button cannot flood the server.
	if not RateLimit.Take(player, "AdminAction") then
		return
	end
	local handler = typeof(kind) == "string" and HANDLERS[kind]
	if not handler then
		return
	end
	local ok, detail = pcall(handler, player, payload)
	if not ok then
		log(player, "FAILED " .. kind, tostring(detail))
		return
	end
	if detail then
		log(player, "granted", detail)
	end
end)

-- The client is TOLD it is admin; it never asks. Nothing answers a "am I admin?" question, so there
-- is no remote a normal player can call to find out, and no timing difference to measure.
local function greet(player)
	if isAdmin(player) then
		hello:FireClient(player)
		log(player, "panel enabled")
	end
end

Players.PlayerAdded:Connect(greet)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(greet, player)
end

-- Flight does not outlive the session it was granted in. The attribute would vanish with the Player
-- Instance anyway, but clearing it explicitly means nothing that cached a reference to this Player
-- (a probe, another system) can read a stale "still flying" after this fires.
Players.PlayerRemoving:Connect(function(player)
	if isAdmin(player) then
		player:SetAttribute("AdminFly", nil)
	end
end)

AdminService.Actions = HANDLERS

return AdminService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX71"><Properties><string name="Name">AuraService</string><ProtectedString name="Source">-- Renders equipped aura cosmetics on characters.
--
-- Auras were purchasable — and handed out by the Brainrot Pass — but nothing ever drew them,
-- so buying one did nothing at all. They're a soft tinted glow plus drifting particles,
-- visible to everyone. The light casts shadows and particles don't render through geometry,
-- so an aura never doubles as a way to spot someone hiding behind cover.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CosmeticData = require(Shared:WaitForChild("CosmeticData"))

local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local AuraService = {}

local AURA_NAME = "CosmeticAura"

-- The emitter every aura had before designs could declare their own. Any aura without an `aura` field
-- is built from exactly this, so the fifteen that shipped are untouched by the layer system.
local DEFAULT_LAYER = {
	size = 0.55,
	transparency = 0.3,
	lifetime = { 0.8, 1.4 },
	rate = 14,
	speed = { 1.5, 3 },
	spread = 180,
	rise = 2.5,
}

function AuraService.Apply(player, character)
	character = character or player.Character
	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local existing = root:FindFirstChild(AURA_NAME)
	if existing then
		existing:Destroy()
	end

	local data = PlayerData.Get(player)
	local auraId = data and data.Cosmetics.aura
	local item = auraId and CosmeticData.Get(auraId)
	if not item or item.kind ~= "Aura" then
		return
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = AURA_NAME

	-- An aura used to be one emitter driven by one colour, which made fifteen cosmetics that differed
	-- only in hue. A design may now declare `aura.layers`, each layer its own emitter, so an aura can
	-- be heavy puffs that sink, a fast spit of needles, or a trail with sparks in it. Layers are
	-- ParticleEmitters and nothing else -- no per-frame work, and the whole thing still replicates as
	-- one attachment. An entry with no `aura` field gets DEFAULT_LAYER, which is the emitter that
	-- shipped, value for value, so every existing aura renders exactly as it does today.
	local design = item.aura or {}
	for _, layer in ipairs(design.layers or { DEFAULT_LAYER }) do
		local emitter = Instance.new("ParticleEmitter")
		local tint = layer.color or item.color
		-- No Texture set: ParticleEmitter falls back to Roblox's built-in sparkle, so this needs
		-- no uploaded asset.
		if layer.fade then
			emitter.Color = ColorSequence.new(tint, layer.fade)
		else
			emitter.Color = ColorSequence.new(tint)
		end
		emitter.LightEmission = layer.lightEmission or 0.8
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, layer.size or 0.55),
			NumberSequenceKeypoint.new(1, layer.endSize or 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, layer.transparency or 0.3),
			NumberSequenceKeypoint.new(1, 1),
		})
		local life = layer.lifetime or { 0.8, 1.4 }
		emitter.Lifetime = NumberRange.new(life[1], life[2])
		emitter.Rate = layer.rate or 14
		local speed = layer.speed or { 1.5, 3 }
		emitter.Speed = NumberRange.new(speed[1], speed[2])
		local spread = layer.spread or 180
		emitter.SpreadAngle = Vector2.new(spread, spread)
		emitter.Acceleration = Vector3.new(0, layer.rise or 2.5, 0)
		emitter.Drag = layer.drag or 0
		emitter.Rotation = NumberRange.new(layer.rotation or 0, layer.rotation or 0)
		emitter.RotSpeed = NumberRange.new(-(layer.spin or 0), layer.spin or 0)
		emitter.Parent = attachment
	end

	local light = Instance.new("PointLight")
	light.Color = design.lightColor or item.color
	light.Range = design.lightRange or 10
	light.Brightness = design.lightBrightness or 1.2
	light.Shadows = true
	light.Parent = attachment

	-- Parented last, with every emitter and the light already on it, so the aura replicates as one
	-- piece rather than several steps onto a character that is already live.
	attachment.Parent = root
end

function AuraService.Start()
	local function hook(player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			AuraService.Apply(player, character)
		end)
		if player.Character then
			AuraService.Apply(player, player.Character)
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end
	Players.PlayerAdded:Connect(hook)
end

return AuraService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX72"><Properties><string name="Name">BattlePassService</string><ProtectedString name="Source">-- Brainrot Pass: XP and tier claims on two tracks, plus the daily login streak.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BattlePassData = require(Shared:WaitForChild("BattlePassData"))
local BrainrotData = require(Shared:WaitForChild("BrainrotData"))
local CosmeticData = require(Shared:WaitForChild("CosmeticData"))
local DailySpinData = require(Shared:WaitForChild("DailySpinData"))
local GamepassConfig = require(Shared:WaitForChild("GamepassConfig"))
local Rarity = require(Shared:WaitForChild("Rarity"))

local CrateService = require(script.Parent:WaitForChild("CrateService"))
local Monetization = require(script.Parent:WaitForChild("Monetization"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))
local StateSync = require(script.Parent:WaitForChild("StateSync"))

local BattlePassService = {}

-- The pass tier as a Player attribute, so nameplates can show it without a remote.
function BattlePassService.SyncTier(player)
	local data = PlayerData.Get(player)
	if data then
		player:SetAttribute("PassTier", BattlePassData.TierForXp(data.Pass.xp))
	end
end

function BattlePassService.AddXp(player, amount)
	local data = PlayerData.Get(player)
	if not data or amount &lt;= 0 then
		return
	end

	local before = BattlePassData.TierForXp(data.Pass.xp)
	data.Pass.xp += amount
	local after = BattlePassData.TierForXp(data.Pass.xp)

	if after &gt; before then
		StateSync.Notify(player, string.format("Brainrot Pass tier %d unlocked!", after))
		BattlePassService.SyncTier(player)
	end

	-- Set by Bootstrap to ProgressionService.OnPassXp: the same XP also feeds Rot Rank.
	if BattlePassService.OnXp then
		BattlePassService.OnXp(player, amount)
	end
end

-- Hands out the first cosmetic in the pool the player doesn't already own. Falls back to
-- coins once they own everything, so a tier reward is never a dead slot.
-- Coins here all go through Monetization.EarnCoins, so the 2x SahurCoins pass doubles pass rewards
-- and Daily Spin coins the same as every other earned coin.
local function grantCosmetic(player, data, poolName)
	local pool = BattlePassData.CosmeticPools[poolName] or {}
	for _, id in ipairs(pool) do
		if not data.Cosmetics.owned[id] then
			data.Cosmetics.owned[id] = true
			local item = CosmeticData.Get(id)
			return string.format("Unlocked cosmetic: %s", item and item.name or id)
		end
	end
	local granted = Monetization.EarnCoins(player, 1000)
	return string.format("Already own every cosmetic on this track — %d SahurCoins instead.", granted)
end

local function applyReward(player, data, reward)
	if reward.kind == "Coins" then
		local granted = Monetization.EarnCoins(player, reward.amount)
		return string.format("+%d SahurCoins", granted)
	elseif reward.kind == "Crate" then
		CrateService.Give(player, reward.crate, 1)
		return string.format("+1 %s Crate", reward.crate)
	elseif reward.kind == "Cosmetic" then
		return grantCosmetic(player, data, reward.pool)
	end
	return "Reward granted."
end

function BattlePassService.ClaimTier(player, tier, track)
	-- Whole numbers only. 1.5 or NaN passed the range check and then indexed a tier that
	-- doesn't exist; `tier % 1 ~= 0` also rejects NaN and infinity.
	if type(tier) ~= "number" or tier % 1 ~= 0 or tier &lt; 1 or tier &gt; BattlePassData.MaxTier then
		return false, "Invalid tier."
	end
	if track ~= "free" and track ~= "premium" then
		return false, "Invalid track."
	end

	local data = PlayerData.Get(player)
	if not data then
		return false, "Profile still loading."
	end

	if BattlePassData.TierForXp(data.Pass.xp) &lt; tier then
		return false, "You haven't reached that tier yet."
	end

	if track == "premium" and not Monetization.Owns(player, "BrainrotPassPremium") then
		return false, "Premium track requires Brainrot Pass Premium."
	end

	local claimed = track == "premium" and data.Pass.claimedPremium or data.Pass.claimedFree
	if claimed[tostring(tier)] then
		return false, "Already claimed."
	end

	local reward = BattlePassData.Tiers[tier][track]
	local message = applyReward(player, data, reward)
	claimed[tostring(tier)] = true

	StateSync.Push(player)
	return true, message
end

-- Every unlocked, unclaimed tier on both tracks (premium only if owned) in one go, with a
-- single profile push. Claiming a backlog tier by tier pushed the profile — and re-rendered the
-- whole Pass tab — once per reward.
function BattlePassService.ClaimAll(player)
	local data = PlayerData.Get(player)
	if not data then
		return false, "Profile still loading."
	end

	local reached = math.min(BattlePassData.TierForXp(data.Pass.xp), BattlePassData.MaxTier)
	local tracks = Monetization.Owns(player, "BrainrotPassPremium") and { "free", "premium" } or { "free" }

	local count = 0
	for tier = 1, reached do
		for _, track in ipairs(tracks) do
			local claimed = track == "premium" and data.Pass.claimedPremium or data.Pass.claimedFree
			if not claimed[tostring(tier)] then
				applyReward(player, data, BattlePassData.Tiers[tier][track])
				claimed[tostring(tier)] = true
				count += 1
			end
		end
	end

	if count == 0 then
		return false, "Nothing to claim yet."
	end

	StateSync.Push(player)
	return true, string.format("Claimed %d pass reward%s.", count, count == 1 and "" or "s")
end

-- The Daily Spin's prize for a segment (DailySpinData), applied to the profile. Returns what it
-- was, in words.
local function applySpinPrize(player, data, segment)
	if segment.kind == "Coins" then
		local amount = math.floor(segment.amount * DailySpinData.StreakMultiplier(data.Daily.streak))
		local granted = Monetization.EarnCoins(player, amount)
		return string.format("+%d SahurCoins", granted)
	elseif segment.kind == "Crate" then
		CrateService.Give(player, segment.crate, 1)
		return string.format("+1 %s Crate", segment.crate)
	elseif segment.kind == "Accessory" then
		local rarity = Rarity.Roll(segment.rarities)
		local pool = {}
		for _, id in ipairs(CosmeticData.OfKind("Accessory", true)) do
			local item = CosmeticData.Get(id)
			if item.rarity == rarity and not data.Cosmetics.owned[id] then
				table.insert(pool, item)
			end
		end
		-- Nothing left at that rarity: any unowned accessory, then coins.
		if #pool == 0 then
			for _, id in ipairs(CosmeticData.OfKind("Accessory", true)) do
				if not data.Cosmetics.owned[id] then
					table.insert(pool, CosmeticData.Get(id))
				end
			end
		end
		if #pool == 0 then
			return string.format("+%d SahurCoins (you own every accessory!)", Monetization.EarnCoins(player, 2000))
		end
		local item = pool[math.random(1, #pool)]
		data.Cosmetics.owned[item.id] = true
		return string.format("the %s accessory (%s)", item.name, item.rarity)
	elseif segment.kind == "Brainrot" then
		local rarity = Rarity.Roll(segment.rarities)
		local def = BrainrotData.RandomOfRarity(rarity)
		if not def then
			return string.format("+%d SahurCoins", Monetization.EarnCoins(player, 2000))
		end
		table.insert(data.Brainrots, def.name)
		return string.format("%s — a %s brainrot!", def.name, def.rarity)
	elseif segment.kind == "TempPass" then
		local choices = {}
		for key in pairs(GamepassConfig.Passes) do
			-- Never the Premium pass: a day of it would let CLAIM ALL keep every premium tier for good.
			if key ~= "BrainrotPassPremium" and not Monetization.GetPasses(player)[key] and not Monetization.TempRemaining(player, key) then
				table.insert(choices, key)
			end
		end
		if #choices == 0 then
			return string.format("+%d SahurCoins (you have every pass already)", Monetization.EarnCoins(player, 2000))
		end
		table.sort(choices)
		local key = choices[math.random(1, #choices)]
		-- Monetization.Owns reads TempPasses live. (This used to call Monetization.Clear too, which
		-- dropped the cached passes the player had PAID for until they rejoined.)
		data.TempPasses[key] = os.time() + (segment.hours or 24) * 3600
		return string.format("%s for %d hours!", GamepassConfig.Passes[key].name, segment.hours or 24)
	end
	return "a prize"
end

-- One spin a day. Returns ok, message, and the segment the wheel should stop on.
function BattlePassService.ClaimDaily(player)
	local data = PlayerData.Get(player)
	if not data then
		return false, "Profile still loading."
	end

	local today = StateSync.CurrentDay()
	if data.Daily.lastClaimDay &gt;= today then
		return false, "Already spun today. Come back tomorrow."
	end

	-- Consecutive day continues the streak; any gap starts over at day 1.
	if data.Daily.lastClaimDay == today - 1 then
		data.Daily.streak += 1
	else
		data.Daily.streak = 1
	end
	data.Daily.lastClaimDay = today

	local index = DailySpinData.Roll()
	local segment = DailySpinData.Segments[index]
	local prize = applySpinPrize(player, data, segment)
	local multiplier = DailySpinData.StreakMultiplier(data.Daily.streak)

	-- The login streak's own prize (#77), on top of the wheel: day N of the seven-day table, then
	-- round again. StateSync's nextIndex already names the one this lands on.
	local dayIndex = (data.Daily.streak - 1) % BattlePassData.DailyCycle + 1
	local streakPrize = applyReward(player, data, BattlePassData.DailyRewards[dayIndex])

	StateSync.Push(player)
	return true, string.format("Daily Spin: %s   (day %d streak%s)   •   Day %d bonus: %s", prize, data.Daily.streak,
		multiplier &gt; 1 and string.format(", coins x%.1f", multiplier) or "", dayIndex, streakPrize), index
end

return BattlePassService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX73"><Properties><string name="Name">BotNav</string><ProtectedString name="Source">-- How bots get from A to B. BotService decides where a bot wants to be; this module gets it there:
-- queued path requests, following a route, checking a step is safe before taking it, finding cover,
-- and a stuck ladder for when none of that worked.
--
-- Requests are queued, not dropped. ComputeAsync is expensive, so only a few paths are computed at
-- once. The old cap threw a request away when it was full, and a bot whose request was thrown away
-- walked a straight line toward a goal up to 220 studs off, into whatever stood in between. Now each
-- bot holds at most one request (a newer destination replaces the older one) and requests are
-- served most urgent first.
--
-- Everything here keeps its per-bot state in `bot.nav`, made by BotNav.Attach. Nothing outside
-- BotService and this module reads it.

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local BotNav = {}

BotNav.Priority = { Urgent = 1, Combat = 2, Loot = 3, Wander = 4 }

-- Every ray this module casts goes through here. BotService replaces it with its per-frame ray
-- budget (BotService.RaycastBudget.Cast) when it loads; this default is the same call with no cap,
-- for a probe that requires BotNav on its own. Returns result, granted: granted == false means the
-- frame's rays are spent and the caller answers cautiously ("can't step", reason "budget") without
-- caching. `priority` is "combat", "navigation" or "idle" (the module's own rays are navigation).
function BotNav.CastRay(origin, direction, params, priority)
	return workspace:Raycast(origin, direction, params), true
end
-- The same budget for a driving bot's block sweeps (BotService hands in RaycastBudget.Spend and
-- .Remaining): Spend counts one query and says whether it was granted; Remaining is what a priority
-- may still spend this frame. These defaults are uncapped.
function BotNav.CastSpend(priority)
	return true
end
function BotNav.CastRemaining(priority)
	return math.huge
end

-- Counters for tools/bot_probe.lua. Cheap increments; nothing reads them in a match.
BotNav.Stats = {
	pathRequests = 0, pathReused = 0, pathShared = 0, pathOk = 0, pathFail = 0, pathTime = 0, pathDiscarded = 0,
	queueWait = 0, queueWaitMax = 0, queuePeak = 0,
	fallbackMoves = 0, pathMoves = 0, lookAheads = 0, blocked = 0,
	jumps = 0, sidesteps = 0, hops = 0, parkour = 0, parkourFromJump = 0, abandons = 0, recovers = 0,
	directBlocked = 0, parkourAttempts = 0, waypointsSkipped = 0, offRoute = 0,
}
local STATS = BotNav.Stats

-- How many PathfindingService computes run at once; the rest wait in Pump's priority queue. A bot
-- whose route is waiting does not freeze: BotNav.Follow's direct-line fallback walks it,
-- floor-checked, until the route lands, so the cap trades route freshness for frame time. Each
-- ComputeAsync costs 77-120 ms of server time, and Oliver's complaint is lag (#126/#131). Measured
-- (tools/bot_probe.lua free roam; the A/B on ONE map build, 40 bots, 110 s a pass, 2026-09-22):
--   cap 4 : worst tick 43.0 ms, think 53 us/bot-update, route wait avg 0.20 s max 1.35 s, 0 rejected
--   cap 6 : worst tick 40.9 ms, think 64 us/bot-update, route wait avg 0.18 s max 1.36 s, 0 rejected
--   cap 16: that A/B pass was lost (Studio closed itself at 292 s); its only figure is run 14 on
--           another seed, worst tick 116 ms / 87 us, against 36-64 ms for cap 4 over four earlier runs.
-- 15 is Oliver's call ("make it 15", 2026-09-22, after "cap it at 10"), one under the 16 that cost
-- frames on the other seed. Measured at 15 on its own build (run 15a, 40 bots, 150 s free roam, a
-- third seed): worst tick 32.4 ms, think 38 us/bot-update, route wait max 0.24 s, 0 rejected, 2% of
-- paths failed. Change it only with an A/B on one snapshot; BotNav.Stats.queueWaitMax and
-- BotService.Stats.maxTick are the numbers to read.
local MAX_CONCURRENT_PATHS = 15

-- How many of those computes one Pump may START. The cap above bounds how many run at once, but
-- not how many begin in the same frame: a burst of requests (the drop, a storm phase, a fight
-- breaking up) started up to 15 ComputeAsync calls in one think tick, and the cap A/B above is
-- the evidence that computes started together cost frame time. Pump runs every think slice
-- (BotService.ThinkSlices a BotThinkInterval, about 15 a second), so 3 a pump is ~45 starts a second,
-- still room for every one of 50 bots to start a route inside about a second; the most urgent
-- still go first. tools/perf_bot_cost.py counts starts per pump.
local MAX_STARTS_PER_PUMP = 3

-- A destination this close to where the current route already ends keeps the route.
local REUSE_RADIUS = 10

-- A waypoint counts as reached within this many flat studs, and only when the bot is at its height.
-- The old test was 7 flat studs and ignored height, so bots turned early round every corner and
-- clipped the wall they were turning round, and "reached" a waypoint on the floor above them.
local ADVANCE_FLAT = 4
local ADVANCE_RISE = 5

-- Waypoints sit on the floor, so everything here needs to know how far the root is above the feet.
-- It is NOT a constant: crouching and sliding lower the rig by about a stud (MatchService.updateHeight
-- scales HipHeight), and a body measured as 3 studs tall while it is actually 2 would read floors,
-- drops, ledges and climb heights a stud out. This is the same expression Shared/Parkour and
-- MovementClient use, so their measurements and these agree by construction.
local ROOT_ABOVE_FLOOR = 3 -- the default R15 figure, used only when there's no rig to ask

local function footHeight(character, root)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and root then
		return humanoid.HipHeight + root.Size.Y / 2
	end
	return ROOT_ABOVE_FLOOR
end
BotNav.FootHeight = footHeight

local JUMP_TRIGGER = 6

-- The furthest a bot will walk off an edge on purpose. It is this high only because nothing in the
-- game does fall damage (checked across the server), so the question is just whether it can get out
-- again: a wall top or a low roof is fine, a void or a pit is not. If fall damage is ever added, this
-- has to come back down to a drop a bot can take. (At 6 a bot that had climbed a 9-stud wall was
-- stranded on top of it.)
local MAX_STEP_DOWN = 14

local AGENT = {
	AgentRadius = 2.5,
	AgentHeight = 6,
	AgentCanJump = true,
	AgentMaxSlope = 55,
	-- Swimming is slow and leaves a bot a sitting duck, so a bridge is worth a real detour.
	Costs = { Water = 20 },
}

-- A surface this upright is ground you can walk up, not a wall (the agent's max slope).
local WALKABLE_NORMAL_Y = math.cos(math.rad(AGENT.AgentMaxSlope))
local MAX_RISE_PER_STUD = math.tan(math.rad(AGENT.AgentMaxSlope))
-- A kerb or step walked straight up, on top of any slope.
local MAX_STEP_UP = 3

local inFlight = 0
local waiting = {}

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function flatDistance(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

--------------------------------------------------------------------------------
-- Per-bot state
--------------------------------------------------------------------------------

function BotNav.Attach(bot)
	bot.nav = {
		waypoints = nil,
		index = 1,
		routeEnd = nil,
		blockedConnection = nil,
		jumpedIndex = 0,
		lookAheadAt = 0,

		request = nil, -- { destination, priority, at, id }
		computing = nil, -- id of the request being computed
		nextId = 0,
		failures = 0, -- consecutive failed computes

		moveTarget = nil, -- the point Follow last walked toward
		lastFailure = nil,
		lastFailureAt = 0,

		progressAt = 0,
		progressPosition = nil,
		progressDistance = nil,
		stuckSince = nil,
		stage = 0,
		detour = nil,
		detourUntil = 0,
		lastHopAt = 0,
		lastGood = nil,
		lastGoodAt = 0,
		groundY = nil, -- feet height of the last surface stood on, for parkour
		climbing = false, -- a jump-then-climb attempt is watching the jump
	}
	return bot.nav
end

local function disconnectBlocked(nav)
	if nav.blockedConnection then
		nav.blockedConnection:Disconnect()
		nav.blockedConnection = nil
	end
end

-- Forget the route (and any request still waiting). A computation already in flight finishes, but
-- its result is thrown away.
function BotNav.Drop(bot)
	local nav = bot.nav
	if not nav then
		return
	end
	disconnectBlocked(nav)
	nav.waypoints = nil
	nav.routeEnd = nil
	nav.request = nil
	nav.computing = nil
	nav.detour = nil
	nav.detourUntil = 0
end

function BotNav.HasRoute(bot)
	local nav = bot.nav
	return nav ~= nil and nav.waypoints ~= nil and nav.index &lt;= #nav.waypoints
end

function BotNav.IsPending(bot)
	local nav = bot.nav
	return nav ~= nil and (nav.request ~= nil or nav.computing ~= nil)
end

-- Where the current route or the request after it is headed, if anywhere.
function BotNav.Destination(bot)
	local nav = bot.nav
	if not nav then
		return nil
	end
	return nav.request and nav.request.destination or nav.routeEnd
end

--------------------------------------------------------------------------------
-- Path requests
--------------------------------------------------------------------------------

local sharedRoute, rememberRoute, adoptRoute

-- Ask for a route. Returns immediately; the route arrives in `bot.nav` when its turn comes. A
-- destination next to where the bot is already going is not recomputed, nor one a compute is
-- already in flight for, and a route a neighbour just had computed to the same place is copied
-- rather than computed again (route sharing, below).
function BotNav.Request(bot, destination, priority)
	local nav = bot.nav
	if not nav or not destination then
		return
	end
	priority = priority or BotNav.Priority.Wander
	STATS.pathRequests += 1

	if nav.routeEnd and BotNav.HasRoute(bot) and (nav.routeEnd - destination).Magnitude &lt; REUSE_RADIUS and not nav.request then
		STATS.pathReused += 1
		return
	end
	if nav.computing and nav.computingTo and (nav.computingTo - destination).Magnitude &lt; REUSE_RADIUS then
		-- The answer is already on its way: asking again would compute the same route twice and
		-- throw the first away.
		STATS.pathReused += 1
		return
	end
	local pending = nav.request
	if pending and (pending.destination - destination).Magnitude &lt; REUSE_RADIUS then
		-- Same place: keep its place in the queue, but take the more urgent priority.
		pending.priority = math.min(pending.priority, priority)
		pending.destination = destination
		return
	end
	if adoptRoute(bot, destination) then
		return
	end

	nav.nextId += 1
	local fresh = { destination = destination, priority = priority, at = tick(), id = nav.nextId }
	if not pending then
		table.insert(waiting, bot)
	else
		-- Replacing a waiting request keeps the time it has already waited.
		fresh.at = pending.at
	end
	nav.request = fresh
	STATS.queuePeak = math.max(STATS.queuePeak, #waiting)
end

-- ROUTE SHARING. In a team mode most of a side asks for the same place (the hill, the base's
-- chests, the squad's sighting) from the same few spawn points, and at the drop a knot of bots
-- lands together and heads for the same town: each of those was its own ComputeAsync at 77-120 ms.
-- A route that succeeded in the last ROUTE_SHARE_SECONDS, from within ROUTE_SHARE_START of where
-- this bot stands, to within REUSE_RADIUS of where it wants to go, is copied instead: the bot
-- joins it at the waypoint nearest to itself and walks the rest. The waypoint list is shared
-- read-only (Follow only reads it). A shared route has no Path.Blocked watcher; the stuck ladder
-- covers a barricade dropped across it, as it does for any route that goes stale. Only the last
-- ROUTE_SHARE_KEEP routes are kept; anything older than the window is useless anyway.
-- tools/perf_bot_cost.py counts computes for N bots asking for one place (before: N; after: at
-- most the first pump's starts) and checks a bot standing far from the route's start never adopts it.
local ROUTE_SHARE_START = 12
local ROUTE_SHARE_SECONDS = 8
local ROUTE_SHARE_KEEP = 32
local recentRoutes, recentRouteIndex = {}, 0

function rememberRoute(start, destination, waypoints)
	if #waypoints &lt; 2 then
		return
	end
	recentRouteIndex = recentRouteIndex % ROUTE_SHARE_KEEP + 1
	local slot = recentRoutes[recentRouteIndex]
	if not slot then
		slot = {}
		recentRoutes[recentRouteIndex] = slot
	end
	-- tick(): a wall-clock window; os.clock() is CPU time in Roblox (COORDINATION.md).
	slot.start, slot.destination, slot.waypoints, slot.at = start, destination, waypoints, tick()
end

function sharedRoute(position, destination, now)
	for index = 1, #recentRoutes do
		local route = recentRoutes[index]
		if now - route.at &lt; ROUTE_SHARE_SECONDS and (route.destination - destination).Magnitude &lt; REUSE_RADIUS
			and flatDistance(route.start, position) &lt; ROUTE_SHARE_START then
			return route
		end
	end
	return nil
end

-- Take a neighbour's recent route to `destination` if there is one. Returns true when the bot now
-- has a route.
function adoptRoute(bot, destination)
	local nav = bot.nav
	local position = bot.character:GetPivot().Position
	local route = sharedRoute(position, destination, tick())
	if not route then
		return false
	end
	local waypoints = route.waypoints
	-- Join at the waypoint nearest the bot (never the very last: that is the destination itself).
	local nearest, nearestDistance = 1, math.huge
	for index = 1, #waypoints - 1 do
		local distance = flatDistance(waypoints[index].Position, position)
		if distance &lt; nearestDistance then
			nearest, nearestDistance = index, distance
		end
	end
	STATS.pathShared += 1
	disconnectBlocked(nav)
	nav.waypoints = waypoints
	nav.index = math.min(nearest + 1, #waypoints)
	nav.routeEnd = destination
	nav.jumpedIndex = 0
	nav.failures = 0
	nav.request = nil
	nav.computing = nil
	return true
end

local function compute(bot, request)
	local nav = bot.nav
	nav.computing = request.id
	nav.computingTo = request.destination
	inFlight += 1
	local waited = tick() - request.at
	STATS.queueWait += waited
	STATS.queueWaitMax = math.max(STATS.queueWaitMax, waited)

	task.spawn(function()
		local path = PathfindingService:CreatePath(AGENT)
		local started = tick()
		local from = bot.character:GetPivot().Position
		local ok = pcall(function()
			path:ComputeAsync(from, request.destination)
		end)
		-- Wall time, like `started`: ComputeAsync yields, so CPU time across it measures other work.
		STATS.pathTime += tick() - started
		inFlight -= 1

		-- Dropped, replaced, or the bot is gone: this answer is for a question nobody is asking now.
		if bot.nav ~= nav or nav.computing ~= request.id or not bot.character.Parent then
			STATS.pathDiscarded += 1
			return
		end
		nav.computing = nil

		if ok and path.Status == Enum.PathStatus.Success then
			STATS.pathOk += 1
			disconnectBlocked(nav)
			nav.waypoints = path:GetWaypoints()
			nav.index = math.min(2, #nav.waypoints) -- the first waypoint is where we already are
			nav.routeEnd = request.destination
			nav.jumpedIndex = 0
			nav.failures = 0
			rememberRoute(from, request.destination, nav.waypoints)
			-- A barricade thrown down or a car parked across the route after it was computed.
			nav.blockedConnection = path.Blocked:Connect(function(blockedIndex)
				if bot.nav == nav and nav.waypoints and blockedIndex &gt;= nav.index then
					STATS.blocked += 1
					disconnectBlocked(nav)
					nav.waypoints = nil
					nav.routeEnd = nil
				end
			end)
		else
			STATS.pathFail += 1
			-- Failures count per destination: one failed loot route and then one failed wander leg are
			-- two different problems, not two strikes against the same goal.
			if nav.lastFailure and (nav.lastFailure - request.destination).Magnitude &lt; REUSE_RADIUS then
				nav.failures += 1
			else
				nav.failures = 1
			end
			nav.waypoints = nil
			nav.routeEnd = nil
			nav.lastFailure = request.destination
			nav.lastFailureAt = tick()
		end
	end)
end

-- Serve waiting requests, most urgent then oldest first, while there is capacity. Called by
-- BotService every think tick.
function BotNav.Pump()
	if #waiting == 0 or inFlight &gt;= MAX_CONCURRENT_PATHS then
		return
	end
	-- Drop entries whose request was served, replaced by Drop, or whose bot has gone.
	-- A bot dropped and re-queued can be listed twice; keep one entry.
	local live, listed = {}, {}
	for _, bot in ipairs(waiting) do
		if not listed[bot] then
			listed[bot] = true
			if bot.nav and bot.nav.request and bot.character.Parent and bot.humanoid.Health &gt; 0 then
				table.insert(live, bot)
			elseif bot.nav then
				bot.nav.request = nil
			end
		end
	end
	table.sort(live, function(a, b)
		local ra, rb = a.nav.request, b.nav.request
		if ra.priority ~= rb.priority then
			return ra.priority &lt; rb.priority
		end
		return ra.at &lt; rb.at
	end)
	waiting = live
	local started = 0
	while #waiting &gt; 0 and inFlight &lt; MAX_CONCURRENT_PATHS and started &lt; MAX_STARTS_PER_PUMP do
		started += 1
		local bot = table.remove(waiting, 1)
		local request = bot.nav.request
		if request then
			bot.nav.request = nil
			-- A route to the same place landed for a neighbour while this one waited: take it, and
			-- the start it would have used goes to the next in the queue.
			if adoptRoute(bot, request.destination) then
				started -= 1
			else
				compute(bot, request)
			end
		end
	end
end

-- Whether the last compute toward (near) this destination failed within `window` seconds.
function BotNav.RecentlyFailed(bot, destination, window)
	local nav = bot.nav
	return nav ~= nil and nav.lastFailure ~= nil and tick() - nav.lastFailureAt &lt; (window or 5)
		and (nav.lastFailure - destination).Magnitude &lt; REUSE_RADIUS
end

function BotNav.Clear()
	table.clear(waiting)
	table.clear(recentRoutes)
	recentRouteIndex = 0
	-- In-flight computes finish on their own and find their bot's nav replaced or gone.
end

--------------------------------------------------------------------------------
-- Probes
--------------------------------------------------------------------------------

-- With `nav` given, the params are kept on it and refilled only when the character or the loot /
-- effects folders change: a RaycastParams and a filter table per step check was two allocations for
-- every one of a fighting bot's five-a-replan checks. Without `nav` (a probe, or a caller that will
-- change a field such as IgnoreWater), a fresh one.
local STEP_FOLDERS = { "Loot", "Effects" }
local function stepParams(character, nav)
	local loot, effects = workspace:FindFirstChild(STEP_FOLDERS[1]), workspace:FindFirstChild(STEP_FOLDERS[2])
	if nav then
		local cached = nav.stepParams
		if cached and nav.stepParamsFor == character and nav.stepParamsLoot == loot and nav.stepParamsEffects == effects then
			return cached
		end
	end
	local params = nav and nav.stepParams or RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = { character }
	if loot then
		table.insert(filter, loot)
	end
	if effects then
		table.insert(filter, effects)
	end
	params.FilterDescendantsInstances = filter
	-- Undergrowth, spruce skirts and other walk-through decor are CanCollide false.
	params.RespectCanCollide = true
	if nav then
		nav.stepParams, nav.stepParamsFor, nav.stepParamsLoot, nav.stepParamsEffects = params, character, loot, effects
	end
	return params
end
BotNav.StepParams = stepParams

-- The floor under a point, looked for from `fromY` down to `depth` below it. Returns the hit (or nil
-- over a drop) and whether the ray was granted by the budget. Water counts as floor here; callers
-- that care check the material.
function BotNav.FloorAt(x, z, fromY, depth, params, priority)
	return BotNav.CastRay(Vector3.new(x, fromY, z), Vector3.new(0, -depth, 0), params, priority or "navigation")
end

local STEP_LIFTS = { 0, -1.8 }
local STEP_SHARES = { 0.5, 1 }

-- Can a bot standing at `root` walk straight to `point` without meeting a wall, stepping off a drop
-- or into water? Checks a waist ray and a knee ray along the way, and the floor halfway and at the
-- end. Returns ok, or false plus a reason ("wall", "drop", "water") and, for a wall, how far off it is.
--
-- Hills are not walls. The first version treated any ray hit as a wall and any missing floor as a
-- drop, and on the map's rolling terrain that made bots stand still: the knee ray hits an uphill
-- slope ahead, and a floor ray started at waist height begins inside ground that has risen above it.
-- So a hit whose surface is walkable (normal within the agent's max slope) doesn't block, and a floor
-- ray that finds nothing is tried again from above the highest walkable rise at that distance.
--
-- A fifth answer, false plus "budget", means the frame's ray budget refused a ray: nothing is known
-- about the step, so callers neither take it nor remember the refusal.
function BotNav.CanStep(root, character, point, params, priority)
	params = params or stepParams(character)
	priority = priority or "navigation"
	local origin = root.Position
	local delta = flat(point - origin)
	local distance = delta.Magnitude
	if distance &lt; 0.5 then
		return true
	end
	local direction = delta.Unit

	for _, lift in ipairs(STEP_LIFTS) do
		local hit, granted = BotNav.CastRay(origin + Vector3.new(0, lift, 0), direction * (distance + 1.5), params, priority)
		if not granted then
			return false, "budget"
		end
		if hit and hit.Normal.Y &lt; WALKABLE_NORMAL_Y then
			return false, "wall", flat(hit.Position - origin).Magnitude
		end
	end

	local standing = footHeight(character, root)
	local feet = origin.Y - standing
	for _, share in ipairs(STEP_SHARES) do
		local along = distance * share
		local at = origin + direction * along
		local floor, granted = BotNav.FloorAt(at.X, at.Z, origin.Y + 1, standing + 1 + MAX_STEP_DOWN, params, priority)
		if not granted then
			return false, "budget"
		end
		if not floor then
			-- Maybe uphill: look down from above the steepest rise that's still walkable.
			local rise = along * MAX_RISE_PER_STUD + MAX_STEP_UP
			local above
			above, granted = BotNav.FloorAt(at.X, at.Z, feet + rise + 1, rise + 1 - (standing + 1), params, priority)
			if not granted then
				return false, "budget"
			end
			if above and above.Normal.Y &gt;= WALKABLE_NORMAL_Y then
				floor = above
			end
		end
		if not floor then
			return false, "drop"
		end
		if floor.Material == Enum.Material.Water then
			return false, "water"
		end
		if floor.Position.Y &lt; feet - MAX_STEP_DOWN then
			return false, "drop"
		end
	end
	return true
end

-- A spot within reach that `threatPosition` can't see, with floor under it and room to stand.
-- Returns the point and whether it can be walked to in a straight line; nil when there's nowhere.
--
-- The best cover is usually right behind the thing that blocks the shot, and a straight walk to
-- there goes through that thing. So a hidden spot with a clear walk wins within its ring, but a
-- hidden spot that needs a route round (floor under it, nothing solid where the bot would stand) is
-- accepted too, and the caller paths to it. Rings of 10, 18 and 28 studs, nearest first, eight
-- directions each starting straight away from the threat; callers rate-limit this. `threatCharacter`,
-- when given, is left out of the sight line: the shooter's own gun or arm hides nothing.
--
-- Returns nil, nil, "budget" when the frame's ray budget ran out part way: the search did not
-- happen, and the caller should try again next think rather than count it as a search.
local COVER_DIRECTIONS = 8
local COVER_RADII = { 10, 18, 28 }
-- (origin, radius) -&gt; { floor point... } nearest first, or nil. Set by ModeTeams while a team match's
-- battleground stands (TeamBattleground.CoverNear), cleared at its teardown.
BotNav.CoverHints = nil
function BotNav.FindCover(root, character, threatPosition, radii, isAllowed, threatCharacter, priority)
	priority = priority or "navigation"
	local params = stepParams(character)
	local los = RaycastParams.new()
	los.FilterType = Enum.RaycastFilterType.Exclude
	local losFilter = params.FilterDescendantsInstances
	if threatCharacter then
		table.insert(losFilter, threatCharacter)
	end
	los.FilterDescendantsInstances = losFilter
	-- Water is not cover, and this ray is what decides whether a spot is hidden. Left at the default
	-- (IgnoreWater false) the river counted as something to hide behind, so a hurt bot would have run
	-- INTO the water and stood there. The step checks below deliberately keep water visible, because
	-- there it means "don't walk in".
	los.IgnoreWater = true
	los.RespectCanCollide = true
	local room = OverlapParams.new()
	room.FilterType = Enum.RaycastFilterType.Exclude
	room.FilterDescendantsInstances = params.FilterDescendantsInstances
	room.RespectCanCollide = true

	local origin = root.Position

	-- BEGIN BATTLEGROUND COVER. Built cover first: while a team match's battleground stands
	-- (TeamBattleground, via ModeTeams) it hands over the spots behind its walls, sandbags, crates and
	-- containers, and one of those the threat cannot see beats a point on a ring, which is as likely to
	-- be the middle of a lane. Each is floor-level; a spot more than a step above or below the bot's
	-- feet is someone else's storey. Same hidden test and the same straight-walk test as the rings.
	if BotNav.CoverHints then
		local standing = footHeight(character, root)
		local feet = origin.Y - standing
		local ok, hints = pcall(BotNav.CoverHints, origin, (radii and radii[#radii]) or 28)
		for _, floorPoint in ipairs(ok and type(hints) == "table" and hints or {}) do
			if math.abs(floorPoint.Y - feet) &lt;= 3 then
				local point = Vector3.new(floorPoint.X, floorPoint.Y + standing, floorPoint.Z)
				if not isAllowed or isAllowed(point) then
					local eye = point + Vector3.new(0, 1.5, 0)
					-- Through the ray budget like the rings below; a refusal ends the search unfinished.
					local hit, granted = BotNav.CastRay(threatPosition, eye - threatPosition, los, priority)
					if not granted then
						return nil, nil, "budget"
					end
					if hit and (hit.Position - eye).Magnitude &gt; 2 then
						local ok, reason = BotNav.CanStep(root, character, point, params, priority)
						if ok then
							return point, true
						end
						if reason == "budget" then
							return nil, nil, "budget"
						end
					end
				end
			end
		end
	end
	-- END BATTLEGROUND COVER

	local away = flat(origin - threatPosition)
	local baseAngle = away.Magnitude &gt; 0.1 and math.atan2(away.Z, away.X) or 0
	-- A spot that needs a route round the back is the fallback, and only after every ring has been
	-- tried for one the bot can simply walk to.
	local routed = nil
	for _, radius in ipairs(radii or COVER_RADII) do
		for step = 0, COVER_DIRECTIONS - 1 do
			-- Straight away from the threat first, then fanning out either side of it.
			local offset = (step % 2 == 0 and 1 or -1) * math.ceil(step / 2) * (math.pi * 2 / COVER_DIRECTIONS)
			local angle = baseAngle + offset
			local point = origin + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
			if not isAllowed or isAllowed(point) then
				local eye = point + Vector3.new(0, 1.5, 0)
				local toEye = eye - threatPosition
				local hit, granted = BotNav.CastRay(threatPosition, toEye, los, priority)
				if not granted then
					return nil, nil, "budget"
				end
				if hit and (hit.Position - eye).Magnitude &gt; 2 then
					local ok, reason = BotNav.CanStep(root, character, point, params, priority)
					if ok then
						return point, true
					end
					if reason == "budget" then
						return nil, nil, "budget"
					end
					if not routed then
						local standing = footHeight(character, root)
						local floor
						floor, granted = BotNav.FloorAt(point.X, point.Z, origin.Y + 4, standing + 4 + MAX_STEP_DOWN, params, priority)
						if not granted then
							return nil, nil, "budget"
						end
						if floor and floor.Material ~= Enum.Material.Water and floor.Normal.Y &gt;= WALKABLE_NORMAL_Y then
							local stand = Vector3.new(point.X, floor.Position.Y + standing, point.Z)
							if #workspace:GetPartBoundsInRadius(stand, 1.2, room) == 0 then
								routed = stand
							end
						end
					end
				end
			end
		end
	end
	if routed then
		return routed, false
	end
	return nil
end

--------------------------------------------------------------------------------
-- Following
--------------------------------------------------------------------------------

-- Walking straight at a goal with no route is only safe when the next stretch has floor under it and
-- nothing in the way. Without this check a bot whose route failed walked off the ledge it stood on or
-- into the wall it was facing. Checked at most a few times a second.
local DIRECT_LOOKAHEAD = 10
local DIRECT_RECHECK = 0.6
local DIRECT_MOVED_RECHECK = 4

local function directSafe(bot, root, goal, now, priority)
	local nav = bot.nav
	local distance = flatDistance(root.Position, goal)
	if distance &lt; 1.5 then
		return true
	end
	-- The check looked DIRECT_LOOKAHEAD studs ahead; a sprinting bot covers more than that in
	-- DIRECT_RECHECK seconds, so it's redone once the bot has moved a few studs, not only on the timer.
	-- A wall's distance goes stale the moment the bot steps toward it: parkourAcross walks up to the
	-- wall between checks, and an approach aimed with the old figure lands inside the wall, fails its
	-- own step check, and navigate abandoned the goal (the 9-stud course in run 14: closest approach
	-- 1.7 studs, the bot never asked to climb; run 15b with this line: over the wall at 2.3 s). Walls
	-- are re-measured every think; the cache serves the open-ground, drop and water answers, which
	-- don't change while the bot stands still.
	-- A check the ray budget refused ("budget") is not an answer and is never served from the cache.
	if now - (nav.directCheckedAt or 0) &lt; DIRECT_RECHECK and nav.directReason ~= "wall" and nav.directReason ~= "budget"
		and nav.directGoal and (nav.directGoal - goal).Magnitude &lt; 2
		and nav.directCheckedFrom and flatDistance(root.Position, nav.directCheckedFrom) &lt; DIRECT_MOVED_RECHECK then
		return nav.directOk, nav.directReason, nav.directWallDistance
	end
	local step = math.min(distance, DIRECT_LOOKAHEAD)
	local point = root.Position + flat(goal - root.Position).Unit * step
	local ok, reason, wallDistance = BotNav.CanStep(root, bot.character, point, stepParams(bot.character, nav), priority)
	nav.directCheckedAt = now
	nav.directCheckedFrom = root.Position
	nav.directGoal = goal
	nav.directOk = ok == true
	nav.directReason = reason
	nav.directWallDistance = wallDistance
	return nav.directOk, reason, wallDistance
end

-- A wall straight across the way with no route round it (a garden wall, a crate stack, a pad edge
-- fence) is exactly what a climb or vault is for. Walk up within reach, then ask MovementService;
-- if a climb from standing isn't on, try it from the top of a jump. At most once every
-- PARKOUR_RETRY seconds, so a wall nobody can get over costs one attempt, not one per think.
local PARKOUR_REACH = 1.6
local PARKOUR_RETRY = 3

local climbFromJump -- defined with the stuck ladder below

local function parkourAcross(bot, humanoid, root, goal, wallDistance, now)
	local nav = bot.nav
	if not BotNav.TryParkour or now &lt; (nav.parkourRetryAt or 0) then
		return false
	end
	local direction = flat(goal - root.Position)
	if direction.Magnitude &lt; 0.1 then
		return false
	end
	direction = direction.Unit
	if wallDistance and wallDistance &gt; PARKOUR_REACH + 0.5 then
		local approach = root.Position + direction * (wallDistance - PARKOUR_REACH)
		if not BotNav.CanStep(root, bot.character, approach, stepParams(bot.character, nav)) then
			return false
		end
		nav.moveTarget = approach
		humanoid:MoveTo(approach)
		return true
	end
	nav.parkourRetryAt = now + PARKOUR_RETRY
	STATS.parkourAttempts += 1
	if BotNav.TryParkour(bot.character, direction, nav.groundY) then
		STATS.parkour += 1
		nav.recheckRouteAt = now
		return true
	end
	if humanoid.FloorMaterial ~= Enum.Material.Air then
		climbFromJump(bot, humanoid, root, direction, function() end)
		return true
	end
	return false
end

-- After something carried the bot along faster or further than walking would (a vault, a climb, a
-- slide), the waypoints it went past are behind it: skip each one it can walk straight past, and if
-- it ended well away from the route, drop the route so a fresh one is asked for. Without this a bot
-- that vaulted a fence turned round and walked back to the waypoint on the far side of it.
local OFF_ROUTE = 25

local function catchUpRoute(bot, root)
	local nav = bot.nav
	local waypoints = nav.waypoints
	if not waypoints then
		return
	end
	local position = root.Position
	local standing = footHeight(bot.character, root)
	local feetY = position.Y - standing
	for _ = 1, 6 do
		if nav.index &gt;= #waypoints then
			break
		end
		local current, following = waypoints[nav.index].Position, waypoints[nav.index + 1].Position
		local segment = flat(following - current)
		local passed = segment.Magnitude &gt; 0.1 and flat(position - current):Dot(segment.Unit) &gt; 0.5
		if passed and math.abs(following.Y - feetY) &lt; ADVANCE_RISE + 3
			and BotNav.CanStep(root, bot.character, following + Vector3.new(0, standing, 0), stepParams(bot.character, nav)) then
			nav.index += 1
			STATS.waypointsSkipped += 1
		else
			break
		end
	end
	if flatDistance(position, waypoints[nav.index].Position) &gt; OFF_ROUTE then
		STATS.offRoute += 1
		disconnectBlocked(nav)
		nav.waypoints = nil
		nav.routeEnd = nil
	end
end

-- Walk the route toward `goal`. Without a route (none yet, or it failed) this walks straight at the
-- goal when the way looks clear, which is right for short hops and the best there is while a request
-- waits its turn; when it doesn't, it stands and sets `nav.directBlockedAt`.
-- Returns true while following a real route. `priority` is the ray class for the direct-line check
-- ("idle" for a wandering or looting bot, "navigation" otherwise; see BotNav.CastRay).
function BotNav.Follow(bot, humanoid, root, goal, now, priority)
	local nav = bot.nav
	now = now or tick()

	-- Watching a jump for the moment to climb: keep going the way it was going.
	if nav.climbing then
		return false
	end
	if nav.recheckRouteAt and now &gt;= nav.recheckRouteAt then
		nav.recheckRouteAt = nil
		catchUpRoute(bot, root)
	end

	if nav.detour and now &lt; nav.detourUntil then
		nav.moveTarget = nav.detour
		humanoid:MoveTo(nav.detour)
		return false
	end
	nav.detour = nil

	local waypoints = nav.waypoints
	if not waypoints or nav.index &gt; #waypoints then
		local safe, reason, wallDistance = directSafe(bot, root, goal, now, priority)
		if not safe and reason == "wall" and parkourAcross(bot, humanoid, root, goal, wallDistance, now) then
			return false
		end
		if not safe then
			STATS.directBlocked += 1
			nav.directBlockedAt = now
			nav.moveTarget = nil
			humanoid:MoveTo(root.Position)
			return false
		end
		STATS.fallbackMoves += 1
		nav.moveTarget = goal
		humanoid:MoveTo(goal)
		return false
	end

	local position = root.Position
	local standing = footHeight(bot.character, root)
	local feetY = position.Y - standing
	local waypoint = waypoints[nav.index]
	while flatDistance(position, waypoint.Position) &lt; ADVANCE_FLAT and math.abs(waypoint.Position.Y - feetY) &lt; ADVANCE_RISE do
		nav.index += 1
		if nav.index &gt; #waypoints then
			disconnectBlocked(nav)
			nav.waypoints = nil
			STATS.fallbackMoves += 1
			nav.moveTarget = goal
			humanoid:MoveTo(goal)
			return false
		end
		waypoint = waypoints[nav.index]
	end

	-- Cut a corner only when the straight line to the waypoint after this one is walkable, so a
	-- zig-zag route over open ground smooths out without ever cutting through a wall.
	local nextPoint = waypoints[nav.index + 1]
	if nextPoint and now - nav.lookAheadAt &gt; 1 and waypoint.Action == Enum.PathWaypointAction.Walk
		and nextPoint.Action == Enum.PathWaypointAction.Walk
		and math.abs(nextPoint.Position.Y - feetY) &lt; 2 and humanoid.FloorMaterial ~= Enum.Material.Air then
		nav.lookAheadAt = now
		if BotNav.CanStep(root, bot.character, nextPoint.Position + Vector3.new(0, standing, 0), stepParams(bot.character, nav), priority) then
			STATS.lookAheads += 1
			nav.index += 1
			waypoint = nextPoint
		end
	end

	-- Jump once for each jump waypoint, as it comes into reach. Setting Jump every tick all the way
	-- there made bots bunny-hop along the approach.
	if waypoint.Action == Enum.PathWaypointAction.Jump and nav.jumpedIndex ~= nav.index
		and flatDistance(position, waypoint.Position) &lt; JUMP_TRIGGER and humanoid.FloorMaterial ~= Enum.Material.Air then
		nav.jumpedIndex = nav.index
		humanoid.Jump = true
	end

	STATS.pathMoves += 1
	nav.moveTarget = waypoint.Position
	humanoid:MoveTo(waypoint.Position)
	return true
end

--------------------------------------------------------------------------------
-- Stuck ladder
--------------------------------------------------------------------------------

-- Set by BotService when the movement tab's server parkour exists:
-- (character, forward, groundY) -&gt; kind|nil.
BotNav.TryParkour = nil

-- A wall too tall to climb from standing can still be climbed from the top of a jump: the movement
-- tab measured a 9-stud wall climbable once the feet are about 2.2 studs up. So jump, watch the jump
-- frame by frame (a think tick is too coarse to catch that window), and try again at that height.
local CLIMB_FROM_JUMP_HEIGHT = 2.2
local CLIMB_WATCH_SECONDS = 0.7

function climbFromJump(bot, humanoid, root, forward, onFail)
	local nav = bot.nav
	local groundY = nav.groundY or (root.Position.Y - footHeight(bot.character, root))
	nav.climbing = true
	humanoid.Jump = true
	task.spawn(function()
		local started = tick()
		while tick() - started &lt; CLIMB_WATCH_SECONDS do
			RunService.Heartbeat:Wait()
			if bot.nav ~= nav or not root.Parent or humanoid.Health &lt;= 0 then
				nav.climbing = false
				return
			end
			if root.Position.Y - footHeight(bot.character, root) - groundY &gt;= CLIMB_FROM_JUMP_HEIGHT then
				nav.climbing = false
				if BotNav.TryParkour(bot.character, forward, groundY) then
					STATS.parkour += 1
					STATS.parkourFromJump += 1
					nav.recheckRouteAt = tick()
				else
					onFail()
				end
				return
			end
		end
		nav.climbing = false
		onFail()
	end)
end

local function sidestepPoint(root, character)
	local params = stepParams(character)
	local look = flat(root.CFrame.LookVector)
	look = look.Magnitude &gt; 0.01 and look.Unit or Vector3.new(0, 0, -1)
	local right = Vector3.new(-look.Z, 0, look.X)
	local best, bestRoom = nil, 0
	for _, side in ipairs({ right, -right }) do
		local hit, granted = BotNav.CastRay(root.Position, side * 8, params, "navigation")
		-- A refused ray is no room at all: with both refused the bot backs out, which is safe anywhere.
		local room = not granted and 0 or (hit and (hit.Position - root.Position).Magnitude or 8)
		if room &gt; bestRoom then
			best, bestRoom = side, room
		end
	end
	if not best or bestRoom &lt; 2.5 then
		-- Hemmed in on both sides: back out instead.
		return root.Position - look * 6
	end
	return root.Position + best * math.min(6, bestRoom - 1.5)
end

local function hop(root, humanoid)
	local look = flat(root.CFrame.LookVector)
	look = look.Magnitude &gt; 0.01 and look.Unit or Vector3.new(0, 0, -1)
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	root.AssemblyLinearVelocity = look * 26 + Vector3.new(0, 58, 0)
end

local function playerNear(position, radius)
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and (root.Position - position).Magnitude &lt; radius then
			return true
		end
	end
	return false
end

-- Call once per think tick with whether the bot is trying to get somewhere (`target`, the point it
-- is walking toward right now, normally `bot.nav.moveTarget`; or nil when it is standing still on
-- purpose: holding loot, behind cover, waiting out a reaction). Progress is measured as distance
-- closed on that point, not distance moved, so a bot circling a waypoint it can't reach counts as
-- stuck too; and it is the current waypoint, not the final goal, so walking the long way round a
-- building on a good route never looks like being stuck.
--
-- Returns "abandon" when the caller should give up its current goal, otherwise nil. Everything
-- else on the ladder is handled here: jump, sidestep with a fresh route, parkour or a hop, and as a
-- last resort, well away from any player, a return to the last place it was walking freely.
function BotNav.Progress(bot, humanoid, root, target, now)
	local nav = bot.nav
	if not target then
		nav.stuckSince = nil
		nav.stage = 0
		nav.progressPosition = nil
		return nil
	end

	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	if grounded then
		nav.groundY = root.Position.Y - footHeight(bot.character, root)
	end
	if nav.climbing then
		return nil
	end
	if grounded and flat(root.AssemblyLinearVelocity).Magnitude &gt; 6 and now - nav.lastGoodAt &gt; 3 then
		nav.lastGood = root.Position
		nav.lastGoodAt = now
	end

	local distance = flatDistance(root.Position, target)
	if not nav.progressPosition or now - nav.progressAt &gt;= 1 then
		local closed = nav.progressDistance and (nav.progressDistance - distance) or math.huge
		local moved = nav.progressPosition and flatDistance(root.Position, nav.progressPosition) or math.huge
		-- A target that moved (a new waypoint, a new goal) resets the comparison, so judge that
		-- second on distance moved instead.
		local sameTarget = nav.progressTarget and flatDistance(nav.progressTarget, target) &lt; 2
		local progressed = (sameTarget and closed &gt;= 1.5) or (not sameTarget and moved &gt;= 3) or distance &lt; 3
		nav.progressPosition = root.Position
		nav.progressDistance = distance
		nav.progressTarget = target
		nav.progressAt = now
		if progressed then
			nav.stuckSince = nil
			nav.ladderSince = nil
			nav.recoverTried = false
			nav.stage = 0
			return nil
		end
		nav.stuckSince = nav.stuckSince or (now - 1)
		nav.ladderSince = nav.ladderSince or nav.stuckSince
	end
	if not nav.stuckSince then
		return nil
	end

	-- The rungs run on time since the ladder (re)started; the last resort on time since the bot last
	-- made any progress at all.
	local stuckFor = now - (nav.ladderSince or nav.stuckSince)
	local totalStuck = now - nav.stuckSince
	-- Tried once per stuck spell; if a player is near, the ladder just carries on instead.
	if totalStuck &gt;= 20 and not nav.recoverTried then
		nav.recoverTried = true
		if nav.lastGood and not playerNear(root.Position, 200) and not playerNear(nav.lastGood, 200) then
			STATS.recovers += 1
			BotNav.Drop(bot)
			bot.character:PivotTo(CFrame.new(nav.lastGood))
			return nil
		end
	end
	if nav.stage &lt; 1 and stuckFor &gt;= 1 then
		nav.stage = 1
		if grounded then
			STATS.jumps += 1
			humanoid.Jump = true
		end
	elseif nav.stage &lt; 2 and stuckFor &gt;= 2 then
		nav.stage = 2
		STATS.sidesteps += 1
		local destination = BotNav.Destination(bot) or target
		BotNav.Drop(bot)
		nav.detour = sidestepPoint(root, bot.character)
		nav.detourUntil = now + 0.8
		BotNav.Request(bot, destination, BotNav.Priority.Urgent)
	elseif nav.stage &lt; 3 and stuckFor &gt;= 4 then
		nav.stage = 3
		local look = flat(target - root.Position)
		look = look.Magnitude &gt; 0.1 and look.Unit or flat(root.CFrame.LookVector).Unit
		-- Wedged against something a route keeps walking back into (a fence, a car, a ledge): hop
		-- over it the way a player would with a Rot Rocket. Bots are simulated by the server, so the
		-- push can be applied directly. The fallback when climbing and vaulting don't apply.
		local function hopOver()
			if humanoid.Health &gt; 0 and humanoid.FloorMaterial ~= Enum.Material.Air and tick() - nav.lastHopAt &gt; 6 then
				nav.lastHopAt = tick()
				STATS.hops += 1
				hop(root, humanoid)
			end
		end
		if BotNav.TryParkour then
			STATS.parkourAttempts += 1
		end
		if BotNav.TryParkour and BotNav.TryParkour(bot.character, look, nav.groundY) then
			STATS.parkour += 1
			nav.recheckRouteAt = now
		elseif BotNav.TryParkour and grounded then
			climbFromJump(bot, humanoid, root, look, hopOver)
		elseif grounded then
			hopOver()
		end
	elseif nav.stage &lt; 4 and stuckFor &gt;= 8 then
		STATS.abandons += 1
		BotNav.Drop(bot)
		-- Start the rungs again for whatever the caller picks next.
		nav.stage = 0
		nav.ladderSince = now
		return "abandon"
	end
	return nil
end

--------------------------------------------------------------------------------
-- DRIVING (bot drivers)
--------------------------------------------------------------------------------
-- BotService's BOT VEHICLES section decides WHETHER a bot drives and WHERE to; this section turns
-- that into a throttle, a steer and a handbrake, the same three inputs a player's keys give
-- VehicleDynamics. Nothing here moves a vehicle any other way: a bot drives by the same physics a
-- player does, and can crash, slide and get stuck the same way.
--
--   BotNav.DriveRoute(roads, from, goal, bounds, preferRoads) -&gt; points, roadFlags, onRoads
--   BotNav.NewDrive(chassis, handling, options)  -&gt; drive      (options: wheelbase, params, probeParams)
--   BotNav.DriveTo(drive, goal, options)                       (options: roads, bounds, via, arrive, loiter,
--                                                                preferRoads, maxSpeed)
--   BotNav.DriveSense(drive, now)       -&gt; status   on the bot's own sliced think (BotThinkInterval)
--   BotNav.DriveControl(drive, dt, now) -&gt; throttle, steer, handbrake   every frame
--
-- TWO CLOCKS. Everything that looks at the world is in DriveSense, which runs on the bot's sliced
-- think, four times a second, and makes AT MOST DriveCastsPerSense (4) spatial queries: one sphere
-- swept down the way it is heading (buildings, trees, walls, other vehicles), two feeler rays off
-- the front corners (which side is clearer), and one ray down onto the ground ahead (a river, a
-- drop, a steep slope). DriveControl runs every frame for the handful of bots at a wheel and is
-- arithmetic only: it steers at a point on the route ahead (pure pursuit), and holds the speed under
-- the tightest of what is known: the corners ahead, the obstacle and the hazard DriveSense last
-- found, the people on foot BotService listed (read from their parts, no query), and the goal. Four
-- decisions a second is not enough to steer a car at speed smoothly; four looks a second is plenty
-- to see what is coming, because every look reaches further than the car covers before the next.
--
-- ROUTES. Where the road network makes the trip shorter in time than going straight there (a stud of
-- country counts DRIVE_OFFROAD_COST studs of road), the route joins the nearest road, follows its
-- edges and curves to the one nearest the goal, and leaves it there, keeping DRIVE_LANE to the right
-- of the centre line so two bots meeting on one road pass. `bounds` (the storm's next circle, or a
-- team arena) keeps every road node the route passes inside it; a straight leg between two points
-- inside a circle stays inside it.
--
-- WHAT A DRIVE REPORTS (DriveSense's status): "driving"; "stopping" while it brakes for the goal;
-- "arrived" once stopped there; "hazard" stopped short of water or a drop it cannot go round;
-- "stuck" after DRIVE_STUCK_TRIES reversing manoeuvres that went nowhere; "lost" when the route
-- has made no progress for DRIVE_LOST_AFTER seconds; "flipped" when it has been on its side or roof.
-- BotService gets out (or plans again) on every one of those but "driving" and "stopping".

local DRIVE_CASTS_PER_SENSE = 4
BotNav.DriveCastsPerSense = DRIVE_CASTS_PER_SENSE

local DRIVE_LANE = 3.5            -- studs right of a road's centre line
local DRIVE_OFFROAD_COST = 1.6    -- a stud across country is worth this many studs of road (slower, and less known)
local DRIVE_ROAD_JOIN = 130       -- the network is worth joining only this close to the start and the goal
local DRIVE_ROAD_MIN = 60         -- ...and only for at least this much road
local DRIVE_BRIDGE_CLEAR = 30     -- studs past a bridge's end a route joins or leaves the road (lined up before it)
local DRIVE_CRUISE = 0.86         -- share of top speed a bot cruises at on a road
local DRIVE_OFFROAD_CRUISE = 0.62 -- ...and across country, where the next tree is only four looks away
local DRIVE_LATERAL = 95          -- studs/s^2 of cornering a bot plans for (the tyres hold more; this is the margin)
local DRIVE_DECEL_SHARE = 0.38    -- share of a vehicle's brake it plans to stop with (a look's delay, grip, a slope)
local DRIVE_STOP_MARGIN = 5       -- studs short of an obstacle or a hazard, past its own nose, that it plans to stop
local DRIVE_LOOK_MIN = 9          -- pure pursuit: the point steered at is this far ahead...
local DRIVE_LOOK_PER = 0.42       -- ...plus this many seconds of the current speed
local DRIVE_AVOID_TURN = math.rad(150) -- the most a detour turns from the route (past square: round the back of a wall)
local DRIVE_FEELER_ANGLE = math.rad(28)
local DRIVE_STUCK_SPEED = 2.5     -- slower than this while wanting to go is not going
local DRIVE_STUCK_AFTER = 1.5     -- seconds of it before reversing out
local DRIVE_REVERSE_FOR = 1.4
local DRIVE_STUCK_TRIES = 3       -- reversing manoeuvres before giving the vehicle up
local DRIVE_LOST_AFTER = 25       -- seconds without getting DRIVE_LOST_GAIN studs nearer the end of the route
local DRIVE_LOST_GAIN = 15
local DRIVE_FLIP_UP = 0.3         -- a body whose up points less than this upward is on its side
local DRIVE_FLIP_AFTER = 0.75
local DRIVE_DROP = 8              -- ground ahead this far below the wheels (and steeper than DROP_GRADE) is a drop
local DRIVE_DROP_GRADE = 0.4      -- 22 degrees down: past any road (RoadNetwork holds them under 10%)
local DRIVE_STEEP_DOWN = -0.2     -- a grade ahead steeper than this, downhill, is taken slower
local DRIVE_STOPPED = 3           -- studs/s: stopped, for arriving and for a hazard
local DRIVE_GUARD_HOLD = 2.5      -- seconds stopped for someone on foot before going round them
local DRIVE_DETOUR_SPEED = 32     -- studs/s going round something (a look every ~8 studs at this pace)
local DRIVE_OVERTAKE_CLEAR = 140  -- studs of the other lane that must be free of traffic to pull out
local WATER = Enum.Material.Water

BotNav.DriveStats = { senses = 0, casts = 0, maxCasts = 0, recoveries = 0, hazards = 0, obstacles = 0, blind = 0 }
local DSTATS = BotNav.DriveStats

-- Right of a flat direction, as a CFrame looking along it has it.
local function rightOf(d)
	return Vector3.new(-d.Z, 0, d.X)
end

local function turnFlat(d, angle)
	local c, s = math.cos(angle), math.sin(angle)
	-- Positive turns to the right (clockwise seen from above), as the steer input does.
	return Vector3.new(d.X * c - d.Z * s, 0, d.Z * c + d.X * s)
end

-- The turn from flat unit `a` to flat unit `b`, positive to the right.
local function signedAngle(a, b)
	return math.atan2(rightOf(a):Dot(b), a:Dot(b))
end

-- The same turn measured going round toward `side` (1 right, -1 left), so a detour that has swung
-- past straight back is still on its own side rather than a small turn the other way.
local function sideAngle(a, b, side)
	local angle = signedAngle(a, b) * side
	if angle &lt; -math.rad(10) then
		angle += 2 * math.pi
	end
	return angle
end

local function nearestOnNetwork(roads, point)
	local best, bestEdge, bestDistance = nil, nil, math.huge
	for _, edge in ipairs(roads.edges) do
		if edge.blocked then
			continue
		end
		local a, b = flat(edge.a.position), flat(edge.b.position)
		local ab = b - a
		local length = ab.Magnitude
		if length &gt; 0.01 then
			local t = math.clamp(flat(point - a):Dot(ab) / (length * length), 0, 1)
			local on = a + ab * t
			local distance = flatDistance(point, on)
			if distance &lt; bestDistance then
				best, bestEdge, bestDistance = on, edge, distance
			end
		end
	end
	return best, bestEdge, bestDistance
end

-- A bend built as a curve (RoadNetwork node.curve) as points along its arc, from the tangent nearer
-- `before`. A square corner stays a single point.
local function bendPoints(node, before)
	local curve = node.curve
	if not curve or not curve.centre or not curve.radius or not curve.a1 or not curve.sweep then
		return { flat(node.position) }
	end
	local a1, sweep = curve.a1, curve.sweep
	local centre = flat(curve.centre)
	local first = centre + Vector3.new(math.cos(a1), 0, math.sin(a1)) * curve.radius
	local last = centre + Vector3.new(math.cos(a1 + sweep), 0, math.sin(a1 + sweep)) * curve.radius
	if before and flatDistance(before, last) &lt; flatDistance(before, first) then
		a1, sweep = a1 + sweep, -sweep
	end
	local steps = math.max(2, math.ceil(math.abs(sweep) / math.rad(15)))
	local points = {}
	for k = 0, steps do
		local angle = a1 + sweep * k / steps
		table.insert(points, centre + Vector3.new(math.cos(angle), 0, math.sin(angle)) * curve.radius)
	end
	return points
end

-- Every point moved DRIVE_LANE to the right of the way the polyline runs (along the bisector at a
-- corner, lengthened so both arms keep the lane).
local function keepRight(points)
	local out = {}
	local n = #points
	for k = 1, n do
		local incoming = k &gt; 1 and flat(points[k] - points[k - 1]) or nil
		local outgoing = k &lt; n and flat(points[k + 1] - points[k]) or nil
		incoming = (incoming and incoming.Magnitude &gt; 0.01) and incoming.Unit or nil
		outgoing = (outgoing and outgoing.Magnitude &gt; 0.01) and outgoing.Unit or nil
		local normal
		if incoming and outgoing then
			normal = rightOf(incoming) + rightOf(outgoing)
			if normal.Magnitude &lt; 0.2 then
				normal = rightOf(incoming)
			else
				normal = normal.Unit / math.max(0.5, normal.Unit:Dot(rightOf(incoming)))
			end
		else
			normal = rightOf(incoming or outgoing or Vector3.new(0, 0, -1))
		end
		out[k] = points[k] + normal * DRIVE_LANE
	end
	return out
end

-- The route from `from` to `goal`: a list of flat points ending at the goal, a flag per point saying
-- whether the leg ending there is road, and whether the network was used. `bounds` = { center, radius }
-- keeps road nodes inside it; `preferRoads` takes the network whenever it reaches both ends (after a
-- hazard stopped a straight run), rather than only when it is quicker.
-- A piece of road or bridge broke at `position` (DestructibleService.OnRoadBroken): every edge of the
-- network it lay on is closed to bot drivers for the rest of the map, so a route never takes a car
-- into the hole or off the end of a fallen bridge. (Holes are for good: nothing rebuilds a road.)
-- Returns how many edges it closed.
function BotNav.BlockRoadAt(roads, position, size)
	local edges = roads and roads.edges
	if not edges then
		return 0
	end
	local reach = (size and math.max(size.X, size.Z) / 2 or 0) + 12
	local closed = 0
	for _, edge in ipairs(edges) do
		if not edge.blocked then
			local a, b = flat(edge.a.position), flat(edge.b.position)
			local ab = b - a
			local length = ab.Magnitude
			local t = length &gt; 0.01 and math.clamp(flat(position - a):Dot(ab) / (length * length), 0, 1) or 0
			if flatDistance(position, a + ab * t) &lt;= reach then
				edge.blocked = true
				closed += 1
			end
		end
	end
	return closed
end

function BotNav.DriveRoute(roads, from, goal, bounds, preferRoads)
	local direct = { flat(goal) }
	local directFlags = { false }
	local edges = roads and roads.edges
	if not edges or #edges == 0 then
		return direct, directFlags, false
	end
	local entry, entryEdge, entryGap = nearestOnNetwork(roads, from)
	local exit, exitEdge, exitGap = nearestOnNetwork(roads, goal)
	if not entry or not exit or entryGap &gt; DRIVE_ROAD_JOIN or exitGap &gt; DRIVE_ROAD_JOIN then
		return direct, directFlags, false
	end
	local function inside(p)
		return not bounds or flatDistance(p, bounds.center) &lt;= bounds.radius
	end

	local nodes = {}
	if entryEdge == exitEdge then
		-- One edge carries the whole trip.
		local roadLength = flatDistance(entry, exit)
		local total = (entryGap + exitGap) * DRIVE_OFFROAD_COST + roadLength
		if roadLength &lt; DRIVE_ROAD_MIN or (not preferRoads and total &gt;= flatDistance(from, goal) * DRIVE_OFFROAD_COST * 0.95) then
			return direct, directFlags, false
		end
	else
		local dist, prev, done = {}, {}, {}
		local function relax(node, d, via)
			if inside(node.position) and d &lt; (dist[node] or math.huge) then
				dist[node] = d
				prev[node] = via
			end
		end
		relax(entryEdge.a, flatDistance(entry, entryEdge.a.position), false)
		relax(entryEdge.b, flatDistance(entry, entryEdge.b.position), false)
		while true do
			local node, best = nil, math.huge
			for candidate, d in pairs(dist) do
				if not done[candidate] and (d &lt; best or (d == best and node and candidate.index and node.index and candidate.index &lt; node.index)) then
					node, best = candidate, d
				end
			end
			if not node then
				break
			end
			done[node] = true
			for _, edge in pairs(node.arms or {}) do
				local other = edge.a == node and edge.b or edge.a
				-- A road with a hole in it or a fallen bridge (BotNav.BlockRoadAt) is no road.
				if not done[other] and not edge.blocked then
					relax(other, best + edge.length, node)
				end
			end
		end
		local last, roadCost = nil, math.huge
		for _, node in ipairs({ exitEdge.a, exitEdge.b }) do
			if dist[node] then
				local cost = dist[node] + flatDistance(node.position, exit)
				if cost &lt; roadCost then
					last, roadCost = node, cost
				end
			end
		end
		if not last then
			return direct, directFlags, false
		end
		local total = (entryGap + exitGap) * DRIVE_OFFROAD_COST + roadCost
		if roadCost &lt; DRIVE_ROAD_MIN or (not preferRoads and total &gt;= flatDistance(from, goal) * DRIVE_OFFROAD_COST * 0.95) then
			return direct, directFlags, false
		end
		local node = last
		while node do
			table.insert(nodes, 1, node)
			node = prev[node] or nil
		end
	end

	-- Join the road a little way along it toward where it is going, and leave it a little before the
	-- exit, so the car merges on and off at an angle instead of turning square onto the tarmac (on a
	-- bridge, square off it is into the river).
	local function toward(point, target, share, most)
		local offset = flat(target - point)
		local length = offset.Magnitude
		if length &lt; 0.01 then
			return point
		end
		return point + offset.Unit * math.min(length * 0.8, math.min(most, share))
	end
	local firstTarget = nodes[1] and flat(nodes[1].position) or exit
	entry = toward(entry, firstTarget, entryGap * 0.5 + 6, 20)
	local lastSource = nodes[#nodes] and flat(nodes[#nodes].position) or entry
	exit = toward(exit, lastSource, exitGap * 0.5, 20)
	-- Never on or off the road on a bridge (RoadNetwork edge.bridges, studs along the edge from its
	-- start): across country to a bridge is across the river it spans. The bank on the car's side
	-- (or the goal's), clear of the abutment.
	local function offBridge(edge, point, side)
		local a = flat(edge.a.position)
		local ab = flat(edge.b.position) - a
		local length = ab.Magnitude
		if length &lt; 0.01 or not edge.bridges then
			return point
		end
		local unit = ab.Unit
		local along = flat(point - a):Dot(unit)
		local sideAlong = flat(side - a):Dot(unit)
		for _, span in ipairs(edge.bridges) do
			if along &gt; span.s0 - DRIVE_BRIDGE_CLEAR and along &lt; span.s1 + DRIVE_BRIDGE_CLEAR then
				local before, after = span.s0 - DRIVE_BRIDGE_CLEAR, span.s1 + DRIVE_BRIDGE_CLEAR
				along = math.abs(sideAlong - before) &lt;= math.abs(sideAlong - after) and before or after
				along = math.clamp(along, 0, length)
			end
		end
		return a + unit * along
	end
	-- (Already on the road, on the bridge itself, it just drives on along it.)
	if entryGap &gt; 11 then
		entry = offBridge(entryEdge, entry, from)
	end
	if exitGap &gt; 11 then
		exit = offBridge(exitEdge, exit, goal)
	end

	-- The road part: on at the entry, through each node (a curve's arc for a curved bend), off at the exit.
	local road = { entry }
	for _, node in ipairs(nodes) do
		for _, point in ipairs(bendPoints(node, road[#road])) do
			if flatDistance(point, road[#road]) &gt; 1 then
				table.insert(road, point)
			end
		end
	end
	if flatDistance(exit, road[#road]) &gt; 1 then
		table.insert(road, exit)
	end
	road = keepRight(road)

	local points, flags = {}, {}
	for index, point in ipairs(road) do
		table.insert(points, point)
		-- The leg to the entry is across country; everything after it is road.
		table.insert(flags, index &gt; 1)
	end
	if flatDistance(goal, points[#points]) &gt; 2 then
		table.insert(points, flat(goal))
		table.insert(flags, false)
	end
	return points, flags, true
end

function BotNav.NewDrive(chassis, handling, options)
	options = options or {}
	local size = chassis.Size
	return {
		chassis = chassis,
		handling = handling,
		wheelbase = options.wheelbase or size.Z * 0.62,
		-- A bike is narrow, but it still needs a gap wider than its handlebars.
		halfWidth = math.max(size.X / 2, 1.6),
		halfLength = size.Z / 2,
		params = options.params,
		probeParams = options.probeParams or options.params,
		rideHeight = options.rideHeight or 2.5,
		route = { [0] = flat(chassis.Position) },
		roadLeg = {},
		index = 1,
		goal = flat(chassis.Position),
		arrive = 25,
		senseCap = math.huge,
		maxSpeed = nil,
		guard = {},
		stuck = { tries = 0, anchor = chassis.Position },
		lastSteer = 0,
		stats = { senses = 0, casts = 0, maxCasts = 0, recoveries = 0 },
	}
end

-- (Re)plans the drive toward `goal`. `via` points come first (a base's drive-out lane).
function BotNav.DriveTo(drive, goal, options)
	options = options or {}
	local start = flat(drive.chassis.Position)
	local route, flags = {}, {}
	local from = start
	for _, point in ipairs(options.via or {}) do
		table.insert(route, flat(point))
		table.insert(flags, false)
		from = flat(point)
	end
	local points, roadFlags, onRoads = BotNav.DriveRoute(options.roads, from, goal, options.bounds, options.preferRoads)
	for index, point in ipairs(points) do
		table.insert(route, point)
		table.insert(flags, roadFlags[index])
	end
	route[0] = start
	drive.route = route
	drive.roadLeg = flags
	drive.index = 1
	drive.goal = flat(goal)
	drive.onRoads = onRoads
	drive.arrive = options.arrive or 25
	drive.loiter = options.loiter == true
	drive.maxSpeed = options.maxSpeed
	drive.stopping = false
	drive.hazard = nil
	drive.obstacle = nil
	drive.shift = nil
	drive.lastGoodGround = nil
	drive.bestRemaining = math.huge
	drive.progressAt = nil
	drive.stuckSince = nil
	return onRoads
end

-- How far along what is left of the route, from `position`.
local function remaining(drive, position)
	local route = drive.route
	local total = flatDistance(position, route[drive.index] or position)
	for k = drive.index + 1, #route do
		total += flatDistance(route[k - 1], route[k])
	end
	return total
end

-- Moves drive.index past every point the vehicle has reached or driven by.
local function advance(drive, position, look)
	local route = drive.route
	while drive.index &lt; #route do
		local a, b = route[drive.index - 1], route[drive.index]
		local ab = b - a
		local length = ab.Magnitude
		local t = length &gt; 0.01 and flat(position - a):Dot(ab) / (length * length) or 1
		if t &gt;= 1 or flatDistance(position, b) &lt; math.max(6, look * 0.5) then
			drive.index += 1
		else
			break
		end
	end
end

-- The pure-pursuit point: `look` studs along the route from where the vehicle is on it, moved across
-- by drive.shift (overtaking in the other lane) where one is set.
local function pursuitPoint(drive, position, look)
	local point = BotNav.RoutePoint(drive, position, look)
	local shift = drive.shift
	if shift then
		local route = drive.route
		local k = math.min(drive.index, #route)
		local along = flat(route[k] - route[k - 1])
		if along.Magnitude &gt; 0.01 then
			point += rightOf(along.Unit) * shift.amount
		end
	end
	return point
end

function BotNav.RoutePoint(drive, position, look)
	local route = drive.route
	local k = drive.index
	-- The first leg runs from wherever the car is now, not from where it was when the route was made
	-- (it may since have backed away from a river, or been pushed).
	local a, b = k == 1 and flat(position) or route[k - 1], route[k]
	local ab = flat(b - a)
	local length = ab.Magnitude
	local on = b
	if length &gt; 0.01 then
		local t = math.clamp(flat(position - a):Dot(ab) / (length * length), 0, 1)
		on = a + ab * t
	end
	-- Off the line (a detour round something, or just joined): aim back onto it, not along it from
	-- a point beside us, so the car closes on the route at an angle rather than running parallel.
	local left = math.max(1, look - flatDistance(position, on) * 0.5)
	local from = on
	while true do
		local to = route[k]
		local span = flatDistance(from, to)
		if left &lt;= span or k &gt;= #route then
			if span &lt; 0.01 then
				return to
			end
			return from + (to - from).Unit * math.min(left, span)
		end
		left -= span
		from = to
		k += 1
	end
end

-- The tightest circle the vehicle's wheels can steer at `speed` (the lock narrows with speed, as
-- VehicleDynamics.Step narrows it).
local function turningRadius(h, wheelbase, speed)
	local fraction = math.clamp(speed / h.topSpeed, 0, 1)
	local lock = h.steerLow + (h.steerHigh - h.steerLow) * fraction ^ 0.75
	return wheelbase / math.tan(math.rad(lock))
end

-- The fastest a vehicle can go round a circle of `radius`: within DRIVE_LATERAL of cornering, and
-- no tighter than its steering lock allows at that speed.
local function arcSpeed(h, wheelbase, radius)
	local v = math.min(h.topSpeed, math.sqrt(DRIVE_LATERAL * radius))
	while v &gt; 12 and turningRadius(h, wheelbase, v) &gt; radius * 1.15 do
		v -= 2
	end
	return v
end

-- The speed a vehicle can take a turn of `turn` radians at, round a curve of about `radius` studs
-- (math.huge for a single sharp corner, which pure pursuit rounds off over its lookahead): within
-- DRIVE_LATERAL of cornering, and slow enough that the steering lock can still make the circle.
local function cornerSpeed(turn, radius, h, wheelbase)
	local chord = 2 * math.sin(turn / 2)
	local v = h.topSpeed
	while v &gt; 12 do
		-- Pure pursuit rounds a sharp corner to about lookahead / chord (and runs a little wide of
		-- that, which the lane has room for).
		local path = math.min(radius, (DRIVE_LOOK_MIN + DRIVE_LOOK_PER * v) / chord)
		if v * v &lt;= DRIVE_LATERAL * path and turningRadius(h, wheelbase, v) &lt;= path * 1.15 then
			break
		end
		v -= 2
	end
	-- Past a right angle it is a turn back on itself, taken at a crawl whatever the sums say.
	if turn &gt; math.rad(100) then
		v = math.min(v, 18)
	end
	return v
end

-- The highest speed from which every corner coming up can still be made, braking at `decel`.
local function cornerCap(drive, position, speed, decel)
	local route = drive.route
	local cap = math.huge
	local reach = speed * speed / (2 * decel) + 40
	local first = drive.index
	-- The corner just passed still counts while the car is coming out of it (advance moves on from a
	-- corner half a lookahead early).
	if first &gt; 1 and flatDistance(position, route[first - 1]) &lt; DRIVE_LOOK_MIN + DRIVE_LOOK_PER * speed then
		first -= 1
	end
	local along = 0
	for k = first, #route - 1 do
		if k == drive.index then
			along = flatDistance(position, route[k])
		elseif k &gt; drive.index then
			along += flatDistance(route[k - 1], route[k])
		end
		if along &gt; reach then
			break
		end
		local d1 = flat(route[k] - route[k - 1])
		local d2 = flat(route[k + 1] - route[k])
		local l1, l2 = d1.Magnitude, d2.Magnitude
		if l1 &gt; 0.1 and l2 &gt; 0.1 then
			local turn = math.acos(math.clamp(d1.Unit:Dot(d2.Unit), -1, 1))
			if turn &gt; math.rad(10) then
				-- Short legs either side are an arc; long ones a corner.
				local radius = math.min(l1, l2) &lt; 30 and math.min(l1, l2) / 2 / math.tan(turn / 2) or math.huge
				local v = cornerSpeed(turn, radius, drive.handling, drive.wheelbase)
				cap = math.min(cap, math.sqrt(v * v + 2 * decel * math.max(0, along - 2)))
			end
		end
	end
	return cap
end

-- Speed allowed now to stop `margin` short of something `ahead` studs in front of the nose.
local function stopCap(ahead, margin, decel)
	return math.sqrt(2 * decel * math.max(0, ahead - margin))
end

-- A spatial query that counts toward DriveCastsPerSense: a ray from `origin`, or with `size` a box
-- swept from the CFrame `origin`.
-- Every query DriveSense makes, counted against the bots' shared frame budget as "navigation".
-- DriveSense reserves its whole look before the first one (see "blind"), so none is refused midway.
local function cast(drive, origin, size, direction, params)
	drive.castsThisSense += 1
	if size then
		if not BotNav.CastSpend("navigation") then
			return nil
		end
		return workspace:Blockcast(origin, size, direction, params)
	end
	return (BotNav.CastRay(origin, direction, params, "navigation"))
end

-- Whether what a sweep met is moving toward us along it (another vehicle coming the other way). Read
-- off the part it hit, not queried.
local function oncoming(hit, along)
	local part = hit and hit.Instance
	if not part or not part:IsA("BasePart") or part.Anchored then
		return false
	end
	local velocity = part.AssemblyLinearVelocity
	return velocity ~= nil and Vector3.new(velocity.X, 0, velocity.Z):Dot(along) &lt; -4
end

-- Whether what a sweep met is a vehicle (something loose, not the scenery) standing over to the left
-- of the way we are going, in the other lane, by its own middle: a part's Position is read, not
-- queried. A parked or stopped car in the other lane is passed on the right of, not overtaken into.
local function leftOfUs(hit, position, along)
	local part = hit and hit.Instance
	if not part or not part:IsA("BasePart") or part:IsA("Terrain") or part.Anchored then
		return false
	end
	return rightOf(along):Dot(flat(part.Position - position)) &lt; -2
end

-- Whether the other lane is free to pull out into: no vehicle in drive.traffic (their chassis, read
-- not queried) ahead in it within DRIVE_OVERTAKE_CLEAR, unless it is going our way faster than we are.
local function laneClear(drive, position, along)
	local ownSpeed = drive.chassis.AssemblyLinearVelocity:Dot(along)
	for _, chassis in ipairs(drive.traffic or {}) do
		if chassis.Parent and chassis ~= drive.chassis then
			local offset = flat(chassis.Position - position)
			local ahead = offset:Dot(along)
			local across = rightOf(along):Dot(offset)
			if ahead &gt; -drive.halfLength and ahead &lt; DRIVE_OVERTAKE_CLEAR and across &lt; 3 and across &gt; -(DRIVE_LANE * 2 + 8) then
				if chassis.AssemblyLinearVelocity:Dot(along) &lt; ownSpeed + 2 then
					return false
				end
			end
		end
	end
	return true
end

-- Whether a hit is something a vehicle cannot drive through: not ground it can climb (a face turned
-- up), not a part nothing collides with (road slabs, markings, foliage).
local function blocking(hit)
	if not hit then
		return false
	end
	if hit.Normal.Y &gt; 0.6 then
		return false
	end
	local part = hit.Instance
	if part and part:IsA("BasePart") and not part:IsA("Terrain") and not part.CanCollide then
		return false
	end
	return true
end

function BotNav.DriveSense(drive, now)
	local chassis = drive.chassis
	local frame = chassis.CFrame
	local position = frame.Position
	local velocity = chassis.AssemblyLinearVelocity
	local look = flat(frame.LookVector)
	look = look.Magnitude &gt; 0.05 and look.Unit or Vector3.new(0, 0, -1)
	local speed = velocity:Dot(frame.LookVector)
	local h = drive.handling
	drive.castsThisSense = 0
	drive.stats.senses += 1
	DSTATS.senses += 1

	-- On its side or roof: nothing to steer.
	if frame.UpVector.Y &lt; DRIVE_FLIP_UP then
		drive.flippedSince = drive.flippedSince or now
		if now - drive.flippedSince &gt;= DRIVE_FLIP_AFTER then
			return "flipped"
		end
		return "driving"
	end
	drive.flippedSince = nil

	local lookahead = DRIVE_LOOK_MIN + DRIVE_LOOK_PER * math.abs(speed)
	advance(drive, position, lookahead)
	local left = remaining(drive, position)

	-- Arriving: brake for the goal, then report it.
	if not drive.loiter and drive.index &gt;= #drive.route and flatDistance(position, drive.goal) &lt;= drive.arrive then
		drive.stopping = true
	end
	if drive.stopping then
		if math.abs(speed) &lt; DRIVE_STOPPED then
			return "arrived"
		end
		return "stopping"
	end

	-- Progress: the route has to keep getting shorter, whatever is in the way.
	if left &lt; drive.bestRemaining - DRIVE_LOST_GAIN or not drive.progressAt then
		drive.bestRemaining = math.min(drive.bestRemaining, left)
		drive.progressAt = now
	elseif now - drive.progressAt &gt; DRIVE_LOST_AFTER and not drive.loiter then
		return "lost"
	end

	-- The frame's ray budget can't cover a whole look: nothing is looked at this think, so nothing is
	-- driven into that hasn't been seen (DriveControl eases off until the next look; the last look's
	-- findings stand meanwhile).
	if BotNav.CastRemaining("navigation") &lt; DRIVE_CASTS_PER_SENSE then
		drive.blindUntil = now + 0.4
		DSTATS.blind += 1
		return "driving"
	end
	drive.blindUntil = nil

	-- An overtake ends once what it was passing is a car's length behind (or it has gone on too long).
	local shift = drive.shift
	if shift and (now &gt; shift.untilTime or flat(shift.point - position):Dot(look) &lt; -(drive.halfLength + 6)) then
		drive.shift = nil
	end
	local target = pursuitPoint(drive, position, lookahead)
	local heading = flat(target - position)
	heading = heading.Magnitude &gt; 0.5 and heading.Unit or look
	-- Where it is actually steering: the route, or the way round whatever it is going round. That
	-- way is held in world terms, not as an angle off the route: the route's own pull swings as the
	-- car moves sideways, and an angle off it would swing the detour back into the thing it avoids.
	local avoid = drive.avoid
	if avoid and now &gt;= avoid.untilTime then
		avoid = nil
		drive.avoid = nil
	end
	local steering = avoid and avoid.dir or heading
	local reach = math.clamp(math.abs(speed) * 1.1 + 16, 20, 90)
	local groundHere = position.Y - drive.rideHeight
	local bumper = Vector3.new(0, 1.2, 0)
	local reversing = drive.reverseUntil and now &lt; drive.reverseUntil
	-- Backing round in a three-point turn is backing too.
	local backing = reversing or drive.turning ~= nil

	-- 1: the car's own width swept straight ahead of it, from a stud above the ground up to head
	-- height: buildings, trees, walls, other vehicles; not a kerb, not the road. That is the way it
	-- is going now, and what DriveControl brakes for. While backing out of somewhere, swept behind
	-- instead, so it stops backing before it backs into something.
	local width = drive.halfWidth * 2 + 1
	local boxAt = Vector3.new(position.X, groundHere + 2.6, position.Z)
	local boxSize = Vector3.new(width, 2.6, 1)
	local frontDir = backing and -look or look
	local frontReach = backing and drive.halfLength + 8 or reach
	local front = cast(drive, CFrame.lookAt(boxAt, boxAt + frontDir), boxSize, frontDir * frontReach, drive.params)
	if backing then
		if blocking(front) and front.Distance &lt; drive.halfLength + 3 + math.abs(speed) * 0.3 then
			drive.reverseUntil = now
			if drive.turning then
				-- No room to back round: no more three-point turns for a moment.
				drive.turning = nil
				drive.noTurnUntil = now + 2
			end
		end
		front = nil
	end
	if blocking(front) then
		drive.front = { point = boxAt + look * front.Distance, untilTime = now + 0.5 }
	else
		drive.front = nil
	end
	-- 2: the way it would like to go. Going round something, that is the way back toward the route,
	-- eased in a step, and it is only taken once this sweep finds it clear (turning back without
	-- looking first walks the car back into the corner it was going round). Otherwise, the route. When
	-- that is straight ahead, sweep 1 has looked already and a second feeler is had instead.
	local candidate = heading
	local backOff = 0
	if avoid then
		backOff = sideAngle(heading, avoid.dir, avoid.side)
		candidate = backOff &lt; math.rad(6) and heading or turnFlat(heading, avoid.side * backOff * 0.55)
	end
	local separate = not reversing and look:Dot(candidate) &lt; math.cos(math.rad(10))
	local ahead = front
	if separate then
		ahead = cast(drive, CFrame.lookAt(boxAt, boxAt + candidate), boxSize, candidate * reach, drive.params)
	end
	-- 2/3: feelers off the front corners, either side of the nose: which way is clearer. With two
	-- sweeps this look, only the one on the side it is turning toward.
	local nose = position + look * drive.halfLength + bumper
	local side = rightOf(look) * drive.halfWidth
	local feelerLength = reach * 0.6
	local turnSide = signedAngle(look, candidate) &gt;= 0 and 1 or -1
	local leftClear, rightClear = feelerLength, feelerLength
	if not separate or turnSide &lt; 0 then
		local hit = cast(drive, nose - side, nil, turnFlat(look, -DRIVE_FEELER_ANGLE) * feelerLength, drive.params)
		leftClear = blocking(hit) and (hit.Position - (nose - side)).Magnitude or feelerLength
	end
	if not separate or turnSide &gt; 0 then
		local hit = cast(drive, nose + side, nil, turnFlat(look, DRIVE_FEELER_ANGLE) * feelerLength, drive.params)
		rightClear = blocking(hit) and (hit.Position - (nose + side)).Magnitude or feelerLength
	end

	-- The way along a face that was met, on `turnTo`'s side, a little away from it.
	local function alongFace(hit, turnTo, from)
		local normal = flat(hit.Normal)
		if normal.Magnitude &lt; 0.3 then
			return turnFlat(from, turnTo * math.rad(35))
		end
		local n = normal.Unit
		local tangent = rightOf(n)
		if tangent:Dot(turnFlat(from, turnTo * math.pi / 2)) &lt; 0 then
			tangent = -tangent
		end
		return (tangent + n * 0.3).Unit
	end

	if avoid then
		if not blocking(ahead) then
			-- The way back is clear: take it (all the way, once it is the route).
			if backOff &lt; math.rad(6) then
				drive.avoid = nil
			else
				avoid.dir = candidate
				avoid.untilTime = now + 0.9
			end
		else
			-- Still in the way: keep going round.
			avoid.untilTime = now + 0.9
		end
		-- What it is going round along is itself blocked ahead (a corner turning in): along that face.
		if drive.avoid and blocking(front) and front.Distance - drive.halfLength &lt; reach * 0.6 then
			local dir = alongFace(front, avoid.side, look)
			if sideAngle(avoid.dir, dir, avoid.side) &lt; math.rad(5) then
				dir = turnFlat(avoid.dir, avoid.side * math.rad(20))
			end
			if sideAngle(heading, dir, avoid.side) &gt; DRIVE_AVOID_TURN then
				dir = turnFlat(heading, avoid.side * DRIVE_AVOID_TURN)
			end
			avoid.dir = dir
		end
	elseif blocking(ahead) and (oncoming(ahead, candidate) or (drive.roadLeg[drive.index] and leftOfUs(ahead, position, candidate))) then
		-- Another vehicle coming the other way in our path, or something over in the other lane: over
		-- to the right and slow, as anyone would (pulling out to the left is into it).
		DSTATS.obstacles += 1
		drive.shift = { amount = drive.roadLeg[drive.index] and 3 or 8, point = boxAt + candidate * ahead.Distance, untilTime = now + 3 }
		drive.obstacle = { point = boxAt + candidate * ahead.Distance, untilTime = now + 0.5 }
	elseif blocking(ahead) and drive.roadLeg[drive.index] and not drive.shift and ahead.Distance &gt; drive.halfLength + 12 then
		-- On a road, something in the lane: pull into the other lane to pass it, as anyone would (the
		-- right is the verge), and back once it is behind; but not with traffic coming the other way in
		-- that lane (drive.traffic, BotService's list of the vehicles about): then wait behind it.
		DSTATS.obstacles += 1
		local point = boxAt + candidate * ahead.Distance
		if laneClear(drive, position, candidate) then
			drive.shift = { amount = -(DRIVE_LANE * 2 + 1.5), point = point, untilTime = now + 8 }
		else
			drive.obstacle = { point = point, untilTime = now + 0.5 }
		end
	elseif blocking(ahead) then
		DSTATS.obstacles += 1
		local distance = math.max(1, ahead.Distance - drive.halfLength)
		local normal = flat(ahead.Normal)
		local turnTo
		if math.abs(leftClear - rightClear) &gt; 2 then
			turnTo = rightClear &gt; leftClear and 1 or -1
		elseif drive.roadLeg[drive.index] then
			-- On a road, round it on the left, through the other lane, as anyone would: the right is the verge.
			turnTo = -1
		else
			-- Round whichever side the face it met is turned toward.
			turnTo = (normal.Magnitude &gt; 0.3 and normal.Unit:Dot(rightOf(heading)) &gt;= 0) and 1 or -1
		end
		local dir
		if distance &lt; reach * 0.6 then
			dir = alongFace(ahead, turnTo, heading)
		else
			-- Far off, a nudge that gets the nose a car's width and a margin clear by the time it is there.
			dir = turnFlat(heading, turnTo * 1.6 * math.atan2(drive.halfWidth + 3.5, distance))
		end
		drive.avoid = { side = turnTo, dir = dir, untilTime = now + 0.9 }
		drive.obstacle = { point = boxAt + candidate * ahead.Distance, untilTime = now + 0.5 }
	elseif math.min(leftClear, rightClear) &lt; feelerLength * 0.45 then
		-- Something close off one corner: ease away from it.
		local away = leftClear &lt; rightClear and 1 or -1
		drive.avoid = { side = away, dir = turnFlat(heading, away * math.rad(10)), untilTime = now + 0.4 }
	end
	-- Nose up against something: going forward can't turn it away (a car turns by moving), so that is
	-- stuck, not waiting. Either both corners are on it, or it is right in front.
	drive.blocked = (leftClear &lt; 4 and rightClear &lt; 4)
		or (blocking(front) and front.Distance - drive.halfLength &lt; DRIVE_STOP_MARGIN + 1)

	-- 4: the ground ahead, water counted (a wheel ray ignores it; a river is not a road). Far enough
	-- out that the car can stop short of the last ground it saw was good, which is where it stops
	-- for water or a drop: the edge is somewhere between that and this.
	local probeDistance = math.clamp(math.abs(speed) * 1.1 + 12, 14, 90)
	-- Turning, the car's path runs between where it points and where it steers: probe down the middle.
	local probeAt
	if reversing then
		-- Backing: behind it, a length out.
		probeDistance = 8
		probeAt = position - look * (drive.halfLength + probeDistance)
	else
		-- Where the car will be that far on: round the tightest circle it can steer at this speed until
		-- it points where it is steering, then straight on. (Straight at the steering point would probe
		-- ground the car's arc never reaches, and straight on ground it is turning away from.)
		local reachAlong = drive.halfLength + probeDistance
		local turn = signedAngle(look, steering)
		local radius = turningRadius(h, drive.wheelbase, math.abs(speed))
		local arc = radius * math.abs(turn)
		if arc &gt;= reachAlong then
			local angle = reachAlong / radius
			probeAt = position + look * (radius * math.sin(angle))
				+ rightOf(look) * ((turn &gt; 0 and 1 or -1) * radius * (1 - math.cos(angle)))
		else
			probeAt = position + look * (radius * math.sin(math.abs(turn)))
				+ rightOf(look) * ((turn &gt; 0 and 1 or -1) * radius * (1 - math.cos(turn)))
				+ steering * (reachAlong - arc)
		end
	end
	local below = cast(drive, Vector3.new(probeAt.X, groundHere + 25, probeAt.Z), nil, Vector3.new(0, -80, 0), drive.probeParams)
	local hazard = false
	drive.steepAhead = false
	drive.dropAhead = false
	if not below or below.Material == WATER then
		hazard = true
	else
		local drop = groundHere - below.Position.Y
		if drop &gt; math.max(DRIVE_DROP, probeDistance * DRIVE_DROP_GRADE) then
			hazard = true
		elseif drop &gt; DRIVE_DROP then
			-- Lower by more than a bank, but not steeply for how far off it is: a long slope, or a cliff
			-- whose foot is what this ray found. Slow enough that the next looks, nearer in, can tell.
			drive.dropAhead = true
		elseif -drop / probeDistance &lt; DRIVE_STEEP_DOWN then
			drive.steepAhead = true
		end
	end
	local lastGood = drive.lastGoodGround
	local known = drive.hazard and now &lt; drive.hazard.untilTime
	if reversing then
		-- Water or a drop behind: stop backing. Nothing is learnt about the way ahead.
		if hazard then
			drive.reverseUntil = now
		end
	elseif hazard then
		DSTATS.hazards += 1
		-- Stop short of the last ground that was fine, if it is still ahead; otherwise short of here. A
		-- stop already set nearer stands: a later look from further on only sees further past the edge.
		local stopAt = lastGood and flat(lastGood - position):Dot(look) &gt; drive.halfLength and lastGood
			or position + look * (drive.halfLength + 1)
		if known and flat(drive.hazard.point - position):Dot(look) &lt; flat(stopAt - position):Dot(look) then
			stopAt = drive.hazard.point
		end
		drive.hazard = { point = Vector3.new(stopAt.X, position.Y, stopAt.Z), untilTime = now + 1.5, at = now }
	elseif not drive.dropAhead and not known then
		-- Only ground that is plainly fine counts; a drop that might be a cliff's foot does not.
		drive.lastGoodGround = Vector3.new(probeAt.X, position.Y, probeAt.Z)
	end

	drive.stats.casts += drive.castsThisSense
	drive.stats.maxCasts = math.max(drive.stats.maxCasts, drive.castsThisSense)
	DSTATS.casts += drive.castsThisSense
	DSTATS.maxCasts = math.max(DSTATS.maxCasts, drive.castsThisSense)

	-- The speed this look allows, whatever DriveControl works out between looks.
	local onRoad = drive.roadLeg[drive.index] == true
	local cap = h.topSpeed * (onRoad and DRIVE_CRUISE or DRIVE_OFFROAD_CRUISE)
	if drive.steepAhead then
		cap = math.min(cap, h.topSpeed * 0.5)
	end
	if drive.dropAhead then
		cap = math.min(cap, 20)
	end
	if drive.maxSpeed then
		cap = math.min(cap, drive.maxSpeed)
	end
	drive.senseCap = cap

	-- Stopped short of a hazard: nothing more this route can do. Back off a length first, straight, so
	-- whatever comes next turns away from the edge rather than round over it.
	if drive.hazard and now &lt; drive.hazard.untilTime and math.abs(speed) &lt; DRIVE_STOPPED then
		drive.hazard = nil
		drive.reverseUntil = now + 2.4
		drive.reverseSteer = 0
		return "hazard"
	end

	-- Stuck: wanting to go, and not going. Reverse out turning, then try the other way round.
	reversing = drive.reverseUntil and now &lt; drive.reverseUntil
	-- Standing still counts as stuck whatever is holding it (an obstacle that won't move, a wheel
	-- against a kerb, the nose on a wall), except the goal, someone on foot, or being told to hold.
	local wants = not drive.guardHolding and not drive.hold and ((drive.wantedSpeed or 0) &gt; 6 or drive.blocked
		or (drive.obstacle ~= nil and now &lt; drive.obstacle.untilTime))
	if flatDistance(position, drive.stuck.anchor) &gt; 30 then
		drive.stuck.tries = 0
		drive.stuck.anchor = position
	end
	if reversing then
		drive.stuckSince = nil
	elseif wants and math.abs(speed) &lt; DRIVE_STUCK_SPEED then
		drive.stuckSince = drive.stuckSince or now
		if now - drive.stuckSince &gt;= DRIVE_STUCK_AFTER then
			drive.stuck.tries += 1
			drive.stats.recoveries += 1
			DSTATS.recoveries += 1
			if drive.stuck.tries &gt; DRIVE_STUCK_TRIES then
				return "stuck"
			end
			-- Round the other side from last time, or from whichever corner is more boxed in.
			local turnTo = drive.avoid and -drive.avoid.side or (rightClear &gt;= leftClear and 1 or -1)
			if drive.stuck.tries % 2 == 0 then
				turnTo = -turnTo
			end
			drive.reverseUntil = now + DRIVE_REVERSE_FOR
			-- Backing with the wheels turned one way swings the nose the other.
			drive.reverseSteer = -turnTo
			drive.avoid = { side = turnTo, dir = turnFlat(look, turnTo * math.rad(60)), untilTime = drive.reverseUntil + 1.5 }
			drive.stuckSince = nil
		end
	else
		drive.stuckSince = nil
	end
	return "driving"
end

-- The throttle, steer and handbrake for this frame. Arithmetic on what DriveSense and BotService
-- left on `drive`; no queries.
function BotNav.DriveControl(drive, dt, now)
	local chassis = drive.chassis
	local frame = chassis.CFrame
	local position = frame.Position
	local speed = chassis.AssemblyLinearVelocity:Dot(frame.LookVector)
	local h = drive.handling
	local decel = h.brake * DRIVE_DECEL_SHARE

	if drive.hold then
		drive.wantedSpeed = 0
		if speed &gt; 1.5 then
			return -1, 0, false
		end
		return 0, 0, true
	end
	if drive.reverseUntil and now &lt; drive.reverseUntil then
		drive.wantedSpeed = 0
		-- Backing out at a walk: nothing behind has been looked at for more than a car's length or so.
		return speed &lt; -10 and 0 or -0.8, drive.reverseSteer or 0, false
	end

	local lookahead = DRIVE_LOOK_MIN + DRIVE_LOOK_PER * math.abs(speed)
	advance(drive, position, lookahead)
	local target = pursuitPoint(drive, position, lookahead)
	local toTarget = flat(target - position)
	local distance = toTarget.Magnitude
	local direction = distance &gt; 0.05 and toTarget.Unit or flat(frame.LookVector).Unit
	local avoid = drive.avoid
	if avoid and now &lt; avoid.untilTime then
		direction = avoid.dir
	end

	-- The speed that can be held: the tightest of everything known.
	local cap = drive.senseCap or h.topSpeed
	cap = math.min(cap, cornerCap(drive, position, math.abs(speed), decel))

	if not drive.loiter then
		local toGoal = flatDistance(position, drive.goal)
		if drive.index &gt;= #drive.route then
			cap = math.min(cap, stopCap(toGoal, drive.arrive * 0.4, decel) + (drive.stopping and 0 or 2))
		end
		if drive.stopping then
			cap = 0
		end
	end
	local obstacle = drive.obstacle
	if obstacle and now &lt; obstacle.untilTime then
		-- The way it wants to go is blocked a little way off: take the detour at a pace that can still
		-- change its mind. What it stops for is what is in FRONT of it (below), not what is round the
		-- corner it is steering toward, or it would stop at every corner of what it is going round.
		local gap = flatDistance(obstacle.point, position) - drive.halfLength
		cap = math.min(cap, math.max(14, stopCap(gap, DRIVE_STOP_MARGIN, decel)))
	end
	local front = drive.front
	if front and now &lt; front.untilTime then
		-- Straight ahead of the nose, the way it is pointing now.
		local look = flat(frame.LookVector)
		local gap = flat(front.point - position):Dot(look.Magnitude &gt; 0.05 and look.Unit or direction) - drive.halfLength
		cap = math.min(cap, stopCap(gap, 3, decel) + (gap &gt; 8 and 2 or 0))
	end
	local hazard = drive.hazard
	if hazard and now &lt; hazard.untilTime then
		local rel = frame:PointToObjectSpace(hazard.point)
		cap = math.min(cap, stopCap(-rel.Z - drive.halfLength, DRIVE_STOP_MARGIN, decel))
	end

	-- People on foot BotService listed: stop short of anyone in the way (a teammate always), and
	-- after DRIVE_GUARD_HOLD of waiting, go round them.
	local holding = false
	local swerve = 0
	for _, guard in ipairs(drive.guard) do
		local root = guard.root
		if root and root.Parent then
			local rel = frame:PointToObjectSpace(root.Position)
			local ahead = -rel.Z - drive.halfLength
			local reach = speed * speed / (2 * decel) + 12
			-- Where they will be across the car's path by the time it gets there, as well as where they
			-- are: someone running across the road is in the way before they are in the lane.
			local across = frame:VectorToObjectSpace(root.AssemblyLinearVelocity or Vector3.zero).X
			local later = rel.X + across * math.min(math.max(ahead, 0) / math.max(math.abs(speed), 5), 1.5)
			local nearest = (rel.X &gt; 0) ~= (later &gt; 0) and 0 or math.min(math.abs(rel.X), math.abs(later))
			local lateral = nearest - drive.halfWidth
			if ahead &gt; -2 and ahead &lt; reach and lateral &lt; 3 then
				local allowed = stopCap(ahead, 3.5, decel)
				if guard.hard then
					cap = math.min(cap, allowed)
					holding = holding or allowed &lt; 1
				else
					cap = math.min(cap, math.max(allowed, 6))
				end
				swerve = rel.X &gt; 0 and -1 or 1
			end
		end
	end
	if holding then
		drive.guardSince = drive.guardSince or now
	else
		drive.guardSince = nil
	end
	drive.guardHolding = holding
	if swerve ~= 0 and (not holding or now - drive.guardSince &gt; DRIVE_GUARD_HOLD) then
		direction = turnFlat(direction, swerve * math.rad(35))
		if holding then
			-- Round them at a walk: the cap above lifts once they are no longer in front.
			cap = 5
		end
	end

	-- Pure pursuit: the wheel angle whose arc passes through the point steered at.
	local localDirection = frame:VectorToObjectSpace(direction)
	local alpha = math.atan2(localDirection.X, -localDirection.Z)
	local reachOf = math.max(distance, 6)
	local wheel = math.deg(math.atan(2 * drive.wheelbase * math.sin(alpha) / reachOf))
	local fraction = math.clamp(math.abs(speed) / h.topSpeed, 0, 1)
	local maxSteer = h.steerLow + (h.steerHigh - h.steerLow) * fraction ^ 0.75
	local steer = math.clamp(wheel / maxSteer, -1, 1)

	-- The arc pure pursuit is steering right now, at a speed the tyres and the steering lock can hold
	-- it at (a turn taken too fast runs wide, off the road and toward whatever is beside it). A point
	-- well round to the side wants a slow turn, not a fast arc: the arc goes where no look has been yet.
	if math.abs(alpha) &gt; math.rad(3) then
		cap = math.min(cap, arcSpeed(h, drive.wheelbase, reachOf / (2 * math.sin(math.min(math.abs(alpha), math.pi / 2)))))
	end
	if math.abs(alpha) &gt; math.rad(60) then
		cap = math.min(cap, 22)
	end
	if avoid and now &lt; avoid.untilTime then
		cap = math.min(cap, DRIVE_DETOUR_SPEED)
	end
	-- Behind, at a crawl: back round toward it (a three-point turn) instead of a wide loop, committed
	-- to one side until the nose is round, so a point straight behind can't flip it from side to side.
	local turning = drive.turning
	if not turning and math.abs(alpha) &gt; math.rad(115) and math.abs(speed) &lt; 8 and cap &gt; 1 and now &gt;= (drive.noTurnUntil or 0) then
		local side = alpha &gt; 0 and 1 or -1
		if math.abs(alpha) &gt; math.rad(165) then
			side = drive.turnSide or side
		end
		turning = { side = side, untilTime = now + 3 }
		drive.turning = turning
		drive.turnSide = side
	end
	if turning then
		if math.abs(alpha) &lt; math.rad(70) or now &gt; turning.untilTime or cap &lt;= 1 then
			drive.turning = nil
		else
			drive.wantedSpeed = cap
			-- Backing with the wheels turned one way swings the nose the other; at a walk, as when
			-- backing out (DriveSense sweeps behind for it).
			return speed &lt; -10 and 0 or -0.7, -turning.side, false
		end
	end

	drive.wantedSpeed = cap
	drive.lastSteer = steer
	local throttle, handbrake = 0, false
	if drive.blindUntil and now &lt; drive.blindUntil and cap &gt;= 1 then
		-- A look skipped for the ray budget: nothing new has been seen, so brake lightly (never on into
		-- the unseen) until the next look; the last look's caps above still stand.
		throttle = speed &gt; 1.5 and -0.35 or 0
		handbrake = speed &lt; 2
	elseif cap &lt; 1 then
		-- Stop, and hold: braking below a crawl would start reversing.
		throttle = speed &gt; 1.5 and -math.clamp(speed / 8, 0.4, 1) or 0
		handbrake = speed &lt; 2
	else
		local err = cap - speed
		if err &gt; 0 then
			throttle = math.clamp(err / 8 + 0.3, 0, 1)
		elseif err &lt; -2 then
			throttle = math.clamp(err / 4, -1, 0)
		else
			throttle = 0.15
		end
	end
	return throttle, steer, handbrake
end

return BotNav
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX74"><Properties><string name="Name">BotService</string><ProtectedString name="Source">-- Bots that actually play. Each carries a real weapon from WeaponData and uses its damage,
-- fire rate, range and magazine; they strafe while engaging, push when out of position, take cover
-- or put a barricade up when hurt, and rotate to the safe zone when there's nobody to shoot.
--
-- They fight each other as well as players, which is what makes the match thin out on its
-- own instead of 29 statues waiting to be farmed.
--
-- Accuracy falls off with distance, so a close-range fight is genuinely dangerous while a
-- long-range one is survivable — that's the main difficulty dial, alongside BotDamageScale.
--
-- What a bot knows is what it could know. It sees a target only with a clear line to it, notices
-- one behind it a moment late (so flanking a bot works), and when a target breaks line of sight it
-- hunts where it last saw them rather than tracking them through walls.
--
-- Getting around lives in BotNav: queued path requests, step checks before every combat move, cover
-- search, and the stuck ladder.
--
-- One rig is built up front and cloned for the rest: CreateHumanoidModelFromDescription is
-- a web call, and doing it 29 times would stall the match start.
--
-- SHARED INFRASTRUCTURE (for every section in this file: archetypes, looting, vehicles, animation).
-- Bot code is hot: up to 13 bots think in one server frame. Anything a new behaviour needs from the
-- world goes through these, never through its own workspace:Raycast or a walk over Combatants.All():
--   BotService.Tick                  counts think slices; stamp a per-tick cache with it (see hostile()).
--   combatantList / combatantsNear   the living combatants this tick (token, character, root, humanoid,
--     (BotService.SpatialQuery)      position, isPlayer) and the ones within a radius, from a uniform
--                                    grid rebuilt once a tick. The returned list is a SHARED scratch
--                                    buffer: read it, never keep it. SpatialQuery.Loot(position,
--                                    radius, kind) does the same for pickups; SpatialQuery.NewGrid
--                                    makes a grid for anything else (vehicles, structures).
--   castRay(origin, direction,       every ray a bot casts. A per-frame budget (BotService.RaycastBudget)
--     params, priority)              serves "combat" (sight lines) before "navigation" (steps, cover,
--                                    floors) before "idle" (wander and loot walking). Returns result,
--                                    granted; on granted == false do the cautious thing (not visible,
--                                    can't step) and DON'T cache the answer: the next think retries.
--                                    BotNav.CastRay is the same function for BotNav's own rays.
--   BotService.LodDefers             far from every player, an idle bot thinks every other turn; a
--                                    bot that is fighting, fleeing, in the storm or was just hit never
--                                    does. Time-based behaviour (regen, timers) must use elapsed time,
--                                    not "one think = BotThinkInterval".
-- Allocation: reuse rows (see refreshCombatants, findTarget, planCombatMove) rather than building
-- tables in a per-think path; the GC pause is part of the frame. tools/perf_bot_cost.py counts rays,
-- candidates examined, KB allocated and thinks per frame at 30 and 50 bots, and its planted faults
-- must all still be caught after a change here.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameModes = require(Shared:WaitForChild("GameModes"))
local MatchConfig = require(Shared:WaitForChild("MatchConfig"))
local Rarity = require(Shared:WaitForChild("Rarity"))
local WeaponData = require(Shared:WaitForChild("WeaponData"))
local BrainrotData = require(Shared:WaitForChild("BrainrotData"))
local CosmeticData = require(Shared:WaitForChild("CosmeticData"))
local AchievementData = require(Shared:WaitForChild("AchievementData"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local AccessoryService = require(script.Parent:WaitForChild("AccessoryService"))
local BotNav = require(script.Parent:WaitForChild("BotNav"))
local CombatService = require(script.Parent:WaitForChild("CombatService"))
local Combatants = require(script.Parent:WaitForChild("Combatants"))
local DefenseService = require(script.Parent:WaitForChild("DefenseService"))
local CompanionService = require(script.Parent:WaitForChild("CompanionService"))
local LootService = require(script.Parent:WaitForChild("LootService"))
local MapGenerator = require(script.Parent:WaitForChild("MapGenerator"))
local MovementService = require(script.Parent:WaitForChild("MovementService"))
local NameplateService = require(script.Parent:WaitForChild("NameplateService"))
local StormService = require(script.Parent:WaitForChild("StormService"))
local SupplyDropService = require(script.Parent:WaitForChild("SupplyDropService"))
local WeaponService = require(script.Parent:WaitForChild("WeaponService"))

local BotService = {}

-- Hooks for game modes, set by whoever runs the match (nil in the battle royale, where everyone is
-- everyone's enemy and bots spawn empty-handed):
--   BotService.IsHostile(bot, otherToken) -&gt; false to make a bot ignore a combatant entirely: it is
--     not chosen as a target, and a shot at it is refused even if it was chosen a moment earlier.
--     Anything other than a literal false means hostile, so a hook that errors or forgets a case
--     leaves the old behaviour rather than a pacifist bot.
--   BotService.SpawnLoadout(bot, humanoid) -&gt; weaponIdOrDef, items: what this bot starts with. The
--     weapon may be a WeaponData def or its id; `items` is a list of { id = , count = } handed to the
--     same granters a chest uses, so a mode can feed bots and players from ONE loadout list instead
--     of two that drift apart. Heals, shields, throwables, barricades and rockets are understood; an
--     id that is none of those is ignored. Nil leaves the bot empty-handed to loot, the BR's rule.
BotService.IsHostile = nil
BotService.SpawnLoadout = nil

-- The think slice being run, bumped by refreshCombatants. Per-tick caches are stamped with it.
BotService.Tick = 0

-- The hook is a pcall per pair, and findTarget asks it for every combatant in reach of every bot
-- that thinks: at 50 bots that was ~600 pcalls a slice. Teams don't change inside a slice, so the
-- answer is kept per bot for the tick (cleared when BotService.Tick moves on). shootAt still asks
-- at the trigger, through this same cache, so a side swap mid-match is seen by the next slice.
local function hostile(bot, token)
	-- Riding together is a truce: nobody sharing a bot's vehicle is its target (BOT VEHICLES).
	local ride = bot.ride
	if ride and ride.model then
		local character = Combatants.GetCharacter(token)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		if seat and seat.Parent == ride.model then
			return false
		end
	end
	local hook = BotService.IsHostile
	if not hook then
		return true
	end
	local cache = bot.hostileCache
	if cache then
		if bot.hostileTick ~= BotService.Tick then
			table.clear(cache)
			bot.hostileTick = BotService.Tick
		else
			local known = cache[token]
			if known ~= nil then
				return known
			end
		end
	elseif type(bot) == "table" then
		cache = {}
		bot.hostileCache = cache
		bot.hostileTick = BotService.Tick
	end
	local ok, result = pcall(hook, bot, token)
	result = (not ok) or result ~= false
	if cache then
		cache[token] = result
	end
	return result
end

-- Counters for tools/bot_probe.lua, shared with BotNav so the probe reads one table.
local STATS = BotNav.Stats
for _, key in ipairs({
	"thinkTime", "thinkTicks", "updates", "maxTick", "pathRejected", "hopsWhileLooting",
	"buildsExposed", "buildsAngle", "buildsHeal", "buildsRefused", "throwsGrenade", "throwsSmoke",
	"reloads", "flees", "hunts", "searches", "coverSearches", "coverFound", "coverReached",
	"lootBlacklisted", "combatReplans", "badMoves", "sprints", "slides", "dangerDodges", "coverRouted",
	"launcherShots", "launcherMisses", "coverUnreachable", "crouches", "lootIgnored", "lootFarReach",
	"coverShots", "sightChecks", "coverChecks", "maxTickWall", "maxBotUpdate", "quickShots",
	-- BOT ARCHETYPES (tools/bot_archetype_sim.py reads these)
	"peeks", "repositions", "thirdPartyHolds", "avoided", "flankMoves", "focusFire", "throwsSticky",
	"buildsFortify", "buildsBlock", "buildsCross", "buildsPushed", "throwsRefusedFriendly", "buildsRefusedFriendly",
	"rays", "raysCombat", "raysNavigation", "raysIdle", "raysDenied", "raysFrameMax", "sightDenied",
	"candidatesExamined", "lodSkips", "lodThinks",
	-- BOT LOOTING &amp; ROTATION (tools/bot_loot_sim.py reads these)
	"lootUpgrades", "lootBackups", "lootJunkDropped", "lootContested", "gunSwaps", "roadLegs",
	"supplySkipped", "restockTrips", "dropHot", "dropQuiet", "lootStocked", "baseChestSpread", "lootBehind",
}) do
	STATS[key] = STATS[key] or 0
end
BotService.Stats = STATS

-- BOT LOOTING &amp; ROTATION (the section of that name, above updateBot): drop choice, loot routes,
-- inventory, heal timing and zone rotation, per archetype. Declared here because functions defined
-- before that section (tryHeal, holdLoot, FindBaseLoot) read its dials. A FIELD, not a local: the
-- main chunk sits at the edge of Luau's 200-local limit (tools/verify.py warns from 195), so the
-- section is reached as BotService.Loot everywhere, and tools/bot_loot_sim.py drives that table.
BotService.Loot = {}

local BOT_NAMES = {
	"SahurFan2011", "TungTungKing", "crocodilo_xd", "TralalaGamer", "BananiniBoss",
	"rot_enjoyer", "PatapimPro", "LarilaLover", "BombardiroBoi", "CappuccinaQT",
	"SaturnitaX", "AmbalabuAce", "TrippiTroppi99", "brainrot_fan", "GoldSahurGuy",
	"FrigoFreeze", "GusiniGamer", "SkibidiSahur", "LiriliMain", "BallerinaBlitz",
	"CameloCrew", "RotRidgeRat", "TownTakerr", "ZoneRunner7", "LootGoblin44",
	"ChestSniffer", "StormDodger", "QuietDropper", "FinalCircler", "NoScopeNate",
}

-- Guns bots don't pick up yet, whatever their rarity. BoomboxBassline shoves its target 45 studs/s,
-- and a bot aims by turning its whole body with an AlignOrientation, so being shoved mid-burst turns
-- its aim: worth one playtest look before bots can hold one. Remove the entry after that.
-- TamburoTungTung throws three bouncing drumlets a shot, and a bot's ProjectileService.FireWeapon throws one
-- round it can't lead; Bananerang's boomerang comes back to where it was thrown, which no bot plans for.
-- Held here so a bot is never dealt one at spawn (the pickup filter below already passes them over).
local BOT_WEAPON_HOLD = { BoomboxBassline = true, TamburoTungTung = true, Bananerang = true }

-- Mostly floor-tier guns, with the occasional good one so some fights bite harder.
local WEAPON_ODDS = { Common = 44, Uncommon = 38, Rare = 15, Epic = 3, Legendary = 0 }

--------------------------------------------------------------------------------
-- BOT ARCHETYPES
--------------------------------------------------------------------------------
-- Every bot used to play the same way: nearest target, 55 studs, strafe, cover at 80% health. Thirty
-- copies of one player read as thirty statues that move. Each bot is now dealt an ARCHETYPE at spawn
-- (Oliver, 2026-09-24: "different kinds that have different strategies in fighting and looting"), a
-- table of dials the fighting, looting and rotation code reads instead of one shared constant. The
-- dials say how a bot COMMITS: what it fights, from how far, when it hides, when it leaves. They never
-- touch how well it shoots. Aim is MatchConfig.BotAccuracy* and AIM_SETTLE_DELAY, and stays where
-- Oliver put it (#40/#75/#81): aggression is commitment, not lethality. tools/bot_aggression_check.py
-- fails if the hit chance at any range moves.
--
-- Layered on top is the WEAPON CLASS a bot happens to hold (WeaponData `style`): a shotgun wants to be
-- at 12 studs and pushes corners, a sniper wants 130 and moves after every shot, an LMG sits and
-- suppresses, a launcher never fires point-blank. ARCHETYPE_CLASS is the small table where the two
-- meet (a Marksman with a shotgun still keeps more distance than a Rusher with one). The merged result
-- for a bot's current gun is BotService.DialsOf(bot), rebuilt when its gun changes.
--
-- Reading the dials elsewhere:
--   BotService.ArchetypeOf(bot)  -&gt; the archetype table (has .name), nil for a token that isn't a bot
--   BotService.DialsOf(bot)      -&gt; archetype x weapon class, the table the fight code runs on
--   BotService.Archetypes        -&gt; name -&gt; archetype, for probes and the mode mix
--   BotService.WeaponClasses     -&gt; style -&gt; class dials
--   BotService.AssignArchetype(bot, name) -&gt; force one (probes, a mode that wants a set squad)
-- Loot and rotation dials (lootGreed, preferredWeaponClasses, rotateEarly, chestPriority, stock
-- targets...) live in BotService.Loot.DIALS in the BOT LOOTING &amp; ROTATION section, keyed by the same six names.
--
-- Dial meanings (fighting):
--   rangeScale         multiplies the weapon class's preferred engagement distance
--   coverUse           0-1, how readily the bot takes cover when the fight rules say it may
--   peek               peeks from cover: hides between bursts rather than standing in the gap
--   repositionOnHit    0-1, chance a fresh hit makes it change position (and drop the current move)
--   targetPick         "closest" | "weakest" | "threat" | "engaged": what the target score favours
--   pushTargetBelow    pushes a target under this health share (the MatchConfig one is the floor)
--   retreatHealth      absolute health under which it leaves a close fight (MatchConfig is the default)
--   healBelow          health share under which it uses heals (MatchConfig is the default)
--   grenadeAt          minimum enemies bunched round the target before a frag goes over
--   smokeToMove        smokes the ground between itself and the target before repositioning
--   thirdParty         holds off a target that is busy with someone else until it is hurt
--   thirdPartyBelow    ...under this health share (or the wait runs out: thirdPartyWait seconds)
--   avoidUnforced      fights only what shoots it, is close, or is on its objective
--   flank              works round the side of the target rather than straight at it
--   holdObjective      KOTH: stays on a hill the team already holds rather than pushing off it
--   buildRate          0-1, how readily it puts a barricade up when a build rule fires
--   buildFortify       builds at a held objective or building with nobody shooting yet
--   buildToCross       builds a wall mid-field to cross open ground toward the target
--   buildToBlock       builds behind itself to break a pursuer's line of sight while leaving
--   cookFrags          skilled enough to cook a frag for an airburst
-- One local for the whole section: this file is close to Luau's 200-local limit for a chunk.
local ARCH = {}

ARCH.Types = {
	Rusher = {
		rangeScale = 0.55, coverUse = 0.25, peek = false, repositionOnHit = 0.15, targetPick = "weakest",
		pushTargetBelow = 0.7, pushHealthAbove = 0.3, retreatHealth = 8, healBelow = 0.45,
		grenadeAt = 2, smokeToMove = false, thirdParty = false, avoidUnforced = false, flank = false,
		holdObjective = false, buildRate = 0.15, buildFortify = false, buildToCross = false, buildToBlock = false,
		cookFrags = false,
	},
	Marksman = {
