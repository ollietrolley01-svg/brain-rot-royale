		hud = "BONNET GUN",
		kind = "hitscan",
		damage = 8,
		headshotMultiplier = 1.25,
		range = 300,
		spread = 1.3,
		fireRate = 8,
		magazine = 40,
		recharge = 12,
		rechargeDelay = 1.0,
