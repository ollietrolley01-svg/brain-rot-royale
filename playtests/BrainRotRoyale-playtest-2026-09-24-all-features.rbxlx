profile("Neon", "Neon", "flicker", 0.25, 0.08, { bit = "shard", count = 2, sparks = true }, L("Shock", 0.2, "FlairBuzz", 0.4), { kind = "sparks", color = rgb(255, 230, 160) }, nil)
profile("ForceField", "ForceField", "flicker", 0.25, 0.08, { motes = true }, L("Shock", 0.18, "FlairBuzz", 0.35), nil, nil)
local PROFILES = P

local function profileOf(material)
	return PROFILES[material.Name] or PROFILES.Plastic
end

-- Each client draws a site from the same numbers the server wrote, so they all draw the same thing.
local function seedOf(site, index)
	local p = site.point
	local seed = site.face * 7919 + math.floor(p.X * 10 + 0.5) * 104729 + math.floor(p.Y * 10 + 0.5) * 1299709
		+ math.floor(p.Z * 10 + 0.5) * 15485863 + index * 31
	return seed % 2147483646 + 1
end

-- The face a site is on, measured: its axes, half-extents, depth from the part's centre, a scale
-- for how big its marks run, and whether it stands upright.
local function faceOf(size, face)
	local axes = FACES[face]
	local hu, hv = extent(axes.u, size), extent(axes.v, size)
	return {
		face = axes, hu = hu, hv = hv, depth = extent(axes.n, size),
		scale = math.clamp(math.min(hu, hv) / 2, 0.5, 1.6),
		side = face ~= 1 and face ~= 4,
	}
end

-- Every piece a site will ever show, full-grown, in the order they appear.
local function siteSpecs(size, site, index, color, material)
	local g = faceOf(size, site.face)
	local s = { u = site.point:Dot(g.face.u), v = site.point:Dot(g.face.v) }
	g.s = s
	g.color = color
	local specs = {}
	profileOf(material).look(Random.new(seedOf(site, index)), specs, s, g, color, material)
	for order, spec in ipairs(specs) do
		spec.order = order
		-- Cracked lava's lines glow a stage hotter as it gets worse (the colour is set when drawn).
		if spec.kind == "CrackGlowLine" then
			spec.lava = true
		end
	end
	table.sort(specs, function(a, b)
		if a.stage ~= b.stage then
			return a.stage &lt; b.stage
		end
		return a.order &lt; b.order
	end)
	return specs, g
end

-- "face,x,y,z;..." as the server writes it, at most MAX_SITES_PER_PART of them.
local function parseSites(text)
	local sites = {}
	if type(text) ~= "string" then
		return sites
	end
	for faceText, xText, yText, zText in string.gmatch(text, "(%d),(%-?[%d.]+),(%-?[%d.]+),(%-?[%d.]+)") do
		if #sites &gt;= MAX_SITES_PER_PART then
			break
		end
		local face, x, y, z = tonumber(faceText), tonumber(xText), tonumber(yText), tonumber(zText)
		if FACES[face] and x and y and z then
			table.insert(sites, { face = face, point = Vector3.new(x, y, z) })
		end
	end
	return sites
end

-- The stage of the pool a part is in: on the part, or on the Model above it that is the pool.
local function stageOf(part)
	local node = part
	while node and node ~= workspace do
		local stage = node:GetAttribute(STAGE_ATTRIBUTE)
		if type(stage) == "number" then
			return math.clamp(math.floor(stage), 0, 3)
		end
		node = node.Parent
	end
	return 0
end

--------------------------------------------------------------------------------
-- Flying bits: the chips, splinters, flakes, grains, pebbles, clods, tiles and leaves a hit knocks
-- off or a stage lets go of. Local physics, light and a little bouncy: they fall, bounce, settle,
-- and fade out over their last BIT_FADE seconds (debris, not the damaged part: #71 is about that).
--------------------------------------------------------------------------------

local bits = {}
local rng = Random.new()

local BIT_SIZES = {
	chip = function()
		local edge = rng:NextNumber(0.1, 0.26)
		return Vector3.new(edge, edge * rng:NextNumber(0.6, 1), edge * rng:NextNumber(0.6, 1))
	end,
	chunk = function()
		local edge = rng:NextNumber(0.25, 0.45)
		return Vector3.new(edge, edge * rng:NextNumber(0.6, 1), edge * rng:NextNumber(0.6, 1))
	end,
	splinter = function() return Vector3.new(0.05, 0.05, rng:NextNumber(0.3, 0.6)) end,
	leaf = function() return Vector3.new(rng:NextNumber(0.25, 0.4), 0.03, rng:NextNumber(0.2, 0.32)) end,
	shard = function() return Vector3.new(0.03, rng:NextNumber(0.1, 0.24), rng:NextNumber(0.08, 0.18)) end,
	flake = function() return Vector3.new(rng:NextNumber(0.18, 0.32), 0.03, rng:NextNumber(0.14, 0.26)) end,
	foil = function() return Vector3.new(rng:NextNumber(0.12, 0.22), 0.015, rng:NextNumber(0.1, 0.18)) end,
	scrap = function() return Vector3.new(rng:NextNumber(0.2, 0.34), 0.02, rng:NextNumber(0.14, 0.26)) end,
	grain = function()
		local e = rng:NextNumber(0.05, 0.09)
		return Vector3.new(e, e, e)
	end,
	grit = function()
		local e = rng:NextNumber(0.06, 0.12)
		return Vector3.new(e, e, e)
	end,
	crystal = function()
		local e = rng:NextNumber(0.08, 0.16)
		return Vector3.new(e, e, e)
	end,
	pebble = function()
		local e = rng:NextNumber(0.18, 0.3)
		return Vector3.new(e, e, e)
	end,
	clod = function()
		local e = rng:NextNumber(0.2, 0.34)
		return Vector3.new(e, e * 0.85, e * 0.9)
	end,
	clump = function()
		local e = rng:NextNumber(0.24, 0.4)
		return Vector3.new(e, e, e)
	end,
	drop = function()
		local e = rng:NextNumber(0.1, 0.18)
		return Vector3.new(e, e, e)
	end,
	crumb = function()
		local e = rng:NextNumber(0.1, 0.18)
		return Vector3.new(e, e * 0.7, e)
	end,
	tuft = function() return Vector3.new(0.05, rng:NextNumber(0.25, 0.4), 0.05) end,
	tileShard = function() return Vector3.new(rng:NextNumber(0.2, 0.34), 0.04, rng:NextNumber(0.16, 0.28)) end,
}
-- Round bits: pebbles, clods, drops, clumps and grains are balls.
local ROUND = { pebble = true, clod = true, drop = true, clump = true, grain = true, cobble = true }
local BIT_MATERIAL = { leaf = M.Grass, tuft = M.Grass, drop = M.Mud, clump = M.Snow, grain = M.Sand, foil = M.Foil,
	crystal = M.Glass, shard = M.Glass, pebble = M.Pebble, grit = M.Pebble }
local BOUNCY = PhysicalProperties.new(0.9, 0.4, 0.55)

local function spawnBit(kind, position, velocity, color, material, size, life)
	if #bits &gt;= MAX_BITS then
		return nil
	end
	local wedge = kind == "shard" or kind == "tileShard"
	local piece = Instance.new(wedge and "WedgePart" or "Part")
	piece.Name = "CrackBit"
	if ROUND[kind] and not wedge then
		piece.Shape = Enum.PartType.Ball
	end
	piece.Size = size or (BIT_SIZES[kind] or BIT_SIZES.chip)()
	piece.CFrame = CFrame.new(position) * CFrame.Angles(rng:NextNumber(0, 6.3), rng:NextNumber(0, 6.3), rng:NextNumber(0, 6.3))
	piece.Color = color
	piece.Material = BIT_MATERIAL[kind] or material
	if kind == "shard" or kind == "crystal" then
		piece.Transparency = 0.3
	end
	piece.CanCollide = true
	piece.CanQuery = false
	piece.CanTouch = false
	piece.CastShadow = false
	piece.CustomPhysicalProperties = (kind == "crumb" or kind == "pebble") and BOUNCY or LIGHT
	piece.Parent = fxFolder
	piece.AssemblyLinearVelocity = velocity
	piece.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-12, 12), rng:NextNumber(-12, 12), rng:NextNumber(-12, 12))
	table.insert(bits, { part = piece, born = now(), life = life or BIT_LIFE, base = piece.Transparency,
		drift = kind == "leaf" or kind == "scrap" or kind == "foil" or kind == "flake" })
	return piece
end

-- One throwaway emitter burst off a surface: dust, sawdust, sparks, a glint, embers, a spray of sand,
-- a splash of mud, powder of snow, light motes. At most MAX_PUFFS alive at once.
local puffs = 0
local function puff(position, normal, color, kind, size, count)
	if puffs &gt;= MAX_PUFFS then
		return nil
	end
	puffs += 1
	local holder = Instance.new("Part")
	holder.Name = "CrackPuff"
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	-- Its front face along the normal, so the burst comes off the surface.
	holder.CFrame = CFrame.lookAt(position + normal * 0.1, position + normal * 1.1)
	holder.Transparency = 1
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Parent = fxFolder
	local emitter = Instance.new("ParticleEmitter")
	emitter.Enabled = false
	emitter.EmissionDirection = Enum.NormalId.Front
	local n = 6
	if kind == "sparks" or kind == "embers" or kind == "motes" then
		emitter.Texture = SPARK_TEXTURE
		local hot = kind == "embers" and EMBER or (kind == "motes" and color or rgb(255, 226, 150))
		emitter.Color = ColorSequence.new(hot, kind == "motes" and color or rgb(255, 130, 40))
		emitter.LightEmission = 1
		emitter.Size = NumberSequence.new(kind == "embers" and 0.2 or 0.14, 0)
		emitter.Lifetime = NumberRange.new(kind == "embers" and 0.6 or 0.15, kind == "embers" and 1.2 or 0.35)
		emitter.Speed = NumberRange.new(kind == "sparks" and 12 or 3, kind == "sparks" and 24 or 7)
		emitter.SpreadAngle = Vector2.new(40, 40)
		emitter.Acceleration = Vector3.new(0, kind == "sparks" and -50 or 6, 0)
		n = kind == "sparks" and 12 or 10
	elseif kind == "glint" then
		emitter.Color = ColorSequence.new(rgb(235, 245, 255))
		emitter.LightEmission = 0.6
		emitter.Size = NumberSequence.new(0.18, 0)
		emitter.Lifetime = NumberRange.new(0.15, 0.3)
		emitter.Speed = NumberRange.new(4, 9)
		emitter.SpreadAngle = Vector2.new(50, 50)
	elseif kind == "spray" or kind == "splash" then
		-- Sand or mud thrown up in an arc that falls back.
		emitter.Texture = DUST_TEXTURE
		emitter.Color = ColorSequence.new(color)
		emitter.Size = NumberSequence.new(kind == "splash" and 0.22 or 0.14, kind == "splash" and 0.1 or 0.05)
		emitter.Lifetime = NumberRange.new(0.4, 0.8)
		emitter.Speed = NumberRange.new(8, 14)
		emitter.SpreadAngle = Vector2.new(35, 35)
		emitter.Acceleration = Vector3.new(0, -40, 0)
		n = 18
	else
		emitter.Texture = DUST_TEXTURE
		emitter.Color = ColorSequence.new(color)
		local big = size or 1
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3 * big), NumberSequenceKeypoint.new(1, 1.1 * big) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
		emitter.Lifetime = NumberRange.new(0.5, 0.9)
		emitter.Speed = NumberRange.new(2, 5)
		emitter.SpreadAngle = Vector2.new(35, 35)
		emitter.Acceleration = Vector3.new(0, -2, 0)
		emitter.Drag = 3
		emitter.Rotation = NumberRange.new(0, 360)
	end
	emitter.Parent = holder
	emitter:Emit(count or n)
	task.delay(1.4, function()
		puffs -= 1
		holder:Destroy()
	end)
	return holder
end

-- What a hit knocks off, by material (the profile's `burst`).
local SOIL = rgb(92, 66, 44)
local function hitBurst(material, position, normal, color, count)
	local burst = profileOf(material).burst
	if burst.sparks then
		puff(position, normal, color, "sparks")
	end
	if burst.fewSparks and rng:NextNumber() &lt; 0.3 then
		puff(position, normal, color, "sparks")
	end
	if burst.embers then
		puff(position, normal, color, "embers")
	end
	if burst.motes then
		puff(position, normal, color:Lerp(WHITE, 0.4), "motes")
	end
	if burst.glint then
		puff(position, normal, color, "glint")
	end
	if burst.spray then
		puff(position, normal, burst.dust or color, "spray")
	elseif burst.splash then
		puff(position, normal, color:Lerp(BLACK, 0.4), "splash")
	elseif burst.dust then
		puff(position, normal, burst.dust, "dust", burst.puffSize)
	end
	local kind = burst.bit
	for _ = 1, kind and math.min((burst.count or 0) + count - 1, 6) or 0 do
		local spread = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.4, 1), rng:NextNumber(-1, 1))
		local soft = kind == "leaf" or kind == "scrap" or kind == "tuft"
		local speed = soft and rng:NextNumber(1, 3) or rng:NextNumber(5, 11)
		local tint = (kind == "leaf" or kind == "tuft") and color or color:Lerp(BLACK, rng:NextNumber(0, 0.2))
		spawnBit(kind, position + normal * 0.15, (normal + spread * 0.6).Unit * speed + Vector3.new(0, 2, 0), tint, material)
	end
	for _ = 1, burst.clods or 0 do
		local spread = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0, 1), rng:NextNumber(-1, 1))
		spawnBit("clod", position + normal * 0.15, (normal + spread * 0.5).Unit * rng:NextNumber(5, 9) + Vector3.new(0, 3, 0), SOIL, M.Ground)
	end
end

-- A hit's sound: the material's two layers, each with its own pitch jitter and a little volume
-- jitter, the second a beat behind. `loud` (a stage rising) plays them up.
local lastSound = {}

local function playLayers(material, position, loud)
	local p = profileOf(material)
	local played = 0
	for _, layer in ipairs(p.layers) do
		local cue, gain, delay = layer[1], layer[2], layer[3]
		if SoundConfig.Get(cue) then
			played += 1
			local volume = gain * rng:NextNumber(0.85, 1.12) * (loud and 1.6 or 1)
			if delay &gt; 0 then
				task.delay(delay, function()
					Sfx.PlayAt(cue, position, 0.3, nil, volume)
				end)
			else
				Sfx.PlayAt(cue, position, 0.3, nil, volume)
			end
		end
	end
	return played
end

local function playHit(material, part, position)
	local clock = now()
	if lastSound[part] and clock - lastSound[part] &lt; SOUND_GAP then
		return false
	end
	lastSound[part] = clock
	return playLayers(material, position, false) &gt; 0
end

--------------------------------------------------------------------------------
-- Moving pieces: every animated piece is in `anims` until it arrives. One pass a frame, one
-- BulkMoveTo for all their frames.
--------------------------------------------------------------------------------

local anims = {}
local flickers = {}
local counts = { animating = 0, flickering = 0 }

-- Fast then slowing (the default arrival), and the even crawl of a split running along the grain.
local function easeOut(t)
	return 1 - (1 - t) ^ 3
end
local function crawl(t)
	return t ^ 0.9
end

-- 0 -&gt; 1 with an overshoot that settles: a board springing loose, a dent pushing in.
local function spring(t)
	return 1 - math.cos(t * math.pi * 2.5) * math.exp(-4.5 * t)
end

-- Where a spec's piece is, at progress t (0 -&gt; 1), in the face's frame, and its size.
local function poseAt(spec, t, size, style)
	if spec.line then
		local l = spec.line
		local k = style == "creep" and crawl(t) or easeOut(t)
		local shown = l.length * k
		local c, s = math.cos(l.angle), math.sin(l.angle)
		return CFrame.new(l.u + c * shown / 2, l.v + s * shown / 2, l.z) * CFrame.Angles(0, 0, l.angle),
			Vector3.new(math.max(0.02, shown + size.Y * 0.5 * t), size.Y, size.Z)
	elseif spec.swing then
		local w = spec.swing
		return hingeFrame(w.u, w.v, w.du, w.dv, w.length, w.thickness, w.angle * spring(t)), size
	elseif spec.slide then
		local k = style == "slump" and t * t * (3 - 2 * t) or easeOut(t)
		return CFrame.new(spec.slide * (1 - k)) * spec.frame, size
	else
		local from = spec.pop or 0.25
		local k = style == "push" and (from + (1 - from) * spring(t)) or (from + (1 - from) * easeOut(math.min(1, t * 1.15)))
		if spec.shape == Enum.PartType.Cylinder then
			return spec.frame, Vector3.new(size.X, size.Y * k, size.Z * k)
		end
		return spec.frame, Vector3.new(size.X * k, size.Y * k, size.Z)
	end
end

-- A piece's size at a stage and a level of detail: cracks widen as the stage rises, and far off
-- (lod 3) the main ones are drawn FAR_BOLD wider.
local function sizeFor(spec, stage, lod)
	local size = spec.size
	local wide = 1
	if spec.grow and stage &gt; spec.stage then
		wide *= 1 + 0.35 * (stage - spec.stage)
	end
	if spec.core and lod == 3 then
		wide *= FAR_BOLD
	end
	if wide ~= 1 then
		size = Vector3.new(size.X, size.Y * wide, size.Z)
	end
	return size
end

local LAVA = { [0] = rgb(150, 26, 10), rgb(214, 62, 16), rgb(255, 138, 30), rgb(255, 214, 120) }

local function realize(part, faceFrame, spec, stage, lod)
	local piece = Instance.new(spec.class or "Part")
	-- CrackLine, CrackLip, CrackShade, CrackChip, CrackRebar, CrackFlake, CrackSeam, ...: what it is,
	-- for Explorer (and for tools/crack_check.py, which reads each material's look from these names).
	piece.Name = spec.kind
	if spec.shape and piece:IsA("Part") then
		piece.Shape = spec.shape
	end
	piece.Size = sizeFor(spec, stage, lod)
	piece.CFrame = part.CFrame * faceFrame * spec.frame
	piece.Color = spec.lava and LAVA[math.clamp(stage, 0, 3)] or spec.color
	piece.Material = spec.material or SMOOTH
	piece.Transparency = spec.transparency or 0
	if spec.reflect then
		piece.Reflectance = spec.reflect
	end
	piece.Anchored = true
	piece.CanCollide = false
	piece.CanQuery = false
	piece.CanTouch = false
	piece.CastShadow = false
	piece.Parent = fxFolder
	return piece
end

-- Starts a piece's arrival `delay` seconds from now (its bit flies, its trail puffs, when it starts).
local function animate(record, piece, spec, faceFrame, stage, delay, duration, world, normal, style, lod)
	if counts.animating &gt;= MAX_ANIMATING then
		return false
	end
	counts.animating += 1
	local size = sizeFor(spec, stage, lod)
	local frame, startSize = poseAt(spec, 0, size, style)
	piece.CFrame = record.part.CFrame * faceFrame * frame
	piece.Size = startSize
	piece.Transparency = 1
	table.insert(anims, { piece = piece, spec = spec, face = faceFrame, record = record, size = size, start = now() + delay,
		duration = duration, transparency = spec.transparency or 0, world = world, normal = normal, style = style })
	return true
end

local function detachBit(record, spec, world, normal)
	local d = spec.detach
	if not d or not record.part.Parent then
		return
	end
	local speed = rng:NextNumber(3, 6)
	local spread = Vector3.new(rng:NextNumber(-0.5, 0.5), rng:NextNumber(-0.2, 0.6), rng:NextNumber(-0.5, 0.5))
	spawnBit(d.kind or "chip", world + normal * 0.2, (normal + spread).Unit * speed + Vector3.new(0, 2.5, 0), d.color or record.part.Color,
		record.part.Material, d.size, d.life)
end

local function stepAnims()
	if #anims == 0 then
		return
	end
	local clock = now()
	local moved, frames = {}, {}
	for index = #anims, 1, -1 do
		local a = anims[index]
		local piece = a.piece
		if not piece.Parent or not a.record.part.Parent then
			table.remove(anims, index)
			counts.animating -= 1
		elseif clock &gt;= a.start then
			if not a.started then
				a.started = true
				piece.Transparency = a.transparency
				if a.spec.detach then
					detachBit(a.record, a.spec, a.world, a.normal)
				end
				if a.style == "push" and a.spec.kind == "CrackDent" and rng:NextNumber() &lt; 0.5 then
					puff(a.world, a.normal, piece.Color, "sparks", nil, 6)
				end
			end
			local t = math.clamp((clock - a.start) / a.duration, 0, 1)
			local frame, size = poseAt(a.spec, t, a.size, a.style)
			if a.style == "flicker" and t &lt; 1 then
				-- Neon and force fields blink as they crack.
				piece.Transparency = rng:NextNumber() &lt; 0.45 and 1 or a.transparency
			end
			if t &gt;= 1 then
				frame, size = a.spec.frame, a.size
				piece.Transparency = a.transparency
				table.remove(anims, index)
				counts.animating -= 1
				if a.trail then
					-- Dust thrown along the crack as it reaches here.
					local l = a.spec.line
					local tip = a.record.part.CFrame * a.face * Vector3.new(l.u + math.cos(l.angle) * l.length, l.v + math.sin(l.angle) * l.length, 0)
					puff(tip, a.normal, a.trail, "dust", 0.45, 3)
				end
			end
			piece.Size = size
			table.insert(moved, piece)
			table.insert(frames, a.record.part.CFrame * a.face * frame)
		end
	end
	if #moved &gt; 0 then
		workspace:BulkMoveTo(moved, frames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local flickerClock = 0
local function stepFlicker(dt)
	flickerClock += dt
	if flickerClock &lt; 1 / FLICKER_HZ then
		return
	end
	flickerClock = 0
	for index = #flickers, 1, -1 do
		local f = flickers[index]
		if not f.piece.Parent then
			table.remove(flickers, index)
			counts.flickering -= 1
		else
			-- Mostly dark, now and then lit through for a frame or two: a dying tube.
			f.piece.Transparency = rng:NextNumber() &lt; 0.22 and 0.85 or f.base
		end
	end
end

-- A white flash at the hit as ice and glacier fracture: a local disc that burns out in 0.18 s.
local function flash(world, normal, size)
	local disc = Instance.new("Part")
	disc.Name = "CrackFlash"
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = Vector3.new(0.05, size, size)
	disc.CFrame = CFrame.lookAt(world + normal * 0.05, world + normal * 1.05) * CFrame.Angles(0, math.pi / 2, 0)
	disc.Color = WHITE
	disc.Material = NEON
	disc.Transparency = 0.1
	disc.Anchored = true
	disc.CanCollide = false
	disc.CanQuery = false
	disc.CanTouch = false
	disc.CastShadow = false
	disc.Parent = fxFolder
	TweenService:Create(disc, TweenInfo.new(0.18), { Transparency = 1, Size = Vector3.new(0.05, size * 2.2, size * 2.2) }):Play()
	task.delay(0.2, function()
		disc:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- The parts being drawn
--------------------------------------------------------------------------------

-- part -&gt; record. Strong keys: every record is removed when its part goes (Destroying, the tag
-- coming off, or the sweep finding it out of the workspace).
local tracked = {}
local totals = { pieces = 0, built = 0, trickles = 0 }

local function unbuild(record)
	for _, piece in ipairs(record.pieces) do
		piece:Destroy()
	end
	totals.pieces -= #record.pieces
	record.pieces, record.pieceSites, record.pieceSpecs = {}, {}, {}
	record.shown, record.drawn = {}, {}
	if record.trickle then
		record.trickle:Destroy()
		record.trickle = nil
		totals.trickles -= 1
	end
	if record.built then
		record.built = false
		totals.built -= 1
	end
end

-- The emitter a badly hurt part keeps up (dust, sand grains, embers, sparks, rust flakes, snow).
local function trickle(record, profile, lowest, stage)
	local t = profile.trickle
	if not t or not lowest or totals.trickles &gt;= MAX_TRICKLES then
		return
	end
	local holder = Instance.new("Part")
	holder.Name = "CrackDust"
	holder.Size = Vector3.new(0.4, 0.2, 0.4)
	holder.CFrame = CFrame.new(lowest.world + lowest.normal * 0.15)
	holder.Transparency = 1
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Parent = fxFolder
	local emitter = Instance.new("ParticleEmitter")
	if t.kind == "embers" or t.kind == "sparks" then
		emitter.Texture = SPARK_TEXTURE
		emitter.Color = ColorSequence.new(t.color)
		emitter.LightEmission = 1
		emitter.EmissionDirection = t.kind == "embers" and Enum.NormalId.Top or Enum.NormalId.Bottom
		emitter.Size = NumberSequence.new(t.kind == "embers" and 0.18 or 0.12, 0)
		emitter.Lifetime = NumberRange.new(0.6, 1.4)
		emitter.Rate = t.kind == "embers" and (stage &gt;= 3 and 8 or 4) or (stage &gt;= 3 and 3 or 1.2)
		emitter.Speed = NumberRange.new(t.kind == "embers" and 1 or 4, t.kind == "embers" and 3 or 9)
		emitter.SpreadAngle = Vector2.new(25, 25)
		emitter.Acceleration = Vector3.new(0, t.kind == "embers" and 3 or -40, 0)
	else
		emitter.Texture = DUST_TEXTURE
		emitter.Color = ColorSequence.new(t.color)
		emitter.EmissionDirection = Enum.NormalId.Bottom
		local grains = t.kind == "grains" or t.kind == "rust" or t.kind == "snow"
		emitter.Size = grains and NumberSequence.new(0.1, 0.06)
			or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0.7) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, grains and 0.1 or 0.5), NumberSequenceKeypoint.new(1, 1) })
		emitter.Lifetime = NumberRange.new(grains and 0.8 or 1.2, grains and 1.4 or 2)
		emitter.Rate = (grains and 10 or 2.5) * (stage &gt;= 3 and 2 or 1)
		emitter.Speed = NumberRange.new(0.4, 1.2)
		emitter.SpreadAngle = Vector2.new(grains and 8 or 15, grains and 8 or 15)
		emitter.Acceleration = Vector3.new(0, grains and -25 or -3, 0)
		emitter.Drag = grains and 0 or 1
	end
	emitter.Parent = holder
	record.trickle = holder
	totals.trickles += 1
end

-- The level of detail for a part at `distance`, from the one it had (hysteresis).
local function lodFor(distance, current)
	local nearEdge = LOD_NEAR + ((current == 1) and LOD_SLACK or -LOD_SLACK)
	local farEdge = LOD_FAR + ((current == 3) and -LOD_SLACK or LOD_SLACK)
	if distance &lt;= nearEdge then
		return 1
	elseif distance &gt;= farEdge then
		return 3
	end
	return 2
end

-- When a new piece of this style starts, as a share of the stage's spread: steps jump in three,
-- a web's rays shoot out while its rings creep behind, everything else runs out with the distance.
local function startShare(style, share, spec)
	if style == "steps" then
		return math.floor(share * 3 + 0.5) / 3
	elseif style == "web" and spec.kind == "CrackWebRing" then
		return 1.5 + share * 4
	end
	return share
end

-- Draws what a part's sites show at its stage and level of detail, adding only what isn't drawn
-- yet. `play` (the stage rose or a site opened while the part is near): the new pieces grow in;
-- otherwise they appear finished (a late joiner, a part coming back into range, a change of detail).
local function build(part, record, play)
	if not record.built then
		record.built = true
		totals.built += 1
		record.cframe = part.CFrame
	end
	record.cache = record.cache or {}
	record.shown = record.shown or {}
	record.drawn = record.drawn or {}
	local profile = profileOf(part.Material)
	local stage = record.stage
	local lod = record.lod or 1
	local cframe = part.CFrame
	local lowest = nil
	local animated = play and record.distance and record.distance &lt;= ANIMATE_WITHIN
	local trails = 0
	for index, site in ipairs(record.sites) do
		local cached = record.cache[index]
		if not cached then
			local specs, g = siteSpecs(part.Size, site, index, part.Color, part.Material)
			cached = { specs = specs, g = g, faceFrame = CFrame.fromMatrix(g.face.n * g.depth, g.face.u, g.face.v, g.face.n) }
			record.cache[index] = cached
		end
		local specs, faceFrame = cached.specs, cached.faceFrame
		local normal = cframe:VectorToWorldSpace(cached.g.face.n)
		local shown = record.shown[index] or 0
		-- Pieces already up: cracks widen, lava glows hotter, as the stage rises.
		for k, piece in ipairs(record.pieces) do
			local spec = record.pieceSpecs[k]
			if record.pieceSites[k] == index and spec and piece.Parent then
				if spec.grow then
					piece.Size = sizeFor(spec, stage, lod)
				end
				if spec.lava then
					piece.Color = LAVA[math.clamp(stage, 0, 3)]
				end
			end
		end
		-- The new pieces: those of stages now reached, at this level of detail, up to the caps.
		local fresh = {}
		local drawn = record.drawn[index] or { 0, 0 }
		for k = shown + 1, #specs do
			local spec = specs[k]
			if spec.stage &gt; stage then
				break
			end
			shown = k
			local isLine = spec.line ~= nil
			if (spec.lod or 3) &gt;= lod and drawn[1] + drawn[2] &lt; PER_SITE_CAP and (not isLine or drawn[1] &lt; PER_SITE_LINES)
				and totals.pieces + #fresh &lt; MAX_PIECES then
				local slot = isLine and 1 or 2
				drawn[slot] += 1
				table.insert(fresh, spec)
			end
		end
		record.shown[index] = shown
		record.drawn[index] = drawn
		local lo, hi = math.huge, -math.huge
		for _, spec in ipairs(fresh) do
			lo, hi = math.min(lo, spec.dist or 0), math.max(hi, spec.dist or 0)
		end
		if animated and #fresh &gt; 0 and profile.style == "race" then
			flash(cframe * site.point, normal, 1.6)
		end
		for _, spec in ipairs(fresh) do
			local piece = realize(part, faceFrame, spec, stage, lod)
			table.insert(record.pieces, piece)
			table.insert(record.pieceSites, index)
			table.insert(record.pieceSpecs, spec)
			totals.pieces += 1
			local world = cframe * (faceFrame * spec.frame).Position
			local moving = false
			if animated then
				local share = hi &gt; lo and ((spec.dist or 0) - lo) / (hi - lo) or 0
				local delay = profile.spread * startShare(profile.style, share, spec) + (spec.branch or 0) * BRANCH_STAGGER
				local duration = profile.grow
				if spec.line then
					-- Lines take their length's time at the style's pace, within the grow.
					duration = math.clamp(spec.line.length * profile.grow, 0.04, profile.grow * 2.2)
				end
				if profile.style == "web" and spec.kind == "CrackWebRing" then
					duration = 0.25
				end
				moving = animate(record, piece, spec, faceFrame, stage, delay, duration, world, normal, profile.style, lod)
				if moving and profile.trail and spec.core and spec.branch == 0 and trails &lt; 3 and rng:NextNumber() &lt; 0.3 then
					trails += 1
					anims[#anims].trail = profile.trail
				end
			end
			if not moving and spec.detach and play and record.distance and record.distance &lt;= BURST_DISTANCE then
				detachBit(record, spec, world, normal)
			end
			if spec.flicker and counts.flickering &lt; MAX_FLICKER then
				counts.flickering += 1
				table.insert(flickers, { piece = piece, base = spec.transparency or 0 })
			end
		end
		if animated and #fresh &gt; 0 and profile.style == "web" then
			-- Glass tinkles as it goes: a few shards off the new web.
			for _ = 1, 2 do
				spawnBit("shard", cframe * site.point + normal * 0.2, normal * rng:NextNumber(3, 6) + Vector3.new(0, 2, 0), rgb(220, 235, 245), M.Glass)
			end
		end
		local world = cframe * site.point
		if not lowest or world.Y &lt; lowest.world.Y then
			lowest = { world = world, normal = normal }
		end
	end
	if stage &gt;= 2 and not record.trickle then
		trickle(record, profile, lowest, stage)
	end
end

local function untrack(part)
	local record = tracked[part]
	if not record then
		return
	end
	tracked[part] = nil
	lastSound[part] = nil
	unbuild(record)
	if record.connection then
		record.connection:Disconnect()
	end
end

local function track(part)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return nil
	end
	local record = tracked[part]
	if record then
		return record
	end
	record = { part = part, pieces = {}, pieceSites = {}, pieceSpecs = {}, shown = {}, drawn = {}, sites = {}, stage = -1, built = false,
		dirty = true, lod = 1 }
	record.connection = part.Destroying:Connect(function()
		untrack(part)
	end)
	tracked[part] = record
	return record
end

-- Re-reads what the server has written for a part; marks it for a (partial) rebuild if anything
-- changed. `play` is set when the change should be seen happening (the stage rose, a site opened).
local function refresh(part, record)
	local text = part:GetAttribute(SITES_ATTRIBUTE)
	if text ~= record.text then
		local had = #record.sites
		record.text = text
		record.sites = parseSites(text)
		record.dirty = true
		if record.stage &gt;= 0 and #record.sites &gt; had then
			record.play = true
		end
	end
	local stage = stageOf(part)
	if stage ~= record.stage then
		if record.stage &gt;= 0 and stage &gt; record.stage then
			record.play = true
			record.rose = true
		end
		record.stage = stage
		record.dirty = true
	end
end

local LEAF_CHANCE = { [2] = 0.25, [3] = 0.5 }

-- Four times a second: drop what has gone, re-read what changed, and draw the nearest damaged parts
-- within reach (the farthest giving up theirs when the caps are reached), each at its detail.
local function sweep()
	local eye = camera and camera.CFrame.Position
	if not eye then
		return
	end
	local candidates = {}
	for part, record in pairs(tracked) do
		if not part.Parent or not part:IsDescendantOf(workspace) then
			untrack(part)
		elseif not part.Anchored then
			-- Coming down (a collapsing chunk): nothing drawn on it until it lies still again.
			if record.built then
				unbuild(record)
				record.cache = nil
			end
			record.play = false
		else
			if record.built and record.cframe and record.cframe ~= part.CFrame then
				-- It moved (it landed as rubble): drawn again where it lies, finished.
				unbuild(record)
				record.cache = nil
				record.dirty = true
				record.play = false
			end
			refresh(part, record)
			record.distance = math.max(0, (part.Position - eye).Magnitude - part.Size.Magnitude / 2)
			local lod = lodFor(record.distance, record.lod)
			if lod ~= record.lod then
				record.lod = lod
				if record.built then
					unbuild(record)
				end
				record.dirty = true
				record.play = false
			end
			if #record.sites == 0 or record.distance &gt; DROP_BEYOND then
				if record.built then
					unbuild(record)
				end
			elseif record.distance &lt;= BUILD_WITHIN or record.built then
				table.insert(candidates, record)
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.distance &lt; b.distance
	end)
	local farthest = #candidates
	for rank, record in ipairs(candidates) do
		if rank &gt; MAX_BUILT then
			if record.built then
				unbuild(record)
			end
		elseif not record.built or record.dirty then
			while totals.pieces &gt; MAX_PIECES - PER_SITE_CAP * MAX_SITES_PER_PART and farthest &gt; rank do
				if candidates[farthest].built then
					unbuild(candidates[farthest])
				end
				farthest -= 1
			end
			build(record.part, record, record.built and record.play)
			record.dirty = false
			record.play = false
		end
		-- Leaves keep coming down off a tree that has been shot bare.
		local chance = LEAF_CHANCE[record.stage]
		if chance and record.built and record.part.Material == M.LeafyGrass and record.distance &lt;= BURST_DISTANCE and rng:NextNumber() &lt; chance then
			local site = record.sites[rng:NextInteger(1, #record.sites)]
			local at = record.part.CFrame * site.point
			spawnBit("leaf", at + Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)), Vector3.new(0, -1, 0), record.part.Color, M.Grass)
		end
	end
end

--------------------------------------------------------------------------------
-- Wiring
--------------------------------------------------------------------------------

for _, part in ipairs(CollectionService:GetTagged(DAMAGED_TAG)) do
	track(part)
end
CollectionService:GetInstanceAddedSignal(DAMAGED_TAG):Connect(track)
CollectionService:GetInstanceRemovedSignal(DAMAGED_TAG):Connect(untrack)

damageFx.OnClientEvent:Connect(function(batch)
	if type(batch) ~= "table" or not camera then
		return
	end
	local eye = camera.CFrame.Position
	local bursts, sounds = 0, 0
	for _, hit in ipairs(batch) do
		local part, point, face, count = hit[1], hit[2], hit[3], hit[4]
		if typeof(part) == "Instance" and part:IsA("BasePart") and part.Parent and typeof(point) == "Vector3" and FACES[face] then
			local record = track(part)
			refresh(part, record)
			local world = part.CFrame * point
			local distance = (world - eye).Magnitude
			record.distance = distance
			record.lod = lodFor(math.max(0, distance - part.Size.Magnitude / 2), record.lod)
			if distance &lt;= BURST_DISTANCE then
				if bursts &lt; BURSTS_PER_EVENT then
					bursts += 1
					hitBurst(part.Material, world, part.CFrame:VectorToWorldSpace(FACES[face].n), part.Color,
						math.clamp(type(count) == "number" and count or 1, 1, 4))
				end
				if sounds &lt; SOUNDS_PER_EVENT then
					if record.rose then
						-- A stage rising: its crack, louder.
						sounds += 1
						lastSound[part] = now()
						playLayers(part.Material, world, true)
					elseif playHit(part.Material, part, world) then
						sounds += 1
					end
				end
			end
			record.rose = false
			-- A new site or stage shows at once rather than at the next sweep, growing in.
			if record.dirty and #record.sites &gt; 0 and part.Anchored and (record.built or (distance &lt;= BUILD_WITHIN and totals.built &lt; MAX_BUILT)) then
				build(part, record, record.play and record.stage &gt;= 0)
				record.dirty = false
				record.play = false
			end
		end
	end
end)

local sinceSweep = 0
RunService.Heartbeat:Connect(function(dt)
	sinceSweep += dt
	if sinceSweep &gt;= SWEEP_EVERY then
		sinceSweep = 0
		sweep()
	end
	stepAnims()
	stepFlicker(dt)
	local clock = now()
	for index = #bits, 1, -1 do
		local bit = bits[index]
		local piece = bit.part
		local age = clock - bit.born
		if not piece.Parent or age &gt; bit.life or piece.Position.Y &lt; -500 then
			piece:Destroy()
			table.remove(bits, index)
		else
			if age &gt; bit.life - BIT_FADE then
				-- Settled: it fades out where it lies.
				piece.Transparency = bit.base + (1 - bit.base) * (age - (bit.life - BIT_FADE)) / BIT_FADE
			end
			if bit.drift then
				local velocity = piece.AssemblyLinearVelocity
				if velocity.Y &lt; -3 then
					-- Air under a leaf, a flake, a scrap: it flutters down rather than drops.
					piece.AssemblyLinearVelocity = Vector3.new(velocity.X * 0.96, -3, velocity.Z * 0.96)
				end
			end
		end
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX149"><Properties><string name="Name">DeathFxClient</string><ProtectedString name="Source">-- The client half of DeathFxService: a sound at every body as its effect plays, the shove for our
-- own body, and the dressing on the plain death. A player's character is simulated by their own
-- client, so the server can't push it — it sends the velocity here and we apply it to whatever parts
-- we still own.
--
-- The plain death (a ragdoll: no death effect equipped by the killer, a storm death, a fall) gets two
-- small effects from Shared/DeathEffectDesigns, run on the same engine as the death effect cosmetics:
-- at the hit, a white flash over the body, a spit of rot sparks, a thud of dust and a little rot-soul
-- wisp rising out of it; and when the server starts fading the ragdoll, a soft puff where it lies, so
-- it goes rather than just thinning. Neither ever moves the body (the server's physics owns it), and
-- neither plays once a death effect has claimed the body (KillAnimService arrives a moment after).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local DeathEffectFx = require(Shared:WaitForChild("DeathEffectFx"))
local Designs = require(Shared:WaitForChild("DeathEffectDesigns"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local player = Players.LocalPlayer
local deathFx = Remotes.Event("DeathFx")

-- Effect (or moment within one) -&gt; sound and pitch jitter.
local CUES = {
	ragdoll = { "BodyFall", 0.2 },
	float = { "FloatAway", 0.15 },
	ash = { "AshAway", 0.15 },
	burn = { "Burn", 0.2 },
	freeze = { "Freeze", 0.1 },
	shatter = { "Shatter", 0.2 },
	shock = { "Shock", 0.3 },
	confetti = { "Confetti", 0.2 },
	vaporize = { "Vaporize", 0.15 },
	gold = { "Gold", 0.1 },
	goldCrumble = { "GoldCrumble", 0.2 },
}

-- The plain death's dressing: at most this many at once (a grenade drops five), none further than
-- this from the camera, and a beat's wait first for a death effect to claim the body.
local MAX_DRESSED = 6
local DRESS_DISTANCE = 200
local CLAIM_WAIT = 0.1

local function shoveOwnBody(data)
	local character = player.Character
	if not character or typeof(data.velocity) ~= "Vector3" then
		return
	end
	local scatter = tonumber(data.scatter) or 0
	local angular = tonumber(data.angular) or 0
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and not part.Anchored then
			part.AssemblyLinearVelocity = data.velocity
				+ Vector3.new((math.random() - 0.5) * scatter, math.random() * scatter * 0.6, (math.random() - 0.5) * scatter)
			if angular &gt; 0 then
				part.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-8, 8), math.random(-8, 8)) * angular
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Dressing the plain death
--------------------------------------------------------------------------------

-- Running dressings, stepped by one Heartbeat connection that exists only while one runs. Time is the
-- sum of frame deltas.
local dressing = {}
local connection

local function stepAll(dt)
	for index = #dressing, 1, -1 do
		local entry = dressing[index]
		entry.t += dt
		if entry.t &gt;= entry.life then
			entry.fx:destroy()
			table.remove(dressing, index)
		else
			local ok, err = pcall(entry.fx.step, entry.fx, entry.t)
			if not ok then
				warn("[DeathFxClient] " .. tostring(err))
				entry.fx:destroy()
				table.remove(dressing, index)
			end
		end
	end
	if #dressing == 0 and connection then
		connection:Disconnect()
		connection = nil
	end
end

local function claimed(body)
	return body:GetAttribute("DeathFxClaimed") == true
end

-- One of Designs.Default's effects on `body`, unless it's been claimed, is gone, is too far, or too
-- many are running.
local function dress(design, body, position)
	if not body.Parent or claimed(body) or #dressing &gt;= MAX_DRESSED then
		return
	end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - position).Magnitude &gt; DRESS_DISTANCE then
		return
	end
	local fx = DeathEffectFx.new({
		parent = workspace,
		name = "DeathFxDressing",
		origin = position,
		life = design.life,
		body = body,
		ownsBody = false,
		seed = math.random(1, 1000000),
	})
	local ok, err = pcall(design.build, fx)
	if ok then
		ok, err = pcall(fx.step, fx, 0)
	end
	if not ok then
		warn("[DeathFxClient] " .. tostring(err))
		fx:destroy()
		return
	end
	table.insert(dressing, { fx = fx, t = 0, life = design.life })
	if not connection then
		connection = RunService.Heartbeat:Connect(stepAll)
	end
end

local function torsoPosition(body, fallback)
	local torso = body:FindFirstChild("UpperTorso") or body:FindFirstChild("Torso") or body:FindFirstChild("HumanoidRootPart")
	return torso and torso.Position or fallback
end

local function dressRagdoll(data)
	local body = data.body
	if typeof(body) ~= "Instance" or not body:IsA("Model") then
		return
	end
	task.delay(CLAIM_WAIT, function()
		dress(Designs.Default.Impact, body, torsoPosition(body, data.position))
	end)
	local linger = tonumber(data.linger)
	if linger and linger &gt; CLAIM_WAIT then
		task.delay(linger, function()
			if body.Parent then
				dress(Designs.Default.Poof, body, torsoPosition(body, data.position))
			end
		end)
	end
end

deathFx.OnClientEvent:Connect(function(data)
	if type(data) ~= "table" then
		return
	end
	if data.kind == "shove" then
		shoveOwnBody(data)
		return
	end
	local cue = CUES[data.kind]
	if cue and typeof(data.position) == "Vector3" then
		Sfx.PlayAt(cue[1], data.position, cue[2])
	end
	if data.kind == "ragdoll" and typeof(data.position) == "Vector3" then
		dressRagdoll(data)
	end
end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX150"><Properties><string name="Name">DefensePreview</string><ProtectedString name="Source">-- The placement preview for portable defenses: while a Rot Barricade, Pop-up Bunker or Brainrot
-- Fortress is in your hand, a translucent ghost of exactly what DefenseService will build stands where
-- it will go up, green when the site is good and red when it isn't. No text: the ghost, the dotted lob,
-- the tint, a red outline on the structure a fourth throw would knock down, and a marker where you aimed
-- when the throw will not reach it say all of it in the world. A ModuleScript so
-- HudClient can drive it and tools/hud_ux_gallery.lua can render it without a match.
--
--   local preview = DefensePreview.new()
--   preview:Update(character, itemId)            -- each frame while a defense is held (aims for itself)
--   preview:Update(character, itemId, aimPoint)  -- or with an aim point (galleries, probes)
--   preview:Hide()
--   DefensePreview.Site(character, itemId, aimPoint)  -- the prediction alone, no drawing (probes)
--   DefensePreview.FlyKit(info)                  -- a thrown structure kit, flown on this client
--
-- It predicts rather than guesses:
--   * the aim is CombatClient's own crosshair point (AimState), the point the throw is sent with;
--   * the throw is the server's: the same start at the head, the same range clamp and facing
--     (DefensePlacement.ThrowTarget), the same lift where the kit lands;
--   * the site is the server's: DefensePlacement.FindSite, the function DefenseService itself calls,
--     with the same size, leaving out only what exists on this client alone (the camera's viewmodel
--     and this ghost, client-side effects);
--   * the ghost is the server's: a clone of the structure DefenseService builds with its own builders
--     into ReplicatedStorage.DefenseTemplates, set on the plan's origin (level, or tilted along a
--     barricade's length), with the plan's footings -- posts, sill, floats, ladder -- drawn from the
--     same DefensePlacement.Footings list DefenseService builds them from.
-- The kit does not arrive where you aimed: it is lobbed on an arc (DefensePlacement.ThrowArc) flat enough
-- to clip a rising hill, and measured on a real map the arc meets the ground a median 10 studs from the
-- aim point. So the preview walks that same arc (DefensePlacement.Landing, the function the server now
-- builds from) and puts the ghost where the throw will actually land, marks your aim when that is far
-- off, and stops the dotted lob there rather than drawing through the hillside. A structure's kit no
-- longer rolls (#128, 09-24: it deploys where the arc lands), so the ghost is a promise, not "about
-- here"; only the Rot Mine, still a physics throw, keeps the ring of how far it may roll.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DefensePlacement = require(Shared:WaitForChild("DefensePlacement"))
local ItemData = require(Shared:WaitForChild("ItemData"))
local ItemModels = require(Shared:WaitForChild("ItemModels"))
local RunService = game:GetService("RunService")

local DefensePreview = {}
DefensePreview.__index = DefensePreview

-- The ring's radius: how far the kit rolls AFTER it lands, now that the arc above is traced rather than
-- assumed. Measured over 72 real throws on SahurSprings with physics (tools/hud_ux_gallery.lua "grip",
-- 2026-09-17): the roll from first contact to rest is mean 5.6, p50 2.7, p75 4.8, p90 11.9 studs, and no
-- kit friction, weight or bounce setting moved it. Five studs covers three throws in four. (The old
-- value of 16.2 was the distance from the AIM, which is a different and much larger thing: the same run
-- put the first contact a median 19.6 studs from the aim and 13 studs SHORT of it -- the flight, not the
-- roll, and the traced arc is what answers that.) Re-run `grip` if the throw or the kit models change.
DefensePreview.LandingSpread = 5
-- A structure lands exactly where the arc does: its ring is a marker, not a spread.
DefensePreview.StructureMark = 1
-- The site is worked out again when the landing moves this far, the facing turns, or this long passes
-- (the world changes under a ghost that is held still: someone walks into it).
DefensePreview.ReplanMove = 0.1
DefensePreview.ReplanAge = 0.25

DefensePreview.ValidColor = Color3.fromRGB(94, 214, 122)
DefensePreview.InvalidColor = Color3.fromRGB(232, 92, 92)

-- Workspace folders only a client has (effects drawn locally): never ground, never in the way. The
-- server has none of them, so leaving them out keeps the client's checks the same as the server's.
DefensePreview.ClientOnlyFolders = { "CompanionFx", "GlassFx", "LootFx", "StormWall", "BRR_GunFx", "BRR_Throwables", "BRR_DefensePreview",
	"BRR_DefenseKits" }

local REFRESH = 1 / 20
local ARC_DOTS = 36
local UP = Vector3.new(0, 1, 0)

--------------------------------------------------------------------------------
-- Prediction
--------------------------------------------------------------------------------

-- The point under the crosshair, the one a throw is sent with. CombatClient's own raycast when it's
-- running (AimState); the same raycast done here otherwise, so a gallery or a probe still works.
function DefensePreview.Aim(character)
	local okState, AimState = pcall(function()
		local module = script.Parent:FindFirstChild("AimState")
		return module and require(module)
	end)
	if okState and AimState and AimState.Get then
		local point = AimState.Get()
		if point then
			return point
		end
	end
	local camera = workspace.CurrentCamera
	if not camera or not character then
		return nil
	end
	local viewport = camera.ViewportSize
	local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
	local filter = { character }
	for _, name in ipairs({ "Effects", "Loot" }) do
		local instance = workspace:FindFirstChild(name)
		if instance then
			table.insert(filter, instance)
		end
	end
	local companions = workspace:FindFirstChild("Companions")
	local player = Players.LocalPlayer
	if companions and player then
		for _, model in ipairs(companions:GetChildren()) do
			if model:GetAttribute("OwnerUserId") == player.UserId then
				table.insert(filter, model)
			end
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = filter
	local result = workspace:Raycast(ray.Origin, ray.Direction * 1500, params)
	return result and result.Position or ray.Origin + ray.Direction * 1500
end

local function clientOnly()
	local list = {}
	if workspace.CurrentCamera then
		table.insert(list, workspace.CurrentCamera)
	end
	for _, name in ipairs(DefensePreview.ClientOnlyFolders) do
		local instance = workspace:FindFirstChild(name)
		if instance then
			table.insert(list, instance)
		end
	end
	return list
end

-- Where a throw of `itemId` at `aimPoint` goes and whether it builds. Mirrors DefenseService.throwKit and
-- landKit step for step. Returns nil without a body to throw from, otherwise a table:
--   from, target, facing, offset, flightTime, velocity   the lob
--   centre                                            where the site checks start (target + LandLift)
--   size                                              the structure's box, or nil for a mine
--   origin                                            the build frame when the site is good
--   plan                                              and its plan, footings included
--   reason                                            why not, when it isn't
-- `cache` (optional, a table the caller keeps) reuses the last plan while the landing and facing hold
-- still, so a held ghost doesn't re-sample the ground twenty times a second.
function DefensePreview.Site(character, itemId, aimPoint, extraExclude, cache)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local head = character:FindFirstChild("Head") or root
	local look = root.CFrame.LookVector
	local exclude = extraExclude or clientOnly()
	-- The same wall clip the server throws from (DefensePlacement.ThrowOrigin): pressed against a
	-- building, a ghost drawn from an unclipped origin would show the throw starting inside the wall.
	local from = DefensePlacement.ThrowOrigin(character, head.Position, look, exclude)
	local velocity, flightTime, target, facing, offset = DefensePlacement.ThrowArc(from, look, aimPoint)
	-- Where the kit will really arrive, not where it was aimed. The server throws it on this arc and
	-- builds where it stops, and measured on a real map the arc meets the ground a median 10 studs from
	-- the aim point -- it is flat enough to clip a rising hill well short. Walking the same arc here is
	-- the difference between a ghost that lies and one that points at the hillside it will hit.
	-- The same filter the ground check uses, except that standing defenses are NOT left out: a kit
	-- thrown at your own bunker hits the bunker, and the arc should stop there like it will.
	local landing, struck, landTime = DefensePlacement.Landing(from, velocity, flightTime,
		DefensePlacement.GroundParams(character, nil, exclude))

	local result = {
		from = from,
		target = target,
		aimTarget = target,
		facing = facing,
		offset = offset,
		flightTime = flightTime,
		velocity = velocity,
		struck = struck,
		-- When on the arc it arrives, so the dotted lob stops where the kit does.
		landTime = landTime,
		-- How far short of the aim the arc lands, so the label can say so.
		short = (Vector3.new(target.X, 0, target.Z) - Vector3.new(landing.X, 0, landing.Z)).Magnitude,
		size = DefensePlacement.Sizes[itemId],
	}
	result.target = landing
	result.centre = landing + Vector3.new(0, DefensePlacement.LandLift, 0)
	if result.size then
		-- Game time: os.clock is CPU time, not the clock the world changes on.
		local now = time()
		if cache and cache.itemId == itemId and cache.centre and (cache.centre - result.centre).Magnitude &lt; DefensePreview.ReplanMove
			and cache.facing:Dot(facing) &gt; 0.9999 and now - cache.at &lt; DefensePreview.ReplanAge then
			result.origin, result.reason, result.plan = cache.origin, cache.reason, cache.plan
		else
			result.origin, result.reason, result.plan = DefensePlacement.FindSite(character, result.size, result.centre, facing,
				workspace:FindFirstChild("Defenses"), exclude)
			if cache then
				cache.itemId, cache.centre, cache.facing, cache.at = itemId, result.centre, facing, now
				cache.origin, cache.reason, cache.plan = result.origin, result.reason, result.plan
			end
		end
	end
	return result
end

--------------------------------------------------------------------------------
-- Drawing
--------------------------------------------------------------------------------

local function folder()
	local existing = workspace.CurrentCamera and workspace.CurrentCamera:FindFirstChild("BRR_DefensePreview")
	if existing then
		return existing
	end
	local created = Instance.new("Folder")
	created.Name = "BRR_DefensePreview"
	created.Parent = workspace.CurrentCamera
	return created
end

local function inert(part)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	return part
end

function DefensePreview.new()
	local self = setmetatable({}, DefensePreview)
	self.itemId = nil
	self.ghost = nil
	self.ghostParts = {}
	self.lastRefresh = 0
	self.shown = false
	self.siteCache = {}
	-- The footings' ghosts: one pooled part per footing, remade when the footing's shape changes.
	self.footParts = {}

	local root = folder()
	self.root = root

	-- The lob, as dots.
	self.dots = {}
	for index = 1, ARC_DOTS do
		local dot = inert(Instance.new("Part"))
		dot.Name = "ArcDot"
		dot.Shape = Enum.PartType.Ball
		dot.Size = Vector3.new(0.26, 0.26, 0.26)
		dot.Material = Enum.Material.Neon
		dot.Transparency = 1
		dot.Parent = root
		self.dots[index] = dot
	end

	-- The landing ring, and the footprint the site is checked over, both on the ground.
	self.ring = Instance.new("CylinderHandleAdornment")
	self.ring.Name = "LandingRing"
	self.ring.Adornee = workspace.Terrain
	self.ring.Height = 0.2
	self.ring.Transparency = 0.35
	self.ring.Visible = false
	self.ring.Parent = root

	self.footprint = inert(Instance.new("Part"))
	self.footprint.Name = "Footprint"
	self.footprint.Material = Enum.Material.Neon
	self.footprint.Transparency = 1
	self.footprint.Parent = root
	self.frame = Instance.new("SelectionBox")
	self.frame.LineThickness = 0.08
	self.frame.SurfaceTransparency = 1
	self.frame.Transparency = 0.1
	self.frame.Adornee = self.footprint
	self.frame.Visible = false
	self.frame.Parent = root

	-- The front: a chevron on the ground ahead of the structure.
	self.front = {}
	for index = 1, 2 do
		local bar = inert(Instance.new("Part"))
		bar.Name = "Front"
		bar.Material = Enum.Material.Neon
		bar.Size = Vector3.new(0.35, 0.08, 2.4)
		bar.Transparency = 1
		bar.Parent = root
		self.front[index] = bar
	end

	-- No captions. The owner asked for the ghost and the lob without text over them, so what the words
	-- used to say is said in the world instead:
	--   * valid or refused -&gt; the ghost's green or red tint, which always did that job;
	--   * "replaces your oldest" -&gt; the structure that is about to come down is outlined in red;
	--   * "lands short of your aim" -&gt; a marker sits where you aimed, and the dotted lob and the ghost
	--     stop visibly short of it, which is the same sentence drawn rather than written.
	self.oldestHighlight = Instance.new("Highlight")
	self.oldestHighlight.Name = "ReplacesOldest"
	self.oldestHighlight.FillColor = DefensePreview.InvalidColor
	self.oldestHighlight.FillTransparency = 0.72
	self.oldestHighlight.OutlineColor = DefensePreview.InvalidColor
	self.oldestHighlight.OutlineTransparency = 0
	self.oldestHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	self.oldestHighlight.Enabled = false
	self.oldestHighlight.Parent = root

	-- Where the throw was pointed, when that is not where it arrives.
	self.aimMark = inert(Instance.new("Part"))
	self.aimMark.Name = "AimMark"
	self.aimMark.Size = Vector3.new(0.2, 0.2, 0.2)
	self.aimMark.Transparency = 1
	self.aimMark.Parent = root
	self.aimRing = Instance.new("CylinderHandleAdornment")
	self.aimRing.Name = "AimRing"
	self.aimRing.Adornee = workspace.Terrain
	self.aimRing.Height = 0.2
	self.aimRing.Radius = 1.6
	self.aimRing.InnerRadius = 1.1
	self.aimRing.Transparency = 0.25
	self.aimRing.Visible = false
	self.aimRing.Parent = root
	self.aimCross = {}
	for index = 1, 2 do
		local bar = inert(Instance.new("Part"))
		bar.Name = "AimCross" .. index
		bar.Size = Vector3.new(index == 1 and 4.4 or 0.22, 0.06, index == 1 and 0.22 or 4.4)
		bar.Transparency = 1
		bar.Parent = root
		self.aimCross[index] = bar
	end
	return self
end

-- The ghost for an item: a clone of DefenseService's published template, see-through.
function DefensePreview:_ghostFor(itemId)
	if self.itemId == itemId and self.ghost and self.ghost.Parent then
		return self.ghost
	end
	if self.ghost then
		self.ghost:Destroy()
	end
	self.ghost, self.ghostParts, self.itemId = nil, {}, itemId
	local templates = ReplicatedStorage:FindFirstChild("DefenseTemplates")
	local template = templates and templates:FindFirstChild(itemId)
	if not template then
		return nil
	end
	local ghost = template:Clone()
	ghost.Name = "Ghost"
	for _, part in ipairs(ghost:GetDescendants()) do
		if part:IsA("BasePart") then
			inert(part)
			table.insert(self.ghostParts, { part = part, color = part.Color, offset = part.CFrame, neon = part.Material == Enum.Material.Neon })
			part.Material = Enum.Material.SmoothPlastic
		end
	end
	local highlight = Instance.new("Highlight")
	highlight.Name = "Outline"
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.FillTransparency = 0.8
	highlight.OutlineTransparency = 0.1
	highlight.Parent = ghost
	self.highlight = highlight
	ghost.Parent = self.root
	self.ghost = ghost
	return ghost
end

function DefensePreview:_paintGhost(origin, valid)
	local tint = valid and DefensePreview.ValidColor or DefensePreview.InvalidColor
	for _, entry in ipairs(self.ghostParts) do
		entry.part.CFrame = origin * entry.offset
		entry.part.Color = entry.neon and tint or entry.color:Lerp(tint, 0.5)
		entry.part.Transparency = entry.neon and 0.35 or 0.62
	end
	if self.highlight then
		self.highlight.FillColor = tint
		self.highlight.OutlineColor = tint:Lerp(Color3.new(1, 1, 1), 0.25)
	end
end

-- The plan's footings as ghosts: the same list, sizes and frames DefenseService builds them from.
function DefensePreview:_drawFootings(footings, valid)
	local tint = valid and DefensePreview.ValidColor or DefensePreview.InvalidColor
	for index, footing in ipairs(footings) do
		local part = self.footParts[index]
		local class = footing.class or "Part"
		if part and (part.ClassName ~= class or (footing.shape and part.Shape ~= footing.shape)) then
			part:Destroy()
			part = nil
		end
		if not part then
			part = inert(Instance.new(class))
			part.Name = "GhostFooting"
			if footing.shape then
				part.Shape = footing.shape
			end
			part.Material = Enum.Material.SmoothPlastic
			part.Parent = self.root
			self.footParts[index] = part
		end
		part.Size = footing.size
		part.CFrame = footing.cframe
		part.Color = footing.color:Lerp(tint, 0.5)
		part.Transparency = 0.62
	end
	for index = #self.footParts, #footings + 1, -1 do
		self.footParts[index]:Destroy()
		self.footParts[index] = nil
	end
end

function DefensePreview:_drawArc(site, color)
	local g = workspace.Gravity
	local steps = 24
	local spacing = 1.6
	local used, carried = 0, 0
	local previous = site.from
	for step = 1, steps do
		local t = (site.landTime or site.flightTime) * step / steps
		local point = site.from + site.velocity * t - Vector3.new(0, 0.5 * g * t * t, 0)
		local length = (point - previous).Magnitude
		local at = spacing - carried
		while at &lt;= length and used &lt; ARC_DOTS do
			used += 1
			local dot = self.dots[used]
			dot.Position = previous + (point - previous) * (at / length)
			dot.Color = color
			-- Fade in from the hand so the first dots don't sit in your face.
			dot.Transparency = used &lt;= 2 and 0.7 or 0.2
			at += spacing
		end
		carried = length - (at - spacing)
		previous = point
	end
	for index = used + 1, ARC_DOTS do
		self.dots[index].Transparency = 1
	end
end

-- Straight down from `position` onto whatever's there (for drawing a spot the site checks refused).
local function groundBelow(position, character)
	local params = DefensePlacement.GroundParams(character, workspace:FindFirstChild("Defenses"), clientOnly())
	local hit = workspace:Raycast(position + UP * 20, -UP * 60, params)
	return hit and hit.Position or position
end

function DefensePreview:Update(character, itemId, aimPoint, extraExclude)
	local item = ItemData.Get(itemId)
	if not item or item.kind ~= "defense" then
		self:Hide()
		return
	end
	local now = os.clock()
	if self.site and self.siteItem == itemId and now - self.lastRefresh &lt; REFRESH and aimPoint == nil then
		return
	end
	self.lastRefresh = now
	local site = DefensePreview.Site(character, itemId, aimPoint or DefensePreview.Aim(character), extraExclude, self.siteCache)
	if not site then
		self:Hide()
		return
	end
	self.site, self.siteItem = site, itemId
	self.shown = true

	local valid = site.size == nil or site.origin ~= nil
	local tint = valid and DefensePreview.ValidColor or DefensePreview.InvalidColor
	self:_drawArc(site, site.size and tint or item.color)

	local landing = groundBelow(site.target, character)
	self.ring.CFrame = CFrame.new(landing + UP * 0.1) * CFrame.Angles(math.pi / 2, 0, 0)
	local spread = site.size and DefensePreview.StructureMark or DefensePreview.LandingSpread
	self.ring.Radius = spread
	self.ring.InnerRadius = math.max(0, spread - 0.5)
	self.ring.Color3 = site.size and tint or item.color
	self.ring.Visible = true

	if not site.size then
		-- A mine: where it arms.
		self:_hideStructure()
		self:_showAim(site, groundBelow(site.aimTarget, character), item.color)
		return
	end

	-- Where to draw the structure: its build frame, or for a refused site the spot it was tried at.
	local origin = site.origin or (CFrame.new(Vector3.new(site.centre.X, groundBelow(site.centre, character).Y, site.centre.Z))
		* CFrame.lookAt(Vector3.zero, site.facing))
	local ghost = self:_ghostFor(itemId)
	if ghost then
		self:_paintGhost(origin, valid)
	end
	self:_drawFootings(site.plan and site.plan.footings or {}, valid)

	local size = site.size
	self.footprint.Size = Vector3.new(size.X, 0.05, size.Z)
	self.footprint.CFrame = origin * CFrame.new(0, 0.06, 0)
	self.frame.Color3 = tint
	self.frame.Visible = true
	for index, bar in ipairs(self.front) do
		local side = index == 1 and 1 or -1
		bar.Color = tint
		bar.Transparency = 0.15
		bar.CFrame = origin * CFrame.new(side * 0.8, 0.08, -size.Z / 2 - 1.6) * CFrame.Angles(0, side * math.rad(40), 0)
	end

	self:_showAim(site, groundBelow(site.aimTarget, character), tint)
	-- A fourth standing defense knocks this player's oldest down (DefenseService keeps three). The one
	-- that is about to go is outlined in red while the ghost is up, which says it where it happens
	-- instead of in a caption over the new one.
	local oldest = nil
	if valid then
		local defenses = workspace:FindFirstChild("Defenses")
		local player = Players.LocalPlayer
		local mine = {}
		for _, model in ipairs(defenses and defenses:GetChildren() or {}) do
			if player and model:GetAttribute("OwnerUserId") == player.UserId then
				table.insert(mine, model)
			end
		end
		-- The folder holds them in the order they went up, so the first is the server's `mine[1]`.
		if #mine &gt;= 3 then
			oldest = mine[1]
		end
	end
	self.oldestHighlight.Adornee = oldest
	self.oldestHighlight.Enabled = oldest ~= nil
end

-- The aim marker: a ring and a cross where the throw was pointed, drawn only when the kit is going to
-- arrive somewhere else. With the dotted lob stopping at the ghost, the gap between the two is the whole
-- message -- "you pointed there, it lands here" -- without a word of text. Measured median for that gap
-- is 19.6 studs, so it is not a rare case; under 6 studs it is noise and the marker stays down.
function DefensePreview:_showAim(site, aimGround, color)
	local far = site.short ~= nil and site.short &gt; 6 and site.aimTarget ~= nil
	self.aimRing.Visible = far
	for _, bar in ipairs(self.aimCross) do
		bar.Transparency = far and 0.25 or 1
	end
	if not far then
		return
	end
	local aim = aimGround
	self.aimRing.CFrame = CFrame.new(aim + UP * 0.12) * CFrame.Angles(math.pi / 2, 0, 0)
	self.aimRing.Color3 = color
	for _, bar in ipairs(self.aimCross) do
		bar.Color = color
		bar.CFrame = CFrame.new(aim + UP * 0.1)
	end
end
function DefensePreview:_hideStructure()
	if self.ghost then
		self.ghost.Parent = nil
		self.ghost:Destroy()
		self.ghost, self.ghostParts, self.itemId = nil, {}, nil
	end
	self.frame.Visible = false
	for _, bar in ipairs(self.front) do
		bar.Transparency = 1
	end
	self:_drawFootings({}, false)
end

function DefensePreview:Hide()
	if not self.shown then
		return
	end
	self.shown = false
	self.site = nil
	self:_hideStructure()
	for _, dot in ipairs(self.dots) do
		dot.Transparency = 1
	end
	self.ring.Visible = false
	self.oldestHighlight.Enabled = false
	self.oldestHighlight.Adornee = nil
	self.aimRing.Visible = false
	for _, bar in ipairs(self.aimCross) do
		bar.Transparency = 1
	end
end

--------------------------------------------------------------------------------
-- Thrown kits, flown here
--------------------------------------------------------------------------------

-- The server decides where a structure kit lands and builds there when it arrives
-- (DefenseService.throwStructure); the kit in flight is only a picture, so each client flies its own
-- along the same arc (DefensePlacement.ArcPoint) every frame, instead of watching a server part step at
-- replication rate (critic C10). `info` is { itemId, from, velocity, landTime, spin }. Returns the kit
-- (probes), or nil for anything malformed.
function DefensePreview.FlyKit(info)
	if type(info) ~= "table" or typeof(info.from) ~= "Vector3" or typeof(info.velocity) ~= "Vector3"
		or type(info.landTime) ~= "number" or info.landTime ~= info.landTime or info.landTime &lt; 0 or info.landTime &gt; 10 then
		return nil
	end
	local kit = ItemModels.Build(info.itemId, { anchored = true, scale = 1.5, name = tostring(info.itemId) .. "Kit" })
	if not kit then
		return nil
	end
	for _, part in ipairs(kit:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	local spin = typeof(info.spin) == "CFrame" and info.spin or CFrame.new()
	local holder = workspace:FindFirstChild("BRR_DefenseKits")
	if not holder then
		holder = Instance.new("Folder")
		holder.Name = "BRR_DefenseKits"
		holder.Parent = workspace
	end
	local function place(t)
		kit:PivotTo(CFrame.new(DefensePlacement.ArcPoint(info.from, info.velocity, t)) * spin * CFrame.Angles(t * 5, t * 3, 0))
	end
	place(0)
	kit.Parent = holder
	-- Game time, not os.clock (CPU time), for anything a player sees move.
	local started = time()
	local follow
	follow = RunService.RenderStepped:Connect(function()
		local t = time() - started
		if t &gt;= info.landTime or not kit.Parent then
			follow:Disconnect()
			kit:Destroy()
			return
		end
		place(t)
	end)
	return kit
end

-- On a running client, every structure kit anyone throws is flown here. HudClient requires this module
-- at start, so this listens from the first frame; tools that require it outside a game don't listen.
if RunService:IsClient() and RunService:IsRunning() then
	task.spawn(function()
		local okRemotes, Remotes = pcall(require, Shared:WaitForChild("Remotes"))
		if okRemotes and Remotes then
			Remotes.Event("DefenseKitFlight").OnClientEvent:Connect(function(info)
				pcall(DefensePreview.FlyKit, info)
			end)
		end
	end)
end

function DefensePreview:Destroy()
	self:Hide()
	self.root:Destroy()
end

return DefensePreview
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX151"><Properties><string name="Name">DropPicker</string><ProtectedString name="Source">-- The drop-location picker: a real picture of the terrain you are about to land on.
--
-- A ModuleScript, not a LocalScript, for two reasons: tools/gallery.ps1 can only render UI that a
-- gallery file can require, and HudClient's main chunk is three locals from Luau's 200-local limit,
-- which is a compile failure no check in this project can see.
--
-- WHAT IT DRAWS, and why each piece is there rather than being a flat grey disc with dots on it
-- (which is what this screen was):
--   * the ground, from the server's raster: height-shaded with a hillshade from the north-west, an
--     elevation tint, and a contour every 20 studs, so a ridge reads as a ridge;
--   * water, with a lighter shore line;
--   * the roads, drawn from their REAL footprints as lines at the resolution the map is drawn at —
--     roads are what a player navigates by and a raster cell is wider than a road;
--   * the river, likewise;
--   * town rings sized by the town's own claimed radius, so a hamlet and a downtown look different;
--   * landmark diamonds, all of them named;
--   * a compass, a scale bar, and your pick as a pin with a readout that says where it is in words.
--
-- TWO RENDERERS, both proven in the same gallery run. EditableImage draws one image pixel by pixel
-- and is the good path; where `AssetService:CreateEditableImage` is unavailable or refuses, the
-- same data is drawn as a grid of Frames with runs merged along each row. The fallback is not a
-- placeholder — it is drawn from the same raster, with the same roads, labels and overlays.
--
-- THE CURSOR. Oliver: "my mouse gets locked up on the drop location checker too". The fix, which
-- this module keeps intact from HudClient's version and which must not be lost in any rewrite:
--   * a full-screen VISIBLE GuiButton with `Modal = true` behind the panel. That is the one thing
--     that beats a first-person camera relocking the mouse every frame, and it lives for exactly
--     the window's lifetime, so a window you can see is always a window you can click.
--   * the `MenuOpen` player attribute, set while the picker is up and released on a pick or a
--     close. Different job: CombatClient reads it so a click on the map does not also fire the gun.
-- The owner of the attribute is the caller (VoteDropClient) through `onMenuOpen`, because a module
-- that can be rendered in a gallery has no player to set attributes on. Both halves are checked
-- live, on real instances, by tools/vote_drop_gallery.lua's `cursor` view, with a planted fault.

-- static-check: globals Content, buffer

local TextService = game:GetService("TextService")
local UserInputService = game:GetService("UserInputService")

local UiKit = require(script.Parent:WaitForChild("UiKit"))
local UiParts = require(script.Parent:WaitForChild("UiParts"))

local create = UiKit.create
local Role, Type, Space, Radius, Stroke = UiKit.Role, UiKit.Type, UiKit.Space, UiKit.Radius, UiKit.Stroke

local DropPicker = {}

-- TEST SEAMS. Never set by game code; the gallery sets them to render a path a player's machine
-- would not take (the Frame fallback) and a viewport this screen cannot otherwise be given (a
-- probe frame can choose a width but not a viewport height, and `short` is decided by height).
DropPicker.ForceCells = false
DropPicker.ViewportForTest = nil

--------------------------------------------------------------------------------
-- Palette
--------------------------------------------------------------------------------

local PALETTE = {
	g = { 92, 146, 70 },
	s = { 214, 190, 140 },
	d = { 150, 124, 92 },
	k = { 132, 126, 118 },
	n = { 226, 230, 236 },
	p = { 126, 122, 116 },
	b = { 108, 84, 70 },
	l = { 206, 166, 64 },
	w = { 52, 112, 190 },
}
-- Where water meets anything else.
local SHORE = { 104, 172, 226 }
-- Roads, and the casing drawn under them. The fill is taken from what the roads on the map ACTUALLY
-- look like from above — pale grey concrete, not the near-black a map symbol would use — because the
-- question this screen has to answer is "is that the place I am about to land in". The dark casing
-- is what keeps a 2 px pale line from disappearing into grass.
local ROAD = { 156, 154, 150 }
local ROAD_EDGE = { 52, 50, 54 }
-- High ground dries out towards this; low ground deepens towards the other. The map gains relief
-- without anybody having to invent a second raster for it.
local HIGH_TINT = { 214, 206, 172 }
local LOW_TINT = { 46, 92, 58 }

local NEIGHBOURS = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
local CONTOUR_STUDS = 20

--------------------------------------------------------------------------------
-- Decoding the server's payload
--------------------------------------------------------------------------------

local function parseSegments(text, fields)
	local out = {}
	if type(text) ~= "string" or text == "" then
		return out
	end
	for chunk in string.gmatch(text, "[^;]+") do
		local values = {}
		for value in string.gmatch(chunk, "-?%d+") do
			table.insert(values, tonumber(value))
		end
		if #values &gt;= fields then
			table.insert(out, values)
		end
	end
	return out
end

-- The payload carries the alphabet it was encoded with, so this cannot drift from the server's.
function DropPicker.Decode(payload)
	local n = payload.n
	local alphabet = payload.alphabet or ""
	local index = {}
	for i = 1, #alphabet do
		index[string.sub(alphabet, i, i)] = i - 1
	end
	local span = payload.max - payload.min
	local classes = table.create(n * n, "g")
	local heights = table.create(n * n, 0)
	for i = 1, n * n do
		classes[i] = string.sub(payload.classes, i, i)
		local q = index[string.sub(payload.heights, i, i)] or 0
		heights[i] = payload.min + q / 63 * span
	end

	local river = {}
	for _, point in ipairs(parseSegments(payload.river, 2)) do
		table.insert(river, Vector2.new(point[1], point[2]))
	end

	return {
		n = n,
		radius = payload.radius,
		cell = 2 * payload.radius / n,
		min = payload.min,
		max = payload.max,
		classes = classes,
		heights = heights,
		roads = parseSegments(payload.roads, 5),
		river = river,
		towns = payload.towns or {},
		landmarks = payload.landmarks or {},
		mapName = payload.mapName,
		counts = payload.counts,
	}
end

--------------------------------------------------------------------------------
-- Sampling the raster
--------------------------------------------------------------------------------

local function classAt(data, u, v)
	local n = data.n
	local col = math.clamp(math.floor(u) + 1, 1, n)
	local row = math.clamp(math.floor(v) + 1, 1, n)
	return data.classes[(row - 1) * n + col]
end

-- THE LIGHT IS COMPUTED PER CELL, NOT PER PIXEL, and this is the difference between a map that
-- appears and a map you wait for. A hillshade costs a gradient and a contour test per sample: done
-- per pixel that is 147,456 samples on a 384 px disc, done per cell it is 16,384, and the pixels
-- only interpolate between them. The CLASS stays nearest-cell, so a building's edge is still an
-- edge while the light across it is smooth — interpolating the classes as well would smear a town
-- into the field around it.
local function buildFields(data)
	if data.shade then
		return
	end
	local n, cell = data.n, data.cell
	local h = data.heights
	local shade = table.create(n * n, 1)
	local tint = table.create(n * n, 0)
	local span = math.max(data.max - data.min, 1)
	for row = 1, n do
		local base = (row - 1) * n
		local above = base - (row &gt; 1 and n or 0)
		local below = base + (row &lt; n and n or 0)
		for col = 1, n do
			local i = base + col
			local left = base + math.max(col - 1, 1)
			local right = base + math.min(col + 1, n)
			local gx = (h[right] - h[left]) / (2 * cell)
			local gz = (h[below + col] - h[above + col]) / (2 * cell)
			-- Light from the north-west, which is the convention every paper map uses.
			local value = math.clamp(1 + 1.9 * (-gx - gz), 0.55, 1.35)
			local band = math.floor(h[i] / CONTOUR_STUDS)
			if math.floor(h[left] / CONTOUR_STUDS) ~= band
				or math.floor(h[above + col] / CONTOUR_STUDS) ~= band then
				value *= 0.87
			end
			shade[i] = value
			tint[i] = (h[i] - data.min) / span
		end
	end
	data.shade = shade
	data.tint = tint
end

-- Bilinear over a per-cell field.
local function fieldAt(field, n, u, v)
	local fx = math.clamp(u - 0.5, 0, n - 1)
	local fz = math.clamp(v - 0.5, 0, n - 1)
	local x0, z0 = math.floor(fx), math.floor(fz)
	local tx, tz = fx - x0, fz - z0
	local x1, z1 = math.min(x0 + 1, n - 1), math.min(z0 + 1, n - 1)
	local a = field[z0 * n + x0 + 1] * (1 - tx) + field[z0 * n + x1 + 1] * tx
	local b = field[z1 * n + x0 + 1] * (1 - tx) + field[z1 * n + x1 + 1] * tx
	return a * (1 - tz) + b * tz
end

-- The colour of one point of ground: class, elevation tint, hillshade, contour.
local function groundColour(data, u, v)
	local n = data.n
	local class = classAt(data, u, v)
	if class == "." then
		class = "g"
	end
	local base = PALETTE[class] or PALETTE.g
	if class == "w" then
		for _, off in ipairs(NEIGHBOURS) do
			local near = classAt(data, u + off[1], v + off[2])
			if near ~= "w" and near ~= "." then
				return SHORE[1], SHORE[2], SHORE[3]
			end
		end
		return base[1], base[2], base[3]
	end

	local r, g, b = base[1], base[2], base[3]
	-- Ground that grows takes an elevation tint — high ground dries out, low ground deepens — so a
	-- ridge reads as a ridge even where the hillshade is flat. Built and paved ground is painted,
	-- not grown, and keeps its own colour rather than fading into the hillside it stands on.
	if class == "g" or class == "d" or class == "k" or class == "s" then
		local t = fieldAt(data.tint, n, u, v)
		local up = math.max(t - 0.55, 0) / 0.45 * 0.34
		local down = math.max(0.35 - t, 0) / 0.35 * 0.18
		r = r + (HIGH_TINT[1] - r) * up + (LOW_TINT[1] - r) * down
		g = g + (HIGH_TINT[2] - g) * up + (LOW_TINT[2] - g) * down
		b = b + (HIGH_TINT[3] - b) * up + (LOW_TINT[3] - b) * down
	end
	local shade = fieldAt(data.shade, n, u, v)
	return r * shade, g * shade, b * shade
end

--------------------------------------------------------------------------------
-- The image renderer
--------------------------------------------------------------------------------

local function byteClamp(value)
	return math.clamp(math.floor(value + 0.5), 0, 255)
end

-- Paints a thick line into the pixel buffer, in PIXEL coordinates, with a one-pixel soft edge. This
-- is why the roads are vectors: at 384 px across a 2560-stud map, a road is 2.7 px wide and a
-- raster cell is 3 — drawn from the raster it is a staircase, drawn from its own footprint it is a
-- road. `alphaOf` returns nil for a pixel outside the disc so the rim stays clean.
local function paintLine(buf, W, ax, ay, bx, by, halfWidth, colour, alphaOf)
	local dx, dy = bx - ax, by - ay
	local lengthSq = dx * dx + dy * dy
	local pad = halfWidth + 1.5
	local x0 = math.max(0, math.floor(math.min(ax, bx) - pad))
	local x1 = math.min(W - 1, math.ceil(math.max(ax, bx) + pad))
	local y0 = math.max(0, math.floor(math.min(ay, by) - pad))
	local y1 = math.min(W - 1, math.ceil(math.max(ay, by) + pad))
	local painted = 0
	for py = y0, y1 do
		for px = x0, x1 do
			local cx, cy = px + 0.5, py + 0.5
			local t = 0
			if lengthSq &gt; 0 then
				t = math.clamp(((cx - ax) * dx + (cy - ay) * dy) / lengthSq, 0, 1)
			end
			local qx, qy = ax + dx * t, ay + dy * t
			local distance = math.sqrt((cx - qx) ^ 2 + (cy - qy) ^ 2)
			local cover = math.clamp(halfWidth + 0.5 - distance, 0, 1)
			if cover &gt; 0 then
				local disc = alphaOf(cx, cy)
				if disc &gt; 0 then
					local o = (py * W + px) * 4
					local mix = cover * disc
					buffer.writeu8(buf, o, byteClamp(buffer.readu8(buf, o) * (1 - mix) + colour[1] * mix))
					buffer.writeu8(buf, o + 1, byteClamp(buffer.readu8(buf, o + 1) * (1 - mix) + colour[2] * mix))
					buffer.writeu8(buf, o + 2, byteClamp(buffer.readu8(buf, o + 2) * (1 - mix) + colour[3] * mix))
					painted += 1
				end
			end
		end
	end
	return painted
end

-- Draws the ground, then the river, then the roads, into one ImageLabel. Returns the label and the
-- pixel size, or nil and the reason it could not.
function DropPicker.DrawImage(parent, data, px)
	-- Up to 640 px (was 384) so a large drop screen draws the map at its own size instead of stretching
	-- a 384 px picture (Oliver 09-22 15:34).
	local W = math.clamp(math.floor(px), 192, 640)
	local ok, result = pcall(function()
		local AssetService = game:GetService("AssetService")
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(W, W) })
		local buf = buffer.create(W * W * 4)
		local cellsPerPixel = data.n / W
		local centre = W / 2
		buildFields(data)

		local function alphaOf(cx, cy)
			local dx, dy = cx - centre, cy - centre
			return math.clamp(centre - math.sqrt(dx * dx + dy * dy) + 0.5, 0, 1)
		end

		for py = 0, W - 1 do
			local v = (py + 0.5) * cellsPerPixel
			for pxl = 0, W - 1 do
				local alpha = alphaOf(pxl + 0.5, py + 0.5)
				local r, g, b = 0, 0, 0
				if alpha &gt; 0 then
					r, g, b = groundColour(data, (pxl + 0.5) * cellsPerPixel, v)
				end
				local o = (py * W + pxl) * 4
				buffer.writeu8(buf, o, byteClamp(r))
				buffer.writeu8(buf, o + 1, byteClamp(g))
				buffer.writeu8(buf, o + 2, byteClamp(b))
				buffer.writeu8(buf, o + 3, byteClamp(alpha * 255))
			end
			if py % 48 == 47 then
				task.wait()
			end
		end

		-- World studs to pixels.
		local k = (W / 2) / data.radius
		local function toPx(x, z)
			return x * k + centre, z * k + centre
		end

		for index = 2, #data.river do
			local a, b = data.river[index - 1], data.river[index]
			local ax, ay = toPx(a.X, a.Y)
			local bx, by = toPx(b.X, b.Y)
			-- MapTerrain cuts the river 34 studs wide (MapTerrain.lua:33). The raster already paints
			-- the wide stretches as water; this line is what keeps the narrow ones continuous.
			paintLine(buf, W, ax, ay, bx, by, math.max(1.2, 17 * k), SHORE, alphaOf)
		end

		local drawn = 0
		for index, seg in ipairs(data.roads) do
			local ax, ay = toPx(seg[1], seg[2])
			local bx, by = toPx(seg[3], seg[4])
			local half = math.max(1.1, seg[5] * k / 2)
			-- Casing first, then the road on top: a 2 px line with no edge disappears into grass.
			paintLine(buf, W, ax, ay, bx, by, half + 0.8, ROAD_EDGE, alphaOf)
			paintLine(buf, W, ax, ay, bx, by, half, ROAD, alphaOf)
			drawn += 1
			if index % 40 == 0 then
				task.wait()
			end
		end

		image:WritePixelsBuffer(Vector2.zero, Vector2.new(W, W), buf)
		local label = create("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScaleType = Enum.ScaleType.Stretch,
			ZIndex = 1,
			Parent = parent,
		})
		label.ImageContent = Content.fromObject(image)
		return { label = label, pixels = W, roads = drawn }
	end)
	if ok then
		return result
	end
	return nil, tostring(result)
end

--------------------------------------------------------------------------------
-- The Frame fallback
--------------------------------------------------------------------------------

-- The same data as Frames: 56 rows of merged runs for the ground, then the roads and the river as
-- thin rotated Frames so they stay lines rather than becoming a staircase.
function DropPicker.DrawCells(parent, data, px)
	local m = 56
	local ratio = data.n / m
	local cellPx = px / m
	local frames = 0
	buildFields(data)
	for row = 1, m do
		local v = (row - 0.5) * ratio
		local runStart, runColour = nil, nil
		local function flush(endCol)
			if runStart then
				create("Frame", {
					Position = UDim2.fromOffset(math.floor((runStart - 1) * cellPx), math.floor((row - 1) * cellPx)),
					Size = UDim2.fromOffset(math.ceil((endCol - runStart + 1) * cellPx) + 1, math.ceil(cellPx) + 1),
					BackgroundColor3 = runColour,
					BorderSizePixel = 0,
					ZIndex = 1,
					Parent = parent,
				})
				frames += 1
			end
			runStart, runColour = nil, nil
		end
		for col = 1, m do
			local u = (col - 0.5) * ratio
			if classAt(data, u, v) == "." then
				flush(col - 1)
			else
				local r, g, b = groundColour(data, u, v)
				-- Quantised to 12 steps a channel: without it every cell differs by a digit and no
				-- two neighbours ever merge, which is 3,136 Frames instead of a few hundred.
				local colour = Color3.fromRGB(
					math.floor(byteClamp(r) / 12) * 12,
					math.floor(byteClamp(g) / 12) * 12,
					math.floor(byteClamp(b) / 12) * 12)
				if not runColour or colour ~= runColour then
					flush(col - 1)
					runStart, runColour = col, colour
				end
			end
		end
		flush(m)
	end

	local k = (px / 2) / data.radius
	-- A road or river drawn as a rotated Frame is clipped by the disc's SQUARE bounds, not by the
	-- circle — so a river leaving the map ran out to the corner and squared off the disc's edge in
	-- the first render. The image renderer never had this because it tests the circle per pixel.
	-- Each segment is therefore clipped against the circle before it is drawn.
	local limit = data.radius * 0.995
	local function clipToDisc(a, b)
		local d = b - a
		local length = d.Magnitude
		if length &lt; 0.001 then
			return (a.Magnitude &lt;= limit) and a or nil, b
		end
		local dir = d / length
		-- Distance along the ray to the two circle crossings, if there are any.
		local t = -a:Dot(dir)
		local closest = a + dir * t
		local gap = limit * limit - closest:Dot(closest)
		if gap &lt;= 0 then
			return nil
		end
		local half = math.sqrt(gap)
		local t0 = math.max(t - half, 0)
		local t1 = math.min(t + half, length)
		if t1 &lt;= t0 then
			return nil
		end
		return a + dir * t0, a + dir * t1
	end
	local function line(rawA, rawB, width, colour, zIndex)
		local a, b = clipToDisc(rawA, rawB)
		if not a or not b then
			return
		end
		local mid = (a + b) / 2
		local length = (b - a).Magnitude * k
		if length &lt; 0.5 then
			return
		end
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, mid.X * k, 0.5, mid.Y * k),
			Size = UDim2.fromOffset(length + width, width),
			BackgroundColor3 = Color3.fromRGB(colour[1], colour[2], colour[3]),
			BorderSizePixel = 0,
			Rotation = math.deg(math.atan2(b.Y - a.Y, b.X - a.X)),
			ZIndex = zIndex,
			Parent = parent,
		})
		frames += 1
	end
	for index = 2, #data.river do
		line(data.river[index - 1], data.river[index], math.max(2, 34 * k), SHORE, 2)
	end
	local roads = 0
	for _, seg in ipairs(data.roads) do
		line(Vector2.new(seg[1], seg[2]), Vector2.new(seg[3], seg[4]), math.max(2, seg[5] * k), ROAD, 2)
		roads += 1
	end
	return { frames = frames, roads = roads }
end

--------------------------------------------------------------------------------
-- Overlays: compass, rings, labels, scale, pin
--------------------------------------------------------------------------------

local function textWidth(text, size, font)
	local ok, measured = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(4000, 200)).X
	end)
	return ok and measured or #text * size * 0.58
end

local function bearingName(dx, dz)
	local degrees = (math.deg(math.atan2(dx, -dz)) + 360) % 360
	local names = { "N", "NE", "E", "SE", "S", "SW", "W", "NW" }
	return names[math.floor((degrees + 22.5) / 45) % 8 + 1]
end

local function overlaps(a, b)
	return a.x &lt; b.x + b.w and b.x &lt; a.x + a.w and a.y &lt; b.y + b.h and b.y &lt; a.y + a.h
end

-- A label in a dark pill, so a name is legible over grass, water or a roof alike.
local function makePill(parent, text, size, font, colour, zIndex)
	local width = textWidth(text, size, font) + 12
	local height = size + 6
	local frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = Role.Scrim,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		ZIndex = zIndex,
		Parent = parent,
	}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	local label = create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = font,
		Text = text,
		TextColor3 = colour,
		TextSize = size,
		ZIndex = zIndex + 1,
		Parent = frame,
	})
	return frame, label, width, height
end

-- Everything over the ground. Returns a view the panel drives: `setPick` moves the pin and answers
-- the readout, `labels` reports how the de-collision pass went.
function DropPicker.DrawOverlays(disc, px, data, options)
	options = options or {}
	local labelSize = options.labelSize or 12
	local k = (px / 2) / data.radius
	local half = px / 2
	local function at(x, z)
		return UDim2.new(0.5, x * k, 0.5, z * k)
	end

	-- The rim: a dark band that hides the raster's own edge, and a thin accent ring outside it.
	create("UIStroke", { Color = Role.Base, Thickness = 4, Parent = disc })
	create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 10, 1, 10),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = disc,
	}, {
		create("UICorner", { CornerRadius = UDim.new(1, 0) }),
		create("UIStroke", { Color = Role.Accent, Thickness = 1, Transparency = 0.4 }),
	})

	-- Compass INSIDE the rim. Outside it, on a 296 px phone panel, the letters land outside the
	-- panel — which is exactly what the first draft did.
	local inset = half - labelSize
	for _, point in ipairs({ { "N", 0, -1 }, { "E", 1, 0 }, { "S", 0, 1 }, { "W", -1, 0 } }) do
		create("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, point[2] * inset, 0.5, point[3] * inset),
			Size = UDim2.fromOffset(18, 18),
			BackgroundTransparency = 1,
			Font = Type.Label.Font,
			Text = point[1],
			TextColor3 = point[1] == "N" and Role.Accent or Role.Text,
			TextStrokeColor3 = Role.Scrim,
			TextStrokeTransparency = 0.2,
			TextSize = labelSize + 1,
			ZIndex = 9,
			Parent = disc,
		})
	end

	-- Town rings removed (Oliver 16:05: "get rid of the town bubbles"); the town name labels stay.
	for _, town in ipairs({}) do
		local ring = math.max(town.r * k, 8)
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = at(town.x, town.z),
			Size = UDim2.fromOffset(ring * 2, ring * 2),
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = disc,
		}, {
			create("UICorner", { CornerRadius = UDim.new(1, 0) }),
			create("UIStroke", { Color = Role.Text, Thickness = 1, Transparency = 0.5 }),
		})
	end

	-- Landmark diamonds.
	for _, landmark in ipairs(data.landmarks) do
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = at(landmark.x, landmark.z),
			Size = UDim2.fromOffset(10, 10),
			BackgroundColor3 = Role.Accent,
			BorderSizePixel = 0,
			Rotation = 45,
			ZIndex = 5,
			Parent = disc,
		}, { create("UIStroke", { Color = Role.Base, Thickness = 2 }) })
	end

	--------------------------------------------------------------------------------
	-- Labels, placed so they do not sit on each other
	--
	-- The first draft put every name at a fixed offset under its marker. On a real map that reads
	-- as "SIX SEVEN SQUARE" clipped to "EN SQUARE" by a landmark 40 studs away. So: towns first
	-- (they are the bigger thing), then landmarks, each trying four anchors in turn, and a name
	-- that fits nowhere gives up its text and keeps a marker that says something is there.
	--------------------------------------------------------------------------------

	-- The compass and the scale bar are placed before any name is, so they are in the list the
	-- de-collision pass avoids. Leaving them out is the same bug one level down: a town name would
	-- clear every other name and still land on top of the "W".
	local barStuds = data.radius &gt;= 1100 and 400 or 200
	local barPx = barStuds * k
	local placed = {
		{ x = half - (barPx + 88) / 2, y = half + px * 0.355 - 9, w = barPx + 88, h = 18 },
	}
	for _, point in ipairs({ { 0, -1 }, { 1, 0 }, { 0, 1 }, { -1, 0 } }) do
		table.insert(placed, { x = half + point[1] * inset - 11, y = half + point[2] * inset - 11, w = 22, h = 22 })
	end
	local reserved = #placed
	-- `rects` is the evidence: the gallery asserts no two of them overlap, which is the whole point
	-- of the pass below and cannot be judged from a screenshot at 375 px wide.
	local labels = { placed = 0, moved = 0, dropped = 0, rects = placed, reserved = reserved }
	local requests = {}
	for _, town in ipairs(data.towns) do
		table.insert(requests, {
			text = string.upper(town.name), x = town.x, z = town.z, colour = Role.Text,
			font = Type.Label.Font, size = labelSize, gap = math.max(town.r * k, 8) + 4, zIndex = 6,
		})
	end
	for _, landmark in ipairs(data.landmarks) do
		table.insert(requests, {
			text = landmark.name, x = landmark.x, z = landmark.z, colour = Role.Accent,
			font = Type.Caption.Font, size = labelSize - 1, gap = 9, zIndex = 6,
		})
	end

	local pills = {}
	for _, request in ipairs(requests) do
		local frame, label, w, h = makePill(disc, request.text, request.size, request.font, request.colour, request.zIndex)
		local cx, cz = request.x * k + half, request.z * k + half
		local candidates = {
			{ cx, cz + request.gap + h / 2 },
			{ cx, cz - request.gap - h / 2 },
			{ cx + request.gap + w / 2 + 2, cz },
			{ cx - request.gap - w / 2 - 2, cz },
		}
		local chosen, index = nil, 0
		for try, candidate in ipairs(candidates) do
			local rect = { x = candidate[1] - w / 2, y = candidate[2] - h / 2, w = w, h = h }
			-- Inside the disc's box, and clear of everything already placed.
			if rect.x &gt;= 0 and rect.y &gt;= 0 and rect.x + w &lt;= px and rect.y + h &lt;= px then
				local clear = true
				for _, other in ipairs(placed) do
					if overlaps(rect, other) then
						clear = false
						break
					end
				end
				if clear then
					chosen, index = rect, try
					break
				end
			end
		end
		if chosen then
			frame.Position = UDim2.fromOffset(chosen.x + w / 2, chosen.y + h / 2)
			table.insert(placed, chosen)
			table.insert(pills, { frame = frame, label = label, rect = chosen })
			labels.placed += 1
			if index &gt; 1 then
				labels.moved += 1
			end
		else
			-- No room anywhere: the name goes, the place does not. A hollow ring marks it, so this
			-- reads as "somewhere with no room for its name" rather than as nothing at all.
			frame:Destroy()
			create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = at(request.x, request.z),
				Size = UDim2.fromOffset(14, 14),
				BackgroundTransparency = 1,
				ZIndex = 6,
				Parent = disc,
			}, {
				create("UICorner", { CornerRadius = UDim.new(1, 0) }),
				create("UIStroke", { Color = request.colour, Thickness = 1.5, Transparency = 0.2 }),
			})
			labels.dropped += 1
		end
	end

	-- Scale bar, inside the disc at the bottom so it can never collide with the words underneath
	-- the map — which is where the first draft put it, on top of the LANDING readout. Its space was
	-- reserved above, before any name was placed.
	local scale = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, px * 0.355),
		Size = UDim2.fromOffset(barPx + 88, 18),
		BackgroundColor3 = Role.Scrim,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		ZIndex = 8,
		Parent = disc,
	}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	local bar = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(barPx, 2),
		BackgroundColor3 = Role.Text,
		BorderSizePixel = 0,
		ZIndex = 9,
		Parent = scale,
	})
	for _, side in ipairs({ 0, 1 }) do
		create("Frame", {
			AnchorPoint = Vector2.new(side, 0.5),
			Position = UDim2.new(side, 0, 0.5, 0),
			Size = UDim2.fromOffset(2, 8),
			BackgroundColor3 = Role.Text,
			BorderSizePixel = 0,
			ZIndex = 9,
			Parent = bar,
		})
	end
	create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		-- 64 px, not 50: "400 studs" at 11 px measures 55 and a right-aligned label in a 50 px box
		-- does not shrink, it loses its first characters — the render read "00 studs".
		Size = UDim2.fromOffset(64, 14),
		BackgroundTransparency = 1,
		Font = Type.Caption.Font,
		Text = string.format("%d studs", barStuds),
		TextColor3 = Role.Text,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 9,
		Parent = scale,
	})

	-- The pick: a ring, a pin and a stalk, drawn over everything.
	local pinRing = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(34, 34),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 10,
		Parent = disc,
	}, {
		create("UICorner", { CornerRadius = UDim.new(1, 0) }),
		create("UIStroke", { Color = Role.Accent, Thickness = 2, Transparency = 0.3 }),
	})
	local pin = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Role.Accent,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 11,
		Parent = disc,
	}, {
		create("UICorner", { CornerRadius = UDim.new(1, 0) }),
		create("UIStroke", { Color = Role.Scrim, Thickness = 3 }),
	})

	local places = {}
	for _, town in ipairs(data.towns) do
		table.insert(places, town)
	end
	for _, landmark in ipairs(data.landmarks) do
		table.insert(places, landmark)
	end

	local view = { labels = labels }

	-- Moves the pin and answers what to say about it. A label the pin covers fades rather than
	-- being hidden by it: the player put the pin there, and a name under it is still information.
	function view.setPick(x, z)
		if not x then
			pin.Visible = false
			pinRing.Visible = false
			for _, entry in ipairs(pills) do
				entry.label.TextTransparency = 0
				entry.frame.BackgroundTransparency = 0.25
			end
			return nil
		end
		pin.Position = at(x, z)
		pinRing.Position = pin.Position
		pin.Visible = true
		pinRing.Visible = true

		-- A name the pin sits on FADES rather than being covered: the player put the pin there, and
		-- the name underneath is still the thing that tells them where "there" is. The first render
		-- faded it to 0.55 over a 0.7 pill, which made "Sahur Hot Springs" unreadable — the point is
		-- to let the pin read as the top layer, not to delete the label.
		local pinRect = { x = x * k + half - 15, y = z * k + half - 15, w = 30, h = 30 }
		for _, entry in ipairs(pills) do
			local under = overlaps(pinRect, entry.rect)
			entry.label.TextTransparency = under and 0.3 or 0
			entry.frame.BackgroundTransparency = under and 0.45 or 0.25
		end

		local nearest, best = nil, math.huge
		for _, place in ipairs(places) do
			local distance = math.sqrt((place.x - x) ^ 2 + (place.z - z) ^ 2)
			if distance &lt; best then
				nearest, best = place, distance
			end
		end
		if not nearest then
			return "Landing spot set"
		end
		if best &lt; 70 then
			return string.format("Landing at %s", nearest.name)
		end
		return string.format("%d studs %s of %s", math.floor(best / 10 + 0.5) * 10,
			bearingName(x - nearest.x, z - nearest.z), nearest.name)
	end

	return view
end

-- The whole map at a given pixel size: ground, roads, overlays. `options.cells` forces the fallback.
function DropPicker.DrawMap(parent, data, px, options)
	options = options or {}
	local disc = create("Frame", {
		AnchorPoint = options.anchor or Vector2.zero,
		Position = options.position or UDim2.fromOffset(0, 0),
		Size = UDim2.fromOffset(px, px),
		BackgroundColor3 = Role.Surface,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = options.zIndex or 1,
		Parent = parent,
	}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

	local renderer, detail = "image", nil
	if not (options.cells or DropPicker.ForceCells) then
		local image, reason = DropPicker.DrawImage(disc, data, px)
		if image then
			detail = string.format("%dx%d pixels, %d road segments", image.pixels, image.pixels, image.roads)
		else
			renderer = "cells-after-image-failed"
			warn("[DropPicker] EditableImage unavailable, drawing cells instead: " .. tostring(reason))
		end
	else
		renderer = "cells"
	end
	if renderer ~= "image" then
		local cells = DropPicker.DrawCells(disc, data, px)
		detail = string.format("%d Frames, %d road segments", cells.frames, cells.roads)
	end

	local view = DropPicker.DrawOverlays(disc, px, data, options)
	view.frame = disc
	view.renderer = renderer
	view.detail = detail
	return view
end

--------------------------------------------------------------------------------
-- The screen
--------------------------------------------------------------------------------

local function viewportOf()
	if DropPicker.ViewportForTest then
		return DropPicker.ViewportForTest
	end
	local camera = workspace.CurrentCamera
	return camera and camera.ViewportSize or Vector2.new(1280, 720)
end

local Picker = {}
Picker.__index = Picker

-- `parent` is a ScreenGui. `onPick(x, z)` is called with studs; `onMenuOpen(open)` with the window's
-- state, and it is the caller's job to write the player attribute — see the note at the top.
function DropPicker.new(options)
	local self = setmetatable({}, Picker)
	self.parent = options.parent
	self.onPick = options.onPick
	self.onMenuOpen = options.onMenuOpen
	self.zIndex = options.zIndex or 40
	self.touch = options.touch
	self.seconds = options.seconds or 0
	self.totalSeconds = options.totalSeconds or 15
	self.visible = false
	self.menuOpenHeld = false
	self.data = nil
	self.pick = nil

	-- THE CURSOR FIX, half one. A VISIBLE GuiButton with Modal = true frees the mouse for as long
	-- as it is up, which is the one thing that beats a first-person camera relocking it every
	-- frame. It is created with the picker and lives exactly as long as the window, so a window you
	-- can see is always a window you can click. `options.noModal` exists for one reason: the
	-- gallery builds a deliberately broken picker with it, to prove the check that reads these
	-- properties can actually fail.
	if not options.noModal then
		self.modal = create("TextButton", {
			Name = "DropSelectOverlay",
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromScale(0, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.45,
			AutoButtonColor = false,
			Modal = true,
			Selectable = false,
			Text = "",
			Visible = false,
			ZIndex = self.zIndex - 1,
			Parent = self.parent,
		})
	end

	self.root = create("Frame", {
		Name = "DropPicker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = self.zIndex,
		Parent = self.parent,
	})
	return self
end

function Picker:isTouch()
	if self.touch ~= nil then
		return self.touch
	end
	local ok, touch = pcall(function()
		return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	end)
	return ok and touch or false
end

-- Studs from a click inside the disc, held to the playable limit so the pin shows where you will
-- actually land rather than where you clicked.
function Picker:worldFromInput(position)
	local disc = self.discFrame
	if not disc or not self.data then
		return nil
	end
	local size, origin = disc.AbsoluteSize, disc.AbsolutePosition
	local px = position.X - origin.X - size.X / 2
	local py = position.Y - origin.Y - size.Y / 2
	local scale = self.data.radius / math.max(size.X / 2, 1)
	local x, z = px * scale, py * scale
	local limit = self.data.radius * 0.96
	local distance = math.sqrt(x * x + z * z)
	if distance &gt; limit then
		local pull = limit / math.max(distance, 1)
		x, z = x * pull, z * pull
	end
	return x, z
end

function Picker:SetPayload(payload)
	if payload then
		self.data = DropPicker.Decode(payload)
	else
		self.data = nil
	end
	self.pick = nil
	self.built = nil
	if self.visible then
		self:Layout()
	end
end

function Picker:SetSeconds(seconds)
	self.seconds = seconds or 0
	if self.clock then
		self.clock.Text = tostring(math.max(0, math.floor(self.seconds)))
	end
	if self.timeFill then
		self.timeFill.Size = UDim2.fromScale(math.clamp(self.seconds / math.max(self.totalSeconds, 1), 0, 1), 1)
	end
end

function Picker:SetPick(x, z, fromServer)
	self.pick = x and { x = x, z = z } or nil
	if self.mapView then
		local readout = self.mapView.setPick(x, z)
		if self.readout then
			self.readout.Text = readout or self.emptyReadout
			self.readout.TextColor3 = readout and Role.Positive or Role.Text
		end
		if self.readoutCard then
			local stroke = self.readoutCard:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = readout and Role.Positive or Role.Line
			end
		end
	end
	if x and not fromServer and self.onPick then
		self.onPick(x, z)
	end
end

function Picker:SetVisible(visible)
	visible = visible == true
	if visible and not self.built then
		self:Layout()
	end
	self.visible = visible
	self.root.Visible = visible
	if self.modal then
		-- Half one, the other end of it: the overlay follows the window exactly, so the cursor is
		-- freed while it is up and handed straight back when the phase ends.
		self.modal.Visible = visible
	end
	-- THE CURSOR FIX, half two: MenuOpen, so a click on the map does not also fire the gun. Held
	-- while the window is up and released once, never left set.
	if visible and not self.menuOpenHeld then
		self.menuOpenHeld = true
		if self.onMenuOpen then
			self.onMenuOpen(true)
		end
	elseif not visible and self.menuOpenHeld then
		self.menuOpenHeld = false
		if self.onMenuOpen then
			self.onMenuOpen(false)
		end
	end
end

function Picker:Destroy()
	self:SetVisible(false)
	if self.modal then
		self.modal:Destroy()
	end
	self.root:Destroy()
end

-- Rebuilds the panel for the viewport it is on now. Called on open, on a new map, and whenever the
-- viewport changes — a screen that only ever lays out once is how the short and tall forms end up
-- shipped untested.
function Picker:Layout()
	for _, child in ipairs(self.root:GetChildren()) do
		child:Destroy()
	end
	self.clock, self.timeFill, self.readout, self.readoutCard, self.mapView, self.discFrame = nil, nil, nil, nil, nil, nil
	self.built = true

	local viewport = viewportOf()
	local form = UiKit.form(viewport)
	local touch = self:isTouch()
	local safe = UiKit.safeArea(viewport, touch)
	-- The safe area's 96 px of thumb room at the bottom exists so the HUD does not put controls
	-- under a thumb. This screen IS the control, it is modal, and there is no HUD under it — so
	-- spending 96 px of a 390 px landscape phone on clearance would shrink the map for nothing.
	-- The top inset stays: Roblox's own bar really is there.
	local bottomInset = touch and Space.LG or safe.Bottom
	local hint = touch and "Tap anywhere on the map. Tap again to move it."
		or "Click anywhere on the map. Click again to move it."
	self.emptyReadout = touch and "Tap the map to choose where you land"
		or "Click the map to choose where you land"
	local fallbackNote = "Pick nothing and you land on a random spot, spread out from everyone else."

	local panel = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		BackgroundColor3 = Role.Base,
		BorderSizePixel = 0,
		ZIndex = self.zIndex,
		Parent = self.root,
	}, {
		create("UICorner", { CornerRadius = UDim.new(0, Radius.Panel) }),
		create("UIStroke", { Color = Role.Line, Thickness = Stroke.Hairline }),
	})
	self.panel = panel

	local function header(x, y, width, titleStyle, clockStyle)
		UiParts.text(panel, titleStyle, "CHOOSE YOUR DROP", Role.Accent, {
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(width - 76, titleStyle.Size + 8),
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = self.zIndex + 1,
		})
		self.clock = UiParts.text(panel, clockStyle, tostring(math.floor(self.seconds)), Role.Text, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromOffset(x + width, y - 4),
			Size = UDim2.fromOffset(72, clockStyle.Size + 10),
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = self.zIndex + 1,
		})
		local track = create("Frame", {
			Position = UDim2.fromOffset(x, y + titleStyle.Size + 12),
			Size = UDim2.fromOffset(width, 4),
			BackgroundColor3 = Role.SurfaceAlt,
			BorderSizePixel = 0,
			ZIndex = self.zIndex + 1,
			Parent = panel,
		}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		self.timeFill = create("Frame", {
			Size = UDim2.fromScale(math.clamp(self.seconds / math.max(self.totalSeconds, 1), 0, 1), 1),
			BackgroundColor3 = Role.Accent,
			BorderSizePixel = 0,
			ZIndex = self.zIndex + 2,
			Parent = track,
		}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		return y + titleStyle.Size + 16
	end

	local function readoutCard(x, y, width, height)
		local card = create("Frame", {
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(width, height),
			BackgroundColor3 = Role.Surface,
			BorderSizePixel = 0,
			ZIndex = self.zIndex + 1,
			Parent = panel,
		}, {
			create("UICorner", { CornerRadius = UDim.new(0, Radius.Card) }),
			create("UIStroke", { Color = Role.Line, Thickness = Stroke.Hairline }),
		})
		UiParts.text(card, Type.Label, "LANDING", Role.TextMuted, {
			Position = UDim2.fromOffset(Space.MD, 6),
			Size = UDim2.new(1, -Space.MD * 2, 0, 16),
			ZIndex = self.zIndex + 2,
		})
		self.readout = UiParts.text(card, Type.Body, self.emptyReadout, Role.Text, {
			Position = UDim2.fromOffset(Space.MD, 24),
			Size = UDim2.new(1, -Space.MD * 2, 0, 22),
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = self.zIndex + 2,
		})
		self.readoutCard = card
		return card
	end

	-- The map is a button: the whole disc takes the click, and the panel around it does not.
	local function drawMap(x, y, size, labelSize)
		local holder = create("TextButton", {
			Position = UDim2.fromOffset(x, y),
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = self.zIndex + 1,
			Parent = panel,
		})
		if self.data then
			self.mapView = DropPicker.DrawMap(holder, self.data, size, {
				labelSize = labelSize,
				zIndex = self.zIndex + 1,
			})
			self.discFrame = self.mapView.frame
		else
			UiParts.text(holder, Type.Body, "Drawing the map…", Role.TextMuted, {
				Size = UDim2.fromScale(1, 1),
				TextXAlignment = Enum.TextXAlignment.Center,
				ZIndex = self.zIndex + 2,
			})
		end
		holder.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			if not self.visible then
				return
			end
			local wx, wz = self:worldFromInput(input.Position)
			if wx then
				self:SetPick(wx, wz)
			end
		end)
		return holder
	end

	if form == "tall" then
		-- Portrait: one column, the map as wide as the panel allows.
		local width = math.clamp(viewport.X - safe.Left - safe.Right, 300, 420)
		local inner = width - Space.MD * 2
		local y = Space.MD
		y = header(Space.MD, y, inner, Type.Heading, Type.Title)
		y += Space.SM
		drawMap(Space.MD, y, inner, 11)
		y += inner + Space.MD
		readoutCard(Space.MD, y, inner, 50)
		y += 50 + Space.SM
		UiParts.text(panel, Type.Caption, hint .. " " .. fallbackNote, Role.TextMuted, {
			Position = UDim2.fromOffset(Space.MD, y),
			Size = UDim2.fromOffset(inner, 30),
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = self.zIndex + 1,
		})
		y += 30 + Space.MD
		panel.Size = UDim2.fromOffset(width, y)
		-- Held below Roblox's own top bar, and centred in what is left.
		local top = safe.Top + (viewport.Y - safe.Top - bottomInset - y) / 2
		panel.AnchorPoint = Vector2.new(0.5, 0)
		panel.Position = UDim2.new(0.5, 0, 0, math.max(safe.Top, math.floor(top)))
		if self.data and self.pick then
			self:SetPick(self.pick.x, self.pick.z, true)
		end
		return
	end

	-- Landscape. The map on the left, the words in a column on the right. The map is sized off the
	-- HEIGHT that is actually free, header and padding already taken out — sizing it off the raw
	-- viewport is how the first draft came out taller than an 844x390 screen.
	local column = form == "short" and 300 or 340
	local chrome = Space.MD * 2
	local free = viewport.Y - safe.Top - bottomInset - chrome
	local mapPx = math.clamp(math.floor(free), 200, form == "short" and 340 or 520)
	local width = Space.MD + mapPx + Space.LG + column + Space.MD
	local height = mapPx + chrome

	panel.Size = UDim2.fromOffset(width, height)
	panel.Position = UDim2.new(0.5, 0, 0, math.max(safe.Top, math.floor(safe.Top + (viewport.Y - safe.Top - bottomInset - height) / 2)))
	panel.AnchorPoint = Vector2.new(0.5, 0)

	drawMap(Space.MD, Space.MD, mapPx, form == "short" and 11 or 12)

	local x = Space.MD + mapPx + Space.LG
	local y = Space.MD
	y = header(x, y, column, form == "short" and Type.Heading or Type.Title,
		form == "short" and Type.Title or Type.Display)
	y += Space.SM
	readoutCard(x, y, column, 52)
	y += 52 + Space.SM
	UiParts.text(panel, Type.Body, hint, Role.Text, {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(column, 40),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = self.zIndex + 1,
	})
	y += 44

	-- The legend, in the COLUMN. The first draft drew it at the panel's own x = 0, which put it
	-- behind the map and half outside the panel.
	local legend = create("Frame", {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(column, 46),
		BackgroundTransparency = 1,
		ZIndex = self.zIndex + 1,
		Parent = panel,
	})
	local lx, ly = 0, 0
	for _, item in ipairs({
		{ "Landmark", "diamond" }, { "Road", "road" },
		{ "Water", "w" }, { "Buildings", "b" },
	}) do
		local w = textWidth(item[1], Type.Caption.Size, Type.Caption.Font)
		if lx + 16 + w + 12 &gt; column then
			lx, ly = 0, ly + 20
		end
		if item[2] == "ring" then
			create("Frame", {
				Position = UDim2.fromOffset(lx, ly + 1),
				Size = UDim2.fromOffset(12, 12),
				BackgroundTransparency = 1,
				ZIndex = self.zIndex + 2,
				Parent = legend,
			}, {
				create("UICorner", { CornerRadius = UDim.new(1, 0) }),
				create("UIStroke", { Color = Role.Text, Thickness = 1, Transparency = 0.4 }),
			})
		elseif item[2] == "diamond" then
			create("Frame", {
				Position = UDim2.fromOffset(lx + 2, ly + 3),
				Size = UDim2.fromOffset(9, 9),
				BackgroundColor3 = Role.Accent,
				BorderSizePixel = 0,
				Rotation = 45,
				ZIndex = self.zIndex + 2,
				Parent = legend,
			})
		elseif item[2] == "road" then
			create("Frame", {
				Position = UDim2.fromOffset(lx, ly + 6),
				Size = UDim2.fromOffset(12, 3),
				BackgroundColor3 = Color3.fromRGB(ROAD[1], ROAD[2], ROAD[3]),
				BorderSizePixel = 0,
				ZIndex = self.zIndex + 2,
				Parent = legend,
			})
		else
			local base = PALETTE[item[2]]
			create("Frame", {
				Position = UDim2.fromOffset(lx, ly + 1),
				Size = UDim2.fromOffset(12, 12),
				BackgroundColor3 = Color3.fromRGB(base[1], base[2], base[3]),
				BorderSizePixel = 0,
				ZIndex = self.zIndex + 2,
				Parent = legend,
			}, { create("UICorner", { CornerRadius = UDim.new(0, 3) }) })
		end
		UiParts.text(legend, Type.Caption, item[1], Role.TextMuted, {
			Position = UDim2.fromOffset(lx + 16, ly),
			Size = UDim2.fromOffset(w + 4, 14),
			ZIndex = self.zIndex + 2,
		})
		lx += 16 + w + 12
	end

	y += 48
	UiParts.text(panel, Type.Caption, fallbackNote, Role.TextMuted, {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(column, 30),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = self.zIndex + 1,
	})

	if self.data and self.pick then
		self:SetPick(self.pick.x, self.pick.z, true)
	end
end

return DropPicker
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX152"><Properties><string name="Name">EnemyAura</string><ProtectedString name="Source">-- Friend from enemy, at a glance (Oliver's #95; grew out of #27, "enemies get a red aura and it
-- must NOT show through walls").
--
-- Two marks, because one is not enough at a glance: a coloured body, and a coloured name. The body
-- reads at range and in a firefight; the name reads when the body is behind cover or only a shoulder
-- is showing. Both come from the same test, so they can never disagree.
--
-- WHAT DECIDES A SIDE: the `Team` attribute ModeTeams writes on the CHARACTER (ModeTeams.lua:318,
-- :620, :636, :712). That is the server's own answer, it needs no remote, and it covers BOTS for
-- free -- a bot is a combatant with a token like any other, so it gets the attribute on the same
-- lines a player does. This is why the script watches workspace for characters carrying the
-- attribute rather than iterating Players: the previous version iterated `Players:GetPlayers()` and
-- so marked no bot at all, in a game where most of the opposition is bots.
--
-- A character with no `Team` attribute gets nothing, so this is inert in the battle royale and in
-- the lobby without needing to know what mode is running.
--
-- THE ONE LINE THAT MATTERS FOR FAIRNESS: `DepthMode = Occluded`. A Highlight defaults to
-- `AlwaysOnTop`, which draws through every wall in the map -- a wallhack handed to everyone. It is
-- asserted in tools/enemy_aura_gallery.lua against a planted `AlwaysOnTop` control that must glow
-- through the same wall, so the check can fail.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameModes = require(Shared:WaitForChild("GameModes"))

local player = Players.LocalPlayer

local ENEMY = Color3.fromRGB(232, 92, 92)
-- Teammates are green, whichever team you are on (Oliver, 2026-09-22: "change the friendly color for the
-- team gamemodes to green"). It used to be the team's own colour.
local FRIEND = Color3.fromRGB(80, 230, 110)
-- Enemies are filled and outlined. Friends get a light green fill and NO outline (Oliver, 2026-09-23
-- 16:11: "a bunch of the foliage and stuff is outlined the same way a friendly bot is"). With DepthMode
-- Occluded, Roblox traces the outline along the edge of whatever is in front of the character, so a bush,
-- fence or leaf covering a teammate got a green outline of its own. A fill is only drawn on the character's
-- own visible pixels, so it cannot spill onto anything else.
local ENEMY_FILL, FRIEND_FILL = 0.65, 0.72
local ENEMY_OUTLINE, FRIEND_OUTLINE = 0.15, 1

local marks = {}

-- ROBLOX DRAWS AT MOST 31 HIGHLIGHTS AT ONCE, and silently drops the rest. A team match fills to 30
-- combatants, so 29 marks plus a dead body still carrying its mark, or a barricade preview, went over
-- and some players and bots showed no outline at all (Oliver, 2026-09-22: "sometimes the outline ...
-- isnt visible"). So only the nearest MAX_LIT are switched on, re-picked a few times a second, and a
-- dead body's mark is taken off straight away. The coloured name still marks everyone else.
local MAX_LIT = 24
local camera = workspace.CurrentCamera

local function myTeam()
	local character = player.Character
	return character and character:GetAttribute("Team")
end

local function nameLabel(character)
	local head = character:FindFirstChild("Head")
	local plate = head and head:FindFirstChild("Nameplate")
	return plate and plate:FindFirstChild("PlayerName")
end

local function clear(character)
	local mark = marks[character]
	if not mark then
		return
	end
	if mark.highlight then
		mark.highlight:Destroy()
	end
	if mark.pin then
		mark.pin:Destroy()
	end
	-- The nameplate is the server's, and we only ever changed its colour: put the colour back rather
	-- than leaving our own on somebody else's instance.
	local label = nameLabel(character)
	if label and mark.nameWas then
		label.TextColor3 = mark.nameWas
	end
	marks[character] = nil
end

local function paint(character)
	if not character or not character.Parent or character == player.Character then
		return
	end
	local mine, theirs = myTeam(), character:GetAttribute("Team")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if mine == nil or theirs == nil or (humanoid and humanoid.Health &lt;= 0) then
		clear(character)
		return
	end

	local enemy = theirs ~= mine
	local colour = enemy and ENEMY or FRIEND
	local mark = marks[character]
	if not mark then
		mark = {}
		marks[character] = mark
	end

	if not mark.highlight then
		mark.highlight = Instance.new("Highlight")
		mark.highlight.Name = "TeamMark"
		-- The requirement, in one property: hidden by anything in front of it, so a wall hides a
		-- marked character exactly as it hides the character.
		mark.highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		mark.highlight.Adornee = character
		mark.highlight.Enabled = false -- the budget loop below switches it on
		mark.highlight.Parent = character
		if humanoid then
			-- A body is not a target (Oliver, 2026-09-22: "the glow ... disappears when the bot or player
			-- dies so you dont mistake corpses for enemies"). Died, and health reaching 0, both take the
			-- mark off at once -- Died alone can arrive late or not at all for a body another machine owns.
			humanoid.Died:Connect(function()
				clear(character)
			end)
			humanoid.HealthChanged:Connect(function(health)
				if health &lt;= 0 then
					clear(character)
				end
			end)
		end
	end
	mark.highlight.FillColor = colour
	mark.highlight.OutlineColor = colour
	mark.highlight.FillTransparency = enemy and ENEMY_FILL or FRIEND_FILL
	mark.highlight.OutlineTransparency = enemy and ENEMY_OUTLINE or FRIEND_OUTLINE

	-- Teammates also get a small green marker over their heads (Oliver, 2026-09-23: "make it easier to tell
	-- what team youre on"). NOT through walls (Oliver, 14:39: "i dont wanna see the team marker icon through
	-- walls"): AlwaysOnTop is off, so a wall in front hides it like it hides the teammate. It is a
	-- BillboardGui, so it costs none of the 31-highlight budget.
	if enemy then
		if mark.pin then
			mark.pin:Destroy()
			mark.pin = nil
		end
	elseif not mark.pin or not mark.pin.Parent then
		local head = character:FindFirstChild("Head") or character.PrimaryPart
		if head then
			local pin = Instance.new("BillboardGui")
			pin.Name = "TeamPin"
			pin.AlwaysOnTop = false
			pin.LightInfluence = 0
			pin.MaxDistance = 600
			pin.Size = UDim2.fromOffset(22, 18)
			pin.StudsOffsetWorldSpace = Vector3.new(0, 4.2, 0)
			pin.Adornee = head
			local arrow = Instance.new("TextLabel")
			arrow.BackgroundTransparency = 1
			arrow.Size = UDim2.fromScale(1, 1)
			arrow.Font = Enum.Font.GothamBlack
			arrow.Text = "▼"
			arrow.TextScaled = true
			arrow.TextColor3 = FRIEND
			arrow.TextStrokeColor3 = Color3.fromRGB(10, 40, 18)
			arrow.TextStrokeTransparency = 0.2
			arrow.Parent = pin
			pin.Parent = head
			mark.pin = pin
		end
	end

	-- The name, in the same colour. The plate is built server-side a moment after the character, so
	-- this runs again when it appears (see `watch`), and the original colour is kept so `clear` can
	-- put it back.
	local label = nameLabel(character)
	if label then
		if mark.nameWas == nil then
			mark.nameWas = label.TextColor3
		end
		label.TextColor3 = colour
	end
end

local function repaintAll()
	for _, model in ipairs(workspace:GetChildren()) do
		if model:IsA("Model") and model:GetAttribute("Team") ~= nil then
			paint(model)
		end
	end
end

local function watch(model)
	if not model:IsA("Model") then
		return
	end
	-- Attributes arrive after the model does -- ModeTeams sets Team when it places the body -- so a
	-- character is watched whether or not it has a side yet, and painted when it gets one.
	model:GetAttributeChangedSignal("Team"):Connect(function()
		paint(model)
	end)
	-- The nameplate is parented into the head after the character is in workspace. Without this the
	-- name keeps its default colour until something else repaints, which in a quiet match is never.
	model.DescendantAdded:Connect(function(descendant)
		if descendant.Name == "PlayerName" and marks[model] then
			paint(model)
		end
	end)
	if model:GetAttribute("Team") ~= nil then
		paint(model)
	end
end

-- The budget: nearest first, enemies ahead of friends at the same distance.
task.spawn(function()
	while true do
		task.wait(0.3)
		local eye = camera and camera.CFrame.Position
		local list = {}
		for character, mark in pairs(marks) do
			if mark.highlight then
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				if not character.Parent or (humanoid and humanoid.Health &lt;= 0)
					or (humanoid and humanoid:GetState() == Enum.HumanoidStateType.Dead) then
					-- Gone, or a body: never outlined (the budget pass is the backstop for a missed Died).
					clear(character)
				else
					local pivot = character:GetPivot().Position
					local distance = eye and (pivot - eye).Magnitude or 0
					if mark.highlight.OutlineTransparency &lt; 1 then -- enemies (only they have an outline)
						distance *= 0.8
					end
					table.insert(list, { mark = mark, distance = distance })
				end
			end
		end
		table.sort(list, function(a, b)
			return a.distance &lt; b.distance
		end)
		for index, entry in ipairs(list) do
			local lit = index &lt;= MAX_LIT
			if entry.mark.highlight.Enabled ~= lit then
				entry.mark.highlight.Enabled = lit
			end
		end
	end
end)

workspace.ChildAdded:Connect(watch)
workspace.ChildRemoved:Connect(clear)
for _, model in ipairs(workspace:GetChildren()) do
	watch(model)
end

-- My own side arriving or changing flips who is an enemy, so everything is re-tested rather than
-- only the character that changed.
player.CharacterAdded:Connect(function(character)
	character:GetAttributeChangedSignal("Team"):Connect(repaintAll)
	repaintAll()
end)
if player.Character then
	player.Character:GetAttributeChangedSignal("Team"):Connect(repaintAll)
	repaintAll()
end
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX153"><Properties><string name="Name">EventBanner</string><ProtectedString name="Source">-- The match event announcement: a ModuleScript so HudClient can mount it and tools/hud_ux_gallery.lua
-- can render every event in every phase without a match running.
--
--   local banner = EventBanner.new(screenGui, { onAnnounce = function() Sfx.Play(...) end })
--   banner:SetViewport(camera.ViewportSize)
--   banner:SetDock("slot")                   -- "slot": beside the top banner, where the READY pill sits
--                                            -- in the lobby; "below": under that pill, while it shows
--   banner:Announce(event)                   -- { id, name, description, color } from MatchEvents.Describe
--   banner:SetTimer("drop", 12)              -- "drop" (seconds to the drop), "building", "live" (seconds
--                                            -- since it started, or nil if not known)
--   banner:Clear()                           -- no event: everything away
--
-- What it does: the event lands as a big card under the compass (icon, name, one line on what it does,
-- and a timer), holds for HOLD seconds, then shrinks into a compact pill beside the top banner that
-- stays for the match. The card sits well above the crosshair and never stays up long. Tapping or
-- clicking the pill brings the card back for another few seconds, so nothing about the event is ever
-- more than a tap away. The icons are drawn from frames, so there are no image assets to load.
--
-- Sized in pixels for a 1080p screen; SetViewport scales it for others.

local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")

local UiKit = require(script.Parent:WaitForChild("UiKit"))

local create, rounded = UiKit.create, UiKit.rounded
local C = UiKit.Colors

local EventBanner = {}
EventBanner.__index = EventBanner

EventBanner.CardSize = Vector2.new(880, 160)
EventBanner.PillSize = Vector2.new(236, 56)
EventBanner.Hold = 3.2

-- THE VOTE REVEAL HIDES THE CARD (#86). The event is announced on the same server beat as the vote
-- closes, and the 3 s "NEXT MATCH" reveal is an opaque panel in PreMatchUi at DisplayOrder 30, over
-- this card's BrrHud: on a 720p/768p screen the card's description line sat under the panel for 3 of
-- its 3.2 s. So VoteDropClient calls HoldFor(REVEAL_SECONDS) when a reveal starts, and a card
-- announced inside the hold waits it out -- in either order: an Announce during the hold is deferred,
-- and a card already up when the hold starts is announced again once it ends, for its full time.
-- tick(), not os.clock() (CPU time in Roblox). 0 = no hold, which is every gallery and probe.
EventBanner.holdUntil = 0
local liveBanners = {}

function EventBanner.HoldFor(seconds)
	EventBanner.holdUntil = math.max(EventBanner.holdUntil, tick() + seconds)
	for _, banner in ipairs(liveBanners) do
		if banner.event and banner.phase == "card" then
			banner:Announce(banner.event)
		end
	end
end

local CARD_W, CARD_H = EventBanner.CardSize.X, EventBanner.CardSize.Y
local PILL_W, PILL_H = EventBanner.PillSize.X, EventBanner.PillSize.Y
local ICON_BADGE = 116
local TIMER_W = 132
local TEXT_X = 30 + ICON_BADGE + 26
local TEXT_W = CARD_W - TEXT_X - TIMER_W - 44

-- The top banner (HudClient) is 56 tall at y 10; the READY pill beside it is 230x60 at (centre + 232, 8).
local SLOT_X, SLOT_Y = 232, 10
local BELOW_Y = 8 + 60 + 8
local ZINDEX = 30

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

--------------------------------------------------------------------------------
-- Icons, drawn from frames in a square. Positions and sizes are fractions of the square.
--------------------------------------------------------------------------------

local Icon = {}

local function shape(parent, x, y, w, h, color, props)
	props = props or {}
	local frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(w, h),
		BackgroundColor3 = color,
		BackgroundTransparency = props.transparency or 0,
		BorderSizePixel = 0,
		Rotation = props.rotation or 0,
		ZIndex = props.z or ZINDEX + 3,
		Parent = parent,
	})
	if props.round then
		create("UICorner", { CornerRadius = UDim.new(props.round, 0), Parent = frame })
	end
	return frame
end

local function circle(parent, x, y, d, color, props)
	props = props or {}
	props.round = 0.5
	return shape(parent, x, y, d, d, color, props)
end

-- An outline only: a transparent circle (or rounded box) with a stroke `t` of the square thick.
local function ring(parent, x, y, w, h, t, color, px, props)
	props = props or {}
	local frame = shape(parent, x, y, w, h, color, { transparency = 1, round = 0.5, rotation = props.rotation, z = props.z })
	create("UIStroke", { Color = color, Thickness = math.max(1, t * px), Transparency = props.transparency or 0, Parent = frame })
	return frame
end

local function diamond(parent, x, y, s, color, props)
	props = props or {}
	props.rotation = 45
	return shape(parent, x, y, s, s, color, props)
end

-- A bar from (x1, y1) to (x2, y2), `t` thick.
local function line(parent, x1, y1, x2, y2, t, color, props)
	props = props or {}
	local dx, dy = x2 - x1, y2 - y1
	props.rotation = math.deg(math.atan2(dy, dx))
	props.round = props.round or 0.5
	return shape(parent, (x1 + x2) / 2, (y1 + y2) / 2, math.sqrt(dx * dx + dy * dy) + t, t, color, props)
end

-- A chevron whose point is at (x, y), pointing along `degrees` (0 right, 90 down), arms `len` long.
local function chevron(parent, x, y, degrees, len, t, color, props)
	for _, spread in ipairs({ 135, -135 }) do
		local a = math.rad(degrees + spread)
		line(parent, x, y, x + math.cos(a) * len, y + math.sin(a) * len, t, color, props)
	end
end

Icon.LootFrenzy = function(box, color, light, dark, px)
	shape(box, 0.5, 0.66, 0.66, 0.34, color, { round = 0.12 })
	shape(box, 0.5, 0.66, 0.66, 0.07, dark)
	shape(box, 0.5, 0.43, 0.74, 0.2, light, { round = 0.3 })
	shape(box, 0.5, 0.53, 0.14, 0.17, WHITE, { round = 0.25, z = ZINDEX + 4 })
	shape(box, 0.5, 0.55, 0.05, 0.07, dark, { z = ZINDEX + 5 })
	diamond(box, 0.2, 0.18, 0.11, WHITE)
	diamond(box, 0.5, 0.12, 0.15, WHITE)
	diamond(box, 0.8, 0.18, 0.11, WHITE)
end

Icon.BountyRush = function(box, color, light, dark, px)
	ring(box, 0.5, 0.5, 0.8, 0.8, 0.075, light, px)
	ring(box, 0.5, 0.5, 0.44, 0.44, 0.075, light, px)
	for _, tick in ipairs({ { 0.5, 0.06, 0.07, 0.22 }, { 0.5, 0.94, 0.07, 0.22 }, { 0.06, 0.5, 0.22, 0.07 }, { 0.94, 0.5, 0.22, 0.07 } }) do
		shape(box, tick[1], tick[2], tick[3], tick[4], WHITE, { round = 0.5 })
	end
	circle(box, 0.5, 0.5, 0.16, WHITE, { z = ZINDEX + 4 })
end

Icon.RotRush = function(box, color, light, dark, px)
	for index, y in ipairs({ 0.3, 0.5, 0.7 }) do
		local length = index == 2 and 0.2 or 0.13
		line(box, 0.08 + (0.2 - length), y, 0.08 + 0.2, y, 0.065, light, { transparency = 0.15 })
	end
	chevron(box, 0.62, 0.5, 0, 0.26, 0.12, light)
	chevron(box, 0.88, 0.5, 0, 0.26, 0.12, WHITE)
end

Icon.ShieldUp = function(box, color, light, dark, px)
	shape(box, 0.5, 0.36, 0.64, 0.42, light, { round = 0.2 })
	diamond(box, 0.5, 0.57, 0.45, light)
	shape(box, 0.5, 0.36, 0.44, 0.28, color, { round = 0.2, z = ZINDEX + 4 })
	diamond(box, 0.5, 0.55, 0.3, color, { z = ZINDEX + 4 })
	shape(box, 0.5, 0.49, 0.08, 0.3, WHITE, { round = 0.5, z = ZINDEX + 5 })
	shape(box, 0.5, 0.49, 0.3, 0.08, WHITE, { round = 0.5, z = ZINDEX + 5 })
end

Icon.HighStakes = function(box, color, light, dark, px)
	for index, y in ipairs({ 0.78, 0.64, 0.5 }) do
		local z = ZINDEX + 2 + index * 2
		shape(box, 0.36, y + 0.05, 0.52, 0.2, dark, { round = 0.5, z = z })
		shape(box, 0.36, y, 0.52, 0.2, index == 3 and light or color, { round = 0.5, z = z + 1 })
	end
	create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.76, 0.28),
		Size = UDim2.fromScale(0.52, 0.34),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = "1.5x",
		TextColor3 = WHITE,
		TextScaled = true,
		ZIndex = ZINDEX + 10,
		Parent = box,
	})
end

Icon.NightOps = function(box, color, light, dark, px, backdrop)
	circle(box, 0.44, 0.54, 0.66, light)
	circle(box, 0.62, 0.4, 0.56, backdrop, { z = ZINDEX + 4 })
	diamond(box, 0.8, 0.74, 0.11, WHITE, { z = ZINDEX + 5 })
	diamond(box, 0.72, 0.18, 0.08, WHITE, { z = ZINDEX + 5 })
	diamond(box, 0.9, 0.44, 0.06, WHITE, { z = ZINDEX + 5 })
end

Icon.LowGravity = function(box, color, light, dark, px)
	-- A ball floating high over the ground, its shadow far below, rising.
	shape(box, 0.5, 0.93, 0.78, 0.06, WHITE, { round = 0.5, transparency = 0.2 })
	shape(box, 0.5, 0.86, 0.3, 0.07, dark, { round = 0.5, transparency = 0.1 })
	for index, y in ipairs({ 0.66, 0.74 }) do
		shape(box, 0.5, y, 0.05 + index * 0.06, 0.045, WHITE, { round = 0.5, transparency = 0.25 + index * 0.2 })
	end
	circle(box, 0.5, 0.42, 0.4, light)
	circle(box, 0.43, 0.35, 0.1, WHITE, { transparency = 0.35, z = ZINDEX + 4 })
	chevron(box, 0.5, 0.02, -90, 0.15, 0.07, WHITE)
end

Icon.ZoneRush = function(box, color, light, dark, px)
	ring(box, 0.5, 0.5, 0.9, 0.9, 0.05, light, px, { transparency = 0.35 })
	circle(box, 0.5, 0.5, 0.3, light)
	circle(box, 0.5, 0.5, 0.14, WHITE, { z = ZINDEX + 4 })
	for _, degrees in ipairs({ 90, 180, 270, 0 }) do
		local a = math.rad(degrees + 180)
		chevron(box, 0.5 + math.cos(a) * 0.25, 0.5 + math.sin(a) * 0.25, degrees, 0.12, 0.07, WHITE)
	end
end

Icon.HotDrops = function(box, color, light, dark, px)
	local dome = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.06),
		Size = UDim2.fromScale(0.86, 0.3),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = ZINDEX + 3,
		Parent = box,
	})
	local canopy = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(1, 0.86 / 0.3),
		BackgroundColor3 = light,
		BorderSizePixel = 0,
		ZIndex = ZINDEX + 3,
		Parent = dome,
	})
	create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = canopy })
	for _, x in ipairs({ 0.36, 0.64 }) do
		shape(dome, x, 0.5, 0.05, 1.2, dark, { z = ZINDEX + 4, transparency = 0.3 })
	end
	line(box, 0.1, 0.36, 0.4, 0.66, 0.04, WHITE)
	line(box, 0.9, 0.36, 0.6, 0.66, 0.04, WHITE)
	line(box, 0.5, 0.36, 0.5, 0.66, 0.04, WHITE)
	shape(box, 0.5, 0.79, 0.34, 0.28, color, { round = 0.12, z = ZINDEX + 5 })
	shape(box, 0.5, 0.79, 0.34, 0.06, dark, { z = ZINDEX + 6 })
	shape(box, 0.5, 0.79, 0.06, 0.28, dark, { z = ZINDEX + 6 })
end

Icon.Headhunter = function(box, color, light, dark, px)
	ring(box, 0.5, 0.5, 0.9, 0.9, 0.045, WHITE, px, { transparency = 0.35 })
	circle(box, 0.5, 0.44, 0.5, light)
	shape(box, 0.5, 0.66, 0.3, 0.18, light, { round = 0.3 })
	circle(box, 0.4, 0.46, 0.12, dark, { z = ZINDEX + 4 })
	circle(box, 0.6, 0.46, 0.12, dark, { z = ZINDEX + 4 })
	for _, tick in ipairs({ { 0.5, 0.04, 0.05, 0.16 }, { 0.5, 0.96, 0.05, 0.16 }, { 0.04, 0.5, 0.16, 0.05 }, { 0.96, 0.5, 0.16, 0.05 } }) do
		shape(box, tick[1], tick[2], tick[3], tick[4], WHITE, { round = 0.5, z = ZINDEX + 5 })
	end
	circle(box, 0.5, 0.44, 0.08, Color3.fromRGB(255, 70, 70), { z = ZINDEX + 6 })
end

Icon.AuraFarm = function(box, color, light, dark, px)
	shape(box, 0.5, 0.38, 0.64, 0.16, light, { round = 0.2 })
	diamond(box, 0.5, 0.52, 0.5, color)
	shape(box, 0.5, 0.35, 0.64, 0.12, light, { z = ZINDEX + 4 })
	diamond(box, 0.42, 0.5, 0.14, WHITE, { transparency = 0.35, z = ZINDEX + 5 })
	diamond(box, 0.16, 0.18, 0.13, WHITE)
	diamond(box, 0.84, 0.24, 0.1, WHITE)
	diamond(box, 0.82, 0.84, 0.08, WHITE)
end

local function fallbackIcon(box)
	create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = "!",
		TextColor3 = WHITE,
		TextScaled = true,
		ZIndex = ZINDEX + 4,
		Parent = box,
	})
end

-- The icon for an event id, drawn into a round badge `px` pixels across. Returns the badge.
function EventBanner.Badge(parent, eventId, color, px)
	color = color or C.Accent
	local light = color:Lerp(WHITE, 0.3)
	local dark = color:Lerp(BLACK, 0.55)
	local backdrop = color:Lerp(BLACK, 0.72)
	local badge = create("Frame", {
		Name = "Badge",
		Size = UDim2.fromOffset(px, px),
		BackgroundColor3 = backdrop,
		BorderSizePixel = 0,
		ZIndex = ZINDEX + 1,
		Parent = parent,
	}, { rounded(px / 2) })
	create("UIStroke", { Color = color, Thickness = math.max(1.5, px * 0.035), Parent = badge })
	create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(WHITE, Color3.fromRGB(170, 170, 170)),
		Parent = badge,
	})
	local box = create("Frame", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.62, 0.62),
		BackgroundTransparency = 1,
		ZIndex = ZINDEX + 2,
		Parent = badge,
	})
	local draw = Icon[eventId]
	if draw then
		draw(box, color, light, dark, px * 0.62, backdrop)
	else
		fallbackIcon(box)
	end
	return badge
end

EventBanner.IconIds = {}
for id in pairs(Icon) do
	table.insert(EventBanner.IconIds, id)
end
table.sort(EventBanner.IconIds)

--------------------------------------------------------------------------------
-- The card and the pill
--------------------------------------------------------------------------------

local function formatClock(seconds)
	seconds = math.max(0, math.floor(seconds or 0))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- How big the card is drawn on a viewport: full size at 1080 tall, never wider than the screen, and
-- never so small a phone can't read it.
function EventBanner.CardScaleFor(viewport)
	local scale = math.clamp(viewport.Y / 1080 * 1.12, 0.62, 1)
	scale = math.min(scale, (viewport.X - 32) / CARD_W)
	local phone = EventBanner.PhoneSpot(viewport)
	if phone then
		-- Whatever else, the card's bottom edge stays above the crosshair on a short screen.
		scale = math.min(scale, (viewport.Y / 2 - 14 - phone.eventPill.y) / CARD_H)
	end
	return scale
end

-- The pill keeps the top banner's own pixel size, shrinking only to fit a narrow screen.
function EventBanner.PillScaleFor(viewport)
	local phone = EventBanner.PhoneSpot(viewport)
	if phone then
		return phone.eventPill.w / PILL_W
	end
	local room = viewport.X - 8 - (viewport.X / 2 + SLOT_X)
	return math.clamp(room / PILL_W, 0.6, 1)
end

-- On a touch screen the whole HUD is laid out by PhoneLayout, and the pill has a slot of its own at the
-- top right, under the menu icons. Returns its rects, or nil on a desktop screen (and if that module
-- ever fails to load, which leaves the banner exactly where it was).
local phoneModule = nil
function EventBanner.PhoneSpot(viewport)
	if phoneModule == nil then
		local ok, module = pcall(function()
			return require(script.Parent:WaitForChild("PhoneLayout", 5))
		end)
		phoneModule = ok and module or false
	end
	if not phoneModule or not viewport or not phoneModule.Active(viewport) then
		return nil
	end
	return phoneModule.Rects(viewport)
end

-- Where the card's top edge goes: under the compass, or higher on a short screen so it stays clear
-- of the crosshair. On a phone it starts where the pill it docks into sits.
function EventBanner.CardTopFor(viewport)
	local phone = EventBanner.PhoneSpot(viewport)
	if phone then
		return phone.eventPill.y
	end
	return viewport.Y &lt; 600 and 70 or 136
end

function EventBanner.new(parent, options)
	options = options or {}
	local self = setmetatable({}, EventBanner)
	table.insert(liveBanners, self)
	self.options = options
	self.viewport = Vector2.new(1920, 1080)
	self.dock = "slot"
	self.token = 0
	self.phase = "hidden"

	-- The card.
	local card = create("CanvasGroup", {
		Name = "EventCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 136),
		Size = UDim2.fromOffset(CARD_W, CARD_H),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		ZIndex = ZINDEX,
		Parent = parent,
	})
	self.card = card
	self.cardScale = create("UIScale", { Parent = card })

	-- Inset by the stroke's width: a CanvasGroup clips at its own edges, and a stroke drawn outside the
	-- plate would lose its rounded corners there.
	local plate = create("Frame", {
		Name = "Plate",
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 1, -8),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
		ZIndex = ZINDEX,
		Parent = card,
	}, { rounded(20) })
	self.cardStroke = create("UIStroke", { Thickness = 3, Transparency = 0.05, Parent = plate })

	-- The event's colour washing in from the left, behind the badge.
	self.wash = create("Frame", {
		Name = "Wash",
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 1, -8),
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		ZIndex = ZINDEX,
		Parent = card,
	}, { rounded(20) })
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.55),
			NumberSequenceKeypoint.new(0.32, 0.8),
			NumberSequenceKeypoint.new(0.7, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = self.wash,
	})

	-- A glint that sweeps across the card as it lands.
	self.glint = create("Frame", {
		Name = "Glint",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, -120, 0.5, 0),
		Size = UDim2.fromOffset(70, CARD_H * 2.2),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		Rotation = 18,
		ZIndex = ZINDEX + 9,
		Parent = card,
	})
	create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = self.glint,
	})

	self.badgeHolder = create("Frame", {
		Name = "BadgeHolder",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 30, 0.5, 0),
		Size = UDim2.fromOffset(ICON_BADGE, ICON_BADGE),
		BackgroundTransparency = 1,
		ZIndex = ZINDEX + 1,
		Parent = card,
	})
	self.badgeScale = create("UIScale", { Parent = self.badgeHolder })
	-- A soft halo behind the badge.
	self.halo = create("Frame", {
		Name = "Halo",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1.36, 1.36),
		BackgroundColor3 = C.Accent,
		BackgroundTransparency = 0.78,
		BorderSizePixel = 0,
		ZIndex = ZINDEX,
		Parent = self.badgeHolder,
	}, { rounded(ICON_BADGE) })

	self.kicker = create("TextLabel", {
		Name = "Kicker",
		Position = UDim2.fromOffset(TEXT_X, 18),
		Size = UDim2.fromOffset(128, 24),
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBlack,
		Text = "MATCH EVENT",
		TextColor3 = C.Background,
		TextSize = 13,
		ZIndex = ZINDEX + 2,
		Parent = card,
	}, { rounded(12) })

	self.title = create("TextLabel", {
		Name = "Title",
		Position = UDim2.fromOffset(TEXT_X, 42),
		Size = UDim2.fromOffset(TEXT_W, 58),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = "",
		TextColor3 = WHITE,
		TextSize = 54,
		TextStrokeTransparency = 0.35,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = ZINDEX + 2,
		Parent = card,
	})

	self.description = create("TextLabel", {
		Name = "Description",
		Position = UDim2.fromOffset(TEXT_X, 102),
		Size = UDim2.fromOffset(TEXT_W, 44),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = C.Text,
		TextSize = 20,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = ZINDEX + 2,
		Parent = card,
	})

	local timer = create("Frame", {
		Name = "Timer",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -26, 0.5, 0),
		Size = UDim2.fromOffset(TIMER_W, 98),
		BackgroundColor3 = C.PanelAlt,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		ZIndex = ZINDEX + 1,
		Parent = card,
	}, { rounded(14) })
	self.timerStroke = create("UIStroke", { Thickness = 1.5, Transparency = 0.55, Parent = timer })
	self.timerLabel = create("TextLabel", {
		Name = "Label",
		Position = UDim2.fromOffset(0, 14),
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = "ALL MATCH",
		TextColor3 = C.Muted,
		TextSize = 13,
		ZIndex = ZINDEX + 2,
		Parent = timer,
	})
	self.timerValue = create("TextLabel", {
		Name = "Value",
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = "LIVE",
		TextColor3 = C.Accent,
		TextSize = 40,
		ZIndex = ZINDEX + 2,
		Parent = timer,
	})

	-- The pill.
	local pill = create("CanvasGroup", {
		Name = "EventPill",
		Position = UDim2.new(0.5, SLOT_X, 0, SLOT_Y),
		Size = UDim2.fromOffset(PILL_W, PILL_H),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		ZIndex = ZINDEX,
		Parent = parent,
	})
	self.pill = pill
	self.pillScale = create("UIScale", { Parent = pill })
	local pillPlate = create("Frame", {
		Name = "Plate",
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		BackgroundColor3 = C.Background,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		ZIndex = ZINDEX,
		Parent = pill,
	}, { rounded(14) })
	self.pillStroke = create("UIStroke", { Thickness = 2, Transparency = 0.25, Parent = pillPlate })
	self.pillWash = create("Frame", {
		Name = "Wash",
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		ZIndex = ZINDEX,
		Parent = pill,
	}, {
		rounded(14),
		create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.6),
				NumberSequenceKeypoint.new(0.45, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}),
	})
	self.pillBadgeHolder = create("Frame", {
		Name = "BadgeHolder",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(40, 40),
		BackgroundTransparency = 1,
		ZIndex = ZINDEX + 1,
		Parent = pill,
	})
	self.pillTitle = create("TextLabel", {
		Name = "Title",
		Position = UDim2.fromOffset(56, 7),
		Size = UDim2.fromOffset(PILL_W - 56 - 26, 24),
		BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne,
		Text = "",
		TextColor3 = C.Accent,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = ZINDEX + 2,
		Parent = pill,
	})
	self.pillSub = create("TextLabel", {
		Name = "Sub",
		Position = UDim2.fromOffset(56, 31),
		Size = UDim2.fromOffset(PILL_W - 56 - 26, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = C.Muted,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = ZINDEX + 2,
		Parent = pill,
	})
	-- "i": the pill opens the card again.
	local info = create("TextLabel", {
		Name = "Info",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -9, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = C.PanelAlt,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBlack,
		Text = "i",
		TextColor3 = C.Muted,
		TextSize = 11,
		ZIndex = ZINDEX + 2,
		Parent = pill,
	}, { rounded(8) })
	self.pillInfo = info
	-- The click target sits over the whole pill (a CanvasGroup can't be a button itself).
	self.pillButton = create("TextButton", {
		Name = "Button",
		Position = UDim2.new(0.5, SLOT_X, 0, SLOT_Y),
		Size = UDim2.fromOffset(PILL_W, PILL_H),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = ZINDEX + 12,
		Parent = parent,
	})
	self.pillButtonScale = create("UIScale", { Parent = self.pillButton })
	self.pillButton.Activated:Connect(function()
		if self.event then
			self:Expand()
		end
	end)
	self.pillButton.MouseEnter:Connect(function()
		self.pillStroke.Transparency = 0
		info.TextColor3 = C.Text
	end)
	self.pillButton.MouseLeave:Connect(function()
		self.pillStroke.Transparency = 0.25
		info.TextColor3 = C.Muted
	end)

	self:SetViewport(self.viewport)
	return self
end

function EventBanner:_pillOrigin()
	local scale = EventBanner.PillScaleFor(self.viewport)
	local phone = EventBanner.PhoneSpot(self.viewport)
	if phone then
		-- Its own slot, and the one under the READY pill while that is out (the lobby).
		local spot = self.dock == "below" and phone.eventPillBelow or phone.eventPill
		return spot.x, spot.y, scale
	end
	local x = math.min(self.viewport.X / 2 + SLOT_X, self.viewport.X - 8 - PILL_W * scale)
	local y = self.dock == "below" and BELOW_Y or SLOT_Y
	return x, y, scale
end

function EventBanner:_layout()
	local x, y, scale = self:_pillOrigin()
	self.pill.Position = UDim2.fromOffset(x, y)
	self.pillScale.Scale = scale
	self.pillButton.Position = UDim2.fromOffset(x, y)
	self.pillButtonScale.Scale = scale
	if self.phase ~= "docking" then
		self.card.Position = UDim2.new(0.5, 0, 0, EventBanner.CardTopFor(self.viewport))
		self.cardScale.Scale = EventBanner.CardScaleFor(self.viewport)
	end
end

function EventBanner:SetViewport(viewport)
	self.viewport = viewport
	self:_layout()
end

function EventBanner:SetDock(dock)
	if dock ~= self.dock then
		self.dock = dock
		self:_layout()
	end
end

-- Fills the card and the pill in for an event, without showing either.
function EventBanner:_fill(event)
	local color = event.color or C.Accent
	local bright = color:Lerp(WHITE, 0.18)
	self.cardStroke.Color = color
	self.wash.BackgroundColor3 = color
	self.halo.BackgroundColor3 = color
	self.kicker.BackgroundColor3 = color
	self.title.Text = string.upper(event.name or "")
	self.title.TextStrokeColor3 = color:Lerp(BLACK, 0.6)
	self.timerStroke.Color = color
	self.timerValue.TextColor3 = bright
	self.pillStroke.Color = color
	self.pillWash.BackgroundColor3 = color
	self.pillTitle.Text = string.upper(event.name or "")
	self.pillTitle.TextColor3 = bright

	-- One line when it fits, otherwise two a little smaller.
	local description = event.description or ""
	local width = TextService:GetTextSize(description, 20, Enum.Font.GothamBold, Vector2.new(10000, 100)).X
	if width &lt;= TEXT_W then
		self.description.TextSize = 20
		self.description.Position = UDim2.fromOffset(TEXT_X, 106)
	else
		self.description.TextSize = 18
		self.description.Position = UDim2.fromOffset(TEXT_X, 102)
	end
	self.description.Text = description

	for _, holder in ipairs({ self.badgeHolder, self.pillBadgeHolder }) do
		local old = holder:FindFirstChild("Badge")
		if old then
			old:Destroy()
		end
	end
	local big = EventBanner.Badge(self.badgeHolder, event.id, color, ICON_BADGE)
	big.ZIndex = ZINDEX + 1
	EventBanner.Badge(self.pillBadgeHolder, event.id, color, 40)
end

-- The timer on both the card and the pill.
function EventBanner:SetTimer(kind, seconds)
	local label, value, sub
	if kind == "drop" then
		label, value = "DROP IN", formatClock(seconds)
		sub = "starts in " .. formatClock(seconds)
	elseif kind == "building" then
		label, value = "THIS MATCH", "SOON"
		sub = "this match  •  starting soon"
	elseif seconds then
		label, value = "LIVE FOR", formatClock(seconds)
		sub = "all match  •  live " .. formatClock(seconds)
	else
		label, value = "ALL MATCH", "LIVE"
		sub = "all match  •  live now"
	end
	self.timerLabel.Text = label
	self.timerValue.Text = value
	self.pillSub.Text = string.upper(sub)
end

local function tween(instance, seconds, goal, style, direction)
	local t = TweenService:Create(instance, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

-- The card lands: pops in, glints, holds, then docks into the pill.
function EventBanner:_showCard(hold, flourish)
	self.token += 1
	local token = self.token
	self.phase = "card"
	self:_layout()
	local scale = EventBanner.CardScaleFor(self.viewport)
	local card = self.card
	card.Visible = true
	card.GroupTransparency = 1
	self.cardScale.Scale = scale * (flourish and 0.72 or 0.92)
	tween(card, 0.22, { GroupTransparency = 0 })
	tween(self.cardScale, flourish and 0.5 or 0.25, { Scale = scale }, Enum.EasingStyle.Back)
	self.badgeScale.Scale = flourish and 0.4 or 1
	if flourish then
		task.delay(0.12, function()
			if token == self.token then
				tween(self.badgeScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end)
	end
	self.glint.Position = UDim2.new(0, -120, 0.5, 0)
	task.delay(flourish and 0.35 or 0.1, function()
		if token == self.token then
			tween(self.glint, 0.75, { Position = UDim2.new(0, CARD_W + 120, 0.5, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		end
	end)
	task.delay(hold, function()
		if token == self.token then
			self:Dock()
		end
	end)
end

-- A new event: the full entrance, then the pill.
function EventBanner:Announce(event)
	if not event then
		self:Clear()
		return
	end
	local wait = EventBanner.holdUntil - tick()
	if wait &gt; 0 then
		-- Deferred, and only if nothing newer has been announced or cleared by then (the token).
		self.token += 1
		local token = self.token
		self.event = nil
		self.phase = "hidden"
		self.card.Visible = false
		self.pill.Visible = false
		self.pillButton.Visible = false
		task.delay(wait + 0.05, function()
			if self.token == token then
				self:Announce(event)
			end
		end)
		return
	end
	self.event = event
	self:_fill(event)
	self.pill.Visible = false
	self.pillButton.Visible = false
	self:_showCard(EventBanner.Hold, true)
	if self.options.onAnnounce then
		task.spawn(self.options.onAnnounce, event)
	end
end

-- The pill was tapped: the card again, briefly.
function EventBanner:Expand()
	if not self.event or self.phase == "card" then
		return
	end
	self.pill.Visible = false
	self.pillButton.Visible = false
	self:_showCard(EventBanner.Hold * 0.8, false)
end

-- Straight to the pill (the card shrinks away into it). Safe to call at any time.
function EventBanner:Dock()
	if not self.event then
		return
	end
	if self.phase == "pill" or self.phase == "docking" then
		return
	end
	self.token += 1
	local token = self.token
	self.phase = "docking"
	local x, y, scale = self:_pillOrigin()
	-- The card's top centre flies to the pill's top centre while shrinking to the pill's width.
	local target = UDim2.fromOffset(x + PILL_W * scale / 2, y)
	tween(self.card, 0.42, { Position = target, GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(self.cardScale, 0.42, { Scale = PILL_W * scale / CARD_W }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.26, function()
		if token ~= self.token then
			return
		end
		self.pill.Visible = true
		self.pillButton.Visible = true
		self.pill.GroupTransparency = 1
		self.pillScale.Scale = scale * 1.12
		tween(self.pill, 0.2, { GroupTransparency = 0 })
		tween(self.pillScale, 0.35, { Scale = scale }, Enum.EasingStyle.Back)
	end)
	task.delay(0.45, function()
		if token ~= self.token then
			return
		end
		self.card.Visible = false
		self.phase = "pill"
		self:_layout()
	end)
end

function EventBanner:Clear()
	self.token += 1
	self.event = nil
	self.phase = "hidden"
	self.card.Visible = false
	self.pill.Visible = false
	self.pillButton.Visible = false
end

-- For galleries: set a phase instantly, no tweens. `phase` is "card", "docking" (half way) or "pill".
function EventBanner:Snap(event, phase)
	self.token += 1
	self.event = event
	self:_fill(event)
	local x, y, pillScale = self:_pillOrigin()
	local cardScale = EventBanner.CardScaleFor(self.viewport)
	self.phase = phase
	self.card.Visible = phase ~= "pill"
	self.card.GroupTransparency = phase == "docking" and 0.45 or 0
	self.pill.Visible = phase ~= "card"
	self.pillButton.Visible = phase == "pill"
	self.pill.GroupTransparency = phase == "docking" and 0.5 or 0
	self.pillScale.Scale = pillScale
	self.badgeScale.Scale = 1
	self.glint.Position = UDim2.new(0, -120, 0.5, 0)
	if phase == "docking" then
		local top = EventBanner.CardTopFor(self.viewport)
		local fromX = self.viewport.X / 2
		local toX = x + PILL_W * pillScale / 2
		self.card.Position = UDim2.fromOffset(fromX + (toX - fromX) * 0.55, top + (y - top) * 0.55)
		self.cardScale.Scale = cardScale + (PILL_W * pillScale / CARD_W - cardScale) * 0.55
	else
		self.card.Position = UDim2.new(0.5, 0, 0, EventBanner.CardTopFor(self.viewport))
		self.cardScale.Scale = cardScale
	end
end

return EventBanner
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX154"><Properties><string name="Name">ExplosiveFx</string><ProtectedString name="Source">-- Explosions, smoke clouds and the splat where a bullet lands, on the client. ModuleScript.
-- ProjectileClient and HitSplatClient call in here; tools/throwables_gallery.lua renders frozen
-- frames of each.
--
--   ExplosiveFx.Explosion(position, normal, kind, radius)   a rocket, 40mm or frag going off
--   ExplosiveFx.Impact(position, normal)                     a round that only hits (no blast)
--   ExplosiveFx.Cloud(position, spec, elapsed)               a smoke cloud `elapsed` seconds into
--                                                            its life; returns its handle
--   ExplosiveFx.Splat(limb, position, normal, options)       a hit mark on a body part in the firing
--                                                            gun's RANK COLOUR (options.color, which
--                                                            every caller must pass -- there is no
--                                                            blood in this game); options.headshot
--                                                            (bigger), options.shield (blue chips)
--   ExplosiveFx.Trail(part)                                  a rocket's exhaust and glow on a model
--   ExplosiveFx.Loop(cueName, part)                          a looping cue following a part (whoosh)
--   ExplosiveFx.Advance(dt)                                  one frame of every live effect
--   ExplosiveFx.Paused                                       true: nothing moves unless Advance is
--                                                            called by hand (the gallery)
--   ExplosiveFx.Clouds                                       live clouds { position, radius, density }
--                                                            for the inside-the-smoke overlay
--
-- Every effect is a function of its age, stepped by Advance, rather than a set of tweens: a frame
-- can be frozen at any moment for the gallery, and the same code draws it live. Textures are the
-- ones the Roblox client ships (the same set GunFx renders). Everything is capped, so a fight with
-- forty bots throwing grenades stays a few hundred instances at worst.
--
-- A smoke cloud is a lumpy ball of OPAQUE parts inside a shell of see-through ones. Only opaque
-- geometry occludes, so the opaque core is what hides nameplates and bodies behind it at every
-- graphics setting; the shell and the particle wisps soften its edge into smoke. From inside, the
-- backs of the balls aren't drawn, so ProjectileClient covers the screen instead.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Ballistics = require(Shared:WaitForChild("Ballistics"))
local SoundConfig = require(Shared:WaitForChild("SoundConfig"))

local ExplosiveFx = {}

ExplosiveFx.Paused = false
ExplosiveFx.Clouds = {}

local V = Vector3.new
local NS = NumberSequence.new
local NSK = NumberSequenceKeypoint.new
local CS = ColorSequence.new
local UP = Vector3.yAxis

local TEXTURE = {
	glow = "rbxasset://textures/glow.png",
	fire = "rbxasset://textures/particles/fire_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	sparks = "rbxasset://textures/particles/fire_sparks_main.dds",
}

local GRAVITY = 196.2
local MAX_DEBRIS = 60
-- A scorch is nine patches now (see scorch), so fewer are kept.
local MAX_SCORCH = 20
-- A splat is about 24 parts now (halo, blot, tongues, droplets, runs), so fewer are kept at once.
local MAX_SPLATS = 30

-- How each kind of blast looks, all sized from the blast radius.
--   balls     fireballs; scale, how big the whole thing is against the radius
--   light     the flash's PointLight range
--   smoke, sparks, embers   particle counts
--   debris    chunks thrown out; scorch, the mark left, its width as a share of the radius (0 for
--             none; never wider than SCORCH_WIDEST)
--   column    seconds of rising smoke after the fireball
local KIND = {
	rocket = { balls = 9, scale = 1.0, light = 70, smoke = 26, sparks = 44, embers = 24, debris = 10, scorch = 0.55, column = 1.4 },
	grenade = { balls = 6, scale = 0.85, light = 48, smoke = 16, sparks = 26, embers = 14, debris = 6, scorch = 0.45, column = 0.8 },
	frag = { balls = 8, scale = 1.0, light = 62, smoke = 22, sparks = 56, embers = 20, debris = 10, scorch = 0.5, column = 1.1 },
	impact = { balls = 2, scale = 0.35, light = 18, smoke = 5, sparks = 12, embers = 4, debris = 3, scorch = 0, column = 0 },
}

local FIRE_HOT = Color3.fromRGB(255, 240, 190)
local FIRE = Color3.fromRGB(255, 168, 56)
local FIRE_DEEP = Color3.fromRGB(255, 96, 24)
local FIRE_DONE = Color3.fromRGB(96, 30, 18)
local SMOKE_DARK = Color3.fromRGB(52, 48, 46)
-- There is no blood in this game: a splat is drawn in the RANK COLOUR of the gun that dealt the hit
-- (HitSplatService sends the rank, HitSplatClient turns it into Rarity.Color). This is only what a
-- caller that forgot to pass one gets -- Common's own grey, matching Rarity.Colors.Common -- and
-- forgetting is warned about rather than quietly coloured. The old red constants are deliberately
-- gone: an unreferenced red is a trap for the next caller.
local SPLAT_DEFAULT = Color3.fromRGB(178, 184, 196)
local warnedColourless = false
local SHIELD = Color3.fromRGB(120, 200, 255)

local function clamp01(t)
	return math.clamp(t, 0, 1)
end

local function easeOut(t)
	t = clamp01(t)
	return 1 - (1 - t) * (1 - t)
end

local function smooth(t)
	t = clamp01(t)
	return t * t * (3 - 2 * t)
end

local folder = nil
local function effects()
	if not folder or not folder.Parent then
		folder = Instance.new("Folder")
		folder.Name = "BRR_ExplosiveFx"
		folder.Parent = workspace
	end
	return folder
end
ExplosiveFx.Folder = effects

local function part(name, size, cframe, color, material, transparency, shape)
	local instance = Instance.new("Part")
	instance.Name = name
	if shape then
		instance.Shape = shape
	end
	instance.Size = size
	instance.CFrame = cframe
	instance.Color = color
	instance.Material = material or Enum.Material.SmoothPlastic
	instance.Transparency = transparency or 0
	instance.Anchored = true
	instance.CanCollide = false
	instance.CanQuery = false
	instance.CanTouch = false
	instance.CastShadow = false
	instance.TopSurface = Enum.SurfaceType.Smooth
	instance.BottomSurface = Enum.SurfaceType.Smooth
	instance.Parent = effects()
	return instance
end

local function emitter(parent, name, props)
	local particles = Instance.new("ParticleEmitter")
	particles.Name = name
	particles.Enabled = false
	particles.LightInfluence = 0
	particles.LockedToPart = false
	for property, value in pairs(props) do
		particles[property] = value
	end
	particles.Parent = parent
	return particles
end

-- A frame whose -Z is `normal`: parts built in it with their thin axis along Z lie on the surface.
local function surfaceFrame(position, normal)
	local up = math.abs(normal.Y) &lt; 0.99 and UP or Vector3.xAxis
	return CFrame.lookAt(position, position + normal, up)
end

-- A cylinder's length runs along its X. This puts X along the frame's -Z (the normal).
local ALONG_NORMAL = CFrame.Angles(0, math.pi / 2, 0)

--------------------------------------------------------------------------------
-- The loop
--------------------------------------------------------------------------------

-- Every live effect: { age, life, update(entry, age), destroy(entry) }.
local live = {}
local debris = {}

local function add(entry)
	entry.age = entry.age or 0
	table.insert(live, entry)
	if entry.update then
		entry.update(entry, entry.age)
	end
	return entry
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.IgnoreWater = true

local function refreshGround()
	local include = { workspace.Terrain }
	for _, name in ipairs({ "Map", "Defenses", "Deployables" }) do
		local instance = workspace:FindFirstChild(name)
		if instance then
			table.insert(include, instance)
		end
	end
	groundParams.FilterDescendantsInstances = include
end

local function stepDebris(dt)
	for index = #debris, 1, -1 do
		local chunk = debris[index]
		chunk.age += dt
		local part = chunk.part
		if chunk.age &gt;= chunk.life or not part.Parent then
			part:Destroy()
			table.remove(debris, index)
		else
			if not chunk.resting then
				chunk.velocity -= UP * (GRAVITY * dt)
				local displacement = chunk.velocity * dt
				local hit = displacement.Magnitude &gt; 1e-4 and workspace:Raycast(chunk.position, displacement + displacement.Unit * chunk.radius, groundParams) or nil
				if hit then
					local into = chunk.velocity:Dot(hit.Normal)
					chunk.position = hit.Position + hit.Normal * chunk.radius
					chunk.velocity = (chunk.velocity - hit.Normal * into) * 0.6 - hit.Normal * (into * 0.3)
					chunk.spin *= 0.5
					if chunk.velocity.Magnitude &lt; 3 and hit.Normal.Y &gt; 0.5 then
						chunk.resting = true
						chunk.velocity = Vector3.zero
					end
				else
					chunk.position += displacement
				end
				if chunk.spin.Magnitude &gt; 1e-4 then
					chunk.rotation = chunk.rotation * CFrame.fromAxisAngle(chunk.spin.Unit, chunk.spin.Magnitude * dt)
				end
			end
			part.CFrame = CFrame.new(chunk.position) * chunk.rotation
			local left = chunk.life - chunk.age
			if left &lt; 1 then
				part.Transparency = 1 - left
			end
		end
	end
end

function ExplosiveFx.Advance(dt)
	dt = math.min(dt, 0.1)
	if #debris &gt; 0 then
		refreshGround()
		stepDebris(dt)
	end
	for index = #live, 1, -1 do
		local entry = live[index]
		entry.age += dt
		if entry.age &gt;= entry.life or (entry.alive and not entry.alive(entry)) then
			entry.destroy(entry)
			table.remove(live, index)
		else
			entry.update(entry, entry.age)
		end
	end
end

RunService.RenderStepped:Connect(function(dt)
	if not ExplosiveFx.Paused then
		ExplosiveFx.Advance(dt)
	end
end)

local function destroyParts(entry)
	for _, instance in ipairs(entry.parts) do
		if instance.Parent then
			instance:Destroy()
		end
	end
end

--------------------------------------------------------------------------------
-- Particle hosts, one per blast kind (particles live on in the world once emitted)
--------------------------------------------------------------------------------

local hosts = {}

local function hostFor(kind)
	local host = hosts[kind]
	if host and host.part.Parent then
		return host
	end
	local holder = part("BRR_BlastHost", V(0.1, 0.1, 0.1), CFrame.identity, Color3.new(), nil, 1)
	local attachment = Instance.new("Attachment")
	attachment.Parent = holder
	host = { part = holder, attachment = attachment }
	host.sparks = emitter(attachment, "Sparks", {
		Texture = TEXTURE.sparks,
		LightEmission = 1,
		Color = CS(FIRE_HOT, FIRE_DEEP),
		Lifetime = NumberRange.new(0.35, 0.9),
		Speed = NumberRange.new(28, 70),
		SpreadAngle = Vector2.new(75, 75),
		Acceleration = V(0, -60, 0),
		Drag = 1.5,
		Size = NS({ NSK(0, 0.22), NSK(1, 0.05) }),
		Transparency = NS({ NSK(0, 0), NSK(0.7, 0.2), NSK(1, 1) }),
	})
	host.embers = emitter(attachment, "Embers", {
		Texture = TEXTURE.glow,
		LightEmission = 1,
		Color = CS(FIRE, FIRE_DEEP),
		Lifetime = NumberRange.new(0.8, 1.6),
		Speed = NumberRange.new(8, 24),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = V(0, -22, 0),
		Drag = 2.5,
		RotSpeed = NumberRange.new(-90, 90),
		Size = NS({ NSK(0, 0.5), NSK(1, 0.1) }),
		Transparency = NS({ NSK(0, 0.1), NSK(1, 1) }),
	})
	host.smoke = emitter(attachment, "Smoke", {
		Texture = TEXTURE.smoke,
		LightInfluence = 1,
		Color = CS(SMOKE_DARK, Color3.fromRGB(120, 116, 112)),
		Lifetime = NumberRange.new(1.4, 2.8),
		Speed = NumberRange.new(6, 18),
		SpreadAngle = Vector2.new(70, 70),
		Acceleration = V(0, 5, 0),
		Drag = 2,
		RotSpeed = NumberRange.new(-40, 40),
		Rotation = NumberRange.new(0, 360),
		Size = NS({ NSK(0, 2.5), NSK(0.4, 6), NSK(1, 10) }),
		Transparency = NS({ NSK(0, 0.35), NSK(0.6, 0.6), NSK(1, 1) }),
	})
	-- Tongues of flame licking out of the fireball cluster: big, short-lived, additive.
	host.flames = emitter(attachment, "Flames", {
		Texture = TEXTURE.fire,
		LightEmission = 1,
		Color = CS(FIRE_HOT, FIRE_DEEP),
		Lifetime = NumberRange.new(0.25, 0.5),
		Speed = NumberRange.new(6, 16),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = V(0, 12, 0),
		Drag = 3,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-60, 60),
		Size = NS({ NSK(0, 3), NSK(0.5, 5), NSK(1, 2) }),
		Transparency = NS({ NSK(0, 0.15), NSK(0.6, 0.4), NSK(1, 1) }),
	})
	host.dust = emitter(attachment, "Dust", {
		Texture = TEXTURE.smoke,
		LightInfluence = 1,
		Color = CS(Color3.fromRGB(150, 140, 126)),
		Lifetime = NumberRange.new(0.8, 1.6),
		Speed = NumberRange.new(20, 40),
		SpreadAngle = Vector2.new(10, 10),
		Drag = 4,
		Rotation = NumberRange.new(0, 360),
		Size = NS({ NSK(0, 1.5), NSK(1, 5) }),
		Transparency = NS({ NSK(0, 0.5), NSK(1, 1) }),
	})
	hosts[kind] = host
	return host
end

--------------------------------------------------------------------------------
-- Explosions
--------------------------------------------------------------------------------

-- Where the blast meets a surface, if it does: the point and normal its ground-bound marks (shock
-- ring, dust, scorch) are drawn on. The server's `normal` says what the round struck, and that can
-- be a body, a lamp post or a branch at chest height; a scorch drawn there stood in the air as a
-- black disc ("the explosions leave a giant black circle floating when they blow up off the
-- ground", Oliver, 2026-09-18). So the struck thing counts only if it is terrain or a solid part
-- wide enough to carry the mark; failing that, the ground straight below counts if it is within
-- reach of the blast; failing that it is an airburst and nothing is drawn on anything.
local surfaceParams = RaycastParams.new()
surfaceParams.FilterType = Enum.RaycastFilterType.Exclude
surfaceParams.IgnoreWater = true

-- true restores the old rule (any normal is a surface), so the gallery can show before and after.
ExplosiveFx.TrustNormal = false

local function carriesMark(instance, span)
	if instance:IsA("Terrain") then
		return true
	end
	if not instance:IsA("BasePart") or not instance.CanCollide then
		return false
	end
	local s = instance.Size
	local largest = math.max(s.X, s.Y, s.Z)
	local middle = s.X + s.Y + s.Z - largest - math.min(s.X, s.Y, s.Z)
	return largest &gt;= span and middle &gt;= span
end

local function castSurface(origin, direction, span)
	local filter = { effects() }
	for _ = 1, 4 do
		surfaceParams.FilterDescendantsInstances = filter
		local hit = workspace:Raycast(origin, direction, surfaceParams)
		if not hit then
			return nil
		end
		if carriesMark(hit.Instance, span) then
			return hit
		end
		table.insert(filter, hit.Instance)
	end
	return nil
end

local scorches = {}
local rng = Random.new()

-- A mark that lies on a surface stays with that surface: re-placed from the part's frame every
-- frame (a scorch on a truck drives off with it, on a lift it goes up with it) and gone the frame
-- the part is destroyed (a floor the blast itself broke can't leave its mark hanging in the air,
-- which would be Oliver's black circle from a different cause: "what about when it's on the second
-- story of a building and destroys the floor under it", 2026-09-18). Terrain is the world, static
-- and never destroyed, so marks on it need no rider. MarksFollow = false plants the old behaviour
-- for the probe's self-test.
ExplosiveFx.MarksFollow = true

local function rider(surface, instance)
	if not ExplosiveFx.MarksFollow or not surface or surface:IsA("Terrain") then
		return nil
	end
	return { part = surface, offset = surface.CFrame:ToObjectSpace(instance.CFrame) }
end

-- Keeps `instance` on its rider's part. False once the part is gone.
local function ride(r, instance)
	if not r then
		return true
	end
	local part = r.part
	if not part.Parent then
		return false
	end
	instance.CFrame = part.CFrame * r.offset
	return true
end

-- A scorch is a cluster of patches, a middle one and a ring round it, each cast onto the surface
-- itself and lying on whatever it found. One flat disc can only be right on a flat, lasting
-- surface: half of it hung in the air off the edge of a floor, and on the ground it was a lid
-- over the crater the same blast dug a moment later (#29, #70). A patch that finds nothing under it
-- isn't drawn. The crater comes from the server after the effect has started, so patches on the
-- ground are laid again a few times over the first seconds and follow the ground down into the
-- hole. Patches on a part ride it and go with it when it breaks.
local SCORCH_WIDEST = 7 -- studs across at most: the old 14-stud rocket mark read as a black pool
local SCORCH_RING = 8
local SCORCH_SHADE = 0.12
local SCORCH_RELAY = { 0.3, 1, 2.5, 5 }
-- How far below the mark's plane a patch may land: on the ground, a crater's depth (DestructibleService
-- digs at most 4.5); on a part, a bevel or a step, never the storey below.
local SCORCH_SINK, SCORCH_LIP = 5, 0.6
ExplosiveFx.ScorchWidest = SCORCH_WIDEST

local function layPatch(patch, centre, normal, flat)
	local mark = patch.mark
	if flat then
		mark.CFrame = surfaceFrame(centre + patch.offset + normal * 0.04, normal) * ALONG_NORMAL
		mark.Transparency = SCORCH_SHADE
		patch.laid = true
		return
	end
	local reach = patch.ground and SCORCH_SINK or SCORCH_LIP
	local hit = castSurface(centre + patch.offset + normal, -normal * (1 + reach), patch.size * 0.5)
	if not hit then
		mark.Transparency = 1
		patch.laid, patch.rides = false, nil
		return
	end
	mark.CFrame = surfaceFrame(hit.Position + hit.Normal * 0.04, hit.Normal) * ALONG_NORMAL
	mark.Transparency = SCORCH_SHADE
	patch.laid = true
	patch.rides = rider(hit.Instance, mark)
end

local function scorch(position, normal, diameter, surface)
	diameter = math.min(diameter, SCORCH_WIDEST)
	local frame = surfaceFrame(position, normal)
	-- No surface part: the gallery's TrustNormal "before", drawn flat where it was told.
	local flat = surface == nil
	local ground = surface ~= nil and surface:IsA("Terrain")
	local patches = {}
	local function patchAt(name, offset, size)
		local mark = part(name, V(0.06, size, size), frame * ALONG_NORMAL, Color3.fromRGB(26, 24, 22), Enum.Material.Slate, SCORCH_SHADE, Enum.PartType.Cylinder)
		local patch = { mark = mark, offset = offset, size = size, ground = ground }
		layPatch(patch, position, normal, flat)
		table.insert(patches, patch)
	end
	patchAt("Scorch", Vector3.zero, diameter * 0.42)
	local turn = rng:NextNumber(0, math.pi * 2)
	for index = 1, SCORCH_RING do
		local angle = turn + index / SCORCH_RING * math.pi * 2
		local out = diameter * 0.3 * rng:NextNumber(0.85, 1.1)
		local offset = frame.RightVector * (math.cos(angle) * out) + frame.UpVector * (math.sin(angle) * out)
		patchAt("ScorchEdge", offset, diameter * 0.32 * rng:NextNumber(0.85, 1.15))
	end

	local parts = {}
	for _, patch in ipairs(patches) do
		table.insert(parts, patch.mark)
	end
	local mark = { parts = parts }
	table.insert(scorches, mark)
	if #scorches &gt; MAX_SCORCH then
		destroyParts(table.remove(scorches, 1))
	end
	local relays = 1
	add({
		life = 28,
		parts = parts,
		update = function(entry, age)
			local relay = ExplosiveFx.MarksFollow and not flat and SCORCH_RELAY[relays] ~= nil and age &gt;= SCORCH_RELAY[relays]
			if relay then
				relays += 1
			end
			local left = 0
			for _, patch in ipairs(patches) do
				local piece = patch.mark
				if piece.Parent then
					if patch.rides and not ride(patch.rides, piece) then
						-- Its part broke. On a floor it goes with it; on the ground (rubble it
						-- lay on) it waits for the next lay.
						patch.rides, patch.laid = nil, false
						if patch.ground then
							piece.Transparency = 1
						else
							piece:Destroy()
						end
					end
					if relay and patch.ground and piece.Parent then
						layPatch(patch, position, normal, false)
					end
				end
				if piece.Parent then
					left += 1
					if patch.laid and age &gt; 25 then
						piece.Transparency = SCORCH_SHADE + (age - 25) / 3 * (1 - SCORCH_SHADE)
					end
				end
			end
			if left == 0 then
				entry.life = 0
			end
		end,
		destroy = destroyParts,
	})
end

local function throwDebris(position, normal, count, speed, size, color, material)
	for _ = 1, count do
		if #debris &gt;= MAX_DEBRIS then
			local oldest = table.remove(debris, 1)
			oldest.part:Destroy()
		end
		local chunk = part("Debris", V(size * rng:NextNumber(0.6, 1.4), size * rng:NextNumber(0.4, 1), size * rng:NextNumber(0.6, 1.4)),
			CFrame.new(position), color, material)
		local direction = (V(rng:NextNumber(-1, 1), rng:NextNumber(0.2, 1), rng:NextNumber(-1, 1)).Unit + normal * 0.8).Unit
		table.insert(debris, {
			part = chunk,
			position = position + normal * 0.3,
			velocity = direction * speed * rng:NextNumber(0.5, 1.1),
			spin = V(rng:NextNumber(-12, 12), rng:NextNumber(-12, 12), rng:NextNumber(-12, 12)),
			rotation = CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)),
			radius = size * 0.5,
			age = 0,
			life = rng:NextNumber(2.5, 4),
		})
	end
end

-- Returns the surface point, its normal and the part it belongs to (nil for none).
local function findSurface(position, normal, r)
	if ExplosiveFx.TrustNormal then
		if normal then
			return position, normal, nil
		end
		return nil, nil, nil
	end
	local span = r * 0.4
	if normal then
		local hit = castSurface(position + normal * 0.5, -normal * 2.5, span)
		if hit then
			return hit.Position, hit.Normal, hit.Instance
		end
	end
	local hit = castSurface(position + UP * 0.5, -UP * (r * 0.6 + 0.5), span)
	if hit then
		return hit.Position, hit.Normal, hit.Instance
	end
	return nil, nil, nil
end

-- The blast: a white flash and its light, a cluster of fireballs that swell, rise and darken to
-- smoke, a shock ring on the surface it hit, dust rolling out along it, sparks, embers, chunks of
-- ground, a column of smoke rising after, and a scorch left behind. The fireballs, flash, shell and
-- particles are at `position`; the ring, dust and scorch lie on the surface findSurface chose.
function ExplosiveFx.Explosion(position, normal, kind, radius)
	local spec = KIND[kind] or KIND.rocket
	local r = math.max(3, (radius or 12) * spec.scale)
	local ground, groundNormal, surfacePart = findSurface(position, normal, r)
	local onSurface = ground ~= nil
	local up = groundNormal or normal or UP
	ground = ground or position
	local parts = {}

	local flash = part("Flash", V(1, 1, 1), CFrame.new(position + up * 0.5), FIRE_HOT, Enum.Material.Neon, 0, Enum.PartType.Ball)
	local light = Instance.new("PointLight")
	light.Color = FIRE
	light.Range = spec.light
	light.Brightness = 8
	light.Shadows = false
	light.Parent = flash
	table.insert(parts, flash)

	-- Fireballs: a few glowing (neon) cores inside a shell of lit, matte balls. Each runs the same
	-- colour ramp (white-hot, orange, deep red, smoke) but starts at its own point on it, so at any
	-- moment the cluster is a mix of bright and dark rather than one flat yellow dome. The outer ones
	-- are partly see-through, which lets the cores glow through them.
	local balls = {}
	for index = 1, spec.balls do
		local core = index &lt;= math.max(2, math.floor(spec.balls * 0.35))
		local offset = V(rng:NextNumber(-1, 1), rng:NextNumber(-0.5, 1), rng:NextNumber(-1, 1)) * (r * (core and 0.12 or 0.26)) + up * (r * 0.12)
		local ball = part("Fireball", V(0.5, 0.5, 0.5), CFrame.new(position + offset), FIRE, core and Enum.Material.Neon or Enum.Material.SmoothPlastic, core and 0 or 0.22, Enum.PartType.Ball)
		table.insert(parts, ball)
		table.insert(balls, {
			part = ball,
			core = core,
			offset = offset,
			final = r * (core and rng:NextNumber(0.45, 0.65) or rng:NextNumber(0.5, 0.85)),
			delay = core and 0 or rng:NextNumber(0.02, 0.1),
			phase = core and rng:NextNumber(0, 0.06) or rng:NextNumber(0.08, 0.3),
			rise = r * rng:NextNumber(0.15, 0.4),
			drift = V(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)) * (r * 0.1),
		})
	end

	-- The shockwave: a translucent shell racing out to three radii, and on a surface a hollow ring of
	-- pressure sweeping across it ahead of the dust. Plain plastic, not Glass: Roblox draws nothing
	-- see-through behind a transparent Glass part (the fireballs, every particle, the smoke), so a
	-- glass shell hid the whole first half-second of the explosion behind a blank dome.
	local wave = part("Shockwave", V(1, 1, 1), CFrame.new(position + up * 0.3), Color3.fromRGB(255, 244, 228), Enum.Material.SmoothPlastic, 0.62, Enum.PartType.Ball)
	table.insert(parts, wave)
	local ring, dust
	if onSurface then
		ring = Instance.new("CylinderHandleAdornment")
		ring.Name = "ShockRing"
		ring.Adornee = workspace.Terrain
		ring.CFrame = surfaceFrame(ground + up * 0.2, up)
		ring.Height = 0.35
		ring.Radius = 0.5
		ring.InnerRadius = 0
		ring.Color3 = FIRE_HOT
		ring.Transparency = 0.15
		ring.AlwaysOnTop = false
		ring.ZIndex = 1
		ring.Parent = workspace.Terrain
		dust = part("DustRing", V(0.9, 1, 1), surfaceFrame(ground + up * 0.5, up) * ALONG_NORMAL, Color3.fromRGB(140, 132, 120), Enum.Material.SmoothPlastic, 0.45, Enum.PartType.Cylinder)
		table.insert(parts, ring)
		table.insert(parts, dust)
	end
	local ringRider = ring and rider(surfacePart, ring) or nil
	local dustRider = dust and rider(surfacePart, dust) or nil

	-- Particles from the shared host, pointed along the normal.
	local host = hostFor(kind)
	host.part.CFrame = surfaceFrame(position + up * 0.3, up) * CFrame.Angles(-math.pi / 2, 0, 0)
	host.sparks:Emit(spec.sparks)
	host.embers:Emit(spec.embers)
	host.smoke:Emit(spec.smoke)
	host.flames.Size = NS({ NSK(0, r * 0.25), NSK(0.5, r * 0.4), NSK(1, r * 0.18) })
	host.flames:Emit(math.floor(spec.balls * 1.5))
	if onSurface then
		host.dust:Emit(math.floor(spec.smoke * 0.6))
	end

	-- The column: its own emitter, since it stays lit for a while.
	if spec.column &gt; 0 then
		local column = part("SmokeColumn", V(0.1, 0.1, 0.1), CFrame.new(position + up * (r * 0.3)), Color3.new(), nil, 1)
		local attachment = Instance.new("Attachment")
		attachment.Parent = column
		local plume = emitter(attachment, "Plume", {
			Texture = TEXTURE.smoke,
			LightInfluence = 1,
			Color = CS(SMOKE_DARK, Color3.fromRGB(110, 106, 102)),
			Lifetime = NumberRange.new(2.5, 4),
			Speed = NumberRange.new(6, 12),
			SpreadAngle = Vector2.new(25, 25),
			Acceleration = V(0, 4, 0),
			Drag = 1.2,
			Rotation = NumberRange.new(0, 360),
			RotSpeed = NumberRange.new(-20, 20),
			Rate = 22,
			Size = NS({ NSK(0, r * 0.25), NSK(1, r * 0.7) }),
			Transparency = NS({ NSK(0, 0.4), NSK(0.7, 0.7), NSK(1, 1) }),
			Enabled = true,
		})
		table.insert(parts, column)
		add({
			life = spec.column + 5,
			parts = { column },
			update = function(_, age)
				if age &gt;= spec.column and plume.Enabled then
					plume.Enabled = false
				end
			end,
			destroy = destroyParts,
		})
	end

	if spec.debris &gt; 0 then
		throwDebris(position, up, spec.debris, r * 3, math.clamp(r * 0.06, 0.25, 0.7), Color3.fromRGB(70, 62, 56), Enum.Material.Slate)
	end
	if onSurface and spec.scorch &gt; 0 then
		scorch(ground, up, r * spec.scorch, surfacePart)
	end

	add({
		life = 1.3,
		parts = parts,
		update = function(_, age)
			-- Flash: out to the radius in a blink, gone in a sixth of a second.
			local ft = age / 0.16
			if ft &lt; 1 then
				local size = 1 + (r * 1.2 - 1) * easeOut(ft * 1.4)
				flash.Size = V(size, size, size)
				flash.Transparency = ft ^ 0.7
				light.Brightness = 8 * (1 - ft)
			elseif flash.Parent then
				flash:Destroy()
			end
			-- Fireballs: swell fast, rise, darken from white-orange through red to smoke, fade. `phase`
			-- puts each ball at its own point on that ramp.
			for _, ball in ipairs(balls) do
				local a = clamp01((age - ball.delay) / 0.75)
				local size = ball.final * easeOut(math.min(a * 2.2, 1))
				ball.part.Size = V(size, size, size)
				ball.part.CFrame = CFrame.new(position + ball.offset + up * (ball.rise * a) + ball.drift * a)
				local c = clamp01(a + ball.phase)
				if c &lt; 0.18 then
					ball.part.Color = FIRE_HOT:Lerp(FIRE, c / 0.18)
				elseif c &lt; 0.5 then
					ball.part.Color = FIRE:Lerp(FIRE_DEEP, (c - 0.18) / 0.32)
				else
					ball.part.Color = FIRE_DEEP:Lerp(FIRE_DONE, (c - 0.5) / 0.5)
					if ball.core and ball.part.Material ~= Enum.Material.SmoothPlastic and c &gt; 0.62 then
						ball.part.Material = Enum.Material.SmoothPlastic
					end
				end
				local base = ball.core and 0 or 0.22
				ball.part.Transparency = a &lt; 0.3 and base or base + (1 - base) * smooth((a - 0.3) / 0.7)
			end
			-- The shockwave shell: out to three radii in four tenths of a second, thinning as it goes.
			local w = age / 0.42
			if w &lt; 1 then
				local size = 1 + (r * 3.2 - 1) * easeOut(w)
				wave.Size = V(size, size, size)
				wave.Transparency = 0.62 + 0.38 * w * w
			elseif wave.Parent then
				wave:Destroy()
			end
			if ring then
				-- Both stay on their surface; if it goes (the blast broke the floor) they go with it.
				if not (ride(ringRider, ring) and ride(dustRider, dust)) then
					if ring.Parent then
						ring:Destroy()
					end
					if dust.Parent then
						dust:Destroy()
					end
				else
					-- The ring: a band that races out across the ground, its leading edge at the wave.
					local t = age / 0.4
					if t &lt; 1 then
						local radius = 0.5 + (r * 3 - 0.5) * easeOut(t)
						local band = math.max(0.3, r * 0.22 * (1 - t))
						ring.Radius = radius
						ring.InnerRadius = math.max(0, radius - band)
						ring.Transparency = 0.15 + 0.85 * t * t
					elseif ring.Parent then
						ring:Destroy()
					end
					local d = age / 1.1
					if d &lt; 1 then
						local size = 1 + (r * 2.2 - 1) * easeOut(d)
						dust.Size = V(0.9 + d * 1.5, size, size)
						dust.Transparency = 0.45 + 0.55 * d * d
					elseif dust.Parent then
						dust:Destroy()
					end
				end
			end
		end,
		destroy = destroyParts,
	})
end

-- A round with no blast landing: a small flash, sparks and a puff.
function ExplosiveFx.Impact(position, normal)
	ExplosiveFx.Explosion(position, normal, "impact", 4)
end

--------------------------------------------------------------------------------
-- Smoke clouds
--------------------------------------------------------------------------------

local CLOUD_LUMPS = 12
local CLOUD_SHELL = 10

-- A cloud `elapsed` seconds into its life (the server's timeline; the hiss has already happened
-- when elapsed is 0). Returns the handle, with .position, .radius and .density kept up to date.
function ExplosiveFx.Cloud(position, spec, elapsed)
	local seed = Random.new()
	local cloud = { position = position, spec = spec, radius = 0, density = 0, elapsed = elapsed or 0 }
	local parts = {}
	local lumps = {}
	-- Matte and warm-grey, lit from above: the lumps near the top are pale, the underside is dark, the
	-- way a cumulus shades. Fabric has no specular highlight, so nothing reads as a glossy ball.
	local base = Color3.fromRGB(158, 155, 150)

	local function lump(kind, direction, distance, diameter, transparency, tint)
		local shade = 0.5 + 0.5 * math.clamp(direction.Y, -1, 1)
		local color = base:Lerp(tint, seed:NextNumber(0, 0.35)):Lerp(Color3.fromRGB(226, 224, 220), shade * 0.55):Lerp(Color3.fromRGB(96, 94, 92), (1 - shade) * 0.45)
		local ball = part(kind, V(0.2, 0.2, 0.2), CFrame.new(position), color, Enum.Material.Fabric, transparency, Enum.PartType.Ball)
		table.insert(parts, ball)
		table.insert(lumps, {
			part = ball,
			direction = direction,
			distance = distance,
			diameter = diameter,
			baseTransparency = transparency,
			phase = seed:NextNumber(0, 6.28),
			bob = seed:NextNumber(0.2, 0.5),
			spin = seed:NextNumber(-0.06, 0.06),
		})
	end

	-- The core: one big opaque ball, the occluder everything else dresses.
	lump("SmokeCore", V(0, 0.2, 0), 0, 1.5, 0, base)
	-- Opaque lumps bulging out of it, spread evenly over the sphere (golden spiral), squashed
	-- toward the top so the cloud is wider than it is tall.
	local golden = math.pi * (3 - math.sqrt(5))
	for index = 0, CLOUD_LUMPS - 1 do
		local y = 1 - (index + 0.5) / CLOUD_LUMPS * 1.6
		local ring = math.sqrt(math.max(0, 1 - y * y))
		local angle = index * golden + seed:NextNumber(-0.2, 0.2)
		local direction = V(math.cos(angle) * ring, y * 0.75, math.sin(angle) * ring).Unit
		lump("SmokeLump", direction, seed:NextNumber(0.48, 0.6), seed:NextNumber(0.7, 0.95), 0, Color3.fromRGB(150, 148, 146))
	end
	-- The shell: smaller, nearly opaque knobs a little further out, so the outline is cauliflower
	-- rather than three big balls. (A see-through shell read as soap bubbles.)
	for index = 0, CLOUD_SHELL - 1 do
		local y = 1 - (index + 0.5) / CLOUD_SHELL * 1.7
		local ring = math.sqrt(math.max(0, 1 - y * y))
		local angle = index * golden * 1.3 + 1.1 + seed:NextNumber(-0.3, 0.3)
		local direction = V(math.cos(angle) * ring, y * 0.7, math.sin(angle) * ring).Unit
		lump("SmokeShell", direction, seed:NextNumber(0.62, 0.78), seed:NextNumber(0.4, 0.62), seed:NextNumber(0.08, 0.2), Color3.fromRGB(190, 188, 184))
	end

	-- Wisps drifting off the surface.
	local wispHost = part("SmokeWisps", V(0.1, 0.1, 0.1), CFrame.new(position), Color3.new(), nil, 1)
	local wispAttachment = Instance.new("Attachment")
	wispAttachment.Parent = wispHost
	local wisps = emitter(wispAttachment, "Wisps", {
		Texture = TEXTURE.smoke,
		LightInfluence = 1,
		Color = CS(Color3.fromRGB(176, 174, 170)),
		Lifetime = NumberRange.new(2.5, 4.5),
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 1,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-15, 15),
		Rate = 22,
		Size = NS({ NSK(0, spec.smokeRadius * 0.35), NSK(1, spec.smokeRadius * 0.8) }),
		Transparency = NS({ NSK(0, 0.45), NSK(0.7, 0.7), NSK(1, 1) }),
		Enabled = true,
	})
	table.insert(parts, wispHost)

	local timeline = { position = position, startedAt = 0, spec = spec }
	table.insert(ExplosiveFx.Clouds, cloud)

	add({
		life = math.huge,
		parts = parts,
		alive = function()
			return cloud.elapsed &lt; spec.grow + spec.hold + spec.fade
		end,
		update = function(entry, age)
			cloud.elapsed = (elapsed or 0) + age
			local now = cloud.elapsed
			local radius = Ballistics.SmokeRadius(timeline, now)
			local density = Ballistics.SmokeDensity(timeline, now)
			cloud.radius = radius
			cloud.density = density
			-- The visible ball grows in from nothing over the first moments of the pour.
			local grown = smooth(now / (spec.grow * 0.5)) * radius
			for _, entry in ipairs(lumps) do
				local direction = entry.direction
				if entry.distance &gt; 0 then
					local turn = now * entry.spin + entry.phase
					direction = V(
						direction.X * math.cos(turn) - direction.Z * math.sin(turn),
						direction.Y + math.sin(now * 0.6 + entry.phase) * 0.06,
						direction.X * math.sin(turn) + direction.Z * math.cos(turn)
					)
				end
				local breathe = 1 + math.sin(now * 0.7 + entry.phase) * 0.035
				local size = grown * entry.diameter * breathe
				entry.part.Size = V(size, size, size)
				entry.part.CFrame = CFrame.new(position + direction * (grown * entry.distance) + UP * (math.sin(now * 0.5 + entry.phase) * entry.bob))
				-- Opaque while dense; thinning out with the cloud.
				entry.part.Transparency = entry.baseTransparency + (1 - entry.baseTransparency) * clamp01(1 - density * 1.25)
			end
			wispHost.CFrame = CFrame.new(position + UP * (grown * 0.2))
			wisps.Rate = 22 * density
			wisps.Enabled = density &gt; 0.2
		end,
		destroy = function(entry)
			destroyParts(entry)
			for index, other in ipairs(ExplosiveFx.Clouds) do
				if other == cloud then
					table.remove(ExplosiveFx.Clouds, index)
					break
				end
			end
		end,
	})
	return cloud
end

--------------------------------------------------------------------------------
-- Hit splats
--------------------------------------------------------------------------------

local splats = {}
local splatHost = nil

-- What flies off a hit: fine droplets streaking out along their flight and pulled down hard, a few
-- heavy globs that arc and fall, and a short dark puff of mist at the wound. A shield hit throws
-- bright chips of light instead. One shared host, moved to each hit and told to emit.
local function splatParticles(position, normal, color, count, shield)
	if not splatHost or not splatHost.part.Parent then
		local holder = part("BRR_SplatHost", V(0.1, 0.1, 0.1), CFrame.identity, Color3.new(), nil, 1)
		local attachment = Instance.new("Attachment")
		attachment.Parent = holder
		splatHost = {
			part = holder,
			drops = emitter(attachment, "Drops", {
				Texture = TEXTURE.glow,
				LightEmission = 0,
				LightInfluence = 1,
				Color = CS(SPLAT_DEFAULT),
				Lifetime = NumberRange.new(0.3, 0.6),
				Speed = NumberRange.new(6, 14),
				SpreadAngle = Vector2.new(50, 50),
				Acceleration = V(0, -60, 0),
				Drag = 1,
				Orientation = Enum.ParticleOrientation.VelocityParallel,
				Size = NS({ NSK(0, 0.14), NSK(1, 0.04) }),
				Transparency = NS({ NSK(0, 0.05), NSK(0.7, 0.2), NSK(1, 1) }),
			}),
			globs = emitter(attachment, "Globs", {
				Texture = TEXTURE.glow,
				LightEmission = 0,
				LightInfluence = 1,
				Color = CS(SPLAT_DEFAULT),
				Lifetime = NumberRange.new(0.45, 0.8),
				Speed = NumberRange.new(3, 7),
				SpreadAngle = Vector2.new(40, 40),
				Acceleration = V(0, -50, 0),
				Drag = 0.5,
				Size = NS({ NSK(0, 0.26), NSK(1, 0.1) }),
				Transparency = NS({ NSK(0, 0), NSK(0.8, 0.1), NSK(1, 1) }),
			}),
			mist = emitter(attachment, "Mist", {
				Texture = TEXTURE.smoke,
				LightEmission = 0,
				LightInfluence = 1,
				Color = CS(SPLAT_DEFAULT),
				Lifetime = NumberRange.new(0.2, 0.4),
				Speed = NumberRange.new(1.5, 4),
				SpreadAngle = Vector2.new(70, 70),
				Acceleration = V(0, -6, 0),
				Drag = 3,
				Rotation = NumberRange.new(0, 360),
				RotSpeed = NumberRange.new(-60, 60),
				Size = NS({ NSK(0, 0.5), NSK(1, 1.3) }),
				Transparency = NS({ NSK(0, 0.45), NSK(1, 1) }),
			}),
			sparks = emitter(attachment, "Sparks", {
				Texture = TEXTURE.sparks,
				LightEmission = 1,
				LightInfluence = 0,
				Color = CS(SHIELD),
				Lifetime = NumberRange.new(0.2, 0.4),
				Speed = NumberRange.new(8, 18),
				SpreadAngle = Vector2.new(45, 45),
				Acceleration = V(0, -30, 0),
				Drag = 2,
				Orientation = Enum.ParticleOrientation.VelocityParallel,
				Size = NS({ NSK(0, 0.22), NSK(1, 0.04) }),
				Transparency = NS({ NSK(0, 0), NSK(1, 1) }),
			}),
		}
	end
	splatHost.part.CFrame = surfaceFrame(position + normal * 0.05, normal) * CFrame.Angles(-math.pi / 2, 0, 0)
	if shield then
		splatHost.sparks:Emit(count * 3)
		return
	end
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	splatHost.drops.Color = CS(color)
	splatHost.globs.Color = CS(dark)
	splatHost.mist.Color = CS(dark)
	splatHost.drops:Emit(count)
	splatHost.globs:Emit(math.max(2, math.floor(count * 0.4)))
	splatHost.mist:Emit(math.max(3, math.floor(count * 0.6)))
end

-- Blood where a bullet landed on `limb`, at `position` on its surface: a dark red star (a central
-- disc, droplets round it, a drip or two running down) that stays put on the limb as it moves, holds
-- a moment and fades. A headshot's is bigger. A hit the shield soaked is blue chips flying off the
-- body instead.
function ExplosiveFx.Splat(limb, position, normal, options)
	options = options or {}
	if #splats &gt;= MAX_SPLATS then
		local oldest = table.remove(splats, 1)
		oldest.life = 0
	end
	local scale = options.headshot and 1.55 or 1
	local frame = surfaceFrame(position + normal * 0.02, normal)
	local parts = {}
	local seed = Random.new()
	-- The blood's colour: the rank of the gun that dealt the hit (options.color), else plain red.
	if not options.color and not options.shield and not warnedColourless then
		warnedColourless = true
		warn("[ExplosiveFx] a splat was drawn with no rank colour: every caller must pass options.color (the firing gun's Rarity.Color). Drawn in Common grey.")
	end
	local blood = options.color or SPLAT_DEFAULT
	local dark = (options.color or SPLAT_DEFAULT):Lerp(Color3.new(0, 0, 0), 0.35)

	if options.shield then
		-- Chips: thin light-blue discs bursting outward along the surface, fading fast.
		local chips = {}
		for index = 1, 4 do
			local angle = index / 4 * math.pi * 2 + seed:NextNumber(-0.4, 0.4)
			local chip = part("ShieldChip", V(0.04, 0.16, 0.16), frame * ALONG_NORMAL, SHIELD, Enum.Material.Neon, 0.1, Enum.PartType.Cylinder)
			table.insert(parts, chip)
			table.insert(chips, { part = chip, direction = V(math.cos(angle), math.sin(angle), 0), speed = seed:NextNumber(3, 5) })
		end
		splatParticles(position, normal, SHIELD, 5, true)
		-- Taken once, so the chips ride the limb as it moves (worked out each frame it was just `frame`).
		local offset = limb.CFrame:ToObjectSpace(frame)
		local entry = add({
			life = 0.4,
			parts = parts,
			update = function(_, age)
				if not limb.Parent then
					return
				end
				local live = limb.CFrame * offset
				for _, chip in ipairs(chips) do
					chip.part.CFrame = live * CFrame.new(chip.direction * (chip.speed * age)) * ALONG_NORMAL
					chip.part.Transparency = 0.1 + 0.9 * (age / 0.4) ^ 1.5
				end
			end,
			alive = function()
				return limb.Parent ~= nil
			end,
			destroy = destroyParts,
		})
		table.insert(splats, entry)
		return entry
	end

	-- The mark: a soft dark halo, a centre made of three overlapping discs (an irregular blot, not a
	-- coin), two splash tongues thrown out from it with a bead at each end, a scatter of droplets
	-- thinning out with distance, and a run or two down the surface ending in a bead. Glossy, since
	-- fresh blood shines. (Oliver, 2026-09-18: "improve the blood splat and add particles too".)
	local pieces = {}
	local function keep(piece, base)
		table.insert(parts, piece)
		table.insert(pieces, { part = piece, offset = limb.CFrame:ToObjectSpace(piece.CFrame), size = piece.Size, base = base or 0 })
	end
	local function disc(diameter, offset, color, lift, transparency)
		local piece = part("Splat", V(0.03, diameter, diameter), frame * CFrame.new(offset + V(0, 0, -(lift or 0))) * ALONG_NORMAL, color, Enum.Material.SmoothPlastic, transparency or 0, Enum.PartType.Cylinder)
		piece.Reflectance = transparency and 0 or 0.18
		keep(piece, transparency)
	end
	-- A strip along the surface from the centre out along `direction` (in the surface frame's plane).
	local function streak(direction, length, width, color, lift)
		local across = V(-direction.Y, direction.X, 0)
		local piece = part("Splat", V(width, length, 0.03), frame * CFrame.new(direction * (length / 2) + V(0, 0, -(lift or 0))) * CFrame.fromMatrix(Vector3.zero, across, direction, across:Cross(direction)), color)
		piece.Reflectance = 0.18
		keep(piece)
	end
	local downOnSurface = frame:VectorToObjectSpace(-UP)
	downOnSurface = V(downOnSurface.X, downOnSurface.Y, 0)
	local hasDown = downOnSurface.Magnitude &gt; 0.2
	if hasDown then
		downOnSurface = downOnSurface.Unit
	end

	disc(0.46 * scale, Vector3.zero, dark, -0.002, 0.55)
	disc(0.3 * scale, Vector3.zero, blood)
	disc(0.22 * scale, V(seed:NextNumber(-0.09, 0.09), seed:NextNumber(-0.09, 0.09), 0) * scale, blood, 0.004)
	disc(0.17 * scale, V(seed:NextNumber(-0.12, 0.12), seed:NextNumber(-0.12, 0.12), 0) * scale, dark, 0.008)
	-- Tongues: two, roughly opposite, both leaning the way gravity runs across the surface.
	local first = seed:NextNumber(0, math.pi * 2)
	for index = 1, 2 do
		local angle = first + (index - 1) * math.pi + seed:NextNumber(-0.5, 0.5)
		local direction = V(math.cos(angle), math.sin(angle), 0)
		if hasDown then
			direction = (direction + downOnSurface * 0.35).Unit
		end
		local length = seed:NextNumber(0.22, 0.4) * scale
		streak(direction, length, 0.07 * scale, index == 1 and blood or dark, 0.003 * index)
		disc(0.1 * scale, direction * length, blood, 0.005 * index)
	end
	local drops = options.headshot and 14 or 10
	for index = 1, drops do
		local angle = index / drops * math.pi * 2 + seed:NextNumber(-0.6, 0.6)
		local distance = seed:NextNumber(0.16, 0.5) * scale
		local diameter = (0.035 + 0.08 * (1 - (distance / (0.5 * scale)))) * scale * seed:NextNumber(0.7, 1.2)
		disc(diameter, V(math.cos(angle) * distance, math.sin(angle) * distance, 0), index % 3 == 0 and dark or blood, 0.002 * (index % 3))
	end
	-- Runs: down the way gravity points across this surface, tapering, with a bead at the end.
	if hasDown then
		local across = V(-downOnSurface.Y, downOnSurface.X, 0)
		local runs = options.headshot and 3 or 2
		for index = 1, runs do
			local length = seed:NextNumber(0.24, 0.46) * scale
			local side = (index - (runs + 1) / 2) * 0.11 * scale + seed:NextNumber(-0.03, 0.03)
			local along = downOnSurface * (length / 2 + 0.08 * scale) + across * side
			-- A frame whose Y runs down the surface (X across it, Z the surface normal, right-handed).
			local drip = part("Drip", V(0.045 * scale, length, 0.03), frame * CFrame.new(along) * CFrame.fromMatrix(Vector3.zero, across, downOnSurface, across:Cross(downOnSurface)), dark)
			drip.Reflectance = 0.18
			table.insert(parts, drip)
			table.insert(pieces, { part = drip, offset = limb.CFrame:ToObjectSpace(drip.CFrame), size = drip.Size, drip = true, base = 0 })
			disc(0.07 * scale, along + downOnSurface * (length / 2), dark, 0.003)
		end
	end
	splatParticles(position, normal, blood, options.headshot and 16 or 10)

	-- Four seconds on the body (Oliver, 2026-09-18: 1.2 s was short enough to miss in play); the
	-- MAX_SPLATS cap is what keeps a dummy under sustained fire from piling up.
	local hold, fade = 3.0, 1.0
	local entry = add({
		life = hold + fade,
		parts = parts,
		update = function(_, age)
			if not limb.Parent then
				return
			end
			local fading = clamp01((age - hold) / fade)
			for _, piece in ipairs(pieces) do
				piece.part.CFrame = limb.CFrame * piece.offset
				piece.part.Transparency = piece.base + (1 - piece.base) * fading * fading
				if piece.drip and age &lt; 0.35 then
					-- The drip runs: it grows downward over its first third of a second.
					local grow = 0.4 + 0.6 * (age / 0.35)
					piece.part.Size = V(piece.size.X, piece.size.Y * grow, piece.size.Z)
				end
			end
		end,
		alive = function()
			return limb.Parent ~= nil
		end,
		destroy = destroyParts,
	})
	table.insert(splats, entry)
	return entry
end

--------------------------------------------------------------------------------
-- Rounds in flight
--------------------------------------------------------------------------------

-- A rocket's exhaust: the sustainer flame out of the back, a smoke trail, and its glow.
function ExplosiveFx.Trail(holder, tail)
	local attachment = Instance.new("Attachment")
	attachment.Position = tail or V(0, 0, 0.9)
	attachment.Parent = holder
	emitter(attachment, "Flame", {
		Texture = TEXTURE.fire,
		LightEmission = 1,
		Color = CS(FIRE_HOT, FIRE_DEEP),
		Lifetime = NumberRange.new(0.06, 0.12),
		Speed = NumberRange.new(4, 8),
		SpreadAngle = Vector2.new(12, 12),
		Rate = 90,
		Size = NS({ NSK(0, 0.55), NSK(1, 0.15) }),
		Transparency = NS({ NSK(0, 0), NSK(1, 1) }),
		Enabled = true,
	})
	emitter(attachment, "Trail", {
		Texture = TEXTURE.smoke,
		LightInfluence = 1,
		Color = CS(Color3.fromRGB(215, 215, 215), Color3.fromRGB(170, 170, 170)),
		Lifetime = NumberRange.new(0.9, 1.6),
		Speed = NumberRange.new(0.5, 1.5),
		Drag = 2,
		Rate = 70,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-30, 30),
		Size = NS({ NSK(0, 0.35), NSK(1, 1.8) }),
		Transparency = NS({ NSK(0, 0.45), NSK(1, 1) }),
		Enabled = true,
	})
	local light = Instance.new("PointLight")
	light.Color = FIRE
	light.Range = 14
	light.Brightness = 2.5
	light.Shadows = false
	light.Parent = holder
	return attachment
end

-- A looping cue (its first layer) following `holder`, through the category's volume group.
function ExplosiveFx.Loop(cueName, holder)
	local config = SoundConfig.Get(cueName)
	local layers = config and SoundConfig.LayersOf(config)
	local layer = layers and layers[1]
	if not layer then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = layer.id
	sound.Volume = layer.volume
	sound.PlaybackSpeed = layer.pitch
	sound.Looped = true
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 10
	sound.RollOffMaxDistance = config.maxDistance or 260
	-- Through the category's volume group, made on demand by Sfx so the sliders apply from the first
	-- play; the by-name lookup is only for a context without Sfx (the gallery).
	local category = config.category or "Effects"
	local group = nil
	local sfxModule = script.Parent:FindFirstChild("Sfx")
	if sfxModule then
		local ok, sfx = pcall(require, sfxModule)
		if ok and type(sfx) == "table" and type(sfx.GroupFor) == "function" then
			group = sfx.GroupFor(category)
		end
	end
	sound.SoundGroup = group or SoundService:FindFirstChild("BRR_" .. category)
	for _, entry in ipairs(config.effects or {}) do
		local ok, effect = pcall(Instance.new, entry[1])
		if ok and effect then
			for property, value in pairs(entry[2] or {}) do
				pcall(function()
					effect[property] = value
				end)
			end
			effect.Parent = sound
		end
	end
	sound.Parent = holder
	sound:Play()
	return sound
end

-- For the gallery and the probe: how much is live.
function ExplosiveFx.Count()
	return #live, #debris, #ExplosiveFx.Clouds
end

-- Everything gone at once (a match ending).
function ExplosiveFx.Clear()
	for index = #live, 1, -1 do
		live[index].destroy(live[index])
		live[index] = nil
	end
	for index = #debris, 1, -1 do
		debris[index].part:Destroy()
		debris[index] = nil
	end
	table.clear(ExplosiveFx.Clouds)
	table.clear(splats)
end

return ExplosiveFx
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX155"><Properties><string name="Name">FootstepClient</string><ProtectedString name="Source">-- Footsteps that sound like the ground they land on (#120).
--
-- Roblox's own character sound script plays one looping "Running" sound for every player's body,
-- the same plastic patter on grass, wood or water, and bots (which it doesn't run for) make no
-- steps at all. This replaces it: each body near the camera, bots included, steps at a cadence
-- set by how fast it is actually moving, and each step is the cue for Humanoid.FloorMaterial
-- (SoundConfig.Footsteps). Other bodies step from their feet, positionally, so you can hear
-- someone coming round a corner; your own steps play flat and quieter.
--
-- The built-in loop is silenced by emptying its SoundId, not by turning its Volume down, because
-- MovementClient already owns that Volume (it lowers it while a body crouches and hands it back
-- afterwards); two writers on one property would undo each other. The crouch hush is applied
-- here instead, with the same MovementConfig.Crouch.StepVolume.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SoundConfig = require(Shared:WaitForChild("SoundConfig"))
local MovementConfig = require(Shared:WaitForChild("MovementConfig"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local STEPS = SoundConfig.Footsteps
local CROUCH = MovementConfig.Crouch

local SCAN_EVERY = 1
local TRIM_EVERY = 0.25

-- model -&gt; { humanoid, root, phase, heard, connections }. Strong keys, pruned on every scan: a
-- weak-keyed table would drop a body while it was still walking about.
local bodies = {}

local function silence(sound)
	if sound.SoundId ~= "" then
		sound.SoundId = ""
	end
end

-- The built-in "Running" loop sits on the root part, and the sound script can make it after we
-- first see the body, so it is looked for now and whenever the root gains a child.
local function silenceRunning(entry)
	local function hook(child)
		if child.Name == "Running" and child:IsA("Sound") then
			silence(child)
			table.insert(entry.connections, child:GetPropertyChangedSignal("SoundId"):Connect(function()
				silence(child)
			end))
		end
	end
	for _, child in ipairs(entry.root:GetChildren()) do
		hook(child)
	end
	table.insert(entry.connections, entry.root.ChildAdded:Connect(hook))
end

local function forget(model)
	local entry = bodies[model]
	if entry then
		for _, connection in ipairs(entry.connections) do
			connection:Disconnect()
		end
		bodies[model] = nil
	end
end

local function scan()
	for model in pairs(bodies) do
		local entry = bodies[model]
		if not model.Parent or not entry.root.Parent or not entry.humanoid.Parent then
			forget(model)
		end
	end
	for _, model in ipairs(workspace:GetChildren()) do
		if not bodies[model] and model:IsA("Model") then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			if humanoid and root then
				local entry = { humanoid = humanoid, root = root, phase = 0.5, heard = false, connections = {} }
				bodies[model] = entry
				silenceRunning(entry)
			end
		end
	end
end

-- Only the MAX_BODIES nearest bodies inside REACH step: a crowded fight shouldn't turn into
-- forty sets of feet, and one far enough off to be culled by rolloff shouldn't cost a pool slot.
local function trim()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local eye = camera.CFrame.Position
	local near = {}
	for model, entry in pairs(bodies) do
		entry.heard = false
		local distance = (entry.root.Position - eye).Magnitude
		if distance &lt;= STEPS.REACH then
			table.insert(near, { entry = entry, distance = distance })
		end
	end
	table.sort(near, function(a, b)
		return a.distance &lt; b.distance
	end)
	for index = 1, math.min(#near, STEPS.MAX_BODIES) do
		near[index].entry.heard = true
	end
end

local function stepFor(model, entry, dt)
	local humanoid = entry.humanoid
	if humanoid.Health &lt;= 0 then
		return
	end
	local state = humanoid:GetState()
	if state == Enum.HumanoidStateType.Swimming or state == Enum.HumanoidStateType.Climbing then
		return
	end
	local cue = SoundConfig.FootstepCue(humanoid.FloorMaterial.Name)
	if not cue then
		-- In the air: no steps, and the first one after landing comes half a stride in.
		entry.phase = 0.5
		return
	end
	local velocity = entry.root.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local rate = SoundConfig.StepRate(speed)
	if rate &lt;= 0 then
		entry.phase = 0.5
		return
	end
	entry.phase += dt * rate
	if entry.phase &lt; 1 then
		return
	end
	entry.phase %= 1

	local gain = SoundConfig.StepGain(speed)
	if model:GetAttribute("Crouching") == true then
		gain *= CROUCH.StepVolume
	end
	if model == Players.LocalPlayer.Character then
		Sfx.Play(cue, 0.1, nil, gain * STEPS.SELF_GAIN)
	else
		local feet = entry.root.Position - Vector3.new(0, humanoid.HipHeight + entry.root.Size.Y / 2, 0)
		Sfx.PlayAt(cue, feet, 0.1, nil, gain)
	end
end

local sinceScan, sinceTrim = SCAN_EVERY, TRIM_EVERY
RunService.Heartbeat:Connect(function(dt)
	sinceScan += dt
	if sinceScan &gt;= SCAN_EVERY then
		sinceScan = 0
		scan()
	end
	sinceTrim += dt
	if sinceTrim &gt;= TRIM_EVERY then
		sinceTrim = 0
		trim()
	end
	for model, entry in pairs(bodies) do
		if entry.heard and model.Parent then
			stepFor(model, entry, dt)
		end
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX156"><Properties><string name="Name">GlassFxClient</string><ProtectedString name="Source">-- Window glass breaking, drawn locally. DestructibleService removes a pane on the server and sends
-- every pane broken that frame in one GlassShatter event ({ cframe, size, color, from, impact,
-- transparency } each, where `from` is where the shot or blast came from and `impact` the point on
-- the pane it struck, when known). Here the pane stands a moment longer with a spiderweb of cracks
-- running out from the impact (#71: cracks, then it goes, never a fade), then bursts: the shards
-- nearest the impact fly fastest, most blow through away from the shot, a few spall back toward
-- it, and they land on the floor under them, lie there glinting a moment and fade. Nothing
-- replicates, and the pane is already gone for everyone, so a player who joins later just sees an
-- open window.
--
-- Shards are capped (per pane and in total) and skipped out of sight range, so a rocket through a
-- row of windows costs a bounded number of tiny local parts rather than a physics storm.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local glassShatter = Remotes.Event("GlassShatter")
local camera = workspace.CurrentCamera

local EFFECT_DISTANCE = 260
local MAX_ACTIVE = 150
local PER_PANE_MIN, PER_PANE_MAX = 10, 18
local SOUNDS_PER_BATCH = 3
local FLASHES_PER_BATCH = 6
-- Share of shards thrown back toward the shot rather than through with it.
local SPALL = 0.2
local REST_TIME = 1.6
local FADE_TIME = 0.9
local MAX_FLIGHT = 2.5
-- Resting shards lie this far above the floor: well clear of its face, so they never flicker on it.
local REST_LIFT = 0.1
-- How long the cracked pane stands before it bursts, and the web's rays and rings.
local WEB_TIME = 0.09
local WEB_RAYS_MIN, WEB_RAYS_MAX = 7, 9
local WEB_RINGS = { 0.18, 0.4, 0.7 }
local WEB_COLOR = Color3.fromRGB(240, 248, 255)

local fxFolder = Instance.new("Folder")
fxFolder.Name = "GlassFx"
fxFolder.Parent = workspace

-- shard -&gt; { floor = y or nil, born = clock }
local flying = {}
local active = 0

local function floorBelow(point)
	local map = workspace:FindFirstChild("Map")
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = map and { map, workspace.Terrain } or { workspace.Terrain }
	local hit = workspace:Raycast(point, Vector3.new(0, -40, 0), params)
	return hit and hit.Position.Y or nil
end

local function retire(shard, delay)
	task.delay(delay, function()
		if shard.Parent then
			TweenService:Create(shard, TweenInfo.new(FADE_TIME), { Transparency = 1 }):Play()
			task.delay(FADE_TIME, function()
				shard:Destroy()
				active -= 1
			end)
		else
			active -= 1
		end
	end)
end

local function localPart(name, size, cframe, color, material, transparency)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Transparency = transparency
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = fxFolder
	return part
end

-- Where on the pane (in its own x/y) the hit landed: the impact the server sent, else the middle.
local function impactOn(cframe, size, impact)
	if typeof(impact) ~= "Vector3" then
		return 0, 0
	end
	local at = cframe:PointToObjectSpace(impact)
	return math.clamp(at.X, -size.X / 2, size.X / 2), math.clamp(at.Y, -size.Y / 2, size.Y / 2)
end

-- The instant of breaking: a stand-in for the pane (it is already gone on the server) with a
-- spiderweb from the impact, straight rays and rings joining them; it stands WEB_TIME and is gone
-- as the shards fly. Returns the pieces, for the caller to remove.
local function web(cframe, size, color, transparency, ix, iy)
	local pieces = {}
	local thin = math.min(size.Z, 0.06)
	table.insert(pieces, localPart("GlassCrackPane", Vector3.new(size.X, size.Y, thin), cframe, color, Enum.Material.Glass,
		type(transparency) == "number" and transparency or 0.45))
	local hx, hy = size.X / 2, size.Y / 2
	local reach = math.max(size.X, size.Y)
	local function line(x1, y1, x2, y2, width)
		-- Kept on the pane: clamp both ends into it.
		x1, x2 = math.clamp(x1, -hx, hx), math.clamp(x2, -hx, hx)
		y1, y2 = math.clamp(y1, -hy, hy), math.clamp(y2, -hy, hy)
		local dx, dy = x2 - x1, y2 - y1
		local length = math.sqrt(dx * dx + dy * dy)
		if length &lt; 0.03 then
			return
		end
		local frame = cframe * CFrame.new((x1 + x2) / 2, (y1 + y2) / 2, 0) * CFrame.Angles(0, 0, math.atan2(dy, dx))
		-- Both faces of the pane: a line a hair proud of each.
		table.insert(pieces, localPart("GlassCrack", Vector3.new(length, width, thin + 0.03), frame, WEB_COLOR, Enum.Material.SmoothPlastic, 0.05))
	end
	local count = math.random(WEB_RAYS_MIN, WEB_RAYS_MAX)
	local angles = {}
	for ray = 1, count do
		angles[ray] = ray / count * math.pi * 2 + (math.random() - 0.5) * 0.5
		line(ix, iy, ix + math.cos(angles[ray]) * reach, iy + math.sin(angles[ray]) * reach, 0.035)
	end
	for _, share in ipairs(WEB_RINGS) do
		local radius = share * reach
		for ray = 1, count do
			local a, b = angles[ray], angles[ray % count + 1]
			line(ix + math.cos(a) * radius, iy + math.sin(a) * radius, ix + math.cos(b) * radius, iy + math.sin(b) * radius, 0.025)
		end
	end
	return pieces
end

local function burst(cframe, size, color, from, ix, iy)
	local normal = cframe.LookVector
	-- Which way the shot was travelling through the pane: +1 along its normal, -1 against it.
	local through = (math.random() &lt; 0.5) and 1 or -1
	if typeof(from) == "Vector3" then
		through = normal:Dot(cframe.Position - from) &gt;= 0 and 1 or -1
	end
	local bottom = cframe * Vector3.new(0, -size.Y / 2, 0)
	-- The floor on each side of the window, found once for the whole pane.
	local floors = {
		[1] = floorBelow(bottom + normal * 1.5 + Vector3.new(0, 0.5, 0)),
		[-1] = floorBelow(bottom - normal * 1.5 + Vector3.new(0, 0.5, 0)),
	}
	local count = math.clamp(math.floor(size.X * size.Y / 1.6), PER_PANE_MIN, PER_PANE_MAX)
	count = math.min(count, MAX_ACTIVE - active)
	for index = 1, count do
		-- A mix of big triangular pieces and small slivers.
		local big = index &lt;= math.ceil(count * 0.35)
		local shard = Instance.new(big and "WedgePart" or "Part")
		shard.Name = "GlassShard"
		if big then
			shard.Size = Vector3.new(0.05, 0.55 + math.random() * 0.7, 0.45 + math.random() * 0.7)
		else
			shard.Size = Vector3.new(0.05, 0.12 + math.random() * 0.3, 0.1 + math.random() * 0.25)
		end
		local offset = Vector3.new((math.random() - 0.5) * size.X * 0.9, (math.random() - 0.5) * size.Y * 0.9, 0)
		-- A shard's thin side is its X; turned so each one starts in the plane of the pane.
		shard.CFrame = cframe * CFrame.new(offset) * CFrame.Angles(0, math.pi / 2, math.random() * math.pi * 2)
		shard.Color = color:Lerp(Color3.new(1, 1, 1), 0.3 + math.random() * 0.2)
		shard.Material = Enum.Material.Glass
		shard.Transparency = 0.2 + math.random() * 0.2
		shard.Reflectance = 0.25
		shard.CanCollide = false
		shard.CanQuery = false
		shard.CanTouch = false
		shard.CastShadow = false
		shard.Massless = true
		shard.Parent = fxFolder
		local side = math.random() &lt; SPALL and -through or through
		local speed = side == through and (7 + math.random() * 11) or (2 + math.random() * 4)
		-- Pieces from where the shot went in fly fastest.
		local centre = 1 - math.clamp((offset - Vector3.new(ix, iy, 0)).Magnitude / (size.Magnitude / 2), 0, 1) * 0.5
		shard.AssemblyLinearVelocity = normal * side * speed * centre
			+ cframe.RightVector * offset.X * (0.8 + math.random())
			+ Vector3.new(0, 1 + math.random() * 5 + offset.Y * 0.5, 0)
		local spin = big and 8 or 16
		shard.AssemblyAngularVelocity = Vector3.new(math.random(-spin, spin), math.random(-spin, spin), math.random(-spin, spin))
		active += 1
		flying[shard] = { floor = floors[side], born = time() }
	end
end

glassShatter.OnClientEvent:Connect(function(batch)
	if type(batch) ~= "table" or not camera then
		return
	end
	local sounds, flashes = 0, 0
	for _, entry in ipairs(batch) do
		local cframe, size, color, from, impact, transparency = entry[1], entry[2], entry[3], entry[4], entry[5], entry[6]
		if typeof(cframe) == "CFrame" and typeof(size) == "Vector3" and typeof(color) == "Color3"
			and (cframe.Position - camera.CFrame.Position).Magnitude &lt;= EFFECT_DISTANCE then
			if sounds &lt; SOUNDS_PER_BATCH then
				sounds += 1
				Sfx.PlayAt("Shatter", cframe.Position, 0.25)
			end
			local ix, iy = impactOn(cframe, size, impact)
			local pieces = nil
			if flashes &lt; FLASHES_PER_BATCH then
				flashes += 1
				pieces = web(cframe, size, color, transparency, ix, iy)
			end
			task.delay(pieces and WEB_TIME or 0, function()
				if pieces then
					for _, piece in ipairs(pieces) do
						piece:Destroy()
					end
				end
				if active &lt; MAX_ACTIVE then
					burst(cframe, size, color, from, ix, iy)
				end
			end)
		end
	end
end)

-- Shards that reach their floor stop there, lying flat, then fade. Ones that never find a floor
-- (thrown out of a high window over a long drop) fade in the air instead.
RunService.Heartbeat:Connect(function()
	-- Wall clock, not os.clock (process CPU time in Roblox).
	local now = time()
	for shard, info in pairs(flying) do
		if not shard.Parent then
			flying[shard] = nil
			active -= 1
		elseif info.floor and shard.Position.Y &lt;= info.floor + REST_LIFT and shard.AssemblyLinearVelocity.Y &lt;= 0 then
			flying[shard] = nil
			shard.Anchored = true
			local position = shard.Position
			shard.CFrame = CFrame.new(position.X, info.floor + REST_LIFT, position.Z)
				* CFrame.Angles(0, math.random() * math.pi * 2, math.pi / 2)
			retire(shard, REST_TIME)
		elseif now - info.born &gt; MAX_FLIGHT then
			flying[shard] = nil
			retire(shard, 0)
		end
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX157"><Properties><string name="Name">GunfireCueClient</string><ProtectedString name="Source">-- Which way the gunfire is coming from (#22, "directional HUD cue for nearby bullet sounds").
--
-- Every shot already reaches every client on the ShotFired remote (CombatService.BroadcastShot,
-- `FireAllClients(shooterPlayer, origin, endPoints, rarity)`), and CombatClient already plays it as a
-- positional sound at `origin`. A sound tells a player a fight is near; it does not reliably tell them
-- WHERE on a laptop speaker or a phone. So this listens to the same remote -- no server change -- and
-- draws a small chevron on a ring round the crosshair, pointing at the shooter, for a second and a half.
--
-- What it leaves out, and why:
--   * your own shots and your teammates' -- you know where those are, and a ring full of friendly
--     chevrons in a team match would hide the one that matters;
--   * anything out of earshot (EARSHOT below, the same 400 studs Sfx uses as its default range), so the
--     cue never tells you about a shot you could not have heard;
--   * everything while a menu is open, while you are dead or spectating, and outside a match.
-- A burst from one gun refreshes the chevron already pointing that way rather than stacking more, and
-- there are never more than MAX_CUES at once: the oldest makes way.
--
-- THE DIRECTION IS YAW ONLY. The source is flattened into the camera's horizontal frame, built from the
-- camera's RightVector (always level: the camera never rolls), so it stays right when you look straight
-- down or up, where a flattened LookVector would collapse to nothing. Angle 0 is straight ahead and it
-- grows clockwise, the way the ring is drawn. tools/gunfire_cue_check.py runs the block marked PURE
-- below and holds it to that on every screen size.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))
local MovementState = require(script.Parent:WaitForChild("MovementState"))

local create, rounded = UiKit.create, UiKit.rounded
local Role = UiKit.Role

local player = Players.LocalPlayer

local EARSHOT = 400
local LIFETIME = 1.5
local MAX_CUES = 4
-- Two shots this close in angle are one source as far as the player can tell.
local MERGE_DEGREES = 20

-- PURE BEGIN (tools/gunfire_cue_check.py runs this block on its own; plain Lua, no Roblox types)

-- The shot's direction as a screen angle in radians: 0 = straight ahead, positive = clockwise (to the
-- right), in (-pi, pi]. nil when the source is right on top of you and has no direction worth drawing.
-- `right` is the camera's RightVector; `offset` is source minus camera position. Anything with X/Y/Z.
local function cueAngle(right, offset)
	local rx, rz = right.X, right.Z
	local length = math.sqrt(rx * rx + rz * rz)
	if length &lt; 1e-6 then
		return nil
	end
	rx, rz = rx / length, rz / length
	-- Level forward is the right vector turned a quarter to the left: (rz, -rx) in X/Z.
	local fx, fz = rz, -rx
	local across = offset.X * rx + offset.Z * rz
	local ahead = offset.X * fx + offset.Z * fz
	if across * across + ahead * ahead &lt; 9 then
		return nil
	end
	return math.atan2(across, ahead)
end

-- The ring round the crosshair: its radius for a viewport, and where on it an angle lands, in the
-- ScreenGui's pixels (IgnoreGuiInset, so the viewport centre is the crosshair). A fraction of the short
-- side, so it sits the same way on a phone and a monitor, with a floor so it clears the crosshair and a
-- ceiling so it stays near the middle of a big screen.
local function ringRadius(width, height)
	return math.max(80, math.min(240, math.min(width, height) * 0.26))
end

local function ringPoint(width, height, angle)
	local radius = ringRadius(width, height)
	return width / 2 + radius * math.sin(angle), height / 2 - radius * math.cos(angle)
end

-- How strong a cue starts: a shot at arm's length is loud, one at the edge of earshot is faint.
local function cueStrength(distance)
	return 1 - 0.6 * math.min(1, math.max(0, distance / EARSHOT))
end

-- PURE END

local shotFired = Remotes.Event("ShotFired")

local gui = create("ScreenGui", {
	Name = "GunfireCue",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	-- Under the HUD, so a panel always covers it. The HUD's ScreenGuis (BrrHud, VehicleHud,
	-- VehicleWeaponHud, BoonHud, ModeScoreHud) are all at the default 0 -- 8 is the inventory panel's --
	-- so the 6 this had drew the chevrons over the hotbar and the driving HUD (#80). Below 0, and below
	-- the sniper scope's -1, which covers the view when it is up.
	DisplayOrder = -2,
	Parent = player:WaitForChild("PlayerGui"),
})

-- One chevron: a holder turned to the angle, with a "^" of two bars at its top.
local function makeChevron()
	local holder = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(28, 16),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local bars = {}
	for index, rotation in ipairs({ -35, 35 }) do
		bars[index] = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, (index == 1) and -6 or 6, 0.5, 0),
			Size = UDim2.fromOffset(15, 4),
			Rotation = rotation,
			BackgroundColor3 = Role.Negative,
			BorderSizePixel = 0,
			Parent = holder,
		}, {
			rounded(2),
			create("UIStroke", { Color = Role.Scrim, Thickness = UiKit.Stroke.Hairline, Transparency = 0.4 }),
		})
	end
	return { holder = holder, bars = bars, age = 0, angle = 0, strength = 0, source = nil }
end

local cues = {}
for index = 1, MAX_CUES do
	cues[index] = makeChevron()
end

local function suppressed()
	if player:GetAttribute("MenuOpen") == true or not MovementState.inMatch then
		return true
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return not humanoid or humanoid.Health &lt;= 0
end

-- Who fired: a player comes named; a bot comes as nil, and its shot starts at its head (the lookup
-- CombatClient's shooterGun uses for the same reason).
local headQuery = OverlapParams.new()
headQuery.MaxParts = 12
local function shooterCharacter(shooter, origin)
	if typeof(shooter) == "Instance" and shooter:IsA("Player") then
		return shooter.Character
	end
	for _, part in ipairs(workspace:GetPartBoundsInRadius(origin, 0.75, headQuery)) do
		if part.Name == "Head" and part.Parent then
			return part.Parent
		end
	end
	return nil
end

-- Same test EnemyAura paints by: a teammate shares your Team attribute. No team (battle royale solos)
-- means everyone is an enemy.
local function isFriendly(shooter, origin)
	local mine = player.Character and player.Character:GetAttribute("Team")
	if mine == nil then
		return false
	end
	local character = shooterCharacter(shooter, origin)
	return character ~= nil and character ~= player.Character and character:GetAttribute("Team") == mine
end

local function hide(cue)
	cue.holder.Visible = false
	cue.source = nil
end

local function draw(cue, camera)
	local angle = cueAngle(camera.CFrame.RightVector, cue.source - camera.CFrame.Position)
	if not angle then
		cue.holder.Visible = false
		return
	end
	cue.angle = angle
	local viewport = camera.ViewportSize
	local x, y = ringPoint(viewport.X, viewport.Y, angle)
	cue.holder.Position = UDim2.fromOffset(x, y)
	cue.holder.Rotation = math.deg(angle)
	local fade = 1 - cue.age / LIFETIME
	local transparency = 1 - cue.strength * fade * 0.9
	for _, bar in ipairs(cue.bars) do
		bar.BackgroundTransparency = transparency
	end
	cue.holder.Visible = true
end

shotFired.OnClientEvent:Connect(function(shooter, origin, _endPoints, _rarity)
	if shooter == player or typeof(origin) ~= "Vector3" or suppressed() then
		return
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local distance = (origin - camera.CFrame.Position).Magnitude
	if distance &gt; EARSHOT or isFriendly(shooter, origin) then
		return
	end
	local angle = cueAngle(camera.CFrame.RightVector, origin - camera.CFrame.Position)
	if not angle then
		return
	end

	-- Refresh a live cue already pointing this way; else take a free slot; else the oldest.
	local pick, free, oldest = nil, nil, nil
	for _, cue in ipairs(cues) do
		if cue.source then
			local apart = math.abs((angle - cue.angle + math.pi) % (2 * math.pi) - math.pi)
			if not pick and math.deg(apart) &lt;= MERGE_DEGREES then
				pick = cue
			end
			if not oldest or cue.age &gt; oldest.age then
				oldest = cue
			end
		elseif not free then
			free = cue
		end
	end
	local strength = cueStrength(distance)
	if pick then
		-- The louder of the two, so a far shot does not dim a near one already showing that way.
		strength = math.max(strength, pick.strength)
	else
		pick = free or oldest
	end
	pick.source = origin
	pick.angle = angle
	pick.age = 0
	pick.strength = strength
	draw(pick, camera)
end)

-- Frame time from the frame's own dt, not os.clock (CPU time in Roblox, see COORDINATION.md).
RunService.RenderStepped:Connect(function(dt)
	local camera = workspace.CurrentCamera
	local off = suppressed() or not camera
	for _, cue in ipairs(cues) do
		if cue.source then
			cue.age += dt
			if off or cue.age &gt;= LIFETIME then
				hide(cue)
			else
				-- Re-aimed every frame: turn towards the shot and the chevron swings to the top.
				draw(cue, camera)
			end
		end
	end
end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX158"><Properties><string name="Name">GunFx</string><ProtectedString name="Source">-- Gunfire effects on the client: muzzle flashes, tracer rounds, spent cases, dropped magazines and
-- impact sparks. ModuleScript; CombatClient calls it for your own shots (from the viewmodel's muzzle)
-- and everyone else's (from their gun's muzzle in the world).
--
--   GunFx.Flash(cframe, kind, scale, firstPerson)  -- cframe looks out of the muzzle
--   GunFx.Tracer(origin, target, kind, onArrive)
--   GunFx.Casing(cframe, kind)                      -- cframe at the ejection port, looking out of it
--   GunFx.Drop(model, up)                           -- a magazine or box let go of
--   GunFx.Impact(position, normal)
--
-- Textures are ones the Roblox client ships under rbxasset:// (glow.png, the particle set), checked
-- by rendering them in the gallery rather than assumed. Everything is pooled or capped: a firefight
-- between forty bots must not become thousands of instances.

local RunService = game:GetService("RunService")

local GunFx = {}

local TEXTURE = {
	glow = "rbxasset://textures/glow.png",
	fire = "rbxasset://textures/particles/fire_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	sparks = "rbxasset://textures/particles/fire_sparks_main.dds",
	sparkle = "rbxasset://textures/sparkle.png",
}

local V = Vector3.new
local NS = NumberSequence.new
local NSK = NumberSequenceKeypoint.new
local CS = ColorSequence.new

local folder = nil
local function effects()
	if not folder or not folder.Parent then
		folder = Instance.new("Folder")
		folder.Name = "BRR_GunFx"
		folder.Parent = workspace
	end
	return folder
end
GunFx.Folder = effects

local function anchoredPart(name, size)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size or V(0.1, 0.1, 0.1)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	return part
end

--------------------------------------------------------------------------------
-- Muzzle flash
--------------------------------------------------------------------------------

-- What each gun's muzzle does: the size of the fireball, how far its flame reaches forward, whether a
-- brake throws flame out to the sides, the colour, and how much smoke hangs after.
local FLASH = {
	rifle = { core = 0.9, flame = 1.0, sides = 0, color = Color3.fromRGB(255, 196, 120), smoke = 0.6, light = 9 },
	smg = { core = 0.7, flame = 0.8, sides = 0, color = Color3.fromRGB(255, 200, 130), smoke = 0.4, light = 8 },
	pistol = { core = 0.6, flame = 0.5, sides = 0, color = Color3.fromRGB(255, 190, 110), smoke = 0.35, light = 7 },
	revolver = { core = 1.0, flame = 0.7, sides = 0.6, color = Color3.fromRGB(255, 180, 100), smoke = 0.8, light = 9 },
	brake = { core = 0.8, flame = 0.6, sides = 1.2, color = Color3.fromRGB(255, 196, 120), smoke = 1.0, light = 10 },
	shotgun = { core = 1.3, flame = 1.1, sides = 0.3, color = Color3.fromRGB(255, 176, 96), smoke = 1.2, light = 11 },
	suppressed = { core = 0.18, flame = 0.1, sides = 0, color = Color3.fromRGB(255, 210, 160), smoke = 0.3, light = 0 },
	rotary = { core = 0.8, flame = 0.9, sides = 0.2, color = Color3.fromRGB(255, 200, 120), smoke = 0.5, light = 9 },
	cannon = { core = 1.8, flame = 1.3, sides = 0.8, color = Color3.fromRGB(255, 170, 70), smoke = 2.0, light = 14 },
	rocket = { core = 1.2, flame = 0.4, sides = 0.2, color = Color3.fromRGB(255, 190, 110), smoke = 2.4, light = 12 },
	launcher = { core = 0.9, flame = 0.4, sides = 0.2, color = Color3.fromRGB(255, 190, 110), smoke = 1.4, light = 9 },
	rail = { core = 1.1, flame = 1.4, sides = 0, color = Color3.fromRGB(140, 226, 255), smoke = 0.2, light = 12 },
	bubble = { core = 0.3, flame = 0, sides = 0, color = Color3.fromRGB(210, 244, 255), smoke = 0, light = 0, bubbles = 7 },
	crossbow = { core = 0, flame = 0, sides = 0, color = Color3.new(1, 1, 1), smoke = 0, light = 0 },

	-- The creative guns (claude-3b's GunModelsCreative). `bubbles` is a burst of sparkles in `bubbleColor`
	-- (a colour or a ColorSequence); `sparks` a burst of sparks whatever the flame. Tune freely.
	squeak = { core = 0.3, flame = 0, sides = 0, color = Color3.fromRGB(255, 226, 110), smoke = 0, light = 0,
		bubbles = 6, bubbleColor = Color3.fromRGB(255, 236, 140) },
	droplets = { core = 0.2, flame = 0, sides = 0, color = Color3.fromRGB(150, 210, 255), smoke = 0, light = 0,
		bubbles = 10, bubbleColor = Color3.fromRGB(120, 196, 255) },
	noodle = { core = 0.5, flame = 0.3, sides = 0, color = Color3.fromRGB(255, 214, 120), smoke = 0.5, light = 4 },
	bassring = { core = 1.2, flame = 0, sides = 0.8, color = Color3.fromRGB(170, 90, 255), smoke = 0, light = 10 },
	gumball = { core = 0.6, flame = 0.2, sides = 0, color = Color3.fromRGB(255, 130, 196), smoke = 0.3, light = 5,
		bubbles = 4, bubbleColor = Color3.fromRGB(255, 150, 210) },
	zap = { core = 1.0, flame = 0, sides = 0.4, color = Color3.fromRGB(140, 214, 255), smoke = 0, light = 10, sparks = 6 },
	disco = { core = 0.9, flame = 0, sides = 0, color = Color3.fromRGB(255, 240, 255), smoke = 0, light = 8, bubbles = 12,
		bubbleColor = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 120)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 220, 80)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 220, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 110, 255)),
		}) },
	snow = { core = 0.4, flame = 0, sides = 0, color = Color3.fromRGB(214, 240, 255), smoke = 0.5, light = 3,
		bubbles = 10, bubbleColor = Color3.fromRGB(248, 252, 255) },
	-- The Lava Lamp Lancer spits molten wax: a fat slow glob of a flash, hot orange, with the smoke of
	-- something burning rather than something fired.
	lava = { core = 0.8, flame = 0.5, sides = 0, color = Color3.fromRGB(255, 130, 40), smoke = 1.1, light = 8,
		bubbles = 5, bubbleColor = Color3.fromRGB(255, 170, 60) },

	-- The workshop guns (WorkshopArsenal): household things, so each muzzle throws what the thing throws.
	leaves = { core = 0.35, flame = 0, sides = 0.3, color = Color3.fromRGB(180, 220, 120), smoke = 0.4, light = 2,
		bubbles = 14, bubbleColor = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 180, 70)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(214, 166, 60)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 96, 44)),
		}) },
	spray = { core = 0.25, flame = 0, sides = 0, color = Color3.fromRGB(150, 214, 255), smoke = 0, light = 0,
		bubbles = 12, bubbleColor = Color3.fromRGB(120, 196, 255) },
	dust = { core = 0.3, flame = 0, sides = 0.2, color = Color3.fromRGB(206, 196, 176), smoke = 1.3, light = 0,
		bubbles = 8, bubbleColor = Color3.fromRGB(214, 202, 180) },
	confetti = { core = 1.0, flame = 0.2, sides = 0.6, color = Color3.fromRGB(255, 246, 214), smoke = 0.5, light = 9, sparks = 4,
		bubbles = 18, bubbleColor = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 140)), ColorSequenceKeypoint.new(0.35, Color3.fromRGB(255, 224, 90)),
			ColorSequenceKeypoint.new(0.7, Color3.fromRGB(90, 226, 180)), ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 130, 255)),
		}) },
	keycap = { core = 0.45, flame = 0.2, sides = 0, color = Color3.fromRGB(226, 236, 255), smoke = 0.2, light = 4, sparks = 3 },

	-- The signature guns (GunModelsSignature, the gun rework): the Epics and up flash as what they are.
	glitch = { core = 0.7, flame = 0.4, sides = 0, color = Color3.fromRGB(255, 90, 230), smoke = 0.1, light = 7, sparks = 5,
		bubbles = 6, bubbleColor = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 220)), ColorSequenceKeypoint.new(1, Color3.fromRGB(70, 240, 255)),
		}) },
	blood = { core = 0.9, flame = 0.9, sides = 0.3, color = Color3.fromRGB(255, 80, 70), smoke = 0.7, light = 8,
		bubbles = 5, bubbleColor = Color3.fromRGB(150, 16, 30) },
	bank = { core = 0.8, flame = 0.6, sides = 1.1, color = Color3.fromRGB(255, 170, 70), smoke = 0.9, light = 10, sparks = 4 },
	ratio = { core = 0.3, flame = 0.2, sides = 0, color = Color3.fromRGB(255, 150, 210), smoke = 0.2, light = 3,
		bubbles = 5, bubbleColor = Color3.fromRGB(255, 120, 190) },
	breach = { core = 1.4, flame = 1.2, sides = 0.5, color = Color3.fromRGB(255, 226, 120), smoke = 1.0, light = 12, sparks = 6 },
}

-- One emitter host per flash kind is enough: particles live in the world once emitted, so the host can
-- move on to the next shot straight away.
local hosts = {}

local function emitter(parent, name, props)
	local particles = Instance.new("ParticleEmitter")
	particles.Name = name
	particles.Enabled = false
	particles.LightInfluence = 0
	particles.LockedToPart = false
	for property, value in pairs(props) do
		particles[property] = value
	end
	particles.Parent = parent
	return particles
end

local function hostFor(kind)
	local host = hosts[kind]
	if host and host.part.Parent then
		return host
	end
	local spec = FLASH[kind] or FLASH.rifle
	local part = anchoredPart("BRR_FlashHost")
	part.Parent = effects()
	local attachment = Instance.new("Attachment")
	attachment.Parent = part
	local color = spec.color
	host = { part = part, attachment = attachment }
	host.core = emitter(attachment, "Core", {
		Texture = TEXTURE.glow,
		LightEmission = 1,
		Color = CS(color:Lerp(Color3.new(1, 1, 1), 0.45), color),
		Lifetime = NumberRange.new(0.05, 0.07),
		Speed = NumberRange.new(0),
		Rotation = NumberRange.new(0, 360),
		Size = NS({ NSK(0, 0.4), NSK(1, 0.6) }),
		Transparency = NS({ NSK(0, 0), NSK(0.6, 0.3), NSK(1, 1) }),
		ZOffset = 0.2,
	})
	host.flame = emitter(attachment, "Flame", {
		Texture = TEXTURE.fire,
		LightEmission = 1,
		Color = CS(color:Lerp(Color3.new(1, 1, 1), 0.3), color),
		Lifetime = NumberRange.new(0.035, 0.055),
		Speed = NumberRange.new(14, 22),
		EmissionDirection = Enum.NormalId.Front,
		SpreadAngle = Vector2.new(6, 6),
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Size = NS({ NSK(0, 0.18), NSK(1, 0.32) }),
		Squash = NS(-0.6),
		Transparency = NS({ NSK(0, 0.05), NSK(1, 1) }),
	})
	host.sides = emitter(attachment, "Sides", {
		Texture = TEXTURE.fire,
		LightEmission = 1,
		Color = CS(color),
		Lifetime = NumberRange.new(0.04, 0.06),
		Speed = NumberRange.new(10, 16),
		EmissionDirection = Enum.NormalId.Right,
		SpreadAngle = Vector2.new(12, 12),
		Orientation = Enum.ParticleOrientation.VelocityParallel,
		Size = NS({ NSK(0, 0.14), NSK(1, 0.26) }),
		Squash = NS(-0.5),
		Transparency = NS({ NSK(0, 0.1), NSK(1, 1) }),
	})
	host.sidesLeft = host.sides:Clone()
	host.sidesLeft.EmissionDirection = Enum.NormalId.Left
	host.sidesLeft.Parent = attachment
	host.smoke = emitter(attachment, "Smoke", {
		Texture = TEXTURE.smoke,
		LightEmission = 0,
		LightInfluence = 1,
		Color = CS(Color3.fromRGB(196, 196, 196)),
		Lifetime = NumberRange.new(0.7, 1.3),
		Speed = NumberRange.new(1.5, 4),
		EmissionDirection = Enum.NormalId.Front,
		SpreadAngle = Vector2.new(25, 25),
		Drag = 4,
		Acceleration = V(0, 1.2, 0),
		RotSpeed = NumberRange.new(-60, 60),
		Rotation = NumberRange.new(0, 360),
		Size = NS({ NSK(0, 0.25), NSK(1, 1.3) }),
		Transparency = NS({ NSK(0, 0.72), NSK(1, 1) }),
	})
	host.sparks = emitter(attachment, "Sparks", {
		Texture = TEXTURE.sparks,
		LightEmission = 1,
		Color = CS(Color3.fromRGB(255, 214, 140)),
		Lifetime = NumberRange.new(0.12, 0.25),
		Speed = NumberRange.new(8, 18),
		EmissionDirection = Enum.NormalId.Front,
		SpreadAngle = Vector2.new(18, 18),
		Drag = 3,
		Size = NS({ NSK(0, 0.05), NSK(1, 0.01) }),
		Transparency = NS({ NSK(0, 0), NSK(1, 1) }),
	})
	local bubbleColor = spec.bubbleColor or Color3.fromRGB(220, 246, 255)
	host.bubbles = emitter(attachment, "Bubbles", {
		Texture = TEXTURE.sparkle,
		LightEmission = 0.4,
		Color = typeof(bubbleColor) == "ColorSequence" and bubbleColor or CS(bubbleColor),
		Lifetime = NumberRange.new(0.5, 0.9),
		Speed = NumberRange.new(4, 9),
		EmissionDirection = Enum.NormalId.Front,
		SpreadAngle = Vector2.new(22, 22),
		Drag = 2.5,
		Acceleration = V(0, 0.6, 0),
		Size = NS({ NSK(0, 0.08), NSK(1, 0.18) }),
		Transparency = NS({ NSK(0, 0.2), NSK(1, 1) }),
	})
	host.light = Instance.new("PointLight")
	host.light.Color = color
	host.light.Brightness = 0
	host.light.Range = spec.light
	host.light.Parent = part
	hosts[kind] = host
	return host
end

function GunFx.Flash(cframe, kind, scale, firstPerson)
	local spec = FLASH[kind] or FLASH.rifle
	if spec.core &lt;= 0 and not spec.bubbles then
		return
	end
	scale = scale or 1
	local host = hostFor(kind)
	-- Particle size is in studs; a flash seen from arm's length reads bigger than one down the street,
	-- so first person draws it a little smaller.
	local size = scale * (firstPerson and 0.8 or 1.25)
	host.part.CFrame = cframe
	if spec.core &gt; 0 then
		host.core.Size = NS({ NSK(0, 0.34 * spec.core * size), NSK(1, 0.5 * spec.core * size) })
		host.core:Emit(2)
	end
	if spec.flame &gt; 0 then
		host.flame.Size = NS({ NSK(0, 0.14 * spec.flame * size), NSK(1, 0.26 * spec.flame * size) })
		host.flame:Emit(math.max(2, math.floor(4 * spec.flame)))
	end
	if spec.sides &gt; 0 then
		host.sides:Emit(math.floor(2 * spec.sides + 0.5))
		host.sidesLeft:Emit(math.floor(2 * spec.sides + 0.5))
	end
	if spec.smoke &gt; 0 then
		host.smoke.Size = NS({ NSK(0, 0.22 * size), NSK(1, 1.1 * spec.smoke * size) })
		host.smoke:Emit(math.max(1, math.floor(2 * spec.smoke)))
	end
	if spec.sparks then
		host.sparks:Emit(spec.sparks)
	elseif spec.flame &gt; 0.5 then
		host.sparks:Emit(math.random(1, 3))
	end
	if spec.bubbles then
		host.bubbles:Emit(spec.bubbles)
	end
	if spec.light &gt; 0 then
		local light = host.light
		light.Brightness = 5
		light.Shadows = firstPerson == true
		local token = (host.lightToken or 0) + 1
		host.lightToken = token
		task.delay(0.05, function()
			if host.lightToken == token then
				light.Brightness = 0
			end
		end)
	end
end

-- A rocket's backblast: a cone of smoke and flame out of the venturi.
function GunFx.Backblast(cframe)
	local host = hostFor("rocket")
	host.part.CFrame = cframe
	host.smoke.Size = NS({ NSK(0, 0.5), NSK(1, 3) })
	host.smoke:Emit(8)
	host.flame:Emit(6)
end

--------------------------------------------------------------------------------
-- Tracers
--------------------------------------------------------------------------------

-- A tracer is two camera-facing beams between a tail and a head that fly down the shot: a hot core
-- and a softer glow round it, bright at the head and fading to nothing along the streak. Beams rather
-- than a stretched neon part, because a part reads as a solid rod from the side and a beam always
-- faces you.
-- How visible a tracer is, over and above the per-kind numbers below, which set each kind's character
-- against the others rather than its absolute size. Against a bright map a tracer read as a thin faint
-- thread, so all three are scaled in one place: wider core, wider and less transparent glow, and a
-- longer streak so a fast round is a line rather than a dot.
local TRACER_CORE, TRACER_GLOW, TRACER_STREAK = 1.6, 1.45, 1.35

-- Those widths are in studs, so they shrink with distance: a rifle's glow (0.29 studs) is about 3
-- pixels across at 75 studs on a 1080p screen and under one pixel at 250, which is why a fight across
-- a field showed no tracers at all. So a streak is widened, never narrowed, to keep its glow at least
-- TRACER_MIN_GLOW_PX across, and never by more than TRACER_MAX_WIDEN so a very distant one cannot
-- turn into a rod. The widening is the same for every kind, so a heavy round stays fatter than a
-- pellet at any range.
local TRACER_MIN_GLOW_PX = 3
local TRACER_MAX_WIDEN = 5
-- A fast round crosses a short shot in a frame or two (a rifle does 20 studs in 0.02 s), and the
-- streak used to be destroyed the frame it arrived, so a close shot barely drew. It now lingers this
-- long after arriving, its tail running on into the target and the whole thing thinning to nothing.
local TRACER_AFTERGLOW = 0.08

-- How much to widen a streak whose nearest point is `distance` studs from the camera, given how many
-- pixels one stud spans at one stud away (viewport height / (2 tan(FOV/2))).
function GunFx.TracerWidthScale(distance, pixelsPerStud)
	if not pixelsPerStud or pixelsPerStud &lt;= 0 then
		return 1
	end
	local glowPixels = 0.2 * TRACER_GLOW * pixelsPerStud / math.max(distance, 1)
	return math.min(math.max(TRACER_MIN_GLOW_PX / glowPixels, 1), TRACER_MAX_WIDEN)
end

-- How much of its width a streak keeps `since` seconds after it arrived; nil once it should go.
function GunFx.TracerFade(since)
	if since &gt;= TRACER_AFTERGLOW then
		return nil
	end
	return 1 - since / TRACER_AFTERGLOW
end

local TRACER = {
	bullet = { speed = 950, streak = 7, core = 0.045, glow = 0.2, color = Color3.fromRGB(255, 180, 90), hot = Color3.fromRGB(255, 244, 214) },
	pellet = { speed = 760, streak = 3, core = 0.03, glow = 0.12, color = Color3.fromRGB(255, 170, 90), hot = Color3.fromRGB(255, 236, 200) },
	heavy = { speed = 820, streak = 10, core = 0.07, glow = 0.3, color = Color3.fromRGB(255, 120, 60), hot = Color3.fromRGB(255, 226, 190) },
	energy = { speed = 0, streak = 0, core = 0.12, glow = 0.6, color = Color3.fromRGB(110, 210, 255), hot = Color3.fromRGB(230, 250, 255), life = 0.28 },
	bubble = { speed = 170, projectile = "bubble" },
	rocket = { speed = 170, projectile = "rocket" },
	grenade = { speed = 130, projectile = "grenade" },
	bolt = { speed = 330, projectile = "bolt" },

	-- The creative guns. A streak takes the bullet fields; `projectile = "ball"` flies a ball of `size`
	-- studs in `color` and `material` (with `transparency`).
	squeak = { speed = 620, streak = 3, core = 0.05, glow = 0.22, color = Color3.fromRGB(255, 220, 90), hot = Color3.fromRGB(255, 252, 220) },
	droplets = { speed = 420, streak = 2.5, core = 0.035, glow = 0.14, color = Color3.fromRGB(110, 190, 255), hot = Color3.fromRGB(225, 244, 255) },
	noodle = { speed = 380, streak = 12, core = 0.08, glow = 0.16, color = Color3.fromRGB(240, 206, 120), hot = Color3.fromRGB(255, 240, 200) },
	bassring = { speed = 0, streak = 0, core = 0.16, glow = 0.8, color = Color3.fromRGB(170, 90, 255), hot = Color3.fromRGB(236, 214, 255), life = 0.22 },
	gumball = { speed = 210, projectile = "ball", size = 0.26, color = Color3.fromRGB(255, 110, 180), material = Enum.Material.SmoothPlastic },
	-- The workshop guns: a leaf turning over, a lance of water, broom bristles, a party streamer, a dust
	-- bunny and a keycap.
	leaf = { speed = 150, projectile = "leaf" },
	waterjet = { speed = 240, streak = 9, core = 0.05, glow = 0.24, color = Color3.fromRGB(120, 196, 255), hot = Color3.fromRGB(226, 246, 255) },
	bristle = { speed = 520, streak = 2.5, core = 0.03, glow = 0.12, color = Color3.fromRGB(226, 196, 120), hot = Color3.fromRGB(255, 238, 200) },
	streamer = { speed = 130, projectile = "streamer" },
	dustbunny = { speed = 190, projectile = "ball", size = 0.3, color = Color3.fromRGB(198, 190, 176), material = Enum.Material.Fabric },
	keycap = { speed = 430, projectile = "keycap" },
	zap = { speed = 0, streak = 0, core = 0.08, glow = 0.5, color = Color3.fromRGB(130, 206, 255), hot = Color3.fromRGB(245, 252, 255), life = 0.16 },
	disco = { speed = 900, streak = 6, core = 0.05, glow = 0.28, color = Color3.fromRGB(255, 120, 240), hot = Color3.fromRGB(255, 255, 255) },
	snow = { speed = 240, projectile = "ball", size = 0.24, color = Color3.fromRGB(246, 250, 255), material = Enum.Material.Snow },
	lava = { speed = 300, projectile = "ball", size = 0.3, color = Color3.fromRGB(255, 120, 40), material = Enum.Material.Neon },

	-- The signature guns (the gun rework). `soft` marks a tracer that chips no wall where it lands.
	glitch = { speed = 1100, streak = 6, core = 0.05, glow = 0.24, color = Color3.fromRGB(70, 240, 255), hot = Color3.fromRGB(255, 90, 230) },
	blood = { speed = 820, streak = 9, core = 0.06, glow = 0.26, color = Color3.fromRGB(170, 18, 36), hot = Color3.fromRGB(255, 130, 130) },
	bank = { speed = 900, streak = 8, core = 0.05, glow = 0.24, color = Color3.fromRGB(255, 140, 40), hot = Color3.fromRGB(255, 232, 196) },
	ratio = { speed = 760, streak = 5, core = 0.045, glow = 0.22, color = Color3.fromRGB(255, 110, 190), hot = Color3.fromRGB(255, 232, 246) },
	breach = { speed = 760, streak = 3, core = 0.035, glow = 0.14, color = Color3.fromRGB(255, 210, 90), hot = Color3.fromRGB(255, 250, 222) },
	heart = { speed = 520, projectile = "heart", soft = true },
	cash = { speed = 880, streak = 8, core = 0.05, glow = 0.26, color = Color3.fromRGB(120, 230, 120), hot = Color3.fromRGB(255, 236, 150) },
	vine = { speed = 820, streak = 10, core = 0.06, glow = 0.3, color = Color3.fromRGB(110, 220, 90), hot = Color3.fromRGB(230, 255, 190) },
	audit = { speed = 1000, streak = 7, core = 0.045, glow = 0.3, color = Color3.fromRGB(190, 150, 255), hot = Color3.fromRGB(250, 244, 255) },
	noclip = { speed = 1200, streak = 9, core = 0.04, glow = 0.28, color = Color3.fromRGB(126, 250, 200), hot = Color3.fromRGB(230, 255, 245) },
	overdue = { speed = 950, streak = 7, core = 0.05, glow = 0.24, color = Color3.fromRGB(230, 40, 50), hot = Color3.fromRGB(255, 220, 200) },
}
GunFx.TracerKinds = TRACER

-- Whether a tracer kind lands soft: no chip in the wall where it arrives (CombatClient asks, for kinds it
-- does not list itself).
function GunFx.SoftTracer(kind)
	local spec = TRACER[kind]
	return spec ~= nil and spec.soft == true
end

local flying = {}
local MAX_FLYING = 90

local function beam(attachment0, attachment1, width, color, transparency)
	local b = Instance.new("Beam")
	b.Attachment0 = attachment0
	b.Attachment1 = attachment1
	b.FaceCamera = true
	b.Segments = 1
	b.LightEmission = 1
	b.LightInfluence = 0
	b.Width0 = width * 0.35
	b.Width1 = width
	b.Color = CS(color)
	b.Transparency = transparency
	b.Parent = attachment0
	return b
end

local function projectileModel(kind, spec)
	local model = Instance.new("Model")
	local mm = 0.0038
	local function piece(shape, size, cframe, color, material, transparency)
		local part = anchoredPart("Projectile", size)
		part.Shape = shape
		part.CFrame = cframe
		part.Color = color
		part.Material = material
		part.Transparency = transparency or 0
		part.Parent = model
	end
	local along = CFrame.Angles(0, math.pi / 2, 0)
	if kind == "bubble" then
		piece(Enum.PartType.Ball, V(0.36, 0.36, 0.36), CFrame.identity, Color3.fromRGB(210, 240, 255), Enum.Material.Glass, 0.55)
	elseif kind == "rocket" then
		piece(Enum.PartType.Cylinder, V(120 * mm, 85 * mm, 85 * mm), along, Color3.fromRGB(84, 96, 70), Enum.Material.SmoothPlastic)
		piece(Enum.PartType.Cylinder, V(80 * mm, 50 * mm, 50 * mm), CFrame.new(0, 0, -100 * mm) * along, Color3.fromRGB(84, 96, 70), Enum.Material.SmoothPlastic)
		piece(Enum.PartType.Cylinder, V(200 * mm, 38 * mm, 38 * mm), CFrame.new(0, 0, 160 * mm) * along, Color3.fromRGB(60, 64, 56), Enum.Material.Metal)
	elseif kind == "grenade" then
		piece(Enum.PartType.Ball, V(40 * mm, 40 * mm, 40 * mm), CFrame.identity, Color3.fromRGB(84, 96, 70), Enum.Material.SmoothPlastic)
	elseif kind == "bolt" then
		piece(Enum.PartType.Cylinder, V(470 * mm, 8 * mm, 8 * mm), along, Color3.fromRGB(30, 30, 32), Enum.Material.SmoothPlastic)
		piece(Enum.PartType.Cylinder, V(60 * mm, 14 * mm, 14 * mm), CFrame.new(0, 0, 200 * mm) * along, Color3.fromRGB(176, 34, 36), Enum.Material.Fabric)
	elseif kind == "ball" then
		local size = spec and spec.size or 0.25
		piece(Enum.PartType.Ball, V(size, size, size), CFrame.identity, spec and spec.color or Color3.new(1, 1, 1),
			spec and spec.material or Enum.Material.SmoothPlastic, spec and spec.transparency)
	elseif kind == "leaf" then
		piece(Enum.PartType.Block, V(0.34, 0.03, 0.2), CFrame.identity, Color3.fromRGB(126, 186, 74), Enum.Material.Grass)
		piece(Enum.PartType.Block, V(0.36, 0.05, 0.05), CFrame.identity, Color3.fromRGB(92, 132, 56), Enum.Material.Grass)
	elseif kind == "heart" then
		-- A little pink heart: two lobes and the point.
		for _, side in ipairs({ -1, 1 }) do
			piece(Enum.PartType.Ball, V(0.13, 0.13, 0.13), CFrame.new(side * 0.05, 0.03, 0), Color3.fromRGB(255, 90, 150), Enum.Material.Neon)
		end
		piece(Enum.PartType.Block, V(0.1, 0.1, 0.06), CFrame.new(0, -0.03, 0) * CFrame.Angles(0, 0, math.rad(45)), Color3.fromRGB(255, 90, 150), Enum.Material.Neon)
	elseif kind == "keycap" then
		piece(Enum.PartType.Block, V(0.16, 0.1, 0.16), CFrame.identity, Color3.fromRGB(38, 40, 48), Enum.Material.SmoothPlastic)
		piece(Enum.PartType.Block, V(0.13, 0.03, 0.13), CFrame.new(0, 0.052, 0), Color3.fromRGB(228, 234, 246), Enum.Material.SmoothPlastic)
	elseif kind == "streamer" then
		-- A ribbon: a head and three segments trailing behind it, alternating party colours.
		local colours = { Color3.fromRGB(255, 90, 140), Color3.fromRGB(255, 224, 90), Color3.fromRGB(90, 226, 180), Color3.fromRGB(150, 130, 255) }
		for index = 0, 3 do
			piece(Enum.PartType.Block, V(0.05, 0.02, 0.26), CFrame.new(math.sin(index * 1.7) * 0.06, math.cos(index * 1.3) * 0.05, index * 0.26),
				colours[index + 1], Enum.Material.SmoothPlastic)
		end
	end
	return model
end

-- A smoke trail behind a rocket.
local function trailEmitter(parent)
	return emitter(parent, "Trail", {
		Texture = TEXTURE.smoke,
		LightInfluence = 1,
		Color = CS(Color3.fromRGB(210, 210, 210)),
		Lifetime = NumberRange.new(0.8, 1.4),
		Rate = 60,
		Speed = NumberRange.new(0.5, 1.5),
		Drag = 2,
		Size = NS({ NSK(0, 0.3), NSK(1, 1.6) }),
		Transparency = NS({ NSK(0, 0.5), NSK(1, 1) }),
		Enabled = true,
	})
end

function GunFx.Tracer(origin, target, kind, onArrive)
	local spec = TRACER[kind] or TRACER.bullet
	local delta = target - origin
	local distance = delta.Magnitude
	if distance &lt; 0.5 then
		if onArrive then
			onArrive()
		end
		return
	end
	local direction = delta.Unit
	if #flying &gt;= MAX_FLYING then
		local oldest = table.remove(flying, 1)
		oldest.destroy()
		if oldest.onArrive then
			oldest.onArrive()
		end
	end

	local terrain = workspace.Terrain
	local entry = { origin = origin, direction = direction, distance = distance, spec = spec, travelled = 0, age = 0, onArrive = onArrive }

	if spec.projectile then
		local model = projectileModel(spec.projectile, spec)
		model.Parent = effects()
		entry.model = model
		entry.parts = model:GetChildren()
		entry.offsets = {}
		for _, part in ipairs(entry.parts) do
			entry.offsets[part] = part.CFrame
		end
		if spec.projectile == "rocket" then
			local host = anchoredPart("TrailHost")
			host.Parent = model
			local attachment = Instance.new("Attachment")
			attachment.Position = V(0, 0, 0.8)
			attachment.Parent = host
			entry.trail = trailEmitter(attachment)
			entry.trailHost = host
		end
		entry.destroy = function()
			model:Destroy()
		end
	else
		local tail = Instance.new("Attachment")
		local head = Instance.new("Attachment")
		tail.Parent = terrain
		head.Parent = terrain
		tail.WorldPosition = origin
		head.WorldPosition = origin
		entry.beams = {
			beam(tail, head, spec.core * TRACER_CORE, spec.hot, NS({ NSK(0, 1), NSK(0.6, 0.2), NSK(1, 0) })),
			beam(tail, head, spec.glow * TRACER_GLOW, spec.color, NS({ NSK(0, 1), NSK(0.7, 0.55), NSK(1, 0.25) })),
		}
		entry.widths = { spec.core * TRACER_CORE, spec.glow * TRACER_GLOW }
		entry.tail, entry.head = tail, head
		entry.destroy = function()
			tail:Destroy()
			head:Destroy()
		end
		if spec.speed == 0 then
			-- Energy: the whole line at once, fading.
			head.WorldPosition = target
			entry.instant = true
		end
	end
	table.insert(flying, entry)
end

--------------------------------------------------------------------------------
-- Spent cases and dropped magazines
--------------------------------------------------------------------------------

-- Thrown things fall, bounce off whatever they land on and lie there a while before fading. The
-- physics is a raycast step rather than real parts in the solver: a case weighs nothing, and a hundred
-- of them rattling against a player's feet should cost nothing.
local thrown = {}
local MAX_THROWN = 70
local castParams = RaycastParams.new()
castParams.FilterType = Enum.RaycastFilterType.Exclude

local CASE = {
	rifle = { length = 0.17, diameter = 0.04, color = Color3.fromRGB(206, 162, 82) },
	pistol = { length = 0.075, diameter = 0.038, color = Color3.fromRGB(206, 162, 82) },
	shell = { length = 0.25, diameter = 0.078, color = Color3.fromRGB(176, 34, 36) },
}

GunFx.IgnoreList = {}

-- Called with (position, kind) the first time a spent case hits something, for its tink. Set by
-- CombatClient; nil means silent.
GunFx.OnCasingLand = nil

local function track(model, parts, velocity, spin, life, sizeHint, casing)
	if #thrown &gt;= MAX_THROWN then
		local oldest = table.remove(thrown, 1)
		oldest.model:Destroy()
	end
	local pivot = model:GetPivot()
	local offsets = {}
	for _, part in ipairs(parts) do
		offsets[part] = pivot:ToObjectSpace(part.CFrame)
	end
	table.insert(thrown, {
		model = model, parts = parts, offsets = offsets, cframe = pivot, velocity = velocity, spin = spin,
		age = 0, life = life, resting = false, radius = sizeHint or 0.05, casing = casing,
	})
end

function GunFx.Casing(cframe, kind)
	local spec = CASE[kind] or CASE.rifle
	local model = Instance.new("Model")
	model.Name = "BRR_Casing"
	local body = anchoredPart("Case", V(spec.length, spec.diameter, spec.diameter))
	body.Shape = Enum.PartType.Cylinder
	body.Transparency = 0
	body.Color = spec.color
	body.Material = kind == "shell" and Enum.Material.SmoothPlastic or Enum.Material.Metal
	body.Reflectance = kind == "shell" and 0 or 0.12
	body.CFrame = cframe * CFrame.Angles(0, math.random() * 0.4, 0)
	body.Parent = model
	if kind == "shell" then
		local base = anchoredPart("CaseBase", V(spec.length * 0.2, spec.diameter * 1.06, spec.diameter * 1.06))
		base.Shape = Enum.PartType.Cylinder
		base.Transparency = 0
		base.Color = Color3.fromRGB(206, 162, 82)
		base.Material = Enum.Material.Metal
		base.CFrame = body.CFrame * CFrame.new(spec.length * 0.42, 0, 0)
		base.Parent = model
	end
	model.Parent = effects()
	-- Out of the port, up and a little back, tumbling.
	local out = cframe.LookVector
	local velocity = out * (5 + math.random() * 2.5) + cframe.UpVector * (3 + math.random() * 2) + cframe.ZVector * (0.5 + math.random())
	local spin = V(math.random() * 30 - 15, math.random() * 30 - 15, math.random() * 30 - 15)
	track(model, model:GetChildren(), velocity, spin, 4, spec.length * 0.5, CASE[kind] and kind or "rifle")
end

function GunFx.Drop(model, up)
	model.Name = "BRR_DroppedMag"
	local parts = {}
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = true
			table.insert(parts, part)
		end
	end
	if #parts == 0 then
		model:Destroy()
		return
	end
	model.PrimaryPart = parts[1]
	model.Parent = effects()
	local _, size = model:GetBoundingBox()
	local velocity = -(up or Vector3.yAxis) * 2 + V(math.random() - 0.5, 0, math.random() - 0.5)
	track(model, parts, velocity, V(math.random() * 4 - 2, math.random() * 2 - 1, math.random() * 4 - 2), 7, math.min(size.X, size.Y, size.Z) * 0.5)
end

--------------------------------------------------------------------------------
-- Impacts
--------------------------------------------------------------------------------

local impactHost = nil
function GunFx.Impact(position, normal)
	if not impactHost or not impactHost.part.Parent then
		local part = anchoredPart("BRR_ImpactHost")
		part.Parent = effects()
		local attachment = Instance.new("Attachment")
		attachment.Parent = part
		impactHost = {
			part = part,
			sparks = emitter(attachment, "Sparks", {
				Texture = TEXTURE.sparks,
				LightEmission = 1,
				Color = CS(Color3.fromRGB(255, 220, 160)),
				Lifetime = NumberRange.new(0.1, 0.3),
				Speed = NumberRange.new(6, 16),
				EmissionDirection = Enum.NormalId.Top,
				SpreadAngle = Vector2.new(50, 50),
				Acceleration = V(0, -30, 0),
				Size = NS({ NSK(0, 0.06), NSK(1, 0.01) }),
				Transparency = NS({ NSK(0, 0), NSK(1, 1) }),
			}),
			dust = emitter(attachment, "Dust", {
				Texture = TEXTURE.smoke,
				LightInfluence = 1,
				Color = CS(Color3.fromRGB(170, 160, 148)),
				Lifetime = NumberRange.new(0.4, 0.8),
				Speed = NumberRange.new(1, 3),
				EmissionDirection = Enum.NormalId.Top,
				SpreadAngle = Vector2.new(35, 35),
				Drag = 4,
				Size = NS({ NSK(0, 0.2), NSK(1, 0.8) }),
				Transparency = NS({ NSK(0, 0.55), NSK(1, 1) }),
			}),
		}
	end
	normal = normal or Vector3.yAxis
	local up = math.abs(normal.Y) &lt; 0.99 and Vector3.yAxis or Vector3.xAxis
	impactHost.part.CFrame = CFrame.lookAt(position, position + normal, up) * CFrame.Angles(-math.pi / 2, 0, 0)
	impactHost.sparks:Emit(math.random(3, 6))
	impactHost.dust:Emit(2)
end

--------------------------------------------------------------------------------
-- The loop
--------------------------------------------------------------------------------

-- Sets a streak's two beams to their base widths times `fade`, widened for distance from the camera
-- (measured to the nearest point of the streak, which is what the eye judges it by).
local function sizeBeams(entry, tailPos, headPos, fade, cameraPos, pixelsPerStud)
	local scale = fade
	if cameraPos then
		local line = headPos - tailPos
		local lengthSquared = line:Dot(line)
		local t = lengthSquared &gt; 0 and math.clamp((cameraPos - tailPos):Dot(line) / lengthSquared, 0, 1) or 0
		scale *= GunFx.TracerWidthScale((tailPos + line * t - cameraPos).Magnitude, pixelsPerStud)
	end
	for index, b in ipairs(entry.beams) do
		local width = entry.widths[index] * scale
		b.Width0 = width * 0.35
		b.Width1 = width
	end
end

RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 0.1)

	local camera = workspace.CurrentCamera
	local cameraPos, pixelsPerStud = nil, nil
	if camera and #flying &gt; 0 then
		cameraPos = camera.CFrame.Position
		pixelsPerStud = camera.ViewportSize.Y / (2 * math.tan(math.rad(camera.FieldOfView) / 2))
	end

	for index = #flying, 1, -1 do
		local entry = flying[index]
		local spec = entry.spec
		entry.age += dt
		if entry.instant then
			local fade = entry.age / (spec.life or 0.25)
			if fade &gt;= 1 then
				entry.destroy()
				table.remove(flying, index)
				if entry.onArrive then
					entry.onArrive()
				end
			else
				sizeBeams(entry, entry.origin, entry.origin + entry.direction * entry.distance, 1, cameraPos, pixelsPerStud)
			end
		elseif entry.arrived then
			-- Afterglow: the head sits on the target, the tail runs on into it and the streak thins out.
			local since = entry.age - entry.arrived
			local fade = GunFx.TracerFade(since)
			if not fade then
				entry.destroy()
				table.remove(flying, index)
			else
				local headPos = entry.origin + entry.direction * entry.distance
				local tailAt = math.min(entry.distance, math.max(0, entry.distance + spec.speed * since - spec.streak * TRACER_STREAK))
				local tailPos = entry.origin + entry.direction * tailAt
				entry.tail.WorldPosition = tailPos
				sizeBeams(entry, tailPos, headPos, fade, cameraPos, pixelsPerStud)
			end
		else
			entry.travelled = math.min(entry.distance, entry.travelled + spec.speed * dt)
			local head = entry.origin + entry.direction * entry.travelled
			if entry.model then
				local look = CFrame.lookAt(head, head + entry.direction)
				if spec.projectile == "bubble" then
					look = look * CFrame.new(math.sin(entry.age * 18) * 0.08, math.cos(entry.age * 14) * 0.08, 0)
				elseif spec.projectile == "ball" or spec.projectile == "keycap" then
					look = look * CFrame.Angles(entry.age * 12, entry.age * 7, 0)
				elseif spec.projectile == "leaf" then
					-- A leaf turns over and slips from side to side as it flies.
					look = look * CFrame.new(math.sin(entry.age * 9) * 0.22, 0, 0)
						* CFrame.Angles(entry.age * 5, math.sin(entry.age * 7) * 0.6, entry.age * 11)
				elseif spec.projectile == "streamer" then
					look = look * CFrame.Angles(0, 0, math.sin(entry.age * 14) * 0.5)
				end
				local parts, cframes = {}, {}
				for _, part in ipairs(entry.parts) do
					if part:IsA("BasePart") and entry.offsets[part] then
						parts[#parts + 1] = part
						cframes[#cframes + 1] = look * entry.offsets[part]
					end
				end
				if entry.trailHost then
					parts[#parts + 1] = entry.trailHost
					cframes[#cframes + 1] = look
				end
				workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
			else
				local tailPos = entry.origin + entry.direction * math.max(0, entry.travelled - spec.streak * TRACER_STREAK)
				entry.head.WorldPosition = head
				entry.tail.WorldPosition = tailPos
				sizeBeams(entry, tailPos, head, 1, cameraPos, pixelsPerStud)
			end
			if entry.travelled &gt;= entry.distance then
				if entry.trail then
					-- Let the smoke already in the air drift off before the host goes.
					entry.trail.Enabled = false
					local model = entry.model
					for _, part in ipairs(entry.parts) do
						if part:IsA("BasePart") and part ~= entry.trailHost then
							part.Transparency = 1
						end
					end
					task.delay(1.5, function()
						model:Destroy()
					end)
					table.remove(flying, index)
				elseif entry.beams then
					-- A streak stays for its afterglow; the impact still lands now, and only once.
					entry.arrived = entry.age
				else
					entry.destroy()
					table.remove(flying, index)
				end
				local onArrive = entry.onArrive
				entry.onArrive = nil
				if onArrive then
					onArrive()
				end
			end
		end
	end

	-- Rebuilding the filter copies the whole ignore list, so only on frames something is falling.
	if #thrown &gt; 0 then
		castParams.FilterDescendantsInstances = { effects(), table.unpack(GunFx.IgnoreList) }
	end
	for index = #thrown, 1, -1 do
		local entry = thrown[index]
		entry.age += dt
		if entry.age &gt; entry.life or not entry.model.Parent then
			entry.model:Destroy()
			table.remove(thrown, index)
		else
			if not entry.resting then
				entry.velocity += V(0, -workspace.Gravity * 0.45 * dt, 0)
				local step = entry.velocity * dt
				local from = entry.cframe.Position
				local hit = workspace:Raycast(from, step + step.Unit * entry.radius, castParams)
				if hit then
					if entry.casing and not entry.landed then
						entry.landed = true
						if GunFx.OnCasingLand then
							GunFx.OnCasingLand(hit.Position, entry.casing)
						end
					end
					local normal = hit.Normal
					local along = entry.velocity - normal * entry.velocity:Dot(normal)
					local bounce = -normal * entry.velocity:Dot(normal) * 0.32
					entry.velocity = along * 0.55 + bounce
					entry.spin *= 0.5
					entry.cframe = CFrame.new(hit.Position + normal * entry.radius) * entry.cframe.Rotation
					if entry.velocity.Magnitude &lt; 1.2 then
						entry.resting = true
					end
				else
					entry.cframe = (entry.cframe + step) * CFrame.Angles(entry.spin.X * dt, entry.spin.Y * dt, entry.spin.Z * dt)
				end
				local parts, cframes = {}, {}
				for _, part in ipairs(entry.parts) do
					parts[#parts + 1] = part
					cframes[#cframes + 1] = entry.cframe * entry.offsets[part]
				end
				workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
			end
			local fadeFrom = entry.life - 0.8
			if entry.age &gt; fadeFrom then
				local alpha = (entry.age - fadeFrom) / 0.8
				for _, part in ipairs(entry.parts) do
					part.LocalTransparencyModifier = alpha
				end
			end
		end
	end
end)

return GunFx
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX159"><Properties><string name="Name">GunnerView</string><ProtectedString name="Source">-- The gunner's first-person view of a vehicle's turret (Oliver 09-24: "make the car guns controllable
-- by a gunner seat which has first-person animations and a working sight").
--
--   local view = GunnerView.Start(vehicle, spec, options)   -&gt; view, or nil if the mount can't carry one
--   view:Update(dt, state)   state = { ammo, magazine, ready } -&gt; once a frame, from VehicleWeaponClient
--   view:Fired()             the local shot went (the gun kicks, the view shakes, the hands ride it)
--   view:AimPoint()          -&gt; the world point the server is to fire through: along the barrel as it is
--   view.yaw, view.pitch     the mount's angles now (degrees), for the aim remote and the HUD
--   view:Stop()              the normal camera back, the arms gone, the body shown
--
-- WHAT YOU SEE. The camera sits at the gunner's eye (VehicleModels' GunnerEye marker on TurretYaw) and
-- looks along the barrel: it rides the turret round and tips with it (a lobbing mortar's view instead
-- follows where its bomb will come down, so the ground it is ranging on stays on the screen). The
-- mouse (or the right stick, or a drag on a touch screen) turns the TURRET, at most `slew` degrees a
-- second, and the view goes with it. Aiming down the sight (right mouse, L2, the AIM button) moves the
-- eye to the gun's own sight (GunnerSight: iron sights on the machine guns, the launcher's side sight,
-- the mortar's) and narrows the view.
--
-- THE ARMS are the player's own (Viewmodel.Arms: the avatar's arms, colours and shirt), their palms on
-- the gun's handles (GripR, GripL), posed by the viewmodel's own two-bone reach every frame, so when the
-- gun kicks or tips the hands go with it. While the mount is not ready -- run dry, or a belt too hot --
-- the right hand goes to load it (ReloadHand: the ammo box, the spare rockets, the bombs) and back.
--
-- THE SIGHT shows exactly where the shot will land. The barrel's ray is worked out from the mount as it
-- is swung now (VehicleWeaponData.Turn, the same maths the server's VehicleWeaponData.Solve uses), and
-- the aim sent to the server is a point far along that very ray, so the server fires along it. A bullet
-- is traced along the ray; a rocket or a grenade is flown along Ballistics.RoundState (drop and all,
-- the same function the server's round flies by), segment by segment, until it meets something. That
-- point, projected onto the screen, is the ring; the small cross is the middle of the view. The two
-- sit together at range and part close in (the eye is above the bore) and wherever a round drops.
--
-- tools/gunner_sight_check.py runs this module's PURE block against the real VehicleModels mounts and
-- VehicleWeaponData.Solve; tools/gunner_fp_gallery.lua shows it in Studio.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local VehicleWeaponData = require(Shared:WaitForChild("VehicleWeaponData"))
local Ballistics = require(Shared:WaitForChild("Ballistics"))

local GunnerView = {}
GunnerView.__index = GunnerView

-- PURE BEGIN (plain Lua and Vector3/CFrame arithmetic; tools/gunner_sight_check.py runs it)
local Pure = {}

-- How far the view narrows aiming down each kind of sight, as a share of the field of view.
Pure.Zoom = { iron = 0.62, scope = 0.42, lob = 0.55 }
-- What a shot does to the gun (degrees of kick up, studs back) and to the view (degrees of shake).
Pure.Kick = {
	hitscan = { pitch = 1.1, back = 0.07, shake = 0.35 },
	heavy = { pitch = 1.6, back = 0.1, shake = 0.5 },
	rocket = { pitch = 4.5, back = 0.22, shake = 1.2 },
	grenade = { pitch = 2.6, back = 0.14, shake = 0.8 },
	lob = { pitch = 3.5, back = 0.18, shake = 1.0 },
}
-- Degrees the view turns per pixel of mouse at 1x sensitivity, and per second at full stick.
Pure.MouseDegrees = 0.22
Pure.StickDegrees = 150
Pure.TouchDegrees = 0.3

-- Whether a spec lobs its round (the mortar): a grenade that can't fire below level.
function Pure.lobs(spec)
	return spec.kind == "round" and spec.projectile == "grenade" and spec.pitchMin &gt;= 0
end

function Pure.sightKind(spec)
	if Pure.lobs(spec) then
		return "lob"
	end
	return spec.projectile == "rocket" and "scope" or "iron"
end

function Pure.kickOf(spec)
	if Pure.lobs(spec) then
		return Pure.Kick.lob
	end
	if spec.kind == "round" then
		return Pure.Kick[spec.projectile] or Pure.Kick.grenade
	end
	return spec.damageClass == "heavy" and Pure.Kick.heavy or Pure.Kick.hitscan
end

-- A wanted look (degrees) held inside the mount's arc: yaw to +-yawLimit (all round wraps), pitch to
-- the floor at that yaw (the front guard's, inside its arc) and pitchMax.
function Pure.clampLook(spec, yaw, pitch)
	if spec.yawLimit &gt;= 180 then
		yaw = (yaw + 180) % 360 - 180
	else
		yaw = math.clamp(yaw, -spec.yawLimit, spec.yawLimit)
	end
	local floor = math.deg(VehicleWeaponData.PitchFloor(spec, math.rad(yaw)))
	return yaw, math.clamp(pitch, floor, spec.pitchMax)
end

-- The turret's angle moved toward the wanted one by at most `step` degrees, the short way round.
function Pure.slew(from, to, step, wraps)
	local delta = to - from
	if wraps then
		delta = (delta + 180) % 360 - 180
	end
	if math.abs(delta) &lt;= step then
		return to
	end
	local out = from + (delta &gt; 0 and step or -step)
	if wraps then
		out = (out + 180) % 360 - 180
	end
	return out
end

-- The barrel's ray at (yaw, pitch) degrees, world space: `rest` the yaw pivot's frame at rest,
-- `pivot` the pitch pivot and `muzzle` the muzzle as VehicleWeaponData.Solve takes them.
function Pure.barrel(rest, pivot, muzzle, yaw, pitch)
	local y, p = math.rad(yaw), math.rad(pitch)
	local origin = rest:PointToWorldSpace(VehicleWeaponData.Turn(pivot, y, 0) + VehicleWeaponData.Turn(muzzle, y, p))
	local direction = rest:VectorToWorldSpace(VehicleWeaponData.Turn(Vector3.new(0, 0, -1), y, p))
	return origin, direction
end

-- Where a shot along (origin, direction) comes down. `cast(from, to)` returns the first hit's position
-- or nil. A bullet is one cast out to the spec's range; a round flies Ballistics.RoundState (boost,
-- sustainer and drop, the server's own flight) in `step`-second pieces until it meets something or
-- its time is up. Returns the point and whether it was a hit (false: the end of its reach, in the air).
function Pure.impact(spec, round, origin, direction, gravity, cast, step)
	if spec.kind ~= "round" or not round then
		local reach = origin + direction * (spec.range or 400)
		local hit = cast(origin, reach)
		return hit or reach, hit ~= nil
	end
	step = step or 0.04
	local last = origin
	local t = 0
	local maxTime = round.maxTime or 3
	while t &lt; maxTime do
		t = math.min(maxTime, t + step)
		local position = Ballistics.RoundState(round, origin, direction, gravity, t)
		local hit = cast(last, position)
		if hit then
			return hit, true
		end
		last = position
	end
	return last, false
end

-- A damped spring toward zero, one sub-step: `k` stiffness, `c` damping.
function Pure.spring(value, velocity, dt, k, c)
	velocity = velocity + (-k * value - c * velocity) * dt
	return value + velocity * dt, velocity
end

function Pure.smooth(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end
-- PURE END

GunnerView.Pure = Pure

local player = Players.LocalPlayer

local function settings()
	local ok, Settings = pcall(function()
		return require(script.Parent:WaitForChild("Settings", 2))
	end)
	return ok and type(Settings) == "table" and Settings or nil
end

local function jointOf(part)
	local joint = part and part:FindFirstChild("Joint")
	return joint and joint:IsA("Motor6D") and joint or nil
end

-- Everything a sight's trace must pass through: the vehicle and whoever rides in it, and the game's
-- own non-solid folders (as the server's bullet, VehicleWeapons).
local function sightParams(vehicle)
	local filter = { vehicle }
	for _, child in ipairs(vehicle:GetChildren()) do
		if (child:IsA("Seat") or child:IsA("VehicleSeat")) and child.Occupant and child.Occupant.Parent then
			table.insert(filter, child.Occupant.Parent)
		end
	end
	for _, name in ipairs({ "Loot", "Effects", "DeathFx" }) do
		local instance = workspace:FindFirstChild(name)
		if instance then
			table.insert(filter, instance)
		end
	end
	local camera = workspace.CurrentCamera
	table.insert(filter, camera)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	params.FilterDescendantsInstances = filter
	return params
end

local function makeGui(parent)
	local gui = Instance.new("ScreenGui")
	gui.Name = "GunnerSight"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 2
	gui.Parent = parent or player:WaitForChild("PlayerGui")
	-- The middle of the view: a small open cross.
	local cross = Instance.new("Frame")
	cross.Name = "Cross"
	cross.AnchorPoint = Vector2.new(0.5, 0.5)
	cross.Position = UDim2.fromScale(0.5, 0.5)
	cross.Size = UDim2.fromOffset(22, 22)
	cross.BackgroundTransparency = 1
	cross.Parent = gui
	for index, spec in ipairs({ { 0, -7, 2, 6 }, { 0, 7, 2, 6 }, { -7, 0, 6, 2 }, { 7, 0, 6, 2 } }) do
		local tick = Instance.new("Frame")
		tick.Name = "Tick" .. index
		tick.AnchorPoint = Vector2.new(0.5, 0.5)
		tick.Position = UDim2.new(0.5, spec[1], 0.5, spec[2])
		tick.Size = UDim2.fromOffset(spec[3], spec[4])
		tick.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		tick.BackgroundTransparency = 0.25
		tick.BorderSizePixel = 0
		tick.Parent = cross
	end
	-- Where the shot lands: a ring with a dot, and (for a round) its range under it.
	local ring = Instance.new("Frame")
	ring.Name = "Impact"
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromScale(0.5, 0.5)
	ring.Visible = false -- until the first frame has placed it
	ring.Size = UDim2.fromOffset(20, 20)
	ring.BackgroundTransparency = 1
	ring.Parent = gui
	Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(255, 214, 90)
	stroke.Parent = ring
	local dot = Instance.new("Frame")
	dot.Name = "Dot"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(4, 4)
	dot.BackgroundColor3 = Color3.fromRGB(255, 214, 90)
	dot.BorderSizePixel = 0
	dot.Parent = ring
	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
	local range = Instance.new("TextLabel")
	range.Name = "Range"
	range.AnchorPoint = Vector2.new(0.5, 0)
	range.Position = UDim2.new(0.5, 0, 1, 6)
	range.Size = UDim2.fromOffset(90, 14)
	range.BackgroundTransparency = 1
	range.Font = Enum.Font.GothamBold
	range.TextSize = 12
	range.TextColor3 = Color3.fromRGB(255, 226, 140)
	range.TextStrokeTransparency = 0.4
	range.Parent = ring
	-- The launcher's scope: the edge of the glass, drawn when the view is right down it.
	local scope = Instance.new("Frame")
	scope.Name = "Scope"
	scope.AnchorPoint = Vector2.new(0.5, 0.5)
	scope.Position = UDim2.fromScale(0.5, 0.5)
	scope.Size = UDim2.fromScale(0.62, 0.62)
	scope.SizeConstraint = Enum.SizeConstraint.RelativeYY
	scope.BackgroundTransparency = 1
	scope.Visible = false
	scope.Parent = gui
	Instance.new("UICorner", scope).CornerRadius = UDim.new(1, 0)
	local scopeEdge = Instance.new("UIStroke")
	scopeEdge.Thickness = 10
	scopeEdge.Color = Color3.fromRGB(12, 12, 14)
	scopeEdge.Parent = scope
	for index, spec in ipairs({ { 0.5, 0.5, 0.004, 0.7 }, { 0.5, 0.5, 0.7, 0.004 } }) do
		local line = Instance.new("Frame")
		line.Name = "Hair" .. index
		line.AnchorPoint = Vector2.new(0.5, 0.5)
		line.Position = UDim2.fromScale(spec[1], spec[2])
		line.Size = UDim2.fromScale(spec[3], spec[4])
		line.BackgroundColor3 = Color3.fromRGB(20, 20, 22)
		line.BackgroundTransparency = 0.2
		line.BorderSizePixel = 0
		line.Parent = scope
	end
	return gui, { cross = cross, ring = ring, stroke = stroke, dot = dot, range = range, scope = scope }
end

-- Starts the view on `vehicle`'s turret, or returns nil if the model carries no first-person markers
-- (a stand-in in a harness, a registered kind): VehicleWeaponClient then keeps its plain aim.
-- options: character (for the arms; default the local player's), noInput (a gallery poses it by hand),
-- guiParent (where the sight goes; default the local player's PlayerGui -- a gallery has no player).
function GunnerView.Start(vehicle, spec, options)
	options = options or {}
	local names = VehicleWeaponData.Parts.turret
	local yawPart, pitchPart, muzzle = vehicle:FindFirstChild(names.yaw), vehicle:FindFirstChild(names.pitch), vehicle:FindFirstChild(names.muzzle)
	local yawJoint, pitchJoint = jointOf(yawPart), jointOf(pitchPart)
	local eye = yawPart and yawPart:FindFirstChild("GunnerEye")
	local sight = pitchPart and pitchPart:FindFirstChild("GunnerSight")
	local gripR, gripL = pitchPart and pitchPart:FindFirstChild("GripR"), pitchPart and pitchPart:FindFirstChild("GripL")
	if not (yawJoint and pitchJoint and muzzle and eye and sight and gripR and gripL and yawJoint.Part0) then
		return nil
	end
	local self = setmetatable({}, GunnerView)
	self.vehicle = vehicle
	self.spec = spec
	self.yawPart, self.pitchPart, self.muzzle = yawPart, pitchPart, muzzle
	self.yawJoint, self.pitchJoint = yawJoint, pitchJoint
	self.eye, self.sight, self.gripR, self.gripL = eye, sight, gripR, gripL
	self.reloadHand = (yawPart:FindFirstChild("ReloadHand") or pitchPart:FindFirstChild("ReloadHand"))
	self.reloadOnYaw = yawPart:FindFirstChild("ReloadHand") ~= nil
	-- The mount's shape at rest, in the yaw pivot's own frame (what VehicleWeaponData.Solve takes).
	-- Read off the joints and the pitch pivot's own frame, not the parts' places: the turret may be
	-- swung already (everyone's mounts follow their attributes).
	self.pivot = pitchJoint.C0.Position
	self.mouth = pitchPart.CFrame:VectorToObjectSpace(muzzle.Position - pitchPart.Position)
	self.lobs = Pure.lobs(spec)
	self.sightKind = Pure.sightKind(spec)
	-- A scope is a solid tube: looked through, its own parts (named *Sight*: the body, the lens, the eye
	-- cup, the bracket) are hidden on this screen, or the view down it is the inside of a box.
	self.scopeParts = {}
	if self.sightKind == "scope" then
		for _, part in ipairs(vehicle:GetChildren()) do
			if part:IsA("BasePart") and string.find(part.Name, "Sight") then
				table.insert(self.scopeParts, part)
			end
		end
	end
	self.kick = Pure.kickOf(spec)
	self.round = spec.kind == "round" and Ballistics.Rounds[spec.projectile] or nil
	self.yaw, self.pitch = 0, spec.restPitch or 0
	self.wantYaw, self.wantPitch = self.yaw, self.pitch
	self.viewPitch = -8
	self.aim = 0
	self.aiming = false
	self.kickPitch, self.kickPitchV, self.kickBack, self.kickBackV = 0, 0, 0, 0
	self.shake = 0
	self.reload = 0
	self.stick = Vector2.zero
	self.touch = Vector2.zero
	self.noInput = options.noInput == true
	self.params = sightParams(vehicle)
	self.settings = settings()
	local camera = workspace.CurrentCamera
	self.camera = camera
	self.savedFov = camera.FieldOfView
	self.savedType = camera.CameraType
	camera.CameraType = Enum.CameraType.Scriptable
	-- The avatar's own arms (Viewmodel.Arms); stand-in blocks if the avatar has none.
	local Viewmodel = require(script.Parent:WaitForChild("Viewmodel"))
	local character = options.character or (player and player.Character)
	local container = Instance.new("Model")
	container.Name = "GunnerArms"
	local ok, arms = pcall(Viewmodel.Arms.new, container, character)
	if not ok then
		arms = Viewmodel.Arms.new(container, nil)
	end
	self.arms = arms
	self.armsModel = container
	container.Parent = camera
	self.character = character
	self.gui, self.ui = makeGui(options.guiParent)
	if player then
		player:SetAttribute("GunnerView", true)
	end
	self:hideBody(true)
	if not self.noInput then
		self.connections = {
			UserInputService.InputChanged:Connect(function(input, processed)
				if input.KeyCode == Enum.KeyCode.Thumbstick2 then
					local stick = input.Position
					self.stick = stick.Magnitude &gt; 0.15 and Vector2.new(stick.X, stick.Y) or Vector2.zero
				elseif input.UserInputType == Enum.UserInputType.Touch and not processed then
					self.touch += Vector2.new(input.Delta.X, input.Delta.Y)
				end
			end),
		}
	end
	return self
end

-- The body out of the way of the camera (the arms are the viewmodel's), shown again after.
function GunnerView:hideBody(hide)
	local character = self.character
	if not character then
		return
	end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") or part:IsA("Decal") then
			part.LocalTransparencyModifier = hide and 1 or 0
		end
	end
end

function GunnerView:SetAiming(on)
	self.aiming = on == true
end

-- The look this frame from the mouse, the stick and a touch drag, held to the arc.
function GunnerView:look(dt)
	if self.noInput then
		return
	end
	local fovShare = 1 - self.aim * (1 - (Pure.Zoom[self.sightKind] or 0.6))
	local aimSens = self.settings and tonumber(self.settings.Get("AimSensitivity")) or 0.7
	local scale = fovShare * (1 - self.aim + self.aim * aimSens)
	local menu = player ~= nil and player:GetAttribute("MenuOpen") == true
	if not menu then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		local delta = UserInputService:GetMouseDelta()
		self.wantYaw -= delta.X * Pure.MouseDegrees * scale
		self.wantPitch -= delta.Y * Pure.MouseDegrees * scale
	end
	self.wantYaw -= self.stick.X * Pure.StickDegrees * scale * dt
	self.wantPitch += self.stick.Y * Pure.StickDegrees * scale * dt
	self.wantYaw -= self.touch.X * Pure.TouchDegrees * scale
	self.wantPitch -= self.touch.Y * Pure.TouchDegrees * scale
	self.touch = Vector2.zero
	self.wantYaw, self.wantPitch = Pure.clampLook(self.spec, self.wantYaw, self.wantPitch)
end

-- The yaw pivot's frame at rest (the chassis moves; the frame follows it) and as turned now.
function GunnerView:frames()
	local rest = self.yawJoint.Part0.CFrame * self.yawJoint.C0
	local yawFrame = rest * CFrame.Angles(0, math.rad(self.yaw), 0)
	local pitchFrame = yawFrame * self.pitchJoint.C0 * CFrame.Angles(math.rad(self.pitch + self.kickPitch), 0, 0)
		* CFrame.new(0, 0, self.kickBack)
	return rest, yawFrame, pitchFrame
end

function GunnerView:AimPoint()
	local rest = self.yawJoint.Part0.CFrame * self.yawJoint.C0
	local origin, direction = Pure.barrel(rest, self.pivot, self.mouth, self.yaw, self.pitch)
	return origin + direction * 1000, origin, direction
end

function GunnerView:Fired()
	self.kickPitchV += self.kick.pitch * 60
	self.kickBackV += self.kick.back * 60
	self.shake = math.min(1.5, self.shake + self.kick.shake)
end

-- One frame. `state` = { ready = bool } from VehicleWeaponClient (the mount's ammo and heat).
function GunnerView:Update(dt, state)
	if not self.vehicle.Parent or not self.yawJoint.Part0 then
		return
	end
	dt = math.min(dt, 0.1)
	self:look(dt)
	local step = (self.spec.slew or 240) * dt
	self.yaw = Pure.slew(self.yaw, self.wantYaw, step, self.spec.yawLimit &gt;= 180)
	self.pitch = Pure.slew(self.pitch, self.wantPitch, step, false)
	-- The kick springs back, sub-stepped.
	local left = dt
	while left &gt; 1e-4 do
		local h = math.min(left, 1 / 120)
		self.kickPitch, self.kickPitchV = Pure.spring(self.kickPitch, self.kickPitchV, h, 220, 22)
		self.kickBack, self.kickBackV = Pure.spring(self.kickBack, self.kickBackV, h, 260, 26)
		left -= h
	end
	self.shake = math.max(0, self.shake - dt * 4)
	self.aim += ((self.aiming and 1 or 0) - self.aim) * math.min(1, dt * 12)
	-- The local turret, kick and all (VehicleWeaponClient leaves this one alone while the view runs).
	self.yawJoint.Transform = CFrame.Angles(0, math.rad(self.yaw), 0)
	self.pitchJoint.Transform = CFrame.Angles(math.rad(self.pitch + self.kickPitch), 0, 0) * CFrame.new(0, 0, self.kickBack)

	local rest, yawFrame, pitchFrame = self:frames()
	-- Where the shot will land, from the barrel as it is (no kick: the server fires the barrel's line).
	local origin, direction = Pure.barrel(rest, self.pivot, self.mouth, self.yaw, self.pitch)
	local params = self.params
	local impact, hit = Pure.impact(self.spec, self.round, origin, direction, workspace.Gravity, function(from, to)
		local result = workspace:Raycast(from, to - from, params)
		return result and result.Position or nil
	end)
	self.impact, self.impactHit = impact, hit

	-- The camera: the eye, turned with the yaw and tipped with the barrel (or, lobbing, toward where the
	-- bomb comes down); aiming, at the sight.
	local hipEye = yawFrame * self.eye.CFrame
	local lookPitch = self.pitch + self.kickPitch
	if self.lobs then
		local flat = Vector3.new(impact.X - hipEye.X, 0, impact.Z - hipEye.Z).Magnitude
		local want = math.clamp(math.deg(math.atan2(impact.Y - hipEye.Y, math.max(flat, 1))), -40, 12)
		self.viewPitch += (want - self.viewPitch) * math.min(1, dt * 6)
		lookPitch = self.viewPitch
	end
	local hipView = CFrame.new(hipEye.Position) * (yawFrame - yawFrame.Position) * CFrame.Angles(math.rad(lookPitch), 0, 0)
	local sightView = pitchFrame * self.sight.CFrame
	if self.lobs then
		-- A mortar is laid by where its bomb comes down, not along its tube: aiming only zooms the view
		-- (from beside the tube, the sight's own spot, the van's roof load filled the picture).
		sightView = hipView
	end
	local view = hipView:Lerp(sightView, Pure.smooth(self.aim))
	if self.shake &gt; 0 then
		local s = self.shake
		view = view * CFrame.Angles(math.rad((math.random() - 0.5) * s), math.rad((math.random() - 0.5) * s), math.rad((math.random() - 0.5) * s * 0.6))
	end
	local camera = self.camera
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = view
	local baseFov = self.settings and tonumber(self.settings.Get("FieldOfView")) or self.savedFov or 70
	camera.FieldOfView = baseFov * (1 - Pure.smooth(self.aim) * (1 - (Pure.Zoom[self.sightKind] or 0.6)))

	-- The hands: on the grips, the right one off to load while the mount isn't ready.
	local ready = state == nil or state.ready ~= false
	self.reload = ready and math.max(0, self.reload - dt * 2.5) or (self.reload + dt / 1.2)
	local right = pitchFrame * self.gripR.CFrame
	local left = pitchFrame * self.gripL.CFrame
	if not ready or self.reload &gt; 0 then
		local phase = ready and 0 or (self.reload % 1)
		local out = Pure.smooth(math.min(1, phase * 3)) * (1 - Pure.smooth(math.max(0, phase * 3 - 2)))
		if ready then
			out = self.reload
		end
		local loadFrame = self.reloadHand and ((self.reloadOnYaw and yawFrame or pitchFrame) * self.reloadHand.CFrame) or right * CFrame.new(0, 0.3, 0.4)
		right = right:Lerp(loadFrame, math.clamp(out, 0, 1))
	end
	local parts, cframes = {}, {}
	self.arms:pose(1, view, right, 0.9, parts, cframes)
	self.arms:pose(-1, view, left, 0.9, parts, cframes)
	workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	-- The scope's glass only when the view is right down the launcher's sight.
	local scoped = self.sightKind == "scope" and self.aim &gt; 0.9
	self.arms:SetHidden(scoped)
	if scoped ~= self.scopeHidden then
		self.scopeHidden = scoped
		for _, part in ipairs(self.scopeParts) do
			part.LocalTransparencyModifier = scoped and 1 or 0
		end
	end
	self.ui.scope.Visible = scoped
	self:placeSight(view, impact, hit)
	self:hideBody(true)
end

function GunnerView:placeSight(view, impact, hit)
	local camera = self.camera
	local screen, onScreen = camera:WorldToViewportPoint(impact)
	local ui = self.ui
	ui.ring.Visible = onScreen
	if onScreen then
		ui.ring.Position = UDim2.fromOffset(screen.X, screen.Y)
	end
	local color = hit and Color3.fromRGB(255, 214, 90) or Color3.fromRGB(170, 174, 184)
	ui.stroke.Color = color
	ui.dot.BackgroundColor3 = color
	local distance = (impact - view.Position).Magnitude
	ui.range.Text = self.spec.kind == "round" and string.format("%d", math.floor(distance + 0.5)) or ""
	ui.cross.Visible = not self.lobs
end

function GunnerView:Stop()
	if self.stopped then
		return
	end
	self.stopped = true
	for _, connection in ipairs(self.connections or {}) do
		connection:Disconnect()
	end
	if self.armsModel then
		self.armsModel:Destroy()
	end
	if self.gui then
		self.gui:Destroy()
	end
	self:hideBody(false)
	for _, part in ipairs(self.scopeParts or {}) do
		part.LocalTransparencyModifier = 0
	end
	if player then
		player:SetAttribute("GunnerView", nil)
	end
	local camera = self.camera
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = self.settings and tonumber(self.settings.Get("FieldOfView")) or self.savedFov or 70
	local humanoid = player and player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
	if not self.noInput then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end

return GunnerView
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX160"><Properties><string name="Name">GunPoseClient</string><ProtectedString name="Source">-- Third-person arm pose for anyone holding a gun.
--
-- WeaponService mounts every gun with its grip where a raised right hand is. This raises the arms
-- to match: the right hand on the grip and the left reaching forward to support the gun, so
-- everyone — other players and bots alike — reads as aiming rather than walking around with a
-- gun floating in front of their chest.
--
-- It runs locally on every client, for every nearby character. A joint's Transform is written by
-- the Animator each frame; setting it in Stepped, which runs straight after animations, overrides
-- the arms for that frame while the walk and idle animations keep driving the rest of the body.
-- R15 rigs only: R6 shoulders use different joint axes. Both rig formats work: classic Motor6D
-- joints and the AnimationConstraint joints of current physics rigs (every bot).
--
-- Reloading and aiming (#13) are drawn from the first-person viewmodel's own tables, so what others see
-- is the reload you see: while a body's `Reloading` attribute holds the reload's length in seconds, the
-- left arm follows the gun's first-person reload clip (Viewmodel.ClipFor / BodyArm) -- to the magazine,
-- the pouch, back, the charging handle -- on the same timing. While `Aiming` is set the gun comes up to
-- the eye line and the arms go with it (below), and the head cants down onto the stock. Both attributes
-- are the server's to publish (WeaponService.Reload and CombatService.SetAiming).
--
-- The gun is mounted on the torso by a Motor6D, `GunMount` (WeaponService.MountGun). Raising it is that
-- joint's Transform, which like every joint Transform here is local to this client: the server's gun and
-- its shot origins never move, and your own HeldGun stays hidden in first person as before.

local RunService = game:GetService("RunService")
local Viewmodel = require(script.Parent:WaitForChild("Viewmodel"))

-- Both arms swing forward (pitch) and turn in toward the gun (yaw). Yaw is applied after pitch so
-- it turns the raised arm rather than twisting the hanging one.
local RIGHT_SHOULDER = CFrame.Angles(0, math.rad(10), 0) * CFrame.Angles(math.rad(82), 0, 0)
local LEFT_SHOULDER = CFrame.Angles(0, math.rad(-38), 0) * CFrame.Angles(math.rad(78), 0, 0)
local RIGHT_ELBOW = CFrame.Angles(math.rad(6), 0, 0)
local LEFT_ELBOW = CFrame.Angles(math.rad(14), 0, 0)

-- Holding an item (a potion, a med kit) is one-handed: the right arm is held out lower with the
-- elbow bent, and the left arm is left to the walk animation.
local ITEM_SHOULDER = CFrame.Angles(0, math.rad(-12), 0) * CFrame.Angles(math.rad(58), 0, 0)
local ITEM_ELBOW = CFrame.Angles(math.rad(34), 0, 0)

-- Sprinting (the character's `Sprinting` attribute, published by the server's MovementService): the gun
-- comes down to a low ready across the body and the chest leans into the run, the third-person twin of
-- the first-person dip in Viewmodel (#13, #89). Shoulders pitched forward less and turned further in,
-- elbows bent so the muzzle points at the ground ahead. An item hand just swings with the run.
local SPRINT_RIGHT_SHOULDER = CFrame.Angles(0, math.rad(28), 0) * CFrame.Angles(math.rad(34), 0, 0)
local SPRINT_LEFT_SHOULDER = CFrame.Angles(0, math.rad(-46), 0) * CFrame.Angles(math.rad(46), 0, 0)
local SPRINT_RIGHT_ELBOW = CFrame.Angles(math.rad(62), 0, 0)
local SPRINT_LEFT_ELBOW = CFrame.Angles(math.rad(70), 0, 0)
-- A positive X tips the chest back on an R15 Waist (Shared/Parkour), so the lean is negative.
local SPRINT_WAIST = CFrame.Angles(math.rad(-10), 0, 0)
-- As Viewmodel: standing still with sprint held is not a sprint. Studs per second, flat.
local SPRINT_MIN_SPEED = 4
-- How fast the pose eases in and out, per second: Viewmodel's 9.
local SPRINT_EASE = 9
-- Aimed, the cheek goes down onto the stock: the head pitched down, turned and tilted toward the gun
-- side. On an R15 Neck a positive X tips the head back and positive Y and Z turn and tilt it to the
-- left, so all three are negative. Eased at Viewmodel's aiming rate (13).
local AIM_NECK = CFrame.Angles(math.rad(-6), math.rad(-10), math.rad(-8))
local AIM_EASE = 13
-- Aimed, the sight comes to the eye line: level with the eyes, in front of the right eye, and no nearer
-- the face than AIM_RELIEF. The eye is read off the rig (the Neck), a little forward of the head's middle.
local AIM_EYE = Vector3.new(0, 0.1, -0.45)
local AIM_RIGHT_EYE = 0.18
local AIM_RELIEF = 0.55

local SCAN_INTERVAL = 0.5
local POSE_DISTANCE = 300

local camera = workspace.CurrentCamera

-- character -&gt; { humanoid, root, joints }
local armed = {}

local function jointsFor(character)
	local function joint(partName, jointName)
		local part = character:FindFirstChild(partName)
		local motor = part and part:FindFirstChild(jointName)
		if not motor then
			-- Physics rigs keep the joint under the part too, but look everywhere to be safe.
			for _, descendant in ipairs(character:GetDescendants()) do
				if descendant.Name == jointName and (descendant:IsA("Motor6D") or descendant:IsA("AnimationConstraint")) then
					motor = descendant
					break
				end
			end
		end
		return motor and (motor:IsA("Motor6D") or motor:IsA("AnimationConstraint")) and motor or nil
	end
	local joints = {
		rightShoulder = joint("RightUpperArm", "RightShoulder"),
		leftShoulder = joint("LeftUpperArm", "LeftShoulder"),
		rightElbow = joint("RightLowerArm", "RightElbow"),
		leftElbow = joint("LeftLowerArm", "LeftElbow"),
		waist = joint("UpperTorso", "Waist"),
		neck = joint("Head", "Neck"),
		rightWrist = joint("RightHand", "RightWrist"),
		leftWrist = joint("LeftHand", "LeftWrist"),
	}
	if not joints.rightShoulder or not joints.leftShoulder then
		return nil
	end
	return joints
end

-- Characters are direct children of the workspace, so a light scan finds everyone holding a gun
-- without listening to every descendant the map adds.
local function scan()
	local seen = {}
	for _, child in ipairs(workspace:GetChildren()) do
		local holdingGun = child:IsA("Model") and child:FindFirstChild("HeldGun") ~= nil
		local holdingItem = child:IsA("Model") and child:FindFirstChild("HeldItem") ~= nil
		if holdingGun or holdingItem then
			local humanoid = child:FindFirstChildOfClass("Humanoid")
			local root = child:FindFirstChild("HumanoidRootPart")
			if humanoid and root then
				seen[child] = true
				if not armed[child] then
					local joints = jointsFor(child)
					if joints then
						armed[child] = { humanoid = humanoid, root = root, joints = joints, sprint = 0, aim = 0 }
					end
				end
				if armed[child] then
					armed[child].item = not holdingGun
				end
			end
		end
	end
	for character in pairs(armed) do
		if not seen[character] then
			armed[character] = nil
		end
	end
end

task.spawn(function()
	while true do
		scan()
		task.wait(SCAN_INTERVAL)
	end
end)

-- Whether this body reads as sprinting right now: the server says so, it is actually moving, and no
-- slide, climb or vault owns the lower body (MovementClient poses those, from the `Parkour` attribute).
local function sprintingNow(character, root)
	if character:GetAttribute("Sprinting") ~= true or character:GetAttribute("Parkour") ~= nil then
		return false
	end
	local velocity = root.AssemblyLinearVelocity
	return Vector3.new(velocity.X, 0, velocity.Z).Magnitude &gt; SPRINT_MIN_SPEED
end

local function blend(from, to, weight)
	return weight &lt;= 0 and from or from:Lerp(to, weight)
end

-- The left arm's turns for a body mid-reload, or nil when it is not reloading. The clip is built once
-- per reload, when the attribute appears, from the gun in the body's hands; the progress is time since
-- then over the reload's length (game time: os.clock is CPU time in Roblox).
local function reloadArm(character, entry, now)
	local seconds = character:GetAttribute("Reloading")
	if type(seconds) ~= "number" or seconds &lt;= 0 then
		entry.reload = nil
		return nil
	end
	if not entry.reload then
		local gun = character:FindFirstChild("HeldGun")
		local clip = gun and Viewmodel.ClipFor(gun, "reload", character:GetAttribute("ReloadEmpty") == true, 1)
		entry.reload = { start = now, clip = clip }
	end
	local progress = math.clamp((now - entry.reload.start) / seconds, 0, 1)
	return Viewmodel.BodyArm(entry.reload.clip, progress)
end

-- A joint's fixed frames either side of its Transform: C0 and C1 for a Motor6D, the two attachments'
-- frames for an AnimationConstraint. Part1 sits at Part0 * c0 * Transform * c1:Inverse().
local function frames(joint)
	if joint:IsA("Motor6D") then
		return joint.C0, joint.C1
	end
	return joint.Attachment0 and joint.Attachment0.CFrame or CFrame.identity,
		joint.Attachment1 and joint.Attachment1.CFrame or CFrame.identity
end

-- Where the hand's grip is, in the upper torso's space, for a shoulder and elbow Transform.
local function handAt(arm, shoulder, elbow)
	local s0, s1 = frames(arm.shoulder)
	local e0, e1 = frames(arm.elbow)
	local w0, w1 = frames(arm.wrist)
	return (s0 * shoulder * s1:Inverse() * e0 * elbow * e1:Inverse() * w0 * w1:Inverse()) * arm.grip
end

-- The shoulder and elbow Transforms that carry this arm's hand from where the held pose puts it to
-- `target` (upper-torso space): the elbow opens or closes until the hand is as far from the shoulder as
-- the target (bisection: the reach grows with the elbow opening), then the shoulder turns the hand onto
-- it, twice over so the turn and the bend settle on each other.
local function reachTo(arm, shoulder, elbow, target)
	local s0, _ = frames(arm.shoulder)
	local pivot = s0.Position
	local want = (target - pivot).Magnitude
	local low, high = 0, math.rad(150)
	local function reach(bend)
		return (handAt(arm, shoulder, CFrame.Angles(bend, 0, 0)) - pivot).Magnitude
	end
	local open, shut = reach(low), reach(high)
	local bend
	if want &gt;= open then
		bend = low
	elseif want &lt;= shut then
		bend = high
	else
		for _ = 1, 24 do
			bend = (low + high) / 2
			if reach(bend) &gt; want then
				low = bend
			else
				high = bend
			end
		end
	end
	elbow = CFrame.Angles(bend, 0, 0)
	local rotation = s0.Rotation
	for _ = 1, 2 do
		local have = (handAt(arm, shoulder, elbow) - pivot).Unit
		local goal = (target - pivot).Unit
		local axis = have:Cross(goal)
		if axis.Magnitude &gt; 1e-6 then
			local turn = CFrame.fromAxisAngle(axis.Unit, math.acos(math.clamp(have:Dot(goal), -1, 1)))
			shoulder = rotation:Inverse() * turn * rotation * shoulder
		end
	end
	return shoulder, elbow
end

-- The aimed pose for a body and the gun in its hands, worked out once per gun: the GunMount Transform
-- that brings the sight to the eye line, and each arm's shoulder and elbow Transforms that keep its hand
-- where it was on the gun. Nil when the body or the gun lacks what it needs (no GunMount, no sight), and
-- the body then aims as before, head only.
local function aimPoseFor(character, joints)
	local gun = character:FindFirstChild("HeldGun")
	local receiver = gun and gun.PrimaryPart
	local mount = receiver and receiver:FindFirstChild("GunMount")
	local sight = gun and gun:GetAttribute("KP_Sight")
	if not (mount and mount:IsA("Motor6D") and sight and joints.neck) then
		return nil
	end
	-- The design origin, where the keypoints are measured from, in the upper torso's space.
	local origin = mount.C0 * mount.C1:Inverse() * (receiver.PivotOffset or CFrame.identity)
	local n0, n1 = frames(joints.neck)
	local eye = (n0 * n1:Inverse()) * AIM_EYE
	local from = (origin * sight).Position
	local to = Vector3.new(eye.X + AIM_RIGHT_EYE, eye.Y, math.min(from.Z, eye.Z - AIM_RELIEF))
	local raise = to - from
	local pose = {
		gun = gun,
		mount = mount,
		raise = CFrame.new(mount.C0:VectorToObjectSpace(raise)),
	}
	for _, side in ipairs({ { "right", "GripHand", RIGHT_SHOULDER, RIGHT_ELBOW }, { "left", "SupportHand", LEFT_SHOULDER, LEFT_ELBOW } }) do
		local name = side[1]
		local arm = {
			shoulder = joints[name .. "Shoulder"],
			elbow = joints[name .. "Elbow"],
			wrist = joints[name .. "Wrist"],
		}
		if arm.shoulder and arm.elbow and arm.wrist then
			-- The middle of the palm, a little below the wrist joint.
			local _, w1 = frames(arm.wrist)
			arm.grip = w1.Position + Vector3.new(0, -0.15, 0)
			-- The hand goes up with the gun, keeping whatever relation the held pose gives it.
			local target = handAt(arm, side[3], side[4]) + raise
			pose[name .. "Shoulder"], pose[name .. "Elbow"] = reachTo(arm, side[3], side[4], target)
		end
	end
	return pose
end

RunService.Stepped:Connect(function(_, delta)
	local focus = camera.CFrame.Position
	local ease = math.clamp(math.min(delta, 0.1) * SPRINT_EASE, 0, 1)
	local aimEase = math.clamp(math.min(delta, 0.1) * AIM_EASE, 0, 1)
	local now = time()
	for character, entry in pairs(armed) do
		if not character.Parent or not entry.root.Parent then
			armed[character] = nil
		elseif entry.humanoid.Health &gt; 0 and (entry.root.Position - focus).Magnitude &lt; POSE_DISTANCE then
			local joints = entry.joints
			entry.sprint += ((sprintingNow(character, entry.root) and 1 or 0) - entry.sprint) * ease
			local sprint = entry.sprint &gt; 0.01 and entry.sprint or 0
			if entry.item then
				-- Blended from what the run animation just wrote, so a sprinting hand swings with it.
				local hand = joints.rightShoulder.Transform
				joints.rightShoulder.Transform = blend(ITEM_SHOULDER, hand, sprint)
				if joints.rightElbow then
					joints.rightElbow.Transform = blend(ITEM_ELBOW, joints.rightElbow.Transform, sprint)
				end
			else
				-- A reload owns the left arm, sprinting or not: first person keeps reloading through a run.
				local shoulder, elbow = reloadArm(character, entry, now)
				entry.aim += ((character:GetAttribute("Aiming") == true and not entry.reload and 1 or 0) - entry.aim) * aimEase
				-- The aimed pose: worked out only for a body that is aiming (or easing out of it), and again when
				-- the gun in hand changes. A body that never aims -- every bot -- never has it built, and its
				-- GunMount and neck are never written.
				local pose = entry.aimPose
				if entry.aim &gt; 0.001 and (pose == nil or (pose and pose.gun.Parent ~= character)) then
					pose = aimPoseFor(character, joints) or false
					entry.aimPose = pose
				end
				-- Aimed and sprinting do not go together; whichever is further in wins the arms.
				local aim = (pose and entry.aim &gt; 0.01) and entry.aim * (1 - sprint) or 0
				local rightShoulder = blend(RIGHT_SHOULDER, SPRINT_RIGHT_SHOULDER, sprint)
				local rightElbow = blend(RIGHT_ELBOW, SPRINT_RIGHT_ELBOW, sprint)
				local leftShoulder = blend(LEFT_SHOULDER, SPRINT_LEFT_SHOULDER, sprint)
				local leftElbow = blend(LEFT_ELBOW, SPRINT_LEFT_ELBOW, sprint)
				if aim &gt; 0 then
					rightShoulder = rightShoulder:Lerp(pose.rightShoulder or rightShoulder, aim)
					rightElbow = rightElbow:Lerp(pose.rightElbow or rightElbow, aim)
					leftShoulder = leftShoulder:Lerp(pose.leftShoulder or leftShoulder, aim)
					leftElbow = leftElbow:Lerp(pose.leftElbow or leftElbow, aim)
				end
				-- The gun is raised only while there is some aim to raise it by, and set back to rest exactly
				-- once when that ends; a body that is not aiming has its GunMount left alone.
				if pose and aim &gt; 0 then
					pose.mount.Transform = CFrame.identity:Lerp(pose.raise, aim)
					entry.raised = true
				elseif pose and entry.raised then
					pose.mount.Transform = CFrame.identity
					entry.raised = false
				end
				joints.rightShoulder.Transform = rightShoulder
				if joints.rightElbow then
					joints.rightElbow.Transform = rightElbow
				end
				joints.leftShoulder.Transform = shoulder or leftShoulder
				if joints.leftElbow then
					joints.leftElbow.Transform = elbow or leftElbow
				end
				if entry.aim &gt; 0.01 and joints.neck then
					joints.neck.Transform = joints.neck.Transform:Lerp(joints.neck.Transform * AIM_NECK, entry.aim)
				end
			end
			-- The lean goes on top of the run's own spine, eased with the rest.
			if sprint &gt; 0 and joints.waist then
				joints.waist.Transform = joints.waist.Transform:Lerp(joints.waist.Transform * SPRINT_WAIST, sprint)
			end
		end
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX161"><Properties><string name="Name">HitSplatClient</string><ProtectedString name="Source">-- The little red splat where a bullet lands on someone, for everyone watching.
--
-- HitSplatService sends each frame's hits as one HitSplat batch: { victim character, attacker
-- character or false, headshot, shield } each. The server only knows who hit whom; the spot on the
-- body is found here, by tracing from the shooter's head to the part that was hit (the head for a
-- headshot, the torso otherwise, with a little scatter) against the victim alone. The splat goes on
-- when the tracer would arrive, so it lands with the shot rather than ahead of it (ExplosiveFx.Splat
-- draws it and keeps it on the limb as the body moves). Far-off hits aren't drawn at all.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Rarity = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Rarity"))
local ExplosiveFx = require(script.Parent:WaitForChild("ExplosiveFx"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- Beyond this from the camera nothing is drawn; a splat is a stud wide.
local CULL_DISTANCE = 350
-- GunFx's bullets fly at about this, so the splat waits for them.
local TRACER_SPEED = 900
local TORSO_NAMES = { "UpperTorso", "Torso", "HumanoidRootPart" }

local victimParams = RaycastParams.new()
victimParams.FilterType = Enum.RaycastFilterType.Include

local function bodyPart(character, headshot)
	if headshot then
		local head = character:FindFirstChild("Head")
		if head then
			return head
		end
	end
	for _, name in ipairs(TORSO_NAMES) do
		local part = character:FindFirstChild(name)
		if part then
			return part
		end
	end
	return nil
end

-- `rarity` is the rank of the gun that dealt the hit (the server's word): the splat is drawn in
-- that rank's colour.
--
-- HARD RULE: no red fallback, anywhere. The old code here was
-- `type(rarity) == "string" and Rarity.Colors[rarity] and Rarity.Color(rarity) or nil`, and passing
-- that `nil` on to ExplosiveFx.Splat hit a fallback in THAT module literally named BLOOD
-- (Color3.fromRGB(148, 16, 16)) -- ExplosiveFx.Splat is called from nowhere else in the project, so
-- that constant is reachable only through this one call. Every WeaponData entry carries a rarity
-- today (checked: 27/27, ReplicatedStorage/Shared/WeaponData.lua), so the path was dormant rather
-- than firing on live data, but `rarity` also arrives as literal `false` for a non-gunfire hit
-- (HitSplatService.Payload) and would have taken the same nil branch. `Rarity.Color` already
-- defaults unmatched input to Common's grey (ReplicatedStorage/Shared/Rarity.lua:22-24) and is safe
-- to call directly with a string, `false`, or `nil` alike -- a plain Lua table read on any of those
-- keys returns nil, never an error -- so routing through it directly removes the red branch
-- entirely instead of relying on every future caller to remember not to take it.
local function splat(victim, attacker, headshot, shield, rarity)
	local color = Rarity.Color(rarity)
	local target = bodyPart(victim, headshot)
	if not target then
		return
	end
	if (target.Position - camera.CFrame.Position).Magnitude &gt; CULL_DISTANCE then
		return
	end

	local shooterHead = attacker and attacker:FindFirstChild("Head")
	local from = shooterHead and shooterHead.Position
	if not from then
		-- No shooter to trace from (a companion, a bot that's gone): from somewhere off to the side.
		local direction = Vector3.new(math.random() - 0.5, math.random() * 0.4 - 0.2, math.random() - 0.5)
		from = target.Position + (direction.Magnitude &gt; 0.01 and direction.Unit or Vector3.xAxis) * 6
	end

	-- Scatter across the face of the part, so a burst doesn't stack every splat on one point.
	local toTarget = target.Position - from
	local distance = toTarget.Magnitude
	if distance &lt; 0.1 then
		return
	end
	local forward = toTarget / distance
	local right = forward:Cross(Vector3.yAxis)
	right = right.Magnitude &gt; 0.01 and right.Unit or Vector3.xAxis
	local up = right:Cross(forward)
	local size = target.Size
	local aim = target.Position + right * ((math.random() - 0.5) * size.X * 0.6) + up * ((math.random() - 0.5) * size.Y * 0.6)

	victimParams.FilterDescendantsInstances = { victim }
	local hit = workspace:Raycast(from, (aim - from) * 1.5, victimParams)
	local limb, point, normal
	if hit and hit.Instance:IsDescendantOf(victim) then
		limb, point, normal = hit.Instance, hit.Position, hit.Normal
	else
		limb = target
		normal = -forward
		point = target.Position + normal * (math.min(size.X, size.Z) * 0.5)
	end

	task.delay(distance / TRACER_SPEED, function()
		if not limb.Parent or not victim.Parent then
			return
		end
		ExplosiveFx.Splat(limb, point, normal, { headshot = headshot, shield = shield, color = color })
		if not shield then
			Sfx.PlayAt("HitSplat", point, 0.15)
		end
	end)
end

Remotes.Event("HitSplat").OnClientEvent:Connect(function(batch)
	if type(batch) ~= "table" then
		return
	end
	for _, hit in ipairs(batch) do
		if type(hit) == "table" then
			local victim, attacker = hit[1], hit[2]
			if typeof(victim) == "Instance" and victim:IsA("Model") and victim.Parent then
				splat(victim, typeof(attacker) == "Instance" and attacker:IsA("Model") and attacker or nil, hit[3] == true, hit[4] == true, hit[5])
			end
		end
	end
end)

-- Your own splats are drawn like everyone else's, so a hit you land is a hit you can see; the
-- player variable keeps the script's intent plain if that changes.
local _ = player
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX162"><Properties><string name="Name">HudClient</string><ProtectedString name="Source">-- Match HUD: health, ammo, weapon slots, storm timer, kill feed, the lobby map vote, and
-- the end-of-match results card. Built in code so there is no GUI to assemble in Studio.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BrainrotData = require(Shared:WaitForChild("BrainrotData"))
local MapData = require(Shared:WaitForChild("MapData"))
local Rarity = require(Shared:WaitForChild("Rarity"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Settings = require(script.Parent:WaitForChild("Settings"))
local Sfx = require(script.Parent:WaitForChild("Sfx"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

local matchChanged = Remotes.Event("MatchChanged")
local stormChanged = Remotes.Event("StormChanged")
local loadoutChanged = Remotes.Event("LoadoutChanged")
local killFeed = Remotes.Event("KillFeed")
local matchResults = Remotes.Event("MatchResults")
local damageDealt = Remotes.Event("DamageDealt")
local damageTaken = Remotes.Event("DamageTaken")
local killStreakRemote = Remotes.Event("KillStreak")
local supplyDropRemote = Remotes.Event("SupplyDrop")
local shotFired = Remotes.Event("ShotFired")
local notify = Remotes.Event("Notify")
local voteChanged = Remotes.Event("VoteChanged")
local castVote = Remotes.Function("CastVote")
local equipRemote = Remotes.Event("EquipSlot")
local dropRemote = Remotes.Event("DropSlot")
local ItemModels = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("ItemModels"))
local profileChanged = Remotes.Event("ProfileChanged")
local requestProfile = Remotes.Function("RequestProfile")
local companionAttackRemote = Remotes.Event("CompanionAttack")

local create, rounded, padding = UiKit.create, UiKit.rounded, UiKit.padding
local formatNumber = UiKit.formatNumber
local C = UiKit.Colors

-- #80: which pieces the phone layout has no room for right now. An upright phone has no compass, kill
-- feed, bounty or location line or speed pill (PhoneLayout.lua's portraitRects), and the layout hid them
-- once -- but the compass's own per-frame code, the bounty handler and the speed pill's refresh each
-- wrote `Visible = true` again the next time they ran, and the pieces came back at their DESKTOP spots
-- over the portrait HUD. So every piece the layout places says whether it wants to be shown through
-- `hudLayout.show`, which records the wish and draws the piece only if the layout has a place for it;
-- when the phone turns and the layout finds room again, it shows whatever was last wished for.
-- (tools/hud_layout_check.py runs this file and fails on any direct `.Visible =` on one of those pieces.)
-- One table, not three locals: the main chunk is close to Luau's 200-local limit.
local hudLayout = { dropped = {}, wanted = {} }
function hudLayout.show(gui, want)
	hudLayout.wanted[gui] = want == true
	gui.Visible = want == true and not hudLayout.dropped[gui]
end

local screenGui = create("ScreenGui", {
	Name = "BrrHud",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})

local matchState = { state = "Waiting", countdown = 0, aliveCount = 0, playerCount = 0, minPlayers = 2 }
local loadout = nil

--------------------------------------------------------------------------------
-- Top banner: match state, alive count, storm
--------------------------------------------------------------------------------

local banner = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 10),
	Size = UDim2.new(0, 440, 0, 56),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.15,
	BorderSizePixel = 0,
	Parent = screenGui,
}, { rounded(12) })

local bannerTitle = create("TextLabel", {
	Size = UDim2.new(1, 0, 0, 28),
	Position = UDim2.new(0, 0, 0, 6),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "WAITING FOR PLAYERS",
	TextColor3 = C.Text,
	TextSize = 20,
	Parent = banner,
})

local bannerSub = create("TextLabel", {
	Size = UDim2.new(1, 0, 0, 20),
	Position = UDim2.new(0, 0, 0, 32),
	BackgroundTransparency = 1,
	Font = Enum.Font.Gotham,
	Text = "",
	TextColor3 = C.Muted,
	-- Shrinks to fit rather than running out of the banner (Oliver 15:37).
	TextScaled = true,
	Parent = banner,
}, { create("UITextSizeConstraint", { MaxTextSize = 14 }), create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) })

-- Ready up / stay in the lobby. A big pill beside the banner: amber and gently pulsing while
-- you're not ready, green with a tick once you are, with the live ready count underneath.
-- F toggles it too. Only readied players are pulled into a match, and the choice carries over
-- between matches.
local UserInputService = game:GetService("UserInputService")
local readyRemote = Remotes.Event("SetReady")

local readyButton = create("TextButton", {
	Position = UDim2.new(0.5, 232, 0, 8),
	Size = UDim2.fromOffset(230, 60),
	BackgroundColor3 = C.Accent,
	BorderSizePixel = 0,
	AutoButtonColor = false,
	Text = "",
	Visible = false,
	Parent = screenGui,
}, { rounded(14) })

local readyScale = create("UIScale", { Parent = readyButton })
local readyStroke = create("UIStroke", {
	Color = C.Accent,
	Thickness = 3,
	Transparency = 0.2,
	ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	Parent = readyButton,
})
create("UIGradient", {
	Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205)),
	Rotation = 90,
	Parent = readyButton,
})

-- The tick is drawn from two bars rather than a glyph the font might not have.
local readyIcon = create("Frame", {
	Position = UDim2.new(0, 14, 0.5, -15),
	Size = UDim2.fromOffset(30, 30),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.78,
	BorderSizePixel = 0,
	Parent = readyButton,
}, { rounded(15) })

local tickShort = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.36, 0, 0.58, 0),
	Size = UDim2.fromOffset(4, 11),
	Rotation = -45,
	BackgroundColor3 = Color3.new(0, 0, 0),
	BorderSizePixel = 0,
	Parent = readyIcon,
})
local tickLong = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.57, 0, 0.47, 0),
	Size = UDim2.fromOffset(4, 18),
	Rotation = 40,
	BackgroundColor3 = Color3.new(0, 0, 0),
	BorderSizePixel = 0,
	Parent = readyIcon,
})
-- Not ready: a play arrow instead of the tick.
local readyArrow = create("TextLabel", {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "&gt;",
	TextColor3 = Color3.new(0, 0, 0),
	TextSize = 20,
	Parent = readyIcon,
})

local readyTitle = create("TextLabel", {
	Position = UDim2.new(0, 54, 0, 6),
	Size = UDim2.new(1, -62, 0, 30),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "READY UP",
	TextColor3 = Color3.new(0, 0, 0),
	TextXAlignment = Enum.TextXAlignment.Left,
	TextSize = 26,
	Parent = readyButton,
})

local readySub = create("TextLabel", {
	Position = UDim2.new(0, 54, 0, 35),
	Size = UDim2.new(1, -62, 0, 18),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = Color3.fromRGB(40, 32, 12),
	TextXAlignment = Enum.TextXAlignment.Left,
	TextTruncate = Enum.TextTruncate.AtEnd,
	TextSize = 12,
	Parent = readyButton,
})

local function isReady()
	return player:GetAttribute("Ready") == true
end

-- Hidden only while you're actually in a match or it's loading; otherwise you can always
-- choose whether the next one includes you.
local function updateReadyButton()
	local inMatch = matchState.state == "Loading" or (matchState.state == "InProgress" and loadout ~= nil)
	readyButton.Visible = not inMatch

	local ready = isReady()
	readyButton.BackgroundColor3 = ready and C.Green or C.Accent
	readyStroke.Color = ready and C.Green or C.Accent
	readyTitle.Text = ready and "READY!" or "READY UP"
	tickShort.Visible = ready
	tickLong.Visible = ready
	readyArrow.Visible = not ready
	-- A key only means something on a keyboard (#86 M2): on a touch screen or a pad the pill itself is
	-- what you press.
	local lastInput = UserInputService:GetLastInputType()
	if lastInput == Enum.UserInputType.Touch or string.find(lastInput.Name, "Gamepad", 1, true) then
		readySub.Text = string.format("%d of %d ready  •  %s",
			matchState.readyCount or 0, matchState.playerCount or 0,
			ready and "tap to stay in lobby" or "tap to join next match")
	else
		readySub.Text = string.format("%d of %d ready  •  [%s] %s",
			matchState.readyCount or 0, matchState.playerCount or 0, Settings.KeyLabel("Ready"),
			ready and "stay in lobby" or "join next match")
	end
end

local readyHovered = false
local lastReadyToggle = 0

local function toggleReady()
	if not readyButton.Visible then
		return
	end
	local now = os.clock()
	if now - lastReadyToggle &lt; 0.35 then
		return
	end
	lastReadyToggle = now
	Sfx.Play("UiClick", 0.08)
	readyRemote:FireServer(not isReady())
end

readyButton.Activated:Connect(toggleReady)
readyButton.MouseEnter:Connect(function()
	readyHovered = true
end)
readyButton.MouseLeave:Connect(function()
	readyHovered = false
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Settings.Key("Ready") and not player:GetAttribute("MenuOpen") then
		toggleReady()
	end
end)

-- The hint on the pill names whatever key Ready is bound to.
Settings.Changed:Connect(function()
	updateReadyButton()
end)

-- Not ready: the outline breathes and the pill swells slightly, so it's the first thing you
-- notice in the lobby. Ready: it settles down.
RunService.RenderStepped:Connect(function()
	if not readyButton.Visible then
		return
	end
	local t = os.clock()
	local target
	if isReady() then
		readyStroke.Transparency = 0.45
		target = 1
	else
		local wave = math.abs(math.sin(t * 3))
		readyStroke.Transparency = 0.15 + wave * 0.55
		target = 1 + wave * 0.035
	end
	if readyHovered then
		target += 0.05
	end
	readyScale.Scale += (target - readyScale.Scale) * 0.25
end)

--------------------------------------------------------------------------------
-- Crosshair + hitmarker
--------------------------------------------------------------------------------

local crosshair = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(64, 64),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = screenGui,
})

-- Hidden while the sights are up (CombatClient's SightsUp attribute): the red dot, the iron sights or
-- the scope is the aim point then, and ticks round it would only clutter the sight picture. It comes
-- back as soon as the gun drops to the hip.
local crosshairWanted = false
local function showCrosshair(wanted)
	crosshairWanted = wanted
	-- One crosshair at a time: while the player works a vehicle's gun, VehicleWeaponClient draws its own
	-- aim mark and this one stands down (#80: with a gun in hand both were drawn, one over the other).
	crosshair.Visible = wanted and not player:GetAttribute("SightsUp") and not player:GetAttribute("VehicleGunActive")
end
player:GetAttributeChangedSignal("SightsUp"):Connect(function()
	showCrosshair(crosshairWanted)
end)
player:GetAttributeChangedSignal("VehicleGunActive"):Connect(function()
	showCrosshair(crosshairWanted)
end)

-- The ticks and their spread, in a block of their own: nothing past here touches them, and the main
-- chunk is close to Luau's local limit.
do
	local BASE_GAP = 5
	local crosshairGap = BASE_GAP

	-- Four ticks rather than a dot: the gap widens when you fire, which is the only spread
	-- feedback the player gets.
	local crossArms = {}
	for _, dir in ipairs({ "Up", "Down", "Left", "Right" }) do
		local vertical = dir == "Up" or dir == "Down"
		local arm = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = vertical and UDim2.fromOffset(2, 8) or UDim2.fromOffset(8, 2),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			Parent = crosshair,
		})
		crossArms[dir] = arm
	end

	local function layoutCrosshair()
		local gap = crosshairGap
		crossArms.Up.Position = UDim2.new(0.5, 0, 0.5, -gap - 4)
		crossArms.Down.Position = UDim2.new(0.5, 0, 0.5, gap + 4)
		crossArms.Left.Position = UDim2.new(0.5, -gap - 4, 0.5, 0)
		crossArms.Right.Position = UDim2.new(0.5, gap + 4, 0.5, 0)
	end

	layoutCrosshair()

	shotFired.OnClientEvent:Connect(function(shooter)
		if shooter == player then
			crosshairGap = math.min(crosshairGap + 5, 22)
		end
	end)

	RunService.RenderStepped:Connect(function(delta)
		if crosshairGap &gt; BASE_GAP then
			crosshairGap = math.max(BASE_GAP, crosshairGap - delta * 34)
			layoutCrosshair()
		end
	end)
end

local hitmarker = create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(80, 40),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "X",
	TextColor3 = C.Red,
	TextTransparency = 1,
	TextSize = 30,
	Parent = screenGui,
})

-- Floating damage numbers at the point of impact.
local GOLD = Color3.fromRGB(255, 210, 70)

-- Only hits on a person get a number: cover takes a tick and nothing else.
local function showDamageNumber(amount, position, wasKill, hitShield, headshot)
	if not position or not Settings.Get("DamageNumbers") then
		return
	end

	local anchor = Instance.new("Part")
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Position = position + Vector3.new(math.random(-15, 15) / 10, 2, math.random(-15, 15) / 10)
	anchor.Parent = workspace

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(120, 44)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 260
	billboard.Parent = anchor

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = tostring(math.floor(amount + 0.5)) .. (headshot and "!" or "")
	-- Blue while the hit is soaking into a shield, so you know the health bar hasn't moved yet;
	-- gold for a headshot.
	label.TextColor3 = wasKill and C.Accent or (headshot and GOLD or (hitShield and Color3.fromRGB(120, 190, 255) or Color3.fromRGB(255, 236, 200)))
	label.TextStrokeTransparency = 0.35
	label.TextSize = wasKill and 34 or (headshot and 31 or 26)
	label.Parent = billboard

	TweenService:Create(anchor, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = anchor.Position + Vector3.new(0, 7, 0),
	}):Play()
	TweenService:Create(label, TweenInfo.new(0.75), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()

	task.delay(0.85, function()
		anchor:Destroy()
	end)
end

damageDealt.OnClientEvent:Connect(function(amount, wasKill, position, hitShield, headshot, kind)
	-- Cover taking the shot (a map wall, a window, a barricade, a barrel): a small grey tick, and
	-- nothing else — no number and none of the hit cues (Oliver's call). Otherwise chipping a wall in
	-- a building sounded and looked exactly like hitting the player behind it.
	if kind == "structure" then
		hitmarker.Text = "+"
		hitmarker.TextSize = 22
		hitmarker.TextColor3 = Color3.fromRGB(188, 192, 198)
		hitmarker.TextTransparency = 0
		TweenService:Create(hitmarker, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
		return
	end
	-- A vehicle taking the shot (VehicleService.DamageVehicle): an amber tick and the number, so wearing
	-- a car down reads as progress but never as a hit on the person in it; WRECKED when it goes.
	if kind == "vehicle" then
		hitmarker.Text = wasKill and "WRECKED" or "+"
		hitmarker.TextSize = wasKill and 26 or 24
		hitmarker.TextColor3 = Color3.fromRGB(255, 176, 70)
		hitmarker.TextTransparency = 0
		TweenService:Create(hitmarker, TweenInfo.new(wasKill and 0.7 or 0.3), { TextTransparency = 1 }):Play()
		Sfx.Play("HitConfirm", 0.2)
		showDamageNumber(amount, position, false, false, false)
		return
	end
	hitmarker.Text = wasKill and (headshot and "HEADSHOT" or "ELIM") or "X"
	hitmarker.TextSize = headshot and 36 or 30
	-- Blue while you're still chewing through their shield; gold for a headshot.
	hitmarker.TextColor3 = wasKill and C.Accent or (headshot and GOLD or (hitShield and Color3.fromRGB(80, 170, 255) or C.Red))
	hitmarker.TextTransparency = 0
	TweenService:Create(hitmarker, TweenInfo.new(wasKill and 0.6 or 0.3), { TextTransparency = 1 }):Play()
	if headshot then
		-- A ding over a crack, on top of the elimination cue when it was the killing shot.
		Sfx.Play("Headshot", 0.06)
		Sfx.Play("HeadshotCrack", 0.1)
		if wasKill then
			Sfx.Play("Elimination")
		end
	else
		Sfx.Play(wasKill and "Elimination" or "HitConfirm", wasKill and 0 or 0.14)
	end
	showDamageNumber(amount, position, wasKill, hitShield, headshot)
end)

--------------------------------------------------------------------------------
-- Screen-edge state: low health, and standing in the storm
--------------------------------------------------------------------------------

-- A full-screen tinted frame with a transparent middle would need a 9-slice image, so the
-- vignette is four edge gradients instead. Same read, no assets.
local vignette = create("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = screenGui,
})

local vignetteEdges = {}
for _, side in ipairs({ "Top", "Bottom", "Left", "Right" }) do
	local vertical = side == "Top" or side == "Bottom"
	local edge = create("Frame", {
		Size = vertical and UDim2.new(1, 0, 0, 140) or UDim2.new(0, 180, 1, 0),
		Position = (side == "Bottom" and UDim2.new(0, 0, 1, -140))
			or (side == "Right" and UDim2.new(1, -180, 0, 0))
			or UDim2.fromScale(0, 0),
		BackgroundColor3 = C.Red,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = vignette,
	})

	local rotation = (side == "Top" and 90) or (side == "Bottom" and 270) or (side == "Left" and 0) or 180
	create("UIGradient", {
		Rotation = rotation,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = edge,
	})

	table.insert(vignetteEdges, edge)
end

local function setVignette(alpha, color)
	if alpha &lt;= 0.01 then
		vignette.Visible = false
		return
	end
	vignette.Visible = true
	for _, edge in ipairs(vignetteEdges) do
		edge.BackgroundTransparency = 1 - alpha
		edge.BackgroundColor3 = color
	end
end

local zoneWarning = create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.62, 0),
	Size = UDim2.fromOffset(520, 40),
	BackgroundTransparency = 1,
	Font = Enum.Font.FredokaOne,
	Text = "YOU'RE IN THE ROT - GET BACK IN",
	TextColor3 = C.Storm,
	TextStrokeTransparency = 0.4,
	TextTransparency = 1,
	TextSize = 28,
	Parent = screenGui,
})

-- The live storm, or nil while it's idle. Declared here, above its first reader, and assigned by the
-- StormChanged handler in "Storm readout" below. It used to be declared only down there, so this
-- loop read a global of the same name that was always nil and the storm vignette and the OUTSIDE
-- THE ZONE warning never showed.
local stormState = nil

RunService.RenderStepped:Connect(function()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")

	-- Not in this match -- joined late, or eliminated and watching -- means none of the storm's
	-- warnings are about this player. A spectator still has a body standing in the lobby, so without
	-- this the vignette pulses purple over someone who is not in the storm, and the readout counts
	-- down a zone they are not in. This is the test renderBanner has made since it was written.
	-- Written out rather than kept in a local: HudClient's main chunk is near Luau's 200-local limit
	-- and overrunning it fails the compile silently.
	if matchState.state == "InProgress" and not loadout then
		setVignette(0)
		zoneWarning.TextTransparency = 1
		return
	end

	if not humanoid or humanoid.Health &lt;= 0 or not root then
		setVignette(0)
		zoneWarning.TextTransparency = 1
		return
	end

	local outside = false
	if stormState and stormState.center then
		local flat = Vector3.new(root.Position.X - stormState.center.X, 0, root.Position.Z - stormState.center.Z)
		outside = flat.Magnitude &gt; stormState.radius
	end

	local ratio = humanoid.MaxHealth &gt; 0 and humanoid.Health / humanoid.MaxHealth or 1

	-- Being in the storm reads purple and always shows; low health reads red and only
	-- below a third, so the two states never fight for the same signal.
	if outside then
		local pulse = 0.3 + math.abs(math.sin(os.clock() * 4)) * 0.22
		setVignette(pulse, C.Storm)
		zoneWarning.TextTransparency = 0.1
	elseif ratio &lt; 0.34 then
		setVignette((0.34 - ratio) / 0.34 * 0.55, C.Red)
		zoneWarning.TextTransparency = 1
	else
		setVignette(0)
		zoneWarning.TextTransparency = 1
	end
end)

--------------------------------------------------------------------------------
-- Supply drops
--------------------------------------------------------------------------------

local activeDrop = nil

local dropBanner = create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 128),
	Size = UDim2.fromOffset(480, 30),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = C.Accent,
	TextStrokeTransparency = 0.5,
	TextTransparency = 1,
	TextSize = 18,
	Parent = screenGui,
})

-- The town or landmark nearest a point, from the attributes MapGenerator leaves on them, so a
-- supply drop can be announced as "near ROT DOCKS" rather than as a dot on the minimap.
local function nearestPlaceName(position)
	local map = workspace:FindFirstChild("Map")
	if not map or typeof(position) ~= "Vector3" then
		return nil
	end
	local best, bestDistance = nil, 260
	local function consider(child, centerAttribute, nameAttribute)
		local center = child:GetAttribute(centerAttribute)
		local name = child:GetAttribute(nameAttribute)
		if center and name then
			local distance = Vector2.new(center.X - position.X, center.Z - position.Z).Magnitude
			if distance &lt; bestDistance then
				best, bestDistance = name, distance
			end
		end
	end
	for _, child in ipairs(map:GetChildren()) do
		consider(child, "TownCenter", "TownName")
	end
	local landmarks = map:FindFirstChild("Landmarks")
	if landmarks then
		for _, child in ipairs(landmarks:GetChildren()) do
			consider(child, "LandmarkCenter", "LandmarkName")
		end
	end
	return best
end

supplyDropRemote.OnClientEvent:Connect(function(info)
	if info.cleared or info.claimed then
		-- A claim only removes the marker if it's for the crate being shown; a newer drop
		-- may already have replaced it.
		-- Matched by integer id, not position: comparing float Vector3s that took different
		-- routes to the client is fragile.
		if info.cleared or (activeDrop and activeDrop.dropId == info.dropId) then
			activeDrop = nil
		end
		return
	end

	activeDrop = info

	local place = nearestPlaceName(info.position)
	local where = place and ("  •  near " .. string.upper(place)) or ""
	-- Each piece is guarded: a payload missing rarity or weapon must shorten the banner, not throw
	-- inside the handler and leave the marker stale.
	dropBanner.Text = info.incoming
		and ("SUPPLY DROP INBOUND" .. (info.rarity and ("  •  " .. string.upper(info.rarity)) or "") .. where)
		or ("SUPPLY DROP LANDED" .. (info.weapon and ("  •  " .. info.weapon) or "") .. where)
	dropBanner.TextColor3 = info.rarity and Rarity.Color(info.rarity) or C.Accent
	dropBanner.TextTransparency = 0
	Sfx.Play("CrateOpen")

	task.delay(6, function()
		TweenService:Create(dropBanner, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
	end)
end)

